# v3 Group Sorting Upgrade: project/job identifiers used for safer auto-grouping.
# Keep this local and conservative: it only strengthens grouping when a clear
# business key exists, and avoids broad sender/domain-only grouping.
GENERIC_GROUP_SUBJECTS = {
    "quote", "quote request", "rfq", "request for quote", "p&a", "p and a",
    "price and availability", "price & availability", "pricing", "estimate",
    "proposal", "order", "purchase order", "po", "re quote", "fw quote",
}


def _compact_group_token(value):
    return re.sub(r"[^a-z0-9]", "", str(value or "").lower())


def is_generic_group_subject(subject):
    text = normalize_subject_for_match(subject or "")
    text = re.sub(r"[^a-z0-9&/ -]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    if not text:
        return True
    if text in GENERIC_GROUP_SUBJECTS:
        return True
    words = [w for w in re.split(r"\s+", text) if w]
    if len(words) <= 3 and any(g in text for g in ["quote", "rfq", "p&a", "pricing", "estimate", "proposal"]):
        return True
    return False


def extract_group_match_tokens(text):
    """Extract conservative job/PO/project tokens for grouping.

    These tokens are intentionally stricter than fuzzy subject matching. They
    catch examples like C&D-156B, 156B, 750AL, Harrand 25155, PO 26-091, etc.,
    while avoiding generic subjects such as just 'Quote Request'.
    """
    raw = str(text or "")
    if not raw:
        return set()
    upper = raw.upper()
    tokens = set()

    # Keyword-anchored codes (PO 26-091, SO 12345, JOB 4471, etc.). The keyword must be a whole
    # word -- (?![A-Z]) stops it matching inside ordinary words like SOlutions / ORDERs / REFer --
    # and the captured value must contain a digit, so plain prose ("Order Charge", "below") is not
    # mistaken for a job/PO code.
    for m in re.finditer(
        r"\b(?:PO|P\.?O\.?|QUOTE|QUOTATION|RFQ|JOB|PROJECT|ORDER|SO|SALES\s+ORDER|REF)"
        r"(?![A-Z])\s*(?:#|NO\.?|NUMBER|:|-)?\s*([A-Z0-9][A-Z0-9 &./_-]{2,24})",
        upper, flags=re.I,
    ):
        val = m.group(1)
        if not any(ch.isdigit() for ch in val):
            continue
        # The greedy capture can swallow trailing prose ("SO 12345 Solutions" -> "12345 SOLUTIONS").
        # Keep only the leading code run: once a digit-bearing word has ended, drop any following
        # alpha-only words so the token is "12345", not "12345solutions". Alpha suffixes fused into a
        # digit word (e.g. 750AL, 26-091) are preserved because they still carry a digit.
        words = val.split()
        kept = []
        seen_digit = False
        for w in words:
            has_digit = any(ch.isdigit() for ch in w)
            if seen_digit and not has_digit:
                break
            kept.append(w)
            if has_digit:
                seen_digit = True
        val = " ".join(kept)
        compact = _compact_group_token(val)
        if len(compact) >= 3 and compact not in {"quote", "rfq", "order", "project", "job", "po"}:
            tokens.add(compact)

    patterns = [
        r"\b([A-Z]{1,6}\s*[&-]\s*[A-Z0-9]{2,}(?:\s*[-/]\s*[A-Z0-9]{2,})?)\b",
        r"\b(\d{2,6}\s*[-/]\s*[A-Z0-9]{2,8})\b",
        r"\b([A-Z]{1,4}\d{2,6}[A-Z0-9]{0,4})\b",
        r"\b(\d{2,6}[A-Z]{1,4})\b",
    ]
    for pat in patterns:
        for m in re.finditer(pat, upper, flags=re.I):
            val = m.group(1) if m.groups() else m.group(0)
            compact = _compact_group_token(val)
            if len(compact) >= 3 and compact not in {"quote", "rfq", "order", "project", "job", "po"}:
                tokens.add(compact)

    # If a name/project word sits next to a real number/code, keep the combined
    # signature as a stronger token (ex: HARRAND 25155, EDENWALD 750AL).
    for m in re.finditer(r"\b([A-Z][A-Z0-9]{2,})\s+([0-9]{2,6}[A-Z]{0,4}|[A-Z]{0,3}[0-9]{2,6}[A-Z]{0,4})\b", upper):
        # Skip date-like phrases ("March 2025", "May 14") -- a month name beside a number is not a
        # job/project signature.
        if m.group(1).lower() in _MONTHS:
            continue
        combined = _compact_group_token(m.group(1) + m.group(2))
        if len(combined) >= 5:
            tokens.add(combined)

    return tokens


def quick_sender_intent_analysis(subject, sender, body="", related_count=0, source=""):
    """Fast non-AI triage context used to prevent spam followups and help Ollama sort accurately."""
    subject = subject or ""
    sender = sender or ""
    body = body or ""
    source = source or ""
    combined = f"{subject}\n{sender}\n{body}"
    combined_l = combined.lower()
    reasons = []
    matched = []

    result = {
        "sender_type": "unknown",
        "sender_intent": "unclear",
        "workflow_category": "General",
        "urgency": "Normal",
        "status": "Needs Reply",
        "business_relevance": 0.55,
        "spam_likelihood": 0.10,
        "needs_followup": False,
        "followup_reason": "",
        "same_subject_related_count": int(related_count or 0),
        "reason": "Incoming message defaults to Needs Reply unless rules or AI show otherwise.",
        "hard_decision": False,
    }

    if related_count:
        reasons.append(f"Found {related_count} cached email(s) with the same normalized subject, so this is likely related to an existing thread/job.")

    spam_signal = sender_looks_automated(sender) or contains_any_phrase(combined_l, SPAM_OR_MARKETING_PHRASES)
    strong_spam_signal = sender_looks_automated(sender) and contains_any_phrase(combined_l, STRONG_SPAM_PHRASES)
    if spam_signal and (not related_count or strong_spam_signal):
        matched = matched_phrases(combined_l, SPAM_OR_MARKETING_PHRASES)
        result.update({
            "sender_type": "automated_or_marketing",
            "sender_intent": "newsletter/spam/system notification",
            "workflow_category": "Junk / Ignore",
            "urgency": "Low",
            "status": "Completed",
            "business_relevance": 0.05,
            "spam_likelihood": 0.92,
            "needs_followup": False,
            "followup_reason": "Blocked: automated/marketing/spam-like message.",
            "hard_decision": True,
            "reason": "Pre-AI spam/system filter matched sender or marketing language" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if spam_signal and related_count:
        matched = matched_phrases(combined_l, SPAM_OR_MARKETING_PHRASES)
        result.update({
            "sender_type": "unknown",
            "sender_intent": "possibly automated, but protected because exact subject matches existing work",
            "workflow_category": "General",
            "urgency": "Normal",
            "status": "Needs Reply",
            "business_relevance": 0.74,
            "spam_likelihood": 0.24,
            "needs_followup": False,
            "followup_reason": "Same-subject project protection blocked junk downgrade.",
            "hard_decision": False,
            "reason": "Spam-like language found, but exact same subject already exists in cache, so do not auto-junk unless AI has strong evidence" + (f": {', '.join(matched)}" if matched else "."),
        })

    if contains_any_phrase(combined_l, VENDOR_QUOTE_REPLY_PHRASES):
        matched = matched_phrases(combined_l, VENDOR_QUOTE_REPLY_PHRASES)
        result.update({
            "sender_type": "vendor_or_supplier",
            "sender_intent": "vendor sent quote/pricing/lead time",
            "workflow_category": "Vendor / Supplier",
            "urgency": "Normal",
            "status": "Needs Reply",
            "business_relevance": 0.93,
            "spam_likelihood": 0.03,
            "needs_followup": False,
            "followup_reason": "Vendor replied with quote/pricing; user likely needs to review/respond or update customer, not wait on vendor.",
            "reason": "Vendor quote/pricing phrase matched" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if contains_any_phrase(combined_l, VENDOR_STATUS_REPLY_PHRASES):
        matched = matched_phrases(combined_l, VENDOR_STATUS_REPLY_PHRASES)
        result.update({
            "sender_type": "vendor_or_supplier",
            "sender_intent": "vendor sent status/shipping/order update",
            "workflow_category": "Vendor / Supplier",
            "urgency": "Normal",
            "status": "Needs Reply",
            "business_relevance": 0.82,
            "spam_likelihood": 0.08,
            "needs_followup": False,
            "followup_reason": "Vendor update received; user may need to pass info along or review.",
            "reason": "Vendor status phrase matched" + (f": {', '.join(matched)}" if matched else "."),
