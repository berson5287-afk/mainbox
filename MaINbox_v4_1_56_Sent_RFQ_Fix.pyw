def normalize_email_type_code(value):
    value = str(value or "").strip().upper()
    aliases = {
        "CUSTOMER": "C", "CUSTOMER/PROSPECT": "C", "CUSTOMER_OR_PROSPECT": "C",
        "VENDOR": "V", "SUPPLIER": "V", "VENDOR/SUPPLIER": "V", "VENDOR_OR_SUPPLIER": "V",
        "EMPLOYEE": "E", "INTERNAL": "E",
        "MARKETING": "M", "SYSTEM": "M", "AUTOMATED": "M", "AUTOMATED_OR_MARKETING": "M", "SYSTEM_OR_INFORMATIONAL": "M",
    }
    value = aliases.get(value, value)
    return value if value in EMAIL_TYPE_CODES else ""


def infer_email_type_code(email):
    if not isinstance(email, dict):
        return ""
    explicit = normalize_email_type_code(email.get("email_type") or email.get("type_code") or email.get("contact_type"))
    if explicit:
        return explicit
    sender_type = str(email.get("sender_type", "") or "").strip().lower()
    if sender_type in ["customer_or_prospect", "customer", "prospect"]:
        return "C"
    if sender_type in ["vendor_or_supplier", "vendor", "supplier", "sent_placeholder"]:
        return "V"
    if sender_type in ["internal", "employee"]:
        return "E"
    if sender_type in ["automated_or_marketing", "system_or_informational", "marketing", "system"]:
        return "M"
    category = str(email.get("category", "") or "").strip().lower()
    if category == "vendor / supplier":
        return "V"
    return ""

