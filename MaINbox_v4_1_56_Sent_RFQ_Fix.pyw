    def email_matches_active_filter(self, email):
        if not self.group_filter_allows_email(email):
            return False
        if self.active_filter == "all":
            return email.get("urgency") != "Low" and email.get("status") != "Completed"
        if self.active_filter == "needs_reply":
            return email.get("status") == "Needs Reply"
        if self.active_filter == "waiting_customer":
            return email.get("status") == "Waiting on Customer"
        if self.active_filter == "waiting_vendor":
            return email.get("status") == "Waiting on Vendor"
        if self.active_filter == "completed":
            return email.get("status") == "Completed"
        if self.active_filter == "urgent":
            return email.get("urgency") in ["High", "Critical"] and email.get("status") != "Completed"
        if self.active_filter == "followups":
            return bool(self.get_active_followup_for_email(email.get("entry_id")))
        if self.active_filter == "low":
            return email.get("urgency") == "Low"
        return email.get("urgency") != "Low"

    def get_cache_key(self):
        return self.selected_sales_category

    # v2.10.13 duplicate guardrails
    def _safe_iso_sort_value(self, value):
        """Sortable timestamp helper for cleanup routines."""
        try:
            if not value:
                return ""
            return datetime.fromisoformat(str(value)).isoformat()
        except Exception:
            return str(value or "")

    def _merge_duplicate_email_rows(self, keeper, duplicate):
        """Merge useful local fields from a duplicate row into the keeper row."""
        try:
            if not isinstance(keeper, dict) or not isinstance(duplicate, dict):
                return keeper
            # Preserve downloaded/cached body text if either copy has it.
            if not keeper.get("body") and duplicate.get("body"):
                keeper["body"] = duplicate.get("body", "")
                keeper["body_loaded"] = bool(keeper.get("body"))
            # Preserve the more user-managed workflow fields from saved status data when present.
            eid = keeper.get("entry_id") or duplicate.get("entry_id")
            saved = self.status_data.get(eid, {}) if eid else {}
            for field in [
                "category", "urgency", "status", "sender_type", "email_type", "sender_intent",
                "reply_intent",
                "business_relevance", "spam_likelihood", "ai_triage_reason", "followup_reason_ai",
                "followup_blocked_reason", "trusted_sender", "learned_rule_source",
                "ai_triaged_at", "ai_triage_pending", "ai_user_locked", "ai_triage_skipped",
                "sent_waiting_tracker_active", "sent_waiting_tracker_sent_timestamp"
            ]:
                if saved.get(field) not in (None, ""):
                    keeper[field] = saved.get(field)
                elif keeper.get(field) in (None, "") and duplicate.get(field) not in (None, ""):
                    keeper[field] = duplicate.get(field)
            keeper["is_new_import"] = bool(keeper.get("is_new_import") or duplicate.get("is_new_import"))
            keeper["followup_time"] = self.get_followup_display_for_email(keeper.get("entry_id", ""))
        except Exception:
            pass
        return keeper

    def dedupe_email_rows(self, reason=""):
        """Remove duplicate rows from the main in-memory email list.

        This is intentionally conservative:
        - exact Outlook EntryID duplicates are merged into one row;
        - exact sent/waiting placeholder IDs are merged into one row;
        - true Sales/My Inbox duplicate deliveries keep the Sales copy and remove the My Inbox copy.
        """
        try:
            original_count = len(getattr(self, "emails", []) or [])
            cleaned = []
            by_id = {}
            removed_ids = set()
            for email in list(getattr(self, "emails", []) or []):
                if not isinstance(email, dict):
                    continue
                entry_id = str(email.get("entry_id", "") or "").strip()
                if entry_id and self.status_data.get(entry_id, {}).get("app_deleted"):
                    continue
                key = entry_id or f"fallback:{email.get('source','')}:{email.get('conversation_id','')}:{normalize_subject_for_match(email.get('subject',''))}:{email.get('received_timestamp',0)}"
                if key in by_id:
                    keeper = by_id[key]
                    self._merge_duplicate_email_rows(keeper, email)
                    if entry_id:
                        removed_ids.add(entry_id)
                    continue
                by_id[key] = email
                cleaned.append(email)

            # Remove the My Inbox copy only when it truly looks like the same delivered item already in Sales.
            # v3.9.27 efficiency: this pass compared every My Inbox row against every other
            # row (quadratic), and it runs inside every save_cached_state(). Bucket the
            # Sales rows by (sender, normalized subject) first so each My Inbox row only
            # checks its handful of plausible twins; the final match predicate is unchanged.
            sales_buckets = {}
            for other in cleaned:
                if other.get("source") != "Sales":
                    continue
                b_sender = (str(other.get("sender_email", "") or other.get("sender", "") or "").strip().lower())
                b_subj = normalize_subject_for_match(other.get("subject", "") or "")
                if b_sender and b_subj:
                    sales_buckets.setdefault((b_sender, b_subj), []).append(other)
            final_rows = []
            for email in cleaned:
                if email.get("source") == "My Inbox":
                    duplicate_sales = None
                    m_sender = (str(email.get("sender_email", "") or email.get("sender", "") or "").strip().lower())
                    m_subj = normalize_subject_for_match(email.get("subject", "") or "")
                    for other in sales_buckets.get((m_sender, m_subj), []):
                        if other is email:
                            continue
                        if self.emails_look_like_same_sales_inbox_duplicate(email, other):
                            duplicate_sales = other
                            break
                    if duplicate_sales:
                        eid = email.get("entry_id", "")
                        if eid:
                            # Preserve the user's local decision that this duplicate should stay hidden.
                            existing = self.status_data.get(eid, {})
                            existing.update({
                                "category": email.get("category", existing.get("category", "General")),
                                "urgency": "Low",
                                "status": email.get("status", existing.get("status", "New")),
                                "app_deleted": bool(existing.get("app_deleted", False)),
                                "sales_inbox_duplicate_hidden": True,
                                "updated_at": datetime.now().isoformat(),
                                "subject": email.get("subject", existing.get("subject", "")),
                                "sender": email.get("sender", existing.get("sender", "")),
                                "source": email.get("source", existing.get("source", "")),
                            })
                            self.status_data[eid] = existing
                        continue
                final_rows.append(email)

            self.emails = final_rows
            for email in self.emails:
                if isinstance(email, dict):
                    email["message"] = None
                    if email.get("entry_id"):
                        email["followup_time"] = self.get_followup_display_for_email(email.get("entry_id", ""))
            # v3 efficiency hardening: dedupe can replace/remove rows, so rebuild
            # the O(1) index before any later get_email_by_id lookup.
            self._rebuild_email_index()
            return max(0, original_count - len(self.emails))
        except Exception:
            return 0

    def dedupe_followup_records(self):
        """Allow only one active manual follow-up and one active scenario reminder per email/type."""
        changed = False
        try:
            def active(item):
                return not item.get("completed") and not item.get("cancelled")

            # Manual followups: one active row per entry_id/conversation/group.
            best = {}
            for item in self.followups:
                if not isinstance(item, dict) or not active(item):
                    continue
                key = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                if not key:
                    continue
                score = self._safe_iso_sort_value(item.get("created_at") or item.get("due_at"))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_active_ids = {id(v[1]) for v in best.values()}
            for item in self.followups:
                if isinstance(item, dict) and active(item):
                    key = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                    if key and id(item) not in keep_active_ids:
                        item["cancelled"] = True
                        item["cancelled_at"] = datetime.now().isoformat()
                        item["cancel_reason"] = "Cancelled by duplicate cleanup; newer active follow-up exists."
                        changed = True

            # Manual follow-ups outrank automatic reminders. If old saved data
            # already has both a manual follow-up and an automatic tracker for
            # the same item, keep the manual follow-up and cancel the automatic
            # tracker so the queue does not show duplicates.
            manual_keys = set()
            for item in self.followups:
                if not isinstance(item, dict) or not active(item):
                    continue
                for val in (item.get("entry_id"), item.get("conversation_id"), item.get("group_id"), item.get("subject")):
                    if val:
                        manual_keys.add(str(val).strip().lower())
            for item in self.scenario_reminders:
                if not isinstance(item, dict) or not active(item):
                    continue
                item_keys = {str(v).strip().lower() for v in (item.get("entry_id"), item.get("conversation_id"), item.get("group_id"), item.get("subject")) if v}
                if manual_keys.intersection(item_keys):
                    item["cancelled"] = True
                    item["cancelled_at"] = datetime.now().isoformat()
                    item["cancel_reason"] = "Cancelled by duplicate cleanup; active manual follow-up exists for this item."
                    changed = True
            for item in self.pending_reply_checks:
                if not isinstance(item, dict) or not active(item):
                    continue
                item_keys = {str(v).strip().lower() for v in (item.get("entry_id"), item.get("conversation_id"), item.get("group_id"), item.get("subject")) if v}
                if manual_keys.intersection(item_keys):
                    item["cancelled"] = True
                    item["cancelled_at"] = datetime.now().isoformat()
                    item["cancel_reason"] = "Cancelled by duplicate cleanup; active manual follow-up exists for this item."
                    changed = True

            # Scenario reminders: one active automatic reminder per email/thread total.
            # The old cleanup allowed one of each type, which could still show AI +
            # vendor/customer reminders for the same item. Keep the newest active
            # automatic tracker and cancel the rest.
            best = {}
            for item in self.scenario_reminders:
                if not isinstance(item, dict) or not active(item):
                    continue
                key = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                if not key:
                    continue
                score = self._safe_iso_sort_value(item.get("created_at") or item.get("due_at"))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_active_ids = {id(v[1]) for v in best.values()}
            for item in self.scenario_reminders:
                if isinstance(item, dict) and active(item):
                    key = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                    if key and id(item) not in keep_active_ids:
                        item["cancelled"] = True
                        item["cancelled_at"] = datetime.now().isoformat()
                        item["cancel_reason"] = "Cancelled by duplicate cleanup; newer active automatic reminder exists for this item."
                        changed = True

            # Commitment reminders (v3.8.10): a thread may legitimately have several
            # (e.g. a ship date AND a quote-expiration), so we only collapse exact
            # duplicates keyed by thread + type + target date. Distinct dates/types
            # are all kept, and these never fight the scenario/manual reminders above.
            best = {}
            for item in getattr(self, "commitment_reminders", []):
                if not isinstance(item, dict) or not active(item):
                    continue
                tkey = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                if not tkey:
                    continue
                key = (str(tkey).strip().lower(), item.get("type", ""), item.get("target_date", ""))
                score = self._safe_iso_sort_value(item.get("created_at") or item.get("due_at"))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_active_ids = {id(v[1]) for v in best.values()}
            for item in getattr(self, "commitment_reminders", []):
                if isinstance(item, dict) and active(item):
                    tkey = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                    key = (str(tkey).strip().lower(), item.get("type", ""), item.get("target_date", "")) if tkey else None
                    if key and id(item) not in keep_active_ids:
                        item["cancelled"] = True
                        item["cancelled_at"] = datetime.now().isoformat()
                        item["cancel_reason"] = "Cancelled by duplicate cleanup; newer identical commitment reminder exists."
                        changed = True

            # Pending reply checks: one active row per entry_id/conversation.
            best = {}
            for item in self.pending_reply_checks:
                if not isinstance(item, dict) or not active(item):
                    continue
                key = item.get("entry_id") or item.get("conversation_id") or item.get("subject")
                if not key:
                    continue
                score = self._safe_iso_sort_value(item.get("created_at"))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_active_ids = {id(v[1]) for v in best.values()}
            for item in self.pending_reply_checks:
                if isinstance(item, dict) and active(item):
                    key = item.get("entry_id") or item.get("conversation_id") or item.get("subject")
                    if key and id(item) not in keep_active_ids:
                        item["cancelled"] = True
                        item["cancelled_at"] = datetime.now().isoformat()
                        item["cancel_reason"] = "Cancelled by duplicate cleanup; newer pending reply check exists."
                        changed = True
        except Exception:
            pass
        # v3 efficiency: clear the dirty flag — saves immediately after this
        # call don't need to run dedup again.
        self._followup_dedup_needed = False
        return changed

    def dedupe_sent_waiting_placeholders(self):
        """Keep one active sent/waiting placeholder per conversation (else per id)."""
        try:
            best = {}
            changed = False
            for item in getattr(self, "sent_waiting_placeholders", []) or []:
                if not isinstance(item, dict) or item.get("cleared"):
                    continue
                entry_id = str(item.get("entry_id", "") or "").strip()
                conversation_id = str(item.get("conversation_id", "") or "").strip()
                sent_entry_id = str(item.get("sent_entry_id", "") or "").strip()
                # v3.9.27: conversation id FIRST. The old key used entry_id first, and a
                # placeholder's entry_id is always populated, so the conversation branch
                # was dead code -- two placeholders for the SAME thread (one keyed
                # "sentwait:{conv}", one "sentwait:{sent_entry_id}" from a scan where the
                # ConversationID read failed) both survived as duplicates.
                key = (("conv:" + conversation_id) if conversation_id else "") or entry_id or sent_entry_id
                if not key:
                    continue
                score = self._safe_iso_sort_value(item.get("created_at")) or str(item.get("received_timestamp", ""))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_ids = {id(v[1]) for v in best.values()}
            for item in getattr(self, "sent_waiting_placeholders", []) or []:
                if isinstance(item, dict) and not item.get("cleared") and id(item) not in keep_ids:
                    item["cleared"] = True
                    item["cleared_at"] = datetime.now().isoformat()
                    item["cleared_reason"] = "duplicate_placeholder_cleanup"
                    changed = True
            return changed
        except Exception:
            return False

    def cleanup_duplicates(self, reason="", save=False):
        """Run all duplicate cleanup passes used after load/import/save."""
        removed = self.dedupe_email_rows(reason=reason)
        # v3 efficiency: only run the (relatively heavy) follow-up/reminder dedupe when
        # something has actually added or replaced those records. The dirty flag is set
        # by every incremental add site AND by every wholesale reload/restore of the
        # follow-up lists (see _followup_dedup_needed = True after each load/undo/reload),
        # so a False flag here genuinely means "already clean and nothing new". This keeps
        # cloud-restore/undo safe — those paths mark the flag dirty so their data is still
        # deduped — while routine save_cached_state calls no longer redo the work.
        if getattr(self, "_followup_dedup_needed", True):
            followup_changed = self.dedupe_followup_records()
        else:
            followup_changed = False
        placeholder_changed = self.dedupe_sent_waiting_placeholders()
        if placeholder_changed:
            self.sync_sent_waiting_placeholders_into_email_list()
        if save:
            if removed:
                self.flush_status_data()
            if followup_changed:
                self.save_followups()
                self.save_scenario_reminders()
                self.save_commitment_reminders()
                self.save_pending_reply_checks()
            if placeholder_changed:
                self.save_sent_waiting_placeholders()
        return removed or followup_changed or placeholder_changed

    def load_cached_state(self):
        cached = self.cache_data.get(self.get_cache_key(), {})
        try:
            # v3.8.30: prefer the durable DB copy of the scanner "already processed" id
            # sets and union it with whatever is in the cache, so a cloud restore (which
            # restores the DB but not the local cache file) does not make the scanner
            # reprocess old mail and resurrect cancelled reminders. Falls back cleanly to
            # cache-only values for installs from before this was mirrored to the DB.
            _ck = str(self.get_cache_key())
            _cache_commit = cached.get("commitment_processed_message_ids", []) or []
            _cache_sent = cached.get("sent_waiting_processed_sent_ids", []) or []
            _db_commit = load_json_from_db("scanner_commitment_processed_message_ids::" + _ck, None)
            _db_sent = load_json_from_db("scanner_sent_waiting_processed_sent_ids::" + _ck, None)
            if not isinstance(_db_commit, list):
                _db_commit = []
            if not isinstance(_db_sent, list):
                _db_sent = []
            # dict.fromkeys preserves order while de-duplicating across the two sources.
            self.commitment_processed_message_ids = list(dict.fromkeys(_db_commit + list(_cache_commit)))
            self.sent_waiting_processed_sent_ids = list(dict.fromkeys(_db_sent + list(_cache_sent)))
        except Exception:
            pass
        self.emails = []
        for e in cached.get("emails", []):
            if not isinstance(e, dict):
                continue
            saved = self.find_saved_status_for_email_fields(
                entry_id=e.get("entry_id", ""), conversation_id=e.get("conversation_id", ""),
                conversation_index=e.get("conversation_index", ""), sender_email=e.get("sender_email", ""),
                sender=e.get("sender", ""), subject=e.get("subject", ""),
                received_timestamp=e.get("received_timestamp", 0), source=e.get("source", ""),
                internet_message_id=e.get("internet_message_id", ""),
            )
            if saved.get("app_deleted"):
                continue
            if saved:
                self.apply_saved_workflow_to_email(e, saved)
                eid = e.get("entry_id", "")
                if eid:
                    healed = dict(self.status_data.get(eid, {}) or {})
                    healed.update(saved)
                    healed["entry_id"] = eid
                    self.status_data[eid] = healed
            self.emails.append(e)
        self.cleanup_duplicates(reason="load_cached_state", save=True)
        for email in self.emails:
            self.apply_saved_workflow_to_email(email)
            email["message"] = None

            cached_body = email.get("body", "") or ""
            email["body"] = cached_body
            email["body_loaded"] = bool(cached_body)

            email["is_new_import"] = False
            email["followup_time"] = self.get_followup_display_for_email(email["entry_id"])
        self.sync_sent_waiting_placeholders_into_email_list()
        self._rebuild_email_index()  # v3 efficiency: build O(1) lookup index.
        self.sort_emails_for_display()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        cached_at = cached.get("cached_at", "never")
        self.preview_text.insert(
            tk.END,
            f"Opened from saved cache.\nCached at: {cached_at}\n\n"
            "MaINbox v3 AutoPilot Mode active.\n"
            "Email bodies are cached after first load.\n"
            f"Data folder: {APP_DATA_DIR}\n"
            "AI Reply and AI Scan use the background AI engine so the UI stays responsive.\n"
            "Default Ollama model: llama3.2:3b. Override with MAINBOX_OLLAMA_MODEL if needed. MaINbox v3 includes same-subject project protection so uniform job/RFQ subjects are not auto-buried as Low/Junk."
        )

    def save_cached_state(self):
        self.cleanup_duplicates(reason="save_cached_state", save=False)
        safe_emails = []
        for email in self.emails:
            safe = dict(email)
            safe.pop("message", None)

            # Keep downloaded bodies in the local cache so they only need to be pulled from Outlook once.
            cached_body = safe.get("body", "") or ""
            safe["body_loaded"] = bool(cached_body)
            safe["body"] = cached_body

            safe["is_new_import"] = False
            safe_emails.append(safe)
        self.cache_data[self.get_cache_key()] = {
            "cached_at": datetime.now().strftime("%Y-%m-%d %I:%M %p"),
            "emails": safe_emails,
            "sent_waiting_processed_sent_ids": getattr(self, "sent_waiting_processed_sent_ids", []),
            "commitment_processed_message_ids": getattr(self, "commitment_processed_message_ids", []),
        }
        save_json(CACHE_FILE, self.cache_data)
        # v3.8.30: also persist the scanner "already processed" id sets to the durable
        # SQLite DB (keyed by cache key). The cache file is NOT part of the DB mirror and
        # is not restored by the cloud bridge, so after a cloud restore these lists used
        # to come back empty -> the scanner reprocessed old mail and could resurrect
        # commitment reminders the user had already cancelled. The DB *is* restored, so
        # mirroring them here preserves the scanner's memory across a restore/new machine.
        try:
            _ck = str(self.get_cache_key())
            save_json_to_db("scanner_commitment_processed_message_ids::" + _ck,
                            getattr(self, "commitment_processed_message_ids", []))
            save_json_to_db("scanner_sent_waiting_processed_sent_ids::" + _ck,
                            getattr(self, "sent_waiting_processed_sent_ids", []))
        except Exception:
            pass

    def save_followups(self):
        # v3 efficiency: only run dedupe when the collections are actually dirty.
        # _followup_dedup_needed is set True by any code that adds/cancels followups.
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
            self._followup_dedup_needed = False
        save_json(FOLLOWUP_FILE, self.followups)

    def save_scenario_reminders(self):
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
            self._followup_dedup_needed = False
        save_json(SCENARIO_REMINDERS_FILE, self.scenario_reminders)

    def save_commitment_reminders(self):
        # v3.8.10 dedicated lane for promised-date follow-ups (own JSON file).
        # v3.8.23 efficiency: when a batch is open (bulk sweep/import), defer the
        # expensive atomic write + dedup to a single flush at the end of the batch.
        if getattr(self, "_commitment_batch", 0):
            self._commitment_batch_dirty = True
            return
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
            self._followup_dedup_needed = False
        save_json(COMMITMENT_REMINDERS_FILE, getattr(self, "commitment_reminders", []))

    def _begin_commitment_batch(self):
        """Open a batch so per-item save_commitment_reminders()/save_cached_state()
        calls coalesce into ONE write at flush time. Safe to nest."""
        self._commitment_batch = getattr(self, "_commitment_batch", 0) + 1

    def _flush_commitment_batch(self, touched_cache=False):
        """Close a batch and perform the single deferred write(s) if anything changed."""
        depth = getattr(self, "_commitment_batch", 0)
        if depth > 1:
            self._commitment_batch = depth - 1
            return
        self._commitment_batch = 0
        wrote_reminders = bool(getattr(self, "_commitment_batch_dirty", False))
        wrote_cache = bool(getattr(self, "_commitment_batch_cache_dirty", False)) or touched_cache
        wrote_status = bool(getattr(self, "_commitment_batch_status_dirty", False))
        self._commitment_batch_dirty = False
        self._commitment_batch_cache_dirty = False
        self._commitment_batch_status_dirty = False
        if wrote_status:
            try:
                self.flush_status_data()
            except Exception:
                pass
        if wrote_reminders:
            self.save_commitment_reminders()   # batch now closed -> real write (1x dedup)
        if wrote_cache:
            try:
                self.save_cached_state()
            except Exception:
                pass

    def save_pending_reply_checks(self):
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
            self._followup_dedup_needed = False
        save_json(PENDING_REPLY_CHECKS_FILE, self.pending_reply_checks)

    def save_sent_waiting_placeholders(self):
        # v3.8.24 efficiency: defer the write while a placeholder batch is open
        # (bulk sent-reply detection), collapsing many per-item writes into one.
        if getattr(self, "_placeholder_batch", 0):
            self._placeholder_batch_dirty = True
            return
        self.dedupe_sent_waiting_placeholders()
        save_json(SENT_WAITING_PLACEHOLDERS_FILE, self.sent_waiting_placeholders)

    def _begin_placeholder_batch(self):
        """Open a batch so per-item save_sent_waiting_placeholders()/sync calls
        coalesce into one write + one resync at flush time. Safe to nest."""
        self._placeholder_batch = getattr(self, "_placeholder_batch", 0) + 1

    def _flush_placeholder_batch(self):
        depth = getattr(self, "_placeholder_batch", 0)
        if depth > 1:
            self._placeholder_batch = depth - 1
            return
        self._placeholder_batch = 0
        wrote = bool(getattr(self, "_placeholder_batch_dirty", False))
        synced = bool(getattr(self, "_placeholder_batch_sync_dirty", False))
        self._placeholder_batch_dirty = False
        self._placeholder_batch_sync_dirty = False
        if synced:
            try:
                self.sync_sent_waiting_placeholders_into_email_list()
            except Exception:
                pass
        if wrote:
            self.save_sent_waiting_placeholders()

    def _auto_group_engine_active(self):
        return bool(AUTO_GROUP_ENGINE_AVAILABLE and self.settings.get("auto_group_engine_enabled", True))

    def _get_auto_group_engine(self):
        """Return one cached plug-in instance; update thresholds on every call."""
        if not self._auto_group_engine_active():
            return None
        try:
            engine = getattr(self, "_auto_group_engine_instance", None)
            if engine is None:
                engine = AutoGroupEngine(self.settings, AUTO_GROUP_ENGINE_STATE_FILE)
                self._auto_group_engine_instance = engine
            else:
                engine.update_settings(self.settings)
            return engine
        except Exception:
            return None

    def auto_assign_plugin_group(self, email):
        """v4.1.35: THREAD-AGNOSTIC enqueue. Any thread (the Tk thread, the AI-triage
        worker, AutoPilot) may call this; it only places the email on a plain request
        queue and returns "" immediately. ALL Tk-adjacent work -- snapshotting live
        collections, pending bookkeeping, worker startup, decision application --
        happens in the main-thread poll (_age_poll), so no background thread ever
        touches root.after()/Tk or iterates a live structure the UI is mutating."""
        if not email or not self._auto_group_engine_active():
            return ""
        eid = str(email.get("entry_id", "") or "")
        if not eid or self.get_group_id_for_email(eid):
            return ""
        try:
            # dict.setdefault is atomic under the GIL: racing threads share ONE queue.
            q = self.__dict__.setdefault("_age_request_queue", queue.Queue())
            q.put(email)
        except Exception:
            pass
        return ""

    def _check_plugin_health(self):
        """v4.1.35 (F4): plug-in presence/version health, surfaced loudly ONCE at
        startup when an ENABLED engine is unavailable, and always stamped into the
        status bar. Sourced from the import-time capture that nothing displayed."""
        problems = []
        lines = []
        if AUTO_GROUP_ENGINE_AVAILABLE:
            lines.append(f"Auto-Group Engine: Loaded v{AUTO_GROUP_ENGINE_VERSION}")
        else:
            lines.append("Auto-Group Engine: UNAVAILABLE")
            if self.settings.get("auto_group_engine_enabled", True):
                problems.append("Auto-Group Engine unavailable -- unified grouping is OFF (legacy rules active).\n"
                                + str(_AUTO_GROUP_ENGINE_IMPORT_ERROR or "module missing"))
        if COVERAGE_INTAKE_ENGINE_AVAILABLE:
            lines.append(f"Coverage Intake Engine: Loaded v{COVERAGE_INTAKE_ENGINE_VERSION}")
        else:
            lines.append("Coverage Intake Engine: UNAVAILABLE")
            if self.settings.get("coverage_intake_engine_enabled", True):
                problems.append("Coverage Intake Engine unavailable -- customer-attachment ingestion is PAUSED\n"
                                "(rows are quarantined to Attachment Review, not committed).\n"
                                + str(_COVERAGE_INTAKE_IMPORT_ERROR or "module missing"))
        if PO_MATCH_ENGINE_AVAILABLE:
            lines.append(f"PO-Match Engine: Loaded v{PO_MATCH_ENGINE_VERSION}")
        else:
            lines.append("PO-Match Engine: UNAVAILABLE")
            if self.settings.get("po_match_engine_enabled", True):
                problems.append("PO-Match Engine unavailable -- automatic PO-award detection is OFF\n"
                                "(customer POs will not be auto-matched to jobs; handle them manually).\n"
                                + str(_PO_MATCH_ENGINE_IMPORT_ERROR or "module missing"))
        self._plugin_health_lines = lines
        try:
            if problems:
                self.ai_status_var.set("PLUG-IN PROBLEM: " + lines[0] if "UNAVAILABLE" in lines[0] else "PLUG-IN PROBLEM: " + lines[-1])
                messagebox.showwarning(
                    "MaINbox plug-in health",
                    "\n".join(lines) + "\n\n" + "\n\n".join(problems)
                    + "\n\nPlace the current engine .py files next to the .pyw and restart.")
            else:
                self.ai_status_var.set(" | ".join(lines))
        except Exception:
            pass

    def _age_bootstrap(self):
        """v4.1.35: MAIN THREAD, once at startup. Creates all queues, starts the single
        engine worker, and starts the permanent poll that is the only bridge between
        background threads and Tk."""
        self.__dict__.setdefault("_age_request_queue", queue.Queue())
        # v4.1.35: idempotent -- a second call must NEVER replace queues the live
        # worker is blocked on (it would strand the worker on the old object forever).
        if getattr(self, "_age_task_queue", None) is None:
            self._age_task_queue = queue.Queue()
        if getattr(self, "_age_result_queue", None) is None:
            self._age_result_queue = queue.Queue()
        if getattr(self, "_age_pending_ids", None) is None:
            self._age_pending_ids = set()
        if getattr(self, "_age_render_scheduled", None) is None:
            self._age_render_scheduled = False
        t = getattr(self, "_age_worker_thread", None)
        if t is None or not t.is_alive():
            t = threading.Thread(target=self._auto_group_worker_loop,
                                 name="AutoGroupEngineWorker", daemon=True)
            self._age_worker_thread = t
            t.start()
        if not getattr(self, "_age_poll_started", False):
            self._age_poll_started = True
            self.root.after(150, self._age_poll)

    def _age_poll(self):
        """v4.1.35: permanent main-thread poll. Drains grouping REQUESTS (snapshot +
        pending bookkeeping + hand to worker) and engine RESULTS (apply on Tk thread).
        Cheap when idle: two queue emptiness checks every 150 ms."""
        try:
            req_q = getattr(self, "_age_request_queue", None)
            drained = []
            if req_q is not None:
                while True:
                    try:
                        drained.append(req_q.get_nowait())
                    except queue.Empty:
                        break
            if drained and self._auto_group_engine_active():
                snapshot = self._age_build_snapshot()
                for email in drained:
                    if not isinstance(email, dict):
                        continue
                    eid = str(email.get("entry_id", "") or "")
                    if not eid or eid in self._age_pending_ids or self.get_group_id_for_email(eid):
                        continue
                    self._age_pending_ids.add(eid)
                    email["auto_group_engine_action"] = "pending"
                    # the worker reads a copy; only the poll/apply touch the live dict
                    self._age_task_queue.put(("decide", email, dict(email), snapshot))
            res_q = getattr(self, "_age_result_queue", None)
            if res_q is not None:
                while True:
                    try:
                        live_email, decision = res_q.get_nowait()
                    except queue.Empty:
                        break
                    try:
                        self._apply_plugin_group_decision(live_email, decision)
                    except Exception:
                        try:
                            self._age_pending_ids.discard(str((live_email or {}).get("entry_id", "") or ""))
                        except Exception:
                            pass
        except Exception:
            pass  # the poll must always reschedule
        try:
            self.root.after(150, self._age_poll)
        except Exception:
            self._age_poll_started = False

    def _age_build_snapshot(self):
        """v4.1.35: MAIN THREAD ONLY. Shallow snapshot of the collections the engine
        iterates; element dicts stay shared and are read-only on the worker."""
        try:
            qc = getattr(self, "quote_coverage", {}) or {}
            cov = {"updated_at": qc.get("updated_at", ""), "threads": dict(qc.get("threads", {}) or {})}
        except Exception:
            cov = {}
        return (
            list(self.emails),
            {"groups": list(self.groups_data.get("groups", []) or []),
             "memberships": dict(self.groups_data.get("memberships", {}) or {})},
            cov,
            {"group_rules": dict((getattr(self, "learning_data", {}) or {}).get("group_rules", {}) or {})},
        )

    def _auto_group_worker_loop(self):
        """v4.1.35: sole owner of AutoGroupEngine calls. Consumes tasks, produces plain
        result tuples on the result queue. NEVER touches Tk, COM, or live collections;
        must never die."""
        while True:
            try:
                task = self._age_task_queue.get()
            except Exception:
                return
            try:
                kind = task[0]
                engine = self._get_auto_group_engine()
                if kind == "feedback":
                    _k, em_copy, target_gid, prev_gid, reason = task
                    if engine is not None:
                        try:
                            engine.record_feedback(em_copy, target_gid, previous_group_id=prev_gid, reason=reason)
                        except Exception:
                            pass
                    continue
                _k, live_email, em_copy, snapshot = task
                decision = None
                if engine is not None and snapshot:
                    emails_s, groups_s, cov_s, learn_s = snapshot
                    try:
                        decision = engine.decide(email=em_copy, groups_data=groups_s, emails=emails_s,
                                                 quote_coverage=cov_s, learning_data=learn_s)
                    except Exception as exc:
                        decision = {"action": "none", "group_id": "", "confidence": 0.0,
                                    "reason": "", "evidence_families": [],
                                    "error": f"{type(exc).__name__}: {exc}"[:240]}
                self._age_result_queue.put((live_email, decision))
            except Exception:
                pass  # never let the worker thread die

    def _apply_plugin_group_decision(self, email, decision):
        """v4.1.35: MAIN THREAD (called only by _age_poll). Records the decision and
        applies an AUTO grouping with fresh re-checks; on engine None, replays a stored
        AI group suggestion that was deferred while the decision was pending."""
        eid = str((email or {}).get("entry_id", "") or "")
        try:
            self._age_pending_ids.discard(eid)
        except Exception:
            pass
        if not email:
            return
        if not isinstance(decision, dict):
            email["auto_group_engine_action"] = "none"
            self._age_replay_deferred_suggestion(email)
            return
        if decision.get("error"):
            email["auto_group_engine_error"] = str(decision.get("error", ""))[:240]
            email["auto_group_engine_action"] = "none"
            self._age_replay_deferred_suggestion(email)
            return
        email["auto_group_engine_decision"] = decision
        email["auto_group_engine_action"] = str(decision.get("action", "none") or "none")
        email["auto_group_engine_group_id"] = str(decision.get("group_id", "") or "")
        email["auto_group_engine_confidence"] = float(decision.get("confidence", 0) or 0)
        email["auto_group_engine_reason"] = str(decision.get("reason", "") or "")[:1500]
        email["auto_group_engine_families"] = list(decision.get("evidence_families", []) or [])
        action = decision.get("action")
        if action == "none":
            self._age_replay_deferred_suggestion(email)
            return
        if action != "auto":
            email.pop("pending_group_suggestion", None)  # the engine's own suggestion outranks the AI's
            return
        email.pop("pending_group_suggestion", None)
        gid = str(decision.get("group_id", "") or "")
        if not gid or not eid or not self.get_group_by_id(gid):
            return
        if self.get_group_id_for_email(eid):
            return  # something else grouped it while the decision was pending
        try:
            if self.workflow_record_is_closed(email) or email.get("closed_guard_applied"):
                return
        except Exception:
            pass
        self.groups_data.setdefault("memberships", {})[eid] = gid
        email["auto_group_engine_rule"] = "unified_scorer"
        self.mark_group_has_new(gid, save=False)  # v4.1.35: save_groups() below is the single write
        self.save_groups()
        try:
            self._assistant_log_autogroup(
                email, gid,
                reason=(f"Auto-Group Engine {decision.get('confidence', 0):.0%}: "
                        f"{decision.get('reason', '')}"),
                rule="auto_group_engine")
        except Exception:
            pass
        try:
            group = self.get_group_by_id(gid)
            if group:
                self.ai_status_var.set(f"Group: related email added to {group.get('name', '')}")
        except Exception:
            pass
        self._age_schedule_render()

    def _age_replay_deferred_suggestion(self, email):
        """v4.1.35: the engine said None (or errored) -- an AI suggestion stored while
        the decision was pending may now proceed through its ORIGINAL path."""
        try:
            sug = email.pop("pending_group_suggestion", None)
            if not isinstance(sug, dict):
                return
            eid = str(email.get("entry_id", "") or "")
            gid = str(sug.get("group_id", "") or "")
            if not eid or not gid or self.get_group_id_for_email(eid) or not self.get_group_by_id(gid):
                return
            if sug.get("mode") == "direct":
                # AutoPilot no-prompt context applied directly before v4.1.35.
                self.groups_data.setdefault("memberships", {})[eid] = gid
                self.mark_group_has_new(gid, save=False)
                self.save_groups()
                self._age_schedule_render()
            else:
                self._offer_ai_group_suggestion(
                    email, gid,
                    float(sug.get("confidence", 0) or 0),
                    str(sug.get("reason", "") or ""),
                    bool(sug.get("allow_group_prompt", True)))
        except Exception:
            pass

    def _age_schedule_render(self):
        """v4.1.35: one debounced groups/emails re-render per burst of async decisions."""
        if getattr(self, "_age_render_scheduled", False):
            return
        self._age_render_scheduled = True
        def _do():
            self._age_render_scheduled = False
            try:
                self.render_group_rows()
            except Exception:
                pass
            try:
                self.render_email_rows()
            except Exception:
                pass
        try:
            self.root.after(500, _do)
        except Exception:
            self._age_render_scheduled = False

    def _apply_plugin_suggestion_to_ai_result(self, email, result):
        """Feed a conservative SUGGEST decision into the existing Assistant prompt path."""
        try:
            dec = email.get("auto_group_engine_decision", {}) if isinstance(email, dict) else {}
            if not isinstance(dec, dict) or dec.get("action") != "suggest":
                return result
            gid = str(dec.get("group_id", "") or "")
            if not gid or not self.get_group_by_id(gid):
                return result
            result = dict(result or {})
            result["suggested_group_id"] = gid
            result["group_confidence"] = float(dec.get("confidence", 0) or 0)
            result["reason"] = "Auto-Group Engine suggestion: " + str(dec.get("reason", "") or "")
            return result
        except Exception:
            return result

    def save_groups(self):
        # v4.1.19: every membership mutation path ends here -- drop the conversation->group
        # routing cache so coverage can never route a vendor reply via a stale membership.
        # (The cache signature also fingerprints membership contents; this is belt-and-braces.)
        try:
            self._conv_group_idx = None
        except Exception:
            pass
        try:
            _age = getattr(self, "_auto_group_engine_instance", None)
            if _age is not None:
                _age.invalidate()
        except Exception:
            pass
        save_json(GROUPS_FILE, self.groups_data)

    def _unique_group_id(self):
        """v4.1.10: a guaranteed-unique group id. The raw microsecond timestamp could repeat
        (two creations in the same tick) or collide with an id already on disk; a duplicate id
        makes memberships ambiguous and used to crash the groups tree at startup. Suffix with
        a counter until the id is unused."""
        try:
            existing = {str((g or {}).get("id", "")) for g in self.groups_data.get("groups", [])}
        except Exception:
            existing = set()
        base = f"grp_{datetime.now().strftime('%Y%m%d%H%M%S%f')}"
        gid = base
        n = 0
        while gid in existing:
            n += 1
            gid = f"{base}_{n}"
        return gid

    def get_group_by_id(self, group_id):
        # v2.9.8: direct single-email RFQ support. These temporary RFQ groups
        # are not shown in the Groups/Quote Jobs list, but let the existing
        # Quote RFQ extractor/window reuse the same safe code path.
        try:
            temp_groups = getattr(self, "_single_email_rfq_groups", {}) or {}
            if group_id in temp_groups:
                return temp_groups[group_id].get("group")
        except Exception:
            pass
        for group in self.groups_data.get("groups", []):
            if group.get("id") == group_id:
                return group
        return None

    def get_group_id_for_email(self, entry_id):
        return self.groups_data.get("memberships", {}).get(entry_id, "")

    def get_group_name_for_email(self, entry_id):
        group_id = self.get_group_id_for_email(entry_id)
        group = self.get_group_by_id(group_id)
        return group.get("name", "") if group else ""

    def mark_group_has_new(self, group_id, save=True):
        # v4.1.35: save= lets callers that immediately save_groups() themselves skip
        # the internal write -- the engine-decision apply was double-writing the store.
        group = self.get_group_by_id(group_id)
        if group:
            group["has_new"] = True
            if save:
                self.save_groups()

    def mark_group_seen(self, group_id):
        group = self.get_group_by_id(group_id)
        if group and group.get("has_new"):
            group["has_new"] = False
            self.save_groups()
            self.render_group_rows()
            self.render_email_rows()

    def _normalized_thread_subject(self, subject):
        """Normalize Outlook thread subjects so RE:/FW: replies stay grouped together."""
        value = str(subject or "").strip().lower()
        changed = True
        while changed:
            old_value = value
            value = re.sub(r"^\s*(re|fw|fwd)\s*:\s*", "", value, flags=re.I).strip()
            changed = value != old_value
        value = re.sub(r"\s+", " ", value)
        return value

    def find_group_id_for_conversation(self, conversation_id, skip_entry_id=""):
        """Find an existing group by Outlook conversation id first."""
        if not conversation_id:
            return ""
        memberships = self.groups_data.get("memberships", {})
        for existing in self.emails:
            if skip_entry_id and existing.get("entry_id") == skip_entry_id:
                continue
            if existing.get("conversation_id") == conversation_id:
                group_id = memberships.get(existing.get("entry_id", ""), "")
                if group_id and self.get_group_by_id(group_id):
                    return group_id
        return ""

    def find_group_id_for_thread(self, email, skip_entry_id=""):
        """Highest priority grouping rule: keep an existing thread/conversation in its group.

        Priority:
        1. Outlook conversation_id match
        2. Normalized subject match among already-grouped emails

        This prevents replies/back-and-forth messages from being reassigned to the wrong group
        by sender/keyword/AI guesses.
        """
        if not email:
            return ""

        memberships = self.groups_data.get("memberships", {})
        conversation_id = email.get("conversation_id", "")

        group_id = self.find_group_id_for_conversation(conversation_id, skip_entry_id=skip_entry_id)
        if group_id:
            return group_id

        subject_key = self._normalized_thread_subject(email.get("subject", ""))
        if not subject_key:
            return ""

        best_group_id = ""
        best_seen = ""

        for existing in self.emails:
            existing_id = existing.get("entry_id", "")
            if skip_entry_id and existing_id == skip_entry_id:
                continue

            existing_group_id = memberships.get(existing_id, "")
            if not existing_group_id or not self.get_group_by_id(existing_group_id):
                continue

            existing_subject_key = self._normalized_thread_subject(existing.get("subject", ""))
            if existing_subject_key and existing_subject_key == subject_key:
                seen = existing.get("received_time", "") or existing.get("sent_time", "") or existing.get("date", "")
                if not best_group_id or str(seen) > str(best_seen):
                    best_group_id = existing_group_id
                    best_seen = seen

        return best_group_id

    def _group_tokens_for_email(self, email):
        if not email:
            return set()
        return extract_group_match_tokens(" ".join([
            str(email.get("subject", "") or ""),
            str(email.get("body", "") or "")[:1200],
        ]))

    def _group_tokens_for_group(self, group_id):
        group = self.get_group_by_id(group_id)
        if not group:
            return set(), set()
        name_tokens = extract_group_match_tokens(group.get("name", ""))
        member_tokens = set()
        count = 0
        memberships = self.groups_data.get("memberships", {})
        for item in sorted(self.emails, key=lambda e: e.get("received_timestamp", 0), reverse=True):
            if memberships.get(item.get("entry_id", ""), "") != group_id:
                continue
            member_tokens.update(extract_group_match_tokens(item.get("subject", "")))
            count += 1
            if count >= 12:
                break
        return name_tokens, member_tokens

    def find_group_id_by_business_key(self, email):
        """Find the safest existing group using job/PO/project identifiers.

        This intentionally avoids fuzzy generic subjects and domain-only rules.
        It only returns a group when one clear winner has matching business keys.
        """
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if entry_id and self.get_group_id_for_email(entry_id):
            return ""
        email_tokens = self._group_tokens_for_email(email)
        if not email_tokens:
            return ""

        ranked = []
        for group in self.groups_data.get("groups", []) or []:
            group_id = group.get("id", "")
            if not group_id or group.get("archived"):
                continue
            name_tokens, member_tokens = self._group_tokens_for_group(group_id)
            name_hits = email_tokens & name_tokens
            member_hits = email_tokens & member_tokens
            if not name_hits and not member_hits:
                continue
            score = 0
            score += sum(60 + min(len(t), 12) for t in name_hits)
            score += sum(25 + min(len(t), 12) for t in member_hits)
            # Prefer active/non-completed groups when scores tie.
            group_emails = self.get_emails_for_group(group_id)
            active_count = sum(1 for e in group_emails if e.get("status") != "Completed" and e.get("urgency") != "Low")
            score += min(active_count, 5)
            ranked.append((score, group_id, group.get("name", ""), sorted(name_hits | member_hits),
                           len(name_hits | member_hits), bool(member_hits)))

        if not ranked:
            return ""
        ranked.sort(reverse=True, key=lambda row: row[0])
        best = ranked[0]
        # Require a clear score and avoid ties between multiple possible groups.
        if best[0] < 60:
            return ""
        if len(ranked) > 1 and ranked[1][0] >= best[0] - 10:
            return ""
        # Don't auto-file on a single coincidental token: require either >=2 distinct shared
        # tokens, or at least one member-subject hit (a lone group-name hit is too weak).
        if best[4] < 2 and not best[5]:
            return ""
        email["business_group_rule"] = ",".join(best[3])
        return best[1]

    def auto_assign_business_key_group(self, email):
        """Auto-group using strong job/PO/project tokens before weaker rules."""
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if not entry_id or self.get_group_id_for_email(entry_id):
            return ""
        group_id = self.find_group_id_by_business_key(email)
        if group_id:
            self.groups_data.setdefault("memberships", {})[entry_id] = group_id
            self.mark_group_has_new(group_id)
            self.save_groups()
            return group_id
        return ""

    def _parse_pa_template_target(self, subject):
        """If a subject is the RFQ extractor's OWN template --
        'Price and Availability Request - <X>' (under any stack of Re:/Fw:/Fwd:
        prefixes) -- return <X>, the group name/job the RFQ was sent for. Else ''.
        The extractor builds outbound subjects this way (see the RFQ window), so a
        reply naming <X> is an explicit, app-authored reference to its group."""
        s = str(subject or "").strip()
        s = re.sub(r"^(?:\s*(?:re|fw|fwd)\s*:\s*)+", "", s, flags=re.I)
        m = re.match(r"price\s+and\s+availability\s+request\s*[-:\u2013\u2014]\s*(.+)$", s, flags=re.I)
        if not m:
            return ""
        return m.group(1).strip()

    def _group_match_codes(self, group_id):
        """Match codes for the high-confidence RFQ-template grouping: a group's
        normal job tokens PLUS loose 4+ digit runs from its name and recent member
        subjects. The looser runs let a reply that quotes only the bare job number
        (e.g. 'Price and Availability Request - 240950 - (Q# 11658689)') still match a
        group named 'EJ- 240950 - Cable', which the conservative tokenizer compounds
        into '240950cable' and would otherwise miss."""
        group = self.get_group_by_id(group_id)
        if not group:
            return set()
        codes = set(extract_group_match_tokens(group.get("name", "")))
        codes |= set(re.findall(r"\d{4,}", group.get("name", "")))
        memberships = self.groups_data.get("memberships", {})
        count = 0
        for item in sorted(self.emails, key=lambda e: e.get("received_timestamp", 0), reverse=True):
            if memberships.get(item.get("entry_id", ""), "") != group_id:
                continue
            subj = item.get("subject", "")
            codes |= set(extract_group_match_tokens(subj))
            codes |= set(re.findall(r"\d{4,}", subj))
            count += 1
            if count >= 12:
                break
        return codes

    def find_group_id_by_pa_template(self, email):
        """Deterministic grouping for the app's own RFQ template. Because the
        extractor writes 'Price and Availability Request - <group name>', a reply
        'Re: Price and Availability Request - <X>' names its group explicitly. We
        match <X> to a live group by job token first (so 'TEST 1586-170' still
        catches a reply that says only '1586-170'), then by exact/contained name --
        no fuzzy gating, since this template is authored by MaINbox itself. A single
        clear winner is required; if two groups match, we defer to weaker rules."""
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if entry_id and self.get_group_id_for_email(entry_id):
            return ""
        target = self._parse_pa_template_target(email.get("subject", ""))
        if not target:
            return ""
        target_tokens = extract_group_match_tokens(target)
        target_codes = set(target_tokens) | set(re.findall(r"\d{4,}", target))
        norm_target = normalize_subject_for_match(target)
        # A bare generic tail ("Quote Request") with no job code is not a reference.
        if not target_codes and is_generic_group_subject(target):
            return ""
        token_matches, name_matches = [], []
        for group in self.groups_data.get("groups", []) or []:
            gid = group.get("id", "")
            if not gid or group.get("archived"):
                continue
            if target_codes and (target_codes & self._group_match_codes(gid)):
                token_matches.append(gid)
                continue
            gnorm = normalize_subject_for_match(group.get("name", ""))
            if norm_target and gnorm and (
                    norm_target == gnorm
                    or (len(norm_target) >= 6 and (norm_target in gnorm or gnorm in norm_target))):
                name_matches.append(gid)
        picks = token_matches or name_matches
        if len(picks) == 1:
            email["pa_template_rule"] = target
            return picks[0]
        return ""

    def auto_assign_pa_template_group(self, email):
        """Auto-group an RFQ-template reply onto its group before any weaker rule."""
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if not entry_id or self.get_group_id_for_email(entry_id):
            return ""
        gid = self.find_group_id_by_pa_template(email)
        if gid:
            self.groups_data.setdefault("memberships", {})[entry_id] = gid
            self.mark_group_has_new(gid)
            self.save_groups()
            return gid
        return ""

    def retroactively_group_pa_template_replies(self):
        """Re-apply the deterministic 'Price and Availability Request - <X>' grouping to any
        still-ungrouped email. The pa_template matcher improves over time (e.g. bare job numbers
        in v3.9.74), but nothing re-evaluates an email already imported under an older matcher --
        it would otherwise stay ungrouped forever even after the matcher is fixed. Cheap: a
        non-template subject exits at the first check, so only real RFQ-template replies do any
        group matching. Returns the count newly grouped."""
        changed = 0
        try:
            for email in list(self.emails):
                eid = email.get("entry_id", "")
                if not eid or self.get_group_id_for_email(eid):
                    continue
                if not self._parse_pa_template_target(email.get("subject", "")):
                    continue
                gid = self.auto_assign_pa_template_group(email)
                if gid:
                    changed += 1
                    try:
                        self._assistant_log_autogroup(
                            email, gid,
                            reason="Retroactive match to the RFQ 'Price and Availability Request - <name>' template.",
                            rule="pa_template_retro")
                    except Exception:
                        pass
        except Exception:
            pass
        return changed

    def rescue_wrongly_buried_active_thread_emails(self):
        """Heal (and permanently guard against) emails forced to Low + hidden and then
        skipped by the import-time grouping pass -- the failure the v4.1.8 suppression
        fix stops at the source. The wrongful Low is persisted to disk (the hidden flag
        is not), so the code fix alone cannot un-bury mail already hidden in an earlier
        session; this sweep does, and also catches any future case where an important
        message ends up Low + ungrouped for any reason.

        Deliberately conservative. It only touches a *Low* email that is NOT user-locked
        and NOT Completed, that has NO genuine Sales duplicate (so correct de-dup is left
        alone -- only wrongly-hidden mail with no real twin qualifies), that clearly
        belongs to an *active* (non-archived) group by one of the STRONG deterministic
        rules already trusted for auto-grouping -- an exact thread/subject match or a
        clear job/PO business key -- and that reads as real work (is_meaningful_
        reactivation_reply), never a bare thanks / FYI / auto-reply. For such an email it
        restores Normal urgency so it is visible again, files it into its group if it was
        left ungrouped, and logs the action to the assistant activity log so it is
        visible and undoable. Genuine junk marked Low never matches an active RFQ group
        by these rules, so it stays buried. Bounded so it stays cheap on large mailboxes.
        Returns the count rescued."""
        rescued = 0
        try:
            memberships = self.groups_data.get("memberships", {})
            # Prebuilt indexes so the per-email checks stay O(1): normalized subjects that
            # already live in a group (for the exact-thread test), and Sales emails keyed
            # by normalized subject (for the genuine-duplicate test).
            grouped_subjects = set()
            sales_by_subj = {}
            for e in self.emails:
                if memberships.get(e.get("entry_id", ""), ""):
                    ks = self._normalized_thread_subject(e.get("subject", ""))
                    if ks:
                        grouped_subjects.add(ks)
                if e.get("source") == "Sales":
                    sk = normalize_subject_for_match(e.get("subject", "") or "")
                    if sk:
                        sales_by_subj.setdefault(sk, []).append(e)
            attempts = 0
            _now_ts = datetime.now().timestamp()
            for email in list(self.emails):
                if attempts >= 60:
                    break
                if email.get("urgency") != "Low" or email.get("ai_user_locked"):
                    continue
                if email.get("status") == "Completed":
                    continue
                eid = email.get("entry_id", "")
                if not eid:
                    continue
                _saved = self.status_data.get(eid, {}) if isinstance(self.status_data, dict) else {}
                if not isinstance(_saved, dict):
                    _saved = {}
                # v4.1.37 (1): a persisted duplicate marker means this Low is CORRECT
                # de-dup -- twin cached or not. The old test only saw twins still in the
                # bounded in-memory list, so old duplicates whose Sales copy aged out
                # were "rescued" back to Normal on every refresh.
                if email.get("sales_inbox_duplicate_hidden") or _saved.get("sales_inbox_duplicate_hidden"):
                    continue
                # v4.1.37 (2): the v4.1.8 burial happens AT IMPORT -- only recent mail can
                # be its victim. Months-old mail flipping back to Normal is exactly the
                # resurfacing complaint, never the bug this sweep exists to heal.
                try:
                    if float(email.get("received_timestamp", 0) or 0) < _now_ts - 21 * 86400:
                        continue
                except Exception:
                    pass
                # v4.1.37 (3): one-shot. rescued_at set + Low again = the email was
                # re-buried ON PURPOSE after a rescue (user re-Low, or a later decision).
                # Rescuing it again would loop forever against the user.
                if email.get("rescued_at") or _saved.get("rescued_at"):
                    continue
                # v4.1.37 (4): an explicit user-locked closure in the machine ledger always wins.
                try:
                    _grec = self._find_closed_email_guard(email, saved_record=_saved)
                    if _grec and _grec.get("ai_user_locked"):
                        continue
                except Exception:
                    pass
                subj = email.get("subject", "")
                subj_key = self._normalized_thread_subject(subj)
                has_token = bool(extract_group_match_tokens(subj))
                # Cheap gate: only real thread/job replies are worth checking -- the bulk of
                # low-value mail shares no grouped subject and carries no job/PO code.
                if not has_token and subj_key not in grouped_subjects:
                    continue
                attempts += 1
                # Never un-bury a My Inbox copy that is a GENUINE duplicate of a Sales email:
                # that Low is correct de-dup, not the bug. Only wrongly-hidden mail (no real
                # twin) qualifies for rescue.
                if email.get("source") == "My Inbox":
                    twin_subj = normalize_subject_for_match(subj or "")
                    if any(self.emails_look_like_same_sales_inbox_duplicate(email, o)
                           for o in sales_by_subj.get(twin_subj, [])):
                        continue
                already_gid = self.get_group_id_for_email(eid)
                gid = already_gid
                rule = "existing"
                if not gid and subj_key in grouped_subjects:
                    gid = self.find_group_id_for_thread(email, skip_entry_id=eid)
                    rule = "thread"
                if not gid and has_token:
                    gid = self.find_group_id_by_business_key(email)
                    rule = "business_key"
                if not gid:
                    continue
                group = self.get_group_by_id(gid)
                if not group or group.get("archived"):
                    continue
                # Only rescue a message that actually represents work (a price/quote reply, a
                # request, a PO), never a passive thanks / FYI / auto-reply.
                if not self.is_meaningful_reactivation_reply(email, body=email.get("body", "")):
                    continue
                newly_grouped = False
                if not already_gid:
                    self.groups_data.setdefault("memberships", {})[eid] = gid
                    email["business_group_rule" if rule == "business_key" else "thread_group_rule"] = (
                        email.get("business_group_rule", "") or "rescued")
                    self.mark_group_has_new(gid)
                    newly_grouped = True
                # Un-bury: restore a visible urgency and clear the stale duplicate-hidden flag.
                email["urgency"] = "Normal"
                email.pop("sales_inbox_duplicate_hidden", None)
                email.pop("sales_inbox_duplicate_hidden_at", None)
                email["rescued_at"] = datetime.now().isoformat()  # v4.1.37: one rescue per email, ever
                try:
                    if isinstance(self.status_data.get(eid), dict):
                        self.status_data[eid].pop("sales_inbox_duplicate_hidden", None)
                        self.status_data[eid].pop("sales_inbox_duplicate_hidden_at", None)
                except Exception:
                    pass
                self.save_record(email)
                self.save_groups()
                rescued += 1
                try:
                    if newly_grouped:
                        detail = "(exact subject match)" if rule == "thread" else "(job/PO key match)"
                        why = ("Restored from a wrongful Low urgency and grouped into its active thread "
                               + detail + "; it reads as real work and should not have been hidden.")
                    else:
                        why = ("Restored from a wrongful Low urgency; it belongs to this active group and "
                               "reads as real work, so it should not have been hidden.")
                    self._assistant_log_autogroup(email, gid, reason=why, rule="rescue_" + rule)
                except Exception:
                    pass
            if rescued:
                try:
                    self.flush_status_data()
                except Exception:
                    pass
        except Exception:
            pass
        return rescued


    def auto_assign_same_thread_group(self, email):
        """If an email belongs to an already-grouped thread, auto-add it before AI rules.
        v3.9.10: domain guard -- refuse auto-group when both sides have a resolved
        SMTP domain and the new email's domain is absent from the existing group."""
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if not entry_id or self.get_group_id_for_email(entry_id):
            return ""

        group_id = self.find_group_id_for_thread(email, skip_entry_id=entry_id)
        if group_id:
            new_domain = get_email_domain(email.get("resolved_sender_smtp", ""))
            if new_domain:
                group_emails = self.get_emails_for_group(group_id)
                group_domains = {get_email_domain(e.get("resolved_sender_smtp", ""))
                                 for e in group_emails}
                group_domains.discard("")
                if group_domains and new_domain not in group_domains:
                    return ""
            self.groups_data.setdefault("memberships", {})[entry_id] = group_id
            email["thread_group_rule"] = "conversation_or_subject"
            self.mark_group_has_new(group_id)
            self.save_groups()
            return group_id

        return ""

    def is_meaningful_reactivation_reply(self, email, body=""):
        """Return True when a new inbound reply should wake up a dormant low/completed thread.

        This is intentionally conservative: short thanks/FYI/auto replies do not revive work,
        but requests to revise, add, change, quote, price, order, approve, or answer do.
        """
        text = f"{email.get('subject', '')}\n{body or email.get('body', '')}\n{email.get('sender_intent', '')}".lower()
        text = re.sub(r"\s+", " ", text).strip()

        if not text:
            return False

        passive_phrases = [
            "thank you", "thanks", "received", "got it", "sounds good", "ok", "okay",
            "fyi", "for your records", "auto reply", "automatic reply", "out of office",
            "unsubscribe", "delivery status notification", "read receipt"
        ]
        if len(text) < 90 and any(p in text for p in passive_phrases):
            return False

        active_phrases = [
            "add", "change", "revise", "revision", "update", "updated", "modify",
            "another", "also need", "can you", "could you", "please", "quote",
            "pricing", "price", "availability", "lead time", "eta", "order",
            "po", "purchase order", "approval", "approve", "send over",
            "need", "needed", "request", "rfq", "attached", "see attached",
            "submittal", "drawing", "spec", "replace", "substitute"
        ]
        if any(p in text for p in active_phrases):
            return True

        try:
            quick = quick_sender_intent_analysis(
                email.get("subject", ""),
                email.get("sender_email") or email.get("sender", ""),
                body or email.get("body", ""),
                related_count=int(email.get("same_subject_related_count", 0) or 0),
                source=email.get("source", "")
            )
            if quick.get("workflow_category") in ("Quote / Estimate", "Customer Issue", "Vendor / Supplier"):
                if quick.get("status") == "Needs Reply" or float(quick.get("business_relevance", 0) or 0) >= 0.65:
                    return True
        except Exception:
            pass

        return False

    def find_dormant_thread_context(self, email):
        """Find prior low/completed records in this email's thread/group."""
        if not email:
            return None

        entry_id = email.get("entry_id", "")
        conversation_id = email.get("conversation_id", "")
        subject_key = self._normalized_thread_subject(email.get("subject", ""))
        memberships = self.groups_data.get("memberships", {})
        current_group_id = self.find_group_id_for_thread(email, skip_entry_id=entry_id)

        best = None
        for existing in self.emails:
            existing_id = existing.get("entry_id", "")
            if not existing_id or existing_id == entry_id:
                continue

            same_thread = False
            if conversation_id and existing.get("conversation_id") == conversation_id:
                same_thread = True
            elif subject_key and self._normalized_thread_subject(existing.get("subject", "")) == subject_key:
                same_thread = True
            elif current_group_id and memberships.get(existing_id, "") == current_group_id:
                same_thread = True

            if not same_thread:
                continue

            saved = self.status_data.get(existing_id, {}) or {}
            existing_urgency = saved.get("urgency") or existing.get("urgency", "")
            existing_status = saved.get("status") or existing.get("status", "")
            existing_deleted = bool(saved.get("app_deleted", False))
            existing_group_id = memberships.get(existing_id, "") or current_group_id
            group = self.get_group_by_id(existing_group_id) if existing_group_id else None
            group_low = bool(group and group.get("urgency") == "Low")
            group_archived = bool(group and group.get("archived", False))

            if existing_deleted or existing_urgency == "Low" or existing_status == "Completed" or group_low or group_archived:
                seen = existing.get("received_timestamp", 0) or existing.get("sent_timestamp", 0) or 0
                if best is None or seen > best.get("seen", 0):
                    best = {
                        "entry_id": existing_id,
                        "group_id": existing_group_id,
                        "group": group,
                        "urgency": existing_urgency,
                        "status": existing_status,
                        "app_deleted": existing_deleted,
                        "archived": group_archived,
                        "seen": seen,
                    }
        return best

    def reactivate_dormant_thread_if_needed(self, email, body=""):
        """Wake up a low/completed thread when a meaningful new inbound email arrives.

        New inbound work should not stay buried just because the old thread was completed/low.
        """
        # v3.9.79: a user-locked email is the user's explicit workflow decision. Never auto-reactivate
        # (re-prioritize) it -- only a close trigger may change a locked email's workflow. Without this,
        # a re-imported / EntryID-drifted locked email could have its urgency bumped back up here.
        if isinstance(email, dict) and email.get("ai_user_locked"):
            return False
        try:
            dormant = self.find_dormant_thread_context(email)
            if not dormant:
                return False
            if not self.is_meaningful_reactivation_reply(email, body=body):
                return False

            changed = False
            text = f"{email.get('subject', '')}\n{body or email.get('body', '')}".lower()
            high_markers = [
                "urgent", "asap", "rush", "today", "immediately", "emergency",
                "revise", "revision", "change", "add", "quote", "rfq", "attached",
                "price", "pricing", "availability", "lead time"
            ]
            new_urgency = "High" if any(m in text for m in high_markers) else "Normal"

            if email.get("urgency") == "Low" or not email.get("urgency"):
                email["urgency"] = new_urgency
                changed = True
            elif email.get("urgency") not in ("High", "Critical") and new_urgency == "High":
                email["urgency"] = "High"
                changed = True

            if email.get("status") in ("Completed", "Waiting on Customer", "Waiting on Vendor", "New", ""):
                email["status"] = "Needs Reply"
                changed = True

            if not email.get("category") or email.get("category") == "Junk / Ignore":
                email["category"] = "Quote / Estimate"
                changed = True

            email["dormant_thread_reactivated"] = True
            email["reactivation_reason"] = "Meaningful new inbound reply woke a low/completed/archived thread."
            email["ai_triage_pending"] = True

            group_id = dormant.get("group_id") or self.find_group_id_for_thread(email, skip_entry_id=email.get("entry_id", ""))
            if group_id:
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = group_id
                group = self.get_group_by_id(group_id)
                if group:
                    group["has_new"] = True
                    # v2.10.8: Archived groups are dormant, not forgotten.
                    # Meaningful new inbound activity should automatically wake the group back up.
                    if group.get("archived", False):
                        group["archived"] = False
                        group["reactivated_at"] = datetime.now().isoformat()
                        group["reactivation_reason"] = "Meaningful new inbound email arrived for archived group."
                        group.pop("archived_at", None)
                    if group.get("urgency") == "Low":
                        group["urgency"] = new_urgency
                self.save_groups()
                try:
                    self.render_group_rows()
                except Exception:
                    pass

            if changed:
                self.save_record(email)
                self.flush_status_data()

            return True
        except Exception:
            return False

    def save_learning_data(self):
        # v4.1.52: during a bulk operation, defer the write (json.dump of up to 1500
        # rules/bucket + SQLite mirror); _bulk_write flushes it once on exit. The
        # in-memory self.learning_data is already updated by the caller.
        if int(getattr(self, "_bulk_write_depth", 0)) > 0:
            self._bulk_learning_dirty = True
            return
        save_json(LEARNING_FILE, self.learning_data)

    def save_learning_rules(self):
        """Backward-compatible alias used by undo/import-export code."""
        self.save_learning_data()

    def _trim_learning_bucket(self, bucket_name):
        bucket = self.learning_data.setdefault(bucket_name, {})
        if len(bucket) <= LEARNING_MAX_RULES_PER_BUCKET:
            return

        def _score(kv):
            rec = kv[1] if isinstance(kv[1], dict) else {}
            try:
                confidence = float(rec.get("confidence", 0.0) or 0.0)
            except Exception:
                confidence = 0.0
            try:
                times = int(rec.get("times", rec.get("count", rec.get("uses", 0))) or 0)
            except Exception:
                times = 0
            protected = 1 if confidence >= 0.85 else 0
            # Preserve high-confidence and frequently corrected rules even when
            # they have not been touched recently. updated_at remains the final
            # tie-breaker to keep recent low-confidence noise from evicting
            # important vendor/customer patterns.
            return (protected, round(confidence, 4), times, str(rec.get("updated_at", "")))

        items = sorted(bucket.items(), key=_score, reverse=True)
        self.learning_data[bucket_name] = dict(items[:LEARNING_MAX_RULES_PER_BUCKET])

    def learn_from_user_correction(self, email, category, urgency, status):
        """Record user corrections so future triage honors sender/domain/subject patterns."""
        if not email:
            return
        # v4.1.51 AGGRESSIVE LEARNING -- AUTO-TYPE FROM CATEGORY. Changing a category
        # used to teach the workflow but leave the sender UNTYPED, so the Sticky-Type
        # and Low-Floor protections (customers never auto-junked, vendors only buried
        # by a genuine marketing scan) never armed for that contact and the AI kept
        # guessing. When the user's correction assigns a category that unambiguously
        # implies a relationship, durably type the EXACT sender now, silently:
        #     Customer Issue                          -> C  (Customer)
        #     Vendor / Supplier                       -> V  (Vendor)
        #     Junk / Ignore from an automated address -> M  (Marketing/Automated)
        # Ambiguous categories (General, Quote / Estimate, Invoice / Payment,
        # Scheduling -- either side can send those) never auto-type, Junk from a
        # HUMAN-looking address never auto-types (protects real contacts having an
        # off day), and an EXISTING durable type is never overridden -- the user's
        # own Type dropdown remains the only way to change a typed sender. Gated by
        # the ai_auto_type_from_category setting (on by default; the Aggressive
        # preset keeps it on).
        try:
            if bool(self.settings.get("ai_auto_type_from_category", True)):
                _existing_type = (self._durable_email_type_for_email(email)
                                  or normalize_email_type_code(email.get("email_type", "")))
                if not _existing_type:
                    _cat = str(category or "").strip()
                    _auto_type = ""
                    if _cat == "Customer Issue":
                        _auto_type = "C"
                    elif _cat == "Vendor / Supplier":
                        _auto_type = "V"
                    elif _cat == "Junk / Ignore" and sender_looks_automated(
                            email.get("sender_email") or email.get("sender", "")):
                        _auto_type = "M"
                    if _auto_type:
                        email["email_type"] = _auto_type
                        email["sender_type"] = EMAIL_TYPE_TO_SENDER_TYPE.get(
                            _auto_type, email.get("sender_type", "unknown"))
        except Exception:
            pass
        # v3.9.47: this is the common chokepoint for every manual workflow correction (workflow
        # panel, Teach editor, context-menu status, AI Triage Center). Lock the email so the
        # auto-triage drip / 12h re-scan can never overwrite the user's explicit choice, mark it
        # AI-settled, and persist immediately so the lock survives a Refresh. Without this, the
        # drip re-triaged the email right after the edit and snapped urgency/category/status back.
        try:
            email["ai_user_locked"] = True
            email["ai_triaged_at"] = email.get("ai_triaged_at") or datetime.now().isoformat()
            email["ai_triage_pending"] = False
            self.save_record(email)
        except Exception:
            pass
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        learned = {
            "category": category,
            "urgency": urgency,
            "status": status,
            "email_type": normalize_email_type_code(email.get("email_type", "")),
            "sender": sender_email,
            "domain": domain,
            "subject": subject_key,
            "sample_subject": email.get("subject", ""),
            "sample_sender": email.get("sender", ""),
            "updated_at": datetime.now().isoformat(),
            "times": 1,
            "is_junk": bool(category == "Junk / Ignore" or urgency == "Low"),
            "learning_mode": "adaptive_editable",
        }

        def upsert(bucket_name, key):
            if not key:
                return
            bucket = self.learning_data.setdefault(bucket_name, {})
            existing = bucket.get(key, {}) if isinstance(bucket.get(key, {}), dict) else {}
            old_signature = (
                existing.get("category"),
                existing.get("urgency"),
                existing.get("status"),
                normalize_email_type_code(existing.get("email_type", "")),
            )
            new_signature = (
                category,
                urgency,
                status,
                learned.get("email_type", ""),
            )
            try:
                old_conf = float(existing.get("confidence", 0.0) or 0.0)
            except Exception:
                old_conf = 0.0
            try:
                old_times = int(existing.get("times", 0) or 0)
            except Exception:
                old_times = 0
            try:
                changed_times = int(existing.get("changed_times", 0) or 0)
            except Exception:
                changed_times = 0

            same_rule = old_signature == new_signature
            if not existing:
                # Exact sender corrections should learn quickly; broad domain/subject rules
                # still start softer so one-off projects do not over-triage unrelated email.
                new_conf = 0.72 if bucket_name == "senders" else 0.45
                new_times = 1
            elif same_rule:
                new_conf = min(0.96, max(old_conf, 0.45) + (0.18 if bucket_name == "senders" else 0.14))
                new_times = old_times + 1
            else:
                # If the user changes their mind later, replace the rule but make it editable/soft again.
                new_conf = 0.68 if bucket_name == "senders" else 0.40
                new_times = 1
                changed_times += 1

            merged = dict(existing)
            merged.update(learned)
            merged["times"] = new_times
            merged["changed_times"] = changed_times
            merged["confidence"] = round(new_conf, 3)
            if existing and not same_rule:
                merged["previous_category"] = existing.get("category", "")
                merged["previous_urgency"] = existing.get("urgency", "")
                merged["previous_status"] = existing.get("status", "")
                merged["previous_email_type"] = normalize_email_type_code(existing.get("email_type", ""))
            bucket[key] = merged
            self._trim_learning_bucket(bucket_name)

        # Safer junk learning:
        # Do NOT blindly learn Junk/Low by sender/domain because real vendors often send
        # both marketing emails and legitimate quotes from the same address. Junk/Low
        # corrections are learned by subject/pattern only, unless the sender itself
        # clearly looks automated/marketing.
        is_junkish = bool(category == "Junk / Ignore" or urgency == "Low")
        allow_sender_junk = bool(is_junkish and sender_looks_automated(sender_value))
        if not is_junkish or allow_sender_junk:
            if allow_sender_junk:
                learned["allow_sender_junk"] = True
            upsert("senders", sender_email)
        # Only learn domain-level rules for non-junk/trusted corrections.
        if domain and not is_junkish:
            upsert("domains", domain)
        upsert("subjects", subject_key)
        self.save_learning_data()

        # v2.7: corrections also teach the follow-up engine.
        # If the user marks something Waiting on Vendor/Customer, future similar messages can inherit that follow-up behavior.
        # If the user marks Completed/Junk/Low, future similar messages should avoid follow-ups.
        if status == "Waiting on Vendor":
            self.learn_followup_behavior(email, "wait_for_vendor", VENDOR_NO_RESPONSE_MINUTES, "Learned from user correction: waiting on vendor.")
        elif status == "Waiting on Customer":
            self.learn_followup_behavior(email, "wait_for_customer", CUSTOMER_PO_FOLLOWUP_MINUTES, "Learned from user correction: waiting on customer.")
        elif status == "Completed" or category == "Junk / Ignore" or urgency == "Low":
            self.learn_followup_behavior(email, "no_followup", None, "Learned from user correction: no follow-up needed.")

    def get_learning_hint_for_email(self, email):
        if not email:
            return None, ""
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        checks = [
            ("sender", self.learning_data.get("senders", {}).get(sender_email)),
            ("subject", self.learning_data.get("subjects", {}).get(subject_key)),
            ("domain", self.learning_data.get("domains", {}).get(domain)),
        ]
        for source, rule in checks:
            if not isinstance(rule, dict):
                continue
            category = rule.get("category")
            urgency = rule.get("urgency")
            status = rule.get("status")
            if category in CATEGORIES and urgency in URGENCY_LEVELS and status in STATUSES:
                # Older versions could learn Junk/Low by sender. Ignore those unsafe
                # sender/domain junk rules unless they were explicitly saved as allowed
                # automated-sender junk rules. Subject-level junk rules still apply.
                if source in ["sender", "domain"] and bool(rule.get("is_junk")) and not bool(rule.get("allow_sender_junk")):
                    continue
                return rule, source
        return None, ""



    def _group_learning_keys_for_email(self, email):
        """Return stable keys used to remember manual group corrections."""
        if not email:
            return []
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        keys = []
        if sender_email:
            keys.append(f"sender:{sender_email}")
        if subject_key:
            keys.append(f"subject:{subject_key}")
        # v3 Group Sorting Upgrade: do not learn/apply broad domain-only group
        # rules. One company/domain can have many unrelated jobs, so domain-only
        # grouping caused repeated wrong group assignments.
        return keys

    def learn_group_from_user_move(self, email, target_group_id, previous_group_id=""):
        """When the user manually moves an email to a group, remember that correction.

        This does not retrain the AI model. It creates lightweight business rules
        that run before AI grouping so repeated customers/projects go to the right
        group automatically next time.
        """
        if not email or not target_group_id:
            return
        target_group = self.get_group_by_id(target_group_id)
        if not target_group:
            return
        bucket = self.learning_data.setdefault("group_rules", {})
        now = datetime.now().isoformat()
        sender_value = email.get("sender_email") or email.get("sender", "")
        rule = {
            "group_id": target_group_id,
            "group_name": target_group.get("name", ""),
            "previous_group_id": previous_group_id or "",
            "sender": extract_email_address(sender_value),
            "domain": get_email_domain(sender_value),
            "subject": learning_subject_key(email.get("subject", "")),
            "business_tokens": sorted(self._group_tokens_for_email(email)),
            "sample_subject": email.get("subject", ""),
            "sample_sender": email.get("sender", ""),
            "updated_at": now,
        }
        for key in self._group_learning_keys_for_email(email):
            existing = bucket.get(key, {}) if isinstance(bucket.get(key, {}), dict) else {}
            merged = dict(existing)
            merged.update(rule)
            merged["times"] = int(existing.get("times", 0) or 0) + 1
            bucket[key] = merged
        self._trim_learning_bucket("group_rules")
        self.save_learning_data()
        try:
            # v4.1.35: feedback runs on the engine worker so every engine call stays
            # on one thread and the state-file write leaves the Tk main thread. The
            # worker receives a COPY of the email (five-tuple: kind, email copy,
            # target, previous, reason) and the task queue is created at bootstrap.
            if self._auto_group_engine_active():
                q = getattr(self, "_age_task_queue", None)
                if q is not None:
                    q.put(("feedback", dict(email), target_group_id,
                           previous_group_id, "manual group move"))
        except Exception:
            pass

    def _group_rule_has_business_token_match(self, email, rule, group_id):
        """Require a real job/PO/project token before applying broad group rules.

        Sender-only corrections are useful as hints, but the same sender/company can
        email about many unrelated jobs.  This helper makes learned sender rules safe
        by requiring a shared business token from the current email, the saved rule,
        or the target group before auto-grouping silently.
        """
        try:
            email_tokens = self._group_tokens_for_email(email)
            if not email_tokens:
                return False
            rule_tokens = set(rule.get("business_tokens") or [])
            rule_tokens.update(extract_group_match_tokens(rule.get("sample_subject", "")))
            rule_tokens.update(extract_group_match_tokens(rule.get("subject", "")))
            group_name_tokens, group_member_tokens = self._group_tokens_for_group(group_id)
            safe_tokens = rule_tokens | group_name_tokens | group_member_tokens
            return bool(email_tokens & safe_tokens)
        except Exception:
            return False

    def get_group_learning_hint_for_email(self, email):
        """Return a remembered group rule for this email, if one still points to a real group."""
        bucket = self.learning_data.setdefault("group_rules", {})
        best = None
        best_key = ""
        best_score = -1
        for key in self._group_learning_keys_for_email(email):
            if key.startswith("domain:"):
                continue
            rule = bucket.get(key)
            if not isinstance(rule, dict):
                continue
            group_id = rule.get("group_id", "")
            group = self.get_group_by_id(group_id)
            if not group or group.get("archived"):
                continue
            has_business_match = self._group_rule_has_business_token_match(email, rule, group_id)
            # Sender-only learned grouping must not auto-apply unless the new email
            # shares a job/PO/project key with the learned rule/group.
            if key.startswith("sender:") and not has_business_match:
                continue
            # Generic subjects such as Quote Request/RFQ/P&A are only safe when a
            # business key also matches.
            if key.startswith("subject:") and is_generic_group_subject(email.get("subject", "")) and not has_business_match:
                continue
            times = int(rule.get("times", 1) or 1)
            priority = 3 if key.startswith("subject:") else 2 if key.startswith("sender:") else 1
            score = priority * 1000 + times
            if has_business_match:
                score += 250
            if score > best_score:
                best = rule
                best_key = key
                best_score = score
        return best, best_key

    def auto_assign_learned_group(self, email):
        """Auto-group using user correction memory before asking AI."""
        if not email or self.get_group_id_for_email(email.get("entry_id", "")):
            return ""
        rule, key = self.get_group_learning_hint_for_email(email)
        if not rule:
            return ""
        group_id = rule.get("group_id", "")
        group = self.get_group_by_id(group_id)
        if not group:
            return ""
        self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = group_id
        email["learned_group_rule"] = key
        self.mark_group_has_new(group_id)
        self.save_groups()
        return group_id

    def _followup_learning_keys_for_email(self, email):
        """Return ordered follow-up learning keys from most specific to broadest."""
        if not email:
            return []
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        keys = []
        if sender_email:
            keys.append(f"sender:{sender_email}")
        if subject_key:
            keys.append(f"subject:{subject_key}")
        if domain:
            keys.append(f"domain:{domain}")
        return keys

    def get_followup_learning_hint_for_email(self, email, min_confidence=None):
        """Return learned follow-up behavior only when confidence is strong enough.

        v2.7.5: a single correction is stored as a weak hint. The app only auto-applies
        learned follow-up behavior after repeated confirmation or after the rule reaches
        FOLLOWUP_LEARNING_APPLY_CONFIDENCE. This prevents one experiment from becoming a
        permanent hard rule.
        """
        if min_confidence is None:
            min_confidence = FOLLOWUP_LEARNING_APPLY_CONFIDENCE
        bucket = self.learning_data.setdefault("followups", {})
        best_rule = None
        best_key = ""
        best_score = -1.0
        for key in self._followup_learning_keys_for_email(email):
            rule = bucket.get(key)
            if not isinstance(rule, dict) or not rule.get("behavior"):
                continue
            try:
                confidence = float(rule.get("confidence", 0.0) or 0.0)
            except Exception:
                confidence = 0.0
            # Backward compatibility for older rules without confidence.
            if confidence <= 0:
                try:
                    times = int(rule.get("times", 1) or 1)
                except Exception:
                    times = 1
                confidence = min(0.95, 0.35 + max(0, times - 1) * 0.20)
                rule["confidence"] = confidence
            if key.startswith("domain:"):
                # Domain-wide rules are intentionally weak.  A company can send
                # unrelated jobs, quote requests, invoices, and FYIs from the same
                # domain, so only repeated/high-confidence domain rules auto-apply.
                try:
                    times = int(rule.get("times", 1) or 1)
                except Exception:
                    times = 1
                if confidence < max(float(min_confidence or 0), 0.90) or times < 3:
                    continue
            if confidence >= min_confidence and confidence > best_score:
                best_rule = rule
                best_key = key
                best_score = confidence
        return best_rule, best_key

    def get_weak_followup_learning_hint_for_email(self, email):
        """Return the best follow-up hint even if confidence is low, for display/debug context only."""
        bucket = self.learning_data.setdefault("followups", {})
        best_rule = None
        best_key = ""
        best_score = -1.0
        for key in self._followup_learning_keys_for_email(email):
            rule = bucket.get(key)
            if not isinstance(rule, dict) or not rule.get("behavior"):
                continue
            try:
                confidence = float(rule.get("confidence", 0.0) or 0.0)
            except Exception:
                confidence = 0.0
            if confidence <= 0:
                try:
                    times = int(rule.get("times", 1) or 1)
                except Exception:
                    times = 1
                confidence = min(0.95, 0.35 + max(0, times - 1) * 0.20)
                rule["confidence"] = confidence
            if confidence > best_score:
                best_rule = rule
                best_key = key
                best_score = confidence
        return best_rule, best_key

    def learn_followup_behavior(self, email, behavior, minutes=None, reason=""):
        """Learn follow-up behavior from AI decisions or user corrections.

        v2.7.5 adaptive learning:
        - First correction creates a weak rule (confidence ~0.35).
        - Repeating the same behavior strengthens confidence.
        - Changing the behavior weakens/replaces the old behavior instead of making a permanent hard rule.
        - Future auto-triage only applies rules once confidence reaches FOLLOWUP_LEARNING_APPLY_CONFIDENCE.
        """
        if not email or not behavior:
            return
        valid = {"no_followup", "wait_for_vendor", "wait_for_customer", "followup_review"}
        if behavior not in valid:
            return
        try:
            minutes_val = int(minutes) if minutes is not None and str(minutes).strip() else None
        except Exception:
            minutes_val = None
        bucket = self.learning_data.setdefault("followups", {})
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        now = datetime.now().isoformat()

        for key in self._followup_learning_keys_for_email(email):
            existing = bucket.get(key, {}) if isinstance(bucket.get(key), dict) else {}
            old_behavior = existing.get("behavior")
            old_minutes = existing.get("minutes")
            try:
                old_conf = float(existing.get("confidence", 0.0) or 0.0)
            except Exception:
                old_conf = 0.0
            try:
                old_times = int(existing.get("times", 0) or 0)
            except Exception:
                old_times = 0
            try:
                changed_times = int(existing.get("changed_times", 0) or 0)
            except Exception:
                changed_times = 0

            same_behavior = (old_behavior == behavior)
            same_minutes = (old_minutes == minutes_val) or (old_minutes is None and minutes_val is None)

            if not existing:
                new_conf = 0.35
                new_times = 1
                changed_times = 0
                replaced_behavior = ""
            elif same_behavior and same_minutes:
                # repeated confirmation: confidence rises faster after repeated confirmations
                new_conf = min(0.95, max(old_conf, 0.35) + 0.18)
                new_times = old_times + 1
                replaced_behavior = ""
            elif same_behavior and not same_minutes:
                # same follow-up type, different timing: adapt timing but only modestly strengthen
                new_conf = min(0.90, max(old_conf, 0.35) + 0.08)
                new_times = old_times + 1
                changed_times += 1
                replaced_behavior = old_behavior or ""
            else:
                # contradictory behavior: do not stubbornly keep the old rule; replace it as a weak rule.
                new_conf = max(0.30, min(0.55, (old_conf * 0.45) + 0.20))
                new_times = 1
                changed_times += 1
                replaced_behavior = old_behavior or ""

            rule = {
                "behavior": behavior,
                "minutes": minutes_val,
                "sender": sender_email,
                "domain": domain,
                "subject": subject_key,
                "sample_subject": email.get("subject", ""),
                "sample_sender": email.get("sender", ""),
                "reason": reason or "Learned follow-up behavior.",
                "updated_at": now,
                "created_at": existing.get("created_at", now),
                "times": new_times,
                "changed_times": changed_times,
                "confidence": round(new_conf, 3),
                "previous_behavior": replaced_behavior,
                "learning_mode": "adaptive_confidence",
            }
            bucket[key] = rule
        self._trim_learning_bucket("followups")
        self.save_learning_data()

    def is_trusted_contact_sender(self, email):
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        if not sender_email:
            return False
        if sender_email in self.trusted_contact_emails:
            return True
        # Also treat manually corrected non-junk senders as trusted.
        rule = self.learning_data.get("senders", {}).get(sender_email, {})
        if isinstance(rule, dict) and not rule.get("is_junk") and rule.get("category") in CATEGORIES:
            return True
        return False

    def load_outlook_contacts_trusted_senders(self):
        """Load Outlook contacts once and use them as a trusted-sender safety net."""
        try:
            if not self.namespace:
                self.connect_outlook_quietly()
            if not self.namespace:
                return
            contacts_folder = self.namespace.GetDefaultFolder(10)  # olFolderContacts
            items = contacts_folder.Items
            found = set(self.trusted_contact_emails)
            count = 0
            for item in items:
                if count >= 2500:
                    break
                count += 1
                for attr in ["Email1Address", "Email2Address", "Email3Address"]:
                    try:
                        addr = getattr(item, attr, "") or ""
                    except Exception:
                        addr = ""
                    addr = extract_email_address(addr)
                    if "@" in addr:
                        found.add(addr)
            self.trusted_contact_emails = found
            self.contacts_cache = {"contacts": sorted(found), "cached_at": datetime.now().isoformat()}
            save_json(CONTACTS_CACHE_FILE, self.contacts_cache)
            try:
                self.ai_status_var.set(f"AI: loaded {len(found)} trusted contact(s)")
            except Exception:
                pass
        except Exception:
            # Contacts are an enhancement only; never interrupt the user if Outlook blocks this.
            pass

    def add_selected_to_selected_group_hotkey(self, event=None):
        """Ctrl+A or Alt+A while a group is selected adds currently selected emails to that group."""
        try:
            focus = self.root.focus_get()
            if focus in [getattr(self, "preview_text", None), getattr(self, "group_notes_text", None)]:
                return None
        except Exception:
            pass
        group_id = self.selected_group_id_from_groups_tree()
        if not group_id:
            messagebox.showwarning("No Group Selected", "Please select group from below")
            return "break"
        selected_emails = self.get_selected_emails(show_warning=False)
        if not selected_emails:
            return None
        self.assign_emails_to_group(selected_emails, group_id)
        return "break"

    def get_related_same_subject_emails(self, email, max_items=8):
        """Quick local scan: exact normalized subject match means high likelihood emails are related."""
        if not email:
            return []
        # v3 efficiency: cache normalized subject on the email dict so the
        # regex stripping loop only runs once per email across the whole session.
        if "_normalized_subject" not in email:
            email["_normalized_subject"] = normalize_subject_for_match(email.get("subject", ""))
        target = email["_normalized_subject"]
        if not target:
            return []
        # v3 Group Sorting Upgrade: do not treat generic subjects such as
        # "Quote Request" or "P&A" as proof that emails belong together.
        if is_generic_group_subject(target) and not extract_group_match_tokens(target):
            return []
        matches = []
        entry_id = email.get("entry_id", "")
        for other in self.emails:
            if other.get("entry_id") == entry_id:
                continue
            if "_normalized_subject" not in other:
                other["_normalized_subject"] = normalize_subject_for_match(other.get("subject", ""))
            if other["_normalized_subject"] == target:
                matches.append(other)
        matches.sort(key=lambda e: e.get("received_timestamp", 0), reverse=True)
        return matches[:max_items]

    def build_related_subject_context(self, email):
        related = self.get_related_same_subject_emails(email)
        lines = []
        for item in related:
            group_name = self.get_group_name_for_email(item.get("entry_id", ""))
            lines.append(
                f"{item.get('received','')} | {item.get('sender','')} | "
                f"category={item.get('category','')} | status={item.get('status','')} | "
                f"group={group_name or 'none'} | subject={item.get('subject','')}"
            )
        return related, lines

    def get_best_same_subject_workflow_hint(self, email):
        """v2.3.2: if exact subject matches prior real work, use it as a protection hint.

        Uniform project/RFQ subjects are common in this workflow. A same-subject match
        should make the app MORE confident the email is related, not less.
        """
        for other in self.get_related_same_subject_emails(email, max_items=12):
            category = other.get("category", "General")
            urgency = other.get("urgency", "Normal")
            status = other.get("status", "New")
            if category == "Junk / Ignore" or urgency == "Low":
                continue
            return {
                "category": category if category in CATEGORIES else "General",
                "urgency": urgency if urgency in URGENCY_LEVELS and urgency != "Low" else "Normal",
                "status": status if status in STATUSES else "Needs Reply",
                "sender": other.get("sender", ""),
                "received": other.get("received", ""),
                "subject": other.get("subject", ""),
                "group": self.get_group_name_for_email(other.get("entry_id", "")),
            }
        return None

    def auto_assign_same_subject_group(self, email):
        """If exact normalized subject matches an existing grouped email, auto-add after quick local scan."""
        if not email or self.get_group_id_for_email(email.get("entry_id", "")):
            return ""
        for other in self.get_related_same_subject_emails(email, max_items=10):
            group_id = self.get_group_id_for_email(other.get("entry_id", ""))
            if group_id and self.get_group_by_id(group_id):
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = group_id
                email["same_subject_group_rule"] = normalize_subject_for_match(email.get("subject", ""))
                self.mark_group_has_new(group_id)
                self.save_groups()
                return group_id
        return ""

    def _load_contact_types(self):
        """v4.1.55: durable per-SENDER relationship registry.

        The sticky-type clamp (v4.1.17) protects only PER-EMAIL types (the status
        record keyed by entry_id), so every NEW email from a known contact was
        re-inferred from scratch and the AI could type a saved customer as Vendor
        again (the reported Danny case). This registry is the per-sender truth:
        {"contacts": {addr: {"code": C/V/E/M, ...}}, "asked": {addr: iso}} --
        "asked" remembers senders the user declined to save, so the first-time
        offer never repeats."""
        cache = getattr(self, "_contact_types_cache", None)
        if isinstance(cache, dict):
            return cache
        data = load_json(CONTACT_TYPES_FILE, {}) if os.path.exists(CONTACT_TYPES_FILE) else {}
        if not isinstance(data, dict):
            data = {}
        data.setdefault("version", 1)
        if not isinstance(data.get("contacts"), dict):
            data["contacts"] = {}
        if not isinstance(data.get("asked"), dict):
            data["asked"] = {}
        self._contact_types_cache = data
        return data

    def _save_contact_types(self):
        try:
            data = self._load_contact_types()
            save_json(CONTACT_TYPES_FILE, data)
            return True
        except Exception:
            return False

    def _pipeline_saved_senders(self, kind):
        """v4.1.55: fail-soft, cached view of the quote-pipeline saved lists (the
        'Saved Customers / Saved Vendors' window). These lists were only consulted
        by Quote Scan; typing now honors them too, so an existing saved customer
        like danny@ is a Customer everywhere without re-entering anything."""
        cache = getattr(self, "_pipeline_senders_cache", None)
        if isinstance(cache, dict) and kind in cache:
            return cache[kind]
        addrs = set()
        try:
            from mainbox_quote_pipeline_entry import load_saved_senders
            for e in (load_saved_senders(kind) or []):
                a = extract_email_address(str(e or "")).lower()
                if a and "@" in a:
                    addrs.add(a)
        except Exception:
            pass
        if not isinstance(cache, dict):
            cache = {}
            self._pipeline_senders_cache = cache
        cache[kind] = addrs
        return addrs

    def _invalidate_contact_type_caches(self):
        self._contact_types_cache = None
        self._pipeline_senders_cache = None

    def get_saved_contact_type(self, sender_value):
        """v4.1.55: durable relationship code (C/V/E/M) for a sender address, or "".
        Priority: the app registry (user-confirmed), then the quote-pipeline saved
        customer/vendor lists."""
        try:
            addr = extract_email_address(str(sender_value or "")).lower()
            if not addr or "@" not in addr:
                return ""
            rec = self._load_contact_types().get("contacts", {}).get(addr)
            code = normalize_email_type_code((rec or {}).get("code")) if isinstance(rec, dict) else ""
            if code:
                return code
            if addr in self._pipeline_saved_senders("customer"):
                return "C"
            if addr in self._pipeline_saved_senders("vendor"):
                return "V"
            return ""
        except Exception:
            return ""

    def set_saved_contact_type(self, sender_value, code, source="user"):
        """v4.1.55: record a durable per-sender type. Returns the normalized address
        on success. Also mirrors C/V into the quote-pipeline saved lists (fail-soft)
        so the sender appears in the existing Saved Senders window."""
        try:
            addr = extract_email_address(str(sender_value or "")).lower()
            ncode = normalize_email_type_code(code)
            if not addr or "@" not in addr or ncode not in ("C", "V", "E", "M"):
                return ""
            data = self._load_contact_types()
            data["contacts"][addr] = {"code": ncode, "at": datetime.now().isoformat(), "source": str(source or "user")}
            data["asked"].pop(addr, None)
            self._save_contact_types()
            if ncode in ("C", "V"):
                try:
                    from mainbox_quote_pipeline_entry import add_saved_sender
                    add_saved_sender("customer" if ncode == "C" else "vendor", addr)
                except Exception:
                    pass
            self._invalidate_contact_type_caches()
            return addr
        except Exception:
            return ""

    def remove_saved_contact_type(self, sender_value):
        """v4.1.55: forget a sender's durable type (registry side only)."""
        try:
            addr = extract_email_address(str(sender_value or "")).lower()
            if not addr:
                return False
            data = self._load_contact_types()
            existed = bool(data["contacts"].pop(addr, None))
            if existed:
                self._save_contact_types()
                self._invalidate_contact_type_caches()
            return existed
        except Exception:
            return False

    def _offer_save_contact_type(self, selected_emails, new_code, parent=None):
        """v4.1.55: FIRST-TIME OFFER. When the user manually types email(s) C/V/E,
        offer -- once per sender, one dialog per operation -- to remember that type
        for the sender permanently. Yes: saved to the registry (and, for C/V, the
        quote-pipeline saved list so it shows in the Saved Senders window). No:
        remembered in 'asked' so the question never repeats for that sender. A
        sender already saved under a DIFFERENT code re-asks only because the fact
        changed (deliberate retype); same-code senders never prompt."""
        try:
            code = normalize_email_type_code(new_code)
            if code not in ("C", "V", "E"):
                return
            data = self._load_contact_types()
            contacts = data.get("contacts", {})
            asked = data.get("asked", {})
            pending = {}
            for email in (selected_emails or []):
                if not isinstance(email, dict):
                    continue
                addr = extract_email_address(str(email.get("sender_email") or email.get("sender") or "")).lower()
                if not addr or "@" not in addr:
                    continue
                saved_code = ""
                rec = contacts.get(addr)
                if isinstance(rec, dict):
                    saved_code = normalize_email_type_code(rec.get("code"))
                if not saved_code:
                    # Pipeline lists count as saved too (Danny is a saved customer).
                    if addr in self._pipeline_saved_senders("customer"):
                        saved_code = "C"
                    elif addr in self._pipeline_saved_senders("vendor"):
                        saved_code = "V"
                if saved_code == code:
                    continue
                if not saved_code and addr in asked:
                    continue
                pending[addr] = saved_code
            if not pending:
                return
            label = EMAIL_TYPE_LABELS.get(code, code)
            addrs = sorted(pending)
            shown = "\n".join(f"  \u2022 {a}" for a in addrs[:6])
            if len(addrs) > 6:
                shown += f"\n  \u2026 and {len(addrs) - 6} more"
            changes = [a for a in addrs if pending[a]]
            note = ""
            if changes:
                note = ("\n\nNote: " + ", ".join(f"{a} is currently saved as "
                        f"{EMAIL_TYPE_LABELS.get(pending[a], pending[a])}" for a in changes[:3])
                        + ". Answering Yes updates the saved type.")
            extra = ""
            if code == "C":
                extra = "\n\nSaved Customers are also auto-recognized by Quote Scan (RFQs auto-draft an ack)."
            elif code == "V":
                extra = "\n\nSaved Vendors are also treated as suppliers by Quote Scan."
            msg = (f"Always treat {'this sender' if len(addrs) == 1 else 'these senders'} as {label}?\n\n{shown}\n\n"
                   f"New email from them will be typed {code} automatically, and automation can never re-type them."
                   f"{extra}{note}\n\nYou can edit saved senders anytime in Settings \u2192 Manage Saved Customers & Vendors."
                   f"\n\n(Answering No will not ask again for {'this sender' if len(addrs) == 1 else 'these senders'}.)")
            try:
                yes = messagebox.askyesno(f"Save as {label}?", msg, parent=parent or self.root)
            except Exception:
                return
            if yes:
                for a in addrs:
                    self.set_saved_contact_type(a, code, source="first_time_offer")
            else:
                now = datetime.now().isoformat()
                for a in addrs:
                    asked[a] = now
                self._save_contact_types()
        except Exception:
            pass

    def _durable_email_type_for_email(self, email):
        """v4.1.17: resolve the durable relationship type (C/V/E/M) for this email.

        v4.1.55: the per-SENDER registry (Saved Senders + first-time offers) now
        outranks the per-email record -- a saved customer is a Customer on every
        email, including brand-new ones the AI has never seen. Per-email user
        exceptions still stand: user edits set ai_user_locked, so automation (the
        only consumer of this clamp) never touches those rows.

        Priority: per-sender registry, then the saved status record's email_type
        (survives refresh/restart and is set by user edits / save_record), then the
        in-memory row's own email_type."""
        try:
            if not isinstance(email, dict):
                return ""
            sender_code = self.get_saved_contact_type(email.get("sender_email") or email.get("sender") or "")
            if sender_code:
                return sender_code
            eid = str(email.get("entry_id", "") or "")
            saved = self.status_data.get(eid, {}) if (eid and isinstance(self.status_data, dict)) else {}
            saved_type = normalize_email_type_code((saved or {}).get("email_type")) if isinstance(saved, dict) else ""
            return saved_type or normalize_email_type_code(email.get("email_type"))
        except Exception:
            return ""

    def _enforce_relationship_triage_rules(self, email, proposal, body="", durable_type="",
                                           marketing_scan=False, learned_junk=False):
        """v4.1.17 STICKY RELATIONSHIP TYPES + LOW FLOOR. Central clamp every automation
        path (pre-AI quick filter, learned hard rules, both Ollama triage appliers) runs
        its proposed workflow through BEFORE touching the email.

        proposal is a plain dict with canonical keys -- category, urgency, status,
        email_type, sender_type -- mutated in place. Returns a list of note strings for
        the triage reason/history so every clamp is visible in the AI Triage log.

        Rules (user-specified):
          1. STICKY TYPES. A customer is always a customer; an employee is always an
             employee. Automation may never retype a durable C or E sender. A durable
             V sender may change ONLY to M, and only when the message was genuinely
             scanned as marketing/advertising (marketing_scan). sender_type is forced
             to match so save_record's inference can never flip the type either.
          2. LOW FLOOR. Mail from a known Customer or Vendor is Normal at minimum:
             automation may not set Low urgency, Junk / Ignore category, or bury it
             auto-Completed -- unless the message was scanned as marketing
             (marketing_scan), the user explicitly taught junk for it (learned_junk),
             or it is a pure courtesy closer ('thanks', 'don't worry about it', ...),
             which may still go Low/Completed as previously programmed but is never
             CATEGORIZED as Junk (keeps sender/subject learning clean).

        User edits never pass through here -- this gates automation only.
        """
        notes = []
        try:
            if not isinstance(proposal, dict):
                return notes
            durable = normalize_email_type_code(durable_type) or self._durable_email_type_for_email(email)
            proposed_type = normalize_email_type_code(proposal.get("email_type"))

            # ---- Rule 1: sticky relationship types ----
            if durable in ("C", "E"):
                if proposed_type and proposed_type != durable:
                    proposal["email_type"] = durable
                    notes.append(
                        f"Sticky type: sender is a known {EMAIL_TYPE_LABELS.get(durable, durable)}; "
                        f"automation kept type {durable} (proposed {proposed_type}).")
                proposal["sender_type"] = EMAIL_TYPE_TO_SENDER_TYPE.get(durable, proposal.get("sender_type", "unknown"))
            elif durable == "V":
                if marketing_scan:
                    # The one allowed automated type change: vendor sent advertising.
                    if proposed_type != "M":
                        proposal["email_type"] = "M"
                        notes.append("Vendor sent scanned advertising: type V -> M (the only allowed automated retype).")
                    proposal["sender_type"] = EMAIL_TYPE_TO_SENDER_TYPE["M"]
                else:
                    if proposed_type and proposed_type != "V":
                        proposal["email_type"] = "V"
                        notes.append(
                            f"Sticky type: sender is a known Vendor; automation kept type V "
                            f"(proposed {proposed_type}; V may only become M on a marketing scan).")
                    proposal["sender_type"] = EMAIL_TYPE_TO_SENDER_TYPE["V"]
            elif durable == "M":
                # A durable Marketing sender stays M for automation purposes; only the
                # user can promote it back to a business type.
                if proposed_type and proposed_type not in ("M",):
                    proposal["email_type"] = "M"
                    notes.append("Sticky type: sender was marked Marketing/Automated; automation cannot promote it.")

            # ---- Rule 2: Low floor for known customers/vendors ----
            effective = normalize_email_type_code(proposal.get("email_type")) or durable
            if effective in ("C", "V") and not marketing_scan and not learned_junk:
                proposed_junk_style = (
                    str(proposal.get("category", "")) == "Junk / Ignore"
                    or str(proposal.get("urgency", "")) == "Low"
                )
                if str(proposal.get("category", "")) == "Junk / Ignore":
                    current_category = str((email or {}).get("category", "") or "")
                    if current_category and current_category != "Junk / Ignore":
                        proposal["category"] = current_category
                    else:
                        proposal["category"] = "Vendor / Supplier" if effective == "V" else "General"
                    notes.append(
                        f"Low floor: known {EMAIL_TYPE_LABELS.get(effective, effective)} mail is never auto-junked "
                        f"(category kept {proposal['category']}).")
                if proposed_junk_style or str(proposal.get("status", "")) == "Completed":
                    courtesy = email_is_courtesy_closer(
                        (email or {}).get("subject", ""), body or (email or {}).get("body", ""))
                else:
                    courtesy = False
                if not courtesy:
                    if str(proposal.get("urgency", "")) == "Low":
                        proposal["urgency"] = "Normal"
                        notes.append(
                            f"Low floor: known {EMAIL_TYPE_LABELS.get(effective, effective)} mail floors at Normal urgency "
                            f"(not a courtesy closer / not scanned as marketing).")
                    if proposed_junk_style and str(proposal.get("status", "")) == "Completed":
                        proposal["status"] = "Needs Reply"
                        notes.append("Low floor: junk-style auto-complete blocked; status set to Needs Reply for review.")
                elif proposed_junk_style or str(proposal.get("status", "")) == "Completed":
                    notes.append("Courtesy closer detected ('thanks' / 'don't worry about it' style): Low/Completed allowed as previously programmed.")
        except Exception:
            pass
        return notes

    def apply_quick_sender_intent(self, email, body="", _related=None):
        """Apply learning/contact/sender rules before AI and return signal context for Ollama.

        _related: optional pre-built list from build_related_subject_context.
        When provided the O(n) subject scan is skipped (v3 efficiency fix).
        """
        if _related is None:
            related, _lines = self.build_related_subject_context(email)
        else:
            related = _related
        quick = quick_sender_intent_analysis(
            subject=email.get("subject", ""),
            sender=email.get("sender_email") or email.get("sender", ""),
            body=body or email.get("body", ""),
            related_count=len(related),
            source=email.get("source", "")
        )

        learning_hint, learning_source = self.get_learning_hint_for_email(email)
        trusted_contact = self.is_trusted_contact_sender(email)

        if trusted_contact:
            quick["trusted_sender"] = True
            quick["business_relevance"] = max(float(quick.get("business_relevance", 0) or 0), TRUSTED_SENDER_BUSINESS_FLOOR)
            quick["spam_likelihood"] = min(float(quick.get("spam_likelihood", 0) or 0), TRUSTED_SENDER_SPAM_CAP)
            if quick.get("workflow_category") == "Junk / Ignore":
                quick["workflow_category"] = "General"
                quick["urgency"] = "Normal"
                quick["status"] = "Needs Reply"
                quick["hard_decision"] = False
            quick["reason"] = (quick.get("reason", "") + " Trusted sender/contact protection applied.").strip()

        if learning_hint:
            # User corrections are stronger than AI guesses. They protect known customers/vendors/projects.
            quick["learned_rule_source"] = learning_source
            quick["learned_rule_times"] = learning_hint.get("times", 1)
            quick["workflow_category"] = learning_hint.get("category", quick.get("workflow_category", "General"))
            quick["urgency"] = learning_hint.get("urgency", quick.get("urgency", "Normal"))
            quick["status"] = learning_hint.get("status", quick.get("status", "Needs Reply"))
            learned_email_type = normalize_email_type_code(learning_hint.get("email_type", ""))
            if learned_email_type:
                quick["email_type"] = learned_email_type
            quick["business_relevance"] = 0.90 if not learning_hint.get("is_junk") else 0.10
            quick["spam_likelihood"] = 0.08 if not learning_hint.get("is_junk") else 0.90
            try:
                learned_confidence = float(learning_hint.get("confidence", 0.0) or 0.0)
            except Exception:
                learned_confidence = 0.0
            try:
                learned_times = int(learning_hint.get("times", 1) or 1)
            except Exception:
                learned_times = 1
            # Learn exact contacts faster: one explicit sender correction is enough to
            # protect future emails from the same sender. Broader subject/domain rules
            # still need repeat confirmation or stronger confidence.
            # v4.1.51: "Require confirmation before applying newly learned behavior"
            # is now WIRED (it was saved but never consumed). When on, learned rules
            # still fill the proposed fields as advisory context, but hard_decision
            # stays False so triage/AI review happens before the rule is enforced.
            _confirm_first = bool(self.settings.get("ai_learning_confirm_before_apply", False))
            quick["hard_decision"] = bool(
                not _confirm_first and (
                    (learning_source == "sender" and learned_confidence >= 0.65)
                    or learned_times >= 2
                    or learned_confidence >= 0.80
                )
            )
            if _confirm_first:
                quick["reason"] = (quick.get("reason", "") +
                                   " Confirm-before-apply is ON: learned rule shown as advisory only.").strip()
            quick["reason"] = (quick.get("reason", "") + f" Learned user correction matched by {learning_source}; applying remembered workflow.").strip()
            # v4.1.17: expose the learned-junk fact so downstream AI appliers can honor
            # the user's own junk teaching as a sanctioned Low-floor exception.
            quick["learned_is_junk"] = bool(learning_hint.get("is_junk"))

        followup_hint, followup_hint_key = self.get_followup_learning_hint_for_email(email)
        if followup_hint:
            quick["learned_followup_key"] = followup_hint_key
            quick["learned_followup_behavior"] = followup_hint.get("behavior", "")
            quick["learned_followup_minutes"] = followup_hint.get("minutes")
            quick["learned_followup_reason"] = followup_hint.get("reason", "")
            if followup_hint.get("behavior") == "no_followup":
                quick["needs_followup"] = False
                quick["followup_reason"] = "Learned rule says no follow-up for this sender/subject/domain."
            else:
                quick["needs_followup"] = True
                quick["followup_reason"] = followup_hint.get("reason", "Learned follow-up behavior matched.")
            quick["reason"] = (quick.get("reason", "") + f" Learned follow-up rule matched: {followup_hint.get('behavior','')} ({followup_hint_key}, confidence {float(followup_hint.get('confidence', 0) or 0):.0%}).").strip()

        # v4.1.17 STICKY TYPES + LOW FLOOR: clamp the pre-AI decision BEFORE it is
        # stamped onto the email or handed to Ollama as signal context. A durable
        # Customer/Employee type can never be changed by automation; a durable Vendor
        # may only become Marketing when the message was genuinely scanned as
        # advertising; and known C/V mail floors at Normal urgency / non-Junk category
        # unless scanned as marketing, taught junk by the user, or a courtesy closer.
        _durable_type = self._durable_email_type_for_email(email)
        if not _durable_type and learning_hint and learning_source == "sender":
            # Sender-level learned type = the user's own teaching about this contact.
            _durable_type = normalize_email_type_code(learning_hint.get("email_type", ""))
        _marketing_scan = (
            str(quick.get("sender_type", "")) == "automated_or_marketing"
            and str(quick.get("workflow_category", "")) == "Junk / Ignore"
        )
        # v4.1.18 audit: a KNOWN customer/vendor writing from a HUMAN address is never
        # "scanned as marketing" on phrases alone -- quoted chains and forwarded content
        # legitimately carry 'unsubscribe'/'click here'. Real advertising comes from
        # automated addresses (noreply/newsletter/marketing@...), so require that
        # sender shape before the marketing exemption can bury typed C/V mail.
        if _marketing_scan and _durable_type in ("C", "V") and not sender_looks_automated(
                email.get("sender_email") or email.get("sender", "")):
            _marketing_scan = False
        _proposal = {
            "category": quick.get("workflow_category", "General"),
            "urgency": quick.get("urgency", "Normal"),
            "status": quick.get("status", "Needs Reply"),
            "email_type": quick.get("email_type", ""),
            "sender_type": quick.get("sender_type", "unknown"),
        }
        _notes = self._enforce_relationship_triage_rules(
            email, _proposal, body=body or email.get("body", ""),
            durable_type=_durable_type, marketing_scan=_marketing_scan,
            learned_junk=bool(quick.get("learned_is_junk", False)),
        )
        quick["workflow_category"] = _proposal["category"]
        quick["urgency"] = _proposal["urgency"]
        quick["status"] = _proposal["status"]
        quick["sender_type"] = _proposal["sender_type"]
        if _proposal.get("email_type"):
            quick["email_type"] = _proposal["email_type"]
        if _durable_type:
            quick["durable_email_type"] = _durable_type
        if _notes:
            quick["reason"] = (quick.get("reason", "") + " " + " ".join(_notes)).strip()
            # A floored decision is no longer a safe pre-AI hard decision to bury the
            # email -- let AI (or the user) look at it instead of auto-hiding it.
            if any("Low floor" in n for n in _notes):
                quick["hard_decision"] = False
                quick["business_relevance"] = max(float(quick.get("business_relevance", 0) or 0), 0.70)
                quick["spam_likelihood"] = min(float(quick.get("spam_likelihood", 0) or 0), 0.35)

        email["sender_type"] = quick.get("sender_type", "unknown")
        email["sender_intent"] = quick.get("sender_intent", "")
        email["business_relevance"] = quick.get("business_relevance", 0)
        email["spam_likelihood"] = quick.get("spam_likelihood", 0)
        email["same_subject_related_count"] = quick.get("same_subject_related_count", 0)
        email["trusted_sender"] = bool(quick.get("trusted_sender", False))
        email["learned_rule_source"] = quick.get("learned_rule_source", "")

        # v2.3.2: protect uniform/exact subject work from being buried as Low/Junk.
        workflow_hint = self.get_best_same_subject_workflow_hint(email)
        if workflow_hint and not (learning_hint and learning_hint.get("is_junk")):
            quick["workflow_category"] = workflow_hint.get("category", quick.get("workflow_category", "General"))
            quick["urgency"] = workflow_hint.get("urgency", quick.get("urgency", "Normal"))
            # v4.1.17: a NEW message from a known Customer/Vendor floors at Normal even when
            # the same-subject hint inherits Low from an older row the user had buried --
            # new inbound C/V mail is new work, not a continuation of the burial.
            if _durable_type in ("C", "V") and str(quick.get("urgency", "")) == "Low":
                quick["urgency"] = "Normal"
            quick["status"] = "Needs Reply"
            quick["business_relevance"] = max(float(quick.get("business_relevance", 0) or 0), 0.82)
            quick["spam_likelihood"] = min(float(quick.get("spam_likelihood", 0) or 0), 0.25)
            quick["hard_decision"] = False
            quick["reason"] = (quick.get("reason", "") + " Same-subject protection: inherited workflow from prior non-junk related email "
                               f"({workflow_hint.get('category','General')} / {workflow_hint.get('urgency','Normal')}).").strip()
            email["sender_intent"] = (email.get("sender_intent", "") + " Same-subject match to existing work.").strip()
            email["business_relevance"] = quick["business_relevance"]
            email["spam_likelihood"] = quick["spam_likelihood"]

        changed = False
        # Hard decisions are safe to apply before Ollama. This keeps true junk from becoming followups.
        # v3.9.79: but never let a pre-AI hard decision (junk filter or learned-rule match) overwrite the
        # category/urgency/status on an email the user explicitly set. ai_user_locked is the user's
        # decision; only a close trigger may override it. Without this gate a re-imported / EntryID-drifted
        # locked email gets snapped back to a learned-rule workflow on the next refresh -- the recurring
        # "my urgency won't stick" bug, via the one automation path the v3.9.46/47 lock did not cover.
        if quick.get("hard_decision") and not email.get("ai_user_locked"):
            for key, qkey in [("category", "workflow_category"), ("urgency", "urgency"), ("status", "status"), ("email_type", "email_type")]:
                val = quick.get(qkey)
                if val and val != email.get(key):
                    email[key] = val
                    changed = True
            email["ai_triage_pending"] = False
            email["ai_triaged_at"] = datetime.now().isoformat()
            email["ai_triage_reason"] = quick.get("reason", "Pre-AI hard filter")
            self.save_record(email)
        return quick, changed

    def apply_ai_triage_to_email(self, email, allow_group_prompt=True):
        """Use pre-AI sender/phrase signals plus Ollama to improve category/urgency/status/grouping."""
        if not AI_TRIAGE_ENABLED or not email:
            return False
        try:
            body = self.load_body_if_needed(email)
        except Exception:
            body = email.get("body", "") or ""

        # v2.10.6: once the body is available, re-check dormant thread reactivation with full content.
        try:
            if self.reactivate_dormant_thread_if_needed(email, body=body):
                self.save_cached_state()
        except Exception:
            pass

        quick_result = self.apply_quick_sender_intent(email, body=body)
        if isinstance(quick_result, tuple):
            quick, quick_changed = quick_result
        else:
            quick, quick_changed = quick_result, False
        if quick.get("hard_decision"):
            return quick_changed

        related, related_lines = self.build_related_subject_context(email)
        try:
            result = ask_ollama_for_triage(
                subject=email.get("subject", ""),
                sender=email.get("sender_email") or email.get("sender", ""),
                body=body,
                groups=self.groups_data.get("groups", []),
                signal_context=quick,
                related_subjects=related_lines,
            )
        except Exception:
            result = None
        if not result:
            return quick_changed

        changed = quick_changed
        suggested_category = str(result.get("workflow_category", quick.get("workflow_category", ""))).strip()
        suggested_urgency = str(result.get("urgency", quick.get("urgency", ""))).strip()
        suggested_status = str(result.get("status", quick.get("status", ""))).strip()

        # Safety: spam-ish or low-relevance AI result cannot create actionable workflow.
        try:
            business_relevance = float(result.get("business_relevance", quick.get("business_relevance", 0)) or 0)
        except Exception:
            business_relevance = 0
        try:
            spam_likelihood = float(result.get("spam_likelihood", quick.get("spam_likelihood", 0)) or 0)
        except Exception:
            spam_likelihood = 0
        protected_by_same_subject = bool(related) and bool(self.get_best_same_subject_workflow_hint(email))
        if (spam_likelihood >= 0.70 or business_relevance <= 0.25) and not protected_by_same_subject:
            suggested_category = "Junk / Ignore"
            suggested_urgency = "Low"
            suggested_status = "Completed"
        elif protected_by_same_subject and suggested_category == "Junk / Ignore":
            # Exact subject matches prior real work, so do not let the small model bury it as junk.
            workflow_hint = self.get_best_same_subject_workflow_hint(email) or {}
            suggested_category = workflow_hint.get("category", "General")
            suggested_urgency = workflow_hint.get("urgency", "Normal")
            suggested_status = "Needs Reply"
            business_relevance = max(business_relevance, 0.82)
            spam_likelihood = min(spam_likelihood, 0.25)

        # Bias correction: incoming business emails default to Needs Reply unless there is strong customer-waiting evidence.
        if suggested_status == "Waiting on Customer":
            sender_intent = f"{result.get('sender_intent','')} {quick.get('sender_intent','')} {result.get('reason','')}".lower()
            if "po" not in sender_intent and "approval" not in sender_intent and "send" not in sender_intent and "later" not in sender_intent and quick.get("status") != "Waiting on Customer":
                suggested_status = "Needs Reply"

        # v4.1.17 STICKY TYPES + LOW FLOOR: clamp the AI's suggestion before applying.
        _resolved_sender_type = str(result.get("sender_type", quick.get("sender_type", "unknown"))).strip() or "unknown"
        _marketing_scan = bool(
            spam_likelihood >= 0.70 and (
                _resolved_sender_type == "automated_or_marketing"
                or sender_looks_automated(email.get("sender_email") or email.get("sender", ""))
                or contains_any_phrase(f"{email.get('subject', '')}\n{body}".lower(), SPAM_OR_MARKETING_PHRASES)
            )
        )
        # v4.1.18 audit: typed C/V mail from a human address is never buried on
        # phrase/model spam signals alone -- advertising comes from automated senders.
        _dt_for_mkt = str(quick.get("durable_email_type", "") or "") or self._durable_email_type_for_email(email)
        if _marketing_scan and _dt_for_mkt in ("C", "V") and not sender_looks_automated(
                email.get("sender_email") or email.get("sender", "")):
            _marketing_scan = False
        _proposal = {
            "category": suggested_category, "urgency": suggested_urgency, "status": suggested_status,
            "email_type": email.get("email_type", ""), "sender_type": _resolved_sender_type,
        }
        _floor_notes = self._enforce_relationship_triage_rules(
            email, _proposal, body=body,
            durable_type=str(quick.get("durable_email_type", "") or ""),
            marketing_scan=_marketing_scan,
            learned_junk=bool(quick.get("learned_is_junk", False)),
        )
        suggested_category = _proposal["category"]
        suggested_urgency = _proposal["urgency"]
        suggested_status = _proposal["status"]

        if suggested_category in CATEGORIES and suggested_category != email.get("category"):
            email["category"] = suggested_category
            changed = True
        if suggested_urgency in URGENCY_LEVELS and suggested_urgency != email.get("urgency"):
            email["urgency"] = suggested_urgency
            changed = True
        if suggested_status in STATUSES and suggested_status != email.get("status"):
            if email.get("status") != "Completed" or suggested_status == "Completed":
                email["status"] = suggested_status
                changed = True
        _clamped_email_type = normalize_email_type_code(_proposal.get("email_type"))
        if _clamped_email_type and _clamped_email_type != normalize_email_type_code(email.get("email_type")):
            email["email_type"] = _clamped_email_type  # v4.1.17: e.g. vendor advertising -> M
            changed = True

        email["sender_type"] = _proposal["sender_type"]
        email["sender_intent"] = str(result.get("sender_intent", quick.get("sender_intent", ""))).strip()
        email["business_relevance"] = business_relevance
        email["spam_likelihood"] = spam_likelihood
        email["needs_followup_ai"] = bool(result.get("needs_followup", quick.get("needs_followup", False)))
        email["followup_reason_ai"] = str(result.get("followup_reason", quick.get("followup_reason", ""))).strip()
        email["same_subject_related_count"] = len(related)
        email["ai_triaged_at"] = datetime.now().isoformat()
        email["ai_triage_reason"] = (str(result.get("reason", quick.get("reason", ""))).strip()
                                     + ((" " + " ".join(_floor_notes)) if _floor_notes else "")).strip()
        email["ai_triage_pending"] = False

        if changed:
            self.save_record(email)
            self.flush_status_data()
        self.record_ai_triage_history(email, before={}, after={"category": email.get("category", ""), "urgency": email.get("urgency", ""), "status": email.get("status", ""), "group": self.get_group_id_for_email(email.get("entry_id", ""))}, reason=email.get("ai_triage_reason", ""), source="AI")

        thread_group_id = self.find_group_id_for_thread(email, skip_entry_id=email.get("entry_id", ""))
        if thread_group_id and not self.get_group_id_for_email(email.get("entry_id", "")):
            self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = thread_group_id
            email["thread_group_rule"] = "conversation_or_subject"
            self.mark_group_has_new(thread_group_id)
            self.save_groups()
            self._assistant_log_autogroup(email, thread_group_id,
                reason="Same conversation/subject as an existing grouped email.",
                rule="thread")
            changed = True
            return changed

        pa_group_id = self.auto_assign_pa_template_group(email)
        if pa_group_id:
            self._assistant_log_autogroup(email, pa_group_id,
                reason="Matched the RFQ 'Price and Availability Request - <name>' template for this group.",
                rule="pa_template")
            changed = True
            return changed

        _plugin_active = self._auto_group_engine_active()
        if _plugin_active:
            _plugin_gid = self.auto_assign_plugin_group(email)
            if _plugin_gid:
                changed = True
                return changed
            result = self._apply_plugin_suggestion_to_ai_result(email, result)

        business_group_id = "" if _plugin_active else self.auto_assign_business_key_group(email)
        if business_group_id:
            self._assistant_log_autogroup(email, business_group_id,
                reason="Matched a business key (PO / quote reference) for this group.",
                rule="business_key")
            changed = True
            return changed

        learned_group_rule, learned_group_key = (None, "") if _plugin_active else self.get_group_learning_hint_for_email(email)
        if learned_group_rule and not self.get_group_id_for_email(email.get("entry_id", "")):
            learned_group_id = learned_group_rule.get("group_id", "")
            if self.get_group_by_id(learned_group_id):
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = learned_group_id
                email["learned_group_rule"] = learned_group_key
                self.mark_group_has_new(learned_group_id)
                self.save_groups()
                self._assistant_log_autogroup(email, learned_group_id,
                    reason=f"Learned grouping rule matched ({learned_group_key}).",
                    rule="learned")
                changed = True
                return changed

        suggested_group_id = str(result.get("suggested_group_id", "")).strip()
        confidence = 0.0
        try:
            confidence = float(result.get("group_confidence", 0) or 0)
        except Exception:
            confidence = 0.0
        group = self.get_group_by_id(suggested_group_id)
        already_grouped = bool(self.get_group_id_for_email(email.get("entry_id", "")))
        # v4.1.35: while an Auto-Group Engine decision is PENDING, the AI suggestion is
        # STORED, never applied -- the deterministic engine must not lose a race to the
        # weaker signal. It replays through this same path if the engine says None.
        if group and not already_grouped and email.get("auto_group_engine_action") == "pending":
            email["pending_group_suggestion"] = {
                "group_id": suggested_group_id, "confidence": confidence,
                "reason": str(result.get("reason", "")).strip(),
                "mode": "assistant", "allow_group_prompt": bool(allow_group_prompt),
            }
            return changed
        assistant = getattr(self, "assistant", None)
        if group and not already_grouped and assistant and assistant.config.enabled:
            # Route grouping through the assistant: it auto-groups when confident
            # and surfaces (asks) when not — replacing the interrupting Yes/No popup.
            rec = assistant.handle(
                kind="Group", stakes=LOW,
                confidence=confidence_from_group(result),
                subject=email.get("subject", ""),
                sender=email.get("sender", ""),
                summary=f"Add to group '{group.get('name','')}'",
                before={"group": ""},
                after={"group": group.get("name", "")},
                reason=str(result.get("reason", "")).strip(),
                payload={"entry_id": email.get("entry_id", ""), "group_id": suggested_group_id},
                dedup_key=f"group:{email.get('entry_id','')}",
            )
            if rec.get("decision") in (AUTO, REVIEW):
                changed = True
        elif allow_group_prompt and group and not already_grouped and confidence >= AI_TRIAGE_GROUP_MIN_CONFIDENCE:
            # Legacy behavior when the assistant is off or unavailable.
            reason = str(result.get("reason", "")).strip()
            prompt = (
                f"AI thinks this email may belong in this group:\n\n"
                f"Group: {group.get('name', '')}\n"
                f"Confidence: {confidence:.0%}\n\n"
                f"Email: {email.get('subject', '')}\n"
                f"Reason: {reason}\n\n"
                f"Add this email to the group?"
            )
            if messagebox.askyesno("AI Group Suggestion", prompt):
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = suggested_group_id
                self.mark_group_has_new(suggested_group_id)
                self.save_groups()
                changed = True
        return changed

    def _offer_ai_group_suggestion(self, email, suggested_group_id, confidence, reason, allow_group_prompt):
        """v4.1.35: the assistant-group offer, callable from the deferred-replay path.
        Mirrors the inline block in apply_ai_triage_to_email exactly."""
        group = self.get_group_by_id(suggested_group_id)
        if not group or self.get_group_id_for_email(email.get("entry_id", "")):
            return False
        assistant = getattr(self, "assistant", None)
        if assistant and assistant.config.enabled:
            rec = assistant.handle(
                kind="Group", stakes=LOW,
                confidence=confidence,
                subject=email.get("subject", ""),
                sender=email.get("sender", ""),
                summary=f"Add to group '{group.get('name','')}'",
                before={"group": ""},
                after={"group": group.get("name", "")},
                reason=reason,
                payload={"entry_id": email.get("entry_id", ""), "group_id": suggested_group_id},
                dedup_key=f"group:{email.get('entry_id','')}",
            )
            return rec.get("decision") in (AUTO, REVIEW)
        if allow_group_prompt and confidence >= AI_TRIAGE_GROUP_MIN_CONFIDENCE:
            prompt = (
                f"AI thinks this email may belong in this group:\n\n"
                f"Group: {group.get('name', '')}\n"
                f"Confidence: {confidence:.0%}\n\n"
                f"Email: {email.get('subject', '')}\n"
                f"Reason: {reason}\n\n"
                f"Add this email to the group?"
            )
            if messagebox.askyesno("AI Group Suggestion", prompt):
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = suggested_group_id
                self.mark_group_has_new(suggested_group_id)
                self.save_groups()
                return True
        return False

    def handle_new_email_after_import(self, email, silent=False):
        """Run new-email automation without blocking import/refresh.

        v2.2: exact thread grouping first, then same-subject grouping, then spam/sender-intent prefilter,
        then queued AI triage only for messages that still need interpretation.
        """
        if not email:
            return
        if self.workflow_record_is_closed(email) or email.get("closed_guard_applied"):
            email["is_new_import"] = False
            return
        auto_group_id = self.auto_assign_same_thread_group(email)

        # v2.10.6: If this is a meaningful new inbound reply on a thread/group that was
        # previously Low or Completed, wake it back up so it appears as active work again.
        try:
            if self.reactivate_dormant_thread_if_needed(email, body=""):
                auto_group_id = self.get_group_id_for_email(email.get("entry_id", "")) or auto_group_id
        except Exception:
            pass

        if not auto_group_id:
            auto_group_id = self.auto_assign_pa_template_group(email)
        _plugin_active = self._auto_group_engine_active()
        if not auto_group_id and _plugin_active:
            auto_group_id = self.auto_assign_plugin_group(email)
        if not auto_group_id and not _plugin_active:
            auto_group_id = self.auto_assign_business_key_group(email)
        if not auto_group_id and not _plugin_active:
            auto_group_id = self.auto_assign_learned_group(email)
        if not auto_group_id and not _plugin_active:
            auto_group_id = self.auto_assign_same_subject_group(email)
        if auto_group_id:
            group = self.get_group_by_id(auto_group_id)
            if group:
                self.ai_status_var.set(f"Group: related email added to {group.get('name', '')}")

        # Very fast subject/sender-only prefilter so newsletters/system emails do not become follow-ups.
        try:
            quick_result = self.apply_quick_sender_intent(email, body="")
            if isinstance(quick_result, tuple):
                quick, quick_changed = quick_result
            else:
                quick, quick_changed = quick_result, False
            if quick_changed:
                if getattr(self, "_commitment_batch", 0):
                    # Bulk import in progress: defer the heavy writes + renders to the
                    # single flush/render the refresh orchestrator does at the end.
                    self._commitment_batch_cache_dirty = True
                    self._commitment_batch_status_dirty = True
                else:
                    self.flush_status_data()
                    self.save_cached_state()
                    self.render_email_rows()
                    self.render_group_rows()
            if quick.get("hard_decision"):
                return
        except Exception:
            pass

        # Quick subject-only scenario check must pass follow-up gates.
        try:
            quick = quick_sender_intent_analysis(
                email.get("subject", ""),
                email.get("sender_email") or email.get("sender", ""),
                "",
                related_count=int(email.get("same_subject_related_count", 0) or 0),
                source=email.get("source", "")
            )
            allowed, _why = should_allow_followup_decision(email, quick_result=quick)
            if allowed and text_mentions_po_or_order(email.get("subject", "")):
                if self.schedule_po_order_followup_if_needed(email, triage_result=quick, quick_result=quick):
                    self.followup_status_var.set(f"Follow-ups: PO/order draft scheduled for {CUSTOMER_PO_FOLLOWUP_MINUTES} min")
        except Exception:
            pass

        # v3.9.79: never re-triage (or even re-queue) an email the user already locked. The drip's
        # candidate gate already skips locked rows, but this direct new-import triage call bypasses
        # that gate, so a re-imported locked email could be AI-reclassified here. A close trigger is
        # the only sanctioned override of a user-set workflow.
        if AI_TRIAGE_ENABLED and not email.get("ai_user_locked"):
            email["ai_triage_pending"] = True
            if not silent:
                self.start_ai_triage_for_emails([email], task_name="triaging new email", allow_group_prompt=not bool(auto_group_id))

    def group_filter_allows_email(self, email):
        entry_id = email.get("entry_id", "")
        group_id = self.get_group_id_for_email(entry_id)

        # Archived groups should stay out of the main email window.
        # Their emails remain saved in MaINbox and can be viewed/restored from Archived Groups.
        if group_id:
            group = self.get_group_by_id(group_id)
            if group and group.get("archived", False):
                return False

        if self.active_group_filter == "all":
            return True
        if self.active_group_filter == "ungrouped":
            return not group_id
        return group_id == self.active_group_filter

    def render_group_rows(self):
        if not hasattr(self, "groups_tree"):
            return
        selected = self.groups_tree.selection()
        selected_iid = selected[0] if selected else ""
        self.groups_tree.delete(*self.groups_tree.get_children())

        total_grouped = len([eid for eid, gid in self.groups_data.get("memberships", {}).items() if self.get_group_by_id(gid)])
        all_iid = "filter:all"
        ungrouped_iid = "filter:ungrouped"
        ungrouped_count = len([email for email in self.emails if not self.get_group_id_for_email(email.get("entry_id", ""))])
        self.groups_tree.insert("", "end", iid=all_iid, text="All Emails", values=("", len(self.emails)), open=True)
        self.groups_tree.insert("", "end", iid=ungrouped_iid, text="Ungrouped", values=("", ungrouped_count), open=True)

        urgency_order = {"Critical": 0, "High": 1, "Normal": 2, "Low": 3}
        visible_groups = [g for g in self.groups_data.get("groups", []) if not g.get("archived", False)]
        sorted_groups = sorted(
            visible_groups,
            key=lambda g: (urgency_order.get(g.get("urgency", "Normal"), 2), str(g.get("name", "")).lower())
        )
        _seen_group_iids = set()
        # v4.1.10 efficiency: build group_id -> members ONCE (same idiom as
        # render_email_rows) instead of re-scanning every email for every group.
        _members_by_gid = {}
        for _email in self.emails:
            try:
                _gid = self.get_group_id_for_email(_email.get("entry_id", ""))
                if _gid:
                    _members_by_gid.setdefault(_gid, []).append(_email)
            except Exception:
                pass
        for group in sorted_groups:
            group_id = group.get("id", "")
            if not group_id:
                continue
            iid = f"group:{group_id}"
            # v4.1.10: never let a duplicate group id abort the whole startup render. A
            # collision here used to raise TclError('... already exists') mid-way through
            # load_cached_state, leaving the window half-built and the splash hung forever.
            if iid in _seen_group_iids or self.groups_tree.exists(iid):
                continue
            _seen_group_iids.add(iid)
            members = _members_by_gid.get(group_id, [])
            is_open = not bool(group.get("collapsed", False))
            urgency = group.get("urgency", "Normal")
            tags = ("group_new",) if group.get("has_new") else ()
            label = group.get("name", "Untitled Group")
            if group.get("has_new"):
                label = f"● {label}"
            self.groups_tree.insert("", "end", iid=iid, text=label, values=(urgency, len(members)), open=is_open, tags=tags)
            for email in members:
                child_iid = f"member:{group_id}:{email.get('entry_id', '')}"
                if self.groups_tree.exists(child_iid):
                    continue
                label = f"{email.get('sender', '')} — {email.get('subject', '')}"
                self.groups_tree.insert(iid, "end", iid=child_iid, text=label[:120], values=("", email.get("received", "")))

        if selected_iid and self.groups_tree.exists(selected_iid):
            self.groups_tree.selection_set(selected_iid)

    def selected_group_id_from_groups_tree(self):
        selected = self.groups_tree.selection() if hasattr(self, "groups_tree") else []
        if not selected:
            return ""
        iid = selected[0]
        if iid.startswith("group:"):
            return iid.split(":", 1)[1]
        if iid.startswith("member:"):
            parts = iid.split(":", 2)
            return parts[1] if len(parts) > 1 else ""
        return ""

    def choose_group_urgency(self, title="Group Urgency", initial="Normal"):
        win = tk.Toplevel(self.root)
        win.title(title)
        remember_window_geometry(win, title, "360x190")
        win.resizable(False, False)
        win.transient(self.root)
        win.grab_set()
        tk.Label(win, text="Select group urgency", font=("Segoe UI", 13, "bold")).pack(pady=12)
        urgency_var = tk.StringVar(value=initial if initial in URGENCY_LEVELS else "Normal")
        box = ttk.Combobox(win, textvariable=urgency_var, values=URGENCY_LEVELS, state="readonly", width=18)
        box.pack(pady=8)
        result = {"value": None}
        def save():
            result["value"] = urgency_var.get() or "Normal"
            win.destroy()
        def cancel():
            win.destroy()
        btns = tk.Frame(win)
        btns.pack(pady=12)
        tk.Button(btns, text="Save", command=save, width=12).pack(side="left", padx=6)
        tk.Button(btns, text="Cancel", command=cancel, width=12).pack(side="left", padx=6)
        win.wait_window()
        return result["value"]

    def offer_group_for_single_email_rfq(self, group_id, emails):
        """v3.9.22: After an RFQ is sent from the right-click (single-email) path, the email
        has only a transient 'single_email_rfq:<entry_id>' id and no real group. Offer to
        create a real group (with the original request email in it) so vendor replies stay
        organized. No-ops for real groups so an RFQ that already has one is never duplicated.
        Fully guarded; never raises."""
        try:
            gid = str(group_id or "")
            if not gid.startswith("single_email_rfq:"):
                return  # real group already exists -- do not create a duplicate
            source_entry_id = gid.split("single_email_rfq:", 1)[1].strip()
            if not source_entry_id:
                return
            if not messagebox.askyesno(
                "Organize RFQ",
                "Create a group for this RFQ so the original request and the vendor replies stay together?"
            ):
                return
            default_name = ""
            try:
                src = next((e for e in (emails or []) if e.get("entry_id") == source_entry_id), None)
                if src:
                    default_name = (src.get("subject") or "").strip()[:80]
            except Exception:
                default_name = ""
            name = simpledialog.askstring("New Group", "Group name / quote job name:",
                                          initialvalue=default_name, parent=self.root)
            if not name or not name.strip():
                return
            name = name.strip()
            urgency = self.choose_group_urgency("New Group Urgency", initial="Normal")
            if not urgency:
                return
            new_group_id = self._unique_group_id()  # v4.1.10: collision-proof
            self.groups_data.setdefault("groups", []).append({
                "id": new_group_id, "name": name, "urgency": urgency, "collapsed": False,
                "has_new": False, "created_at": datetime.now().isoformat(), "notes": "", "archived": False})
            self.groups_data.setdefault("memberships", {})[source_entry_id] = new_group_id
            self.save_groups()
            try:
                self.active_group_filter = "all"
                self.render_group_rows()
                self.sort_emails_for_display()
                self.render_email_rows()
            except Exception:
                pass
            try:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, f"Created {urgency} group: {name}\n\nThe original quote email is now in this group. Vendor replies on this RFQ will group here.")
            except Exception:
                pass
        except Exception:
            pass

    def create_group(self):
