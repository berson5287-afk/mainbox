        entry_id = self._group_member_entry_id_from_iid(iid)
        try:
            menu = tk.Menu(self.root, tearoff=0)
            if entry_id:
                menu.add_command(label="Open in Outlook", command=lambda eid=entry_id: self.open_group_member_in_outlook(eid))
                menu.add_command(label="Move", command=lambda eid=entry_id: self.move_group_member_to_another_group(eid))
