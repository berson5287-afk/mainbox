        def export_purchase_history_sqlite():
            path = filedialog.asksaveasfilename(
                parent=win,
                title="Export Procurement Memory SQLite",
                defaultextension=".db",
                filetypes=[("SQLite database", "*.db"), ("All files", "*.*")],
                initialfile="purchasing_memory.db",
            )
            if not path:
                return
            try:
                mem = self.procurement_memory or default_procurement_memory()
                conn = sqlite3.connect(path)
                cur = conn.cursor()
                cur.executescript("""
                PRAGMA journal_mode=WAL;
                CREATE TABLE IF NOT EXISTS vendors (
                    vendor_email TEXT PRIMARY KEY,
                    vendor_name TEXT,
                    request_count INTEGER DEFAULT 0,
                    award_count INTEGER DEFAULT 0,
                    last_awarded_at TEXT
                );
                CREATE TABLE IF NOT EXISTS material_records (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    material_key TEXT,
                    raw_text TEXT,
                    normalized_description TEXT,
                    description TEXT,
                    qty TEXT,
                    unit TEXT,
                    manufacturer TEXT,
                    part_number TEXT,
                    sku TEXT,
                    dimensions TEXT,
                    material_type TEXT,
                    finish TEXT,
                    schedule_rating TEXT,
                    vendor_email TEXT,
                    vendor_name TEXT,
                    unit_price REAL,
                    total_price REAL,
                    job TEXT,
                    subject TEXT,
                    source TEXT,
                    email_date TEXT,
                    created_at TEXT
                );
                CREATE TABLE IF NOT EXISTS aliases (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    material_key TEXT,
                    alias TEXT,
                    canonical_description TEXT
                );
                CREATE INDEX IF NOT EXISTS idx_material_records_key ON material_records(material_key);
                CREATE INDEX IF NOT EXISTS idx_material_records_vendor ON material_records(vendor_email);
                CREATE INDEX IF NOT EXISTS idx_material_records_desc ON material_records(normalized_description, description, raw_text);
                """)
                cur.execute("DELETE FROM vendors")
                cur.execute("DELETE FROM material_records")
                cur.execute("DELETE FROM aliases")
                for email, v in (mem.get("vendors", {}) or {}).items():
                    if not isinstance(v, dict):
                        continue
                    cur.execute(
                        "INSERT OR REPLACE INTO vendors(vendor_email, vendor_name, request_count, award_count, last_awarded_at) VALUES (?, ?, ?, ?, ?)",
                        (str(email or v.get("email", "")).lower(), v.get("name", ""), int(v.get("request_count", 0) or 0), int(v.get("award_count", 0) or 0), v.get("last_awarded_at", "")),
                    )
                for rec in (mem.get("price_history", []) or []):
                    if not isinstance(rec, dict):
                        continue
                    desc = rec.get("description", "") or rec.get("normalized_description", "") or rec.get("raw_text", "")
                    key = rec.get("material_key", "") or canonical_material_key({"description": desc, "part_number": rec.get("part_number", "")})
                    cur.execute(
                        """INSERT INTO material_records(material_key, raw_text, normalized_description, description, qty, unit, part_number, vendor_email, vendor_name, unit_price, total_price, job, subject, source, email_date, created_at)
                           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                        (key, rec.get("raw_text", ""), desc, desc, rec.get("qty", ""), rec.get("unit", ""), rec.get("part_number", ""), str(rec.get("vendor_email", "") or "").lower(), rec.get("vendor_name", ""), rec.get("unit_price"), rec.get("total_price"), rec.get("job", ""), rec.get("notes", ""), rec.get("source", "mainbox_export"), rec.get("email_date", ""), rec.get("created_at", "")),
                    )
                for key, m in (mem.get("materials", {}) or {}).items():
                    if not isinstance(m, dict):
                        continue
                    sample = m.get("sample_description", "")
                    if sample:
                        cur.execute("INSERT INTO aliases(material_key, alias, canonical_description) VALUES (?, ?, ?)", (key, sample, sample))
                conn.commit()
                conn.close()
                status_var.set(f"Exported procurement memory SQLite: {os.path.basename(path)}")
                messagebox.showinfo("Export Complete", f"Exported procurement memory to:\n{path}", parent=win)
            except Exception as exc:
                try:
                    conn.close()
                except Exception:
                    pass
                messagebox.showerror("SQLite Export Failed", str(exc), parent=win)

        def import_purchase_history_sqlite():
            path = filedialog.askopenfilename(
                parent=win,
                title="Import Procurement Memory SQLite",
                filetypes=[("SQLite database", "*.db;*.sqlite;*.sqlite3"), ("All files", "*.*")],
            )
            if not path:
                return
            if not messagebox.askyesno("Import SQLite", "Import this SQLite purchasing-memory file and merge it into MaINbox procurement memory?\n\nThis will not delete existing memory.", parent=win):
                return
            imported = 0
            skipped = 0
            try:
                conn = sqlite3.connect(path)
                conn.row_factory = sqlite3.Row
                cur = conn.cursor()
                table_names = {r[0].lower(): r[0] for r in cur.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
                # v2.9.5: SQLite import is a REPLACE, not merge. This prevents old
                # vendors/materials from surviving after the user cleaned the DB.
                mem = default_procurement_memory()
                mem.setdefault("materials", {})
                mem.setdefault("vendors", {})
                mem.setdefault("awards", [])
                mem.setdefault("price_history", [])
                mem.setdefault("routing_rules", {})
                now = datetime.now().isoformat()

                def first_value(row, names, default=""):
                    keys = set(row.keys())
                    for name in names:
                        if name in keys and row[name] is not None:
                            return row[name]
                    return default

                vendor_names = {}
                if "vendors" in table_names:
                    for row in cur.execute(f"SELECT * FROM {table_names['vendors']}"):
                        email = str(first_value(row, ["vendor_email", "email", "sender_email"], "") or "").lower().strip()
                        name = str(first_value(row, ["vendor_name", "name", "sender_name"], "") or email).strip()
                        if email and not is_blocked_internal_vendor(email, name):
                            vendor_names[email] = name
                            vrec = mem.setdefault("vendors", {}).setdefault(email, {"email": email, "name": name, "request_count": 0, "award_count": 0})
                            if name:
                                vrec["name"] = name

                material_table = None
                for possible in ["material_records", "materials", "purchase_history", "price_history", "line_items"]:
                    if possible in table_names:
                        material_table = table_names[possible]
                        break
                if not material_table:
                    raise RuntimeError("No supported material table found. Expected one of: material_records, materials, purchase_history, price_history, line_items.")

                rows = cur.execute(f"SELECT * FROM {material_table}").fetchall()
                for row in rows:
                    desc = str(first_value(row, ["normalized_description", "description", "material", "item", "raw_text", "line_text"], "") or "").strip()
                    raw_text = str(first_value(row, ["raw_text", "line_text", "source_text", "notes"], "") or desc).strip()
                    part_number = str(first_value(row, ["part_number", "part", "sku", "manufacturer_part_number", "mpn"], "") or "").strip()
                    vendor_email = str(first_value(row, ["vendor_email", "sender_email", "email"], "") or "").lower().strip()
                    vendor_name = str(first_value(row, ["vendor_name", "vendor", "sender_name", "company"], "") or vendor_names.get(vendor_email, vendor_email)).strip()
                    if not desc and not part_number:
                        skipped += 1
                        continue
                    if not vendor_email and vendor_name:
                        vendor_email = vendor_name.lower().replace(" ", "_")
                    if not vendor_email or is_blocked_internal_vendor(vendor_email, vendor_name):
                        skipped += 1
                        continue
                    item = {
                        "qty": str(first_value(row, ["qty", "quantity"], "") or ""),
                        "unit": str(first_value(row, ["unit", "uom"], "") or ""),
                        "description": desc,
                        "part_number": part_number,
                        "notes": "imported from SQLite PST memory",
                    }
                    key = str(first_value(row, ["material_key", "canonical_key", "key"], "") or "").strip() or canonical_material_key(item)
                    if not key:
                        skipped += 1
                        continue
                    vrec = mem.setdefault("vendors", {}).setdefault(vendor_email, {"email": vendor_email, "name": vendor_name, "request_count": 0, "award_count": 0})
                    if vendor_name:
                        vrec["name"] = vendor_name
                    vrec["award_count"] = int(vrec.get("award_count", 0) or 0) + 1
                    vrec["last_awarded_at"] = now
                    mrec = mem.setdefault("materials", {}).setdefault(key, {"key": key, "sample_description": desc, "vendors": {}})
                    if desc:
                        mrec["sample_description"] = desc
                    stat = mrec.setdefault("vendors", {}).setdefault(vendor_email, {"email": vendor_email, "name": vendor_name, "request_count": 0, "award_count": 0})
                    if vendor_name:
                        stat["name"] = vendor_name
                    stat["award_count"] = int(stat.get("award_count", 0) or 0) + 1
                    stat["preferred"] = True
                    stat["last_awarded_at"] = now
                    unit_price = first_value(row, ["unit_price", "price_each", "price"], None)
                    total_price = first_value(row, ["total_price", "extended_price", "total"], None)
                    try:
                        unit_price = float(unit_price) if unit_price not in (None, "") else None
                    except Exception:
                        unit_price = None
                    try:
                        total_price = float(total_price) if total_price not in (None, "") else None
                    except Exception:
                        total_price = None
                    if unit_price is not None:
                        stat["last_unit_price"] = unit_price
                    job = str(first_value(row, ["job", "group_name", "project", "customer"], "") or "")
                    subject = str(first_value(row, ["subject", "email_subject", "notes"], "") or "")
                    email_date = str(first_value(row, ["email_date", "date", "sent_date", "received_date", "timestamp"], "") or "")
                    mem.setdefault("awards", []).append({"created_at": now, "source": "sqlite_import", "vendor": {"email": vendor_email, "name": vendor_name}, "material_key": key, "material": item, "group_id": "", "group_name": job, "unit_price": unit_price, "total_price": total_price, "notes": f"SQLite import: {subject}"})
                    mem.setdefault("price_history", []).append({"created_at": now, "source": "sqlite_import", "vendor_email": vendor_email, "vendor_name": vendor_name, "material_key": key, "description": desc, "qty": item.get("qty", ""), "unit": item.get("unit", ""), "part_number": part_number, "unit_price": unit_price, "total_price": total_price, "job": job, "email_date": email_date, "raw_text": raw_text, "notes": subject})
                    mem.setdefault("routing_rules", {}).setdefault(key, [])
                    if vendor_email not in mem["routing_rules"][key]:
                        mem["routing_rules"][key].insert(0, vendor_email)
                    imported += 1

                conn.close()
                purge_blocked_procurement_vendors_from_memory(mem)

                # Keep both learned-vendor stores aligned with the imported SQLite DB.
                # Import is intentionally a replace, not a merge, so rebuild vendor_history
                # from the imported procurement memory before saving.
                hist = default_vendor_history()
                hist.setdefault("vendors", {})
                hist.setdefault("materials", {})
                hist.setdefault("customers", {})
                hist.setdefault("jobs", {})
                hist["updated_at"] = datetime.now().isoformat()
                for email, v in (mem.get("vendors", {}) or {}).items():
                    email = str(email or v.get("email", "") or "").lower().strip()
                    name = str((v or {}).get("name", "") or email).strip()
                    if email and not is_blocked_internal_vendor(email, name):
                        hist["vendors"][email] = {
                            "email": email,
                            "name": name,
                            "times_used": int((v or {}).get("request_count", 0) or 0),
                            "last_used_at": (v or {}).get("last_used_at", "") or (v or {}).get("last_awarded_at", ""),
                        }
                for key, m in (mem.get("materials", {}) or {}).items():
                    key = str(key or "").strip()
                    if not key:
                        continue
                    entries = []
                    for email, stat in ((m or {}).get("vendors", {}) or {}).items():
                        email = str(email or "").lower().strip()
                        name = str((stat or {}).get("name", "") or email).strip()
                        if email and not is_blocked_internal_vendor(email, name):
                            entries.append({
                                "email": email,
                                "name": name,
                                "times_used": int((stat or {}).get("request_count", 0) or 0),
                                "last_used_at": (stat or {}).get("last_requested_at", "") or (stat or {}).get("last_awarded_at", ""),
                                "sample_description": (m or {}).get("sample_description", ""),
                            })
                    if entries:
                        hist["materials"][key] = entries
                self.vendor_history = hist
                save_json(VENDOR_HISTORY_FILE, self.vendor_history)

                self.procurement_memory = mem
                self.save_procurement_memory()
                status_var.set(f"Imported {imported} row(s) from SQLite. Skipped {skipped} incomplete row(s).")
                messagebox.showinfo("Import Complete", f"Imported {imported} material/history row(s).\nSkipped {skipped} incomplete row(s).", parent=win)
            except Exception as exc:
                try:
                    conn.close()
                except Exception:
                    pass
                messagebox.showerror("SQLite Import Failed", str(exc), parent=win)

