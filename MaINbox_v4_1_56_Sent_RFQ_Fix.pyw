        try:
            # v3.9.105: the bridge dir was hardcoded to another PC's profile
            # (C:\Users\Berso\...), so the import failed and the bridge silently
            # reported "disabled" on every launch here. Resolve it properly:
            # MAINBOX_BRIDGE_DIR env override, else the documented default
            # %LOCALAPPDATA%\MaINbox\bridge, else the legacy desktop path when it
            # actually exists (so the original machine keeps working unchanged).
            _bridge_candidates = [
                os.environ.get("MAINBOX_BRIDGE_DIR", "").strip(),
                data_path("bridge"),
                r"C:\Users\Berso\OneDrive\Desktop\MB Bridge",
            ]
            _bridge_dir = ""
            for _cand in _bridge_candidates:
                if _cand and os.path.isfile(os.path.join(_cand, "mainbox_bridge.py")):
                    _bridge_dir = _cand
                    break
            if not _bridge_dir:
                raise ImportError(
                    "mainbox_bridge.py not found (searched MAINBOX_BRIDGE_DIR, "
                    + data_path("bridge") + ", and the legacy desktop path)"
                )
            if _bridge_dir not in sys.path:
                sys.path.insert(0, _bridge_dir)
            from mainbox_bridge import MainboxAdapter as _MainboxAdapter
            self.bridge = _MainboxAdapter()
            self.bridge.heartbeat(app_version=mainbox_version_number())
            self._bridge_publish_followups(force=True)  # give Brain an initial snapshot
            self.root.after(4000, self._bridge_tick)
            self.log("Bridge: connected, follow-up snapshot published")
        except Exception as _bridge_err:
            self.bridge = None
            self.log(f"Bridge: disabled ({_bridge_err})")
