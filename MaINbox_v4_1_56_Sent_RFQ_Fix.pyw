            def pick_color(key, var, swatch):
                from tkinter import colorchooser
                current = var.get() or "#ffffff"
                chosen = colorchooser.askcolor(color=current, parent=cwin, title="Pick a color")
                if chosen and chosen[1]:
                    var.set(chosen[1])
                    try:
                        swatch.configure(bg=chosen[1])
                    except Exception:
                        pass

