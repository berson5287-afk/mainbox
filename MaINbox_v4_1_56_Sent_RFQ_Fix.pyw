                swatch.grid(row=row_idx, column=1, sticky="w", pady=3, padx=(0, 6))
                swatch.bind("<Button-1>", lambda e, k=key, v=var, s=swatch: pick_color(k, v, s))
                swatch_labels[key] = swatch
                hex_entry = tk.Entry(cframe, textvariable=var, width=10, bg=_ENTRY_BG, fg=_FG, insertbackground=_FG)
                hex_entry.grid(row=row_idx, column=2, sticky="w", pady=3)

