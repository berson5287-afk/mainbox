            if self.ai_cancel_event:
                self.ai_cancel_event.set()
        except Exception:
            pass
        self.auto_refresh_enabled = False
        self.followup_check_enabled = False
        self.flush_status_data()
        self.save_followups()
        self.save_pending_reply_checks()
        self.save_groups()
        try:
            self.save_learning_rules()
        except Exception:
            pass
        try:
            self.save_triage_history()
        except Exception:
            pass
        try:
            self.save_deleted_history()
        except Exception:
            pass
        try:
            self._bootstrap_closed_email_guard()
            self._save_closed_email_guard()
        except Exception:
            pass
        try:
            self.save_scenario_reminders()
            self.save_commitment_reminders()
        except Exception:
            pass
        try:
            self.save_sent_waiting_placeholders()
        except Exception:
            pass
        try:
            self.save_vendor_history()
        except Exception:
            pass
        try:
            self.save_quote_requests()
        except Exception:
            pass
        try:
            self.save_quote_coverage()  # v3.9.1
        except Exception:
            pass
        try:
            if isinstance(getattr(self, "procurement_memory", None), dict):
                self.procurement_memory["updated_at"] = datetime.now().isoformat()
                save_json(PROCUREMENT_MEMORY_FILE, self.procurement_memory)
        except Exception:
            pass
        self.save_cached_state()
        self.root.destroy()


