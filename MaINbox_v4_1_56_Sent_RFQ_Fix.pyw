        def view_followup_rules():
            rules_win = tk.Toplevel(win)
            rules_win.title("Adaptive Follow-Up Learning Rules")
            remember_window_geometry(rules_win, "Adaptive Follow-Up Learning Rules", "980x520")
            rules_win.transient(win)
            search_frame = tk.LabelFrame(rules_win, text="Search Follow-Up Learning Rules")
            search_frame.pack(fill="x", padx=10, pady=(10, 4))
            tk.Label(search_frame, text="Search behavior / sender / subject / domain:").pack(side="left", padx=6, pady=6)
            search_var = tk.StringVar()
            search_entry = tk.Entry(search_frame, textvariable=search_var, width=55)
            search_entry.pack(side="left", padx=6, pady=6)
            count_var = tk.StringVar(value="")
            tk.Label(search_frame, textvariable=count_var, fg=_FG_DIM).pack(side="right", padx=8)
            rule_tree = ttk.Treeview(rules_win, columns=("behavior", "minutes", "confidence", "times", "sender", "subject", "updated"), show="headings", selectmode="extended")
            for col, label, width in [
                ("behavior", "Behavior", 140), ("minutes", "Minutes", 80), ("confidence", "Confidence", 90),
                ("times", "Times", 70), ("sender", "Sender / Domain", 210), ("subject", "Subject Pattern", 260), ("updated", "Updated", 155)
            ]:
                rule_tree.heading(col, text=label)
                rule_tree.column(col, width=width)
            rule_tree.pack(fill="both", expand=True, padx=10, pady=6)

            def rows():
                items = []
                for key, rule in self.learning_data.get("followups", {}).items():
                    if not isinstance(rule, dict):
                        continue
                    items.append((key, rule))
                items.sort(key=lambda kv: kv[1].get("updated_at", ""), reverse=True)
                return items

            def refresh_rules(*_):
                rule_tree.delete(*rule_tree.get_children())
                q = search_var.get().strip().lower()
                visible = []
                for key, rule in rows():
                    hay = " ".join([key, str(rule.get("behavior", "")), str(rule.get("sender", "")), str(rule.get("domain", "")), str(rule.get("subject", "")), str(rule.get("sample_subject", "")), str(rule.get("reason", ""))]).lower()
                    if q and not all(part in hay for part in q.split()):
                        continue
                    visible.append((key, rule))
                    conf = float(rule.get("confidence", 0) or 0)
                    sender_label = rule.get("sender") or rule.get("domain") or key
                    rule_tree.insert("", "end", iid=key, values=(
                        rule.get("behavior", ""),
                        "" if rule.get("minutes") is None else rule.get("minutes"),
                        f"{conf:.0%}",
                        rule.get("times", 0),
                        sender_label,
                        rule.get("sample_subject") or rule.get("subject", ""),
                        rule.get("updated_at", ""),
