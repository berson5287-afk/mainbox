    def email_is_completed(self, email):
        """True when the user has closed/hidden this email in MaINbox.

        Follow-up automation should treat Completed, Low, and Junk/Ignore as
        closed states.  The old check only looked at Status == Completed, which
        allowed AI scenario reminders to remain/reappear for items the user had
        already buried as Low or Junk, and sometimes kept completed trackers in
        the Follow-Up Queue until they became due.
        """
        try:
            email = email or {}
            return (
                email.get("status", "") == "Completed"
                or email.get("urgency", "") == "Low"
                or email.get("category", "") == "Junk / Ignore"
            )
        except Exception:
            return False

    def _followup_item_matches_email(self, item, email):
        """Match a follow-up/reminder/check to an email using the strongest IDs available."""
        try:
            if not item or not email:
                return False
            entry_id = email.get("entry_id", "")
            conversation_id = email.get("conversation_id", "")
            subject = (email.get("subject", "") or "").strip().lower()
            group_id = self.get_group_id_for_email(entry_id) if entry_id else ""

            if entry_id and item.get("entry_id") == entry_id:
                return True
            if conversation_id and item.get("conversation_id") == conversation_id:
                return True
            if group_id and item.get("group_id") == group_id:
                return True

            # Subject is only a last-resort fallback for older saved follow-up records
            # that may not have EntryID/ConversationID populated.
            item_subject = (item.get("subject", "") or "").strip().lower()
            if subject and item_subject and subject == item_subject:
                return True
        except Exception:
            pass
        return False

    def collect_active_tracking_items_for_emails(self, emails):
        """
        Return active follow-up/tracking rows associated with the selected email(s).
        Includes manual follow-ups, automatic scenario reminders, pending reply checks,
        and commitment reminders (promised dates / reply-needed).  # v3.8.31
        """
        rows = []
        seen = set()
        email_list = [e for e in (emails or []) if isinstance(e, dict)]

        def add_row(collection_name, index, item, kind, tracking_type, email):
            if not item or item.get("completed") or item.get("cancelled"):
                return
            key = (collection_name, index)
            if key in seen:
                return
            seen.add(key)
            rows.append({
                "key": key,
                "collection": collection_name,
                "index": index,
                "item": item,
                "kind": kind,
                "tracking_type": tracking_type,
                "email": email,
                "subject": item.get("subject") or email.get("subject", "") or "(No subject)",
                "due": self.format_due_display(item.get("due_at", "")) if hasattr(self, "format_due_display") else item.get("due_at", ""),
                "note": item.get("message") or item.get("note") or item.get("reason") or item.get("description") or "",
            })

        for email in email_list:
            for index, item in enumerate(getattr(self, "followups", []) or []):
                if self._followup_item_matches_email(item, email):
                    add_row("followups", index, item, "Manual follow-up", "Manual", email)

            for index, item in enumerate(getattr(self, "scenario_reminders", []) or []):
                if self._followup_item_matches_email(item, email):
                    scenario_type = item.get("type", "scenario")
                    if scenario_type == "vendor_no_response":
                        kind = "Auto: Vendor no-response"
                    elif scenario_type == "customer_po_order_followup":
                        kind = "Auto: PO/order follow-up"
                    else:
                        kind = "Auto: " + scenario_type.replace("_", " ").title()
                    add_row("scenario_reminders", index, item, kind, "Auto", email)

            for index, item in enumerate(getattr(self, "pending_reply_checks", []) or []):
                if self._followup_item_matches_email(item, email):
                    add_row("pending_reply_checks", index, item, "Auto: Pending reply check", "Auto", email)

            # v3.8.30: commitment reminders (promised dates / reply-needed) are active
            # tracking for the email too, so they must show up in the completion review
            # and clear when the email is marked Completed. They were omitted here, so a
            # commitment reminder kept firing even after its email was completed.
            for index, item in enumerate(getattr(self, "commitment_reminders", []) or []):
                if self._followup_item_matches_email(item, email):
                    c_kind = "Auto: " + (item.get("kind_label") or "Commitment reminder")
                    add_row("commitment_reminders", index, item, c_kind, "Auto", email)

        return rows

    def review_tracking_items_before_complete(self, emails):
        """
        When marking email(s) Completed/Low/Junk, let the user decide which related
        follow-ups/tracking records to clear. Automatic items are selected by default;
        manual follow-ups are shown but left unselected unless the user chooses them.
        """
        rows = self.collect_active_tracking_items_for_emails(emails)
        if not rows:
            return set()

        win = tk.Toplevel(self.root)
        win.title("Review Follow-Ups Before Completing")
        remember_window_geometry(win, "Review Follow-Ups Before Completing", "980x460")
        win.transient(self.root)
        win.grab_set()

        tk.Label(
            win,
            text="This email has active follow-up/tracking items.",
            font=("Segoe UI", 14, "bold")
        ).pack(anchor="w", padx=12, pady=(10, 2))
        tk.Label(
            win,
            text="Automatic items are selected by default. Manual follow-ups are shown so you can choose whether to keep or clear them.",
            font=("Segoe UI", 9)
        ).pack(anchor="w", padx=12, pady=(0, 8))

        columns = ("clear", "type", "due", "subject", "note")
        tree = ttk.Treeview(win, columns=columns, show="headings", selectmode="extended", height=12)
        tree.heading("clear", text="Clear?")
        tree.heading("type", text="Auto / Manual")
        tree.heading("due", text="Due")
        tree.heading("subject", text="Subject")
        tree.heading("note", text="Note")
        tree.column("clear", width=70, anchor="center")
        tree.column("type", width=180)
        tree.column("due", width=120)
        tree.column("subject", width=300)
        tree.column("note", width=280)
        tree.pack(fill="both", expand=True, padx=12, pady=6)

        selected_keys = set()
        row_by_iid = {}
        for idx, row in enumerate(rows):
            iid = str(idx)
            row_by_iid[iid] = row
            if row.get("tracking_type") == "Auto":
                selected_keys.add(row["key"])
            tree.insert(
                "", "end", iid=iid,
                values=(
                    "Yes" if row["key"] in selected_keys else "No",
                    row.get("kind", ""),
                    row.get("due", ""),
                    row.get("subject", ""),
                    row.get("note", ""),
                )
            )

        result = {"keys": None, "skip_complete": False}

        def refresh_marks():
            for iid, row in row_by_iid.items():
                vals = list(tree.item(iid, "values"))
                vals[0] = "Yes" if row["key"] in selected_keys else "No"
                tree.item(iid, values=vals)

        def toggle_selected(event=None):
            iids = tree.selection()
            if not iids:
                iid = tree.focus()
                iids = [iid] if iid else []
            for iid in iids:
                row = row_by_iid.get(iid)
                if not row:
                    continue
                key = row["key"]
                if key in selected_keys:
                    selected_keys.remove(key)
                else:
                    selected_keys.add(key)
            refresh_marks()

        def select_auto():
            selected_keys.clear()
            for row in rows:
                if row.get("tracking_type") == "Auto":
                    selected_keys.add(row["key"])
            refresh_marks()

        def select_all():
            selected_keys.clear()
            selected_keys.update(row["key"] for row in rows)
            refresh_marks()

        def select_none():
            selected_keys.clear()
            refresh_marks()

        def clear_selected_and_close():
            result["keys"] = set(selected_keys)
            win.destroy()

        def clear_all_and_close():
            result["keys"] = {row["key"] for row in rows}
            win.destroy()

        def keep_all_and_close():
            result["keys"] = set()
            win.destroy()

        def skip_mark_complete_and_close():
            result["skip_complete"] = True
            result["keys"] = None
            win.destroy()

        tree.bind("<Double-Button-1>", toggle_selected)
        tree.bind("<space>", toggle_selected)
        # Delete key acts as the "Clear Selected" button (commit marked rows).
        tree.bind("<Delete>", lambda e: clear_selected_and_close())

        helper = tk.Label(win, text="Tip: double-click a row or press Space to toggle Clear Yes/No.", font=("Segoe UI", 9), fg=_FG_DIM)
        helper.pack(anchor="w", padx=12, pady=(0, 6))

        btns = tk.Frame(win)
        btns.pack(fill="x", padx=12, pady=(0, 12))
        tk.Button(btns, text="Select Auto Only", command=select_auto, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Select All", command=select_all, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Select None", command=select_none, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Skip Marking Complete", command=skip_mark_complete_and_close, width=22).pack(side="right", padx=4)
        tk.Button(btns, text="Keep All", command=keep_all_and_close, width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Clear All", command=clear_all_and_close, width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Clear Selected", command=clear_selected_and_close, width=16).pack(side="right", padx=4)

        try:
            win.lift()
            win.focus_force()
        except Exception:
            pass
        self.root.wait_window(win)

        if result.get("skip_complete"):
            return None
        return result["keys"] if result["keys"] is not None else set()

    def cancel_selected_tracking_items(self, keys_to_cancel, reason="Cancelled when email marked Completed"):
        """Cancel selected follow-up/tracking records by collection/index key."""
        if not keys_to_cancel:
            return 0
        now_iso = datetime.now().isoformat()
        cancelled = 0
        collections = {
            "followups": getattr(self, "followups", []),
            "scenario_reminders": getattr(self, "scenario_reminders", []),
            # v3.8.30: was missing. collect_active_tracking_items_for_emails now emits
            # "commitment_reminders"-keyed rows, so this map must resolve that collection
            # or those rows would silently never cancel even though the dialog reported them.
            "commitment_reminders": getattr(self, "commitment_reminders", []),
            "pending_reply_checks": getattr(self, "pending_reply_checks", []),
        }
        for collection_name, index in keys_to_cancel:
            items = collections.get(collection_name) or []
            try:
                item = items[index]
            except Exception:
                continue
            if not isinstance(item, dict):
                continue
            if item.get("completed") or item.get("cancelled"):
                continue
            item["cancelled"] = True
            item["cancelled_at"] = now_iso
            item["cancel_reason"] = reason
            cancelled += 1

        if cancelled:
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_pending_reply_checks()
        return cancelled

    def cancel_automatic_tracking_for_email(self, email, reason="Email marked Completed"):
        """
        Stop automatic tracking for a completed email without touching manual follow-ups.

        Preserved:
        - self.followups created from the Setup / Edit Follow Up window

        Cancelled:
        - scenario_reminders such as vendor no-response, customer PO, AI review reminders
        - pending_reply_checks created after MaINbox opens a draft and waits for Sent Items
        - commitment_reminders (promised dates / reply-needed)  # v3.8.31
        """
        if not email:
            return 0

        entry_id = email.get("entry_id", "")
        conversation_id = email.get("conversation_id", "")
        now_iso = datetime.now().isoformat()
        cancelled = 0

        for item in getattr(self, "scenario_reminders", []):
            if item.get("completed") or item.get("cancelled"):
                continue
            same_entry = entry_id and item.get("entry_id") == entry_id
            same_conversation = conversation_id and item.get("conversation_id") == conversation_id
            if same_entry or same_conversation:
                item["cancelled"] = True
                item["cancelled_at"] = now_iso
                item["cancel_reason"] = reason
                cancelled += 1

        for item in getattr(self, "pending_reply_checks", []):
            if item.get("completed") or item.get("cancelled"):
                continue
            same_entry = entry_id and item.get("entry_id") == entry_id
            same_conversation = conversation_id and item.get("conversation_id") == conversation_id
            if same_entry or same_conversation:
                item["cancelled"] = True
                item["cancelled_at"] = now_iso
                item["cancel_reason"] = reason
                cancelled += 1

        # v3.8.31: also cancel commitment reminders (promised dates / reply-needed) for
        # this email. This helper is currently unused, but the completion-review path now
        # handles commitment reminders, and leaving this one incomplete would be a trap if
        # any future code routes mark-complete through here.
        for item in getattr(self, "commitment_reminders", []) or []:
            if item.get("completed") or item.get("cancelled"):
                continue
            same_entry = entry_id and item.get("entry_id") == entry_id
            same_conversation = conversation_id and item.get("conversation_id") == conversation_id
            if same_entry or same_conversation:
                item["cancelled"] = True
                item["cancelled_at"] = now_iso
                item["cancel_reason"] = reason
                cancelled += 1

        # Keep user-created/manual follow-ups visible. Only clear the display if
        # there is no active manual follow-up still scheduled for this email.
        if entry_id and not self.get_active_followup_for_email(entry_id):
            email["followup_time"] = ""

        return cancelled

    def selected_workflow_values_differ(self, selected_emails, category, urgency, status, email_type):
        """True when the edit controls differ from the selected row data.

        This is used before Refresh and by dropdown auto-save so a user's manual
        urgency/status/category choice cannot be lost by re-rendering older saved
        data from Outlook/cache.
        """
        try:
            for email in selected_emails or []:
                if category and category != email.get("category", ""):
                    return True
                if urgency and urgency != email.get("urgency", ""):
                    return True
                if status and status != email.get("status", ""):
                    return True
                if email_type != normalize_email_type_code(email.get("email_type", "")):
                    return True
            return False
        except Exception:
            return False

    def auto_save_selected_workflow_change(self, event=None):
        """Immediately persist dropdown workflow edits made by the user.

        Previously the combobox could show a new urgency while the durable record
        still held the old urgency until Apply/Save was clicked. A subsequent
        Refresh then reloaded the old durable value, making it look like the
        manual urgency change was ignored.
        """
        if getattr(self, "_loading_selected_workflow_fields", False):
            return
        if getattr(self, "_auto_saving_workflow_fields", False):
            return
        try:
            selected = self.get_selected_emails(show_warning=False)
            if not selected:
                return
            new_category = self.category_var.get()
            new_urgency = self.urgency_var.get()
            new_status = self.status_var.get()
            new_email_type = normalize_email_type_code(getattr(self, "email_type_var", tk.StringVar()).get())
            if not self.selected_workflow_values_differ(selected, new_category, new_urgency, new_status, new_email_type):
                return
            self._auto_saving_workflow_fields = True
            self.save_selected_changes(autosave=True)
        finally:
            self._auto_saving_workflow_fields = False

    def save_pending_selected_workflow_edits_before_refresh(self):
        """Commit unsaved visible workflow edits before importing/re-rendering refresh data."""
        try:
            if getattr(self, "_loading_selected_workflow_fields", False):
                return False
            selected = self.get_selected_emails(show_warning=False)
            if not selected:
                return False
            new_category = self.category_var.get()
            new_urgency = self.urgency_var.get()
            new_status = self.status_var.get()
            new_email_type = normalize_email_type_code(getattr(self, "email_type_var", tk.StringVar()).get())
            if not self.selected_workflow_values_differ(selected, new_category, new_urgency, new_status, new_email_type):
                return False
            return bool(self.save_selected_changes(autosave=True))
        except Exception:
            return False

    def save_selected_changes(self, autosave=False):
        selected_emails = self.get_selected_emails(show_warning=not autosave)
        if not selected_emails:
            return False
        new_category = self.category_var.get()
        new_urgency = self.urgency_var.get()
        new_status = self.status_var.get()
        new_email_type = normalize_email_type_code(getattr(self, "email_type_var", tk.StringVar()).get())
        if autosave and not self.selected_workflow_values_differ(selected_emails, new_category, new_urgency, new_status, new_email_type):
            return False
        self.save_undo_state("save selected email changes")
        vendor_reminders_scheduled = 0
        followups_cancelled = 0
        marking_done = (
            new_status == "Completed"
            or new_urgency == "Low"
            or new_category == "Junk / Ignore"
        )
        tracking_keys_to_cancel = set()
        kept_tracking_entry_ids = set()
        if marking_done:
            # If this email has any active follow-up/tracking items, let the user
            # choose exactly what to clear. Auto items are selected by default;
            # manual follow-ups are shown but preserved unless selected.
            tracking_rows_before_review = self.collect_active_tracking_items_for_emails(selected_emails)
            tracking_keys_to_cancel = self.review_tracking_items_before_complete(selected_emails)
            if tracking_keys_to_cancel is None:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, "Mark Complete skipped. No email status or follow-ups were changed.")
                return
            for row in tracking_rows_before_review:
                if row.get("key") in tracking_keys_to_cancel:
                    continue
                tracked_email = row.get("email") or {}
                tracked_entry_id = tracked_email.get("entry_id", "")
                if tracked_entry_id:
                    kept_tracking_entry_ids.add(tracked_entry_id)
        _guard_changed = False
        with self._bulk_write():
            for email in selected_emails:
                original_urgency = email.get("urgency", "Normal")
                entry_id = email.get("entry_id", "")
                _was_closed = self.workflow_record_is_closed(email) or self.workflow_record_is_closed(self.status_data.get(entry_id, {})) or bool(self._find_closed_email_guard(email, self.status_data.get(entry_id, {})))
                email["category"] = new_category
                # If the user marks an email Completed but chooses to keep any active
                # follow-up/tracking item, preserve the current urgency so it does not
                # get pushed into Low/hidden just because completion was applied.
                if new_status == "Completed" and entry_id in kept_tracking_entry_ids:
                    email["urgency"] = original_urgency
                else:
                    email["urgency"] = new_urgency
                email["status"] = new_status
                if new_email_type or hasattr(self, "email_type_var"):
                    email["email_type"] = new_email_type
                email["is_new_import"] = False
                # v3.9.46: a manual workflow edit is the user's explicit decision. Mark the email
                # AI-settled and user-locked so the background drip / 12h re-triage can never
                # overwrite it, and so it survives a refresh (which rebuilds rows from status_data).
                email["ai_triaged_at"] = email.get("ai_triaged_at") or datetime.now().isoformat()
                email["ai_triage_pending"] = False
                email["ai_user_locked"] = True
                if _was_closed and not marking_done:
                    email["explicit_reopened_at"] = datetime.now().isoformat()
                    email["workflow_closed_at"] = ""
                    if self.clear_closed_email_guard(email, save=False):
                        _guard_changed = True
                self.save_record(email)
                self.learn_from_user_correction(email, new_category, new_urgency, new_status)
                if new_status == "Waiting on Vendor":
                    if self.schedule_vendor_no_response_reminder(email):
                        vendor_reminders_scheduled += 1
                # Marking an email Completed/Low/Junk now opens a review popup when
                # related tracking exists. Only the rows selected in that popup are cleared.
            if marking_done and tracking_keys_to_cancel:
                cancel_reason = f"Cancelled from completion review: email marked {new_status or new_category}"
                followups_cancelled += self.cancel_selected_tracking_items(tracking_keys_to_cancel, cancel_reason)
                for email in selected_emails:
                    eid = email.get("entry_id", "")
                    if eid and not self.get_active_followup_for_email(eid):
                        email["followup_time"] = ""
            if _guard_changed:
                self._save_closed_email_guard()
        self.flush_status_data()
        self.sort_emails_for_display()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        self.save_cached_state()
        self.preview_text.delete("1.0", tk.END)
        extra = f"\n\nVendor no-response reminder scheduled for {vendor_reminders_scheduled} email(s)." if vendor_reminders_scheduled else ""
        cancelled_note = f"\nCancelled {followups_cancelled} active follow-up(s)." if followups_cancelled else ""
        self.preview_text.insert(tk.END, f"Saved changes to {len(selected_emails)} selected email(s).{extra}{cancelled_note}")
        # v4.1.55: first-time offer -- remember this manually chosen type for the sender(s).
        try:
            if new_email_type:
                self._offer_save_contact_type(selected_emails, new_email_type)
        except Exception:
            pass
        return True

    def get_sender_email(self, msg):
        try:
            sender = msg.SenderEmailAddress or ""
            if sender:
                return sender
        except Exception:
            pass
        try:
            sender = msg.Sender.GetExchangeUser().PrimarySmtpAddress
            if sender:
                return sender
        except Exception:
            pass
        return ""

    def generate_reply_text(self, email, prefer_ai=True):
        fallback = get_followup_message(email.get("category", "General"))
        if not prefer_ai:
            return fallback
        body = self.load_body_if_needed(email)
        ai_result = ask_ollama_for_reply(
            subject=email.get("subject", ""), sender=email.get("sender", ""), body=body,
            category=email.get("category", "General"), urgency=email.get("urgency", "Normal"),
            status=email.get("status", "New")
        )
        if ai_result:
            text = ai_result.get("text") if isinstance(ai_result, dict) else ai_result
            total_ns = ai_result.get("total_duration") if isinstance(ai_result, dict) else None
            load_ns = ai_result.get("load_duration") if isinstance(ai_result, dict) else None
            if total_ns:
                total_s = total_ns / 1_000_000_000
                load_s = (load_ns or 0) / 1_000_000_000
                self.ai_status_var.set(f"AI: Ollama {total_s:.1f}s / load {load_s:.1f}s")
            else:
                self.ai_status_var.set("AI: used Ollama")
            return text
        self.ai_status_var.set("AI: template fallback")
        return fallback

    def force_mainbox_window_to_front(self, window=None, restore_root=True):
        """v3.9.60: reliably restore + foreground a MaINbox window (the main window or one of
        its popups), even when MaINbox is MINIMIZED.

        Tk's lift()/focus_force() alone do not reliably pull a minimized window back under
        Windows' foreground-lock rules -- which is why a reminder popup that appeared while
        MaINbox was minimized could only be recovered via Task Manager -> "Bring to front",
        not by clicking the taskbar button. This mirrors the Win32 AttachThreadInput +
        SetForegroundWindow technique already used for the Outlook inspector in
        bring_outlook_inspector_to_front(). Reminder/alert popups are transient(self.root), so
        if the main window is iconified the popup is hidden too; we restore the main window
        first, then foreground the popup. Everything is best-effort and guarded, so it is a
        no-op (falling back to lift/focus) if win32 is unavailable."""
        target = window or self.root

        def _tk_restore(w):
            # Map an iconified window back so it (and its transient children) can be shown.
            try:
                if w is self.root or str(w.wm_state()) == "iconic":
                    w.deiconify()
            except Exception:
                pass
            try:
                w.state("normal")
            except Exception:
                pass
            try:
                w.lift()
            except Exception:
                pass

        if restore_root:
            _tk_restore(self.root)
        _tk_restore(target)
        try:
            target.update_idletasks()
        except Exception:
            pass

        def _hwnd_for(w):
            if not win32gui:
                return None
            hwnd = None
            try:
                child = w.winfo_id()
                try:
                    parent = win32gui.GetParent(child)
                except Exception:
                    parent = None
                hwnd = parent or child
            except Exception:
                hwnd = None
            if not hwnd:
                try:
                    hwnd = win32gui.FindWindow(None, w.title())
                except Exception:
                    hwnd = None
            return hwnd

        def _force_front(hwnd):
            if not hwnd or not win32gui or not win32con:
                return False
            try:
                if ctypes:
                    try:
                        ctypes.windll.user32.AllowSetForegroundWindow(-1)
                    except Exception:
                        pass
                try:
                    win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
                except Exception:
                    try:
                        win32gui.ShowWindow(hwnd, win32con.SW_SHOWNORMAL)
                    except Exception:
                        pass

                # Temporarily attach input threads -- the standard workaround for Windows'
                # focus-stealing prevention so SetForegroundWindow actually takes effect.
                attached = False
                fg_thread = target_thread = current_thread = None
                if win32process and ctypes:
                    try:
                        fg_hwnd = win32gui.GetForegroundWindow()
                        fg_thread, _ = win32process.GetWindowThreadProcessId(fg_hwnd)
                        target_thread, _ = win32process.GetWindowThreadProcessId(hwnd)
                        current_thread = ctypes.windll.kernel32.GetCurrentThreadId()
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, True)
                                attached = True
                    except Exception:
                        attached = False

                try:
                    win32gui.BringWindowToTop(hwnd)
                except Exception:
                    pass
                try:
                    win32gui.SetWindowPos(hwnd, win32con.HWND_TOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                    win32gui.SetWindowPos(hwnd, win32con.HWND_NOTOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                except Exception:
                    pass
                ok = False
                try:
                    ok = bool(win32gui.SetForegroundWindow(hwnd))
                except Exception:
                    ok = False
                try:
                    win32gui.SetFocus(hwnd)
                except Exception:
                    pass

                if attached and win32process and ctypes:
                    try:
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, False)
                    except Exception:
                        pass
                return ok
            except Exception:
                return False

        # Restore the main window (its taskbar button) first, then the popup itself.
        if restore_root and target is not self.root:
            _force_front(_hwnd_for(self.root))
        _force_front(_hwnd_for(target))

        # Final Tk nudge so focus visibly lands on the popup.
        try:
            target.lift()
            target.focus_force()
        except Exception:
            pass

    def bring_outlook_inspector_to_front(self, item, attempts=10, delay_ms=160):
        """Try Outlook Activate plus Win32 foreground handling. Windows may still block true focus, so we also raise/topmost-nudge."""
        def get_inspector_and_hwnd():
            inspector = None
            hwnd = None
            try:
                inspector = item.GetInspector
            except Exception:
                inspector = None
            try:
                active = self.outlook.ActiveInspector() if self.outlook else None
                if active:
                    inspector = active
            except Exception:
                pass
            if inspector:
                try:
                    inspector.Activate()
                except Exception:
                    pass
                try:
                    hwnd = int(inspector.HWND)
                except Exception:
                    hwnd = None
            return inspector, hwnd

        def force_hwnd_front(hwnd):
            if not hwnd or not win32gui or not win32con:
                return False
            try:
                if ctypes:
                    try:
                        ctypes.windll.user32.AllowSetForegroundWindow(-1)
                    except Exception:
                        pass
                try:
                    win32gui.ShowWindow(hwnd, win32con.SW_SHOWNORMAL)
                except Exception:
                    win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)

                # Temporarily attach input threads. This is the common workaround for Windows focus rules.
                attached = False
                fg_thread = target_thread = current_thread = None
                if win32process and ctypes:
                    try:
                        fg_hwnd = win32gui.GetForegroundWindow()
                        fg_thread, _ = win32process.GetWindowThreadProcessId(fg_hwnd)
                        target_thread, _ = win32process.GetWindowThreadProcessId(hwnd)
                        current_thread = ctypes.windll.kernel32.GetCurrentThreadId()
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, True)
                                attached = True
                    except Exception:
                        attached = False

                try:
                    win32gui.BringWindowToTop(hwnd)
                except Exception:
                    pass
                try:
                    win32gui.SetWindowPos(hwnd, win32con.HWND_TOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                    win32gui.SetWindowPos(hwnd, win32con.HWND_NOTOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                except Exception:
                    pass
                ok = False
                try:
                    ok = bool(win32gui.SetForegroundWindow(hwnd))
                except Exception:
                    ok = False
                try:
                    win32gui.SetFocus(hwnd)
                except Exception:
                    pass

                if attached and win32process and ctypes:
                    try:
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, False)
                    except Exception:
                        pass
                return ok
            except Exception:
                return False

        def attempt(remaining):
            try:
                try:
                    self.root.attributes("-topmost", False)
                    self.root.lower()
                except Exception:
                    pass
                inspector, hwnd = get_inspector_and_hwnd()
                if hwnd:
                    force_hwnd_front(hwnd)
            except Exception:
                pass
            if remaining > 0:
                try:
                    self.root.after(delay_ms, lambda: attempt(remaining - 1))
                except Exception:
                    pass

        attempt(attempts)

    def display_outlook_item_foreground(self, item):
        """Display an Outlook item and strongly nudge its inspector window to the front."""
        try:
            # Make sure the monitor itself is not marked topmost over Outlook.
            try:
                self.root.attributes("-topmost", False)
            except Exception:
                pass
            item.Display()
        except Exception:
            return
        self.bring_outlook_inspector_to_front(item)

    def _regroup_existing_sent_rfq_trackers(self):
        """v3.9.97: one-time backfill. Run the (now deterministic) tracker->group resolver over
        sent-waiting trackers that are STILL ungrouped, so vendor RFQs you sent before this
        version -- the loose 'P&A -' rows -- file under their group on first launch instead of
        only newly-sent ones. Flag-gated so it runs once; additive (the resolver never moves an
        already-grouped row and only groups on a confident recipient/subject match against a
        real persisted group), so it cannot scatter rows you've filed by hand."""
        try:
            if not isinstance(getattr(self, "groups_data", None), dict):
                return
            if self.groups_data.get("rfq_tracker_regroup_done"):
                return
            memberships = self.groups_data.get("memberships", {}) or {}
            for ph in list(getattr(self, "sent_waiting_placeholders", []) or []):
                if not isinstance(ph, dict):
                    continue
                pid = ph.get("entry_id", "")
                if not pid or ph.get("cleared") or memberships.get(pid):
                    continue
                try:
                    self._link_sent_tracker_to_request_group(ph)
                except Exception:
                    pass
            self.groups_data["rfq_tracker_regroup_done"] = True
            self.save_groups()
        except Exception:
            pass

    def _group_id_from_sent_rfq_record(self, placeholder):
        """v3.9.97: file a sent vendor-RFQ tracker under the group it was sent FOR, using the
        record Quote RFQ writes at send time. When you 'Send RFQs Now', the send is appended to
        quote_requests carrying the group_id, the subject, and the vendor recipients -- so this
        matches the tracker to that send by recipient + subject and returns the group_id. That
        makes the 'P&A -' vendor RFQs group by construction (no fragile subject-token guessing),
        and because the tracker then shares the vendor reply's Outlook conversation, the v3.9.96
        group-ledger flip routes that vendor's quote to the right ledger automatically.

        Deterministic and conservative: requires a real (persisted) group AND a positive signal
        -- the recipient is one of that send's vendors, or the subject matches distinctively.
        Returns '' (leave it for the existing resolvers / manual filing) when nothing lines up.
        Most-recent send wins so a re-send to a new job takes precedence."""
        try:
            if not isinstance(placeholder, dict):
                return ""
            recip = str(placeholder.get("sender_email", "") or placeholder.get("sender", "") or "").lower().strip()
            psubj = normalize_subject_for_match(placeholder.get("subject", "") or "")
            if not recip and not psubj:
                return ""
            real_ids = {g.get("id") for g in (self.groups_data.get("groups", []) or [])
                        if isinstance(g, dict) and g.get("id")}
            for qrec in reversed(self.quote_requests or []):   # most-recent send first
                if not isinstance(qrec, dict):
                    continue
                gid = str(qrec.get("group_id", "") or "")
                if not gid or gid not in real_ids:
                    continue
                qsubj = normalize_subject_for_match(qrec.get("subject", "") or "")
                vendor_emails = {str((v or {}).get("email", "") or "").lower().strip()
                                 for v in (qrec.get("vendors", []) or []) if isinstance(v, dict)}
                vendor_emails.discard("")
                subj_ok = (not psubj) or (not qsubj) or (psubj == qsubj)
                recip_in = bool(recip and vendor_emails and recip in vendor_emails)
                subj_strong = bool(psubj and qsubj and psubj == qsubj and len(psubj) >= 8)
                if subj_ok and (recip_in or subj_strong):
                    return gid
            return ""
        except Exception:
            return ""

    def _link_sent_tracker_to_request_group(self, placeholder):
        """v3.9.89: keep a sent/waiting tracker in the same group as the request it came from, so the
        original customer request, the tracker, and (later) the vendor reply all stay together.

        Strictly additive and non-destructive: it only sets a group membership when one is missing,
        never moves an already-grouped item (including a manual choice), and leaves the tracker
        ungrouped for the user to file by hand when nothing matches confidently.

        Resolution order:
          1. the email this tracker was sent in reply to (tracked_entry_id) -- its group/thread/job key
          2. the tracker's own Outlook thread already filed in a group
          3. a confident job/PO/project key match (find_group_id_by_business_key) -- the
             'customer name + job name/#' path for sends made directly from Outlook
        If a concrete originating request EMAIL is found but neither it nor the tracker is grouped
        yet, create one group named from the request subject and put both in it.
        """
        try:
            if not isinstance(placeholder, dict):
                return
            pid = placeholder.get("entry_id", "")
            if not pid:
                return
            memberships = self.groups_data.setdefault("memberships", {})
            existing_gid = memberships.get(pid, "")
            if existing_gid and self.get_group_by_id(existing_gid):
                return  # already grouped -- never override

            target_gid = ""
            request_email = None

            # 1) MaINbox path: the email this tracker was sent in reply to.
            tracked_id = placeholder.get("tracked_entry_id", "")
            if tracked_id:
                request_email = self.get_email_by_id(tracked_id)
                target_gid = memberships.get(tracked_id, "")
                if not target_gid and request_email:
                    target_gid = (self.find_group_id_for_thread(request_email, skip_entry_id=pid)
                                  or self.find_group_id_by_business_key(request_email))

            # 1b) v3.9.97: the RFQ you actually sent. Quote RFQ records each send in
            #     quote_requests with its group_id + subject + vendor recipients, so a sent
            #     vendor-RFQ tracker (no tracked_entry_id back to the customer request, and a
            #     "P&A -" subject the token matcher won't catch) files under its group directly.
            if not target_gid:
                target_gid = self._group_id_from_sent_rfq_record(placeholder)

            # 2) The tracker's own Outlook thread already filed in a group.
            if not target_gid:
                target_gid = self.find_group_id_for_thread(placeholder, skip_entry_id=pid)

            # 3) Outlook path: a confident job/PO/# key match to an existing group.
            if not target_gid:
                target_gid = self.find_group_id_by_business_key(placeholder)

            # 3b) Outlook path with no existing group yet: locate the originating request email
            #     by shared job key so we can pair them into a fresh group below.
            if not target_gid and request_email is None:
                request_email = self._find_request_email_for_tracker(placeholder)

            # Join an existing group when we found one.
            if target_gid and self.get_group_by_id(target_gid):
                memberships[pid] = target_gid
                self.save_groups()
                return

            # No existing group, but we have a concrete originating request -> create one for the pair.
            if request_email and request_email.get("entry_id"):
                req_id = request_email.get("entry_id", "")
                req_gid = memberships.get(req_id, "")
                if req_gid and self.get_group_by_id(req_gid):
                    memberships[pid] = req_gid
                    self.save_groups()
                    return
                name = (str(request_email.get("subject", "") or "")
                        or str(placeholder.get("subject", "") or "") or "Quote Job").strip()[:80]
                new_gid = self._unique_group_id()  # v4.1.10: collision-proof
                self.groups_data.setdefault("groups", []).append({
                    "id": new_gid, "name": name, "urgency": "Normal", "collapsed": False,
                    "has_new": False, "created_at": datetime.now().isoformat(), "notes": "",
                    "archived": False, "auto_created_reason": "sent_tracker_request_pairing"})
                memberships[req_id] = new_gid
                memberships[pid] = new_gid
                self.save_groups()
        except Exception:
            pass

    # ============ v4.1.38 PO-AWARD DETECTION ============
    def _po_award_enabled(self):
        """True when PO-award detection should run: the engine is available and both
        gates are on. Fail-safe -- a missing engine simply disables the feature."""
        try:
            if not (PO_MATCH_ENGINE_AVAILABLE and _PO_MATCH_ENGINE is not None):
                return False
            if not bool(self.settings.get("po_match_engine_enabled", True)):
                return False
            if not bool(self.settings.get("auto_po_award_detection", True)):
                return False
            return True
        except Exception:
            return False

    def _build_open_jobs_for_po_match(self):
        """Assemble the list of ACTIVE, unresolved Quote Coverage jobs as OpenJob
        records the PO engine can score against. v4.1.39: excludes jobs that are
        already awarded, archived, or dismissed (they should not win a new PO or dilute
        the correct match), and STRUCTURALLY populates each job's quote/job/PO numbers
        (extracted from the group name, subject, original-request subject, and RFQ
        cache text) so the engine's strongest signal -- the seller quote number --
        matches reliably even when it is not sitting in a loose text field.

        Pure read of in-memory state; safe on the worker thread."""
        jobs = []
        try:
            threads = (getattr(self, "quote_coverage", {}) or {}).get("threads", {}) or {}
            groups_by_id = {}
            for g in (self.groups_data.get("groups", []) or []):
                if isinstance(g, dict) and g.get("id"):
                    groups_by_id[str(g["id"])] = g
            rfq_records = (getattr(self, "rfq_cache", {}) or {}).get("records", {}) or {}
            for tkey, rec in threads.items():
                if not isinstance(rec, dict):
                    continue
                # v4.1.39a: LIFECYCLE-AWARE candidacy. Excluding every job that has
                # any PO breaks change orders / partial releases / revised POs, which
                # legitimately arrive after the first PO. So:
                #   - dismissed  -> excluded (user rejected the job)
                #   - archived and never awarded -> excluded from the general pool
                #     (only reachable by an explicit quote/PO-number reference)
                #   - awarded / po_received -> KEPT as a candidate so a later PO can
                #     match, flagged prior_po so the engine applies a mild penalty and
                #     never treats it as a fresh fully-open job.
                if rec.get("dismissed"):
                    continue
                requested = rec.get("requested", []) or []
                if not requested:
                    continue  # nothing outstanding to award against
                gid = str(rec.get("group_id", "") or "")
                if not gid and str(tkey).startswith("grp:"):
                    gid = str(tkey)[4:]
                grp = groups_by_id.get(gid, {})
                _already_po = bool(rec.get("po_received") or rec.get("awarded"))
                if grp and grp.get("archived") and not _already_po:
                    continue
                # Free-text the job is known by (group name + subjects + RFQ text).
                _rfq_text = ""
                try:
                    if gid:
                        _rfq_rec = rfq_records.get("grp:" + gid, {}) or rfq_records.get(gid, {})
                        if isinstance(_rfq_rec, dict):
                            # v4.1.39a: read the fields record_rfq_cache actually stores
                            # (subject/body/quote_text) -- the prior code read
                            # quote_number/body_preview, which are never written.
                            _rfq_text = " ".join(str(_rfq_rec.get(k, "") or "")
                                                 for k in ("subject", "quote_text", "body"))[:4000]
                except Exception:
                    _rfq_text = ""
                text_parts = [
                    str(rec.get("subject", "") or ""),
                    str(grp.get("name", "") or ""),
                    str(rec.get("original_request_subject", "") or ""),
                    _rfq_text,
                ]
                job_text = "\n".join(t for t in text_parts if t)
                # Structured identifiers: any explicitly stored on the record, plus
                # everything extractable from the job's known text.
                q_nums = list(rec.get("customer_quote_numbers", []) or [])
                p_nums = list(rec.get("po_numbers", []) or [])
                j_nums = list(rec.get("job_numbers", []) or [])
                try:
                    q_nums += extract_quote_numbers(job_text)
                    p_nums += extract_po_numbers(job_text)
                    j_nums += extract_job_numbers(job_text)
                except Exception:
                    pass
                # Requested item parts/descriptions.
                parts = []
                descs = []
                for it in requested:
                    if not isinstance(it, dict):
                        continue
                    pn = str(it.get("part_number", "") or "").strip()
                    if pn:
                        parts.append(pn)
                    dd = str(it.get("description", "") or "").strip()
                    if dd:
                        descs.append(dd)
                label = str(rec.get("subject", "") or grp.get("name", "") or gid or tkey)[:90]
                jobs.append(OpenJob(
                    job_id=str(tkey),
                    label=label,
                    text=job_text,
                    customer_email=str(rec.get("customer_email", "") or ""),
                    quote_numbers=tuple(dict.fromkeys(q_nums)),
                    po_numbers=tuple(dict.fromkeys(p_nums)),
                    job_numbers=tuple(dict.fromkeys(j_nums)),
                    requested_parts=tuple(parts),
                    requested_descriptions=tuple(descs),
                    prior_po=_already_po,
                ))
        except Exception:
            return []
        return jobs

    def _detect_and_queue_customer_po(self, msg, entry_id, store_id, subject, body,
                                      fresh_text, sender_email, sender_name,
                                      durable_type, namespace, imid_key=""):
        """Worker-thread PO detection for ONE attachment-bearing customer/unknown
        message. Reads the attachment text, asks the PO-match engine to classify +
        match it to an open job, and records the result DURABLY so a confident match
        pops up and an ambiguous/unmatched PO still surfaces for review. Returns True
        when this message is a recognized PURCHASE ORDER so the caller stops treating
        it as a possible request.

        v4.1.39: the previous version queued only MATCH (in an in-memory list) and
        returned True for REVIEW too -- so a recognized-but-unmatched PO was
        checkpointed and lost. Now every recognized PO (MATCH, REVIEW, or unmatched)
        is written to a PERSISTED review queue keyed by durable source identity
        BEFORE the caller checkpoints the message. A crash/restart cannot lose it,
        and a second distinct PO for the same job is kept (dedupe is by source, not
        by job)."""
        try:
            # Read the attachment text once (best-effort; a failed read yields "").
            _att_read_failed = False
            try:
                _att_text = self._attachment_quote_text_from_msg(msg)
                if not isinstance(_att_text, str):
                    _att_text = str(_att_text[0]) if isinstance(_att_text, (list, tuple)) and _att_text else ""
            except Exception:
                _att_text = ""
                _att_read_failed = True
            # v4.1.39a: a message whose BODY explicitly says a PO is attached but whose
            # attachment produced no text is an UNREADABLE PO candidate, not a decided
            # non-PO. Signal a retry so the caller does NOT permanently checkpoint it;
            # a transient extraction/OCR failure must not lose a real PO.
            _body_low = f"{subject}\n{fresh_text}".lower()
            _po_attached_claim = bool(re.search(
                r"\b(?:po|p\.?o\.?|purchase\s+order)\s+(?:is\s+)?attach|attached\s+(?:is\s+)?(?:the\s+)?(?:po|p\.?o\.?|purchase\s+order)\b",
                _body_low))
            _has_attach = False
            try:
                _has_attach = bool(getattr(msg, "Attachments", None)) and msg.Attachments.Count > 0
            except Exception:
                _has_attach = False
            if not _att_text and _po_attached_claim and _has_attach:
                # Bound retries so a permanently-unreadable attachment is not re-tried
                # every scan forever. After a few attempts, fall through and let the
                # caller checkpoint it (an operator can open it manually).
                try:
                    retries = self.quote_coverage.setdefault("po_attach_retry", {})
                    if isinstance(retries, dict):
                        _rk = imid_key or ("eid:" + str(entry_id))
                        n = int(retries.get(_rk, 0)) + 1
                        retries[_rk] = n
                        if n <= 5:
                            _cov_debug(f"PO attachment unreadable, retry {n}/5: {subject!r}")
                            return "retry"
                        _cov_debug(f"PO attachment unreadable after {n} tries, giving up: {subject!r}")
                except Exception:
                    return "retry"
            elif _att_text:
                # v4.1.41: the attachment read succeeded -- drop any retry counter so
                # the bookkeeping dict does not grow forever.
                try:
                    retries = self.quote_coverage.get("po_attach_retry")
                    if isinstance(retries, dict):
                        retries.pop(imid_key or ("eid:" + str(entry_id)), None)
                except Exception:
                    pass
            # Cheap pre-gate: no attachment text AND no PO cue in the body -> not a PO,
            # skip the engine entirely (keeps the scan cheap on ordinary mail).
            if not _att_text and not re.search(
                    r"\bpurchase\s+order\b|\bp\.?\s*o\.?\s*(?:#|no\.?|number|attached)\b|\bhere\s+(?:is|are)\s+the\s+po\b",
                    _body_low):
                return False

            try:
                _own = self._own_mailbox_domains(namespace)
            except Exception:
                _own = set()
            # v4.1.39: pass STRUCTURED PO line items when we can parse them, so the
            # engine matches on real parts/descriptions rather than a raw token scan.
            _parts, _descs = self._po_structured_lines_from_text(_att_text)
            ctx = POContext(
                subject=str(subject or ""),
                body=str(fresh_text or body or ""),
                attachment_text=str(_att_text or ""),
                sender_email=str(sender_email or ""),
                sender_name=str(sender_name or ""),
                sender_type=str(durable_type or ""),
                internal_domains=tuple(_own) if _own else (),
                has_attachments=True,
                line_parts=tuple(_parts),
                line_descriptions=tuple(_descs),
            )
            open_jobs = self._build_open_jobs_for_po_match()
            verdict = _PO_MATCH_ENGINE.evaluate(ctx, open_jobs)
            if not getattr(verdict, "is_po", False):
                return False  # not a purchase order -- let the request gate proceed

            _dec = getattr(verdict, "decision", None)
            _dec_val = _dec.value if hasattr(_dec, "value") else str(_dec or "")
            _imid = imid_key.replace("imid:", "", 1) if imid_key else ""
            # Persist EVERY recognized PO to the durable review queue (deduped by
            # source identity). This must happen before the caller marks the message
            # processed, so nothing is ever silently consumed.
            _persisted = self._persist_po_review_entry(
                decision=_dec_val,
                job_id=str(getattr(verdict, "job_id", "") or ""),
                job_label=str(getattr(verdict, "job_label", "") or ""),
                entry_id=entry_id, store_id=store_id, imid=_imid,
                subject=str(subject or ""), sender=sender_name or sender_email,
                sender_email=str(sender_email or ""),
                confidence=float(getattr(verdict, "confidence", 0.0) or 0.0),
                reasons=list(getattr(verdict, "reasons", []) or []),
                po_numbers=list(getattr(verdict, "po_numbers", []) or []),
                quote_numbers=list(getattr(verdict, "quote_numbers", []) or []),
                customer_conflict=bool(getattr(verdict, "customer_conflict", False)),
                runner_up_label=str(getattr(verdict, "runner_up_label", "") or ""),
                po_lines={"parts": list(_parts), "descriptions": list(_descs),
                          "details": list(getattr(self, "_last_po_line_details", []) or [])},
            )
            if _persisted is False:
                # v4.1.42: the durable write failed -- do NOT let the caller
                # checkpoint this message. Signal retry; the next scan re-detects
                # and the src_id dedupe makes eventual success idempotent.
                _cov_debug(f"PO review persistence failed, will retry: {subject!r}")
                return "retry"
            # A confident, non-conflicting MATCH also goes into the immediate popup
            # queue so the user is prompted this session.
            if _dec_val == "match" and getattr(verdict, "job_id", "") \
                    and not getattr(verdict, "customer_conflict", False):
                self._queue_po_award_prompt_from_review(entry_id=entry_id, imid=_imid)
            else:
                _cov_debug(f"PO recognized ({_dec_val}, conflict={getattr(verdict,'customer_conflict',False)}): {subject!r} -> review queue")
            return True
        except Exception as _exc:
            _cov_debug(f"PO detect/queue error: {_exc!r}")
            return False

    def _po_structured_lines_from_text(self, att_text):
        """v4.1.39: best-effort structured line items from PO attachment text, using
        the existing material extractor. Returns (parts, descriptions). v4.1.39a also
        captures per-line quantity/unit into self._last_po_line_details so an award
        can record what was actually ordered (the data the future line-level partial-
        award UI needs). Returns ([],[]) on any failure -- the engine then falls back
        to its own token scan."""
        parts, descs = [], []
        self._last_po_line_details = []
        if not att_text:
            return parts, descs
        try:
            mats = extract_materials_from_quote_text(
                _coverage_reassemble_columnar_quote(att_text), keep_duplicates=True) or []
            for m in mats:
                if not isinstance(m, dict):
                    continue
                pn = str(m.get("part_number", "") or "").strip()
                dd = str(m.get("description", "") or "").strip()
                if pn:
                    parts.append(pn)
                if dd:
                    descs.append(dd)
                # Preserve quantity/unit for the award record (partial-PO groundwork).
                self._last_po_line_details.append({
                    "part_number": pn,
                    "description": dd,
                    "qty": str(m.get("qty", "") or m.get("quantity", "") or "").strip(),
                    "unit": str(m.get("unit", "") or m.get("uom", "") or "").strip(),
                })
        except Exception:
            self._last_po_line_details = []
            return [], []
        return parts, descs

    def _persist_po_review_entry(self, decision, job_id, job_label, entry_id, store_id,
                                 imid, subject, sender, sender_email, confidence, reasons,
                                 po_numbers, quote_numbers, customer_conflict,
                                 runner_up_label, po_lines):
        """v4.1.39: write ONE recognized PO into the DURABLE review queue at
        quote_coverage['po_review_pending']. Deduped by SOURCE identity (Message-ID,
        else EntryID, else PO#+sender fingerprint) so a second distinct PO for the
        same job is kept, but the same message is never duplicated. Persisted to the
        coverage store so a crash/restart cannot lose it. Skips anything already in
        the handled ledger."""
        try:
            if not isinstance(getattr(self, "quote_coverage", None), dict):
                return
            src_id = ("mid:" + imid.strip().lower()) if imid else (
                ("eid:" + str(entry_id)) if entry_id else "")
            if not src_id and po_numbers:
                src_id = "po:" + "|".join(sorted(po_numbers)) + ":" + str(sender_email or "").lower()
            if not src_id:
                return False
            # Already handled? Do not re-open (counts as persisted: True).
            handled = self.quote_coverage.get("po_awards_handled", []) or []
            if isinstance(handled, list):
                for h in handled:
                    if isinstance(h, dict) and h.get("src_id") == src_id:
                        return True
            pending = self.quote_coverage.setdefault("po_review_pending", [])
            if not isinstance(pending, list):
                pending = self.quote_coverage["po_review_pending"] = []
            for p in pending:
                if isinstance(p, dict) and p.get("src_id") == src_id:
                    return True  # same message already durably queued
            # v4.1.43 (external audit of v4.1.42, CRITICAL finding): the v4.1.42 body
            # wrapped save_quote_coverage() in try/except, but that method swallowed
            # its own exceptions and returned None -- so this method returned True on
            # a failed disk write and the caller checkpointed a PO whose review entry
            # was never stored. save_quote_coverage() now returns a real result, and
            # a failed save REMOVES the just-appended in-memory entry: otherwise the
            # next retry would see the in-memory duplicate at the src_id dedupe above
            # and return True, assuming it was already persisted (retry poisoning).
            _new_entry = {
                "src_id": src_id,
                "decision": decision,
                "job_id": job_id, "job_label": job_label,
                "entry_id": entry_id, "store_id": store_id, "imid": imid,
                "subject": subject, "sender": sender, "sender_email": sender_email,
                "confidence": confidence, "reasons": reasons,
                "po_numbers": po_numbers, "quote_numbers": quote_numbers,
                "customer_conflict": customer_conflict,
                "runner_up_label": runner_up_label,
                "po_lines": po_lines,
                "created_at": datetime.now().isoformat(),
            }
            with self._coverage_save_lock():
                # v4.1.44 (audit #5): restore the WHOLE list on failure, not just the
                # new entry. At the 500-entry cap the prune ran before the save, so a
                # failed save left memory one OLD entry short; a later successful save
                # of the shortened queue would have permanently dropped it from disk.
                _pending_before = list(pending)
                pending.append(_new_entry)
                if len(pending) > 500:
                    del pending[:len(pending) - 500]
                if not self.save_quote_coverage():
                    pending[:] = _pending_before
                    return False
            # Worker thread: refresh the toolbar count on the main thread (the
            # after()-from-worker pattern is this app's established cross-thread
            # signal; the callback body runs on the Tk main thread).
            try:
                self.root.after(0, self._refresh_po_review_button)
            except Exception:
                pass
            return True
        except Exception:
            return False

    def _queue_po_award_prompt_from_review(self, entry_id="", imid=""):
        """v4.1.39: mark that a confident MATCH in the durable review queue should be
        shown as a popup THIS session. The in-memory list only holds a pointer (the
        source id); the authoritative record is the persisted review entry, so a lost
        popup list never loses the PO."""
        try:
            src_id = ("mid:" + imid.strip().lower()) if imid else (("eid:" + str(entry_id)) if entry_id else "")
            if not src_id:
                return
            q = getattr(self, "_pending_po_award_prompts", None)
            if not isinstance(q, list):
                q = []
                self._pending_po_award_prompts = q
            if src_id not in q:
                q.append(src_id)
        except Exception:
            pass

    def _make_po_review_button(self, parent, grp):
        """Build the 'PO Review (N)' toolbar button and keep a reference so its label
        can reflect the live count of POs awaiting review."""
        try:
            n = self._po_review_pending_count()
        except Exception:
            n = 0
        label = f"PO Review ({n})" if n else "PO Review"
        btn = grp(parent, label, self._open_po_review_window)
        self._po_review_button = btn
        return btn

    def _refresh_po_review_button(self):
        """Update the PO Review button label to the current pending count. Safe to
        call from the main thread after a scan or after the review window closes."""
        try:
            btn = getattr(self, "_po_review_button", None)
            if btn is None:
                return
            n = self._po_review_pending_count()
            btn.config(text=(f"PO Review ({n})" if n else "PO Review"))
        except Exception:
            pass

    def _po_review_pending_count(self):
        """Number of PO review entries awaiting a human decision (all decisions --
        match/review/unmatched/conflict). Drives the 'PO Review (N)' button label."""
        try:
            pending = (getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or []
            return len([p for p in pending if isinstance(p, dict)])
        except Exception:
            return 0

    def _open_po_review_window(self):
        """v4.1.39a: a visible window that DRAINS the durable PO review queue --
        the piece that makes po_review_pending usable. Lists every recognized PO
        (confident match, ambiguous review, customer conflict, and unmatched),
        shows its top candidate job and why, and lets the user act per row:
        Apply to the matched job, Choose another job, Open the source email, or
        Dismiss. Confident non-conflict matches also flow through here so nothing
        is action-only via the transient popup."""
        try:
            pending = list((getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or [])
        except Exception:
            pending = []
        win = tk.Toplevel(self.root)
        win.title(f"PO Review ({len(pending)})")
        win.configure(bg=_BG)
        win.geometry("880x520")
        try:
            win.transient(self.root)
        except Exception:
            pass

        header = tk.Label(win, bg=_BG, fg=_FG, justify="left", anchor="w",
                          text=("Purchase orders detected from incoming mail. Review each and choose an "
                                "action.\nApply records the PO against the job (customer award, kept "
                                "separate from vendor coverage)."))
        header.pack(fill="x", padx=12, pady=(10, 6))

        body = tk.Frame(win, bg=_BG)
        body.pack(fill="both", expand=True, padx=12, pady=(0, 8))

        cols = ("status", "po", "customer", "job", "conf")
        tree = ttk.Treeview(body, columns=cols, show="headings", height=14)
        for c, w, txt in (("status", 90, "Status"), ("po", 130, "PO #"),
                          ("customer", 200, "From"), ("job", 300, "Matched job"),
                          ("conf", 60, "Conf")):
            tree.heading(c, text=txt)
            tree.column(c, width=w, anchor="w")
        vs = ttk.Scrollbar(body, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=vs.set)
        tree.pack(side="left", fill="both", expand=True)
        vs.pack(side="right", fill="y")

        # Map tree row -> src_id.
        row_src = {}

        def _status_label(p):
            if p.get("customer_conflict"):
                return "CONFLICT"
            d = str(p.get("decision", "") or "")
            if d == "match":
                return "Match"
            if d == "review":
                return "Review"
            return "Unmatched"

        def _refresh_tree():
            tree.delete(*tree.get_children())
            row_src.clear()
            cur = list((getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or [])
            for p in cur:
                if not isinstance(p, dict):
                    continue
                _po = ", ".join(p.get("po_numbers", []) or []) or "-"
                _conf = int(round(float(p.get("confidence", 0.0) or 0.0) * 100))
                _job = str(p.get("job_label", "") or p.get("job_id", "") or "(no match)")[:60]
                iid = tree.insert("", "end", values=(
                    _status_label(p), _po[:20],
                    str(p.get("sender", "") or p.get("sender_email", "") or "")[:30],
                    _job, f"{_conf}%"))
                row_src[iid] = p.get("src_id", "")
            win.title(f"PO Review ({len(row_src)})")
            try:
                self._refresh_po_review_button()
            except Exception:
                pass

        _refresh_tree()

        # Detail + actions area.
        detail = tk.Label(win, bg=_BG, fg="#9aa4b2", justify="left", anchor="w", wraplength=840)
        detail.pack(fill="x", padx=12, pady=(0, 4))

        def _selected_entry():
            sel = tree.selection()
            if not sel:
                return None, None
            sid = row_src.get(sel[0], "")
            return sid, self._po_review_entry_by_src(sid)

        def _on_select(_evt=None):
            sid, p = _selected_entry()
            if not isinstance(p, dict):
                detail.config(text="")
                return
            bits = []
            if p.get("customer_conflict"):
                bits.append("\u26a0 Sender company differs from the matched job's customer -- confirm before applying.")
            if p.get("reasons"):
                bits.append("Why: " + "; ".join(p.get("reasons", []) or [])[:300])
            if p.get("runner_up_label"):
                bits.append("Runner-up: " + str(p.get("runner_up_label")))
            detail.config(text="\n".join(bits))
        tree.bind("<<TreeviewSelect>>", _on_select)

        def _apply_selected():
            sid, p = _selected_entry()
            if not isinstance(p, dict):
                return
            job_id = str(p.get("job_id", "") or "")
            if not job_id:
                try:
                    import tkinter.messagebox as _mb
                    _mb.showinfo("No matched job",
                                 "This PO has no matched job. Use 'Choose another job' to pick one.",
                                 parent=win)
                except Exception:
                    pass
                return
            # v4.1.44 (audit #5, URGENT #1): award + audit event + pending removal
            # commit as ONE transaction; a failed save keeps the entry queued and
            # says so, instead of showing success over an unwritten disk.
            ok = bool(self._resolve_po_review_entry(
                p, "applied", job_id, record_award=True,
                handled_extra={"via": "po_review_window"}))
            if not ok:
                try:
                    import tkinter.messagebox as _mb
                    _mb.showerror("PO not recorded",
                                  "The PO could not be recorded durably (the job may have "
                                  "been merged, archived, or removed, or the save failed). "
                                  "The PO is kept in the queue.",
                                  parent=win)
                except Exception:
                    pass
                return
            try:
                self.render_group_rows(); self.render_email_rows()
            except Exception:
                pass
            _refresh_tree(); detail.config(text="")

        def _choose_job():
            sid, p = _selected_entry()
            if not isinstance(p, dict):
                return
            self._po_review_choose_job(p, win, on_done=lambda: (_refresh_tree(), detail.config(text="")))

        def _open_email_selected():
            sid, p = _selected_entry()
            if isinstance(p, dict):
                self._open_po_source_email(p)

        def _dismiss_selected():
            sid, p = _selected_entry()
            if not isinstance(p, dict):
                return
            # v4.1.44 (audit #5): dismissal is also a durable state change --
            # verify persistence BEFORE the row disappears from the window.
            ok = bool(self._resolve_po_review_entry(
                p, "dismissed", str(p.get("job_id", "") or ""), record_award=False,
                handled_extra={"via": "po_review_window"}))
            if not ok:
                try:
                    import tkinter.messagebox as _mb
                    _mb.showerror("Dismiss not saved",
                                  "The dismissal could not be saved. The PO is kept in the queue.",
                                  parent=win)
                except Exception:
                    pass
                return
            _refresh_tree(); detail.config(text="")

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=12, pady=(4, 12))
        tk.Button(btns, text="Apply to matched job", command=_apply_selected,
                  bg="#2f6feb", fg="white").pack(side="left", padx=4)
        tk.Button(btns, text="Choose another job\u2026", command=_choose_job,
                  bg=_BTN_BG, fg=_FG).pack(side="left", padx=4)
        tk.Button(btns, text="Open email", command=_open_email_selected,
                  bg=_BTN_BG, fg=_FG).pack(side="left", padx=4)
        tk.Button(btns, text="Dismiss", command=_dismiss_selected,
                  bg=_BTN_BG, fg=_FG).pack(side="left", padx=4)
        tk.Button(btns, text="Close", command=lambda: (win.destroy(), self._refresh_po_review_button()),
                  bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
        try:
            win.lift(); win.focus_force()
        except Exception:
            pass

    def _resolve_po_review_entry(self, entry, disposition, job_id="",
                                 record_award=False, apply_awarded_quantities=False,
                                 handled_extra=None):
        """v4.1.44 (audit #5, URGENT #1): resolve a PO review entry as ONE
        transaction. The v4.1.43 UI paths saved the award transactionally, then
        SEPARATELY appended the handled audit event, removed the pending entry,
        and called save_quote_coverage() again with the result ignored -- so a
        failed second save showed success in the UI while disk still held the
        pending PO, which could reappear after restart and be applied twice.

        This method, under the coverage lock: snapshots the affected job record,
        the pending queue, the handled ledger, and the top-level timestamp;
        applies the award (deferred save), appends the audit event, removes the
        pending entry; saves ONCE; and restores EVERYTHING if the save fails.

        v4.1.47 (eighth audit #3): returns a tri-state, all truthy-compatible with
        the old boolean for callers that only refresh:
            "committed"        -- this call durably resolved the entry; committed-
                                  only side effects (reminder, archive) may run
            "already_resolved" -- benign no-op replay (stale window/double-fire);
                                  NO side effects may run; any stale pending
                                  duplicate was self-healed
            False              -- nothing changed (entry gone without a handled
                                  event, missing job, or failed save)"""
        with self._coverage_save_lock():
            _snap_rec = _snap_updated = None
            _event = _removed_entry = None
            _trimmed_events = []
            _removed_index = 0
            _cov_debug_race = False
            _rev_at_start = self._coverage_revision()
            qc = None
            try:
                qc = getattr(self, "quote_coverage", None)
                if not isinstance(qc, dict) or not isinstance(entry, dict):
                    return False
                threads = qc.get("threads", {}) or {}
                src_id = str(entry.get("src_id", "") or "")

                # v4.1.46 (seventh audit, URGENT #1): IDEMPOTENCY. Two UI surfaces
                # (the review window and the auto-popup) can hold the same durable
                # entry, and a double-fired callback replays it -- previously each
                # call re-recorded the award, appended a second handled event, and
                # doubled the PO history even though every save succeeded.
                # (a) If this src_id is already in the handled ledger, it was
                #     resolved (whatever the disposition): benign no-op, True.
                # (b) The award is created only after CLAIMING the still-pending
                #     entry; a stale window acting on a consumed entry gets False
                #     and its refresh shows the queue as it really is.
                if src_id:
                    _h_prior = qc.get("po_awards_handled", []) or []
                    if any(isinstance(x, dict) and str(x.get("src_id", "")) == src_id
                           for x in _h_prior):
                        # v4.1.47 (eighth audit #3/#4): "already_resolved", not a
                        # plain True -- callers must not run committed-only side
                        # effects (reminder/archive) on a stale replay. SELF-HEAL:
                        # a duplicate of this src_id still sitting in the pending
                        # queue (handled AND pending at once) would keep the PO
                        # visible in PO Review after resolution; remove it and
                        # persist the cleanup, restoring it if the save fails so
                        # memory never runs ahead of disk.
                        _p_now = qc.get("po_review_pending")
                        if isinstance(_p_now, list):
                            _stale = [x for x in _p_now
                                      if isinstance(x, dict) and str(x.get("src_id", "")) == src_id]
                            if _stale:
                                for _x in _stale:
                                    try:
                                        _p_now.remove(_x)
                                    except ValueError:
                                        pass
                                if not self.save_quote_coverage():
                                    _p_now.extend(_stale)
                        return "already_resolved"
                _pending_now = qc.get("po_review_pending", []) or []
                if not any(isinstance(x, dict) and str(x.get("src_id", "")) == src_id
                           for x in _pending_now):
                    return False

                _snap_rec = (copy.deepcopy(threads.get(job_id))
                             if job_id and isinstance(threads.get(job_id), dict) else None)
                _snap_updated = qc.get("updated_at", "")

                # 1. Award mutation, save deferred to step 4. A False here means no
                # net mutation happened (missing job, or _record_po_award restored
                # its own snapshot on an internal error).
                if record_award:
                    if not self._record_po_award(
                            job_id, po_numbers=entry.get("po_numbers", []) or [],
                            awarded_lines=None,
                            apply_awarded_quantities=bool(apply_awarded_quantities),
                            _defer_save=True):
                        return False

                # 2. Handled audit event (complete, auditable).
                h = qc.setdefault("po_awards_handled", [])
                if not isinstance(h, list):
                    h = qc["po_awards_handled"] = []
                _event = {
                    "src_id": src_id,
                    "entry_id": entry.get("entry_id", ""),
                    "imid": entry.get("imid", ""),
                    "job_id": job_id,
                    "job_label": entry.get("job_label", ""),
                    "po_numbers": entry.get("po_numbers", []),
                    "quote_numbers": entry.get("quote_numbers", []),
                    "sender": entry.get("sender", ""),
                    "sender_email": entry.get("sender_email", ""),
                    "confidence": entry.get("confidence", 0.0),
                    "reasons": entry.get("reasons", []),
                    "customer_conflict": entry.get("customer_conflict", False),
                    "disposition": disposition,
                    "at": datetime.now().isoformat(),
                }
                if isinstance(handled_extra, dict):
                    _event.update(handled_extra)
                h.append(_event)          # identity retained for surgical rollback
                if len(h) > 2000:
                    # v4.1.46 (seventh audit, #2): keep the trimmed prefix so a
                    # FAILED save can put it back -- previously a failed save at the
                    # cap restored only the new event, leaving memory one OLD audit
                    # event short, and the next successful save made the loss
                    # permanent on disk (the handled-ledger twin of the v4.1.44
                    # pending-queue cap defect).
                    _trimmed_events = h[:len(h) - 2000]
                    del h[:len(h) - 2000]

                # 3. Remove the pending review entry.
                pending = qc.get("po_review_pending", []) or []
                for _i, _p in enumerate(pending):
                    if isinstance(_p, dict) and _p.get("src_id") == src_id:
                        _removed_entry, _removed_index = _p, _i
                        break
                if not isinstance(qc.get("po_review_pending"), list):
                    qc["po_review_pending"] = []
                if _removed_entry is not None:
                    try:
                        qc["po_review_pending"].remove(_removed_entry)
                    except ValueError:
                        _removed_entry = None

                # 4. One save; restore everything on failure.
                if not self.save_quote_coverage():
                    _cov_debug_race = (self._coverage_revision() != _rev_at_start)
                    raise RuntimeError("coverage save failed")
                return "committed"      # v4.1.47: distinct from "already_resolved"
            except Exception:
                # v4.1.45 (sixth audit, finding #1): SURGICAL rollback. Replacing the
                # record and the two lists wholesale also erased anything a NON-lock-
                # aware coverage writer had changed inside this window (the auditor
                # demonstrated a concurrent vendor update disappearing). Revert only
                # this transaction's own writes: the PO-owned fields on the record,
                # the handled event this transaction appended (by identity), and the
                # pending entry it removed (re-inserted at its original position).
                # Concurrent additions to either list are preserved.
                try:
                    if isinstance(qc, dict):
                        if job_id and _snap_rec is not None:
                            _rec_now = (qc.get("threads", {}) or {}).get(job_id)
                            if isinstance(_rec_now, dict):
                                self._restore_po_fields(_rec_now, _snap_rec)
                            else:
                                qc.setdefault("threads", {})[job_id] = _snap_rec
                        if _event is not None:
                            _h_now = qc.get("po_awards_handled")
                            if isinstance(_h_now, list):
                                for _i in range(len(_h_now) - 1, -1, -1):
                                    if _h_now[_i] is _event:
                                        del _h_now[_i]
                                        break
                                # v4.1.46 (#2): reinsert the prefix the cap trim
                                # removed, preserving original order.
                                if _trimmed_events:
                                    _h_now[:0] = _trimmed_events
                        if _removed_entry is not None:
                            _p_now = qc.get("po_review_pending")
                            if not isinstance(_p_now, list):
                                _p_now = qc["po_review_pending"] = []
                            _sid = str((_removed_entry or {}).get("src_id", "") or "")
                            if not any(isinstance(x, dict) and x.get("src_id") == _sid
                                       for x in _p_now):
                                _p_now.insert(min(_removed_index, len(_p_now)), _removed_entry)
                        if _snap_updated is not None:
                            qc["updated_at"] = _snap_updated
                        if _cov_debug_race:
                            _cov_debug("PO resolution rolled back after a concurrent coverage "
                                       "write (revision advanced); only PO-owned fields reverted")
                except Exception:
                    pass
                return False

    def _po_review_choose_job(self, entry, parent, on_done=None):
        """Let the user pick a different open job for a PO (wrong-match / unmatched
        handling), then record the award against the chosen job."""
        try:
            jobs = self._build_open_jobs_for_po_match()
        except Exception:
            jobs = []
        picker = tk.Toplevel(parent)
        picker.title("Choose job for this PO")
        picker.configure(bg=_BG)
        picker.geometry("560x420")
        try:
            picker.transient(parent)
        except Exception:
            pass
        tk.Label(picker, bg=_BG, fg=_FG, anchor="w", justify="left",
                 text="Select the job this purchase order belongs to:").pack(
            fill="x", padx=12, pady=(10, 6))
        lb = tk.Listbox(picker, activestyle="none")
        lb.pack(fill="both", expand=True, padx=12, pady=(0, 8))
        _job_ids = []
        for j in jobs:
            _job_ids.append(j.job_id)
            _flag = " [has PO]" if getattr(j, "prior_po", False) else ""
            lb.insert("end", f"{j.label}{_flag}")
        if not jobs:
            lb.insert("end", "(no open jobs available)")

        def _confirm():
            sel = lb.curselection()
            if not sel or not _job_ids:
                return
            job_id = _job_ids[sel[0]]
            # v4.1.44 (audit #5, URGENT #1): one transaction for award + audit
            # event + pending removal.
            ok = bool(self._resolve_po_review_entry(
                entry, "applied", job_id, record_award=True,
                handled_extra={"via": "po_review_window"}))
            if not ok:
                try:
                    import tkinter.messagebox as _mb
                    _mb.showerror("PO not recorded",
                                  "That job could not be updated durably. The PO is kept in the queue.",
                                  parent=picker)
                except Exception:
                    pass
                return
            try:
                self.render_group_rows(); self.render_email_rows()
            except Exception:
                pass
            try:
                picker.destroy()
            except Exception:
                pass
            if callable(on_done):
                on_done()

        b = tk.Frame(picker, bg=_BG)
        b.pack(fill="x", padx=12, pady=(4, 12))
        tk.Button(b, text="Assign PO to this job", command=_confirm,
                  bg="#2f6feb", fg="white").pack(side="right", padx=4)
        tk.Button(b, text="Cancel", command=picker.destroy,
                  bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
        try:
            picker.lift(); picker.focus_force()
        except Exception:
            pass

    def _restore_po_review_popups(self):
        """v4.1.39: on startup, re-point the in-memory popup queue at any confident,
        non-conflicting MATCH still sitting in the DURABLE review queue, so a PO that
        was recognized before a crash/close is shown again. Ambiguous/conflict/
        unmatched entries stay in the durable queue for the review window but do not
        auto-pop. Idempotent."""
        try:
            pending = (getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or []
            if not isinstance(pending, list) or not pending:
                return
            q = getattr(self, "_pending_po_award_prompts", None)
            if not isinstance(q, list):
                q = []
                self._pending_po_award_prompts = q
            for p in pending:
                if not isinstance(p, dict):
                    continue
                if str(p.get("decision", "")) == "match" and p.get("job_id") \
                        and not p.get("customer_conflict"):
                    sid = p.get("src_id", "")
                    if sid and sid not in q:
                        q.append(sid)
        except Exception:
            pass

    def _open_po_source_email(self, item):
        """Open the PO's source email in Outlook so the user can confirm before acting.
        Resolves by EntryID (+ StoreID) with a Message-ID fallback across scan folders.
        """
        try:
            outlook, namespace = self.fresh_outlook()
            if not namespace:
                return False
            eid = str(item.get("entry_id", "") or "")
            sid = str(item.get("store_id", "") or "")
            msg = None
            if eid:
                try:
                    msg = namespace.GetItemFromID(eid, sid) if sid else namespace.GetItemFromID(eid)
                except Exception:
                    msg = None
            if msg is None and item.get("imid"):
                # Message-ID fallback -- durable across EntryID churn.
                try:
                    _mid = str(item.get("imid", "") or "").strip()
                    for _lbl, _fold in self.coverage_inbox_folders_for_quote_scan(namespace) or []:
                        try:
                            _found = _fold.Items.Find(
                                "@SQL=\"http://schemas.microsoft.com/mapi/proptag/0x1035001F\" = '" + _mid + "'")
                            if _found is not None:
                                msg = _found
                                break
                        except Exception:
                            continue
                except Exception:
                    msg = None
            if msg is None:
                return False
            self.display_outlook_item_foreground(msg)
            return True
        except Exception:
            return False

    def _po_review_entry_by_src(self, src_id):
        """Fetch a persisted PO review entry by its source id, or None."""
        try:
            pending = (getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or []
            for p in pending:
                if isinstance(p, dict) and p.get("src_id") == src_id:
                    return p
        except Exception:
            pass
        return None

    # v4.1.44: _po_review_remove was removed -- every resolution path now goes
    # through _resolve_po_review_entry, which removes the pending entry inside
    # the same transaction as the award and the handled audit event.

    def _create_po_received_followup(self, group_id, anchor_email, po_numbers=None):
        """v4.1.39: a PO-RECEIVED reminder (place vendor orders / confirm entry /
        verify delivery) -- distinct from _create_quote_completion_followup, whose
        note ('chase the PO after quote completion') is wrong once a PO is in hand."""
        try:
            if not anchor_email:
                return False
            s = getattr(self, "settings", {}) or {}
            days = int(s.get("po_received_followup_days", 1) or 0)
            hour = int(s.get("po_received_followup_hour", 7) or 0)
            minute = int(s.get("po_received_followup_minute", 0) or 0)
            due_at = (datetime.now() + timedelta(days=max(0, days))).replace(
                hour=max(0, min(23, hour)), minute=max(0, min(59, minute)),
                second=0, microsecond=0)
            for it in self.followups:
                if it.get("completed") or it.get("cancelled"):
                    continue
                if group_id and it.get("group_id") == group_id and it.get("source_reason") == "po_received":
                    return False
            _ponum = ", ".join(po_numbers or []) or ""
            item = {
                "entry_id": anchor_email.get("entry_id", ""),
                "store_id": anchor_email.get("store_id", ""),
                "conversation_id": anchor_email.get("conversation_id", ""),
                "group_id": group_id,
                "subject": anchor_email.get("subject", ""),
                "source": anchor_email.get("source", ""),
                "category": anchor_email.get("category", "General"),
                "due_at": due_at.isoformat(),
                "message": "", "use_ai": False,
                "note": ("PO received" + (f" ({_ponum})" if _ponum else "")
                         + " - place vendor orders, confirm order entry, verify delivery date."),
                "source_reason": "po_received",
                "completed": False, "cancelled": False,
                "created_at": datetime.now().isoformat(),
            }
            self.followups.append(item)
            self._followup_dedup_needed = True
            try:
                anchor_email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
            except Exception:
                pass
            self.save_followups()
            return True
        except Exception:
            return False

    def _process_pending_po_award_prompts(self):
        """MAIN-thread drain of the PO-award popup queue. The in-memory queue holds
        source-id POINTERS into the DURABLE review queue (quote_coverage
        ['po_review_pending']); the authoritative record is persisted, so a lost
        popup list never loses a PO.

        v4.1.39: records a customer PO as a PO (not vendor 'Quoted'). Default options
        follow the audit: record PO received (on); apply awarded quantities to sales
        lines (off); create an order-processing reminder (off); archive (off). A
        customer CONFLICT is surfaced prominently. 'Remind me later' snoozes;
        'Dismiss' is permanent; both are distinct choices."""
        src_id = None
        try:
            q = getattr(self, "_pending_po_award_prompts", None)
            if not isinstance(q, list) or not q:
                return
            src_id = q.pop(0)
        except Exception:
            return
        # Resolve the pointer to the durable record.
        item = self._po_review_entry_by_src(src_id) if isinstance(src_id, str) else None
        if not isinstance(item, dict):
            # Pointer went stale (already handled) -- just continue the queue.
            try:
                self.root.after(200, self._process_pending_po_award_prompts)
            except Exception:
                pass
            return
        try:
            job_id = str(item.get("job_id", "") or "")
            gid = job_id[4:] if job_id.startswith("grp:") else ""
            _conf = int(round(float(item.get("confidence", 0.0) or 0.0) * 100))
            _pos = ", ".join(item.get("po_numbers", []) or []) or "(number not detected)"
            _reasons = "; ".join(item.get("reasons", []) or [])
            _conflict = bool(item.get("customer_conflict"))

            win = tk.Toplevel(self.root)
            win.title("Purchase Order received")
            win.configure(bg=_BG)
            win.transient(self.root)
            _hdr = ("A purchase order was received.\n\n"
                    f"PO: {_pos}\n"
                    f"From: {str(item.get('sender', '') or '')[:60]}\n"
                    f"Subject: {str(item.get('subject', '') or '')[:80]}\n\n"
                    f"Matched to job ({_conf}% confidence):\n"
                    f"  {str(item.get('job_label', '') or job_id)[:80]}")
            tk.Label(win, text=_hdr, bg=_BG, fg=_FG, justify="left").pack(
                anchor="w", padx=14, pady=(12, 4))
            if _conflict:
                tk.Label(win,
                         text=("\u26a0  The PO sender's company differs from this job's "
                               "customer.\n    Confirm this is the right job before applying."),
                         bg=_BG, fg="#e6a23c", justify="left", wraplength=460).pack(
                    anchor="w", padx=14, pady=(0, 6))
            if _reasons:
                tk.Label(win, text="Why: " + _reasons[:200], bg=_BG, fg="#9aa4b2",
                         justify="left", wraplength=460).pack(anchor="w", padx=14, pady=(0, 8))

            # v4.1.39 default options per the audit -- record the PO as a PO; do NOT
            # flip vendor coverage or archive by default.
            var_record = tk.BooleanVar(value=True)
            var_apply = tk.BooleanVar(value=False)
            var_reminder = tk.BooleanVar(value=False)
            var_archive = tk.BooleanVar(value=False)
            opts = tk.Frame(win, bg=_BG)
            opts.pack(fill="x", padx=14, pady=(2, 8))
            tk.Checkbutton(opts, text="Record PO received for this job (lines unverified until reviewed)",
                           variable=var_record, bg=_BG, fg=_FG, selectcolor=_ENTRY_BG,
                           activebackground=_BG, activeforeground=_FG).pack(anchor="w")
            tk.Checkbutton(opts, text="Apply awarded quantities to matched sales lines (asserts full award, marks them Quoted)",
                           variable=var_apply, bg=_BG, fg=_FG, selectcolor=_ENTRY_BG,
                           activebackground=_BG, activeforeground=_FG).pack(anchor="w")
            tk.Checkbutton(opts, text="Create an order-processing reminder",
                           variable=var_reminder, bg=_BG, fg=_FG, selectcolor=_ENTRY_BG,
                           activebackground=_BG, activeforeground=_FG).pack(anchor="w")
            tk.Checkbutton(opts, text="Archive this group now (leave OFF to place orders first)",
                           variable=var_archive, bg=_BG, fg=_FG, selectcolor=_ENTRY_BG,
                           activebackground=_BG, activeforeground=_FG).pack(anchor="w")

            def _next():
                try:
                    win.destroy()
                except Exception:
                    pass
                self.root.after(300, self._process_pending_po_award_prompts)

            def _handled_extra():
                # v4.1.44: complete audit detail merged into the transactional
                # resolver's standard event (options, runner-up, line details).
                return {
                    "runner_up_label": item.get("runner_up_label", ""),
                    "po_lines": item.get("po_lines", {}),
                    "via": "po_award_popup",
                    "options": {
                        "record": bool(var_record.get()),
                        "apply_quantities": bool(var_apply.get()),
                        "reminder": bool(var_reminder.get()),
                        "archive": bool(var_archive.get()),
                    },
                }

            def _open_email():
                self._open_po_source_email(item)

            def _apply():
                # v4.1.44 (audit #5, URGENT #1): the award, the handled audit event,
                # and the pending-queue removal now commit as ONE transaction with a
                # single save (previously the award saved transactionally but the
                # handled/removal mutation saved separately with the result ignored,
                # so a failed second save could resurrect the PO after restart and
                # let it be applied twice). Reminder and archive side-effects run
                # only AFTER the resolution is durably on disk.
                _want_award = bool(var_record.get()) or bool(var_apply.get())
                _res = self._resolve_po_review_entry(
                    item, "applied", job_id,
                    record_award=_want_award,
                    apply_awarded_quantities=bool(var_apply.get()),
                    handled_extra=_handled_extra())
                if _res == "already_resolved":
                    # v4.1.47 (eighth audit #3): stale popup replay -- the PO was
                    # already applied or dismissed elsewhere. Run NO side effects
                    # (no reminder, no archive); just move on. The stale pending
                    # duplicate, if any, was self-healed by the resolver.
                    _next()
                    return
                ok = bool(_res)
                if not ok:
                    # v4.1.41 semantics kept: do NOT re-arm this popup (a missing job
                    # loops the same error); the entry stays in the durable review
                    # queue where 'Choose another job' is the remedy. Continue with
                    # the REST of the queue only.
                    try:
                        import tkinter.messagebox as _mb
                        _mb.showerror("PO not recorded",
                                      "The PO could not be recorded durably (the job may "
                                      "have been merged, archived, or removed, or the save "
                                      "failed).\n\nThe PO is kept in the review queue -- "
                                      "open 'PO Review' on the toolbar and use 'Choose "
                                      "another job' to assign it.",
                                      parent=win)
                    except Exception:
                        pass
                    try:
                        win.destroy()
                    except Exception:
                        pass
                    try:
                        self._refresh_po_review_button()
                    except Exception:
                        pass
                    self.root.after(300, self._process_pending_po_award_prompts)
                    return
                # Committed-only side effects below (v4.1.47): reached only when
                # _res == "committed" -- a replay returned above.
                # PO-received reminder (correct semantics), if chosen.
                try:
                    if var_reminder.get():
                        anchor = self.get_email_by_id(str(item.get("entry_id", "") or "")) or {
                            "entry_id": item.get("entry_id", ""),
                            "store_id": item.get("store_id", ""),
                            "subject": item.get("subject", ""),
                            "source": "", "category": "General",
                        }
                        self._create_po_received_followup(gid, anchor, item.get("po_numbers", []) or [])
                except Exception:
                    pass
                # Archive last (only if chosen).
                try:
                    if var_archive.get() and gid:
                        self._archive_group_by_id(gid)
                except Exception:
                    pass
                try:
                    self.render_group_rows()
                    self.render_email_rows()
                except Exception:
                    pass
                _next()

            def _snooze():
                # Leave the durable review entry in place; just stop showing it this
                # session. It will re-surface on a later scan / restart.
                _next()

            def _dismiss():
                # Permanent: record as dismissed and remove from the pending queue --
                # v4.1.44 (audit #5): as ONE transaction; a failed save keeps the
                # entry queued and says so.
                ok = bool(self._resolve_po_review_entry(
                    item, "dismissed", job_id, record_award=False,
                    handled_extra=_handled_extra()))
                if not ok:
                    try:
                        import tkinter.messagebox as _mb
                        _mb.showerror("Dismiss not saved",
                                      "The dismissal could not be saved. The PO stays in "
                                      "the review queue.",
                                      parent=win)
                    except Exception:
                        pass
                _next()

            btns = tk.Frame(win, bg=_BG)
            btns.pack(fill="x", padx=14, pady=(6, 12))
            tk.Button(btns, text="Apply", command=_apply,
                      bg="#2f6feb", fg="white").pack(side="right", padx=4)
            tk.Button(btns, text="Open email", command=_open_email,
                      bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
            tk.Button(btns, text="Remind me later", command=_snooze,
                      bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
            tk.Button(btns, text="Dismiss", command=_dismiss,
                      bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
            win.protocol("WM_DELETE_WINDOW", _snooze)   # closing = snooze, not permanent
            try:
                win.lift(); win.focus_force()
            except Exception:
                pass
        except Exception as _exc:
            try:
                _cov_debug(f"PO award popup error: {_exc!r}")
            except Exception:
                pass
            try:
                self.root.after(300, self._process_pending_po_award_prompts)
            except Exception:
                pass

    def _record_po_award(self, job_id, po_numbers=None, awarded_lines=None,
                         award_status="", apply_awarded_quantities=False,
                         _defer_save=False):
        """v4.1.42: record a customer PURCHASE ORDER against a job -- TRANSACTIONALLY
        and with honest verification semantics.

        v4.1.44: _defer_save=True applies the mutation WITHOUT saving (returning True
        once the in-memory mutation succeeded), for callers composing this into a
        LARGER transaction (_resolve_po_review_entry) that snapshots, saves once, and
        restores everything itself. Those callers must hold _coverage_save_lock().

        Customer award state stays SEPARATE from vendor coverage ('Quoted' = vendor
        pricing exists; a PO = a customer award). Fields written:

            rec["po_received"]   = True
            rec["po_numbers"]    = [...]        (accumulated across multiple POs)
            rec["award_status"]  = "unverified" | "full" | "partial"
            rec["awarded_lines"] = [line keys]  ([] until verified)
            rec["po_awards"]     = [per-PO history entries]

        VERIFICATION (external audit of v4.1.41, finding #4): the default "Record PO
        received" path records the PO as RECEIVED with award_status="unverified" and
        awarded_lines=[] -- it does NOT assert that every requested line was awarded,
        because no line-level reconciliation has happened. A full/partial award is
        recorded only when the caller supplies explicit awarded_lines, or the user
        explicitly opts into apply_awarded_quantities (asserting the PO covers the
        matched lines); only then is the legacy rec["awarded"] flag set and, when
        opted in, the covered lines' vendor item_status flipped (replicating
        coverage_set_item_status: status + manual_done_keys + check_keys).

        TRANSACTION (finding #5): the record is deep-copied before any mutation, all
        changes are made in memory, ONE save is attempted at the end, and on any
        failure the snapshot is restored -- the in-memory record never diverges from
        disk on a failed apply. Returns True only when the save succeeded.

        v4.1.43: the transaction span (snapshot -> mutate -> commit/rollback) holds
        the coverage RLock so a rollback cannot interleave with another writer."""
        _lk = self._coverage_save_lock()
        _lk.acquire()
        try:
            threads = (getattr(self, "quote_coverage", {}) or {}).get("threads", {}) or {}
            rec = threads.get(job_id)
            if not isinstance(rec, dict):
                return False
            _snapshot = copy.deepcopy(rec)
            _touched_lines = []
            try:
                _now = datetime.now().isoformat()
                # Accumulate PO numbers across multiple POs for the same job.
                existing_pos = [str(x) for x in (rec.get("po_numbers", []) or []) if x]
                for pn in (po_numbers or []):
                    if pn and pn not in existing_pos:
                        existing_pos.append(pn)
                rec["po_received"] = True
                rec["po_numbers"] = existing_pos
                rec["po_received_at"] = rec.get("po_received_at", _now)
                rec["updated_at"] = _now

                requested = list(rec.get("requested", []) or [])
                all_keys = []
                for it in requested:
                    if not isinstance(it, dict):
                        continue
                    try:
                        k = self.coverage_item_primary_key(it)
                    except Exception:
                        k = ""
                    if k:
                        all_keys.append(k)

                explicit_lines = [k for k in (awarded_lines or []) if k]
                verified = bool(explicit_lines) or bool(apply_awarded_quantities)
                if verified:
                    covered = explicit_lines or list(all_keys)
                    rec["awarded_lines"] = covered
                    rec["award_status"] = award_status or (
                        "partial" if 0 < len(covered) < len(all_keys) else "full")
                    rec["awarded"] = True
                    rec["awarded_at"] = rec.get("awarded_at", _now)
                else:
                    # Unverified receipt: the PO is on record, no line is asserted.
                    covered = []
                    rec["awarded_lines"] = []
                    rec["award_status"] = award_status or "unverified"
                    # Deliberately do NOT set rec["awarded"]; lifecycle candidacy
                    # keys off po_received, and a later verification upgrades this.

                # Per-PO history entry (auditable; supports multiple POs per job).
                hist = rec.setdefault("po_awards", [])
                if isinstance(hist, list):
                    hist.append({
                        "po_numbers": list(po_numbers or []),
                        "awarded_lines": list(covered),
                        "award_status": rec["award_status"],
                        "at": _now,
                    })

                # OPT-IN ONLY vendor flip -- in-record writes replicating
                # coverage_set_item_status (status + manual_done_keys + check_keys),
                # with NO per-line saves; the single save below commits everything.
                if apply_awarded_quantities and covered:
                    _touched_lines = list(covered)   # v4.1.45: for surgical rollback
                    item_status = rec.setdefault("item_status", {})
                    if not isinstance(item_status, dict):
                        item_status = rec["item_status"] = {}
                    done_keys = rec.setdefault("manual_done_keys", [])
                    if not isinstance(done_keys, list):
                        done_keys = rec["manual_done_keys"] = []
                    for k in covered:
                        item_status[k] = "quoted"
                        if k not in done_keys:
                            done_keys.append(k)
                    if rec.get("check_keys"):
                        rec["check_keys"] = [k for k in rec.get("check_keys", [])
                                             if k not in set(covered)]
            except Exception:
                # v4.1.45 (sixth audit #1): surgical -- revert only PO-owned fields
                # so a concurrent writer's changes to this record are not erased.
                self._restore_po_fields(rec, _snapshot, _touched_lines)
                return False

            # Single commit; restore the snapshot if it fails so memory == disk.
            # v4.1.43 (external audit of v4.1.42, CRITICAL finding): the try/except
            # here could never fire -- save_quote_coverage() swallowed its own
            # exceptions and returned None, so a failed disk write reported True and
            # memory kept the mutation disk never received. The save now returns a
            # real result and failure restores the snapshot.
            if _defer_save:
                return True     # v4.1.44: caller owns the save/rollback transaction
            if not self.save_quote_coverage():
                self._restore_po_fields(rec, _snapshot, _touched_lines)
                return False
            return True
        except Exception:
            return False
        finally:
            _lk.release()

    def _sent_recipient_is_known_customer(self, placeholder):
        """v4.1.38: True when the recipient of a sent message is a durable Customer.

        The Sent/Waiting tracker stores the recipient address as sender_email (the
        person we sent TO). We resolve that address to a durable relationship type
        via any saved status row for it, then the user's sender/domain learning.
        A confident 'C' means an outbound RFQ-coverage ledger must NOT be built
        (this is our quote going to a customer, not an RFQ going to a vendor)."""
        try:
            addr = extract_email_address(
                str((placeholder or {}).get("sender_email", "") or (placeholder or {}).get("sender", "")))
            if not addr:
                return False
            addr_l = addr.strip().lower()
            # 1. Any saved status record whose resolved/sender email matches -> its type.
            if isinstance(self.status_data, dict):
                for _rec in self.status_data.values():
                    if not isinstance(_rec, dict):
                        continue
                    for _f in ("resolved_sender_smtp", "sender_email", "sender"):
                        _v = extract_email_address(str(_rec.get(_f, "") or "")).strip().lower()
                        if _v and _v == addr_l:
                            _t = normalize_email_type_code(_rec.get("email_type", ""))
                            if _t == "C":
                                return True
                            if _t in ("V", "E", "M"):
                                return False  # known non-customer -- allow normal flow
            # 2. Sender/domain-level learning hint.
            try:
                _lh, _ls = self.get_learning_hint_for_email({"sender_email": addr, "sender": "", "subject": ""})
                if _lh and _ls in ("sender", "domain"):
                    return normalize_email_type_code(_lh.get("email_type", "")) == "C"
            except Exception:
                pass
            return False
        except Exception:
            return False

    def _sent_attachment_looks_priced(self, sent_msg):
        """v4.1.38: True when the sent message's own attachments read as a priced,
        commercial quote document (unit price / extended price / subtotal / total /
        'quotation' / a quote number). Prices in the ATTACHMENT (not the body) are
        exactly how a quote we send is missing a body '$' yet is still a quote."""
        try:
            _txt = self._coverage_attachment_text_for_priced_check(sent_msg)
        except Exception:
            _txt = ""
        if not _txt:
            return False
        low = _txt.lower()
        # Quote-shaped evidence: multiple currency amounts, per-unit pricing, or
        # explicit unit/extended-price column wording, or a quotation header/number.
        _money = len(re.findall(r"\$\s*\d[\d,]*\.\d{2}\b", _txt))
        _perunit = bool(re.search(r"/\s*(?:c|m|ea|each|ft|foot|feet)\b|\bper\s+(?:each|ea|c|m|foot|ft)\b", low))
        _cols = bool(re.search(r"\bprice\s*/?\s*um\b|\bunit\s+price\b|\bextended\b|\bext\b\s|\bext\.?\s*price\b", low))
        _totals = bool(re.search(r"\bsub\s*total\b|\bsubtotal\b|\bgrand\s+total\b|\btotal\s*:\s*\$?\d", low))
        _quotehdr = bool(re.search(r"\bquotation\b|\bquote\s*(?:#|no\.?|number)\b|\bper\s+quote\b", low))
        # Require at least TWO independent signals so an ordinary attachment with a
        # single stray number can never veto a genuine RFQ.
        signals = sum([_money >= 2, _perunit, _cols, _totals, _quotehdr])
        return signals >= 2

    def _coverage_attachment_text_for_priced_check(self, sent_msg):
        """v4.1.38: best-effort text of the sent message's document attachments, for
        the priced-quote check only. Reuses the vendor-attachment text reader the
        coverage scans use; failures are swallowed (a failed read yields no veto)."""
        try:
            _t = self._attachment_quote_text_from_msg(sent_msg)
        except Exception:
            _t = ""
        if isinstance(_t, str):
            return _t[:20000]
        if isinstance(_t, (list, tuple)) and _t:
            try:
                return str(_t[0])[:20000]
            except Exception:
                return ""
        return ""

    def _auto_create_coverage_for_sent_rfq(self, placeholder, sent_body="", sent_subject="", sent_msg=None):
        """v4.1.12: AUTO QUOTE COVERAGE, create-first. When a vendor RFQ is sent from Outlook,
        the tracker scan creates the Sent/Waiting tracker; THIS then always finishes the chain:
          1. ensure the tracker has a group -- reuse its group when the pairing already found one,
             otherwise CREATE one immediately (named from the RFQ subject). The v4.1.11 version
             gated everything on the pairing finding the original request first, which is exactly
             backwards for 'P&A -' subjects the token matcher cannot catch -- so nothing fired;
          2. create the group's coverage ledger from the item list in the RFQ actually sent,
             every line marked Waiting;
          3. hunt for the ORIGINAL customer request by matching its body against the requested
             items. A clear, dominant match links it into the group automatically (you can always
             move it out). Anything less queues a picker: the top candidates are shown after the
             scan for you to choose, or skip.
        Dupe-guards unchanged from v4.1.11: Waiting-on-Vendor + unpriced sends only; never touches
        a group that already has a ledger (active or dismissed); items tagged 'rfq_extraction' so a
        manual Quote RFQ REPLACES them; per-item dedupe; no items -> no ledger, no group created.
        Gated by settings['auto_coverage_from_sent_rfq'] (default ON)."""
        try:
            if not bool(self.settings.get("auto_coverage_from_sent_rfq", True)):
                return False
            if not isinstance(placeholder, dict):
                return False
            if str(placeholder.get("status", "") or "") != "Waiting on Vendor":
                return False
            pid = placeholder.get("entry_id", "")
            if not pid:
                return False
            # v4.1.38 RECIPIENT VETO: this hook builds a ledger of items WE requested
            # from a VENDOR. If the sent message went to a known CUSTOMER, it cannot be
            # a vendor RFQ no matter what the (possibly mis-inferred) tracker status
            # says -- it is our quote/reply going out, and its attachment is a quote we
            # SENT, not a customer's request. Resolve the recipient and refuse.
            try:
                if self._sent_recipient_is_known_customer(placeholder):
                    _cov_debug("SENT-RFQ veto: recipient is a known customer -- not a vendor RFQ")
                    return False
            except Exception:
                pass
            body = str(sent_body or "")
            if re.search(r"\$\s*\d", body):
                return False              # priced send = a quote, not an RFQ
            # v4.1.38 ATTACHMENT-AWARE PRICE VETO: the body often has no "$" because the
            # prices live in the attached quote document. A priced/commercial quote in
            # the SENT attachment is still a quote we are SENDING, not an RFQ -- veto it.
            try:
                if sent_msg is not None and self._sent_attachment_looks_priced(sent_msg):
                    _cov_debug("SENT-RFQ veto: sent attachment is a priced quote document")
                    return False
            except Exception:
                pass
            mats = []
            if body.strip():
                # v4.1.26 (round 8, defect #1): keep identical repeated rows from the
                # sent-RFQ body -- they become separate requested lines in the ledger.
                mats = normalize_material_items(
                    extract_materials_from_quote_text(
                        _coverage_reassemble_columnar_quote(body), keep_duplicates=True) or [],
                    keep_duplicates=True)
            # v4.1.18: the item list is often NOT typed into the RFQ body -- it rides
            # along as the customer's forwarded attachment (PDF/Excel) or a screenshot
            # pasted into the send. When the body yields nothing, or explicitly points
            # at attached material, read the sent message's own attachments/images too.
            if sent_msg is not None and (
                    not mats
                    or re.search(r"attach|screenshot|image below|picture|photo|see (?:the )?list", body.lower())):
                try:
                    _amats = self._coverage_materials_from_msg_attachments(
                        sent_msg, include_images=True, source_label="sent-rfq")
                except Exception:
                    _amats = []
                if _amats:
                    # v4.1.26 (round 8, defect #1): preserve genuine duplicate rows WITHIN
                    # each source (a BOM listing '10 EA 632S' twice is two requirements),
                    # but stay occurrence-aware ACROSS sources so an item that appears in
                    # both the typed body and the attachment isn't double-counted: each
                    # body occurrence absorbs at most one matching attachment occurrence.
                    _amats = normalize_material_items(_amats, keep_duplicates=True)
                    if mats:
                        def _xsrc_key(_r):
                            return re.sub(r"\s+", " ",
                                          f"{_r.get('qty','')}|{_r.get('unit','')}|{_r.get('part_number','')}|{_r.get('description','')}".lower()).strip()
                        _bod_ct = {}
                        for _r in mats:
                            _k = _xsrc_key(_r)
                            _bod_ct[_k] = _bod_ct.get(_k, 0) + 1
                        for _r in _amats:
                            _k = _xsrc_key(_r)
                            if _bod_ct.get(_k, 0) > 0:
                                _bod_ct[_k] -= 1   # already represented by a body row
                                continue
                            mats.append(_r)
                    else:
                        mats = _amats
            if not mats:
                return False
            if not isinstance(getattr(self, "quote_coverage", None), dict):
                return False
            threads = self.quote_coverage.setdefault("threads", {})
            memberships = self.groups_data.setdefault("memberships", {})
            gid = str(memberships.get(pid, "") or "")
            if gid and not self.get_group_by_id(gid):
                gid = ""
            # v4.1.18 audit: the customer-attachment scan may have keyed this job's ledger
            # by conversation before it was grouped -- fold that fragment into the group
            # key first so this hook sees ONE ledger and never creates a duplicate.
            if gid:
                self._coverage_fold_conversation_into_group(
                    str(placeholder.get("conversation_id", "") or ""), gid)
            if gid and isinstance(threads.get("grp:" + gid), dict):
                return False              # this job already has a ledger -- never touch it
            subj = str(sent_subject or placeholder.get("subject", "") or "")
            # v4.1.14: decide the group BEFORE creating one. The v4.1.13 flow always spun up a
            # NEW group for an ungrouped tracker and then tried to pull the original request in --
            # exactly backwards when the request already lives in a group (an RFQ sent with a
            # fresh subject for a job like '1598 HBL Controlled' fragmented into its own group).
            # Now: hunt for the original request FIRST; a dominant match whose email is already
            # grouped means the tracker JOINS that group; a dominant ungrouped match gets a new
            # group holding both; anything ambiguous gets a new group + the picker.
            self_row = None
            if pid and not str(pid).startswith("sentwait:"):
                _se = self.get_email_by_id(pid)
                if _se and not _se.get("is_sent_waiting_placeholder"):
                    self_row = _se
            cands = []
            adopt_eid = ""
            adopt_gid = ""
            if not gid and self_row is None:
                try:
                    cands = self._score_original_request_candidates({"requested": mats}, placeholder)
                except Exception:
                    cands = []
                if cands:
                    best = cands[0]
                    second_score = cands[1][1] if len(cands) > 1 else 0.0
                    # Dominant either way: (a) most items found in one email, clearly ahead of the
                    # runner-up; or (b) the ONLY candidate at all, on >=2 hard part hits covering
                    # at least half the job -- with zero competition, demanding 80% just pushed
                    # obvious matches to the picker.
                    _dominant = (best[3] >= 2 and ((best[1] >= 0.8 and (best[1] - second_score) >= 0.3)
                                                   or (len(cands) == 1 and best[1] >= 0.5)))
                    if _dominant:
                        adopt_eid = best[0]
                        _cg = str(memberships.get(adopt_eid, "") or "")
                        if _cg and self.get_group_by_id(_cg):
                            adopt_gid = _cg
            if not gid:
                if adopt_gid:
                    gid = adopt_gid
                    memberships[pid] = gid
                    self.save_groups()
                else:
                    # Create the group NOW -- the ledger must not wait for a request match.
                    gname = re.sub(r"^\s*(?:re|fw|fwd)\s*:\s*", "", subj, flags=re.I)
                    gname = re.sub(r"^\s*p\s*&\s*a\s*[-:]*\s*", "", gname, flags=re.I).strip()[:80] or "Quote job"
                    gid = self._unique_group_id()
                    self.groups_data.setdefault("groups", []).append({
                        "id": gid, "name": gname, "urgency": "Normal", "collapsed": False,
                        "has_new": False, "created_at": datetime.now().isoformat(), "notes": "",
                        "archived": False, "auto_created_reason": "auto_coverage_sent_rfq"})
                    memberships[pid] = gid
                    self.save_groups()
            key = "grp:" + gid
            # v4.1.18 audit: same fold for the just-created/adopted group -- a
            # conversation-keyed ledger from the attachment scan becomes THIS ledger.
            self._coverage_fold_conversation_into_group(
                str(placeholder.get("conversation_id", "") or ""), gid)
            if isinstance(threads.get(key), dict):
                if adopt_gid:
                    # Joined a job that ALREADY has a ledger: the grouping is the win here --
                    # the sent tracker is now filed with its job; the existing ledger is never
                    # touched (its Waiting marks come from the normal outgoing-RFQ hook).
                    self.save_quote_coverage()
                    _cov_debug(f"AUTO-COVERAGE v3: tracker adopted into existing group {gid} "
                               f"(ledger already present; left untouched)")
                    return True
                return False
            added = self.update_coverage_requested(
                key, mats, subject=subj, group_id=gid,
                conversation_id=str(placeholder.get("conversation_id", "") or ""),
                source="rfq_extraction")
            if not added:
                return False
            rec = self.get_coverage_record(key)
            if isinstance(rec, dict):
                aw = rec.setdefault("auto_waiting_keys", [])
                for _it in rec.get("requested", []) or []:
                    _pk = self.coverage_item_primary_key(_it)
                    if _pk and _pk not in aw:
                        aw.append(_pk)
                rec["auto_coverage_created"] = True
                rec["auto_coverage_from_sent_id"] = str(placeholder.get("sent_entry_id", "") or "")
                rec["updated_at"] = datetime.now().isoformat()
            # 3) tie in the ORIGINAL customer request. A real inbound row standing in as the
            # tracker IS the original request; an adopted/dominant candidate links directly;
            # anything ambiguous goes to the picker.
            linked = False
            if self_row is not None:
                linked = self._link_original_request_to_group(pid, gid, key)
            elif adopt_eid:
                linked = self._link_original_request_to_group(adopt_eid, gid, key)
            if not linked and cands:
                self._queue_request_link_prompt(gid, key, subj, cands[:5])
            self.save_quote_coverage()
            _cov_debug(f"AUTO-COVERAGE v3: group {gid}{' (adopted)' if adopt_gid else ''} ledger created "
                       f"with {added} item(s); candidates={len(cands)} auto_linked={linked}")
            return True
        except Exception:
            return False

    def _score_original_request_candidates(self, rec, placeholder):
        """v4.1.12: rank inbound emails as the likely ORIGINAL customer request for a coverage
        ledger, by how many of the requested items their body contains (gated item matching --
        the same evidence bar the flip uses). Returns [(entry_id, score, label, hits), ...] best
        first. score = matched requested items / total requested. Conservative candidacy: needs
        >=2 gated hits (>=1 when the job has a single line). Only inbound, non-placeholder mail
        received BEFORE the RFQ was sent, within 21 days; body loads capped at 15 (subject-token
        prefilter orders the queue so likely matches load first)."""
        out = []
        try:
            requested = (rec or {}).get("requested", []) or []
            if not requested:
                return out
            need = 2 if len(requested) >= 2 else 1
            common = _coverage_record_common_tokens(requested)
            try:
                sent_ts = float(placeholder.get("received_timestamp", 0) or 0)
            except Exception:
                sent_ts = 0.0
            cutoff_ts = sent_ts - 21 * 86400 if sent_ts else 0.0
            subj_tokens = extract_group_match_tokens(str(placeholder.get("subject", "") or ""))
            pool = []
            for e in getattr(self, "emails", []) or []:
                if not isinstance(e, dict) or e.get("is_sent_waiting_placeholder"):
                    continue
                if e.get("sender_type") == "sent_placeholder":
                    continue
                ts = float(e.get("received_timestamp", 0) or 0)
                if sent_ts and not (cutoff_ts <= ts <= sent_ts + 60):
                    continue
                pre = 1 if (subj_tokens and subj_tokens & extract_group_match_tokens(e.get("subject", ""))) else 0
                pool.append((pre, ts, e))
            pool.sort(key=lambda t: (-t[0], -t[1]))
            loads = 0
            for _pre, _ts, e in pool:
                body = str(e.get("body", "") or "")
                if not body.strip():
                    if loads >= 15:
                        continue
                    loads += 1
                    try:
                        body = str(self.load_body_for_rfq(e) or "")
                    except Exception:
                        body = ""
                    if not body.strip():
                        continue
                blob = {"description": (str(e.get("subject", "") or "") + "\n" + body)[:20000]}
                hits = 0
                for req in requested:
                    try:
                        if coverage_items_match(req, blob) and _coverage_distinctive_match_ok(req, blob, common):
                            hits += 1
                    except Exception:
                        continue
                if hits < need:
                    continue
                score = hits / float(len(requested))
                label = f"{e.get('sender','')} \u2014 {str(e.get('subject',''))[:60]} ({e.get('received','')})"
                out.append((e.get("entry_id", ""), round(score, 3), label, hits))
            out.sort(key=lambda t: (-t[1], -t[3]))
        except Exception:
            pass
        return out

    def _link_original_request_to_group(self, request_entry_id, gid, key):
        """v4.1.12: tie a found original request into the job -- membership (only when the email
        is not already in a DIFFERENT group), plus customer/subject on the ledger."""
        try:
            if not request_entry_id:
                return False
            em = self.get_email_by_id(request_entry_id)
            if not em:
                return False
            memberships = self.groups_data.setdefault("memberships", {})
            cur = str(memberships.get(request_entry_id, "") or "")
            if cur and cur != gid and self.get_group_by_id(cur):
                return False          # respect an existing grouping -- never move it
            memberships[request_entry_id] = gid
            self.save_groups()
            rec = self.get_coverage_record(key)
            if isinstance(rec, dict):
                rec["customer"] = str(em.get("sender", "") or "") or rec.get("customer", "")
                _ce = extract_email_address(em.get("sender_email", "") or "")
                if _ce:
                    rec["customer_email"] = _ce
                _sj = str(em.get("subject", "") or "")
                if _sj:
                    rec["subject"] = _sj
                rec["original_request_entry_id"] = request_entry_id
                rec["updated_at"] = datetime.now().isoformat()
                self.save_quote_coverage()
            _cov_debug(f"AUTO-COVERAGE v2: original request {request_entry_id[:18]}... linked into group {gid}")
            return True
        except Exception:
            return False

    def _queue_request_link_prompt(self, gid, key, subject, candidates):
        """v4.1.12: remember that this new auto-created coverage still needs its original request
        picked by the user. The scan runs on a WORKER thread, so no UI here -- the queue is drained
        on the main thread by _process_pending_request_link_prompts() after the scan repaints."""
        try:
            q = getattr(self, "_pending_request_link_prompts", None)
            if not isinstance(q, list):
                q = []
                self._pending_request_link_prompts = q
            if any(isinstance(p, dict) and p.get("gid") == gid for p in q):
                return
            q.append({"gid": gid, "key": key, "subject": str(subject or ""),
                      "candidates": list(candidates or []), "created_at": datetime.now().isoformat()})
        except Exception:
            pass

    def _resolve_request_link_choice(self, gid, key, cand_eid):
        """v4.1.14: apply the user's pick from the link-the-original-request dialog. If the chosen
        email is UNGROUPED (or already in this group), link it in place. If it lives in ANOTHER
        group -- the user just told us this job belongs THERE -- adopt that group: move this auto
        group's members (the tracker) over, merge/re-key the ledger to grp:<target> (lossless via
        _merge_coverage_records when one exists), fill customer from the pick, and retire the now
        empty auto-created group. Never moves the chosen email itself."""
        try:
            if not cand_eid:
                return False
            memberships = self.groups_data.setdefault("memberships", {})
            cur = str(memberships.get(cand_eid, "") or "")
            if not cur or cur == gid or not self.get_group_by_id(cur):
                return self._link_original_request_to_group(cand_eid, gid, key)
            # --- adopt the candidate's group ---
            for _eid, _g in list(memberships.items()):
                if _g == gid:
                    memberships[_eid] = cur
            threads = self.quote_coverage.setdefault("threads", {})
            src = threads.pop(key, None)
            tkey = "grp:" + cur
            if isinstance(src, dict):
                src["group_id"] = cur
                src["thread_key"] = tkey
                if isinstance(threads.get(tkey), dict):
                    self._merge_coverage_records(threads[tkey], src)
                else:
                    threads[tkey] = src
            em = self.get_email_by_id(cand_eid)
            rec = threads.get(tkey)
            if em and isinstance(rec, dict):
                rec["customer"] = str(em.get("sender", "") or "") or rec.get("customer", "")
                _ce = extract_email_address(em.get("sender_email", "") or "")
                if _ce:
                    rec["customer_email"] = _ce
                rec["original_request_entry_id"] = cand_eid
                rec["updated_at"] = datetime.now().isoformat()
            _g_list = self.groups_data.get("groups", [])
            _auto = next((g for g in _g_list if g.get("id") == gid), None)
            if (_auto and _auto.get("auto_created_reason") == "auto_coverage_sent_rfq"
                    and not any(v == gid for v in memberships.values())):
                self.groups_data["groups"] = [g for g in _g_list if g.get("id") != gid]
            self.save_groups()
            self.save_quote_coverage()
            _cov_debug(f"AUTO-COVERAGE v3: user pick adopted existing group {cur}; auto group {gid} folded in")
            return True
        except Exception:
            return False

    def _process_pending_request_link_prompts(self):
        """v4.1.12: MAIN-thread drain of the link-the-original-request queue. One simple picker
        per pending job: the top candidates (best first, with their match strength), Link / Skip.
        Skip leaves the job fully functional (group + tracker + ledger) -- the request can always
        be added to the group by hand later."""
        item = None
        q = None
        try:
            q = getattr(self, "_pending_request_link_prompts", None)
            if not isinstance(q, list) or not q:
                return
            item = q.pop(0)
            gid = item.get("gid", "")
            key = item.get("key", "")
            cands = [c for c in (item.get("candidates") or []) if c and c[0]]
            if not gid or not cands:
                self.root.after(200, self._process_pending_request_link_prompts)
                return
            # v4.1.19 AUDIT FIX (external audit finding #1): this dialog referenced
            # undefined names (BG_COLOR/FG_COLOR/ENTRY_BG/BUTTON_BG -- the real theme
            # globals are _BG/_FG/_ENTRY_BG/_BTN_BG), so construction died on NameError,
            # the blanket except swallowed it, and because the item was popped first the
            # linking opportunity was silently discarded. The picker NEVER worked. Fixed
            # names; construction failures are now logged and the item is re-queued
            # (bounded retries) instead of vanishing.
            win = tk.Toplevel(self.root)
            win.title("Quote Coverage \u2014 link the original request")
            win.configure(bg=_BG)
            win.transient(self.root)
            tk.Label(win, text=("A quote coverage was auto-created for:\n" + str(item.get("subject", ""))[:90]
                                + "\n\nWhich email is the ORIGINAL customer request?"),
                     bg=_BG, fg=_FG, justify="left").pack(anchor="w", padx=12, pady=(10, 6))
            lb = tk.Listbox(win, width=100, height=min(8, max(3, len(cands))),
                            bg=_ENTRY_BG, fg=_FG, selectbackground="#4a6ea9")
            for c in cands:
                try:
                    lb.insert("end", f"{int(round(float(c[1]) * 100))}% match \u2014 {c[2]}")
                except Exception:
                    lb.insert("end", str(c[2]))
            lb.pack(fill="both", expand=True, padx=12, pady=4)
            lb.selection_set(0)
            btns = tk.Frame(win, bg=_BG)
            btns.pack(fill="x", padx=12, pady=(6, 10))

            def _done_next():
                try:
                    win.destroy()
                except Exception:
                    pass
                self.root.after(200, self._process_pending_request_link_prompts)

            def _do_link():
                try:
                    sel = lb.curselection()
                    if sel:
                        eid = cands[sel[0]][0]
                        if self._resolve_request_link_choice(gid, key, eid):
                            try:
                                self.render_group_rows()
                            except Exception:
                                pass
                except Exception:
                    pass
                _done_next()

            tk.Button(btns, text="Link selected", command=_do_link,
                      bg="#2f6feb", fg="white").pack(side="right", padx=4)
            tk.Button(btns, text="Skip", command=_done_next,
                      bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
            win.protocol("WM_DELETE_WINDOW", _done_next)
            try:
                win.lift()
                win.focus_force()
            except Exception:
                pass
        except Exception as _link_exc:
            # v4.1.19: never silently discard a linking opportunity. Log it and re-queue
            # the item (max 3 attempts) so a transient construction failure retries.
            _cov_debug(f"REQUEST-LINK picker failed to open: {_link_exc!r}")
            try:
                if isinstance(item, dict):
                    item["_retries"] = int(item.get("_retries", 0) or 0) + 1
                    if item["_retries"] <= 3 and isinstance(q, list):
                        q.append(item)
                        self.root.after(1500, self._process_pending_request_link_prompts)
            except Exception:
                pass

    def _find_request_email_for_tracker(self, placeholder):
        """v3.9.89: for a tracker on an email sent directly from Outlook (no tracked_entry_id link),
        find the originating customer request by shared job/PO/project key -- the 'customer name +
        job name/#' match. Conservative: needs a strong shared token from extract_group_match_tokens;
        returns None (leave it for manual grouping) when nothing matches."""
        try:
            tracker_tokens = extract_group_match_tokens(placeholder.get("subject", ""))
            if not tracker_tokens:
                return None
            best = None
            best_hits = 0
            best_ts = 0.0
            for e in getattr(self, "emails", []) or []:
                if not isinstance(e, dict) or e.get("is_sent_waiting_placeholder"):
                    continue
                if e.get("sender_type") == "sent_placeholder":
                    continue
                if e.get("entry_id", "") == placeholder.get("entry_id", ""):
                    continue
                hits = tracker_tokens & extract_group_match_tokens(
                    " ".join([str(e.get("subject", "") or ""), str(e.get("body", "") or "")[:1200]]))
                if not hits:
                    continue
                ts = float(e.get("received_timestamp", 0) or 0)
                if len(hits) > best_hits or (len(hits) == best_hits and ts > best_ts):
                    best = e
                    best_hits = len(hits)
                    best_ts = ts
            return best
        except Exception:
            return None

    def make_sent_waiting_placeholder(self, sent_msg, pending=None, target_status="Waiting on Vendor"):
        """Create a visible main-window tracking row for a sent email we are waiting on.

        v2.10.8: Works for both MaINbox-created drafts and manually sent Outlook emails.
        """
        pending = pending or {}
        try:
            conversation_id = ""
            try:
                conversation_id = sent_msg.ConversationID or ""
            except Exception:
                conversation_id = pending.get("conversation_id", "")

            sent_entry_id = ""
            try:
                sent_entry_id = sent_msg.EntryID or ""
            except Exception:
                sent_entry_id = pending.get("sent_entry_id", "")

            subject = ""
            try:
                subject = sent_msg.Subject or pending.get("subject", "")
            except Exception:
                subject = pending.get("subject", "")

            sent_conversation_index = ""
            sent_internet_message_id = ""
            try:
                sent_conversation_index = str(getattr(sent_msg, "ConversationIndex", "") or pending.get("sent_conversation_index", "") or "")
            except Exception:
                sent_conversation_index = pending.get("sent_conversation_index", "") or ""
            try:
                pa = sent_msg.PropertyAccessor
                try:
                    sent_internet_message_id = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
                except Exception:
                    sent_internet_message_id = pending.get("sent_internet_message_id", "") or ""
            except Exception:
                sent_internet_message_id = pending.get("sent_internet_message_id", "") or ""

            if not conversation_id and not sent_entry_id and not subject:
                return None

            # One active waiting row per conversation. If Outlook lacks a conversation id,
            # fall back to sent EntryID / subject hash.
            if conversation_id:
                placeholder_id = f"sentwait:{conversation_id}"
            elif sent_entry_id:
                placeholder_id = f"sentwait:{sent_entry_id}"
            else:
                digest = hashlib.sha1(str(subject).encode("utf-8", "ignore")).hexdigest()[:16]
                placeholder_id = f"sentwait:subject:{digest}"

            recipient = ""
            try:
                recipient = sent_msg.To or ""
            except Exception:
                recipient = pending.get("recipient", "")

            sent_on = datetime.now()
            try:
                if sent_msg.SentOn:
                    sent_on = sent_msg.SentOn.replace(tzinfo=None)
            except Exception:
                try:
                    sent_on = datetime.fromisoformat(pending.get("sent_on", ""))
                except Exception:
                    pass

            placeholder = {
                "entry_id": placeholder_id,
                "sent_entry_id": sent_entry_id,
                "sent_conversation_index": sent_conversation_index,
                "sent_internet_message_id": sent_internet_message_id,
                "tracked_entry_id": pending.get("entry_id", ""),
                "tracked_store_id": pending.get("store_id", ""),
                "store_id": pending.get("store_id", ""),
                "conversation_id": conversation_id,
                "source": "Sent / Waiting",
                "subject": subject,
                "normalized_subject": normalize_subject_for_match(subject),
                "sender": recipient or pending.get("sender", "Sent RFQ / Reply"),
                "sender_email": recipient or pending.get("sender_email", ""),
                "body": "",
                "body_loaded": False,
                "received": sent_on.strftime("%Y-%m-%d %I:%M %p"),
                "received_timestamp": sent_on.timestamp(),
                "outlook_categories": "",
                "category": pending.get("category", "Vendor / Supplier") or "Vendor / Supplier",
                "urgency": pending.get("urgency", "Normal") if pending.get("urgency") != "Low" else "Normal",
                "status": target_status or "Waiting on Vendor",
                "message": None,
                "is_new_import": False,
                "followup_time": "",
                "sender_type": "sent_placeholder",
                "email_type": "V" if target_status == "Waiting on Vendor" else "C",
                "sender_intent": "Waiting for vendor/customer response to sent email",
                "business_relevance": "1.0",
                "spam_likelihood": "0.0",
                "same_subject_related_count": 0,
                "has_attachments": False,
                "is_sent_waiting_placeholder": True,
                "created_at": datetime.now().isoformat(),
                "cleared": False,
            }
            return placeholder
        except Exception:
            return None

    def sync_sent_waiting_placeholders_into_email_list(self):
        """Keep active sent placeholders visible in the main list, without duplicate rows."""
        try:
            # v2.10.8 patch: app-deleted sent placeholders must stay gone after restart.
            # They are stored separately in mainbox_sent_waiting_placeholders.json, so
            # filter them against status_data before re-inserting them into self.emails.
            # v3.9.27 duplicate self-heal: a thread shows at most ONE tracker row. If a
            # loaded real email row is already the active tracker for a conversation
            # (sent_waiting_tracker_active), retire any placeholder for that same
            # conversation instead of showing both. This also cleans up the duplicate
            # pairs older versions created (they re-activated the real row AND added a
            # placeholder for the same send).
            tracked_conversations = set()
            for row in getattr(self, "emails", []) or []:
                if not isinstance(row, dict) or row.get("is_sent_waiting_placeholder"):
                    continue
                if row.get("sent_waiting_tracker_active"):
                    conv = str(row.get("conversation_id", "") or "").strip()
                    if conv:
                        tracked_conversations.add(conv)
            retired_any = False
            active = []
            for p in getattr(self, "sent_waiting_placeholders", []):
                pid = p.get("entry_id", "")
                if p.get("cleared"):
                    continue
                if pid and self.status_data.get(pid, {}).get("app_deleted"):
                    p["cleared"] = True
                    p["cleared_reason"] = "app_deleted"
                    continue
                p_conv = str(p.get("conversation_id", "") or "").strip()
                if p_conv and p_conv in tracked_conversations:
                    p["cleared"] = True
                    p["cleared_at"] = datetime.now().isoformat()
                    p["cleared_reason"] = "superseded_by_tracked_row"
                    retired_any = True
                    continue
                active.append(p)
            if retired_any:
                try:
                    # Persist the retirements; respects the placeholder batch if open.
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
            # Remove placeholder rows that were cleared/deleted from the visible list.
            active_ids = {p.get("entry_id", "") for p in active}
            self.emails = [e for e in self.emails if not e.get("is_sent_waiting_placeholder") or e.get("entry_id") in active_ids]
            # Index where each placeholder row currently lives so we can both add missing
            # rows and refresh rows that already exist.
            existing_index = {}
            for i, e in enumerate(self.emails):
                if e.get("is_sent_waiting_placeholder"):
                    existing_index.setdefault(e.get("entry_id", ""), i)
            for placeholder in active:
                pid = placeholder.get("entry_id", "")
                if not pid:
                    continue
                if pid not in existing_index:
                    self.emails.append(dict(placeholder))
                else:
                    # v3.9.1 fix: a second reply in the same conversation updates the stored
                    # placeholder (newer SentOn time, recipient, body), but the older code only
                    # ever APPENDED a placeholder once and skipped it forever after, so the
                    # already-visible row kept showing the first send time (e.g. the "will
                    # advise" reply at 7:46 stayed put after the quote went out at 8:49).
                    # Refresh the visible row in place from the updated placeholder, then
                    # re-overlay any durable user workflow choice (e.g. a manual Completed)
                    # so the newest send time/body shows without discarding the user's edits.
                    i = existing_index[pid]
                    merged = dict(self.emails[i])
                    merged.update(placeholder)
                    saved = self.status_data.get(pid, {}) if isinstance(self.status_data, dict) else {}
                    if saved:
                        self.apply_saved_workflow_to_email(merged, saved)
                    self.emails[i] = merged
            # v3 efficiency: rebuild index after placeholder sync changes self.emails.
            self._rebuild_email_index()
        except Exception:
            pass

    def thread_is_app_deleted_for_placeholder(self, placeholder):
        """v3.9.2: True if this Sent / Waiting placeholder belongs to a thread the user
        deleted from MaINbox only.

        The Sent Items scan re-sees the original sent message on every refresh, and in
        Cached Exchange Mode the sent message's own EntryID may differ from the id used to
        record the deletion (the deletion is recorded against the inbound message). The old
        guard only checked the placeholder's own entry_id, so a deleted thread came back as a
        Sent / Waiting echo. Matching on the conversation id (precise) catches that; a
        subject-only fallback is used ONLY when neither side has a conversation id, so
        unrelated same-subject RFQs are never suppressed.
        """
        try:
            if not isinstance(self.status_data, dict) or not isinstance(placeholder, dict):
                return False
            p_conv = str(placeholder.get("conversation_id", "") or "").strip().lower()
            p_subject = normalize_subject_for_match(placeholder.get("subject", "") or "")
            if not p_conv and not p_subject:
                return False
            for rec in self.status_data.values():
                if not isinstance(rec, dict) or not rec.get("app_deleted"):
                    continue
                rec_conv = str(rec.get("conversation_id", "") or "").strip().lower()
                if p_conv and rec_conv and rec_conv == p_conv:
                    return True
                if not p_conv and not rec_conv and p_subject:
                    rec_subject = normalize_subject_for_match(rec.get("subject", "") or rec.get("normalized_subject", "") or "")
                    if rec_subject and rec_subject == p_subject:
                        return True
            return False
        except Exception:
            return False

    def add_or_update_sent_waiting_placeholder(self, placeholder):
        if not placeholder:
            return False
        try:
            pid = placeholder.get("entry_id", "")
            if not pid:
                return False
            # v2.10.8 patch: do not recreate a sent/waiting placeholder that the
            # user already deleted from MaINbox only. This prevents it from coming
            # back when Sent Items are scanned after reopening the app.
            # v3.9.2: also suppress when the placeholder's THREAD was deleted (matched by
            # conversation id), since Cached Exchange Mode re-syncs change EntryIDs and the
            # placeholder's own id will not match the id the deletion was recorded against.
            if self.status_data.get(pid, {}).get("app_deleted") or self.thread_is_app_deleted_for_placeholder(placeholder):
                for existing in self.sent_waiting_placeholders:
                    if existing.get("entry_id") == pid:
                        existing["cleared"] = True
                        existing["cleared_reason"] = "app_deleted"
                        break
                self.save_sent_waiting_placeholders()
                return False
            updated = False
            for i, existing in enumerate(self.sent_waiting_placeholders):
                if existing.get("entry_id") == pid:
                    # v3.8.29 fix: do NOT resurrect a placeholder that a matching
                    # incoming reply already cleared. The Sent Items scan re-sees the
                    # original sent message on every refresh; the old code blindly set
                    # cleared=False here, so a tracker cleared by a reply would pop back
                    # and never go away (the "reply came in but the tracker is still
                    # sitting there" bug). Only un-clear if the user genuinely re-opened
                    # the thread by sending AGAIN after the clearing reply, i.e. this
                    # sent message is newer than the reply that cleared it.
                    # v3.9.27: the guard only protected "matching_reply_imported", but the
                    # bounded Outlook rescue scan clears with reason
                    # "bounded_outlook_thread_reply_found" -- those trackers were being
                    # resurrected on the next Sent Items pass whenever Cached Exchange
                    # Mode reassigned the sent message's EntryID (so the processed-id
                    # skip missed it). Protect every reply-based clear the same way, and
                    # never resurrect a placeholder retired by duplicate cleanup (its
                    # surviving sibling is the live tracker for that thread).
                    existing_reason = str(existing.get("cleared_reason", "") or "")
                    if existing.get("cleared") and existing_reason == "duplicate_placeholder_cleanup":
                        return False
                    if existing.get("cleared") and existing_reason in (
                        "matching_reply_imported",
                        "bounded_outlook_thread_reply_found",
                    ):
                        try:
                            new_send_ts = float(placeholder.get("received_timestamp", 0) or 0)
                            cleared_reply_ts = float(existing.get("cleared_reply_timestamp", 0) or 0)
                        except Exception:
                            new_send_ts = 0
                            cleared_reply_ts = 0
                        if not (new_send_ts and cleared_reply_ts and new_send_ts > cleared_reply_ts + 30):
                            # Same original send (or older than the reply) -> leave it
                            # cleared and treat as a no-op so it stays out of the list.
                            return False
                    self.sent_waiting_placeholders[i].update(placeholder)
                    self.sent_waiting_placeholders[i]["cleared"] = False
                    updated = True
                    break
            if not updated:
                self.sent_waiting_placeholders.append(placeholder)
            self.save_sent_waiting_placeholders()
            # v3.9.89: keep this tracker grouped with the request it came from (and, once it
            # arrives, the vendor reply). Additive only -- never moves an already-grouped row.
            try:
                self._link_sent_tracker_to_request_group(placeholder)
            except Exception:
                pass
            if getattr(self, "_placeholder_batch", 0):
                self._placeholder_batch_sync_dirty = True
            else:
                self.sync_sent_waiting_placeholders_into_email_list()
            return True
        except Exception:
            return False

    def _flag_tracked_reply_by_intent(self, reply_email, waiting_party=""):
        """v3.9.51: an inbound reply that just cleared one of our sent/waiting trackers is the
        response we were waiting on. Give it a sensible status automatically so the next step is
        smooth, using the existing non-AI analyze_reply_intent():
          - a question / 'please confirm' style reply  -> Needs Reply
          - a 'working on it' / 'I'll get back to you'  -> Waiting on Vendor / Waiting on Customer
            (Vendor vs Customer taken from the tracker we cleared -- whoever we sent to -- then the
             reply's own sender type, then the phrase wording)
          - a plain thank-you / acknowledgement         -> Completed
        Replies with no clear signal are left untouched for normal AI triage. A status the user set
        by hand is never overridden, and the flagged reply is marked settled so the background drip
        / AutoPilot do not re-classify over this rule.
        """
        try:
            if (not isinstance(reply_email, dict)
                    or reply_email.get("ai_user_locked")
                    or reply_email.get("is_sent_waiting_placeholder")):
                return
            try:
                self.load_body_if_needed(reply_email)
            except Exception:
                pass
            subject = reply_email.get("subject", "") or ""
            body = reply_email.get("body", "") or ""
            sender = reply_email.get("sender_email", "") or reply_email.get("sender", "") or ""
            intent = analyze_reply_intent(
                subject=subject, body=body, sender_or_recipient=sender,
                source=reply_email.get("source", ""), direction="inbound")
            new_status = ""
            if intent.get("is_closed_ack"):
                new_status = "Completed"
            elif intent.get("is_waiting"):
                party = waiting_party if waiting_party in ("Vendor", "Customer") else ""
                if not party:
                    _st = str(reply_email.get("sender_type", "") or reply_email.get("email_type", "") or "").lower()
                    if "customer" in _st or "prospect" in _st:
                        party = "Customer"
                    elif "vendor" in _st or "supplier" in _st:
                        party = "Vendor"
                if not party:
                    party = "Customer" if intent.get("intent") == "waiting_on_customer" else "Vendor"
                new_status = "Waiting on " + party
            else:
                _body_q = _strip_reply_boilerplate_for_intent(body) if body else ""
                if intent.get("intent") in ("needs_reply", "business_request") or ("?" in _body_q):
                    new_status = "Needs Reply"
            if not new_status:
                return
            reply_email["status"] = new_status
            reply_email["ai_triaged_at"] = datetime.now().isoformat()
            reply_email["ai_triage_pending"] = False
            reply_email["ai_user_locked"] = True
            reply_email["is_new_import"] = False
            self.save_record(reply_email)
        except Exception:
            pass

    def clear_sent_waiting_placeholder_for_reply(self, email):
        """When a matching incoming reply arrives, clear the sent-placeholder reminder.

        Match by Outlook conversation id first, then by normalized subject as a fallback.
        The timestamp guard keeps the original older inbox email from clearing a brand-new
        sent/waiting tracker.
        """
        try:
            if not email or email.get("is_sent_waiting_placeholder"):
                return False
            conversation_id = email.get("conversation_id", "")
            subject_key = self._normalized_thread_subject(email.get("subject", ""))
            if not conversation_id and not subject_key:
                return False
            changed = False
            now = datetime.now().isoformat()
            for placeholder in getattr(self, "sent_waiting_placeholders", []):
                if placeholder.get("cleared"):
                    continue

                same_thread = False
                if conversation_id and placeholder.get("conversation_id") == conversation_id:
                    same_thread = True
                elif subject_key and self._normalized_thread_subject(placeholder.get("subject", "")) == subject_key:
                    same_thread = True
                if not same_thread:
                    continue

                # Only clear when the incoming message is newer than the sent placeholder.
                # This prevents the original customer/vendor email in the same conversation from
                # immediately clearing the reminder during the next refresh.
                try:
                    email_ts = float(email.get("received_timestamp", 0) or 0)
                    placeholder_ts = float(placeholder.get("received_timestamp", 0) or 0)
                except Exception:
                    email_ts = 0
                    placeholder_ts = 0
                if placeholder_ts and email_ts and email_ts <= (placeholder_ts + 30):
                    continue

                placeholder["cleared"] = True
                placeholder["cleared_at"] = now
                placeholder["cleared_by_entry_id"] = email.get("entry_id", "")
                placeholder["cleared_reason"] = "matching_reply_imported"
                # v3.8.29: remember WHEN the clearing reply arrived. The Sent Items
                # scan re-sees the original sent message on later refreshes; the
                # resurrect guard in add_or_update_sent_waiting_placeholder() uses
                # this to tell "same old send" (keep cleared) apart from "user sent
                # again after the reply" (genuine re-open -> allow a fresh tracker).
                placeholder["cleared_reply_timestamp"] = email_ts
                changed = True
                # v3.9.89: the reply takes the tracker's place IN THE SAME GROUP -- inherit the
                # tracker's group so the request, the now-cleared tracker, and this reply stay
                # together. Additive: only sets a membership when the reply has none; never moves it.
                try:
                    _pg = self.groups_data.get("memberships", {}).get(placeholder.get("entry_id", ""), "")
                    _rid = email.get("entry_id", "")
                    if (_pg and _rid and self.get_group_by_id(_pg)
                            and not self.groups_data.get("memberships", {}).get(_rid)):
                        self.groups_data.setdefault("memberships", {})[_rid] = _pg
                except Exception:
                    pass
            if changed:
                # v3.9.51: flag the reply that cleared this sent placeholder by intent (see
                # _flag_tracked_reply_by_intent) so the next step is smooth. Placeholders do not
                # carry Vendor/Customer, so the helper derives it from the reply's own sender type.
                self._flag_tracked_reply_by_intent(email, "")
                active_ids = {p.get("entry_id", "") for p in self.sent_waiting_placeholders if not p.get("cleared")}
                self.emails = [e for e in self.emails if not e.get("is_sent_waiting_placeholder") or e.get("entry_id") in active_ids]
                self._rebuild_email_index()
                self.save_sent_waiting_placeholders()
                self.save_cached_state()
            return changed
        except Exception:
            return False


    def clear_existing_sent_waiting_tracker_rows_for_reply(self, reply_email):
        """Close older real-email rows that were only being shown as sent/waiting trackers.

        Sent tracking can be displayed in two ways:
        1) a separate Sent / Waiting placeholder row, and
        2) the original customer/vendor row re-activated to Waiting after the user sends a reply.

        clear_sent_waiting_placeholder_for_reply() handles #1. This handles #2 so that when a
        newer inbound reply arrives, the older "I sent this out" tracker row leaves the main
        active pane and the new reply becomes the item the user sees/acts on.
        """
        try:
            if not reply_email or reply_email.get("is_sent_waiting_placeholder"):
                return False
            reply_id = str(reply_email.get("entry_id", "") or "")
            conversation_id = str(reply_email.get("conversation_id", "") or "").strip()
            subject_key = self._normalized_thread_subject(reply_email.get("subject", ""))
            if not conversation_id and not subject_key:
                return False
            try:
                reply_ts = float(reply_email.get("received_timestamp", 0) or 0)
            except Exception:
                reply_ts = 0
            if not reply_ts:
                return False

            changed = False
            cleared_at = datetime.now().isoformat()
            waiting_party = ""  # v3.9.51: which side the cleared tracker was waiting on (Vendor/Customer)
            for tracked in list(getattr(self, "emails", []) or []):
                try:
                    if not isinstance(tracked, dict):
                        continue
                    if tracked.get("is_sent_waiting_placeholder"):
                        continue
                    tracked_id = str(tracked.get("entry_id", "") or "")
                    if tracked_id and tracked_id == reply_id:
                        continue
                    # Only close rows MaINbox explicitly woke up as sent-waiting trackers.
                    # This avoids completing normal/manual Waiting items that are unrelated to
                    # the sent-tracker feature.
                    if not tracked.get("sent_waiting_tracker_active"):
                        continue

                    same_thread = False
                    tracked_conv = str(tracked.get("conversation_id", "") or "").strip()
                    if conversation_id and tracked_conv and tracked_conv == conversation_id:
                        same_thread = True
                    elif subject_key and self._normalized_thread_subject(tracked.get("subject", "")) == subject_key:
                        same_thread = True
                    if not same_thread:
                        continue

                    try:
                        tracked_ts = float(tracked.get("sent_waiting_tracker_sent_timestamp", 0) or tracked.get("received_timestamp", 0) or 0)
                    except Exception:
                        tracked_ts = 0
                    # The response must be newer than the row/tracker it is clearing. Give Outlook
                    # a small clock/conversation-sync cushion so the original row cannot clear itself.
                    if tracked_ts and reply_ts <= (tracked_ts + 30):
                        continue

                    tracked["sent_waiting_tracker_active"] = False
                    tracked["sent_waiting_tracker_cleared_at"] = cleared_at
                    tracked["sent_waiting_tracker_cleared_by_entry_id"] = reply_id
                    tracked["sent_waiting_tracker_cleared_reason"] = "matching_reply_imported"
                    _orig_tracked_status = tracked.get("status")
                    if _orig_tracked_status == "Waiting on Vendor" and not waiting_party:
                        waiting_party = "Vendor"
                    elif _orig_tracked_status == "Waiting on Customer" and not waiting_party:
                        waiting_party = "Customer"
                    if _orig_tracked_status in ("Waiting on Vendor", "Waiting on Customer"):
                        tracked["status"] = "Completed"
                    tracked["is_new_import"] = False
                    self.save_record(tracked)
                    changed = True
                except Exception:
                    continue

            if changed:
                # v3.9.51: the inbound reply that just cleared a tracker is the response we were
                # waiting on -- flag it by intent so the next step is smooth (a question -> Needs
                # Reply; "working on it / I'll get back to you" -> Waiting on Vendor/Customer matching
                # who we sent to; a plain thanks -> Completed).
                self._flag_tracked_reply_by_intent(reply_email, waiting_party)
                self.flush_status_data()
                # Remove completed tracker rows from the default active pane immediately; they remain
                # available under Completed/search/history if the user needs them.
                self._rebuild_email_index()
                self.save_cached_state()
            return changed
        except Exception:
            return False

    def sweep_sent_waiting_trackers_against_loaded_replies(self):
        """Hard cleanup for Sent / Waiting trackers that already have a newer reply loaded.

        This covers the real-world Joanne case where both rows are visible/searchable:
        - a Sent / Waiting tracker row from the sent email, and
        - a newer inbound RE: row from the other person.

        The older cleanup depended on the incoming import event or the backing
        sent_waiting_placeholders list. If the reply was already in the cache/search list,
        or the visible tracker row was orphaned from that backing list, the row could sit
        in the main pane forever. This sweep compares every visible Sent / Waiting tracker
        against every loaded non-placeholder reply and removes/completes only trackers that
        have a clearly newer matching reply.
        """
        changed = False
        cleared_replies = 0
        try:
            rows = list(getattr(self, "emails", []) or [])
            if not rows:
                return 0

            def norm_subject(value):
                # Use the global normalizer here because it strips RE/FW/External prefixes
                # consistently for both sent placeholders and already-cached inbound replies.
                try:
                    return normalize_subject_for_match(value or "")
                except Exception:
                    try:
                        return self._normalized_thread_subject(value or "")
                    except Exception:
                        return str(value or "").strip().lower()

            def row_ts(row):
                """Return a sortable timestamp for sent/reply matching.

                Older cached rows can have only the display string (for example
                '2026-06-08 12:33 PM') and no received_timestamp. The earlier
                hard cleanup skipped those rows because timestamp was 0, which
                let old Sent / Waiting trackers stay visible even after the
                matching reply was already loaded.
                """
                if not isinstance(row, dict):
                    return 0.0
                for key in ("received_timestamp", "sent_timestamp", "sent_waiting_tracker_sent_timestamp"):
                    try:
                        value = row.get(key, 0)
                        if value not in (None, ""):
                            ts = float(value)
                            if ts > 0:
                                return ts
                    except Exception:
                        pass
                for key in ("received", "sent_on", "created_at", "updated_at"):
                    value = str(row.get(key, "") or "").strip()
                    if not value:
                        continue
                    # Drop timezone suffixes only for display-string fallback matching;
                    # we only need relative ordering inside the same Outlook mailbox.
                    value_clean = value.replace("T", " ")
                    value_clean = re.sub(r"\.\d+", "", value_clean)
                    value_clean = re.sub(r"(Z|[+-]\d{2}:?\d{2})$", "", value_clean).strip()
                    for fmt in (
                        "%Y-%m-%d %I:%M %p",
                        "%Y-%m-%d %H:%M",
                        "%Y-%m-%d %H:%M:%S",
                        "%m/%d/%Y %I:%M %p",
                        "%m/%d/%Y %H:%M",
                        "%m/%d/%y %I:%M %p",
                        "%m/%d/%y %H:%M",
                    ):
                        try:
                            return datetime.strptime(value_clean, fmt).timestamp()
                        except Exception:
                            continue
                    try:
                        return datetime.fromisoformat(value_clean).timestamp()
                    except Exception:
                        pass
                return 0.0

            replies = []
            for row in rows:
                if not isinstance(row, dict):
                    continue
                if row.get("is_sent_waiting_placeholder") or row.get("source") == "Sent / Waiting":
                    continue
                ts = row_ts(row)
                if not ts:
                    continue
                subj = norm_subject(row.get("subject", ""))
                conv = str(row.get("conversation_id", "") or "").strip()
                if not conv and not subj:
                    continue
                replies.append((row, conv, subj, ts))
            if not replies:
                return 0

            def matches_reply(tracker, reply_conv, reply_subj):
                tracker_conv = str(tracker.get("conversation_id", "") or "").strip()
                if tracker_conv and reply_conv and tracker_conv == reply_conv:
                    return True
                tracker_subj = norm_subject(tracker.get("subject", ""))
                if tracker_subj and reply_subj and tracker_subj == reply_subj:
                    return True
                return False

            now = datetime.now().isoformat()
            active_placeholder_ids = set()
            for placeholder in getattr(self, "sent_waiting_placeholders", []) or []:
                if not isinstance(placeholder, dict) or placeholder.get("cleared"):
                    continue
                sent_ts = row_ts(placeholder)
                if not sent_ts:
                    continue
                for reply, reply_conv, reply_subj, reply_ts in replies:
                    if reply_ts <= sent_ts + 30:
                        continue
                    if not matches_reply(placeholder, reply_conv, reply_subj):
                        continue
                    placeholder["cleared"] = True
                    placeholder["cleared_at"] = now
                    placeholder["cleared_by_entry_id"] = reply.get("entry_id", "")
                    placeholder["cleared_reason"] = "matching_reply_imported"
                    placeholder["cleared_reply_timestamp"] = reply_ts
                    pid = placeholder.get("entry_id", "")
                    if pid:
                        rec = self.status_data.get(pid, {}) if isinstance(self.status_data, dict) else {}
                        if isinstance(rec, dict):
                            rec.update({
                                "status": "Completed",
                                "sent_waiting_cleared": True,
                                "sent_waiting_cleared_at": now,
                                "sent_waiting_cleared_by_entry_id": reply.get("entry_id", ""),
                                "updated_at": now,
                            })
                            self.status_data[pid] = rec
                    changed = True
                    cleared_replies += 1
                    break

            for placeholder in getattr(self, "sent_waiting_placeholders", []) or []:
                if isinstance(placeholder, dict) and not placeholder.get("cleared"):
                    pid = placeholder.get("entry_id", "")
                    if pid:
                        active_placeholder_ids.add(pid)

            # Also remove orphaned visible Sent / Waiting rows even if their backing
            # placeholder record is missing/stale. This is intentionally limited to rows
            # explicitly marked as Sent / Waiting so normal Waiting-on-Vendor rows are not touched.
            kept = []
            for row in rows:
                if not isinstance(row, dict):
                    continue
                is_visible_tracker = bool(row.get("is_sent_waiting_placeholder") or row.get("source") == "Sent / Waiting")
                if not is_visible_tracker:
                    kept.append(row)
                    continue
                pid = row.get("entry_id", "")
                if row.get("is_sent_waiting_placeholder") and pid in active_placeholder_ids:
                    # Keep active placeholders unless a newer reply proves this visible row is stale.
                    pass
                sent_ts = row_ts(row)
                should_remove = False
                if sent_ts:
                    for reply, reply_conv, reply_subj, reply_ts in replies:
                        if reply_ts <= sent_ts + 30:
                            continue
                        if matches_reply(row, reply_conv, reply_subj):
                            should_remove = True
                            row["cleared"] = True
                            row["cleared_at"] = now
                            row["cleared_by_entry_id"] = reply.get("entry_id", "")
                            row["cleared_reason"] = "matching_reply_imported"
                            row["cleared_reply_timestamp"] = reply_ts
                            if pid:
                                rec = self.status_data.get(pid, {}) if isinstance(self.status_data, dict) else {}
                                if isinstance(rec, dict):
                                    rec.update({
                                        "status": "Completed",
                                        "sent_waiting_cleared": True,
                                        "sent_waiting_cleared_at": now,
                                        "sent_waiting_cleared_by_entry_id": reply.get("entry_id", ""),
                                        "updated_at": now,
                                    })
                                    self.status_data[pid] = rec
                            changed = True
                            cleared_replies += 1
                            break
                if not should_remove:
                    kept.append(row)

            if changed:
                self.emails = kept
                self._rebuild_email_index()
                try:
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
                try:
                    self.flush_status_data()
                except Exception:
                    pass
                try:
                    self.save_cached_state()
                except Exception:
                    pass
            return cleared_replies
        except Exception:
            return 0

    def assign_imported_reply_to_tracker_group(self, reply_email, tracker=None):
        """Put a rescued incoming reply into the same group as the waiting tracker it replaces.

        The normal auto-group path intentionally has safety guards (especially domain guards),
        but this path is different: the reply has already matched an active sent/waiting tracker
        by Outlook thread/subject and newer timestamp. In that case it should inherit the exact
        group from the tracker/original row so the old tracker can be replaced by the real reply
        inside the correct quote/job group.
        """
        try:
            if not isinstance(reply_email, dict) or not isinstance(tracker, dict):
                return False
            reply_id = str(reply_email.get("entry_id", "") or "").strip()
            if not reply_id or self.get_group_id_for_email(reply_id):
                return False

            candidates = []
            for key in ("entry_id", "tracked_entry_id", "original_entry_id", "source_entry_id", "parent_entry_id"):
                value = str(tracker.get(key, "") or "").strip()
                if value and value not in candidates:
                    candidates.append(value)

            group_id = ""
            for candidate_id in candidates:
                group_id = self.get_group_id_for_email(candidate_id)
                if group_id and self.get_group_by_id(group_id):
                    break

            # If the visible tracker row is grouped only by thread membership somewhere else,
            # use the existing thread resolver as a final safe fallback.
            if not group_id:
                group_id = self.find_group_id_for_thread(tracker, skip_entry_id=reply_id)
            if not group_id:
                group_id = self.find_group_id_for_thread(reply_email, skip_entry_id=reply_id)

            group = self.get_group_by_id(group_id) if group_id else None
            if not group:
                return False

            self.groups_data.setdefault("memberships", {})[reply_id] = group_id
            reply_email["thread_group_rule"] = "sent_waiting_tracker_group"
            reply_email["sent_waiting_tracker_group_id"] = group_id
            reply_email["sent_waiting_tracker_group_name"] = group.get("name", "")
            reply_email["sent_waiting_tracker_grouped_from_entry_id"] = candidates[0] if candidates else ""
            self.mark_group_has_new(group_id)
            self.save_groups()
            return True
        except Exception:
            return False

    def import_matching_inthread_reply_from_outlook(self, msg, folder_label="", tracker=None, silent=True):
        """Import a real inbound reply that matched an active Waiting/Sent tracker.

        v3.9.19 fix: Sales mailbox refresh normally honors the selected Outlook
        category, which is correct for new unrelated mail, but vendor replies can
        arrive uncategorized. If a reply is in the same thread as an active
        sent/waiting tracker, it must be imported even when the category filter
        would have skipped it; otherwise the old Waiting row remains visible and
        the user never sees the answer in MaINbox.
        """
        try:
            source_label = "Sales" if "sales" in str(folder_label or "").lower() else "My Inbox"
            email = self.build_email_data(msg, source_label)
            if not email:
                return False
            entry_id = str(email.get("entry_id", "") or "").strip()
            if not entry_id:
                return False
            already_loaded = bool(self.get_email_by_id(entry_id))
            is_new = self.upsert_email(email)
            try:
                self.assign_imported_reply_to_tracker_group(email, tracker=tracker)
            except Exception:
                pass
            try:
                self.suppress_my_inbox_duplicate_when_sales_copy_exists(email)
            except Exception:
                pass
            if is_new and email.get("urgency") != "Low":
                try:
                    self.handle_new_email_after_import(email, silent=silent)
                except Exception:
                    pass
                try:
                    scheduled_commitments = self.scan_outlook_message_for_commitments(msg, email, direction=source_label)
                    if scheduled_commitments:
                        email["followup_time"] = self.get_followup_display_for_email(email.get("entry_id", ""))
                except Exception:
                    pass
            if is_new or not already_loaded:
                try:
                    self.save_record(email)
                    self.flush_status_data()
                except Exception:
                    pass
            return bool(is_new or not already_loaded)
        except Exception:
            return False

    def scan_outlook_inbox_for_sent_waiting_thread_replies(self, max_items=80, lookback_days=7):
        """Bounded rescue scan for active Waiting/Sent trackers.

        v3.9.20 performance fix: v3.9.19 proved the right idea, but it could be
        too broad during Refresh because it scanned many Outlook messages against
        every active Waiting row. This version keeps the same behavior but only
        looks at recent, active tracker candidates and only imports a reply after
        a cheap thread/subject match is found.
        """
        running_flag = "_sent_waiting_thread_scan_running"
        last_flag = "_sent_waiting_thread_scan_last_at"
        try:
            if getattr(self, running_flag, False):
                return 0
            now_ts_guard = datetime.now().timestamp()
            last_ts_guard = float(getattr(self, last_flag, 0) or 0)
            # Refresh can call reconciliation several times; one bounded scan is enough.
            if last_ts_guard and (now_ts_guard - last_ts_guard) < 8:
                return 0
            setattr(self, running_flag, True)
            setattr(self, last_flag, now_ts_guard)
        except Exception:
            pass

        try:
            # v3.9.27 fix (the "ty reply never cleared the tracker" bug): the old caps
            # silently clamped the caller's max_items=160 down to 70 AND that budget was
            # shared across folders. My Inbox is scanned first, so on any busy mailbox it
            # consumed the entire budget and the Sales Inbox was NEVER reached. Replies
            # that live only in the Sales Inbox (uncategorized customer replies are not
            # imported by the category-filtered refresh) could then never clear their
            # tracker. The budget is now PER FOLDER and honors the caller up to 200.
            try:
                per_folder_max = max(15, min(int(max_items or 80), 200))
            except Exception:
                per_folder_max = 160
            try:
                lookback_days = max(1, min(int(lookback_days or 7), 14))
            except Exception:
                lookback_days = 7

            def norm_subject(value):
                try:
                    return normalize_subject_for_match(value or "")
                except Exception:
                    try:
                        return self._normalized_thread_subject(value or "")
                    except Exception:
                        return str(value or "").strip().lower()

            def parse_row_ts(row):
                if not isinstance(row, dict):
                    return 0.0
                for key in ("received_timestamp", "sent_timestamp", "sent_waiting_tracker_sent_timestamp"):
                    try:
                        value = row.get(key, 0)
                        if value not in (None, ""):
                            ts = float(value)
                            if ts > 0:
                                return ts
                    except Exception:
                        pass
                for key in ("received", "sent_on", "created_at", "updated_at"):
                    value = str(row.get(key, "") or "").strip()
                    if not value:
                        continue
                    value_clean = value.replace("T", " ")
                    value_clean = re.sub(r"\.\d+", "", value_clean)
                    value_clean = re.sub(r"(Z|[+-]\d{2}:?\d{2})$", "", value_clean).strip()
                    for fmt in ("%Y-%m-%d %I:%M %p", "%Y-%m-%d %H:%M", "%Y-%m-%d %H:%M:%S", "%m/%d/%Y %I:%M %p", "%m/%d/%Y %H:%M", "%m/%d/%y %I:%M %p", "%m/%d/%y %H:%M"):
                        try:
                            return datetime.strptime(value_clean, fmt).timestamp()
                        except Exception:
                            continue
                    try:
                        return datetime.fromisoformat(value_clean).timestamp()
                    except Exception:
                        pass
                return 0.0

            trackers = []
            cutoff_dt = datetime.now() - timedelta(days=lookback_days)
            cutoff_ts = cutoff_dt.timestamp()

            def add_tracker(kind, row):
                if not isinstance(row, dict):
                    return
                if row.get("cleared"):
                    return
                subj_key = norm_subject(row.get("subject", ""))
                conv_id = str(row.get("conversation_id", "") or row.get("sent_conversation_id", "") or row.get("sent_waiting_tracker_conversation_id", "") or "").strip()
                sent_ts = parse_row_ts(row)
                # Keep the rescue scan focused. Very old or keyless rows should not make
                # Refresh walk the whole mailbox.
                if sent_ts and sent_ts < cutoff_ts:
                    return
                if not subj_key and not conv_id:
                    return
                trackers.append({"kind": kind, "row": row, "ts": sent_ts, "subject_key": subj_key, "conversation_id": conv_id})

            for p in getattr(self, "sent_waiting_placeholders", []) or []:
                if isinstance(p, dict) and not p.get("cleared"):
                    add_tracker("placeholder", p)
            for row in getattr(self, "emails", []) or []:
                if not isinstance(row, dict):
                    continue
                if row.get("sent_waiting_tracker_active") or row.get("is_sent_waiting_placeholder") or row.get("source") == "Sent / Waiting":
                    add_tracker("row", row)
                elif row.get("status") in ("Waiting on Vendor", "Waiting on Customer") and row.get("urgency") != "Low":
                    add_tracker("waiting_row", row)

            if not trackers:
                return 0

            # Newest active trackers first and cap the total work. This avoids Refresh
            # hanging when old Waiting rows have accumulated.
            trackers.sort(key=lambda x: float(x.get("ts") or 0), reverse=True)
            trackers = trackers[:50]

            conv_map = {}
            subj_map = {}
            for t in trackers:
                if t.get("conversation_id"):
                    conv_map.setdefault(t["conversation_id"], []).append(t)
                if t.get("subject_key"):
                    subj_map.setdefault(t["subject_key"], []).append(t)

            outlook, namespace = self.fresh_outlook()
            if not namespace:
                return 0
            folders = self.coverage_inbox_folders_for_quote_scan(namespace)
            if not folders:
                try:
                    folders = [("My Inbox", namespace.GetDefaultFolder(6))]
                except Exception:
                    folders = []
            if not folders:
                return 0

            changed = False
            cleared = 0
            now = datetime.now().isoformat()
            seen_msg_ids = set()

            def clear_tracker(kind, tracker_row, reply_entry_id, reply_ts):
                nonlocal changed, cleared
                sent_ts = parse_row_ts(tracker_row)
                if sent_ts and reply_ts and reply_ts <= sent_ts + 30:
                    return False
                if kind == "placeholder" or tracker_row.get("is_sent_waiting_placeholder") or tracker_row.get("source") == "Sent / Waiting":
                    tracker_row["cleared"] = True
                    tracker_row["cleared_at"] = now
                    tracker_row["cleared_by_entry_id"] = reply_entry_id
                    tracker_row["cleared_reason"] = "bounded_outlook_thread_reply_found"
                    tracker_row["cleared_reply_timestamp"] = reply_ts
                    pid = tracker_row.get("entry_id", "")
                    if pid and isinstance(getattr(self, "status_data", None), dict):
                        rec = self.status_data.get(pid, {})
                        if isinstance(rec, dict):
                            rec.update({
                                "status": "Completed",
                                "sent_waiting_cleared": True,
                                "sent_waiting_cleared_at": now,
                                "sent_waiting_cleared_by_entry_id": reply_entry_id,
                                "sent_waiting_cleared_reason": "bounded_outlook_thread_reply_found",
                                "updated_at": now,
                            })
                            self.status_data[pid] = rec
                else:
                    tracker_row["sent_waiting_tracker_active"] = False
                    tracker_row["sent_waiting_tracker_cleared_at"] = now
                    tracker_row["sent_waiting_tracker_cleared_by_entry_id"] = reply_entry_id
                    tracker_row["sent_waiting_tracker_cleared_reason"] = "bounded_outlook_thread_reply_found"
                    if tracker_row.get("status") in ("Waiting on Vendor", "Waiting on Customer"):
                        tracker_row["status"] = "Completed"
                    tracker_row["is_new_import"] = False
                    try:
                        self.save_record(tracker_row)
                    except Exception:
                        pass
                changed = True
                cleared += 1
                return True

            total_checked = 0
            for folder_label, folder in folders:
                try:
                    items = folder.Items
                    try:
                        cut_str = cutoff_dt.strftime("%m/%d/%Y %I:%M %p")
                        items = items.Restrict(f"[ReceivedTime] >= '{cut_str}'")
                    except Exception:
                        pass
                    try:
                        items.Sort("[ReceivedTime]", True)
                    except Exception:
                        pass
                    folder_checked = 0
                    for msg in items:
                        # v3.9.27: per-folder budget. The old shared total made the first
                        # folder (My Inbox) starve the Sales Inbox entirely.
                        if folder_checked >= per_folder_max:
                            break
                        folder_checked += 1
                        total_checked += 1
                        try:
                            try:
                                recv_dt = msg.ReceivedTime.replace(tzinfo=None)
                            except Exception:
                                recv_dt = None
                            if recv_dt is not None and recv_dt < cutoff_dt:
                                break
                            recv_ts = recv_dt.timestamp() if recv_dt else datetime.now().timestamp()
                            try:
                                entry_id = str(msg.EntryID or "")
                            except Exception:
                                entry_id = ""
                            if entry_id and entry_id in seen_msg_ids:
                                continue
                            if entry_id:
                                seen_msg_ids.add(entry_id)
                            try:
                                subject = str(msg.Subject or "")
                            except Exception:
                                subject = ""
                            try:
                                conv_id = str(msg.ConversationID or "").strip()
                            except Exception:
                                conv_id = ""
                            subj_key = norm_subject(subject)
                            candidates = []
                            if conv_id and conv_id in conv_map:
                                candidates.extend(conv_map.get(conv_id, []))
                            if subj_key and subj_key in subj_map:
                                for t in subj_map.get(subj_key, []):
                                    if t not in candidates:
                                        candidates.append(t)
                            if not candidates:
                                continue

                            imported = False
                            for t in list(candidates):
                                row = t.get("row")
                                if not isinstance(row, dict) or row.get("cleared"):
                                    continue
                                sent_ts = float(t.get("ts") or parse_row_ts(row) or 0)
                                if sent_ts and recv_ts <= sent_ts + 30:
                                    continue
                                try:
                                    if entry_id and not imported:
                                        existing_reply = self.get_email_by_id(entry_id)
                                        if existing_reply:
                                            self.assign_imported_reply_to_tracker_group(existing_reply, tracker=row)
                                            imported = True
                                        else:
                                            self.import_matching_inthread_reply_from_outlook(msg, folder_label=folder_label, tracker=row, silent=True)
                                            imported = True
                                except Exception:
                                    pass
                                # v3.9.27: clear EVERY matching tracker for this reply. The old
                                # break-after-first left sibling trackers (e.g. a placeholder AND
                                # a re-activated real row for the same thread) sitting active.
                                clear_tracker(t.get("kind", "row"), row, entry_id, recv_ts)
                        except Exception:
                            continue
                except Exception:
                    continue

            if changed:
                active_ids = {p.get("entry_id", "") for p in getattr(self, "sent_waiting_placeholders", []) or [] if isinstance(p, dict) and not p.get("cleared")}
                self.emails = [
                    e for e in (getattr(self, "emails", []) or [])
                    if not (isinstance(e, dict) and (e.get("is_sent_waiting_placeholder") or e.get("source") == "Sent / Waiting") and e.get("entry_id", "") not in active_ids)
                ]
                try:
                    self._rebuild_email_index()
                except Exception:
                    pass
                try:
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
                try:
                    self.flush_status_data()
                except Exception:
                    pass
                try:
                    self.save_cached_state()
                except Exception:
                    pass
            return cleared
        except Exception:
            return 0
        finally:
            try:
                setattr(self, running_flag, False)
            except Exception:
                pass

    def reconcile_sent_waiting_placeholders_against_replies(self):
        """Clear any active sent/waiting tracker that already has a newer in-thread reply in
        the loaded email list. The per-message clear during a scan only fires while a reply is
        first being imported; since Sent Items (which create the trackers) are scanned AFTER
        the inbox, a reply imported in the same cycle can miss its tracker and then fall outside
        the incremental scan window, so it is never re-checked. This sweep re-checks every loaded
        reply against the current trackers, reusing the same conversation/subject + timestamp
        matching, so a received response always clears its tracker regardless of scan ordering.

        Returns the number of replies that cleared at least one tracker (0 if none), so callers
        that gate a repaint on "did anything change" treat a reconciliation-only clear as a change."""
        cleared = 0
        try:
            placeholders = getattr(self, "sent_waiting_placeholders", [])
            has_active_placeholder = any(not p.get("cleared") for p in placeholders)
            has_active_real_row_tracker = any(
                isinstance(row, dict) and row.get("sent_waiting_tracker_active")
                for row in (getattr(self, "emails", []) or [])
            )
            # First run the hard sweep. It catches already-loaded replies and orphaned
            # visible Sent / Waiting rows, not just brand-new import events.
            cleared += int(self.sweep_sent_waiting_trackers_against_loaded_replies() or 0)
            # Then ask Outlook itself: for each active sent tracker, scan recent incoming
            # messages and link by the actual thread/conversation chain. This catches cases
            # where the reply exists in Outlook but was not present in the cached row list.
            cleared += int(self.scan_outlook_inbox_for_sent_waiting_thread_replies(max_items=160, lookback_days=14) or 0)
            if not has_active_placeholder and not has_active_real_row_tracker:
                return cleared
            for e in list(self.emails):
                if not e.get("is_sent_waiting_placeholder"):
                    placeholder_cleared = self.clear_sent_waiting_placeholder_for_reply(e)
                    row_cleared = self.clear_existing_sent_waiting_tracker_rows_for_reply(e)
                    if placeholder_cleared or row_cleared:
                        cleared += 1
            # One final sweep handles rows that became orphaned during the per-reply clear.
            cleared += int(self.sweep_sent_waiting_trackers_against_loaded_replies() or 0)
        except Exception:
            pass
        return cleared

    def infer_status_after_reply_sent(self, email, target_status_after_send=None):
        # An explicit caller-provided target always wins (e.g. a vendor-no-response
        # follow-up that KNOWS it is chasing a vendor).
        if target_status_after_send in ["Waiting on Customer", "Waiting on Vendor"]:
            return target_status_after_send
        current = email.get("status", "") if email else ""
        if current in ["Waiting on Customer", "Waiting on Vendor"]:
            return current
        # v4.1.38: the DURABLE relationship type decides the direction BEFORE any
        # category/subject heuristic. The prior code inferred "vendor" from the
        # workflow category, so a reply to a Customer whose category had been
        # mis-classified "Vendor / Supplier" was recorded as Waiting-on-Vendor --
        # which then let the outbound quote be treated as a vendor RFQ. A confirmed
        # Customer is Waiting-on-Customer; a confirmed Vendor is Waiting-on-Vendor.
        try:
            _dtype = self._durable_email_type_for_email(email if isinstance(email, dict) else {})
        except Exception:
            _dtype = ""
        if _dtype == "C":
            return "Waiting on Customer"
        if _dtype == "V":
            return "Waiting on Vendor"
        # Type unknown -- fall back to the category/source/subject signal as before.
        category = (email.get("category", "") if email else "").lower()
        source = (email.get("source", "") if email else "").lower()
        subject = (email.get("subject", "") if email else "").lower()
        if "vendor" in category or "supplier" in category or "vendor" in source or "vendor" in subject:
            return "Waiting on Vendor"
        return "Waiting on Customer"

    def record_pending_reply_check(self, email, target_status_after_send=None, followup_source="manual"):
        if not email:
            return
        entry_id = email.get("entry_id", "")
        conversation_id = email.get("conversation_id", "")
        if not entry_id and not conversation_id:
            return
        existing_status = self.status_data.get(entry_id, {}) if entry_id else {}
        if entry_id and (existing_status.get("app_deleted") or existing_status.get("prevent_future_followups")):
            # Deleted-from-app items may still get one final kept follow-up, but
            # they should not start another sent-reply tracking cycle afterward.
            return
        target_status = self.infer_status_after_reply_sent(email, target_status_after_send)
        for item in self.pending_reply_checks:
            if item.get("completed") or item.get("cancelled"):
                continue
            if (entry_id and item.get("entry_id") == entry_id) or (conversation_id and item.get("conversation_id") == conversation_id):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Replaced by newer reply draft"
        self.pending_reply_checks.append({
            "entry_id": entry_id,
            "conversation_id": conversation_id,
            "store_id": email.get("store_id", ""),
            "subject": email.get("subject", ""),
            "created_at": datetime.now().isoformat(),
            "target_status_after_send": target_status,
            "category": email.get("category", ""),
            "urgency": email.get("urgency", ""),
            "source": followup_source,
            "completed": False,
            "cancelled": False,
        })
        self._followup_dedup_needed = True  # v3 efficiency: mark dirty.
        self.save_pending_reply_checks()

    def find_sent_reply_for_pending_check(self, pending):
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return None
        conversation_id = pending.get("conversation_id", "")
        if not conversation_id:
            return None
        try:
            created_at = datetime.fromisoformat(pending.get("created_at", "")) - timedelta(seconds=5)
        except Exception:
            created_at = datetime.now() - timedelta(days=1)
        try:
            sent_folder = namespace.GetDefaultFolder(5)  # olFolderSentMail
            items = sent_folder.Items
            items.Sort("[SentOn]", True)
            checked = 0
            for msg in items:
                if checked >= 150:
                    break
                checked += 1
                try:
                    sent_on = msg.SentOn
                    if sent_on and sent_on.replace(tzinfo=None) < created_at:
                        break
                    msg_conversation_id = ""
                    try:
                        msg_conversation_id = msg.ConversationID
                    except Exception:
                        msg_conversation_id = ""
                    if msg_conversation_id and msg_conversation_id == conversation_id:
                        return msg
                except Exception:
                    continue
        except Exception:
            return None
        return None

    def is_sent_message_thank_you_only(self, sent_msg):
        """Skip placeholder creation for simple thank-you/acknowledgement replies.

        Uses the restored Phase 1 Smart Followup intent detector instead of the
        old 7-term/260-char check, so punctuated acknowledgements and common
        short closers do not create unnecessary sent/waiting trackers.
        """
        try:
            subject = ""
            body = ""
            recipient = ""
            try:
                subject = sent_msg.Subject or ""
            except Exception:
                subject = ""
            try:
                body = sent_msg.Body or ""
            except Exception:
                body = ""
            try:
                recipient = sent_msg.To or ""
            except Exception:
                recipient = ""
            intent = analyze_reply_intent(subject=subject, body=body, sender_or_recipient=recipient, source="Sent Items", direction="outbound")
            return bool(intent.get("is_closed_ack"))
        except Exception:
            return False

    def get_sent_msg_time(self, sent_msg):
        try:
            if sent_msg.SentOn:
                return sent_msg.SentOn.replace(tzinfo=None)
        except Exception:
            pass
        return datetime.now()

    def find_existing_email_for_sent_message(self, sent_msg):
        """Find the MaINbox row/thread a sent Outlook message belongs to."""
        conversation_id = ""
        subject_key = ""
        try:
            conversation_id = sent_msg.ConversationID or ""
        except Exception:
            conversation_id = ""
        try:
            subject_key = self._normalized_thread_subject(sent_msg.Subject or "")
        except Exception:
            subject_key = ""
        # v4.1.13: a SUBJECT-ONLY match (no conversation-id agreement) must be distinctive.
        # A brand-new send titled just 'P&A' normalizes identically to every old 'RE: P&A'
        # in the box, so it silently claimed some unrelated thread: that row was flipped to
        # Waiting, no tracker was created, and no coverage could follow. Generic short
        # subjects (no digits, under 10 chars -- 'p&a', 'quote', 'rfq', 'wagos') now only
        # match through the conversation id, which genuine replies always carry.
        if subject_key and len(subject_key) < 10 and not any(c.isdigit() for c in subject_key):
            subject_key = ""
        best = None
        best_seen = -1
        for email in self.emails:
            if email.get("is_sent_waiting_placeholder"):
                continue
            same = False
            if conversation_id and email.get("conversation_id") == conversation_id:
                same = True
            elif subject_key and self._normalized_thread_subject(email.get("subject", "")) == subject_key:
                same = True
            if not same:
                continue
            seen = email.get("received_timestamp", 0) or email.get("sent_timestamp", 0) or 0
            try:
                seen = float(seen)
            except Exception:
                seen = 0
            if best is None or seen > best_seen:
                best = email
                best_seen = seen
        return best

    def sent_message_looks_like_business_tracker(self, sent_msg):
        """Allow brand-new sent RFQ/request emails to create a tracker row."""
        try:
            subject = ""
            body = ""
            try:
                subject = sent_msg.Subject or ""
            except Exception:
                subject = ""
            try:
                body = (sent_msg.Body or "")[:1200]
            except Exception:
                body = ""
            text = f"{subject}\n{body}".lower()
            markers = [
                "quote", "rfq", "request for quote", "price", "pricing",
                "availability", "lead time", "material", "can you quote",
                "please quote", "please provide", "send over", "vendor", "supplier",
                "estimate", "bid", "stock", "qty", "quantity"
            ]
            return any(m in text for m in markers)
        except Exception:
            return False

    def activate_existing_email_after_sent_message(self, email, sent_msg, target_status="Waiting on Vendor"):
        """If user replies from an existing/completed row, wake it up and show Waiting on Vendor."""
        if not email:
            return False
        try:
            # v4.1.16: the user sending a reply from Outlook on a completed/hidden
            # row is an explicit human decision to work the thread again. Record it
            # as such, or the closed guard re-completes the row at the next startup
            # and the wake-up (plus its Waiting tracker) silently disappears.
            _was_closed = self._email_was_closed_before_edit(email)
            changed = False
            if email.get("status") != target_status:
                email["status"] = target_status
                changed = True
            if email.get("urgency") == "Low" or not email.get("urgency"):
                email["urgency"] = "Normal"
                changed = True
            if email.get("category") in ("", "Junk / Ignore"):
                email["category"] = "Vendor / Supplier"
                changed = True
            email["is_new_import"] = False
            email["sent_waiting_tracker_active"] = True
            email["sent_waiting_tracker_updated_at"] = datetime.now().isoformat()
            try:
                email["sent_waiting_tracker_sent_timestamp"] = self.get_sent_msg_time(sent_msg).timestamp()
            except Exception:
                email["sent_waiting_tracker_sent_timestamp"] = datetime.now().timestamp()
            try:
                email["sent_waiting_tracker_sent_entry_id"] = sent_msg.EntryID or ""
            except Exception:
                pass
            try:
                email["sent_waiting_tracker_conversation_index"] = str(getattr(sent_msg, "ConversationIndex", "") or "")
            except Exception:
                pass
            try:
                pa = sent_msg.PropertyAccessor
                email["sent_waiting_tracker_internet_message_id"] = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
            except Exception:
                pass
            # If it was previously removed from MaINbox only, restore visibility.
            entry_id = email.get("entry_id", "")
            if entry_id:
                existing = self.status_data.get(entry_id, {})
                if existing.get("app_deleted"):
                    existing["app_deleted"] = False
                    existing.pop("deleted_from_app_at", None)
                    self.status_data[entry_id] = existing
                    changed = True
            if _was_closed and not self.workflow_record_is_closed(email):
                self._record_explicit_reopen_for_email(email, save=True)
            self.save_record(email)
            return changed
        except Exception:
            return False

    def scan_recent_sent_waiting_trackers(self, max_items=80, lookback_days=10):
        """Scan recent Sent Items so manual Outlook sends also create/update trackers.

        v2.10.8 behavior:
        - If user sends a reply in an existing MaINbox thread, even if it was Completed/Low,
          the existing row becomes Waiting on Vendor unless the sent message is only a thank-you.
        - If user sends a brand-new RFQ/request, a Sent / Waiting placeholder appears in the main list.
        """
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return 0
        changed_count = 0
        cutoff = datetime.now() - timedelta(days=lookback_days)
        _cov_debug(f"=== SENT SCAN start (coverage-debug build) max_items={max_items} lookback_days={lookback_days} cutoff={cutoff.isoformat()} ===")
        processed = set()
        self._begin_commitment_batch()  # v3.8.23: coalesce per-message commitment/cache writes
        try:
            processed = set(getattr(self, "sent_waiting_processed_sent_ids", []) or [])
        except Exception:
            processed = set()
        # v4.1.56: a message sent FROM the shared Sales mailbox is saved into THAT
        # store's Sent Items, which this scan never read (only GetDefaultFolder(5)) --
        # so the send was never seen: no tracker, and therefore no auto quote
        # coverage. Walk BOTH sent folders; per-folder fast-skip state and fault
        # isolation (a broken Sales store can never break the user's own scan).
        _sent_folders = []
        try:
            _own_sent = namespace.GetDefaultFolder(5)  # olFolderSentMail
            if _own_sent is not None:
                _sent_folders.append(("My Sent", _own_sent))
        except Exception:
            pass
        try:
            _sales_sent = self._find_sales_sent_folder_in(namespace)
            if _sales_sent is not None:
                _dup = False
                try:
                    _sid_new = str(getattr(_sales_sent, "EntryID", "") or "")
                    _dup = any(_sid_new and _sid_new == str(getattr(_f, "EntryID", "") or "")
                               for _lbl, _f in _sent_folders)
                except Exception:
                    _dup = False
                if not _dup:
                    _sent_folders.append(("Sales Sent", _sales_sent))
        except Exception:
            pass
        _fold_state = getattr(self, "_sent_tracker_folder_state", None)
        if not isinstance(_fold_state, dict):
            _fold_state = {}
            self._sent_tracker_folder_state = _fold_state
        for _sf_label, sent_folder in _sent_folders:
          try:
              items = sent_folder.Items
              items.Sort("[SentOn]", True)
              # v3.9.93: this scan re-walks and re-reads ~50 recent Sent-item bodies via Outlook
              # COM every periodic tick. The tick runs on the Tk MAIN thread, so when Outlook is
              # slow to fetch those bodies the whole UI freezes for 20-30s -- and it was doing this
              # every cycle EVEN WHEN nothing had been sent since the previous pass. Skip the heavy
              # per-item walk when the Sent folder is unchanged (same item count AND same newest
              # EntryID) since the last pass: with no new sent item there is no new tracker to
              # create, and an incoming reply still clears its tracker when it is imported. Any new
              # (or removed) sent item changes the count or the newest id and runs the full scan,
              # which re-runs the reconcile sweep too. Cheap: Count + one EntryID read, no bodies.
              try:
                  _cur_count = int(getattr(items, "Count", 0) or 0)
              except Exception:
                  _cur_count = -1
              _cur_newest_id = ""
              try:
                  _first_item = items.GetFirst()
                  if _first_item is not None:
                      _cur_newest_id = str(getattr(_first_item, "EntryID", "") or "")
              except Exception:
                  _cur_newest_id = ""
              # v4.1.56: fast-skip state is PER FOLDER now (My Sent / Sales Sent each
              # remember their own count + newest id), and an unchanged folder skips
              # to the NEXT folder instead of returning -- returning here would have
              # made an unchanged My Sent hide a brand-new Sales-mailbox send.
              _prev_count, _prev_newest_id = _fold_state.get(_sf_label, (None, None))
              if (_cur_newest_id and _prev_newest_id is not None
                      and _cur_newest_id == _prev_newest_id and _cur_count == _prev_count):
                  _cov_debug(f"  SENT FOLDER {_sf_label!r} unchanged (count={_cur_count}, newest EntryID stable) -> skip heavy walk this pass")
                  continue
              # New/removed sent item since last pass -- remember this state and do the full scan.
              _fold_state[_sf_label] = (_cur_count, _cur_newest_id)
              try:
                  _fp = ""
                  try:
                      _fp = sent_folder.FolderPath
                  except Exception:
                      _fp = getattr(sent_folder, "Name", "?")
                  _cov_debug(f"  SENT FOLDER scanned: {_fp!r}  total_items={items.Count}")
                  _n = 0
                  for _it in items:
                      try:
                          _cov_debug(f"    newest[{_n}]: subj={getattr(_it, 'Subject', '')!r} sent={self.get_sent_msg_time(_it).isoformat()}")
                      except Exception:
                          pass
                      _n += 1
                      if _n >= 8:
                          break
              except Exception as _e:
                  _cov_debug(f"  SENT FOLDER diag exception: {_e!r}")
              checked = 0
              # v4.1.23 (external audit round 5, finding #16): advance-first GetFirst/GetNext
              # iteration -- this scan routes priced sent messages into Quote Coverage and
              # breaks on an old date, so it must not depend on Python enumeration honoring
              # Items.Sort(). Same pattern as both coverage scans.
              try:
                  _nav_msg = items.GetFirst()
              except Exception:
                  _nav_msg = None
              while _nav_msg is not None:
                  msg = _nav_msg
                  try:
                      _nav_msg = items.GetNext()
                  except Exception:
                      _nav_msg = None
                  if checked >= max_items:
                      break
                  checked += 1
                  try:
                      sent_on = self.get_sent_msg_time(msg)
                      if sent_on < cutoff:
                          break
                      sent_entry_id = ""
                      try:
                          sent_entry_id = msg.EntryID or ""
                      except Exception:
                          sent_entry_id = ""
                      # Re-process existing conversations if needed. v3.8.12: do NOT skip the
                      # whole Sent item just because sent-waiting tracking already handled it;
                      # the ETA/lead-time commitment scanner has its own processed list.
                      already_tracker_processed = bool(sent_entry_id and sent_entry_id in processed)
                      try:
                          msg_subject = getattr(msg, "Subject", "") or ""
                      except Exception:
                          msg_subject = ""
                      try:
                          msg_body = getattr(msg, "Body", "") or ""
                      except Exception:
                          msg_body = ""
                      try:
                          msg_to = getattr(msg, "To", "") or ""
                      except Exception:
                          msg_to = ""
                      reply_intent = analyze_reply_intent(subject=msg_subject, body=msg_body, sender_or_recipient=msg_to, source="Sent Items", direction="outbound")
                      _msg_priced = bool(re.search(r"\$\s*\d|\b\d+\.\d{2}\b", msg_body or ""))
                      if _msg_priced:
                          _cov_debug(f"SENT-PRICED subj={msg_subject!r} sent_on={sent_on.isoformat()} closed_ack={bool(reply_intent.get('is_closed_ack'))} already_processed={already_tracker_processed}")
                      if reply_intent.get("is_closed_ack"):
                          # A pure thank-you makes no tracker -- but a thank-you that carries
                          # line-item pricing is still a quote, so let the coverage hook record it
                          # before we skip the tracker logic for this message. (v3.9.4)
                          if _msg_priced:
                              _cov_debug("  closed-ack BUT priced -> routing to quote coverage hook")
                              try:
                                  _cid = ""
                                  try:
                                      _cid = msg.ConversationID or ""
                                  except Exception:
                                      _cid = ""
                                  self.update_coverage_quoted_from_sent(
                                      conversation_id=_cid, subject=msg_subject, body=msg_body,
                                      sent_entry_id=sent_entry_id, sent_on=sent_on.isoformat(),
                                      source_message_id=outlook_msg_internet_id(msg))
                              except Exception:
                                  pass
                          if sent_entry_id:
                              processed.add(sent_entry_id)
                          # v3.9.70: a pure thank-you/ack closes the loop. Before skipping
                          # tracker creation, close the matching INBOUND thread so it does
                          # not linger as Needs Reply / Waiting after we have acked. Only an
                          # open, non-user-locked row is touched. If that thread is a won/
                          # closed deal in a group, surface the archive Cleanup too (deduped).
                          try:
                              _ex = self.find_existing_email_for_sent_message(msg)
                              if (_ex and not _ex.get("ai_user_locked")
                                      and _ex.get("status") in ("Needs Reply", "Waiting on Customer", "Waiting on Vendor", "New", "")):
                                  _ex["status"] = "Completed"
                                  _ex["ai_triaged_at"] = datetime.now().isoformat()
                                  _ex["ai_triage_pending"] = False
                                  self.save_record(_ex)
                                  try:
                                      if self.get_group_id_for_email(_ex.get("entry_id", "")):
                                          self.load_body_for_rfq(_ex)
                                          _cl, _ph, _kd = self._email_request_is_closed(_ex)
                                          if _cl:
                                              self._assistant_propose_cleanup(_ex, _ph, _kd)
                                  except Exception:
                                      pass
                          except Exception:
                              pass
                          continue

                      existing_email = self.find_existing_email_for_sent_message(msg)
                      created_or_updated = False
                      placeholder = None
                      if already_tracker_processed:
                          # Tracker was already handled by an older refresh; leave statuses alone
                          # but still allow the commitment scanner below to run once.
                          pass
                      elif existing_email:
                          # Use the existing row's direction/category instead of forcing every
                          # sent tracker to Waiting on Vendor. Smart Followup may override when
                          # the sent text explicitly says we are waiting on a vendor/customer.
                          target_status = reply_intent.get("status") if reply_intent.get("is_waiting") else ""
                          if target_status not in ["Waiting on Vendor", "Waiting on Customer"]:
                              target_status = self.infer_status_after_reply_sent(existing_email)
                          if self.activate_existing_email_after_sent_message(existing_email, msg, target_status):
                              created_or_updated = True
                          # Smart Followup learning must reinforce whenever the sent reply
                          # clearly indicates we are waiting on a vendor/customer, even if the
                          # row was already in the correct status (in that case activate_*
                          # returns False, and the old code skipped learning here). The
                          # processed-sent-ID set above guarantees each sent message only
                          # teaches once, so this cannot inflate confidence on repeated scans.
                          if reply_intent.get("is_waiting") and target_status in ("Waiting on Vendor", "Waiting on Customer"):
                              behavior = "wait_for_vendor" if target_status == "Waiting on Vendor" else "wait_for_customer"
                              minutes = VENDOR_NO_RESPONSE_MINUTES if target_status == "Waiting on Vendor" else CUSTOMER_PO_FOLLOWUP_MINUTES
                              self.learn_followup_behavior(existing_email, behavior, minutes, "Smart Followup: sent reply intent is waiting.")
                          # v4.1.13: an RFQ sent by REPLYING inside an existing thread (the most
                          # common real flow -- the customer's request row gets activated as the
                          # tracker, and NO placeholder is made) must also get auto quote coverage.
                          # Same hook, with the activated row standing in as the tracker; all the
                          # usual guards apply inside (Waiting-on-Vendor only, unpriced, no
                          # existing ledger for the group, items must parse).
                          if target_status == "Waiting on Vendor":
                              try:
                                  _tv_cid = ""
                                  try:
                                      _tv_cid = str(msg.ConversationID or "")
                                  except Exception:
                                      _tv_cid = ""
                                  _tv = {
                                      "entry_id": existing_email.get("entry_id", ""),
                                      "status": "Waiting on Vendor",
                                      "subject": msg_subject or existing_email.get("subject", ""),
                                      "conversation_id": _tv_cid or str(existing_email.get("conversation_id", "") or ""),
                                      "sent_entry_id": sent_entry_id,
                                      "received_timestamp": sent_on.timestamp(),
                                  }
                                  self._auto_create_coverage_for_sent_rfq(
                                      _tv, sent_body=msg_body, sent_subject=msg_subject, sent_msg=msg)
                              except Exception:
                                  pass
                          # v3.9.27 duplicate fix: the activated real row IS the tracker now
                          # (status=Waiting + sent_waiting_tracker_* fields). The old code ALSO
                          # created a separate "Sent / Waiting" placeholder here, so every sent
                          # reply in an existing thread showed TWO waiting rows for the same
                          # thing in the main pane. One tracker per thread: real row wins. Any
                          # older saved placeholder for this conversation is retired below in
                          # sync_sent_waiting_placeholders_into_email_list().
                          placeholder = None
                      elif not already_tracker_processed:
                          # Brand-new outgoing RFQ/request that did not start from an imported row.
                          if self.sent_message_looks_like_business_tracker(msg) or reply_intent.get("needs_tracker"):
                              target_status = reply_intent.get("status") if reply_intent.get("status") in ["Waiting on Vendor", "Waiting on Customer"] else "Waiting on Vendor"
                              pending = {
                                  "category": reply_intent.get("category") or "Vendor / Supplier",
                                  "urgency": "Normal",
                                  "subject": msg_subject,
                                  "sent_entry_id": sent_entry_id,
                                  "sent_on": sent_on.isoformat(),
                                  "reply_intent": reply_intent.get("intent", ""),
                              }
                              placeholder = self.make_sent_waiting_placeholder(msg, pending, target_status)
                              if self.add_or_update_sent_waiting_placeholder(placeholder):
                                  created_or_updated = True
                                  # v4.1.11: the tracker is created and (inside add_or_update)
                                  # grouped with its originating request. If that group has no
                                  # coverage ledger yet, create it from the sent RFQ's own item
                                  # list -- full dupe-guards inside; no-op when one exists.
                                  try:
                                      self._auto_create_coverage_for_sent_rfq(
                                          placeholder, sent_body=msg_body, sent_subject=msg_subject, sent_msg=msg)
                                  except Exception:
                                      pass

                      if created_or_updated:
                          changed_count += 1
                      # v3.8.10: scan the sent message for dated commitments (ship/ETA,
                      # quote expiration, backorder, callbacks, payment due, etc.).
                      try:
                          commit_target = existing_email or (placeholder if isinstance(placeholder, dict) else None)
                          if commit_target:
                              scheduled_commitments = self.scan_outlook_message_for_commitments(msg, commit_target, direction="Sent")
                              if scheduled_commitments:
                                  changed_count += scheduled_commitments
                      except Exception:
                          pass
                      # v3.9.1: parse this sent reply for quoted line items and mark them
                      # covered on the matching coverage thread. Self-guards: no-op unless the
                      # thread already has requested items, and dedupes per sent EntryID.
                      try:
                          msg_conv_id = ""
                          try:
                              msg_conv_id = msg.ConversationID or ""
                          except Exception:
                              msg_conv_id = ""
                          # v3.9.54: only run the quote-matcher on a sent message that actually
                          # carries pricing. Without this gate an outgoing RFQ (a request with no
                          # prices) was parsed as a "quote" -- and because no line carries a price,
                          # the no-priced-lines fallback inside update_coverage_quoted_from_sent
                          # kept every parsed line -- wrongly marking the customer's OWN requested
                          # items as Quoted. The other two callers of this hook already gate on price.
                          if re.search(r"\$\s*\d|\b\d+\.\d{2}\b", msg_body or ""):
                              self.update_coverage_quoted_from_sent(
                                  conversation_id=msg_conv_id,
                                  subject=msg_subject,
                                  body=msg_body,
                                  sent_entry_id=sent_entry_id,
                                  sent_on=sent_on.isoformat(),
                                  source_message_id=outlook_msg_internet_id(msg),
                              )
                          # v3.9.4: if this sent item is an OUTGOING request (RFQ you sent out),
                          # move the matching customer's requested items to "Waiting".
                          self.update_coverage_waiting_from_request(
                              subject=msg_subject,
                              body=msg_body,
                              sent_entry_id=sent_entry_id,
                              sent_on=sent_on.isoformat(),
                          )
                      except Exception:
                          pass
                      if sent_entry_id:
                          processed.add(sent_entry_id)
                  except Exception:
                      continue
          except Exception:
            continue

        try:
            self.sent_waiting_processed_sent_ids = list(processed)[-1000:]
        except Exception:
            pass
        # v4.1.12 one-time BACKFILL: every RFQ sent before this feature existed is in
        # sent_waiting_processed_sent_ids, so the per-message loop above will never revisit
        # it -- which is why nothing was auto-created for jobs already in flight. Walk the
        # ACTIVE Waiting-on-Vendor trackers from the last 21 days instead, fetch each sent
        # body by EntryID, and run the same auto-coverage flow (all its guards apply: a job
        # that already has a ledger is untouched, priced sends skip, no items -> no ledger).
        try:
            if (bool(self.settings.get("auto_coverage_from_sent_rfq", True))
                    and isinstance(getattr(self, "quote_coverage", None), dict)
                    and self.quote_coverage.get("auto_coverage_backfill_v3") != 1):
                _bf_cut = datetime.now() - timedelta(days=21)
                _bf_done = 0
                # v4.1.13: candidates are BOTH kinds of tracker -- standalone Sent/Waiting
                # placeholders AND real rows activated as trackers by a reply-in-thread RFQ
                # (v4.1.12 only walked placeholders, missing the most common real flow).
                _bf_cands = []
                for _ph in list(getattr(self, "sent_waiting_placeholders", []) or []):
                    if (isinstance(_ph, dict) and not _ph.get("cleared")
                            and str(_ph.get("status", "") or "") == "Waiting on Vendor"
                            and _ph.get("sent_entry_id")):
                        try:
                            _ts = float(_ph.get("received_timestamp", 0) or 0)
                        except Exception:
                            continue
                        _bf_cands.append((_ph.get("entry_id", ""), str(_ph.get("status", "")),
                                          str(_ph.get("subject", "") or ""),
                                          str(_ph.get("conversation_id", "") or ""),
                                          str(_ph.get("sent_entry_id", "")), _ts))
                for _em in list(getattr(self, "emails", []) or []):
                    if (isinstance(_em, dict) and _em.get("sent_waiting_tracker_active")
                            and not _em.get("is_sent_waiting_placeholder")
                            and str(_em.get("status", "") or "") == "Waiting on Vendor"
                            and _em.get("sent_waiting_tracker_sent_entry_id")):
                        try:
                            _ts = float(_em.get("sent_waiting_tracker_sent_timestamp", 0) or 0)
                        except Exception:
                            continue
                        _bf_cands.append((_em.get("entry_id", ""), "Waiting on Vendor",
                                          str(_em.get("subject", "") or ""),
                                          str(_em.get("conversation_id", "") or ""),
                                          str(_em.get("sent_waiting_tracker_sent_entry_id", "")), _ts))
                for _eid, _st, _subj, _cid, _sid, _ts in _bf_cands:
                    if _bf_done >= 40:
                        break
                    try:
                        if datetime.fromtimestamp(_ts) < _bf_cut:
                            continue
                    except Exception:
                        continue
                    _bmsg = None
                    try:
                        _bmsg = namespace.GetItemFromID(_sid)
                    except Exception:
                        _bmsg = None
                    if _bmsg is None:
                        continue
                    try:
                        _bbody = str(getattr(_bmsg, "Body", "") or "")
                        _bsubj = str(getattr(_bmsg, "Subject", "") or "") or _subj
                    except Exception:
                        continue
                    _bf_done += 1
                    try:
                        self._auto_create_coverage_for_sent_rfq(
                            {"entry_id": _eid, "status": _st, "subject": _bsubj,
                             "conversation_id": _cid, "sent_entry_id": _sid,
                             "received_timestamp": _ts},
                            sent_body=_bbody, sent_subject=_bsubj, sent_msg=_bmsg)
                    except Exception:
                        pass
                self.quote_coverage["auto_coverage_backfill_v3"] = 1
                self.save_quote_coverage()
                _cov_debug(f"AUTO-COVERAGE v3 backfill: examined {_bf_done} tracker(s) (placeholders + activated rows)")
        except Exception:
            pass
        # v3.8.23: close the batch. A scan that detected commitments (or marked a
        # message processed) set _commitment_batch_cache_dirty; combined with the
        # changed_count save below this resolves to a single save_cached_state().
        batch_touched_cache = bool(getattr(self, "_commitment_batch_cache_dirty", False))
        if changed_count:
            self.sync_sent_waiting_placeholders_into_email_list()
            self.flush_status_data()
            self.save_sent_waiting_placeholders()
            self._commitment_batch_cache_dirty = True  # fold the tracker's own cache save into the flush
        self._flush_commitment_batch()
        if not changed_count and batch_touched_cache:
            # commitments were created but no tracker change; flush already wrote cache.
            pass
        # v3.8.38: Sent Items are scanned AFTER the inbox, so a reply imported earlier in the
        # same cycle can miss its just-created tracker (the per-message clear only fires while
        # the reply is being imported, after which it ages out of the incremental scan window).
        # Reconcile every loaded reply against the trackers so a received response always
        # clears its tracker, regardless of scan ordering.
        cleared_count = self.reconcile_sent_waiting_placeholders_against_replies()
        return changed_count + cleared_count

    def coverage_inbox_folders_for_quote_scan(self, namespace=None):
        """Return all inbound folders that can receive vendor quotes.

        The first v3.9.4 scanner only looked at the default Inbox. In real use, vendor
        quote replies may land in the shared Sales mailbox, so coverage stayed at Waiting
        even though the reply was imported elsewhere in MaINbox. Keep this folder list
        narrow (My Inbox + Sales Inbox) and dedupe by EntryID/FolderPath to avoid double scans.
        """
        folders = []
        seen = set()

        def add_folder(folder, label):
            if not folder:
                return
            try:
                key = str(getattr(folder, "EntryID", "") or "")
            except Exception:
                key = ""
            if not key:
                try:
                    key = str(getattr(folder, "FolderPath", "") or getattr(folder, "Name", "") or label)
                except Exception:
                    key = label
            if key in seen:
                return
            seen.add(key)
            folders.append((label, folder))

        try:
            if namespace:
                add_folder(namespace.GetDefaultFolder(6), "My Inbox")  # olFolderInbox
        except Exception:
            pass
        try:
            # v3.9.85: was self.find_sales_inbox_folder_safe(), which reads self.namespace --
            # a COM object bound to the Tk MAIN-thread apartment. This method runs on the
            # background quote-scan worker (scan_recent_inbox_for_quotes -> here), so touching
            # the main-thread namespace raised RPC_E_WRONG_THREAD (0x8001010e) and intermittently
            # took the whole process down ("MaINbox just closed by itself"). fresh_outlook()
            # already handed us a thread-local `namespace`; resolve Sales through the worker-safe
            # variant, which never touches self.namespace. (My Inbox above already uses the passed
            # namespace correctly; both callers of this method pass a fresh_outlook() namespace.)
            if namespace:
                add_folder(self._find_sales_inbox_folder_in(namespace), "Sales Inbox")
        except Exception:
            pass
        return folders

    def _attachment_quote_text_from_msg(self, msg, max_atts=10):
        """Extract text from a live Outlook message's DOCUMENT attachments (PDF, Excel,
        CSV, Word, text) so a vendor quote sent as a PDF can be read for Quote Coverage.
        Returns concatenated text, or '' when there are no document attachments or on any
        failure. Reuses the same temp-save + best-effort text/OCR path the RFQ scanner
        uses, and always cleans up its temp folder. A cheap extension pass runs first so
        no temp folder is created unless a real document is actually attached.

        v3.9.91: a delivered message's attachments never change, so the coverage scan reads
        each message's PDFs/Excels ONCE per run instead of re-saving and re-parsing them on
        every 90s/180s pass -- that repeated parse churn was the avoidable load in the coverage
        logs. Only SUCCESSFUL (non-empty) extractions are cached, keyed by EntryID (stable within
        a session); an empty/failed parse is never cached, so it is retried and a transient blip
        can't permanently drop a vendor quote. The cache is bounded and clears on restart.
        """
        # v4.1.27 (external audit round 9, blocker #4): per-attachment INTEGRITY tracking,
        # same model the customer-request scan has had since v4.1.20. Any eligible
        # document that fails to save, raises during parse, yields no text, or sits
        # beyond the attachment cap sets _vendor_attach_last_failed -- callers must then
        # treat the extraction as INCOMPLETE: rows parsed from the surviving siblings may
        # be stored, but the message is not marked processed and an empty parse is never
        # treated as authoritative.
        self._vendor_attach_last_failed = False
        self._vendor_attach_failed_names = []   # v4.1.28: which files could not be read
        cache = getattr(self, "_attachment_text_cache", None)
        if cache is None:
            cache = self._attachment_text_cache = {}
        _ck = ""
        try:
            _ck = str(getattr(msg, "EntryID", "") or "")
        except Exception:
            _ck = ""
        if _ck and _ck in cache:
            return cache[_ck]   # cached results are COMPLETE extractions only (see below)
        try:
            atts = msg.Attachments
            count = int(getattr(atts, "Count", 0) or 0)
        except Exception:
            self._vendor_attach_last_failed = True   # attachments unreadable != no attachments
            return ""
        if count <= 0:
            return ""
        doc_exts = (".pdf", ".xlsx", ".xls", ".csv", ".doc", ".docx", ".txt", ".rtf")
        candidates = []
        for i in range(1, count + 1):
            try:
                att = atts.Item(i)
                fname = safe_filename_piece(getattr(att, "FileName", "") or f"attachment_{i}", f"attachment_{i}")
                if os.path.splitext(fname)[1].lower() not in doc_exts:
                    continue
                if outlook_attachment_is_inline(att):
                    continue
                if len(candidates) >= max_atts:
                    # v4.1.27: an eligible document BEYOND the cap was never read --
                    # that is an incomplete extraction, not a clean skip.
                    self._vendor_attach_last_failed = True
                    self._vendor_attach_failed_names.append(fname + " (beyond attachment cap)")
                    break
                candidates.append((att, fname))
            except Exception:
                self._vendor_attach_last_failed = True
                continue
        if not candidates:
            return ""
        text_parts = []
        temp_root = ""
        try:
            temp_root = tempfile.mkdtemp(prefix="mainbox_cov_")
            for att, fname in candidates:
                try:
                    path = os.path.join(temp_root, fname)
                    att.SaveAsFile(path)
                    if not os.path.exists(path):
                        self._vendor_attach_last_failed = True   # save silently produced nothing
                        self._vendor_attach_failed_names.append(fname + " (save produced no file)")
                        continue
                    t = read_text_from_file_best_effort(path)
                    if t and t.strip():
                        # v4.1.30 (external audit round 12, finding #1): NONEMPTY output
                        # that is extractor FAILURE PROSE ("No text could be extracted
                        # from this page", parse-error banners, '####' noise) is an
                        # INDETERMINATE read, not a successful one. The v4.1.29 rule
                        # already kept stored rows safe, but because the helper reported
                        # 'complete', the retry ledger never advanced and the message
                        # rescanned forever without ever reaching Attachment Review.
                        # Marker-based only (no density heuristics here: a legitimate
                        # price table is number-heavy and must not be misflagged).
                        if _COVERAGE_PARSE_FAILURE_MARKERS.search(t[:3000]):
                            self._vendor_attach_last_failed = True
                            self._vendor_attach_failed_names.append(fname + " (extractor returned failure text)")
                        else:
                            text_parts.append("\n--- Attachment: %s ---\n%s" % (fname, t[:18000]))
                    else:
                        # v4.1.27: an eligible document that yields NO text is indeterminate
                        # (image-only PDF whose OCR failed, protected file, unsupported
                        # layout) -- never proof it holds no quote.
                        self._vendor_attach_last_failed = True
                        self._vendor_attach_failed_names.append(fname + " (no text extracted)")
                except Exception:
                    self._vendor_attach_last_failed = True
                    self._vendor_attach_failed_names.append(fname + " (save/parse exception)")
                    continue
        except Exception:
            self._vendor_attach_last_failed = True
            return ""
        finally:
            try:
                if temp_root and os.path.isdir(temp_root):
                    shutil.rmtree(temp_root, ignore_errors=True)
            except Exception:
                pass
        _res = "\n".join(text_parts)
        # v4.1.30 (round 12): STRUCTURED OUTCOME for callers -- the shape the auditor
        # has asked for across three rounds, populated from the per-file tracking above.
        self._vendor_attach_last_result = {
            "complete": not self._vendor_attach_last_failed,
            "files_failed": list(self._vendor_attach_failed_names),
            "chars": len(_res),
            "files_read": len(text_parts),
        }
        if _ck and _res and not self._vendor_attach_last_failed:
            # Cache COMPLETE successful extractions only -- caching a partial result would
            # make every retry return the partial set without re-attempting the failed file.
            try:
                if len(cache) >= 800:
                    cache.clear()
                cache[_ck] = _res
            except Exception:
                pass
        return _res

    def _coverage_materials_from_msg_attachments(self, msg, include_images=True, source_label=""):
        """v4.1.18: extract LINE ITEMS from a live Outlook message's attachments for
        Quote Coverage -- documents (PDF/Excel/Word/CSV/text) AND pictures: attached
        photos or screenshots PASTED INTO THE BODY (Outlook stores those as inline
        image attachments with a content-id, which the older inline detector skipped
        as signature noise; here any image >= COVERAGE_IMAGE_MIN_BYTES counts as real
        content, so a screenshot of a material list is read while logos are not).

        Extraction ladder per file (all existing, battle-tested machinery):
          1. extract_structured_materials_from_saved_attachment -- structured
             Excel/PDF-table parse with header mapping; falls through internally to
             read_text_from_file_best_effort (PyMuPDF -> pdfplumber -> pypdf ->
             Tesseract OCR; images OCR'd directly) + flat-text row parsing.
          2. If that yields nothing: raw text -> extract_materials_from_quote_text
             over the columnar-reassembled text.

        Returns normalized material dicts (each tagged source_file). Successful
        (non-empty) results are cached per EntryID for the session -- a delivered
        message's attachments never change, so OCR runs at most once per message.
        Fail-soft everywhere: any COM/parse error just skips that file."""
        self._coverage_attach_last_save_failed = False
        # v4.1.31: structured decision consumed by the customer-request scan.
        self._coverage_intake_last_result = {
            "decision": "bypass", "document_role": "unknown",
            "review_reason": "", "metrics": {}, "warnings": [],
            "engine_available": bool(COVERAGE_INTAKE_ENGINE_AVAILABLE),
        }
        # v4.1.22 (external audit round 4, finding #8): parse EXCEPTIONS after a successful
        # save are tracked like save failures -- one attachment parsing while another dies
        # mid-extraction must not let the message complete silently.
        self._coverage_attach_last_parse_failed = False
        # v4.1.23 (round 5, finding #11): oversized / cap-deferred material was silently
        # treated as an empty parse; the flag routes it to Attachment Review instead.
        self._coverage_attach_last_skipped_material = False
        cache = getattr(self, "_coverage_attach_mats_cache", None)
        if cache is None:
            cache = self._coverage_attach_mats_cache = {}
        _ck = ""
        try:
            _ck = str(getattr(msg, "EntryID", "") or "")
        except Exception:
            _ck = ""
        if _ck and _ck in cache:
            return [dict(m) for m in cache[_ck]]
        try:
            atts = msg.Attachments
            count = int(getattr(atts, "Count", 0) or 0)
        except Exception:
            return []
        if count <= 0:
            return []
        docs = []
        imgs = []
        for i in range(1, min(count, 20) + 1):
            try:
                att = atts.Item(i)
                fname = safe_filename_piece(getattr(att, "FileName", "") or f"attachment_{i}", f"attachment_{i}")
                ext = os.path.splitext(fname)[1].lower()
                try:
                    size = int(getattr(att, "Size", 0) or 0)
                except Exception:
                    size = 0
                if size > COVERAGE_ATTACH_MAX_FILE_BYTES:
                    _cov_debug(f"ATTACH-ITEMS {source_label} skip oversized {fname!r} ({size} bytes)")
                    self._coverage_attach_last_skipped_material = True  # v4.1.23 finding #11
                    continue
                if ext in COVERAGE_ATTACHMENT_DOC_EXTS:
                    docs.append((att, fname, size))
                elif include_images and ext in COVERAGE_ATTACHMENT_IMG_EXTS and size >= COVERAGE_IMAGE_MIN_BYTES:
                    # Inline OR attached: a screenshot pasted into the body is exactly
                    # the content this feature exists for. The size floor excludes
                    # signature logos/dividers/trackers from OCR.
                    imgs.append((att, fname, size))
            except Exception:
                continue
        if len(docs) > COVERAGE_ATTACH_MAX_DOCS or len(imgs) > COVERAGE_ATTACH_MAX_IMAGES:
            self._coverage_attach_last_skipped_material = True  # v4.1.23: cap-deferred files
            _cov_debug(f"ATTACH-ITEMS {source_label}: {max(0, len(docs) - COVERAGE_ATTACH_MAX_DOCS)} doc(s) / "
                       f"{max(0, len(imgs) - COVERAGE_ATTACH_MAX_IMAGES)} image(s) beyond caps -- flagged for review")
        docs = docs[:COVERAGE_ATTACH_MAX_DOCS]
        imgs = imgs[:COVERAGE_ATTACH_MAX_IMAGES]
        # v4.1.20 (external audit round 2, finding #1): PER-ATTACHMENT save tracking.
        # v4.1.19 only flagged a failure when NO attachment saved -- so a logo that saved
        # fine masked the material-list PDF whose SaveAsFile failed, and after the empty-
        # parse retries the message was marked processed with the PDF never inspected.
        # The flag now means "at least one ELIGIBLE attachment could not be saved"; the
        # caller must not mark the message done while it is set, and partial results are
        # NOT session-cached so the failed file is genuinely re-attempted on retry.
        self._coverage_attach_last_save_failed = False
        if not docs and not imgs:
            return []
        mats = []
        saved_ct = 0
        failed_ct = 0
        temp_root = ""
        try:
            temp_root = tempfile.mkdtemp(prefix="mainbox_cov_req_")
            for _fidx, (att, fname, size) in enumerate(docs + imgs, start=1):
                try:
                    # v4.1.18 audit: index prefix so two attachments with the SAME filename
                    # (common with image001.png) cannot overwrite each other in the temp dir.
                    path = os.path.join(temp_root, f"{_fidx:02d}_{fname}")
                    try:
                        att.SaveAsFile(path)
                    except Exception:
                        failed_ct += 1
                        _cov_debug(f"ATTACH-ITEMS {source_label} SAVE FAILED for {fname!r}")
                        continue
                    if not os.path.exists(path):
                        failed_ct += 1
                        _cov_debug(f"ATTACH-ITEMS {source_label} save produced no file for {fname!r}")
                        continue
                    saved_ct += 1
                    items = []
                    _parse_exc = 0
                    try:
                        items = extract_structured_materials_from_saved_attachment(path, fname, keep_duplicates=True) or []
                    except Exception:
                        items = []
                        _parse_exc += 1
                    if not items:
                        try:
                            t = read_text_from_file_best_effort(path) or ""
                            if t.strip():
                                items = extract_materials_from_quote_text(
                                    _coverage_reassemble_columnar_quote(t), keep_duplicates=True) or []
                        except Exception:
                            items = []
                            _parse_exc += 1
                    if _parse_exc >= 2 or (_parse_exc and not items):
                        # Both extraction ladders raised (or the only one tried raised and
                        # produced nothing): this file was never actually read.
                        self._coverage_attach_last_parse_failed = True
                        _cov_debug(f"ATTACH-ITEMS {source_label} PARSE FAILED for {fname!r}")
                    kept = 0
                    for it in items:
                        if isinstance(it, dict):
                            it.setdefault("source_file", fname)
                            mats.append(it)
                            kept += 1
                    _cov_debug(f"ATTACH-ITEMS {source_label} file={fname!r} size={size} -> {kept} item(s)")
                except Exception:
                    continue
        except Exception:
            self._coverage_attach_last_save_failed = True
            return []
        finally:
            try:
                if temp_root and os.path.isdir(temp_root):
                    shutil.rmtree(temp_root, ignore_errors=True)
            except Exception:
                pass
        if failed_ct > 0:
            self._coverage_attach_last_save_failed = True
            _cov_debug(f"ATTACH-ITEMS {source_label}: {failed_ct} of {saved_ct + failed_ct} eligible attachment(s) failed to save -- caller must not mark this message done")
        mats = normalize_material_items(mats, keep_duplicates=True)[:150]
        # v4.1.31: WHOLE-DOCUMENT + POSITIVE-ROW gate.  Existing OCR/SmartScan
        # extraction remains unchanged; this engine decides whether those candidates
        # are safe customer-request rows, a commercial/internal document to reject,
        # or an ambiguous result to quarantine for Attachment Review.
        try:
            _engine_enabled = bool((getattr(self, "settings", {}) or {}).get("coverage_intake_engine_enabled", True))
        except Exception:
            _engine_enabled = True
        # v4.1.35 (F5): the intake engine judges CUSTOMER-REQUEST extraction only.
        # Since v4.1.31 it also ran on the sent-RFQ path, where the sender is our own
        # address, so the internal-sender veto silently emptied every sent-RFQ
        # attachment ingestion. The sent path is the user's own deliberate action --
        # the contamination class this engine guards against does not apply there.
        _intake_applies = (source_label == "customer-request")
        if _intake_applies and _engine_enabled and COVERAGE_INTAKE_ENGINE_AVAILABLE and _COVERAGE_INTAKE_ENGINE is not None:
            try:
                try:
                    _ctx_subject = str(getattr(msg, "Subject", "") or "")
                except Exception:
                    _ctx_subject = ""
                try:
                    _ctx_body = str(getattr(msg, "Body", "") or "")[:8000]
                except Exception:
                    _ctx_body = ""
                try:
                    _ctx_sender = str(self.get_sender_email(msg) or "")
                except Exception:
                    _ctx_sender = ""
                try:
                    _ctx_sender_name = str(getattr(msg, "SenderName", "") or "")
                except Exception:
                    _ctx_sender_name = ""
                try:
                    _ctx_conv = str(getattr(msg, "ConversationID", "") or "")
                except Exception:
                    _ctx_conv = ""
                _ctx_type = ""
                try:
                    _saved_row = self.get_email_by_id(_ck) or {}
                    _ctx_type = normalize_email_type_code((_saved_row or {}).get("email_type", ""))
                except Exception:
                    _ctx_type = ""
                try:
                    _internal_domains = tuple(sorted(self._own_mailbox_domains(getattr(self, "namespace", None))))
                except Exception:
                    _internal_domains = ()
                _source_files = ", ".join([str(x[1]) for x in (docs + imgs)])
                _intake = _COVERAGE_INTAKE_ENGINE.evaluate_customer_request(
                    mats,
                    IntakeContext(
                        subject=_ctx_subject, body=_ctx_body, sender_email=_ctx_sender,
                        sender_name=_ctx_sender_name, sender_type=_ctx_type,
                        internal_domains=_internal_domains, source_file=_source_files,
                        message_id=_ck, conversation_id=_ctx_conv,
                    ),
                )
                self._coverage_intake_last_result = _intake.to_dict()
                self._coverage_intake_last_result["engine_available"] = True
                if _intake.decision == IntakeDecision.ACCEPT:
                    mats = normalize_material_items(_intake.accepted_items, keep_duplicates=True)[:150]
                else:
                    mats = []
                _cov_debug(
                    f"COVERAGE-INTAKE {source_label}: decision={_intake.decision.value} "
                    f"role={_intake.document_role.value} candidates={_intake.metrics.get('candidate_rows', 0)} "
                    f"accepted={_intake.metrics.get('accepted_rows', 0)} reason={_intake.review_reason!r}"
                )
            except Exception as _intake_exc:
                # v4.1.35 (E1): FAIL CLOSED. The protection was enabled and errored --
                # committing rows through the legacy parser is exactly the contamination
                # path the engine exists to stop. Quarantine to Attachment Review; the
                # Review entry names the cause and Retry re-attempts after a fix.
                self._coverage_intake_last_result = {
                    "decision": "quarantine", "document_role": "unknown",
                    "review_reason": f"Coverage Intake Engine error (rows quarantined, not committed): {_intake_exc}",
                    "metrics": {}, "warnings": [], "engine_available": True,
                }
                mats = []
                _cov_debug(f"COVERAGE-INTAKE FAIL-CLOSED after engine error: {_intake_exc!r}")
        elif _intake_applies and _engine_enabled and not COVERAGE_INTAKE_ENGINE_AVAILABLE:
            # v4.1.35 (E1): FAIL CLOSED. The setting says the intake safety engine is
            # ON but the module is missing/old/broken -- do NOT fall back to the parser
            # that caused the Bid-document contamination. Quarantine instead.
            self._coverage_intake_last_result = {
                "decision": "quarantine", "document_role": "unknown",
                "review_reason": ("Coverage Intake Engine unavailable (rows quarantined, not committed): "
                                  + str(_COVERAGE_INTAKE_IMPORT_ERROR or "module missing")),
                "metrics": {}, "warnings": [], "engine_available": False,
            }
            mats = []
            _cov_debug("COVERAGE-INTAKE FAIL-CLOSED: engine unavailable; rows quarantined")
        # Cache ONLY complete ACCEPTED extractions.  Rejected/quarantined documents
        # must not be cached as material lists.
        # retry return the partial set without ever re-attempting the failed file.
        # v4.1.22: a parse exception is incomplete too.
        if _ck and mats and failed_ct == 0 and not getattr(self, "_coverage_attach_last_parse_failed", False):
            try:
                if len(cache) >= 400:
                    cache.clear()
                cache[_ck] = [dict(m) for m in mats]
            except Exception:
                pass
        return mats

    def scan_recent_inbox_for_quotes(self, max_items=150, lookback_days=14):
        """v3.9.5: Vendor pricing arrives inbound -- in My Inbox OR shared Sales Inbox.
        Scan both folders for priced vendor replies; any priced reply whose line items match a
        coverage record's requested items flips those items to Quoted. Linking/gating is handled
        by update_coverage_quoted_from_sent, so this remains conservative and idempotent."""
        self._last_quote_scan_folder_errors = []   # v4.1.28 (round 10, blocker #4)
        self._last_quote_scan_health = []          # v4.1.30 (round 12, finding #5)
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            self._last_quote_scan_folder_errors.append("Outlook namespace unavailable")
            return 0
        marked = 0
        # v3.9.74: only pay to read PDF/Excel attachments when coverage is actually in use
        # (some thread still has requested items). Cheap one-time check before the folder walk.
        threads_now = (getattr(self, "quote_coverage", {}) or {}).get("threads", {})
        open_cov = any(isinstance(r, dict) and r.get("requested") for r in threads_now.values())
        cutoff = datetime.now() - timedelta(days=lookback_days)
        _cov_debug(f"=== INBOX QUOTE SCAN start max_items={max_items} lookback_days={lookback_days} cutoff={cutoff.isoformat()} ===")
        folders = self.coverage_inbox_folders_for_quote_scan(namespace)
        if not folders:
            _cov_debug("INBOX QUOTE SCAN: no inbound folders available")
            return 0
        seen_message_ids = set()
        # v4.1.26 (round 8, defect #3): SAFE negative-decision cache. Content-permanent
        # non-candidates only: a message with no price in its body, no attachments, and
        # nothing quote-ish in subject/body can NEVER become a vendor quote, so it is
        # checkpointed and skipped for free on every later pass. Messages that carry
        # prices or attachments but don't currently link stay retryable (coverage
        # records come and go; update_coverage_quoted_from_sent stays the gatekeeper).
        _qneg = self.quote_coverage.setdefault("quote_scan_negative", {}) if isinstance(getattr(self, "quote_coverage", None), dict) else {}
        if not isinstance(_qneg, dict):
            _qneg = self.quote_coverage["quote_scan_negative"] = {}
        _qneg_dirty = False
        for folder_label, inbox in folders:
            # v4.1.54: the shared Sales mailbox holds EVERY salesperson's mail. Only the
            # user's own inbox is unconditionally theirs; any other inbound folder (the
            # Sales Inbox) must carry the selected sales category tag before its mail is
            # ingested -- the same rule the main import has always applied. Without this,
            # a colleague's tagged message (e.g. TR while running as SB) had its
            # attachments read and could be queued into Attachment Review.
            _sales_cat_gate = (folder_label != "My Inbox")
            try:
                try:
                    folder_path = str(getattr(inbox, "FolderPath", "") or getattr(inbox, "Name", "") or folder_label)
                except Exception:
                    folder_path = folder_label
                _cov_debug(f"INBOX QUOTE SCAN folder={folder_label!r} path={folder_path!r}")
                items = inbox.Items
                # v3.9.6: trim to the recent window BEFORE reading any message bodies, so a large
                # or uncached shared mailbox isn't fully walked (150+ body reads) on every scan.
                # Restrict can fail on some stores/providers -> fall back to the full collection.
                try:
                    _cut_str = cutoff.strftime("%m/%d/%Y %I:%M %p")
                    items = items.Restrict(f"[ReceivedTime] >= '{_cut_str}'")
                except Exception:
                    pass
                # v4.1.26 (round 8, defect #3): PERSISTENT ALTERNATING CURSOR, same design
                # as the customer-request scan (v4.1.25). A pass that stops at a cap
                # records the oldest position it reached; passes alternate between new
                # mail (top) and backfill continuation (below the cursor), so a vendor
                # quote at position 151 of a busy shared inbox is reached on the next
                # pass instead of being starved forever. Cursor clears when a backfill
                # pass reaches the cutoff (window fully traversed).
                _qcursors = self.quote_coverage.setdefault("quote_scan_cursors", {})
                if not isinstance(_qcursors, dict):
                    _qcursors = self.quote_coverage["quote_scan_cursors"] = {}
                _qcur = _qcursors.get(folder_label) if isinstance(_qcursors.get(folder_label), dict) else {}
                _backfill = bool(_qcur.get("backfill_next")) and bool(str(_qcur.get("oldest_reached", "") or ""))
                _boundary_skip = set()
                if _backfill:
                    try:
                        # v4.1.27 (round 9, blocker #2): the cursor is MINUTE-precision
                        # (Outlook Restrict granularity), so a strict '<' permanently
                        # skipped any message received in the SAME minute as the cursor
                        # but below the cap. Backfill now includes the boundary minute
                        # (< cursor + 1 minute) and free-skips the messages already
                        # processed IN that minute via their recorded EntryIDs.
                        _b_edge = _qcur["oldest_reached"]
                        try:
                            _b_dt = datetime.strptime(_b_edge, "%m/%d/%Y %I:%M %p") + timedelta(minutes=1)
                            _b_edge = _b_dt.strftime("%m/%d/%Y %I:%M %p")
                            _boundary_skip = set(_qcur.get("boundary_ids", []) or [])
                        except Exception:
                            pass   # unparseable stored cursor -> legacy strict behavior
                        items = items.Restrict(f"[ReceivedTime] < '{_b_edge}'")
                        _cov_debug(f"INBOX QUOTE SCAN cursor: backfill pass below {_b_edge!r} (boundary-inclusive, {len(_boundary_skip)} id(s) pre-done) in {folder_label!r}")
                    except Exception:
                        _backfill = False
                try:
                    items.Sort("[ReceivedTime]", True)
                except Exception:
                    pass
                # v4.1.26 (round 8, defect #3): 'checked' now counts only CANDIDATES
                # (priced body, or attachment-bearing quote-ish mail) -- routine
                # correspondence no longer consumes the scan window. 'walked' caps novel
                # examinations; 'raw_walked' is the ultimate COM-traffic safety cap.
                checked = 0
                walked = 0
                raw_walked = 0
                _hit_cap = False
                _last_recv = None
                _minute_key = None
                _minute_ids = []   # v4.1.27: EntryIDs seen in the CURRENT minute (newest-first walk)
                # v4.1.22 (finding #15): same advance-first GetFirst/GetNext iteration as
                # the customer-request scan, replacing direct enumeration after Sort().
                try:
                    _nav_msg = items.GetFirst()
                except Exception:
                    _nav_msg = None
                # v4.1.29 (round 11, finding #3): free-skipping remembered boundary
                # messages must not consume the raw-COM allowance that exists to bound
                # REAL work (body reads, attachment parses) -- otherwise a backfill pass
                # into a huge same-minute burst spends its whole budget re-skipping what
                # it already did and never advances (auditor's 5,200-burst repro). The
                # raw cap is extended by exactly the boundary-set size: skips are cheap
                # GetNext calls, so the true COM ceiling is 5000 + |boundary| (boundary <= 20000, so <= 25000)
                # navigations with the same 5000-real-message work bound as before.
                _raw_cap = 5000 + len(_boundary_skip)
                while _nav_msg is not None:
                    msg = _nav_msg
                    try:
                        _nav_msg = items.GetNext()
                    except Exception:
                        _nav_msg = None
                    raw_walked += 1
                    if checked >= max_items or walked >= 1000 or raw_walked >= _raw_cap:
                        _hit_cap = True
                        break
                    try:
                        try:
                            recv_dt = msg.ReceivedTime.replace(tzinfo=None)
                        except Exception:
                            recv_dt = None
                        if recv_dt is not None and recv_dt < cutoff:
                            break
                        if recv_dt is not None:
                            _last_recv = recv_dt
                        try:
                            entry_id = msg.EntryID or ""
                        except Exception:
                            entry_id = ""
                        # v4.1.27 (round 9, blocker #2): remember which messages live in the
                        # minute we may stop in, so a boundary-inclusive backfill can skip
                        # exactly them without re-consuming the window.
                        # v4.1.28 (round 10, blocker #3): stored as 16-hex SHA1 HASHES with
                        # a 5000 cap (~80 KB worst case) instead of 500 full EntryIDs --
                        # the old cap stalled traversal at ~650 messages in one minute
                        # because the boundary memory could not grow past 500. 5000 matches
                        # the raw-COM work bound: a burst the scanner can physically walk,
                        # the cursor can remember (20000-hash memory, ~360 KB only when a
                        # minute actually bursts). Beyond that is beyond any per-pass budget BY DESIGN (Outlook Restrict is minute-granular, so a
                        # seconds+ID compound cursor is not implementable at the API level;
                        # the boundary-ID set IS the tie-breaker) -- and the overflow is
                        # LOGGED rather than silent.
                        _bh = ""
                        if entry_id:
                            _bh = hashlib.sha1(str(entry_id).encode("utf-8", "ignore")).hexdigest()[:16]
                        if recv_dt is not None and _bh:
                            _mk = recv_dt.strftime("%m/%d/%Y %I:%M %p")
                            if _mk != _minute_key:
                                _minute_key = _mk
                                _minute_ids = []
                            if len(_minute_ids) < 20000:
                                _minute_ids.append(_bh)
                            elif len(_minute_ids) == 20000:
                                _minute_ids.append("__overflow__")  # sentinel: record once
                                # v4.1.30 (round 12, finding #5): _cov_debug is OFF in
                                # production, so saturation must surface through channels
                                # the user actually sees: the scan-health list (shown in
                                # the Full Update summary) and a persisted note in the
                                # coverage ledger (shown in the coverage status label).
                                _note = (f"Mail burst: minute {_mk} holds over 20,000 messages; the scan cannot "
                                         f"guarantee reaching every message in that minute. Anything missed can be "
                                         f"linked manually from Quote Coverage.")
                                try:
                                    self._last_quote_scan_health.append(_note)
                                except Exception:
                                    pass
                                try:
                                    _sh = self.quote_coverage.setdefault("scan_health", [])
                                    if isinstance(_sh, list):
                                        _sh.append({"at": datetime.now().isoformat(), "note": _note})
                                        if len(_sh) > 50:
                                            del _sh[:len(_sh) - 50]
                                        _qneg_dirty = True
                                except Exception:
                                    pass
                                _cov_debug(f"INBOX QUOTE SCAN: {_note}")
                        if entry_id and entry_id in seen_message_ids:
                            continue
                        if entry_id:
                            seen_message_ids.add(entry_id)
                        if entry_id and (_bh in _boundary_skip or entry_id in _boundary_skip):
                            continue   # v4.1.27: already processed in the boundary minute
                                       # (raw-EntryID check keeps pre-v4.1.28 cursors working)
                        # Free skip: examined on an earlier pass and content-permanently
                        # not a candidate (no price, no attachments, nothing quote-ish).
                        if entry_id and int(_qneg.get(entry_id, -1)) == COVERAGE_QUOTE_GATE_VERSION:
                            continue
                        # v4.1.54: Sales-Inbox messages must be tagged with the selected
                        # sales category before ANY ingestion work (body read, attachment
                        # parse, coverage flip, Attachment Review queue). Deliberately NOT
                        # checkpointed in the negative cache: category tags are mutable,
                        # so a message tagged for this user later becomes visible on the
                        # next pass. One cheap COM property read; happens before the
                        # 'walked' budget so a colleague-heavy Sales Inbox cannot starve
                        # the user's own scan window.
                        if _sales_cat_gate:
                            try:
                                _msg_cats = msg.Categories or ""
                            except Exception:
                                _msg_cats = ""
                            if not self.email_has_outlook_category(_msg_cats, self.selected_sales_category):
                                continue
                        walked += 1
                        try:
                            body = msg.Body or ""
                        except Exception:
                            body = ""
                        try:
                            subj = msg.Subject or ""
                        except Exception:
                            subj = ""
                        has_price = bool(re.search(r"\$\s*\d|\b\d+\.\d{2}\b", body))
                        _quoteish = bool(_COVERAGE_QUOTEISH_RE.search((subj + " " + body).lower()))
                        try:
                            _has_attach = int(getattr(msg.Attachments, "Count", 0) or 0) > 0
                        except Exception:
                            _has_attach = False
                        try:
                            conv_id = msg.ConversationID or ""
                        except Exception:
                            conv_id = ""
                        # v4.1.26 (round 8, defect #4): a reply whose CONVERSATION links to
                        # an open coverage record qualifies for the attachment read even
                        # with no keyword at all -- the vendor who answers "Attached." on
                        # the RFQ thread is exactly the quote this scan exists to catch.
                        _conv_linked = False
                        if _has_attach and not _quoteish and open_cov and conv_id:
                            try:
                                if self._coverage_group_id_for_conversation(conv_id):
                                    _conv_linked = True
                                else:
                                    _tk = self.coverage_thread_key(conv_id, subj)
                                    _lr = self.get_coverage_record(_tk, create=False) if _tk else None
                                    _conv_linked = bool(_lr and _lr.get("requested"))
                            except Exception:
                                _conv_linked = False
                        # v3.9.74: vendor quotes often arrive as a PDF/Excel with NO price in the
                        # email body, so the old body-price pre-filter dropped them entirely. When
                        # coverage is in use and the message reads like a quote (or its thread is
                        # linked to a coverage record), pull text from its document attachments so
                        # those line items can flip requested -> Quoted. Body-priced mail keeps its
                        # fast path; attachment text is added on top.
                        attach_text = ""
                        _att_incomplete = False
                        if open_cov and _has_attach and (_quoteish or has_price or _conv_linked):
                            # v4.1.27 (round 9, blocker #4): bounded retry for messages whose
                            # attachments keep failing -- after 5 failed passes the message
                            # goes to Attachment Review (visible work) instead of silently
                            # consuming every future scan pass.
                            _qart = self.quote_coverage.setdefault("quote_scan_attach_retry", {})
                            if not isinstance(_qart, dict):
                                _qart = self.quote_coverage["quote_scan_attach_retry"] = {}
                            if int(_qart.get(entry_id, 0) or 0) >= 5:
                                pass   # gave up on the attachments; body-price path below still works
                            else:
                                try:
                                    attach_text = self._attachment_quote_text_from_msg(msg)
                                except Exception:
                                    attach_text = ""
                                _att_incomplete = bool(getattr(self, "_vendor_attach_last_failed", False))
                                if _att_incomplete:
                                    _tries = int(_qart.get(entry_id, 0) or 0) + 1
                                    _qart[entry_id] = _tries
                                    _qneg_dirty = True
                                    if _tries >= 5:
                                        # v4.1.28 (round 10, blocker #5): the entry carries
                                        # its DURABLE identity (Message-ID, sender, conv,
                                        # failed file names) so the review window's
                                        # Message-ID fallback and Retry actually have
                                        # something to work with after EntryID churn.
                                        try:
                                            _arnq = self.quote_coverage.setdefault("attachment_review_needed", [])
                                            if isinstance(_arnq, list):
                                                try:
                                                    _v_imid = re.sub(r"\s+", "", str(outlook_msg_internet_id(msg) or "")).lower()
                                                except Exception:
                                                    _v_imid = ""
                                                try:
                                                    _v_sender = self.get_sender_email(msg) or str(getattr(msg, "SenderName", "") or "")
                                                except Exception:
                                                    _v_sender = ""
                                                _arnq.append({
                                                    "entry_id": entry_id,
                                                    "internet_message_id": _v_imid,
                                                    "subject": str(subj or "")[:160],
                                                    "sender": str(_v_sender or "")[:120],
                                                    "conversation_id": str(conv_id or ""),
                                                    "failed_files": list(getattr(self, "_vendor_attach_failed_names", []) or [])[:10],
                                                    "reason": "vendor quote attachment(s) could not be fully read after 5 scan passes",
                                                    "attempts": _tries,
                                                    "at": datetime.now().isoformat(),
                                                })
                                                if len(_arnq) > 1000:
                                                    del _arnq[:len(_arnq) - 1000]
                                        except Exception:
                                            pass
                                        _cov_debug(f"INBOX QUOTE SCAN: attachments still failing for {subj!r} after {_tries} passes -- queued for Attachment Review")
                                elif entry_id in _qart:
                                    _qart.pop(entry_id, None)
                                    _qneg_dirty = True
                        if not has_price and not attach_text:
                            # Checkpoint ONLY the content-permanent case. A quote-ish or
                            # attachment-bearing message stays retryable: attachments may
                            # parse later (extractor upgrades) and coverage links change.
                            if entry_id and not _has_attach and not _quoteish and not has_price:
                                _qneg[entry_id] = COVERAGE_QUOTE_GATE_VERSION
                                _qneg_dirty = True
                            continue
                        checked += 1  # candidate consumed part of the scan window
                        # v3.9.101: capture who SENT this inbound message so the flip can require a
                        # VENDOR. The customer's own reply lands in this same inbox scan (e.g. the
                        # customer re-stating the item they want, with your earlier priced quote
                        # attached), and without the sender the item-name + any-price match flips
                        # the customer's requested item to Quoted.
                        try:
                            _in_sender = self.get_sender_email(msg) or ""
                        except Exception:
                            _in_sender = ""
                        _cov_debug(f"INBOX-CANDIDATE folder={folder_label!r} subj={subj!r} body_priced={has_price} attach_chars={len(attach_text)} attach_incomplete={_att_incomplete} conv_linked={_conv_linked} sender={_in_sender!r} recv={(recv_dt.isoformat() if recv_dt else '?')}")
                        added = self.update_coverage_quoted_from_sent(
                            conversation_id=conv_id, subject=subj, body=body, attachment_text=attach_text,
                            sent_entry_id=entry_id, sent_on=(recv_dt.isoformat() if recv_dt else datetime.now().isoformat()),
                            sender_email=_in_sender, source_message_id=outlook_msg_internet_id(msg),
                            attachment_incomplete=_att_incomplete)  # v4.1.27: partial reads never finalize
                        if added:
                            marked += added
                    except Exception:
                        continue
                # v4.1.26 (round 8, defect #3): persist the cursor decision for this folder
                # -- identical semantics to the customer-request scan. A capped BACKFILL
                # pass advances the cursor deeper; a capped TOP pass keeps the (deeper)
                # stored cursor so backfill progress is never lost; any pass that fully
                # traverses its window clears the cursor.
                try:
                    if _hit_cap and _last_recv is not None:
                        _entry = dict(_qcur) if isinstance(_qcur, dict) else {}
                        if _backfill or not str(_entry.get("oldest_reached", "") or ""):
                            _entry["oldest_reached"] = _last_recv.strftime("%m/%d/%Y %I:%M %p")
                            # v4.1.27 (round 9, blocker #2): record WHICH messages in the
                            # boundary minute were already covered, so the next backfill
                            # includes that minute without repeating them. Only refreshed
                            # when oldest_reached itself moves (they belong together).
                            _entry["boundary_ids"] = list(_minute_ids)[:20000] if _minute_key == _entry["oldest_reached"] else []
                        _entry["backfill_next"] = not _backfill
                        _qcursors[folder_label] = _entry
                        _qneg_dirty = True
                        _cov_debug(f"INBOX QUOTE SCAN cursor saved for {folder_label!r}: oldest={_entry.get('oldest_reached')!r} backfill_next={_entry.get('backfill_next')} boundary_ids={len(_entry.get('boundary_ids', []) or [])} (checked={checked} walked={walked} raw={raw_walked})")
                    elif folder_label in _qcursors:
                        _qcursors.pop(folder_label, None)
                        _qneg_dirty = True
                        _cov_debug(f"INBOX QUOTE SCAN cursor cleared for {folder_label!r} (window fully traversed)")
                except Exception:
                    pass
            except Exception as _e:
                # v4.1.28 (round 10, blocker #4): a folder that died before being inspected
                # must be DISTINGUISHABLE from "scanned, nothing found". The error is
                # surfaced to the caller (Full Update shows it as a warning) instead of
                # only being swallowed into the debug log.
                try:
                    self._last_quote_scan_folder_errors.append(f"{folder_label}: {_e!r:.120}")
                except Exception:
                    pass
                _cov_debug(f"INBOX QUOTE SCAN folder exception {folder_label!r}: {_e!r}")
        # Bound + persist the negative cache and cursors (piggybacks the coverage save).
        try:
            if len(_qneg) > 8000:
                # Oldest-insertion trim: dict preserves insertion order.
                for _k in list(_qneg.keys())[:len(_qneg) - 8000]:
                    _qneg.pop(_k, None)
            if _qneg_dirty:
                self.save_quote_coverage()
        except Exception:
            pass
        return marked

    def _own_mailbox_domains(self, namespace=None):
        """v4.1.20 (external audit round 2, finding #4): the signed-in mailbox's SMTP
        domain(s), resolved once and cached for the session. Lets the customer-attachment
        scan classify same-domain senders as INTERNAL before any sender-level learning
        exists, so your own replies landing in the shared Sales inbox -- or a brand-new
        colleague -- can never seed customer-requested coverage items."""
        cached = getattr(self, "_own_domains_cache", None)
        if isinstance(cached, set) and cached:
            return cached
        doms = set()
        try:
            ns = namespace or getattr(self, "namespace", None)
            cu = getattr(ns, "CurrentUser", None) if ns is not None else None
            addr = ""
            if cu is not None:
                try:
                    ae = cu.AddressEntry
                    try:
                        exu = ae.GetExchangeUser()
                        if exu is not None:
                            addr = str(exu.PrimarySmtpAddress or "")
                    except Exception:
                        pass
                except Exception:
                    pass
                if not addr:
                    try:
                        addr = str(getattr(cu, "Address", "") or "")
                    except Exception:
                        addr = ""
            d = get_email_domain(addr)
            if d:
                doms.add(str(d).lower())
        except Exception:
            pass
        # v4.1.31: configured aliases + employee-learned domains.  Outlook
        # CurrentUser often exposes only the primary SMTP domain while shared
        # mailboxes and aliases use another company domain.
        try:
            if COVERAGE_INTAKE_ENGINE_AVAILABLE:
                doms.update(configured_internal_domains(getattr(self, "settings", {}) or {}, doms))
            else:
                _raw = str((getattr(self, "settings", {}) or {}).get("internal_domains", "") or "")
                _raw += "," + str(os.environ.get("MAINBOX_INTERNAL_DOMAINS", "") or "")
                for _tok in re.split(r"[,;\s]+", _raw.lower()):
                    _tok = _tok.strip().lstrip("@")
                    if _tok and "." in _tok:
                        doms.add(_tok)
        except Exception:
            pass
        try:
            for _row in (getattr(self, "emails", []) or []):
                if not isinstance(_row, dict) or normalize_email_type_code(_row.get("email_type", "")) != "E":
                    continue
                _ed = str(get_email_domain(_row.get("sender_email", "") or _row.get("sender", "")) or "").lower()
                if _ed:
                    doms.add(_ed)
        except Exception:
            pass
        if doms:
            self._own_domains_cache = doms
        return doms

    def scan_recent_inbox_for_customer_request_attachments(self, max_items=80, lookback_days=10, max_new=10):
        """v4.1.18: CUSTOMER REQUEST ATTACHMENT COVERAGE. A customer's item list often
        arrives as a PDF/Excel attachment or a screenshot pasted into the body -- not as
        typed text -- so nothing reached the coverage ledger. This scan walks the same
        inbound folders as the vendor-quote scan and, for messages that read like a
        QUOTE REQUEST and carry document attachments or meaningful body images, extracts
        their line items and creates/updates the thread's coverage ledger (items land
        Outstanding; the normal outgoing-RFQ hook flips them Waiting and vendor pricing
        flips them Quoted, exactly like typed items).

        Conservative + idempotent by construction:
        - each message is examined ONCE ever (persistent processed-ID ledger inside the
          coverage file, so it survives restarts and rides the cloud backup);
        - request gate: customer-request phrases, RFQ/P&A subjects, or explicit
          "quote the attached list / see screenshot" language -- priced vendor quotes
          never qualify (they are the OTHER scan's job);
        - relationship gate: durable Vendor/Marketing/Internal senders never create
          requested items (v4.1.17 sticky types feed this);
        - dismissed ledgers are never resurrected;
        - max_new caps how many NEW messages get the (OCR-capable) extraction per pass,
          so a first run over a busy inbox spreads across refreshes instead of stalling;
        - runs inside the same serialized Outlook worker contexts as the quote scan.

        Gated by settings['auto_coverage_from_customer_attachments'] (default ON)."""
        try:
            # v4.1.39: this scan now hosts BOTH customer-request mining and PO-award
            # detection. Run it if EITHER feature is enabled; the request-creation work
            # inside still respects auto_coverage_from_customer_attachments, and PO
            # detection has its own _po_award_enabled() gate. Previously PO detection
            # could never run when attachment auto-coverage was off, despite its own
            # settings being on.
            _attach_cov_on = bool(self.settings.get("auto_coverage_from_customer_attachments", True))
            _po_on = False
            try:
                _po_on = self._po_award_enabled()
            except Exception:
                _po_on = False
            if not _attach_cov_on and not _po_on:
                return 0
        except Exception:
            pass
        if not isinstance(getattr(self, "quote_coverage", None), dict):
            return 0
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return 0
        processed_list = self.quote_coverage.setdefault("processed_customer_request_ids", [])
        if not isinstance(processed_list, list):
            processed_list = self.quote_coverage["processed_customer_request_ids"] = []
        processed = set(str(x) for x in processed_list)
        # v4.1.22 (external audit round 4, finding #6): NEGATIVE-DECISION checkpointing.
        # A message examined and found NOT to be a request is remembered (with the gate
        # version), so signature-image/invoice traffic stops re-consuming the scan window
        # every pass and older RFQs beneath it are reached. Bumping the gate version
        # re-examines everything automatically.
        negative = self.quote_coverage.setdefault("request_scan_negative", {})
        if not isinstance(negative, dict):
            negative = self.quote_coverage["request_scan_negative"] = {}
        cutoff = datetime.now() - timedelta(days=lookback_days)
        _cov_debug(f"=== CUSTOMER REQUEST ATTACHMENT SCAN start max_items={max_items} lookback_days={lookback_days} max_new={max_new} ===")
        self._last_req_scan_folder_errors = []   # v4.1.28 (round 10, blocker #4)
        folders = self.coverage_inbox_folders_for_quote_scan(namespace)
        if not folders:
            return 0
        added_total = 0
        new_processed = 0
        dirty = False
        seen_ids = set()
        for folder_label, inbox in folders:
            if new_processed >= max_new:
                break
            # v4.1.54: same Sales-mailbox ownership rule as the vendor-quote scan -- only
            # messages tagged with the selected sales category are ingested from any
            # folder other than the user's own inbox.
            _sales_cat_gate = (folder_label != "My Inbox")
            try:
                items = inbox.Items
                try:
                    _cut_str = cutoff.strftime("%m/%d/%Y %I:%M %p")
                    items = items.Restrict(f"[ReceivedTime] >= '{_cut_str}'")
                except Exception:
                    pass
                # v4.1.21 (external audit round 3, finding #6): STARVATION FIX part 1 --
                # restrict to attachment-bearing mail so routine no-attachment traffic
                # never consumes the scan window at all. Fail-soft: some stores reject
                # DASL restrictions; the walk below still works without it.
                try:
                    items = items.Restrict('@SQL="urn:schemas:httpmail:hasattachment"=1')
                except Exception:
                    pass
                # v4.1.25 (external audit round 7, blocker #7): PERSISTENT SCAN CURSOR.
                # When a pass ends at a cap, the oldest-reached position is stored and
                # passes ALTERNATE between new mail (top) and backfill continuation
                # (below the cursor), guaranteeing eventual traversal of the whole
                # window no matter how many attachment-bearing messages sit above an
                # old RFQ. The cursor clears when a backfill pass reaches the cutoff.
                _cursors = self.quote_coverage.setdefault("request_scan_cursors", {})
                if not isinstance(_cursors, dict):
                    _cursors = self.quote_coverage["request_scan_cursors"] = {}
                _cur = _cursors.get(folder_label) if isinstance(_cursors.get(folder_label), dict) else {}
                _backfill = bool(_cur.get("backfill_next")) and bool(str(_cur.get("oldest_reached", "") or ""))
                if _backfill:
                    try:
                        # v4.1.27 (round 9, blocker #2): the cursor is MINUTE-precision, so
                        # a strict '<' permanently skipped messages received in the same
                        # minute as the cursor but below the cap. Include the boundary
                        # minute; this scan's durable processed/negative checkpoints
                        # free-skip everything already handled in it, so nothing repeats
                        # and nothing is lost.
                        _b_edge = _cur["oldest_reached"]
                        try:
                            _b_dt = datetime.strptime(_b_edge, "%m/%d/%Y %I:%M %p") + timedelta(minutes=1)
                            _b_edge = _b_dt.strftime("%m/%d/%Y %I:%M %p")
                        except Exception:
                            pass
                        items = items.Restrict(f"[ReceivedTime] < '{_b_edge}'")
                        _cov_debug(f"REQ-ATTACH cursor: backfill pass below {_b_edge!r} (boundary-inclusive) in {folder_label!r}")
                    except Exception:
                        _backfill = False
                try:
                    items.Sort("[ReceivedTime]", True)
                except Exception:
                    pass
                _hit_cap = False
                _last_recv = None
                # STARVATION FIX part 2: 'checked' now counts only ELIGIBLE candidates
                # (attachment-bearing, not yet processed), so 80 routine emails can no
                # longer hide an older customer RFQ beneath them. 'walked' hard-caps the
                # raw COM traffic in case the DASL restriction was rejected.
                checked = 0
                walked = 0
                raw_walked = 0
                _skip_ct = 0    # v4.1.30: checkpointed free-skips (navigation, not work)
                # v4.1.22 (external audit round 4, finding #15): advance-first
                # GetFirst/GetNext iteration -- direct Python enumeration does not
                # reliably honor Items.Sort() on all stores. The cursor advances BEFORE
                # the body runs, so every 'continue' below remains safe.
                try:
                    _nav_msg = items.GetFirst()
                except Exception:
                    _nav_msg = None
                while _nav_msg is not None:
                    msg = _nav_msg
                    try:
                        _nav_msg = items.GetNext()
                    except Exception:
                        _nav_msg = None
                    # v4.1.23 (external audit round 5, finding #10): already-checkpointed
                    # messages (processed or negative) no longer consume the walk budget --
                    # otherwise 1,000 routine attachment emails permanently hid the RFQ
                    # beneath them on EVERY pass. raw_walked is the ultimate COM-traffic
                    # safety cap; 'walked' counts only NOVEL examinations.
                    # v4.1.30 (external audit round 12, finding #4): TWO-BUDGET model, same
                    # as the vendor-quote scan. Checkpointed free-skips no longer consume
                    # the 5000 examination budget -- 5000 already-processed same-minute
                    # messages could otherwise permanently hide the unprocessed request
                    # beneath them (every pass re-navigated the same checkpoints and hit
                    # the raw cap before reaching it). Skips are cheap navigations, bounded
                    # separately at 30000; real examinations stay bounded at 5000.
                    raw_walked += 1
                    if checked >= max_items or new_processed >= max_new or walked >= 1000 \
                            or (raw_walked - _skip_ct) >= 5000 or raw_walked >= 30000:
                        _hit_cap = True  # v4.1.25: remember we stopped at a cap, not the cutoff
                        break
                    try:
                        try:
                            recv_dt = msg.ReceivedTime.replace(tzinfo=None)
                        except Exception:
                            recv_dt = None
                        if recv_dt is not None and recv_dt < cutoff:
                            break
                        if recv_dt is not None:
                            _last_recv = recv_dt
                        try:
                            entry_id = str(msg.EntryID or "")
                        except Exception:
                            entry_id = ""
                        if not entry_id or entry_id in processed or entry_id in seen_ids:
                            if entry_id and entry_id in processed:
                                _skip_ct += 1   # v4.1.30: checkpointed navigation, not work
                            continue
                        if int(negative.get(entry_id, -1)) == COVERAGE_REQUEST_GATE_VERSION:
                            _skip_ct += 1       # v4.1.30: checkpointed navigation, not work
                            continue  # v4.1.22: examined before, not a request -- free skip
                        # v4.1.54: Sales-Inbox messages must carry the selected sales
                        # category before ANY ingestion work. Counted as a cheap skip
                        # (one COM property read), NOT checkpointed (tags are mutable),
                        # and placed before the walk budget so colleague-tagged mail
                        # cannot starve this user's request scan.
                        if _sales_cat_gate:
                            try:
                                _msg_cats = msg.Categories or ""
                            except Exception:
                                _msg_cats = ""
                            if not self.email_has_outlook_category(_msg_cats, self.selected_sales_category):
                                _skip_ct += 1
                                continue
                        walked += 1
                        seen_ids.add(entry_id)
                        # Cheap gate 1: must actually carry attachments (inline screenshots
                        # count -- Outlook stores pasted body images as attachments).
                        try:
                            if int(getattr(msg.Attachments, "Count", 0) or 0) <= 0:
                                continue
                        except Exception:
                            continue
                        # v4.1.19 AUDIT FIX (finding #13): EntryIDs change on move/copy/
                        # restore/another profile, so key the processed ledger by the durable
                        # RFC-5322 Message-ID when available (EntryID kept as fallback and
                        # for back-compat with entries recorded by v4.1.18).
                        _imid_key = ""
                        try:
                            _pa = msg.PropertyAccessor
                            try:
                                _imid_raw = str(_pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
                            except Exception:
                                _imid_raw = str(_pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001E") or "")
                            _imid_norm = re.sub(r"\s+", "", _imid_raw).strip().lower()
                            if _imid_norm:
                                _imid_key = "imid:" + _imid_norm
                        except Exception:
                            _imid_key = ""
                        if _imid_key and _imid_key in processed:
                            # Same message already handled (possibly under an older EntryID).
                            processed_list.append(entry_id)
                            processed.add(entry_id)
                            dirty = True
                            continue

                        def _mark_done(_eid=entry_id, _ik=_imid_key):
                            processed_list.append(_eid)
                            processed.add(_eid)
                            if _ik:
                                processed_list.append(_ik)
                                processed.add(_ik)
                        try:
                            subj = msg.Subject or ""
                        except Exception:
                            subj = ""
                        try:
                            body = (msg.Body or "")[:6000]
                        except Exception:
                            body = ""
                        # v4.1.20 (external audit round 2, finding #3): request detection must
                        # read the NEWLY WRITTEN text. For a REPLY in a thread, the quoted
                        # history below the fresh text contains the customer's ORIGINAL
                        # "please quote the attached list" -- which let an unknown vendor's
                        # "see attached" answer qualify as a customer request. Replies now
                        # qualify only on their fresh text; an original (non-reply) message
                        # can still qualify by its subject (RFQ / P&A ...).
                        try:
                            _fresh = _strip_reply_boilerplate_for_intent(body)
                        except Exception:
                            _fresh = body
                        _is_reply = bool(re.match(r"\s*(?:re|fw|fwd)\s*:", subj, flags=re.I))
                        low = (_fresh if _is_reply else (subj + "\n" + _fresh)).lower()
                        # v4.1.21 (external audit round 3, finding #9): resolve the sender's
                        # relationship type BEFORE the request gate, so a KNOWN CUSTOMER's
                        # attachment-only reply ("Attached.") in a quote thread can qualify.
                        sender_email = ""
                        sender_name = ""
                        try:
                            sender_email = self.get_sender_email(msg) or ""
                        except Exception:
                            sender_email = ""
                        try:
                            sender_name = str(getattr(msg, "SenderName", "") or "")
                        except Exception:
                            sender_name = ""
                        # Gate 3: relationship type. Vendors' priced replies belong to the
                        # quote scan; marketing/internal mail never creates requested items.
                        row = self.get_email_by_id(entry_id) or {}
                        _dtype = self._durable_email_type_for_email(
                            {"entry_id": entry_id, "email_type": (row or {}).get("email_type", "")})
                        if not _dtype:
                            # v4.1.19 AUDIT FIX (finding #3): no saved row yet -- fall back to
                            # the user's own SENDER-LEVEL teaching so a known vendor's "please
                            # see attached quote" can never be mistaken for a customer request.
                            try:
                                _lh, _ls = self.get_learning_hint_for_email(
                                    {"sender_email": sender_email, "sender": sender_name, "subject": subj})
                                if _lh and _ls in ("sender", "domain"):
                                    _dtype = normalize_email_type_code(_lh.get("email_type", ""))
                            except Exception:
                                pass
                        if not _dtype and sender_email:
                            # v4.1.20 (finding #4): same-domain senders are INTERNAL even
                            # before any learning exists -- your own replies in the shared
                            # Sales inbox must never seed customer-requested items.
                            try:
                                _own = self._own_mailbox_domains(namespace)
                                _sd = str(get_email_domain(sender_email) or "").lower()
                                if _own and _sd and _sd in _own:
                                    _dtype = "E"
                            except Exception:
                                pass
                        if _dtype in ("V", "M", "E"):
                            _cov_debug(f"REQ-ATTACH skip {subj!r}: sender type {_dtype}")
                            _mark_done()
                            dirty = True
                            continue
                        # v4.1.38 PO-AWARD DETECTION. A customer PURCHASE ORDER often
                        # arrives as a PDF -- sometimes on the RFQ thread ("here is the
                        # PO"), sometimes forwarded in a DIFFERENT chain. Before the
                        # request gate (a PO is not a request, so it would otherwise be
                        # checkpointed negative and lost), ask the PO-match engine whether
                        # this attachment-bearing customer/unknown message is a PO for an
                        # open job. A confident match is QUEUED for the main-thread popup;
                        # detection never mutates coverage here on the worker thread.
                        try:
                            if self._po_award_enabled():
                                _po_store_id = ""
                                try:
                                    _po_store_id = str(getattr(getattr(msg, "Parent", None), "StoreID", "") or "")
                                except Exception:
                                    _po_store_id = ""
                                _po_queued = self._detect_and_queue_customer_po(
                                    msg=msg, entry_id=entry_id, store_id=_po_store_id,
                                    subject=subj, body=body, fresh_text=_fresh,
                                    sender_email=sender_email, sender_name=sender_name,
                                    durable_type=_dtype, namespace=namespace,
                                    imid_key=_imid_key)
                                if _po_queued == "retry":
                                    # v4.1.39a: PO attachment could not be read this pass.
                                    # Do NOT mark done and do NOT negative-checkpoint --
                                    # leave the message unprocessed so a later scan (when
                                    # the attachment/OCR is available) can re-examine it.
                                    _cov_debug(f"REQ-ATTACH {subj!r}: PO attachment unreadable -- leaving for retry")
                                    continue
                                if _po_queued:
                                    # This message is a recognized PO -- do not also try to
                                    # mine it for requested items. Mark done so it is not
                                    # re-examined; the popup handles the coverage action.
                                    _cov_debug(f"REQ-ATTACH {subj!r}: recognized as a customer PO, queued for review")
                                    _mark_done()
                                    dirty = True
                                    continue
                        except Exception as _po_exc:
                            _cov_debug(f"REQ-ATTACH PO detection error on {subj!r}: {_po_exc!r}")
                        # v4.1.39: if customer-request attachment coverage is OFF (this
                        # scan is running only for PO detection), do not mine the message
                        # for requested items. It was not a PO (or the PO branch would
                        # have continued above), so checkpoint it and move on.
                        if not bool(self.settings.get("auto_coverage_from_customer_attachments", True)):
                            negative[entry_id] = COVERAGE_REQUEST_GATE_VERSION
                            dirty = True
                            continue
                        # Gate 2 (v4.1.21 finding #10): explicit PRICING-INTENT phrases only --
                        # generic 'please advise' on a submittal or packing list never seeds a
                        # ledger. The attached-list pointer branches remain as second signals.
                        is_request = bool(
                            contains_any_phrase(low, COVERAGE_ATTACH_REQUEST_PHRASES)
                            or re.search(r"\brfq\b|quote request|request for quote|\bp\s*&\s*a\b|price and availability|pricing and availability", low)
                            or re.search(r"(?:quote|price|pricing|availability)[^.\n]{0,60}\b(attached|attachment|screenshot|image|photo|picture|list below|below)\b", low)
                            or re.search(r"\b(attached|see|per the)\b[^.\n]{0,40}\b(bom|takeoff|take-off|material list|parts list|item list|screenshot)\b", low)
                        )
                        # v4.1.21 (finding #9) / v4.1.22 (round 4, finding #7): a KNOWN
                        # CUSTOMER replying in a quote-oriented thread qualifies only with
                        # ACTUAL attachment-pointer language. The old "any reply of <= 40
                        # characters" shortcut let 'Thanks!' with a purchase_order.pdf seed
                        # requested coverage -- gone. Courtesy / won-order / lost-deal
                        # intent in the fresh text VETOES request creation outright.
                        if not is_request and _dtype == "C":
                            _subj_quoteish = bool(re.search(r"\brfq\b|\bp\s*&\s*a\b|quot|pric|estimate|bid\b", subj.lower()))
                            _pointer = bool(re.search(
                                r"attach|screenshot|photo|picture|(?:revised|updated|new|material|parts|item)\s+list|"
                                r"added items|additional items|please add|quote these|see below",
                                _fresh.strip().lower()))
                            if _subj_quoteish and _pointer:
                                is_request = True
                                _cov_debug(f"REQ-ATTACH {subj!r}: known-customer attachment-pointer reply accepted")
                        if is_request:
                            # Finding #7: courtesy/closing intent overrides -- 'Thanks!',
                            # 'we're all set', a placed PO ('won order'), or a walk-away
                            # ('lost deal') must never create NEW requested items, whatever
                            # is attached (POs, packing lists, submittals ride those replies).
                            try:
                                _veto = email_is_courtesy_closer(subj, _fresh)
                                if not _veto:
                                    _won, _wp = detect_won_order((subj + "\n" + _fresh).lower())
                                    _veto = bool(_won)
                                if not _veto:
                                    _lost, _lp, _lvl = detect_lost_deal(_fresh)
                                    _veto = bool(_lost)
                            except Exception:
                                _veto = False
                            if _veto:
                                _cov_debug(f"REQ-ATTACH skip {subj!r}: courtesy/won/lost intent vetoes request creation")
                                _mark_done()
                                dirty = True
                                continue
                        if not is_request:
                            # v4.1.22 (finding #6): checkpoint the negative decision so this
                            # message never consumes the scan window again (until the gate
                            # version changes).
                            negative[entry_id] = COVERAGE_REQUEST_GATE_VERSION
                            dirty = True
                            continue
                        checked += 1  # v4.1.22: only INTENT-PASSING candidates consume the window
                        # Gate 3b (v4.1.19 audit #3 / v4.1.20 finding #2): vendor-quote CONTENT
                        # veto on the FRESH text, using QUOTE-SHAPED price evidence rather than
                        # "any two-decimal number". v4.1.21: skipped for KNOWN customers --
                        # their mail is by definition not a vendor quote (a forwarded vendor
                        # document is still caught by the mostly-priced item veto below).
                        _fresh_low = (subj + "\n" + _fresh).lower()
                        if _dtype != "C" and (contains_any_phrase(_fresh_low, VENDOR_QUOTE_REPLY_PHRASES) or _looks_like_priced_quote_text(_fresh)):
                            _cov_debug(f"REQ-ATTACH skip {subj!r}: reads like a priced vendor quote, not a request")
                            _mark_done()
                            dirty = True
                            continue
                        # The expensive step -- counts against max_new whether or not items
                        # are found. Save failures are transient (retried next pass); empty
                        # parses get BOUNDED retries (audit #4) before being marked done.
                        mats = self._coverage_materials_from_msg_attachments(
                            msg, include_images=True, source_label="customer-request")
                        new_processed += 1
                        # v4.1.31: consume the intake engine's explicit decision BEFORE
                        # the legacy empty/retry path.  Reject is a terminal non-request;
                        # quarantine creates an actionable Attachment Review record and is
                        # checkpointed so it does not OCR forever.
                        _intake_result = getattr(self, "_coverage_intake_last_result", {}) or {}
                        _intake_decision = str(_intake_result.get("decision", "bypass") or "bypass").lower()
                        if _intake_decision == "reject":
                            _cov_debug(
                                f"REQ-ATTACH rejected by intake engine {subj!r}: "
                                f"role={_intake_result.get('document_role')} reason={_intake_result.get('review_reason')}"
                            )
                            _mark_done()
                            dirty = True
                            continue
                        if _intake_decision == "quarantine":
                            try:
                                _arn = self.quote_coverage.setdefault("attachment_review_needed", [])
                                if isinstance(_arn, list):
                                    _arn.append({
                                        "entry_id": entry_id,
                                        "internet_message_id": _imid_key.replace("imid:", "", 1) if _imid_key else "",
                                        "subject": str(subj or "")[:160],
                                        "sender": sender_email or sender_name,
                                        "reason": "Coverage Intake Engine: " + str(_intake_result.get("review_reason", "ambiguous document")),
                                        "attempts": 1,
                                        "at": datetime.now().isoformat(),
                                        "intake_engine": {
                                            "version": str(_intake_result.get("audit", {}).get("engine_version", "")),
                                            "document_role": str(_intake_result.get("document_role", "unknown")),
                                            "confidence": _intake_result.get("confidence", 0),
                                            "metrics": _intake_result.get("metrics", {}),
                                            "warnings": _intake_result.get("warnings", []),
                                        },
                                    })
                                    if len(_arn) > 1000:
                                        del _arn[:len(_arn) - 1000]
                            except Exception:
                                pass
                            _mark_done()
                            dirty = True
                            _cov_debug(f"REQ-ATTACH quarantined by intake engine {subj!r}")
                            continue
                        # v4.1.20 (external audit round 2, finding #1): the flag now means
                        # "at least one ELIGIBLE attachment failed to save" -- even when
                        # OTHER attachments produced items. The message is never marked done
                        # while it is set (partial items still reach the ledger below; the
                        # per-item dedupe makes the eventual full re-run lossless). A bounded
                        # counter (5 passes) guarantees termination if a file never saves.
                        # v4.1.22 (finding #8): a parse exception is the same class of
                        # incompleteness as a save failure -- retry, never terminal-complete.
                        _save_failed = bool(getattr(self, "_coverage_attach_last_save_failed", False)
                                            or getattr(self, "_coverage_attach_last_parse_failed", False))
                        _save_gave_up = False
                        if _save_failed:
                            _sf = self.quote_coverage.setdefault("request_scan_savefail_counts", {})
                            if not isinstance(_sf, dict):
                                _sf = self.quote_coverage["request_scan_savefail_counts"] = {}
                            _sft = int(_sf.get(entry_id, 0) or 0) + 1
                            if _sft >= 5:
                                _sf.pop(entry_id, None)
                                _save_gave_up = True
                                _cov_debug(f"REQ-ATTACH {subj!r}: attachment save still failing after {_sft} passes -- giving up on the failed file(s)")
                                # v4.1.21 (external audit round 3, finding #5): exhausted
                                # failures are RECORDED FOR REVIEW, not silently absorbed --
                                # "we stopped retrying" must stay distinguishable from "we
                                # successfully examined this request".
                                try:
                                    _arn = self.quote_coverage.setdefault("attachment_review_needed", [])
                                    if isinstance(_arn, list):
                                        _arn.append({
                                            "entry_id": entry_id,
                                            "internet_message_id": _imid_key.replace("imid:", "", 1) if _imid_key else "",
                                            "subject": str(subj or "")[:160],
                                            "sender": sender_email or sender_name,
                                            "reason": "attachment could not be saved from Outlook after 5 scan passes",
                                            "attempts": _sft,
                                            "at": datetime.now().isoformat(),
                                        })
                                        if len(_arn) > 1000:
                                            del _arn[:len(_arn) - 1000]
                                except Exception:
                                    pass
                            else:
                                _sf[entry_id] = _sft
                                _cov_debug(f"REQ-ATTACH {subj!r}: {'partial ' if mats else ''}attachment save failure (attempt {_sft}/5) -- message stays unprocessed for retry")
                            dirty = True
                        if not mats:
                            if _save_failed and not _save_gave_up:
                                continue
                            if _save_failed and _save_gave_up:
                                _mark_done()
                                dirty = True
                                continue
                            # v4.1.19 AUDIT FIX (finding #4): an empty parse can be a transient
                            # OCR/parser hiccup, not proof the attachment holds no items. Retry
                            # on later passes up to 3 attempts before marking processed.
                            _rc = self.quote_coverage.setdefault("request_scan_retry_counts", {})
                            if not isinstance(_rc, dict):
                                _rc = self.quote_coverage["request_scan_retry_counts"] = {}
                            _tries = int(_rc.get(entry_id, 0) or 0) + 1
                            if _tries < 3:
                                _rc[entry_id] = _tries
                                dirty = True
                                _cov_debug(f"REQ-ATTACH {subj!r}: no items (attempt {_tries}/3), will retry")
                                continue
                            _rc.pop(entry_id, None)
                            # v4.1.23 (finding #11): if material was SKIPPED (oversized /
                            # beyond caps), this is not a successfully-empty message --
                            # put it in Attachment Review so the user can handle it.
                            if getattr(self, "_coverage_attach_last_skipped_material", False):
                                try:
                                    _arn = self.quote_coverage.setdefault("attachment_review_needed", [])
                                    if isinstance(_arn, list):
                                        _arn.append({
                                            "entry_id": entry_id,
                                            "internet_message_id": _imid_key.replace("imid:", "", 1) if _imid_key else "",
                                            "subject": str(subj or "")[:160],
                                            "sender": sender_email or sender_name,
                                            "reason": "attachment(s) skipped: oversized or beyond the document/image caps -- never parsed",
                                            "attempts": 3,
                                            "at": datetime.now().isoformat(),
                                        })
                                        if len(_arn) > 1000:
                                            del _arn[:len(_arn) - 1000]
                                except Exception:
                                    pass
                            _mark_done()
                            dirty = True
                            _cov_debug(f"REQ-ATTACH {subj!r}: no line items found after 3 attempts -- marked done")
                            continue
                        # v4.1.19 audit #3 (item-level veto): a document whose lines mostly
                        # carry PRICES is a vendor quote, not a customer request list.
                        # v4.1.21 (finding #4): this veto is NOT a terminal decision while any
                        # attachment failed to save -- the priced sheet that DID save must not
                        # mask the material list that did not. Retry the whole message instead.
                        _priced_ct = sum(1 for _m in mats if str((_m or {}).get("price", "") or "").strip())
                        if mats and _priced_ct >= max(1, (len(mats) + 1) // 2):
                            if _save_failed and not _save_gave_up:
                                _cov_debug(f"REQ-ATTACH {subj!r}: saved attachment(s) look priced, but another attachment failed to save -- withholding the vendor-document verdict until it is read")
                                continue
                            _cov_debug(f"REQ-ATTACH skip {subj!r}: {_priced_ct}/{len(mats)} extracted lines carry prices -> vendor quote document")
                            self.quote_coverage.setdefault("request_scan_retry_counts", {}).pop(entry_id, None)
                            self.quote_coverage.setdefault("request_scan_savefail_counts", {}).pop(entry_id, None)
                            _mark_done()
                            dirty = True
                            continue
                        self.quote_coverage.setdefault("request_scan_retry_counts", {}).pop(entry_id, None)
                        # v4.1.24 (round 6, blocker #7): oversized/cap-deferred material is
                        # recorded for review EVEN when a sibling attachment parsed -- a small
                        # spreadsheet must not silently bury the oversized material PDF.
                        if getattr(self, "_coverage_attach_last_skipped_material", False):
                            try:
                                _arn = self.quote_coverage.setdefault("attachment_review_needed", [])
                                if isinstance(_arn, list):
                                    _arn.append({
                                        "entry_id": entry_id,
                                        "internet_message_id": _imid_key.replace("imid:", "", 1) if _imid_key else "",
                                        "subject": str(subj or "")[:160],
                                        "sender": sender_email or sender_name,
                                        "reason": "attachment(s) skipped (oversized / beyond caps) while other attachments parsed -- skipped file was never read",
                                        "attempts": 1,
                                        "at": datetime.now().isoformat(),
                                    })
                                    if len(_arn) > 1000:
                                        del _arn[:len(_arn) - 1000]
                            except Exception:
                                pass
                        if not _save_failed or _save_gave_up:
                            # Complete extraction (or gave up on a permanently failing file):
                            # safe to mark done. Otherwise the message stays unprocessed so the
                            # failed attachment is re-attempted -- items found so far are still
                            # written to the ledger below (idempotent; deduped on re-run).
                            _mark_done()
                        dirty = True
                        try:
                            conv_id = str(msg.ConversationID or "")
                        except Exception:
                            conv_id = ""
                        gid = ""
                        try:
                            gid = str(self.get_group_id_for_email(entry_id) or "")
                            if gid and not self.get_group_by_id(gid):
                                gid = ""
                        except Exception:
                            gid = ""
                        if not gid and conv_id:
                            try:
                                gid = str(self._coverage_group_id_for_conversation(conv_id) or "")
                            except Exception:
                                gid = ""
                        # v4.1.18 audit: if an earlier pass keyed this conversation's ledger
                        # by conversation (email was ungrouped then), fold it into the group.
                        if gid and conv_id:
                            self._coverage_fold_conversation_into_group(conv_id, gid)
                        key = ("grp:" + gid) if gid else self.coverage_thread_key(conv_id, subj)
                        rec = self.get_coverage_record(key, create=False)
                        if isinstance(rec, dict) and rec.get("dismissed"):
                            _cov_debug(f"REQ-ATTACH {subj!r}: ledger dismissed, not resurrecting")
                            continue
                        added = self.update_coverage_requested(
                            key, mats, subject=subj, customer=sender_name,
                            customer_email=sender_email, group_id=gid,
                            conversation_id=conv_id, source="customer_attachment",
                            source_ref=(_imid_key or entry_id))  # v4.1.24: per-message identity
                        if added:
                            added_total += added
                            _cov_debug(f"REQ-ATTACH {subj!r}: +{added} requested item(s) from attachments/images -> {key}")
                    except Exception:
                        continue
                try:
                    if _hit_cap and _last_recv is not None:
                        _entry = dict(_cur) if isinstance(_cur, dict) else {}
                        if _backfill or not str(_entry.get("oldest_reached", "") or ""):
                            _entry["oldest_reached"] = _last_recv.strftime("%m/%d/%Y %I:%M %p")
                        _entry["backfill_next"] = not _backfill
                        _cursors[folder_label] = _entry
                        dirty = True
                        _cov_debug(f"REQ-ATTACH cursor saved for {folder_label!r}: {_entry!r}")
                    elif folder_label in _cursors:
                        _cursors.pop(folder_label, None)
                        dirty = True
                        _cov_debug(f"REQ-ATTACH cursor cleared for {folder_label!r} (window fully traversed)")
                except Exception:
                    pass
            except Exception as _e:
                try:
                    self._last_req_scan_folder_errors.append(f"{folder_label}: {_e!r:.120}")  # v4.1.28
                except Exception:
                    pass
                _cov_debug(f"REQ-ATTACH folder exception {folder_label!r}: {_e!r}")
        try:
            # v4.1.21 (finding #18): each message stores up to TWO identities (EntryID +
            # Message-ID), so the cap doubles to keep ~4000 messages of history.
            if len(processed_list) > 8000:
                del processed_list[:len(processed_list) - 8000]
                dirty = True
            # v4.1.22: bound the negative-decision cache too (insertion-ordered dict --
            # oldest examined messages age out far beyond any lookback window).
            if len(negative) > 8000:
                for _k in list(negative.keys())[:len(negative) - 8000]:
                    negative.pop(_k, None)
                dirty = True
            if dirty or added_total:
                self.save_quote_coverage()
        except Exception:
            pass
        if added_total:
            try:
                self.root.after(0, self.update_coverage_status_label)
            except Exception:
                pass
        return added_total

    def check_pending_sent_replies(self):
        manual_sent_updates = 0
        try:
            manual_sent_updates = self.scan_recent_sent_waiting_trackers(max_items=50, lookback_days=7)
        except Exception:
            manual_sent_updates = 0
        if not getattr(self, "pending_reply_checks", None):
            if manual_sent_updates:
                self.sort_emails_for_display()
                self.render_email_rows()
                try:
                    self.render_group_rows()
                except Exception:
                    pass
            return manual_sent_updates
        changed = False
        completed_count = 0
        self._begin_placeholder_batch()  # v3.8.24: coalesce per-reply placeholder writes/syncs
        for pending in self.pending_reply_checks:
            if pending.get("completed") or pending.get("cancelled"):
                continue
            email = self.get_email_by_id(pending.get("entry_id", "")) or self.find_email_for_followup_item(pending)
            if email and self.email_is_completed(email):
                pending["cancelled"] = True
                pending["cancelled_at"] = datetime.now().isoformat()
                pending["cancel_reason"] = "Cancelled automatic tracking: email marked Completed"
                changed = True
                continue
            sent_msg = self.find_sent_reply_for_pending_check(pending)
            if not sent_msg:
                continue
            if self.is_sent_message_thank_you_only(sent_msg):
                if email:
                    email["status"] = "Completed"
                    email["followup_time"] = ""
                    email["is_new_import"] = False
                    email["sent_waiting_tracker_active"] = False
                    email["smart_followup_closed_reason"] = "Simple thank-you/acknowledgement reply sent."
                    self.save_record(email)
                pending["completed"] = True
                pending["completed_at"] = datetime.now().isoformat()
                pending["completed_reason"] = "simple_ack_reply_found_in_sent_items"
                completed_count += 1
                changed = True
                continue
            if email:
                email["status"] = pending.get("target_status_after_send", "Waiting on Customer")
                email["followup_time"] = ""
                email["is_new_import"] = False
                email["sent_waiting_tracker_active"] = True
                email["sent_waiting_tracker_updated_at"] = datetime.now().isoformat()
                try:
                    email["sent_waiting_tracker_sent_timestamp"] = self.get_sent_msg_time(sent_msg).timestamp()
                except Exception:
                    email["sent_waiting_tracker_sent_timestamp"] = datetime.now().timestamp()
                self.save_record(email)
            # v3.9.27 duplicate fix: only create the separate "Sent / Waiting" placeholder
            # row when there is NO real row to carry the tracker. The old code created it
            # alongside the activated real row, showing two waiting rows for one send.
            if not email:
                placeholder_status = pending.get("target_status_after_send", "Waiting on Vendor")
                if placeholder_status in ["Waiting on Vendor", "Waiting on Customer"]:
                    placeholder = self.make_sent_waiting_placeholder(sent_msg, pending, placeholder_status)
                    self.add_or_update_sent_waiting_placeholder(placeholder)
            pending["completed"] = True
            pending["completed_at"] = datetime.now().isoformat()
            pending["completed_reason"] = "reply_found_in_sent_items"
            completed_count += 1
            changed = True
        self._flush_placeholder_batch()  # v3.8.24: single placeholder write + single resync
        if changed:
            self.flush_status_data()
            self.save_pending_reply_checks()
            self.save_cached_state()
            self.sort_emails_for_display()
            self.render_email_rows()
            try:
                self.render_group_rows()
            except Exception:
                pass
            self.followup_status_var.set(f"Follow-ups: sent reply detected, moved {completed_count} item(s) to waiting status")
        return completed_count

    def create_reply_draft_with_message(self, email, message_text, require_thread=False, target_status_after_send=None, followup_source="manual"):
        self.draft_busy = True
        msg = self.get_message_object(email)
        if not msg:
            self.draft_busy = False
            messagebox.showerror("Draft Error", "Could not reopen this email from Outlook. Try Refresh or Update.")
            return False
        try:
            html_message = html_escape_basic(message_text)
            try:
                reply = msg.Reply()
                self.display_outlook_item_foreground(reply)
                reply.HTMLBody = f"<p>{html_message}</p><br>" + reply.HTMLBody
                self.display_outlook_item_foreground(reply)
                self.root.after(500, lambda r=reply: self.bring_outlook_inspector_to_front(r))
                self.root.after(1200, lambda r=reply: self.bring_outlook_inspector_to_front(r))
            except Exception as reply_error:
                if require_thread:
                    self.draft_busy = False
                    messagebox.showerror("Threaded Reply Error", f"Outlook could not create a threaded reply for this item.\n\n{reply_error}")
                    return False
                outlook, namespace = self.fresh_outlook()
                if not outlook:
                    raise Exception("Could not reconnect to Outlook.Application")
                reply = outlook.CreateItem(0)
                sender_email = self.get_sender_email(msg)
                subject = email.get("subject", "")
                if not subject.lower().startswith("re:"):
                    subject = "RE: " + subject
                reply.To = sender_email
                reply.Subject = subject
                reply.HTMLBody = f"<p>{html_message}</p><br>"
                self.display_outlook_item_foreground(reply)
                self.root.after(500, lambda r=reply: self.bring_outlook_inspector_to_front(r))
                self.root.after(1200, lambda r=reply: self.bring_outlook_inspector_to_front(r))
            # Draft was created/opened. Until we can confirm the reply was actually sent,
            # this item should remain Needs Reply. A background sent-items check will move
            # it to Waiting on Customer/Vendor after the sent reply is detected.
            self.record_pending_reply_check(email, target_status_after_send, followup_source)
            email["status"] = "Needs Reply"
            email["is_new_import"] = False
            self.save_record(email)
            self.flush_status_data()
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.save_cached_state()
            self.draft_busy = False
            return True
        except Exception as e:
            self.draft_busy = False
            messagebox.showerror("Draft Error", f"Could not create draft.\n\n{e}")
            return False

    def create_ai_draft_reply(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return

        jobs = []
        total = len(selected_emails)
        for index, email in enumerate(selected_emails, start=1):
            try:
                body = self.load_body_if_needed(email)
            except Exception:
                body = email.get("body", "") or ""
            fallback = get_followup_message(email.get("category", "General"))
            jobs.append({
                "entry_id": email.get("entry_id", ""),
                "subject": email.get("subject", ""),
                "sender": email.get("sender", ""),
                "body": body,
                "category": email.get("category", "General"),
                "urgency": email.get("urgency", "Normal"),
                "status": email.get("status", "New"),
                "fallback": fallback,
            })
            if total == 1:
                self.render_body_preview(
                    email,
                    body,
                    extra_status="AI Reply clicked: body loaded into preview/cache. Drafting in background..."
                )

        self.save_cached_state()

        def worker(cancel_event):
            results = []
            for job in jobs:
                if cancel_event.is_set():
                    return {"cancelled": True, "results": results}
                ai_result = ask_ollama_for_reply(
                    subject=job["subject"],
                    sender=job["sender"],
                    body=job["body"],
                    category=job["category"],
                    urgency=job["urgency"],
                    status=job["status"],
                )
                text = job["fallback"]
                source = "template fallback"
                timing = ""
                if ai_result:
                    text = ai_result.get("text") if isinstance(ai_result, dict) else str(ai_result)
                    source = "Ollama"
                    if isinstance(ai_result, dict) and ai_result.get("total_duration"):
                        total_s = ai_result.get("total_duration", 0) / 1_000_000_000
                        load_s = (ai_result.get("load_duration") or 0) / 1_000_000_000
                        timing = f"{total_s:.1f}s / load {load_s:.1f}s"
                results.append({
                    "entry_id": job["entry_id"],
                    "message": text,
                    "source": source,
                    "timing": timing,
                })
            return {"cancelled": False, "results": results}

        def success(result):
            if result.get("cancelled"):
                self.ai_status_var.set("AI: draft generation cancelled")
                self.preview_text.insert(tk.END, "\nAI draft generation cancelled before opening remaining drafts.")
                return
            created = 0
            fallback_count = 0
            for row in result.get("results", []):
                email = self.get_email_by_id(row.get("entry_id", ""))
                if not email:
                    continue
                if row.get("source") != "Ollama":
                    fallback_count += 1
                if self.create_reply_draft_with_message(email, row.get("message", ""), require_thread=True):
                    created += 1
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(
                tk.END,
                f"Created {created} threaded draft(s).\n\n"
                f"AI source: {len(result.get('results', [])) - fallback_count} Ollama / {fallback_count} template fallback.\n"
                "The AI work ran in the background so the app should stay usable."
            )
            self.ai_status_var.set("AI: draft complete")

        def error(exc, tb):
            self.ai_status_var.set("AI: fallback after error")
            if messagebox.askyesno("AI Error", f"Ollama failed or timed out, but MaINbox is still usable.\n\nCreate template draft(s) instead?\n\n{exc}"):
                created = 0
                for job in jobs:
                    email = self.get_email_by_id(job.get("entry_id", ""))
                    if email and self.create_reply_draft_with_message(email, job.get("fallback", ""), require_thread=True):
                        created += 1
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, f"Created {created} template fallback draft(s) after AI error.")

        self.start_ai_task("drafting reply", worker, success, error)

    def create_urgent_ack_drafts(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return
        urgent_emails = [email for email in selected_emails if email.get("urgency") in ["High", "Critical"]]
        if not urgent_emails:
            answer = messagebox.askyesno("No High/Critical Selected", "None of the selected emails are marked High or Critical.\n\nCreate acknowledgment draft(s) anyway?")
            if not answer:
                return
            urgent_emails = selected_emails
        created = 0
        for email in urgent_emails:
            message = self.generate_reply_text(email, prefer_ai=True)
            if self.create_reply_draft_with_message(email, message, require_thread=True):
                created += 1
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Created {created} AI/threaded urgent acknowledgment draft(s).")


    def active_followup_count(self):
        manual = len([f for f in self.followups if not f.get("completed") and not f.get("cancelled")])
        scenarios = 0
        for f in self.scenario_reminders:
            if f.get("completed") or f.get("cancelled"):
                continue
            email = self.find_email_for_followup_item(f)
            if email and self.email_is_completed(email):
                continue
            scenarios += 1
        commitments = 0
        for f in getattr(self, "commitment_reminders", []):
            if f.get("completed") or f.get("cancelled"):
                continue
            email = self.find_email_for_followup_item(f)
            if email and self.email_is_completed(email):
                continue
            commitments += 1
        return manual + scenarios + commitments

    def format_due_display(self, due_at_raw):
        try:
            due_at = datetime.fromisoformat(due_at_raw)
            return due_at.strftime("%m/%d %I:%M %p")
        except Exception:
            return "Unknown"

    def find_email_for_followup_item(self, item):
        entry_id = item.get("entry_id", "")
        if entry_id:
            email = self.get_email_by_id(entry_id)
            if email:
                return email
        conversation_id = item.get("conversation_id", "")
        if conversation_id:
            for email in self.emails:
                if email.get("conversation_id") == conversation_id:
                    return email
        group_id = item.get("group_id", "")
        if group_id:
            for email in self.emails:
                if self.get_group_id_for_email(email.get("entry_id", "")) == group_id:
                    return email

        # If the user deleted the item from MaINbox but chose to keep its
        # follow-up, keep a safe snapshot so that one final follow-up can still
        # be reviewed/deployed without putting the email back into the main list.
        try:
            snapshot = item.get("deleted_email_snapshot")
            if isinstance(snapshot, dict) and snapshot.get("entry_id"):
                safe = dict(snapshot)
                safe.pop("message", None)
                safe["is_deleted_app_snapshot"] = True
                return safe
        except Exception:
            pass
        return None

    def get_followup_queue_items(self, include_completed=False):
        # v3.9.27 efficiency: this runs on every preview-queue render (every refresh /
        # AutoPilot cycle). Only re-run the 4-collection dedupe when something actually
        # added or replaced follow-up records; dedupe_followup_records() clears the flag.
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
        rows = []
        seen_queue_keys = set()
        for index, item in enumerate(self.followups):
            if not include_completed and (item.get("completed") or item.get("cancelled")):
                continue
            email = self.find_email_for_followup_item(item)
            group_name = ""
            if email:
                group_name = self.get_group_name_for_email(email.get("entry_id", "")) or ""
            status = "Cancelled" if item.get("cancelled") else "Completed" if item.get("completed") else "Active"
            queue_key = ("manual", status if include_completed else "Active", item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if queue_key in seen_queue_keys:
                continue
            seen_queue_keys.add(queue_key)
            rows.append({
                "queue_id": f"manual:{index}",
                "kind": "Manual follow-up",
                "due_at": item.get("due_at", ""),
                "due_display": self.format_due_display(item.get("due_at", "")),
                "subject": item.get("subject") or (email.get("subject", "") if email else "Email not loaded/found"),
                "group": group_name,
                "status": status,
                "note": item.get("message") or item.get("note") or "Manual scheduled follow-up",
                "item": item,
                "email": email,
            })
        for index, item in enumerate(self.scenario_reminders):
            if not include_completed and (item.get("completed") or item.get("cancelled")):
                continue
            email = self.find_email_for_followup_item(item)
            if email and self.email_is_completed(email) and not item.get("one_time_after_app_delete") and not (item.get("completed") or item.get("cancelled")):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Auto-cancelled: related email is Completed/Low/Junk."
                self.save_scenario_reminders()
                self.save_commitment_reminders()
                if not include_completed:
                    continue
            group_name = ""
            if email:
                group_name = self.get_group_name_for_email(email.get("entry_id", "")) or ""
            scenario_type = item.get("type", "scenario")
            if scenario_type == "vendor_no_response":
                kind = "Vendor no-response"
            elif scenario_type == "customer_po_order_followup":
                kind = "PO/order follow-up"
            else:
                kind = scenario_type.replace("_", " ").title()
            status = "Cancelled" if item.get("cancelled") else "Completed" if item.get("completed") else "Active"
            queue_key = (scenario_type, status if include_completed else "Active", item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if queue_key in seen_queue_keys:
                continue
            seen_queue_keys.add(queue_key)
            rows.append({
                "queue_id": f"scenario:{index}",
                "kind": kind,
                "due_at": item.get("due_at", ""),
                "due_display": self.format_due_display(item.get("due_at", "")),
                "subject": item.get("subject") or (email.get("subject", "") if email else "Email not loaded/found"),
                "group": group_name,
                "status": status,
                "note": item.get("note") or item.get("reason") or item.get("description") or "Automatic scenario reminder",
                "item": item,
                "email": email,
            })
        # v3.8.15: include the commitment/promised-date lane so created ETA / lead-time
        # reminders are visible immediately (upcoming preview + queue), not only when due.
        for index, item in enumerate(getattr(self, "commitment_reminders", [])):
            if not include_completed and (item.get("completed") or item.get("cancelled")):
                continue
            email = self.find_email_for_followup_item(item)
            if email and self.email_is_completed(email) and not (item.get("completed") or item.get("cancelled")):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Auto-cancelled: related email is Completed/Low/Junk."
                self.save_commitment_reminders()
                if not include_completed:
                    continue
            group_name = ""
            if email:
                group_name = self.get_group_name_for_email(email.get("entry_id", "")) or ""
            status = "Cancelled" if item.get("cancelled") else "Completed" if item.get("completed") else "Active"
            queue_key = (item.get("type", "commitment"), status if include_completed else "Active",
                         item.get("target_date", ""),
                         item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if queue_key in seen_queue_keys:
                continue
            seen_queue_keys.add(queue_key)
            rows.append({
                "queue_id": f"commitment:{index}",
                "kind": item.get("kind_label", "Promised date"),
                "due_at": item.get("due_at", ""),
                "due_display": self.format_due_display(item.get("due_at", "")),
                "subject": item.get("subject") or (email.get("subject", "") if email else "Email not loaded/found"),
                "group": group_name,
                "status": status,
                "note": item.get("note") or "Detected promised date / ETA reminder",
                "item": item,
                "email": email,
            })
        def sort_key(row):
            try:
                return datetime.fromisoformat(row.get("due_at") or "9999-12-31T23:59:59")
            except Exception:
                return datetime.max
        rows.sort(key=sort_key)
        return rows

    def open_followup_queue_window(self):
        win = tk.Toplevel(self.root)
        win.title("MaINbox Follow-Up Queue")
        remember_window_geometry(win, "MaINbox Follow-Up Queue", "1050x520")
        win.transient(self.root)

        header = tk.Frame(win)
        header.pack(fill="x", padx=10, pady=8)
        title_var = tk.StringVar()
        tk.Label(header, textvariable=title_var, font=("Segoe UI", 15, "bold")).pack(side="left")
        show_completed_var = tk.BooleanVar(value=False)
        tk.Checkbutton(header, text="Show completed/cancelled", variable=show_completed_var).pack(side="right", padx=5)

        columns = ("due", "type", "status", "group", "subject", "note")
        queue_tree = ttk.Treeview(win, columns=columns, show="headings", selectmode="extended")
        queue_tree.heading("due", text="Due")
        queue_tree.heading("type", text="Type")
        queue_tree.heading("status", text="Status")
        queue_tree.heading("group", text="Group")
        queue_tree.heading("subject", text="Subject")
        queue_tree.heading("note", text="Note")
        queue_tree.column("due", width=125)
        queue_tree.column("type", width=155)
        queue_tree.column("status", width=80, anchor="center")
        queue_tree.column("group", width=190)
        queue_tree.column("subject", width=285)
        queue_tree.column("note", width=300)
        queue_tree.pack(fill="both", expand=True, padx=10, pady=5)
        queue_tree.tag_configure("due", background="#fff2cc", foreground="black")
        queue_tree.tag_configure("overdue", background="#f4cccc", foreground="black")
        queue_tree.tag_configure("completed", background="#d9ead3", foreground="black")
        queue_tree.tag_configure("cancelled", background="#eeeeee", foreground="#777777")

        detail = tk.Text(win, height=5, wrap="word", font=("Segoe UI", 9))
        detail.pack(fill="x", padx=10, pady=(4, 6))

        queue_rows = []

        def selected_rows(show_warning=True):
            selected = queue_tree.selection()
            if not selected:
                if show_warning:
                    messagebox.showwarning("No Follow-Up Selected", "Please select one or more follow-up queue items first.")
                return []
            found = []
            selected_set = set(selected)
            for row in queue_rows:
                if row.get("queue_id") in selected_set:
                    found.append(row)
            return found

        def selected_row(show_warning=True):
            rows = selected_rows(show_warning=show_warning)
            return rows[0] if rows else None

        def refresh_queue():
            nonlocal queue_rows
            queue_tree.delete(*queue_tree.get_children())
            queue_rows = self.get_followup_queue_items(include_completed=show_completed_var.get())
            now = datetime.now()
            active = len([r for r in queue_rows if r.get("status") == "Active"])
            title_var.set(f"Follow-Up Queue — {active} active")
            for row in queue_rows:
                tags = []
                if row.get("status") == "Completed":
                    tags = ["completed"]
                elif row.get("status") == "Cancelled":
                    tags = ["cancelled"]
                else:
                    try:
                        due_at = datetime.fromisoformat(row.get("due_at", ""))
                        if due_at <= now:
                            tags = ["overdue"]
                        elif due_at <= now + timedelta(minutes=15):
                            tags = ["due"]
                    except Exception:
                        tags = []
                queue_tree.insert(
                    "", "end", iid=row["queue_id"],
                    values=(row["due_display"], row["kind"], row["status"], row["group"], row["subject"], row["note"]),
                    tags=tags,
                )
            detail.delete("1.0", tk.END)
            if queue_rows:
                detail.insert(tk.END, "Select one or more queue items to cancel, snooze, or trigger now. Open Related Email uses the first selected item.")
            else:
                detail.insert(tk.END, "No active follow-ups are currently queued.")
            self.followup_status_var.set(f"Follow-ups: {self.active_followup_count()} active")
            self.render_followup_preview_queue()

        def show_detail(event=None):
            row = selected_row(show_warning=False)
            if not row:
                detail.delete("1.0", tk.END)
                detail.insert(tk.END, "Select one or more queue items to cancel, snooze, or trigger now. Open Related Email uses the first selected item.")
                return
            email = row.get("email")
            detail.delete("1.0", tk.END)
            detail.insert(
                tk.END,
                f"Type: {row.get('kind')}\n"
                f"Due: {row.get('due_display')}\n"
                f"Status: {row.get('status')}\n"
                f"Group: {row.get('group') or 'None'}\n"
                f"Subject: {row.get('subject')}\n"
                f"Related email loaded: {'Yes' if email else 'No'}\n\n"
                f"Note: {row.get('note')}"
            )

        def open_related():
            row = selected_row()
            if not row:
                return
            email = row.get("email")
            if not email:
                messagebox.showinfo("Email Not Loaded", "This follow-up exists, but the related email is not currently loaded in the visible/cache email list. Try Refresh or Update.")
                return
            try:
                if self.tree.exists(email.get("entry_id", "")):
                    self.tree.selection_set(email["entry_id"])
                    self.tree.see(email["entry_id"])
            except Exception:
                pass
            body = self.load_body_if_needed(email)
            self.render_body_preview(email, body, extra_status="Opened from Follow-Up Queue.")
            win.lift()

        def cancel_selected():
            rows = [r for r in selected_rows() if r.get("status") == "Active"]
            if not rows:
                return
            if not messagebox.askyesno("Cancel Follow-Ups", f"Cancel {len(rows)} queued follow-up(s)?"):
                return
            for row in rows:
                item = row.get("item")
                if item is not None:
                    item["cancelled"] = True
                    item["cancelled_at"] = datetime.now().isoformat()
                    item["cancel_reason"] = "Cancelled from Follow-Up Queue"
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            refresh_queue()
            self.render_email_rows()
            self.render_group_rows()

        def snooze_rows(rows, due_at, label="custom"):
            changed = 0
            for row in rows:
                if row.get("status") != "Active":
                    continue
                item = row.get("item")
                if item is not None:
                    item["due_at"] = due_at.isoformat()
                    item["snoozed_at"] = datetime.now().isoformat()
                    item["snooze_label"] = label
                    email = row.get("email")
                    if email:
                        email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
                    changed += 1
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_cached_state()
            refresh_queue()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            return changed

        def parse_custom_snooze(raw):
            raw = (raw or "").strip()
            if not raw:
                return None
            now = datetime.now()
            for fmt in ["%m/%d/%Y %I:%M %p", "%m/%d/%y %I:%M %p", "%m/%d/%Y %H:%M", "%m/%d/%y %H:%M"]:
                try:
                    return datetime.strptime(raw.upper(), fmt)
                except Exception:
                    pass
            parsed_time = parse_followup_time(raw)
            return parsed_time

        def snooze_selected(minutes=None):
            rows = [r for r in selected_rows() if r.get("status") == "Active"]
            if not rows:
                return
            if minutes is None:
                custom = simpledialog.askstring(
                    "Custom Snooze",
                    "Enter snooze date/time. Examples:\n3:00 PM\n05/13/2026 9:30 AM",
                    parent=win
                )
                due_at = parse_custom_snooze(custom)
                if not due_at:
                    messagebox.showerror("Invalid Snooze", "Please enter a time like 3:00 PM or a date/time like 05/13/2026 9:30 AM.")
                    return
                label = custom
            else:
                due_at = datetime.now() + timedelta(minutes=minutes)
                label = f"{minutes} minutes"
            snooze_rows(rows, due_at, label=label)

        def snooze_dropdown_apply():
            label = snooze_var.get()
            options = {
                "15 min": 15,
                "30 min": 30,
                "1 hour": 60,
                "2 hours": 120,
                "Tomorrow 9 AM": None,
                "Custom date/time": None,
            }
            if label == "Tomorrow 9 AM":
                target = datetime.combine((datetime.now() + timedelta(days=1)).date(), datetime.strptime("9:00 AM", "%I:%M %p").time())
                rows = [r for r in selected_rows() if r.get("status") == "Active"]
                if rows:
                    snooze_rows(rows, target, label=label)
                return
            if label == "Custom date/time":
                snooze_selected(None)
                return
            snooze_selected(options.get(label, 30))

        def trigger_now():
            rows = [r for r in selected_rows() if r.get("status") == "Active"]
            if not rows:
                return
            for row in rows:
                item = row.get("item")
                if item is not None:
                    item["due_at"] = (datetime.now() - timedelta(seconds=1)).isoformat()
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.check_due_followups()
            refresh_queue()

        btns = tk.Frame(win)
        btns.pack(fill="x", padx=10, pady=(0, 10))
        tk.Button(btns, text="Open Related Email", command=open_related, width=18).pack(side="left", padx=4)
        tk.Button(btns, text="Trigger Now Selected", command=trigger_now, width=18).pack(side="left", padx=4)
        snooze_var = tk.StringVar(value="30 min")
        ttk.Combobox(btns, textvariable=snooze_var, values=["15 min", "30 min", "1 hour", "2 hours", "Tomorrow 9 AM", "Custom date/time"], state="readonly", width=18).pack(side="left", padx=4)
        tk.Button(btns, text="Snooze Selected", command=snooze_dropdown_apply, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Cancel Selected", command=cancel_selected, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Refresh", command=refresh_queue, width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Close", command=win.destroy, width=12).pack(side="right", padx=4)

        queue_tree.bind("<<TreeviewSelect>>", show_detail)
        show_completed_var.trace_add("write", lambda *_: refresh_queue())
        refresh_queue()
        try:
            win.lift()
            win.focus_force()
        except Exception:
            pass

    def open_followup_window(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return
        first_email = selected_emails[0]
        existing = self.get_active_followup_for_email(first_email["entry_id"])
        win = tk.Toplevel(self.root)
        win.title("Setup / Edit Follow Up")
        remember_window_geometry(win, "Setup Edit Follow Up", "560x430")
        win.resizable(False, False)
        win.transient(self.root)
        tk.Label(win, text="Setup / Edit Follow Up", font=("Segoe UI", 16, "bold")).pack(pady=12)
        tk.Label(win, text=f"{len(selected_emails)} email(s) selected.\nAt the follow-up time, the app will show a due follow-ups popup. You choose what to deploy.", font=("Segoe UI", 10)).pack(pady=4)
        if existing:
            try:
                existing_dt = datetime.fromisoformat(existing["due_at"])
                default_time = existing_dt.strftime("%I:%M %p")
                existing_text = f"Existing follow-up: {existing_dt.strftime('%m/%d/%Y %I:%M %p')}"
            except Exception:
                default_time = "3:00 PM"
                existing_text = "Existing follow-up found."
        else:
            default_time = "3:00 PM"
            existing_text = "No existing follow-up for the first selected email."
        tk.Label(win, text=existing_text, font=("Segoe UI", 9), fg=_FG_DIM).pack(pady=4)
        time_frame = tk.Frame(win)
        time_frame.pack(pady=10)
        tk.Label(time_frame, text="Follow-up:").pack(side="left", padx=5)
        time_var = tk.StringVar(value=default_time)
        followup_choices = [
            "1 minute", "5 minutes", "15 minutes", "30 minutes",
            "1 hour", "2 hours", "4 hours", "Tomorrow 9 AM", "3:00 PM"
        ]
        followup_box = ttk.Combobox(time_frame, textvariable=time_var, values=followup_choices, state="readonly", width=18)
        followup_box.pack(side="left", padx=5)
        tk.Label(time_frame, text="choose a preset").pack(side="left", padx=5)
        tk.Label(win, text="Scheduling again will replace any active follow-up for the selected email(s).\nThe app must remain open for scheduled follow-up popups to trigger.", font=("Segoe UI", 9), fg=_FG_DIM).pack(pady=8)

        def get_active_auto_followup_conflicts():
            """Return active automatic follow-up/tracking rows for the selected email(s).

            Manual follow-ups are now the user's authoritative reminder.  To keep
            the queue clean, creating a manual follow-up cannot leave an AI/vendor/
            customer/pending tracker active for the same email/thread.
            """
            conflicts = []
            seen = set()
            for email in selected_emails:
                for collection_name, index, item in self.get_active_automatic_tracking_for_email(email, include_pending=True):
                    key = (collection_name, index)
                    if key in seen:
                        continue
                    seen.add(key)
                    scenario_type = item.get("type", item.get("source", "automatic"))
                    conflicts.append({
                        "collection": collection_name,
                        "index": index,
                        "item": item,
                        "email": email,
                        "subject": item.get("subject") or email.get("subject", "") or "(No subject)",
                        "due": self.format_due_display(item.get("due_at", "")) if hasattr(self, "format_due_display") else item.get("due_at", ""),
                        "note": item.get("note", "") or item.get("reason", "") or item.get("source", "") or "Automatic follow-up/tracking",
                        "kind": scenario_type.replace("_", " ").title() if scenario_type else "Automatic Tracking",
                    })
            return conflicts

        def ask_manual_followup_with_auto_conflicts(conflicts):
            """
            If an automatic follow-up/tracker already exists, ask whether to
            replace it with the manual follow-up or stop. Returns: cancel or abort.
            """
            if not conflicts:
                return "cancel"

            dialog = tk.Toplevel(win)
            dialog.title("Automatic Follow-Up Already Exists")
            remember_window_geometry(dialog, "Automatic Follow-Up Conflict", "800x430")
            dialog.transient(win)
            dialog.grab_set()
            dialog.resizable(True, True)

            tk.Label(
                dialog,
                text="An automatic follow-up/tracker already exists for the selected email(s).",
                font=("Segoe UI", 13, "bold")
            ).pack(anchor="w", padx=12, pady=(12, 4))
            tk.Label(
                dialog,
                text="To prevent duplicate reminders, creating the manual follow-up will cancel the existing automatic tracking.",
                font=("Segoe UI", 9)
            ).pack(anchor="w", padx=12, pady=(0, 8))

            frame = tk.Frame(dialog)
            frame.pack(fill="both", expand=True, padx=12, pady=6)
            columns = ("kind", "due", "subject", "note")
            tree = ttk.Treeview(frame, columns=columns, show="headings", height=8)
            tree.heading("kind", text="Existing Tracker")
            tree.heading("due", text="Due")
            tree.heading("subject", text="Subject")
            tree.heading("note", text="Note")
            tree.column("kind", width=170)
            tree.column("due", width=120)
            tree.column("subject", width=270)
            tree.column("note", width=300)
            tree.pack(side="left", fill="both", expand=True)
            yscroll = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)
            yscroll.pack(side="right", fill="y")
            tree.configure(yscrollcommand=yscroll.set)

            for row in conflicts:
                tree.insert("", "end", values=(row.get("kind", "Automatic"), row.get("due", ""), row.get("subject", ""), row.get("note", "")))

            result = {"choice": "abort"}

            def choose(choice):
                result["choice"] = choice
                dialog.destroy()

            btns = tk.Frame(dialog)
            btns.pack(fill="x", padx=12, pady=(8, 12))
            tk.Button(btns, text="Create Manual + Cancel Auto", command=lambda: choose("cancel"), width=28).pack(side="left", padx=4)
            tk.Button(btns, text="Do Not Create", command=lambda: choose("abort"), width=18).pack(side="right", padx=4)

            dialog.protocol("WM_DELETE_WINDOW", lambda: choose("abort"))
            win.wait_window(dialog)
            return result.get("choice", "abort")

        def schedule_or_edit():
            target_dt = parse_followup_time(time_var.get().strip())
            if not target_dt:
                messagebox.showerror("Invalid Time", "Please choose a dropdown value or enter something like 3:00 PM, 9 AM, 14:30, 1, 1 min, 30 minutes, 2 hours, or Tomorrow 9 AM.")
                return

            auto_conflicts = get_active_auto_followup_conflicts()
            auto_choice = ask_manual_followup_with_auto_conflicts(auto_conflicts)
            if auto_choice == "abort":
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, "Manual follow-up was not created. Existing automatic follow-up/tracking was left unchanged.")
                return

            self.save_undo_state("schedule/edit follow-up")
            scheduled_count = 0
            cancelled_auto_count = 0
            now_iso = datetime.now().isoformat()

            if auto_choice == "cancel":
                for conflict in auto_conflicts:
                    item = conflict.get("item")
                    if item and not item.get("completed") and not item.get("cancelled"):
                        item["cancelled"] = True
                        item["cancelled_at"] = now_iso
                        item["cancel_reason"] = "Cancelled by user while creating manual follow-up"
                        cancelled_auto_count += 1

            for email in selected_emails:
                for item in self.followups:
                    if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                        item["cancelled"] = True
                        item["cancelled_at"] = now_iso
                        item["cancel_reason"] = "Replaced by edited follow-up"
                item = {
                    "entry_id": email["entry_id"], "store_id": email.get("store_id", ""),
                    "conversation_id": email.get("conversation_id", ""), "group_id": self.get_group_id_for_email(email.get("entry_id", "")), "subject": email.get("subject", ""),
                    "source": email.get("source", ""), "category": email.get("category", "General"),
                    "due_at": target_dt.isoformat(), "message": "", "use_ai": True,
                    "completed": False, "cancelled": False, "created_at": now_iso
                }
                self.followups.append(item)
                self._followup_dedup_needed = True  # v3 efficiency: mark dirty.
                email["followup_time"] = target_dt.strftime("%m/%d %I:%M %p")
                scheduled_count += 1
            self.save_followups()
            if cancelled_auto_count:
                self.save_scenario_reminders()
                self.save_commitment_reminders()
                self.save_pending_reply_checks()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.save_cached_state()
            self.preview_text.delete("1.0", tk.END)
            extra = f"\nCancelled {cancelled_auto_count} existing automatic follow-up/tracking item(s)." if cancelled_auto_count else ""
            self.preview_text.insert(tk.END, f"Scheduled/edited {scheduled_count} manual follow-up(s) for {target_dt.strftime('%m/%d/%Y %I:%M %p')}.{extra}\n\nThe app must be open for the follow-up drafts to trigger.")
            win.destroy()

        def cancel_from_window():
            win.destroy()
            self.cancel_selected_followups()

        tk.Button(win, text="Save Follow Up", command=schedule_or_edit, width=24).pack(pady=8)
        tk.Button(win, text="Cancel Existing Follow Up", command=cancel_from_window, width=24).pack(pady=8)
        tk.Button(win, text="Close", command=win.destroy, width=24).pack(pady=8)

    def cancel_selected_followups(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return
        cancelled = 0
        now_iso = datetime.now().isoformat()
        for email in selected_emails:
            # Cancel both manual follow-ups and automatic AI/scenario tracking.
            # Previously this button only cancelled self.followups, so AI Follow-Up
            # Review rows in self.scenario_reminders could stay active and keep
            # returning in the queue even after the user thought they were cleared.
            for item in self.followups:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            for item in self.scenario_reminders:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            for item in self.pending_reply_checks:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            # v3.8.30: also cancel commitment reminders (promised dates / reply-needed)
            # for this email. Previously this handler called save_commitment_reminders()
            # but never modified the list, so a commitment reminder stayed active after the
            # user believed every follow-up/tracking item for the email had been cleared.
            for item in getattr(self, "commitment_reminders", []) or []:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            try:
                self.learn_followup_behavior(email, "no_followup", None, "User cancelled follow-up/tracking for this item.")
            except Exception:
                pass
            email["followup_time"] = ""
        self.save_followups()
        self.save_scenario_reminders()
        self.save_commitment_reminders()
        self.save_pending_reply_checks()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        self.save_cached_state()
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Cancelled {cancelled} active follow-up/tracking item(s).")

    def create_draft_reply(self):
        email = self.get_selected_email()
        if not email:
            return
        self.create_reply_draft_with_message(email, get_followup_message(email.get("category", "General")), require_thread=True)

    def open_selected_email(self):
        email = self.get_selected_email()
        if not email:
            return
        msg = self.get_message_object(email)
        if not msg:
            messagebox.showerror("Open Error", "Could not reopen this email from Outlook. Try Refresh or Update.")
            return
        try:
            email["is_new_import"] = False
            if self.tree.exists(email["entry_id"]):
                self.tree.item(email["entry_id"], tags=(self.get_row_tag(email),))
            msg.Display()
            try:
                inspector = msg.GetInspector
                if inspector:
                    inspector.Activate()
            except Exception:
                pass
        except Exception as e:
            email["message"] = None
            messagebox.showerror("Open Error", f"Could not open email.\n\n{e}")

    def change_category(self):
        self.save_cached_state()
        self.root.destroy()
