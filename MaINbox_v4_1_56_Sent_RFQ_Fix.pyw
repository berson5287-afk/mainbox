    def assign_emails_to_group(self, emails, group_id):
        group = self.get_group_by_id(group_id)
        if not group or not emails:
            return 0
        self.save_undo_state("add email(s) to group")
        count = 0
        memberships = self.groups_data.setdefault("memberships", {})
        for email in emails:
            entry_id = email.get("entry_id", "")
            if entry_id:
                previous_group_id = memberships.get(entry_id, "")
                memberships[entry_id] = group_id
                count += 1
                if previous_group_id != group_id:
                    self.learn_group_from_user_move(email, group_id, previous_group_id)
        self.save_groups()
        self.render_group_rows()
        self.render_email_rows()
        self.preview_text.delete("1.0", tk.END)
        quote_like = any((e.get("category") == "Quote / Estimate" or contains_any_phrase((e.get("subject", "") + "\n" + e.get("body", "")), CUSTOMER_REQUEST_PHRASES)) for e in emails)
        msg = f"Added {count} email(s) to {group.get('urgency', 'Normal')} group: {group.get('name', '')}"
        if quote_like:
            msg += "\n\nQuote Intelligence is available for this group. Select the group and click Quote RFQ to scan materials/attachments and build vendor request drafts."
        self.preview_text.insert(tk.END, msg)
        return count

    def add_selected_emails_to_selected_group(self):
