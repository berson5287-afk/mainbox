        return result

    if contains_any_phrase(combined_l, CUSTOMER_WAITING_PHRASES) or text_mentions_po_or_order(combined_l):
        matched = matched_phrases(combined_l, CUSTOMER_WAITING_PHRASES)
        result.update({
            "sender_type": "customer_or_prospect",
