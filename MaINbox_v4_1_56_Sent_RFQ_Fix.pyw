def mainbox_version_number():
    """v3.9.105: numeric app version parsed from APP_TITLE (e.g. "3.9.105").

    Used for the Brain-bridge heartbeat so the reported version can never go
    stale again (it was hardcoded "3.9.42" long after that release)."""
    try:
        m = re.search(r"v(\d+(?:\.\d+)+)", APP_TITLE)
        return m.group(1) if m else "0.0.0"
    except Exception:
        return "0.0.0"


