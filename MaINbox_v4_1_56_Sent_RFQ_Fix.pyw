        except Exception:
            pass

    def get_row_tag(self, email):
        if email.get("is_new_import"):
            return "new_import"
        urgency = email["urgency"]
        status = email["status"]
        if urgency == "Low":
            urgency = "Normal"
        if status == "Needs Reply":
            status_key = "needs_reply"
        elif status in ["Waiting on Customer", "Waiting on Vendor"]:
            status_key = "waiting"
        elif status == "Completed":
            status_key = "completed"
        else:
            status_key = "normal"
        return f"{urgency.lower()}_{status_key}"

    def get_importance_rank(self, email):
        urgency = email.get("urgency", "Normal")
        status = email.get("status", "New")
        if urgency == "Critical":
            return 0
        if urgency == "High":
            return 1
        if status == "Needs Reply":
            return 2
        if status in ["Waiting on Customer", "Waiting on Vendor"]:
            return 3
        if status == "New":
            return 4
        if status == "Completed":
            return 5
        return 6

    def sort_emails_for_display(self):
        self.emails.sort(key=lambda email: (self.get_importance_rank(email), -email.get("received_timestamp", 0)))

    def get_my_inbox_folder(self):
        folder = self.get_my_inbox_folder_safe()
        if folder is None:
            raise RuntimeError("Outlook Inbox is not available right now. Outlook may be busy or reconnecting.")
        return folder

    def find_sales_inbox_folder(self):
        try:
            folders = self.namespace.Folders
            for i in range(1, folders.Count + 1):
                root = folders.Item(i)
                if SALES_MAILBOX_NAME.lower() in str(root.Name).lower():
                    try:
                        return root.Folders.Item("Inbox")
                    except Exception:
                        return root
            for i in range(1, folders.Count + 1):
                root = folders.Item(i)
                try:
                    return root.Folders.Item(SALES_MAILBOX_NAME)
                except Exception:
                    pass
        except Exception:
            pass
        return None

    # ------------------------------------------------------------------
    # v4.1.15 Closed Email Resurfacing Guard
    # ------------------------------------------------------------------
    @staticmethod
    def _guard_iso(value):
        try:
            return datetime.fromisoformat(str(value or "").replace("Z", "+00:00")).timestamp()
        except Exception:
            return 0.0

    @staticmethod
    def _guard_imid(value):
        try:
            return re.sub(r"\s+", "", str(value or "")).strip().lower()
        except Exception:
            return ""

    def _load_closed_email_guard(self):
        try:
            data = load_json(CLOSED_EMAIL_GUARD_FILE, {"version": 2, "records": {}, "reopened": {}})
            if not isinstance(data, dict):
                data = {}
            data["version"] = 2
            if not isinstance(data.get("records"), dict):
                data["records"] = {}
            if not isinstance(data.get("reopened"), dict):
                data["reopened"] = {}
            return data
        except Exception:
            return {"version": 2, "records": {}, "reopened": {}}

    @contextlib.contextmanager
    def _bulk_write(self):
        """v4.1.52 FREEZE FIX. Marking N emails at once used to perform up to ~4N
        fsync'd whole-file writes ON THE UI THREAD, freezing the app for the length
        of the selection. Per email the cascade was:

            save_selected_changes / set_selected_status_from_menu (the loop)
              -> save_record -> record_closed_email_guard(save=True)
                   -> _save_closed_email_guard -> save_json(closed guard)   [write 1]
              -> learn_from_user_correction
                   -> save_record -> _save_closed_email_guard (again)        [write 2]
                   -> save_learning_data -> save_json(learning) + SQLite      [write 3]
                   -> learn_followup_behavior (Low/Junk/Completed => no_followup)
                        -> save_learning_data (again) + SQLite                [write 4]

        Each save_json is a full json.dump(indent=2) of a file holding up to
        LEARNING_MAX_RULES_PER_BUCKET (1500) rules per bucket, fsync'd and atomically
        replaced -- and the learning file is additionally re-serialized and committed
        to SQLite. On a OneDrive-synced path with antivirus that is ~1s each, so a
        ~40-email mark froze the UI for ~4 minutes (observed 2026-07-20 10:20, a
        245.9s freeze while a background quote scan contended for the same disk).

        Inside this context the two high-frequency writers only mark their file
        DIRTY; each is flushed ONCE on exit. The per-item in-memory mutations are
        unchanged, so the on-disk end state is identical. Nesting-safe via a depth
        counter; the flush runs in a finally so an exception mid-loop still commits
        the work already done. This mirrors the discipline the reopen path already
        used (clear_closed_email_guard(save=False) then a single flush)."""
        self._bulk_write_depth = int(getattr(self, "_bulk_write_depth", 0)) + 1
        try:
            yield
        finally:
            self._bulk_write_depth = max(0, int(getattr(self, "_bulk_write_depth", 1)) - 1)
            if self._bulk_write_depth == 0:
                if getattr(self, "_bulk_guard_dirty", False):
                    self._bulk_guard_dirty = False
                    try:
                        self._save_closed_email_guard()
                    except Exception:
                        pass
                if getattr(self, "_bulk_learning_dirty", False):
                    self._bulk_learning_dirty = False
                    try:
                        self.save_learning_data()
                    except Exception:
                        pass

    def _save_closed_email_guard(self):
        # v4.1.52: during a bulk operation, defer the write -- the in-memory guard is
        # already updated; _bulk_write flushes it once on exit.
        if int(getattr(self, "_bulk_write_depth", 0)) > 0:
            self._bulk_guard_dirty = True
            return True
        try:
            os.makedirs(DEVICE_GUARD_DIR, exist_ok=True)
            if not isinstance(getattr(self, "closed_email_guard", None), dict):
                self.closed_email_guard = {"version": 2, "records": {}, "reopened": {}}
            self.closed_email_guard["version"] = 2
            self.closed_email_guard.setdefault("records", {})
            self.closed_email_guard.setdefault("reopened", {})
            self.closed_email_guard["updated_at"] = datetime.now().isoformat()
            save_json(CLOSED_EMAIL_GUARD_FILE, self.closed_email_guard)
            return True
        except Exception:
            return False

    def _guard_identity_keys(self, record):
        """Per-message keys only. ConversationID is intentionally excluded because it
        identifies a whole thread and is shared by genuinely new replies."""
        keys = []
        try:
            rec = record or {}
            eid = str(rec.get("entry_id", "") or "").strip()
            if eid:
                keys.append("eid:" + eid)
            imid = self._guard_imid(rec.get("internet_message_id", ""))
            if imid:
                keys.append("imid:" + imid)
            cidx = str(rec.get("conversation_index", "") or "").strip()
            if cidx:
                keys.append("cidx:" + hashlib.sha256(cidx.encode("utf-8", "ignore")).hexdigest())
            subj = normalize_subject_for_match(rec.get("subject", "") or rec.get("normalized_subject", "") or "")
            sender = str(rec.get("sender_email", "") or rec.get("sender", "") or "").strip().lower()
            try:
                ts = int(round(float(rec.get("received_timestamp", 0) or 0)))
            except Exception:
                ts = 0
            if subj and sender and ts:
                raw = f"{sender}|{subj}|{ts}"
                keys.append("sst:" + hashlib.sha256(raw.encode("utf-8", "ignore")).hexdigest())
        except Exception:
            pass
        return list(dict.fromkeys(keys))

    def _guard_same_message_fallback(self, a, b):
        """Tight fallback for legacy rows with no Message-ID/ConversationIndex."""
        try:
            asub = normalize_subject_for_match((a or {}).get("subject", "") or (a or {}).get("normalized_subject", "") or "")
            bsub = normalize_subject_for_match((b or {}).get("subject", "") or (b or {}).get("normalized_subject", "") or "")
            asender = str((a or {}).get("sender_email", "") or (a or {}).get("sender", "") or "").strip().lower()
            bsender = str((b or {}).get("sender_email", "") or (b or {}).get("sender", "") or "").strip().lower()
            ats = float((a or {}).get("received_timestamp", 0) or 0)
            bts = float((b or {}).get("received_timestamp", 0) or 0)
            return bool(asub and asub == bsub and asender and asender == bsender and ats and bts and abs(ats - bts) <= 120)
        except Exception:
            return False

    def _find_reopened_email_guard(self, probe):
        """Return the newest explicit-open decision for this exact message, if any.

        Open decisions are retained locally rather than merely deleting the close marker. This
        matters after a whole-snapshot cloud restore: an older snapshot may say Completed, but
        the machine-local reopen decision must still win if the user reopened it later.
        """
        try:
            records = (getattr(self, "closed_email_guard", None) or {}).get("reopened", {})
            found = []
            seen = set()
            for key in self._guard_identity_keys(probe or {}):
                rec = records.get(key)
                if isinstance(rec, dict):
                    sig = (rec.get("decision_at", ""), rec.get("entry_id", ""), rec.get("internet_message_id", ""), rec.get("conversation_index", ""))
                    if sig not in seen:
                        found.append(rec)
                        seen.add(sig)
            if not found:
                for rec in records.values():
                    if not isinstance(rec, dict) or not self._guard_same_message_fallback(probe, rec):
                        continue
                    sig = (rec.get("decision_at", ""), rec.get("entry_id", ""), rec.get("internet_message_id", ""), rec.get("conversation_index", ""))
                    if sig not in seen:
                        found.append(rec)
                        seen.add(sig)
            if not found:
                return {}
            return dict(max(found, key=lambda r: self._guard_iso(r.get("decision_at") or r.get("updated_at"))))
        except Exception:
            return {}

    def _find_closed_email_guard(self, probe, saved_record=None):
        try:
            records = (getattr(self, "closed_email_guard", None) or {}).get("records", {})
            found = []
            seen = set()
            for key in self._guard_identity_keys(probe or {}):
                rec = records.get(key)
                if isinstance(rec, dict):
                    sig = (rec.get("decision_at", ""), rec.get("entry_id", ""), rec.get("internet_message_id", ""), rec.get("conversation_index", ""))
                    if sig not in seen:
                        found.append(rec)
                        seen.add(sig)
            if not found:
                for rec in records.values():
                    if not isinstance(rec, dict) or not self._guard_same_message_fallback(probe, rec):
                        continue
                    sig = (rec.get("decision_at", ""), rec.get("entry_id", ""), rec.get("internet_message_id", ""), rec.get("conversation_index", ""))
                    if sig not in seen:
                        found.append(rec)
                        seen.add(sig)
            if not found:
                return {}
            best = max(found, key=lambda r: self._guard_iso(r.get("decision_at") or r.get("workflow_closed_at") or r.get("updated_at")))
            reopened_times = []
            if isinstance(saved_record, dict) and saved_record.get("explicit_reopened_at"):
                reopened_times.append(saved_record.get("explicit_reopened_at"))
            if isinstance(probe, dict) and probe.get("explicit_reopened_at"):
                reopened_times.append(probe.get("explicit_reopened_at"))
            reopened_rec = self._find_reopened_email_guard(probe or {})
            if reopened_rec.get("decision_at"):
                reopened_times.append(reopened_rec.get("decision_at"))
            latest_reopen = max((self._guard_iso(v) for v in reopened_times), default=0.0)
            if latest_reopen >= self._guard_iso(best.get("decision_at")):
                return {}
            return dict(best)
        except Exception:
            return {}

    def _closed_guard_snapshot(self, record):
        rec = dict(record or {})
        if not self.workflow_record_is_closed(rec):
            return {}
        when = str(rec.get("workflow_closed_at") or rec.get("deleted_from_app_at") or rec.get("updated_at") or datetime.now().isoformat())
        app_deleted = bool(rec.get("app_deleted", False))
        if app_deleted:
            kind = "app_deleted"
        elif rec.get("status") == "Completed":
            kind = "completed"
        elif rec.get("urgency") == "Low":
            kind = "low"
        else:
            kind = "junk"
        return {
            "decision": "closed", "decision_at": when, "workflow_closed_at": when,
            "closure_kind": kind, "app_deleted": app_deleted,
            "category": rec.get("category", ""), "urgency": rec.get("urgency", ""),
            "status": rec.get("status", ""), "ai_user_locked": bool(rec.get("ai_user_locked", False)),
            "prevent_future_followups": bool(rec.get("prevent_future_followups", False) or app_deleted),
            "entry_id": str(rec.get("entry_id", "") or ""), "store_id": str(rec.get("store_id", "") or ""),
            "internet_message_id": str(rec.get("internet_message_id", "") or ""),
            "conversation_index": str(rec.get("conversation_index", "") or ""),
            "conversation_id": str(rec.get("conversation_id", "") or ""),
            "sender": str(rec.get("sender", "") or ""), "sender_email": str(rec.get("sender_email", "") or ""),
            "subject": str(rec.get("subject", "") or ""),
            "normalized_subject": normalize_subject_for_match(rec.get("subject", "") or rec.get("normalized_subject", "") or ""),
            "received": str(rec.get("received", "") or ""), "received_timestamp": rec.get("received_timestamp", 0) or 0,
            "source": str(rec.get("source", "") or ""), "updated_at": str(rec.get("updated_at", "") or when),
        }

    def record_closed_email_guard(self, record, save=True):
        try:
            snap = self._closed_guard_snapshot(record)
            keys = self._guard_identity_keys(snap)
            if not snap or not keys:
                return False
            if not isinstance(getattr(self, "closed_email_guard", None), dict):
                self.closed_email_guard = {"version": 2, "records": {}, "reopened": {}}
            # Never let a stale restored Completed row supersede a later explicit reopen.
            reopened = self._find_reopened_email_guard(snap)
            if reopened and self._guard_iso(reopened.get("decision_at")) >= self._guard_iso(snap.get("decision_at")):
                return False
            records = self.closed_email_guard.setdefault("records", {})
            changed = False
            for key in keys:
                old = records.get(key)
                if isinstance(old, dict) and self._guard_iso(old.get("decision_at")) > self._guard_iso(snap.get("decision_at")):
                    continue
                candidate = dict(snap)
                if isinstance(old, dict) and old.get("decision_at") == candidate.get("decision_at"):
                    candidate["updated_at"] = old.get("updated_at", candidate.get("updated_at", ""))
                if old != candidate:
                    records[key] = candidate
                    changed = True
            if changed and save:
                self._save_closed_email_guard()
            return changed
        except Exception:
            return False

    def clear_closed_email_guard(self, record, save=True):
        """Record an explicit user reopen/restore; automation never calls this.

        The open marker is intentionally retained outside the cloud-restored MaINbox folder, so
        an older full snapshot cannot silently re-close an email the user reopened afterward.
        """
        try:
            if not isinstance(getattr(self, "closed_email_guard", None), dict):
                self.closed_email_guard = {"version": 2, "records": {}, "reopened": {}}
            records = self.closed_email_guard.setdefault("records", {})
            reopened_records = self.closed_email_guard.setdefault("reopened", {})
            probe = dict(record or {})
            when = str(probe.get("explicit_reopened_at") or datetime.now().isoformat())
            probe["explicit_reopened_at"] = when
            keys = self._guard_identity_keys(probe)
            changed = False
            reopen_snap = {
                "decision": "open", "decision_at": when, "updated_at": when,
                "entry_id": str(probe.get("entry_id", "") or ""),
                "store_id": str(probe.get("store_id", "") or ""),
                "internet_message_id": str(probe.get("internet_message_id", "") or ""),
                "conversation_index": str(probe.get("conversation_index", "") or ""),
                "conversation_id": str(probe.get("conversation_id", "") or ""),
                "sender": str(probe.get("sender", "") or ""),
                "sender_email": str(probe.get("sender_email", "") or ""),
                "subject": str(probe.get("subject", "") or ""),
                "normalized_subject": normalize_subject_for_match(probe.get("subject", "") or probe.get("normalized_subject", "") or ""),
                "received": str(probe.get("received", "") or ""),
                "received_timestamp": probe.get("received_timestamp", 0) or 0,
                "source": str(probe.get("source", "") or ""),
            }
            for key in keys:
                old_open = reopened_records.get(key)
                if not isinstance(old_open, dict) or self._guard_iso(old_open.get("decision_at")) <= self._guard_iso(when):
                    if old_open != reopen_snap:
                        reopened_records[key] = dict(reopen_snap)
                        changed = True
            probe_keys = set(keys)
            for key, rec in list(records.items()):
                if not (key in probe_keys or (isinstance(rec, dict) and self._guard_same_message_fallback(probe, rec))):
                    continue
                close_at = self._guard_iso((rec or {}).get("decision_at") or (rec or {}).get("workflow_closed_at"))
                if close_at <= self._guard_iso(when):
                    records.pop(key, None)
                    changed = True
            if changed and save:
                self._save_closed_email_guard()
            return changed
        except Exception:
            return False

    def _email_was_closed_before_edit(self, email):
        """v4.1.16: True when this email is currently closed by ANY authority --
        the in-memory row, the saved status record, or the machine-local closed
        ledger. Every explicit-user edit path calls this BEFORE changing workflow
        fields so a close -> open transition can be detected and recorded."""
        try:
            if not isinstance(email, dict):
                return False
            entry_id = str(email.get("entry_id", "") or "")
            saved = self.status_data.get(entry_id, {}) if (entry_id and isinstance(self.status_data, dict)) else {}
            if self.workflow_record_is_closed(email) or self.workflow_record_is_closed(saved):
                return True
            return bool(self._find_closed_email_guard(email, saved_record=saved if isinstance(saved, dict) else None))
        except Exception:
            return False

    def _record_explicit_reopen_for_email(self, email, save=False):
        """v4.1.16: shared bookkeeping for ANY explicit user action that reopens a
        closed email (right-click status menu, Teach editor, AI Triage Center
        hotkeys, assistant-approved changes, undo, reply-from-Outlook wake-up --
        plus the workflow Save panel / keyboard hotkeys / Restore-from-Deleted
        that v4.1.15 already covered). Stamps explicit_reopened_at on the row and
        records the reopen decision in the machine-local ledger so the closed
        guard cannot re-assert the old close at the next startup or restore.

        Call AFTER the reopening fields are applied and only when
        _email_was_closed_before_edit() was True beforehand. Returns True when
        the ledger changed (caller batches _save_closed_email_guard when
        save=False)."""
        try:
            if not isinstance(email, dict) or self.workflow_record_is_closed(email):
                return False
            when = datetime.now().isoformat()
            email["explicit_reopened_at"] = when
            email["workflow_closed_at"] = ""
            email.pop("closed_guard_applied", None)
            email.pop("closed_guard_decision_at", None)
            probe = dict(email)
            try:
                entry_id = str(email.get("entry_id", "") or "")
                saved = self.status_data.get(entry_id) if (entry_id and isinstance(self.status_data, dict)) else None
                if isinstance(saved, dict):
                    saved["explicit_reopened_at"] = when
                    saved["workflow_closed_at"] = ""
                    saved.pop("closed_guard_applied", None)
                    saved.pop("closed_guard_decision_at", None)
                    # v4.1.18 audit: some callers (AI Triage Center rows) pass a THIN dict with
                    # no Message-ID/ConversationIndex/timestamp. The ledger's close records are
                    # keyed on those, so clear with the saved record's full identity merged in --
                    # otherwise a later EntryID drift could resurface a close the user reopened.
                    probe = dict(saved)
                    probe.update({k: v for k, v in email.items() if v not in (None, "")})
                    probe["explicit_reopened_at"] = when
                    probe["workflow_closed_at"] = ""
            except Exception:
                probe = dict(email)
            return self.clear_closed_email_guard(probe, save=save)
        except Exception:
            return False

    def _reconcile_closed_email_guard_after_undo(self):
        """v4.1.16: Ctrl+Z restores a whole status_data snapshot, which can put the
        saved records out of agreement with the machine-local closed ledger in BOTH
        directions. Undo is an explicit user decision, so the restored snapshot wins:

        * A record the snapshot shows OPEN while the ledger still holds a close
          (user undid a Complete/Low/Junk/app-delete) gets a fresh reopen decision,
          so the guard cannot silently re-apply the close at the next startup. For
          an undone app-delete this also keeps the email visible at all -- without
          it the guard's app_deleted marker made the row vanish from refresh while
          undo had already removed it from Deleted History.
        * A record the snapshot shows CLOSED while the ledger holds a NEWER reopen
          (user undid a reopen) gets its close decision re-stamped to now, so the
          re-close survives both the reopen ledger and v4.1.16's reopen enforcement.
        """
        changed = False
        try:
            now_iso = datetime.now().isoformat()
            for eid, rec in list((getattr(self, "status_data", None) or {}).items()):
                if not isinstance(rec, dict):
                    continue
                probe = dict(rec)
                probe.setdefault("entry_id", eid)
                if self.workflow_record_is_closed(rec):
                    reopen = self._find_reopened_email_guard(probe)
                    close_at = self._guard_iso(
                        probe.get("workflow_closed_at")
                        or probe.get("deleted_from_app_at")
                        or probe.get("updated_at")
                    )
                    if reopen and self._guard_iso(reopen.get("decision_at")) >= close_at:
                        # Undo re-closed an email the ledger says was reopened later:
                        # re-stamp the close so it is the newest decision again.
                        rec["workflow_closed_at"] = now_iso
                        rec["explicit_reopened_at"] = ""
                        probe = dict(rec)
                        probe.setdefault("entry_id", eid)
                    if self.record_closed_email_guard(probe, save=False):
                        changed = True
                else:
                    if self._find_closed_email_guard(probe, saved_record=rec):
                        rec["explicit_reopened_at"] = now_iso
                        rec["workflow_closed_at"] = ""
                        rec.pop("closed_guard_applied", None)
                        rec.pop("closed_guard_decision_at", None)
                        probe = dict(rec)
                        probe.setdefault("entry_id", eid)
                        if self.clear_closed_email_guard(probe, save=False):
                            changed = True
            if changed:
                self._save_closed_email_guard()
        except Exception:
            pass
        return changed

    def _bootstrap_closed_email_guard(self):
        changed = False
        try:
            for eid, rec in list((getattr(self, "status_data", None) or {}).items()):
                if not isinstance(rec, dict) or not self.workflow_record_is_closed(rec):
                    continue
                snap = dict(rec)
                snap.setdefault("entry_id", eid)
                if not snap.get("workflow_closed_at"):
                    snap["workflow_closed_at"] = snap.get("deleted_from_app_at") or snap.get("updated_at") or datetime.now().isoformat()
                if self.record_closed_email_guard(snap, save=False):
                    changed = True
            if changed:
                self._save_closed_email_guard()
        except Exception:
            pass
        return changed

    def _apply_closed_email_guard_to_statuses(self):
        changed = False
        try:
            for eid, rec in list((getattr(self, "status_data", None) or {}).items()):
                if not isinstance(rec, dict):
                    continue
                probe = dict(rec)
                probe.setdefault("entry_id", eid)
                guard = self._find_closed_email_guard(probe, saved_record=rec)
                if not guard:
                    # v4.1.16: ENFORCE the reopen ledger too. v4.1.15 recorded explicit
                    # reopen decisions and used them to stop the guard from re-asserting
                    # an old close -- but when a stale cloud snapshot restored the record
                    # as Completed/Low/Junk/deleted, nothing flipped it back open, so the
                    # user's newer reopen decision was still lost. If this record is
                    # closed and the machine-local ledger holds a reopen decision NEWER
                    # than the record's close time, the reopen wins: undo exactly the
                    # closing fields (and nothing else).
                    if self.workflow_record_is_closed(rec):
                        reopen = self._find_reopened_email_guard(probe)
                        close_at = self._guard_iso(
                            rec.get("workflow_closed_at")
                            or rec.get("deleted_from_app_at")
                            or rec.get("updated_at")
                        )
                        own_reopen_at = self._guard_iso(rec.get("explicit_reopened_at"))
                        reopen_at = self._guard_iso((reopen or {}).get("decision_at"))
                        if reopen and reopen_at >= close_at and reopen_at > own_reopen_at:
                            if rec.get("app_deleted"):
                                rec["app_deleted"] = False
                            if rec.get("status", "") == "Completed":
                                rec["status"] = "New"
                            if rec.get("urgency", "") == "Low":
                                rec["urgency"] = "Normal"
                            if rec.get("category", "") == "Junk / Ignore":
                                rec["category"] = "General"
                            rec["workflow_closed_at"] = ""
                            rec["explicit_reopened_at"] = str(reopen.get("decision_at", "") or "")
                            rec.pop("closed_guard_applied", None)
                            rec.pop("closed_guard_decision_at", None)
                            self.status_data[eid] = rec
                            changed = True
                    continue
                for field in ("category", "urgency", "status", "app_deleted", "ai_user_locked",
                              "prevent_future_followups", "workflow_closed_at"):
                    if guard.get(field) not in (None, "") and rec.get(field) != guard.get(field):
                        rec[field] = guard.get(field)
                        changed = True
                rec["closed_guard_applied"] = True
                rec["closed_guard_decision_at"] = guard.get("decision_at", "")
                self.status_data[eid] = rec
        except Exception:
            pass
        return changed

    def workflow_record_is_closed(self, record):
        """Return True for user-closed/hidden workflow states that refresh/AI must not reopen."""
        try:
            record = record or {}
            return (
                bool(record.get("app_deleted", False))
                or record.get("status", "") == "Completed"
                or record.get("urgency", "") == "Low"
                or record.get("category", "") == "Junk / Ignore"
            )
        except Exception:
            return False

    def find_saved_status_for_email_fields(self, entry_id="", conversation_id="", conversation_index="", sender_email="", sender="", subject="", received_timestamp=0, source="", internet_message_id=""):
        """Find the saved workflow record for an Outlook item.

        Primary key is Outlook EntryID.  A conservative fallback is used because Outlook/Exchange can
        occasionally surface the same message with a different EntryID after sync/move/cache changes.
        This prevents a user-closed item (Low/Completed/Junk/app-deleted) from reappearing as New.
        """
        try:
            entry_id = str(entry_id or "").strip()
            direct = self.status_data.get(entry_id) if entry_id and isinstance(self.status_data, dict) else {}
            probe = {
                "entry_id": entry_id, "conversation_id": conversation_id, "conversation_index": conversation_index,
                "sender_email": sender_email, "sender": sender, "subject": subject,
                "received_timestamp": received_timestamp, "source": source,
                "internet_message_id": internet_message_id,
                "explicit_reopened_at": direct.get("explicit_reopened_at", "") if isinstance(direct, dict) else "",
            }
            guard = self._find_closed_email_guard(probe, saved_record=direct)
            if guard:
                merged = dict(direct) if isinstance(direct, dict) else {}
                merged.update(guard)
                merged["entry_id"] = entry_id or merged.get("entry_id", "")
                merged["closed_guard_applied"] = True
                return merged
            if isinstance(direct, dict) and direct:
                return direct

            # v3.9.82: Internet Message-ID (RFC 5322 Message-ID) is assigned by the
            # originating server and stays constant even when Cached Exchange Mode hands
            # the same message a NEW Outlook EntryID after a re-sync/cache rebuild. Match
            # on it first: it is message-unique, so this can never bury a genuinely new
            # reply (a new reply is a different message with its own Message-ID).
            imid = str(internet_message_id or "").strip().lower()
            if imid and isinstance(self.status_data, dict):
                for _eid, _rec in list(self.status_data.items()):
                    if not isinstance(_rec, dict):
                        continue
                    if str(_rec.get("internet_message_id", "") or "").strip().lower() == imid:
                        return _rec

            cidx = str(conversation_index or "").strip()
            if cidx and isinstance(self.status_data, dict):
                for _eid, _rec in list(self.status_data.items()):
                    if isinstance(_rec, dict) and str(_rec.get("conversation_index", "") or "").strip() == cidx:
                        return _rec

            normalized_subject = normalize_subject_for_match(subject or "")
            sender_key = str(sender_email or sender or "").strip().lower()
            conversation_id = str(conversation_id or "").strip().lower()
            source = str(source or "").strip()
            try:
                ts = float(received_timestamp or 0)
            except Exception:
                ts = 0.0
            if not isinstance(self.status_data, dict) or not normalized_subject or not sender_key:
                return {}

            best = None
            best_score = -1
            for old_entry_id, rec in list(self.status_data.items()):  # v3.9.82: snapshot - worker thread iterates while main-thread drip may write status_data
                if not isinstance(rec, dict):
                    continue
                rec_subject = normalize_subject_for_match(rec.get("subject", "") or rec.get("normalized_subject", "") or "")
                if rec_subject != normalized_subject:
                    continue

                # v3.9.2: compute the timestamp delta and the closed/suppressed state up front so
                # the sender gate can stay strict for active rows but tolerant for rows we are
                # deliberately keeping hidden (app-deleted / Low / Completed / Junk).
                try:
                    rec_ts = float(rec.get("received_timestamp", 0) or 0)
                except Exception:
                    rec_ts = 0.0
                delta = abs(ts - rec_ts) if (ts and rec_ts) else None
                rec_is_closed = self.workflow_record_is_closed(rec)
                rec_conv = str(rec.get("conversation_id", "") or "").strip().lower()
                same_conversation = bool(conversation_id and rec_conv and rec_conv == conversation_id)

                # Cached Exchange Mode can resurface the SAME message with a new EntryID AND a
                # different sender_email form (SMTP vs the X500 "/O=EXCHANGE/..." address). The old
                # strict gate then dropped the suppressed record and the deleted/Low/Completed item
                # came back as new. Only relax the sender mismatch when this is clearly the same
                # delivered message (same conversation, or identical normalized subject within a
                # tight 120s window) AND the stored record is one we are actively suppressing.
                rec_sender = str(rec.get("sender_email", "") or rec.get("sender", "") or "").strip().lower()
                if rec_sender and rec_sender != sender_key:
                    tolerant = rec_is_closed and (same_conversation or (delta is not None and delta <= 120))
                    if not tolerant:
                        continue

                score = 0
                if same_conversation:
                    score += 5
                rec_source = str(rec.get("source", "") or "").strip()
                if source and rec_source and rec_source == source:
                    score += 1
                if delta is not None:
                    if delta <= 60:
                        score += 4
                    elif delta <= 600:
                        score += 2
                    else:
                        # ConversationID identifies the thread, not this individual message.
                        # A later real reply often shares sender, subject, and ConversationID.
                        continue
                else:
                    # No Message-ID/ConversationIndex/timestamp means identity is ambiguous.
                    continue
                if rec_is_closed:
                    score += 2
                if score > best_score:
                    best = rec
                    best_score = score
            return dict(best) if best and best_score >= 4 else {}
        except Exception:
            return {}

    def apply_saved_workflow_to_email(self, email, saved=None):
        """Overlay durable workflow fields from status_data onto an in-memory email row."""
        try:
            if not isinstance(email, dict):
                return email
            saved = saved if isinstance(saved, dict) else self.status_data.get(email.get("entry_id", ""), {})
            if not isinstance(saved, dict) or not saved:
                return email
            for field in [
                "category", "urgency", "status", "sender_type", "email_type", "sender_intent",
                "reply_intent", "business_relevance", "spam_likelihood", "same_subject_related_count",
                "ai_triaged_at", "ai_triage_pending", "needs_followup_ai", "ai_triage_reason",
                "followup_reason_ai", "followup_blocked_reason", "trusted_sender", "learned_rule_source",
                "sales_inbox_duplicate_hidden", "sales_inbox_duplicate_hidden_at", "rescued_at",
                "sent_waiting_tracker_active", "sent_waiting_tracker_sent_timestamp", "ai_user_locked", "ai_triage_skipped",
                "workflow_closed_at", "explicit_reopened_at", "closed_guard_applied"
            ]:
                if field in saved and saved.get(field) not in (None, ""):
                    email[field] = saved.get(field)
            return email
        except Exception:
            return email

    def saved_workflow_is_closed_for_email(self, email):
        try:
            if not isinstance(email, dict):
                return False
            saved = self.status_data.get(email.get("entry_id", ""), {}) if isinstance(self.status_data, dict) else {}
            return self.workflow_record_is_closed(saved) or self.workflow_record_is_closed(email)
        except Exception:
            return False

    def upsert_email(self, email):
        entry_id = email.get("entry_id", "")
        if not entry_id:
            return False
        # v3.9.27 efficiency: the old code linearly scanned self.emails for the existing
        # row, then ran dedupe_email_rows() (which includes a quadratic Sales/My-Inbox
        # cross-check) AND a full index rebuild on EVERY imported message. On a refresh
        # importing a few hundred messages into a couple thousand cached rows that was
        # the single biggest freeze source. The index already maps entry_id -> row, so:
        # find via index, replace/append in place, update the index incrementally, and
        # leave the one full dedupe pass to the refresh orchestrators (refresh_new_emails
        # runs cleanup_duplicates(pre_render) and every save_cached_state() dedupes too).
        idx = getattr(self, "_email_index", None)
        if idx is None:
            self._rebuild_email_index()
            idx = self._email_index
        existing = idx.get(entry_id)
        if existing is not None and existing.get("entry_id") != entry_id:
            existing = None  # stale index hit; treat as miss and repair below
        if existing is None:
            for row in self.emails:
                if isinstance(row, dict) and row.get("entry_id") == entry_id:
                    existing = row
                    idx[entry_id] = row
                    break
        if existing is not None:
            # Durable saved workflow state wins over stale cache rows.
            # This prevents Low/Completed/Junk/app-deleted decisions from being reopened on refresh.
            saved = self.status_data.get(entry_id, {}) if isinstance(self.status_data, dict) else {}
            if saved.get("app_deleted"):
                try:
                    self.emails = [e for e in self.emails if e is not existing]
                    idx.pop(entry_id, None)
                except Exception:
                    pass
                return False
            if saved:
                self.apply_saved_workflow_to_email(email, saved)
            else:
                email["category"] = existing.get("category", email.get("category", "General"))
                email["urgency"] = existing.get("urgency", email.get("urgency", "Normal"))
                email["status"] = existing.get("status", email.get("status", "New"))
            email["followup_time"] = self.get_followup_display_for_email(entry_id)
            email["is_new_import"] = existing.get("is_new_import", False)

            # Preserve cached body content across refreshes so refresh does not throw it away.
            existing_body = existing.get("body", "") or ""
            email["body"] = existing_body
            email["body_loaded"] = bool(existing_body)

            merged = self._merge_duplicate_email_rows(email, existing)
            # v3.9.48: a Refresh must NEVER re-classify an email already in the list. The existing
            # in-memory row carries the user's authoritative workflow (manual edits, triage result,
            # user-lock), which can legitimately be newer than status_data -- e.g. an edit whose
            # Outlook EntryID drifted under Cached Exchange Mode, or any state status_data didn't
            # capture. Force these fields from the existing row to win over the freshly re-imported
            # / status_data values so a refresh can never snap urgency/category/status back.
            # (app_deleted is handled above and still wins.)
            for _f in ("category", "urgency", "status", "email_type",
                       "ai_triaged_at", "ai_triage_pending", "ai_user_locked"):
                _ev = existing.get(_f)
                if _ev not in (None, ""):
                    merged[_f] = _ev
            # Keep status_data in agreement with the row that just won, so it can't stay stale and
            # cause a later refresh/restart to disagree.
            try:
                _sd = self.status_data.get(entry_id) if isinstance(self.status_data, dict) else None
                if isinstance(_sd, dict):
                    for _f in ("category", "urgency", "status"):
                        if merged.get(_f) not in (None, ""):
                            _sd[_f] = merged.get(_f)
            except Exception:
                pass
            for i, row in enumerate(self.emails):
                if row is existing:
                    self.emails[i] = merged
                    break
            idx[entry_id] = merged
            return False

        saved = self.status_data.get(entry_id, {}) if isinstance(self.status_data, dict) else {}
        if saved:
            if saved.get("app_deleted"):
                return False
            self.apply_saved_workflow_to_email(email, saved)
        email["is_new_import"] = True
        email["followup_time"] = self.get_followup_display_for_email(entry_id)
        email["body"] = email.get("body", "") or ""
        email["body_loaded"] = bool(email["body"])
        self.emails.append(email)
        idx[entry_id] = email
        return True

    def _mb_quote_scan(self):
        try:
            from mainbox_quote_pipeline_entry import run_quote_scan
            run_quote_scan(self)
        except Exception:
            import traceback; traceback.print_exc()

    def refresh_new_emails(self):
        """v3.9.40: manual Refresh now runs the Outlook mailbox walk on a BACKGROUND engine
        (a worker thread with its own thread-local COM namespace) and applies the results on
        the Tk main thread, so the UI stays fully responsive during a refresh instead of
        freezing for minutes while Outlook is walked on a slow/uncached mailbox.

        Sent-tracker reconciliation is handled as emails come in (cached clears in the apply
        step) rather than via a synchronous Sent Items scan, which was a large part of the old
        freeze. The heavy Outlook property reads all happen on the worker; the main-thread apply
        is cached-only and fast."""
        if getattr(self, "_refresh_running", False):
            try:
                self.last_updated_var.set("Refresh already in progress \u2014 still working in the background...")
            except Exception:
                pass
            return
        # Commit any visible manual workflow dropdown edits before the refresh re-imports/renders.
        try:
            self.save_pending_selected_workflow_edits_before_refresh()
        except Exception:
            pass
        # v3.9.48: snapshot every existing email's workflow the instant Refresh begins. The
        # background mailbox walk frees the main thread (that is what stops the freeze), so a
        # timer (the auto-triage drip) or an in-flight triage can mutate these rows WHILE the
        # refresh rebuilds them -- which is how a manually-set urgency/category/status was being
        # lost. We restore this snapshot after the rebuild, so Refresh can never change a workflow
        # the user already set. Keyed by EntryID, with a stable subject+sender+timestamp fallback
        # so it still matches if Cached Exchange Mode hands the same message back with a new EntryID.
        try:
            self._pre_refresh_wf_by_eid = {}
            self._pre_refresh_wf_by_key = {}
            for _e in self.emails:
                if not isinstance(_e, dict):
                    continue
                _rec = {
                    "category": _e.get("category"),
                    "urgency": _e.get("urgency"),
                    "status": _e.get("status"),
                    "email_type": _e.get("email_type"),
                    "ai_triaged_at": _e.get("ai_triaged_at"),
                    "ai_triage_pending": _e.get("ai_triage_pending"),
                    "ai_user_locked": _e.get("ai_user_locked"),
                    "ai_triage_skipped": _e.get("ai_triage_skipped"),
                }
                _eid = _e.get("entry_id")
                if _eid:
                    self._pre_refresh_wf_by_eid[_eid] = _rec
                try:
                    _subj = normalize_subject_for_match(_e.get("subject", "") or "")
                    _snd = str(_e.get("sender_email", "") or _e.get("sender", "") or "").strip().lower()
                    _ts = int(float(_e.get("received_timestamp", 0) or 0))
                    if _subj and _snd:
                        self._pre_refresh_wf_by_key[(_subj, _snd, _ts)] = _rec
                except Exception:
                    pass
        except Exception:
            self._pre_refresh_wf_by_eid = {}
            self._pre_refresh_wf_by_key = {}
        self._refresh_running = True
        try:
            self.last_updated_var.set("Refreshing in the background \u2014 you can keep working\u2026")
            self.connection_status_var.set("Outlook: refreshing")
        except Exception:
            pass

        def work(outlook, namespace):
            # v3.9.86: COLLECT ONLY. The inbox quote-coverage scan used to run here, on the
            # worker, BEFORE the collected mail was handed back -- which meant new mail could
            # not render until that scan finished reading up to 150 bodies x2 folders (and
            # parsing PDF/Excel attachments). That was the bulk of the "Refresh takes a while
            # before anything appears" wait. The scan still runs (vendor pricing arrives inbound
            # and must flip requested items to Quoted), but it has moved to a SEPARATE background
            # pass (_refresh_start_quote_scan_pass) that fires AFTER the new mail is on screen.
            # Returning the collected dicts immediately is what lets the fast apply + render run
            # first. (scan_recent_inbox_for_quotes remains worker-safe -- it connects its own
            # thread-local namespace via fresh_outlook + saves coverage atomically.)
            return self._refresh_collect_inbound(namespace)

        def done(collected):
            # v3.9.86: the fast apply upserts + renders the new mail immediately, then schedules
            # the deferred finalize pass (closed-thread reconciliation) and, after that, the
            # background quote-coverage scan. _refresh_running stays True across the whole chain
            # and is cleared only at the END of that quote-coverage pass (or its error handler),
            # so a second Refresh / an AutoPilot tick is held off until the cycle fully settles.
            try:
                self._refresh_apply_inbound(collected or [])
            except Exception:
                # Fast apply failed outright (before it could schedule the finalize chain) --
                # clear the flag here so Refresh is never left wedged.
                self._refresh_running = False

        def err(exc):
            self._refresh_running = False
            try:
                msg = str(exc) or ""
                if "already busy" in msg or "skipped this background pass" in msg:
                    # v3.9.60: AutoPilot (or another Outlook worker) holds the serialization
                    # lock. Nothing was changed; the next Refresh/AutoPilot tick will catch up.
                    self.last_updated_var.set("Refresh skipped - a background sync was running. Try Refresh again in a moment.")
                    return
                if self.is_outlook_disconnect_error(exc):
                    self.reset_outlook_connection("manual refresh")
                    self.last_updated_var.set("Outlook reconnecting \u2014 click Refresh again in a moment. Nothing was changed.")
                    self.connection_status_var.set("Outlook: disconnected")
                else:
                    self.last_updated_var.set("Refresh error \u2014 nothing was changed.")
                    self.connection_status_var.set("Outlook: refresh error")
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=err, label="manual-refresh")

    def _collect_folder_dicts(self, folder, source_label, scan_limit, category_filter):
        """v3.9.40 worker side: walk ONE folder newest-first and return plain email dicts via
        build_email_data (which returns message=None, so nothing apartment-bound is marshalled
        back). No upsert, no tracker mutation, no Tk -- safe off the main thread. Mirrors the
        COM walk in import_from_folder but collects instead of applying."""
        out = []
        try:
            messages = folder.Items
            try:
                messages.Sort("[ReceivedTime]", True)
            except Exception:
                pass
            iterable = messages
            using_restrict = False
            if category_filter:
                try:
                    category = self.selected_sales_category.replace("'", "''")
                    restricted = messages.Restrict(f"@SQL=\"urn:schemas-microsoft-com:office:office#Keywords\" LIKE '%{category}%'")
                    restricted.Sort("[ReceivedTime]", True)
                    iterable = restricted
                    using_restrict = True
                except Exception:
                    iterable = messages
                    using_restrict = False
            ordered = []
            try:
                m = iterable.GetFirst()
                guard = 0
                while m is not None and guard < 100000:
                    guard += 1
                    ordered.append(m)
                    if scan_limit is not None and len(ordered) >= scan_limit:
                        break
                    m = iterable.GetNext()
            except Exception:
                ordered = []
            scan_source = ordered if ordered else iterable
            scanned = 0
            for msg in scan_source:
                if scan_limit is not None and scanned >= scan_limit:
                    break
                scanned += 1
                try:
                    if category_filter and not using_restrict:
                        outlook_categories = msg.Categories or ""
                        if not self.email_has_outlook_category(outlook_categories, self.selected_sales_category):
                            continue
                    email = self.build_email_data(msg, source_label)
                    if not email:
                        continue
                    out.append(email)
                except Exception:
                    continue
        except Exception:
            pass
        return out

    def _refresh_collect_inbound(self, namespace):
        """v3.9.40 worker side of Refresh: collect recent My Inbox + Sales emails as plain dicts
        from a thread-local namespace. No state mutation that touches Tk, no rendering."""
        collected = []
        try:
            my_folder = namespace.GetDefaultFolder(6)  # olFolderInbox
            collected.extend(self._collect_folder_dicts(my_folder, "My Inbox", FAST_MY_INBOX_SCAN_LIMIT, False))
        except Exception:
            pass
        try:
            sales_folder = self._find_sales_inbox_folder_in(namespace)
            if sales_folder:
                collected.extend(self._collect_folder_dicts(sales_folder, "Sales", FAST_SALES_SCAN_LIMIT, True))
        except Exception:
            pass
        return collected

    def _refresh_apply_inbound(self, collected):
        """v3.9.40 main-thread side of Refresh: apply the worker-collected email dicts (upsert,
        duplicate suppression, new-item handling), reconcile sent/waiting trackers AS THE REPLIES
        ARRIVE (cached clears -- no Outlook COM), then render and save. Contains no Outlook COM,
        so it cannot freeze the UI no matter how slow the mailbox is."""
        added_my = 0
        added_sales = 0
        hinted = 0  # v3.9.86: count of NEW emails whose subject looks like a quote (free signal)
        self._begin_commitment_batch()
        try:
            for email in collected:
                try:
                    is_new = self.upsert_email(email)
                    self.suppress_my_inbox_duplicate_when_sales_copy_exists(email)
                    if is_new and email.get("urgency") != "Low":
                        self.handle_new_email_after_import(email, silent=True)
                    # Sent trackers are handled as emails come in: a reply that just arrived
                    # clears its matching waiting tracker. Both clears are cached (operate on
                    # self.emails / self.sent_waiting_placeholders), so there is no COM here.
                    self.clear_sent_waiting_placeholder_for_reply(email)
                    self.clear_existing_sent_waiting_tracker_rows_for_reply(email)
                    if is_new:
                        if email.get("source") == "Sales":
                            added_sales += 1
                        else:
                            added_my += 1
                        # v3.9.86: free quote hint -- the subject is already in memory, so this
                        # is a pure string check (NO body load, NO COM). It does not flip any
                        # coverage on its own (that needs the body/attachment line items, read
                        # later by the off-critical-path quote scan); it just lets us surface a
                        # "looks like a quote" count and stage the status bar honestly.
                        try:
                            if self._subject_suggests_quote(email.get("subject", "")):
                                email["quote_subject_hint"] = True
                                hinted += 1
                        except Exception:
                            pass
                except Exception:
                    continue
        finally:
            try:
                self._flush_commitment_batch()
            except Exception:
                pass
        # v3.9.75: re-group any still-ungrouped RFQ-template reply. Nothing re-evaluates an email
        # imported under an older grouping matcher, so a reply that names only a bare job number
        # (now matched as of v3.9.74) would otherwise stay ungrouped forever. Deterministic + cheap.
        try:
            self.retroactively_group_pa_template_replies()
        except Exception:
            pass
        # v4.1.8: heal any email that a wrongful Low tag left buried + ungrouped (see method).
        try:
            self.rescue_wrongly_buried_active_thread_emails()
        except Exception:
            pass
        try:
            self.cleanup_duplicates(reason="pre_render", save=True)
        except Exception:
            pass
        # v3.9.48: restore the workflow snapshot taken when Refresh began, so nothing that ran on
        # the freed main thread during the background walk (auto-triage drip, in-flight triage) can
        # change a category/urgency/status the user set. Existing rows are matched by EntryID first,
        # then by a stable subject+sender+timestamp key (covers EntryID drift); genuinely new emails
        # are not in the snapshot, so their fresh classification is left untouched.
        try:
            _by_eid = getattr(self, "_pre_refresh_wf_by_eid", None) or {}
            _by_key = getattr(self, "_pre_refresh_wf_by_key", None) or {}
            if _by_eid or _by_key:
                for _e in self.emails:
                    if not isinstance(_e, dict):
                        continue
                    _rec = _by_eid.get(_e.get("entry_id"))
                    if _rec is None:
                        try:
                            _subj = normalize_subject_for_match(_e.get("subject", "") or "")
                            _snd = str(_e.get("sender_email", "") or _e.get("sender", "") or "").strip().lower()
                            _ts = int(float(_e.get("received_timestamp", 0) or 0))
                            _rec = _by_key.get((_subj, _snd, _ts))
                        except Exception:
                            _rec = None
                    if not _rec:
                        continue
                    for _f, _v in _rec.items():
                        if _v not in (None, ""):
                            _e[_f] = _v
                    # keep status_data in agreement so the restored value also survives a later restart.
                    try:
                        _sd = self.status_data.get(_e.get("entry_id")) if isinstance(self.status_data, dict) else None
                        if isinstance(_sd, dict):
                            for _f in ("category", "urgency", "status"):
                                if _rec.get(_f) not in (None, ""):
                                    _sd[_f] = _rec.get(_f)
                    except Exception:
                        pass
        except Exception:
            pass
        finally:
            self._pre_refresh_wf_by_eid = {}
            self._pre_refresh_wf_by_key = {}
        # v3.9.86: FAST PHASE ENDS HERE. Render the new mail NOW. This is the whole point of the
        # restructure -- the user sees and can start working on new mail immediately, instead of
        # waiting for the closed-thread body loads + the inbox quote scan to finish first. The
        # heavy remainder (closed-thread reconciliation, then the quote-coverage scan) runs in a
        # deferred pass scheduled at the bottom of this method.
        try:
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.save_cached_state()
        except Exception:
            pass
        try:
            self.preview_text.delete("1.0", tk.END)
            _msg = (f"Refresh complete.\n\nNew My Inbox emails imported: {added_my}\n"
                    f"New Sales emails imported: {added_sales}\n\n")
            if hinted:
                _msg += (f"{hinted} new email(s) look like quotes \u2014 checking quote coverage in "
                         f"the background.\n\n")
            _msg += ("New mail is on screen now; thread reconciliation and quote-coverage checks "
                     "are finishing in the background. Sent/waiting trackers are reconciled as "
                     "replies arrive.")
            self.preview_text.insert(tk.END, _msg)
        except Exception:
            pass
        try:
            self.last_updated_var.set("New mail loaded \u2014 finishing background tasks\u2026")
            self.connection_status_var.set("Outlook: connected")
        except Exception:
            pass
        # v3.9.86: hand the heavy remainder to a deferred main-thread pass so it runs AFTER this
        # render has painted, not before it. If it cannot be scheduled for any reason, run it
        # inline so coverage still updates and Refresh is never left running.
        try:
            self.root.after(60, self._refresh_finalize_pass)
        except Exception:
            try:
                self._refresh_finalize_pass()
            except Exception:
                self._refresh_running = False

    def _refresh_finalize_pass(self):
        """v3.9.86: deferred tail of the manual Refresh, run on the Tk main thread AFTER the new
        mail has already been rendered (so it no longer delays the first paint).

        Step 1 -- closed-thread reconciliation (moved verbatim from the old _refresh_apply_inbound
        tail; see the v3.9.69 notes inline): flip rows the user already replied to off "Needs
        Reply", and mark genuinely-closed quote threads Completed. This still loads a small,
        budgeted set of bodies over COM on the main thread (load_body_for_rfq), so it can briefly
        pause the UI -- but it is the SAME work as before v3.9.86, simply resequenced to run after
        the mail is visible instead of before it.

        Step 2 -- kick the background quote-coverage scan (its own worker pass), which is what
        flips matched requested items to Quoted. That scan used to run on the collection worker
        BEFORE the hand-off; it now runs last, off the critical path.
        """
        try:
            self.last_updated_var.set("New mail loaded \u2014 reconciling threads\u2026")
        except Exception:
            pass
        # --- Step 1: closed-thread reconciliation (the former v3.9.69 block) ---
        # v3.9.69: the snapshot restore (in _refresh_apply_inbound) would revert these corrections
        # on an EXISTING row, so they run AFTER it (and so apply on a plain Refresh, not only to
        # brand-new mail):
        #   (1) Outlook shows the user already replied to a row still marked "Needs Reply" -> it
        #       isn't Needs Reply; flip to the matching Waiting.
        #   (2) A thread the user JUST replied to, in a group, not yet Completed, may now be a
        #       closed deal (won order / PO provided, or a cancellation). Load its body once and,
        #       if so, propose the archive Cleanup. Gated by user_replied + group membership, so
        #       this touches only a tiny set (just-replied threads) -- never a full-mailbox load.
        try:
            _checked = getattr(self, "_closed_checked_eids", None)
            if not isinstance(_checked, set):
                _checked = self._closed_checked_eids = set()
            _budget = 30
            for _e in self.emails:
                if not isinstance(_e, dict):
                    continue
                _eid = _e.get("entry_id", "")
                _replied = bool(_e.get("user_replied"))
                _grouped = bool(self.get_group_id_for_email(_eid))
                _handled = False
                # A thread that is now CLOSED -- won order, cancellation, or the
                # customer declining ("thanks anyway", "went with another") -- is
                # DONE. Check it for (a) anything the user just replied to, and (b)
                # any grouped, not-yet-checked quote thread, so a customer walk-away
                # is caught even when we never replied. Body loaded once; the budget
                # + a session 'checked' set keep this off the hot path.
                _do = False
                if (_e.get("status") != "Completed"
                        and not _e.get("sent_waiting_tracker_active")
                        and not _e.get("is_sent_waiting_placeholder")):
                    # v3.9.90: never let the won-order / closed-thread HEURISTIC auto-complete an
                    # ACTIVE sent/waiting tracker. The tracker is the user's explicit "I'm waiting on
                    # a reply" decision; a thread that merely contains a PO/"good to go" signal (e.g.
                    # subject "...Purchase Order: 1108-1848; Doc Type: PO") would otherwise flip a
                    # just-created Waiting tracker straight to Completed. Trackers still clear the
                    # right way -- when the actual reply arrives -- or by a manual status change.
                    if _replied:
                        _do = True
                    elif _grouped and _eid not in _checked and _budget > 0:
                        _do = True
                        _budget -= 1
                        _checked.add(_eid)
                if _do:
                    try:
                        if self.load_body_for_rfq(_e):
                            _closed, _phrase, _kind = self._email_request_is_closed(_e)
                            if _closed:
                                _e["status"] = "Completed"
                                try:
                                    _sd = self.status_data.get(_eid) if isinstance(self.status_data, dict) else None
                                    if isinstance(_sd, dict):
                                        _sd["status"] = "Completed"
                                except Exception:
                                    pass
                                try:
                                    self._cancel_active_followups_for_email(_e, reason="Quote closed")
                                except Exception:
                                    pass
                                self._assistant_propose_cleanup(_e, _phrase, _kind)
                                _handled = True
                    except Exception:
                        pass
                # Otherwise, a still-"Needs Reply" row the user already replied to is
                # no longer Needs Reply -> flip to the matching Waiting.
                if not _handled and _replied and _e.get("status") == "Needs Reply":
                    _ns = "Waiting on Vendor" if str(_e.get("email_type", "")).upper() == "V" else "Waiting on Customer"
                    _e["status"] = _ns
                    try:
                        _sd = self.status_data.get(_eid) if isinstance(self.status_data, dict) else None
                        if isinstance(_sd, dict):
                            _sd["status"] = _ns
                    except Exception:
                        pass
        except Exception:
            pass
        # v3.9.81: archive finished quote groups + schedule the chase follow-up.
        try:
            self._run_quote_completion_autocleanup()
        except Exception:
            pass
        # Re-render: the closed-thread step above may have changed statuses / archived groups.
        try:
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.save_cached_state()
        except Exception:
            pass
        # --- Step 2: background quote-coverage scan (off the critical path) ---
        # Guarded: if the scan pass cannot even be started, clear the flag here so Refresh is
        # never left wedged (the quote-scan pass is otherwise responsible for clearing it).
        # v4.0.0: after a restore, the email list is now final for this refresh -- map the
        # source PC's EntryIDs onto this PC's before the user works the restored state.
        try:
            if getattr(self, "_pending_post_restore_relink", 0):
                self._relink_restored_entry_ids()
        except Exception:
            pass
        try:
            self._refresh_start_quote_scan_pass()
        except Exception:
            self._refresh_running = False

    def _identity_match_score(self, rec, email):
        """v4.0.2: shared cross-PC identity scorer. `rec` and `email` are dicts with
        subject/sender/conversation/timestamp (and optionally internet_message_id).
        Returns -1 for a hard mismatch, else a score; >=6 is a confident match."""
        try:
            r_imid = self._guard_imid(rec.get("internet_message_id", ""))
            e_imid = self._guard_imid(email.get("internet_message_id", ""))
            if r_imid and e_imid:
                return 100 if r_imid == e_imid else -1
            r_cidx = str(rec.get("conversation_index", "") or "").strip()
            e_cidx = str(email.get("conversation_index", "") or "").strip()
            if r_cidx and e_cidx:
                return 95 if r_cidx == e_cidx else -1
            nsub_r = normalize_subject_for_match(rec.get("subject", "") or rec.get("normalized_subject", "") or "")
            nsub_e = normalize_subject_for_match(email.get("subject", "") or "")
            if not nsub_r or nsub_r != nsub_e:
                return -1
            r_conv = str(rec.get("conversation_id", "") or "").strip().lower()
            e_conv = str(email.get("conversation_id", "") or "").strip().lower()
            same_conv = bool(r_conv and e_conv and r_conv == e_conv)
            try:
                r_ts = float(rec.get("received_timestamp", 0) or 0)
            except Exception:
                r_ts = 0.0
            try:
                e_ts = float(email.get("received_timestamp", 0) or 0)
            except Exception:
                e_ts = 0.0
            delta = abs(r_ts - e_ts) if (r_ts and e_ts) else None
            r_sender = str(rec.get("sender_email", "") or rec.get("sender", "") or "").strip().lower()
            e_sender = str(email.get("sender_email", "") or email.get("sender", "") or "").strip().lower()
            if r_sender and e_sender and r_sender != e_sender:
                if not (same_conv or (delta is not None and delta <= 120)):
                    return -1
            score = 0
            if same_conv:
                score += 2  # corroboration only; ConversationID is not a message identity
            if delta is not None:
                if delta <= 60:
                    score += 5
                elif delta <= 300:
                    score += 3
                elif delta > 600:
                    return -1
            else:
                return -1
            if r_sender and e_sender and r_sender == e_sender:
                score += 3
            return score
        except Exception:
            return -1

    def _heal_entry_id_references(self, eid_map):
        """v4.0.2: rewrite old->new EntryIDs across every store. Returns heal counts."""
        healed = {"statuses": 0, "memberships": 0, "lists": 0}
        for old_eid, new_eid in eid_map.items():
            try:
                rec = self.status_data.pop(old_eid, None)
                if isinstance(rec, dict):
                    rec["entry_id"] = new_eid
                    self.status_data[new_eid] = rec
                    healed["statuses"] += 1
            except Exception:
                pass
            try:
                memberships = self.groups_data.get("memberships", {}) if isinstance(self.groups_data, dict) else {}
                if old_eid in memberships:
                    memberships[new_eid] = memberships.pop(old_eid)
                    healed["memberships"] += 1
            except Exception:
                pass
            for attr in ("followups", "scenario_reminders", "commitment_reminders",
                         "pending_reply_checks", "sent_waiting_placeholders"):
                try:
                    for it in (getattr(self, attr, None) or []):
                        if isinstance(it, dict) and str(it.get("entry_id", "")) == old_eid:
                            it["entry_id"] = new_eid
                            healed["lists"] += 1
                except Exception:
                    continue
        return healed

    def _save_and_rerender_after_relink(self, eid_map, healed, note=""):
        for saver in ("flush_status_data", "save_groups", "save_followups", "save_scenario_reminders",
                      "save_commitment_reminders", "save_pending_reply_checks", "save_sent_waiting_placeholders"):
            try:
                getattr(self, saver)()
            except Exception:
                pass
        try:
            self.cleanup_duplicates(reason="post_restore_relink", save=False)
            self._rebuild_email_index()
        except Exception:
            pass
        try:
            self.save_cached_state()
        except Exception:
            pass
        try:
            self.log(f"Post-restore re-link{note}: mapped {len(eid_map)} email(s) to this PC's Outlook IDs "
                     f"({healed['statuses']} statuses, {healed['memberships']} group memberships, {healed['lists']} reminder/follow-up records)")
        except Exception:
            pass
        try:
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
        except Exception:
            pass

    def _relink_restored_entry_ids(self):
        """v4.0.0/v4.0.2: heal cross-PC Outlook EntryID drift after a cloud restore.

        v4.0.2 (cache-carried restores): the restored email cache renders the
        source PC's exact view, its rows tagged restored_foreign. As the local
        walk finds the same emails, each foreign row is matched to its local twin
        by identity, the LOCAL row is kept (fresh EntryID/store), the foreign
        row's cached body and fields are merged in, and every store keyed by the
        old EntryID is rewritten. Foreign rows with no local twin yet stay
        visible (they ARE the mirror) and are picked up by later passes or the
        background backfill. Pre-cache restores (no tagged rows) fall back to the
        v4.0.0 status-record matching. Idempotent."""
        passes_left = int(getattr(self, "_pending_post_restore_relink", 0) or 0)
        if passes_left <= 0:
            return
        self._pending_post_restore_relink = passes_left - 1
        try:
            if not isinstance(getattr(self, "emails", None), list):
                return
            foreign = [e for e in self.emails if isinstance(e, dict) and e.get("restored_foreign") and e.get("entry_id")]
            if foreign:
                locals_ = [e for e in self.emails
                           if isinstance(e, dict) and e.get("entry_id") and not e.get("restored_foreign")]
                by_subject = {}
                for e in locals_:
                    nsub = normalize_subject_for_match(e.get("subject", "") or "")
                    if nsub:
                        by_subject.setdefault(nsub, []).append(e)
                claimed = set()
                eid_map = {}
                merged_rows = 0
                for f_row in foreign:
                    old_eid = str(f_row.get("entry_id"))
                    if old_eid in claimed:
                        continue
                    nsub = normalize_subject_for_match(f_row.get("subject", "") or "")
                    best, best_score = None, 5
                    for cand in by_subject.get(nsub, []):
                        c_eid = str(cand.get("entry_id"))
                        if c_eid in claimed or c_eid == old_eid:
                            continue
                        score = self._identity_match_score(f_row, cand)
                        if score > best_score:
                            best, best_score = cand, score
                    if best is None:
                        # No local twin yet: keep the mirror row visible; a foreign
                        # store_id is useless here, so drop it once.
                        if f_row.get("store_id"):
                            f_row["store_id"] = ""
                        continue
                    new_eid = str(best.get("entry_id"))
                    claimed.add(new_eid)
                    claimed.add(old_eid)
                    eid_map[old_eid] = new_eid
                    try:
                        self._merge_duplicate_email_rows(best, f_row)
                    except Exception:
                        pass
                    try:
                        self.emails.remove(f_row)
                        merged_rows += 1
                    except Exception:
                        f_row["restored_foreign"] = False
                if not eid_map:
                    try:
                        self.log(f"Post-restore re-link: no local twins found this pass "
                                 f"({len(foreign)} restored row(s) still awaiting local mail; "
                                 f"{max(passes_left - 1, 0)} pass(es) remaining)")
                    except Exception:
                        pass
                    return
                healed = self._heal_entry_id_references(eid_map)
                self._save_and_rerender_after_relink(eid_map, healed, note=f" ({merged_rows} restored rows merged into local twins)")
                return
            # ---- legacy fallback: pre-cache restore (no tagged rows) -- v4.0.0 logic ----
            if not isinstance(getattr(self, "status_data", None), dict) or not self.status_data:
                return
            current_by_id = {str(e.get("entry_id")): e for e in self.emails if isinstance(e, dict) and e.get("entry_id")}
            if not current_by_id:
                return
            by_subject = {}
            for eid, e in current_by_id.items():
                nsub = normalize_subject_for_match(e.get("subject", "") or "")
                if nsub:
                    by_subject.setdefault(nsub, []).append(eid)
            claimed = set()
            eid_map = {}
            for old_eid, rec in list(self.status_data.items()):
                if not isinstance(rec, dict) or old_eid in current_by_id:
                    continue
                nsub = normalize_subject_for_match(rec.get("subject", "") or rec.get("normalized_subject", "") or "")
                best, best_score = "", 5
                for cand_eid in by_subject.get(nsub, []):
                    if cand_eid in claimed:
                        continue
                    score = self._identity_match_score(rec, current_by_id.get(cand_eid) or {})
                    if score > best_score:
                        best, best_score = cand_eid, score
                if best:
                    claimed.add(best)
                    eid_map[old_eid] = best
            if not eid_map:
                try:
                    self.log("Post-restore re-link: nothing to link this pass"
                             + (f" ({passes_left - 1} pass(es) remaining)" if passes_left - 1 > 0 else ""))
                except Exception:
                    pass
                return
            healed = self._heal_entry_id_references(eid_map)
            self._save_and_rerender_after_relink(eid_map, healed)
        except Exception:
            pass

    def _post_restore_backfill_async(self, since_dt):
        """v4.0.2: background ID transplant for restored rows the recent walk didn't cover.

        Walks both inboxes (worker thread, thread-local COM) newest-first back to
        since_dt collecting ONLY identity fields per item -- EntryID, StoreID,
        ConversationID, subject, sender, received time. The apply phase matches
        those identities against the remaining restored_foreign rows and
        transplants the LOCAL EntryID/StoreID into each cached row: the row keeps
        the exact look and cached body it arrived with and simply becomes
        openable. Never blocks the UI; this replaces the synchronous deep
        update_since_date walk (the frozen 'Working...' box)."""
        try:
            pending = [e for e in (self.emails or []) if isinstance(e, dict) and e.get("restored_foreign")]
        except Exception:
            pending = []
        if not pending or since_dt is None:
            return
        try:
            self.set_status(f"Post-restore: background ID sync for {len(pending)} restored email(s) (back to {since_dt.strftime('%m/%d/%Y')}); MaINbox stays usable...")
        except Exception:
            pass
        need = len(pending)

        def _work(outlook, namespace):
            collected = []
            folders = []
            try:
                folders.append(("My Inbox", namespace.GetDefaultFolder(6)))
            except Exception:
                pass
            try:
                sales = self._find_sales_inbox_folder_in(namespace)
                if sales is not None:
                    folders.append(("Sales", sales))
            except Exception:
                pass
            restrict = "[ReceivedTime] >= '" + since_dt.strftime("%m/%d/%Y %I:%M %p") + "'"
            for source, folder in folders:
                try:
                    items = folder.Items
                    items.Sort("[ReceivedTime]", True)
                    try:
                        items = items.Restrict(restrict)
                    except Exception:
                        pass
                    count = 0
                    it = items.GetFirst()
                    while it is not None and count < 4000:
                        count += 1
                        try:
                            received = it.ReceivedTime
                            collected.append({
                                "entry_id": str(it.EntryID),
                                "store_id": str(getattr(getattr(it, "Parent", None), "StoreID", "") or ""),
                                "conversation_id": str(getattr(it, "ConversationID", "") or ""),
                                "subject": str(it.Subject or ""),
                                "sender": str(getattr(it, "SenderName", "") or ""),
                                "sender_email": str(getattr(it, "SenderEmailAddress", "") or ""),
                                "received_timestamp": float(received.timestamp()) if received else 0.0,
                                "source": source,
                            })
                        except Exception:
                            pass
                        it = items.GetNext()
                except Exception:
                    continue
            return collected

        def _done(collected):
            collected = collected or []
            try:
                foreign = [e for e in (self.emails or []) if isinstance(e, dict) and e.get("restored_foreign")]
                if not foreign or not collected:
                    try:
                        self.log(f"Post-restore backfill: walked {len(collected)} identities; {len(foreign)} restored row(s) still unmapped")
                    except Exception:
                        pass
                    return
                by_subject = {}
                for c in collected:
                    nsub = normalize_subject_for_match(c.get("subject", "") or "")
                    if nsub:
                        by_subject.setdefault(nsub, []).append(c)
                existing_ids = {str(e.get("entry_id")) for e in self.emails if isinstance(e, dict) and e.get("entry_id")}
                claimed = set()
                eid_map = {}
                transplanted = 0
                for f_row in foreign:
                    old_eid = str(f_row.get("entry_id"))
                    nsub = normalize_subject_for_match(f_row.get("subject", "") or "")
                    best, best_score = None, 5
                    for cand in by_subject.get(nsub, []):
                        c_eid = str(cand.get("entry_id"))
                        if c_eid in claimed or c_eid == old_eid:
                            continue
                        score = self._identity_match_score(f_row, cand)
                        if score > best_score:
                            best, best_score = cand, score
                    if best is None:
                        continue
                    new_eid = str(best.get("entry_id"))
                    claimed.add(new_eid)
                    if new_eid in existing_ids:
                        # A locally-walked row already exists -- the relink merge path owns that case.
                        continue
                    f_row["entry_id"] = new_eid
                    f_row["store_id"] = best.get("store_id", "")
                    f_row["restored_foreign"] = False
                    existing_ids.add(new_eid)
                    transplanted += 1
                    eid_map[old_eid] = new_eid
                if eid_map:
                    healed = self._heal_entry_id_references(eid_map)
                    self._save_and_rerender_after_relink(eid_map, healed, note=f" (backfill: {transplanted} restored rows now openable locally)")
                else:
                    try:
                        self.log(f"Post-restore backfill: walked {len(collected)} identities; no new links (remaining rows may predate this PC's mailbox history)")
                    except Exception:
                        pass
            except Exception:
                pass

        def _err(exc):
            try:
                self.log(f"Post-restore backfill skipped ({exc}); restored rows stay visible and re-link continues on normal refreshes")
            except Exception:
                pass

        self.run_outlook_worker(_work, on_done=_done, on_error=_err, label="post-restore-backfill")

    def _cloud_sync_startup_check(self):
        """v4.1.0: auto-sync entry point. At launch, quietly check whether ANOTHER of
        your PCs uploaded a newer cloud backup than anything this PC has applied or
        produced; if so, offer to restore it (or restore automatically when the
        cloud_sync_auto_restore setting is on). The check is a couple of tiny JSON
        downloads on a daemon thread -- it never blocks startup, and silently does
        nothing when the Supabase bridge isn't configured."""
        try:
            if not bool(load_mainbox_settings().get("cloud_sync_check_on_startup", True)):
                return
        except Exception:
            pass

        def _bg():
            try:
                cfg = load_cloud_bridge_config()
                if not isinstance(cfg, dict) or not bool(cfg.get("enabled")):
                    self._cloud_sync_log("Cloud sync check: bridge not enabled -- skipping")
                    return
                if not str(cfg.get("supabase_url") or "").strip() or not str(cfg.get("supabase_service_role_key") or "").strip():
                    self._cloud_sync_log("Cloud sync check: Supabase URL/key not configured -- skipping")
                    return
                own_id = str(cfg.get("device_id") or "")
                try:
                    manifests = cloud_sync_fetch_all_manifests(cfg)
                except Exception as exc:
                    self._cloud_sync_log(f"Cloud sync check: could not read cloud manifests ({exc})")
                    return
                other = [m for m in manifests if isinstance(m, dict) and str(m.get("device_id") or "") != own_id]
                self._cloud_sync_log(
                    f"Cloud sync check: this PC id {own_id[:8] or '?'}..., {len(manifests)} manifest(s) in cloud "
                    f"({len(other)} from other device(s))"
                )
                state = _cloud_sync_read_state()
                floor = max(str(state.get("uploaded_at", "")), str(state.get("declined_uploaded_at", "")))
                try:
                    import socket as _socket
                    _own_host = _socket.gethostname() or ""
                except Exception:
                    _own_host = ""
                pick, reason = cloud_sync_pick_newer_remote(manifests, own_id, floor, own_hostname=_own_host)
                self._cloud_sync_log(f"Cloud sync check: {reason}")
                if not pick:
                    return
                self.root.after(0, lambda p=pick: self._cloud_sync_offer_restore(p))
            except Exception as exc:
                self._cloud_sync_log(f"Cloud sync check: unexpected error ({exc})")

        threading.Thread(target=_bg, name="cloud-sync-check", daemon=True).start()

    def _cloud_sync_log(self, msg):
        try:
            self.root.after(0, lambda m=msg: self.log(m))
        except Exception:
            try:
                self.log(msg)
            except Exception:
                pass

    def _cloud_sync_offer_restore(self, manifest):
        """v4.1.0: main-thread half of the auto-sync check."""
        try:
            who = str(manifest.get("hostname") or manifest.get("device_id") or "another PC")
            when = str(manifest.get("uploaded_at") or "")
            auto = False
            try:
                auto = bool(load_mainbox_settings().get("cloud_sync_auto_restore", False))
            except Exception:
                auto = False
            if not auto:
                answer = messagebox.askyesno(
                    "Newer Backup From Your Other PC",
                    f"A newer MaINbox backup from {who} was uploaded {when}.\n\n"
                    "Restore it now? MaINbox will close, restore, and reopen showing that PC's exact view.\n\n"
                    "(No = keep working here; you won't be asked again for this particular backup.)",
                )
                if not answer:
                    try:
                        state = _cloud_sync_read_state()
                        state["declined_uploaded_at"] = when
                        with open(CLOUD_SYNC_STATE_FILE, "w", encoding="utf-8") as f:
                            json.dump(state, f, indent=2)
                    except Exception:
                        pass
                    return
            try:
                self.log(f"Cloud sync: restoring newer backup from {who} (uploaded {when})")
            except Exception:
                pass
            launched, msg = launch_cloud_bridge_restore_latest()
            if not launched:
                try:
                    messagebox.showerror("Cloud Sync", msg + "\n\nUse Update Options > Browse Bridge File to point at the bridge script, then relaunch.")
                except Exception:
                    pass
                return
            try:
                self.set_status("Cloud sync: restoring newer backup -- MaINbox will close and reopen...")
            except Exception:
                pass
            try:
                self.root.after(150, self.on_close)
            except Exception:
                try:
                    self.root.destroy()
                except Exception:
                    pass
        except Exception:
            pass

    def _refresh_start_quote_scan_pass(self):
        """v3.9.86: final Refresh pass -- run scan_recent_inbox_for_quotes on a background worker,
        AFTER the new mail is already on screen. This is the same conservative, idempotent,
        worker-safe scan that previously ran on the collection worker before the hand-off; only
        its timing changed (it no longer blocks the first render). _refresh_running is cleared in
        its on_done / on_error, so a second Refresh -- and an AutoPilot tick -- is held off until
        coverage has been reconciled."""
        try:
            self.last_updated_var.set("New mail loaded \u2014 checking quote coverage\u2026")
        except Exception:
            pass

        def qwork(outlook, namespace):
            # scan_recent_inbox_for_quotes connects its own thread-local namespace (fresh_outlook)
            # and saves coverage atomically, so it is safe here exactly as it was on the old
            # collection worker. We pass nothing back -- it mutates coverage on disk itself.
            try:
                self.scan_recent_inbox_for_quotes()
            except Exception:
                pass
            try:
                # v4.1.18: same pass also captures customer requests whose item list
                # arrived as an attachment or a screenshot pasted into the body.
                self.scan_recent_inbox_for_customer_request_attachments()
            except Exception:
                pass
            return None

        def qdone(_):
            self._refresh_running = False
            # Surface outstanding coverage in the dedicated status var (set it whether or not any
            # items remain, so a now-cleared coverage stops showing a stale warning).
            try:
                cov_threads, cov_items = self.coverage_outstanding_summary()
                if cov_items > 0:
                    self.coverage_status_var.set(
                        f"Quote coverage: {cov_items} item(s) need quotes / {cov_threads} thread(s)")
                    # Append the nudge to the preview ONLY if it still shows our refresh summary,
                    # so we never clobber something the user navigated to in the meantime.
                    try:
                        if self.preview_text.get("1.0", "1.30").startswith("Refresh complete"):
                            self.preview_text.insert(
                                tk.END,
                                f"\n\n\u26a0 Quote coverage: {cov_items} requested item(s) still need "
                                f"quotes across {cov_threads} thread(s). Click \"Quote Coverage\" to see the list.")
                    except Exception:
                        pass
                else:
                    self.coverage_status_var.set("Quote coverage: \u2014")
            except Exception:
                pass
            try:
                self.last_updated_var.set(f"Last updated: {datetime.now().strftime('%I:%M:%S %p')} \u2014 background refresh")
                self.connection_status_var.set("Outlook: connected")
            except Exception:
                pass

        def qerr(exc):
            self._refresh_running = False
            # The mail is already on screen; this scan is best-effort. Note that the coverage
            # check was deferred (a busy worker or a transient Outlook hiccup) and let the next
            # Refresh / AutoPilot / Update catch up. Never wedge Refresh on this.
            try:
                if self.is_outlook_disconnect_error(exc):
                    self.reset_outlook_connection("refresh quote scan")
                self.last_updated_var.set(
                    f"Last updated: {datetime.now().strftime('%I:%M:%S %p')} \u2014 refresh (coverage check deferred)")
                self.connection_status_var.set("Outlook: connected")
            except Exception:
                pass

        self.run_outlook_worker(qwork, on_done=qdone, on_error=qerr, label="refresh-quote-scan")

    def _subject_suggests_quote(self, subject):
        """v3.9.86: cheap, body-free signal that a NEW email's SUBJECT reads like a vendor quote
        reply. Used only to surface a count + stage the status bar -- it never flips coverage by
        itself (line-item matching needs the body/attachments, read later by the inbox quote
        scan). Mirrors the subject side of that scan's matcher, minus the noisy 'avail' token."""
        try:
            return bool(re.search(r"quot|pric|p&a|proposal|estimat", str(subject or ""), re.IGNORECASE))
        except Exception:
            return False


    def apply_visual_settings_to_existing_widgets(self, widget=None):
        """Retheme already-created Tk widgets without rebuilding the UI."""
        if widget is None:
            widget = self.root
        try:
            apply_theme(self.root)
        except Exception:
            pass
        try:
            cls = widget.winfo_class()
        except Exception:
            cls = ""
        try:
            if isinstance(widget, (tk.Frame, tk.LabelFrame)):
                widget.configure(bg=_BG)
            elif isinstance(widget, tk.Label):
                widget.configure(bg=_BG, fg=_FG)
                try:
                    current_font = font.Font(font=widget.cget("font"))
                    current_size = abs(int(current_font.actual().get("size", _FONT_SIZE)))
                    current_weight = current_font.actual().get("weight", "normal")
                    if current_size <= 12:
                        widget.configure(font=(_FONT, _FONT_SIZE, "bold" if current_weight == "bold" else _FONT_WEIGHT))
                except Exception:
                    pass
            elif isinstance(widget, tk.Button):
                widget.configure(bg=_BTN_BG, fg=_BTN_FG, activebackground=_ACCENT2, activeforeground="#ffffff", font=(_FONT, _FONT_SIZE, _FONT_WEIGHT))
            elif isinstance(widget, tk.Entry):
                widget.configure(bg=_ENTRY_BG, fg=_FG, insertbackground=_FG, font=(_FONT, _FONT_SIZE, _FONT_WEIGHT))
            elif isinstance(widget, tk.Text):
                widget.configure(bg=_BG3, fg=_FG, insertbackground=_FG, selectbackground=_SEL_BG, selectforeground=_SEL_FG, font=(_FONT, _FONT_SIZE, _FONT_WEIGHT))
            elif isinstance(widget, tk.Listbox):
                widget.configure(bg=_BG3, fg=_FG, selectbackground=_SEL_BG, selectforeground=_SEL_FG, font=(_FONT, _FONT_SIZE, _FONT_WEIGHT))
        except Exception:
            pass
        try:
            for child in widget.winfo_children():
                self.apply_visual_settings_to_existing_widgets(child)
        except Exception:
            pass
        try:
            self.normal_font.configure(family=_FONT, size=_FONT_SIZE, weight=_FONT_WEIGHT)
            self.bold_font.configure(family=_FONT, size=_FONT_SIZE, weight="bold")
        except Exception:
            pass
        try:
            self.configure_tree_tags()
        except Exception:
            pass
        try:
            self.tree.configure(style="Treeview")
        except Exception:
            pass
        try:
            self.render_email_rows()
        except Exception:
            pass
        try:
            self.root.update_idletasks()
        except Exception:
            pass


    def apply_visual_settings_with_wait_splash(self, message="Applying visual changes..."):
        """Hide existing windows, show a short themed wait splash, repaint, then restore."""
        import time as _time

        root = getattr(self, "root", None)
        hidden_windows = []

        def _hide_window(win):
            try:
                if not win or not win.winfo_exists():
                    return
                state = win.state()
                # Do not try to restore windows that were already withdrawn/iconified.
                if state in ("normal", "zoomed"):
                    hidden_windows.append((win, state))
                    win.withdraw()
            except Exception:
                pass

        try:
            # Hide child/top-level windows first so the user does not watch them repaint.
            for child in list(root.winfo_children()):
                try:
                    if isinstance(child, tk.Toplevel) and child.winfo_exists():
                        _hide_window(child)
                except Exception:
                    pass
            _hide_window(root)
        except Exception:
            pass

        splash = None
        try:
            splash = tk.Toplevel(root)
            splash.title("Please wait")
            splash.resizable(False, False)
            splash.attributes("-topmost", True)
            try:
                splash.configure(bg=_BG)
                apply_theme(splash)
            except Exception:
                pass

            tk.Label(
                splash,
                text="Please wait...",
                font=(_FONT, max(12, _FONT_SIZE + 4), "bold"),
                fg=_ACCENT,
                bg=_BG,
            ).pack(pady=(26, 8), padx=26)
            tk.Label(
                splash,
                text=message,
                font=(_FONT, max(9, _FONT_SIZE), _FONT_WEIGHT),
                fg=_FG_DIM,
                bg=_BG,
                wraplength=360,
                justify="center",
            ).pack(pady=(0, 12), padx=26)
            progress = ttk.Progressbar(splash, mode="indeterminate", length=300)
            progress.pack(pady=(0, 22), padx=26)
            progress.start(12)

            try:
                splash.update_idletasks()
                w, h = 420, 160
                x = (splash.winfo_screenwidth() // 2) - (w // 2)
                y = (splash.winfo_screenheight() // 2) - (h // 2)
                splash.geometry(f"{w}x{h}+{x}+{y}")
                splash.update()
            except Exception:
                pass

            _time.sleep(0.20)
            try:
                self.apply_visual_settings_to_existing_widgets()
            except Exception:
                pass
            try:
                splash.update()
            except Exception:
                pass
            _time.sleep(0.20)

        finally:
            try:
                if splash and splash.winfo_exists():
                    splash.destroy()
            except Exception:
                pass

            # Restore only windows that were visible before the visual refresh.
            for win, state in hidden_windows:
                try:
                    if win and win.winfo_exists():
                        win.deiconify()
                        if state == "zoomed":
                            try:
                                win.state("zoomed")
                            except Exception:
                                pass
                        try:
                            win.lift()
                        except Exception:
                            pass
                except Exception:
                    pass

            try:
                if root and root.winfo_exists():
                    root.update_idletasks()
            except Exception:
                pass


