        return result

    if contains_any_phrase(combined_l, VENDOR_WAITING_PHRASES):
        matched = matched_phrases(combined_l, VENDOR_WAITING_PHRASES)
        result.update({
            "sender_type": "vendor_or_supplier",
            "sender_intent": "vendor says they will get back with pricing/status/info",
