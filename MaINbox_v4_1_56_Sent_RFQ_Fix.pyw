    def _button_layout_path(self):
        return data_path("mainbox_button_layout.json")

    def _load_button_layout(self):
        try:
            with open(self._button_layout_path(), "r", encoding="utf-8") as f:
                data = json.load(f)
            return data if isinstance(data, dict) else {}
        except Exception:
            return {}

    def _save_button_layout(self, layout):
        try:
            with open(self._button_layout_path(), "w", encoding="utf-8") as f:
                json.dump(layout, f, indent=2)
            return True
        except Exception:
            return False

    def _merged_button_order(self, key, specs=None):
        """[(spec, visible)] for toolbar `key`: saved order/visibility first, then any
        manifest buttons not in the saved layout appended (visible) -- so a button
        added in a later version still appears without wiping the user's layout."""
        if specs is None:
            specs = self._main_button_specs().get(key, [])
        by_id = {s["id"]: s for s in specs}
        saved = self._load_button_layout().get(key, [])
        result, seen = [], set()
        for row in saved:
            if not isinstance(row, dict):
                continue
            bid = row.get("id")
            if bid in by_id and bid not in seen:
                result.append((by_id[bid], bool(row.get("v", True))))
                seen.add(bid)
        for s in specs:
            if s["id"] not in seen:
                result.append((s, True))
                seen.add(s["id"])
        return result

    def _build_toolbar(self, key):
        """(Re)render one button bar from the manifest + saved layout. Safe to call
        again any time (e.g. after the Edit Buttons dialog saves) -- it clears and
        rebuilds only that bar's buttons; the frame itself stays put."""
        frame = self._toolbar_frames.get(key) if isinstance(getattr(self, "_toolbar_frames", None), dict) else None
        if not frame:
            return
        try:
            if not frame.winfo_exists():
                return
        except Exception:
            return
        for child in frame.winfo_children():
            child.destroy()
        if key == "filter":
            self._filter_buttons = {}
        specs = self._main_button_specs().get(key, [])
        vertical = (key == "group")
        last_section = None
        for spec, visible in self._merged_button_order(key, specs):
            if not visible:
                continue
            if vertical and last_section is not None and spec.get("section") != last_section:
                tk.Frame(frame, bg=_BORDER, height=1).pack(fill="x", padx=6, pady=(5, 4))
            try:
                btn = spec["make"](frame)
            except Exception:
                continue
            if vertical:
                btn.pack(anchor="w", pady=2)
            else:
                btn.pack(side="left", padx=spec.get("pad", 5), pady=spec.get("pady", 0))
            last_section = spec.get("section")
        if key == "filter":
            try:
                self._refresh_filter_button_styles()
            except Exception:
                pass

    def open_button_editor(self):
        """Settings -> Visual Settings -> Edit Buttons. Tick to show / untick to hide
        a button; arrows reorder. Changes apply live (and persist) on Save."""
        specs_all = self._main_button_specs()
        order = ["group", "edit", "filter", "action"]
        titles = {"group": "Left Group / Tools column", "edit": "Edit Selected Email(s) bar",
                  "filter": "Filters bar", "action": "Bottom Action bar"}
        win = tk.Toplevel(self.root)
        win.title("Edit Buttons")
        remember_window_geometry(win, "MaINbox Edit Buttons", "560x740")
        win.transient(self.root)
        apply_theme(win)
        tk.Label(win, text="Edit Buttons", font=(_FONT, 16, "bold"), fg=_ACCENT, bg=_BG).pack(anchor="w", padx=14, pady=(12, 2))
        tk.Label(win, text="Tick to show a button, untick to hide it. Use the arrows to reorder within a bar. "
                           "Changes apply when you click Save.",
                 bg=_BG, fg=_FG_DIM, wraplength=520, justify="left").pack(anchor="w", padx=14, pady=(0, 8))

        holder = tk.Frame(win, bg=_BG)
        holder.pack(fill="both", expand=True, padx=0, pady=0)
        canvas = tk.Canvas(holder, bg=_BG, highlightthickness=0)
        scroll = ttk.Scrollbar(holder, orient="vertical", command=canvas.yview)
        content = tk.Frame(canvas, bg=_BG)
        content.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=content, anchor="nw")
        canvas.configure(yscrollcommand=scroll.set)
        canvas.pack(side="left", fill="both", expand=True)
        scroll.pack(side="right", fill="y")

        state = {}        # key -> [[id, label, BooleanVar], ...] in current order
        row_frames = {}   # key -> frame the rows live in

        for key in order:
            specs = specs_all.get(key, [])
            state[key] = [[s["id"], s["label"], tk.BooleanVar(value=vis)]
                          for s, vis in self._merged_button_order(key, specs)]

        def render_rows(key):
            rf = row_frames[key]
            for ch in rf.winfo_children():
                ch.destroy()
            for idx, (bid, label, var) in enumerate(state[key]):
                row = tk.Frame(rf, bg=_BG2)
                row.pack(fill="x", pady=1)
                tk.Checkbutton(row, variable=var, bg=_BG2, fg=_FG, selectcolor=_BG3, activebackground=_BG2).pack(side="left")
                tk.Label(row, text=label, bg=_BG2, fg=_FG, anchor="w", width=26).pack(side="left", padx=(2, 6))
                tk.Button(row, text="\u25b2", width=2, command=lambda k=key, i=idx: move(k, i, -1)).pack(side="left", padx=1)
                tk.Button(row, text="\u25bc", width=2, command=lambda k=key, i=idx: move(k, i, 1)).pack(side="left", padx=1)

        def move(key, idx, delta):
            lst = state[key]
            j = idx + delta
            if 0 <= j < len(lst):
                lst[idx], lst[j] = lst[j], lst[idx]
                render_rows(key)

        for key in order:
            lf = tk.LabelFrame(content, text=titles.get(key, key), bg=_BG2, fg=_ACCENT, padx=8, pady=6)
            lf.pack(fill="x", padx=14, pady=6)
            rf = tk.Frame(lf, bg=_BG2)
            rf.pack(fill="x")
            row_frames[key] = rf
            render_rows(key)

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=14, pady=10)

        def do_save():
            layout = {}
            for key in order:
                layout[key] = [{"id": bid, "v": bool(var.get())} for bid, label, var in state[key]]
            self._save_button_layout(layout)
            for key in order:
                try:
                    self._build_toolbar(key)
                except Exception:
                    pass
            win.destroy()

        def do_reset():
            if messagebox.askyesno("Reset Buttons",
                                   "Restore every button to its default order and make them all visible?",
                                   parent=win):
                self._save_button_layout({})
                for key in order:
                    try:
                        self._build_toolbar(key)
                    except Exception:
                        pass
                win.destroy()

        tk.Button(btns, text="Save", command=do_save, bg=_ACCENT, fg="#ffffff",
                  activebackground=_ACCENT2, activeforeground="#ffffff",
                  font=(_FONT, _FONT_SIZE, "bold"), width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Cancel", command=win.destroy, width=10).pack(side="right", padx=4)
        tk.Button(btns, text="Reset to defaults", command=do_reset, width=16).pack(side="left", padx=4)


    def sync_vendor_history_to_procurement_memory(self):
        """Keep RFQ-learned vendor_history visible in the exported procurement SQLite DB.

        MaINbox has two related stores:
        - vendor_history: learned when the user manually teaches/uses RFQ vendors
        - procurement_memory: used by Import/Export SQLite and purchase-history routing

        Older builds saved some taught vendors only to vendor_history, so exporting the
        learned DB could appear unchanged after teaching more vendors.  This sync is
        non-destructive and does not double-count repeated saves.
        """
        try:
            hist = self.vendor_history if isinstance(self.vendor_history, dict) else default_vendor_history()
            mem = self.procurement_memory if isinstance(self.procurement_memory, dict) else default_procurement_memory()
            mem.setdefault("vendors", {})
            mem.setdefault("materials", {})
            mem.setdefault("routing_rules", {})

            for email, v in (hist.get("vendors", {}) or {}).items():
                email = str(email or v.get("email", "") or "").lower().strip()
                name = str((v or {}).get("name", "") or email).strip()
                if not email or is_blocked_internal_vendor(email, name):
                    continue
                times_used = int((v or {}).get("times_used", 0) or 0)
                pv = mem["vendors"].setdefault(email, {"email": email, "name": name, "request_count": 0, "award_count": 0})
                if name:
                    pv["name"] = name
                pv["request_count"] = max(int(pv.get("request_count", 0) or 0), times_used)
                if (v or {}).get("last_used_at"):
                    pv["last_used_at"] = (v or {}).get("last_used_at")

            for key, entries in (hist.get("materials", {}) or {}).items():
                key = str(key or "").strip()
                if not key:
                    continue
                mrec = mem["materials"].setdefault(key, {"key": key, "sample_description": "", "vendors": {}})
                mrec.setdefault("vendors", {})
                for rec in entries or []:
                    if not isinstance(rec, dict):
                        continue
                    email = str(rec.get("email", "") or "").lower().strip()
                    name = str(rec.get("name", "") or email).strip()
                    if not email or is_blocked_internal_vendor(email, name):
                        continue
                    stat = mrec["vendors"].setdefault(email, {"email": email, "name": name, "request_count": 0, "award_count": 0})
                    if name:
                        stat["name"] = name
                    times_used = int(rec.get("times_used", 0) or 0)
                    stat["request_count"] = max(int(stat.get("request_count", 0) or 0), times_used)
                    if rec.get("last_used_at"):
                        stat["last_requested_at"] = rec.get("last_used_at")
                    if rec.get("sample_description") and not mrec.get("sample_description"):
                        mrec["sample_description"] = rec.get("sample_description", "")
                    mem["routing_rules"].setdefault(key, [])
                    if email not in mem["routing_rules"][key]:
                        mem["routing_rules"][key].append(email)

            self.procurement_memory = mem
            return True
        except Exception:
            return False

    def save_vendor_history(self):
        purge_blocked_vendors_from_vendor_history(self.vendor_history)
        self.vendor_history["updated_at"] = datetime.now().isoformat()
        save_json(VENDOR_HISTORY_FILE, self.vendor_history)
        if self.sync_vendor_history_to_procurement_memory():
            purge_blocked_procurement_vendors_from_memory(self.procurement_memory)
            self.procurement_memory["updated_at"] = datetime.now().isoformat()
            save_json(PROCUREMENT_MEMORY_FILE, self.procurement_memory)

