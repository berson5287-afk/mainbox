# Do NOT put real vendors here. This list is only for the app user's own/internal
# identities that should never be suggested as suppliers from sent-mail history.
BLOCKED_INTERNAL_VENDOR_TOKENS = [
    "berson5287@gmail.com",
    "steve berson",
    "stephen berson",
]


def is_blocked_internal_vendor(email="", name=""):
    combined = f"{email or ''} {name or ''}".lower().strip()
    if not combined:
        return False
    return any(tok in combined for tok in BLOCKED_INTERNAL_VENDOR_TOKENS)


def purge_blocked_procurement_vendors_from_memory(mem):
    """Remove the user's own/internal identities from procurement memory.

    This deliberately does NOT remove Leviton/David Lesser or any other real vendor.
    It only removes blocked internal identities like Steve/Stephen Berson.
    """
    if not isinstance(mem, dict):
        return False
    changed = False
    vendors = mem.setdefault("vendors", {})
    for email in list(vendors.keys()):
        rec = vendors.get(email, {}) or {}
        if is_blocked_internal_vendor(email, rec.get("name", "")):
            vendors.pop(email, None)
            changed = True

    for _key, mrec in list((mem.get("materials", {}) or {}).items()):
        if not isinstance(mrec, dict):
            continue
        mv = mrec.get("vendors", {})
        if isinstance(mv, dict):
            for email in list(mv.keys()):
                rec = mv.get(email, {}) or {}
                if is_blocked_internal_vendor(email, rec.get("name", "")):
                    mv.pop(email, None)
                    changed = True

    rr = mem.get("routing_rules", {})
    if isinstance(rr, dict):
        for key, emails in list(rr.items()):
            if isinstance(emails, list):
                new_emails = [e for e in emails if not is_blocked_internal_vendor(e, "")]
                if len(new_emails) != len(emails):
                    rr[key] = new_emails
                    changed = True

    awards = mem.get("awards", [])
    if isinstance(awards, list):
        new_awards = []
        for rec in awards:
            vendor = (rec or {}).get("vendor", {}) if isinstance(rec, dict) else {}
            if is_blocked_internal_vendor(vendor.get("email", ""), vendor.get("name", "")):
                changed = True
                continue
            new_awards.append(rec)
        if len(new_awards) != len(awards):
            mem["awards"] = new_awards

    ph = mem.get("price_history", [])
    if isinstance(ph, list):
        new_ph = []
        for rec in ph:
            if isinstance(rec, dict) and is_blocked_internal_vendor(rec.get("vendor_email", ""), rec.get("vendor_name", "")):
                changed = True
                continue
            new_ph.append(rec)
        if len(new_ph) != len(ph):
            mem["price_history"] = new_ph
    return changed


def purge_blocked_vendors_from_vendor_history(hist):
    """Remove only blocked internal identities from the older vendor-history cache."""
    if not isinstance(hist, dict):
        return False
    changed = False
    vendors = hist.setdefault("vendors", {})
    for email in list(vendors.keys()):
        rec = vendors.get(email, {}) or {}
        if is_blocked_internal_vendor(email, rec.get("name", "")):
            vendors.pop(email, None)
            changed = True

    materials = hist.setdefault("materials", {})
    for key, entries in list(materials.items()):
        if isinstance(entries, list):
            new_entries = [e for e in entries if not (isinstance(e, dict) and is_blocked_internal_vendor(e.get("email", ""), e.get("name", "")))]
            if len(new_entries) != len(entries):
                materials[key] = new_entries
                changed = True
        elif isinstance(entries, dict):
            for email in list(entries.keys()):
                rec = entries.get(email, {}) or {}
                if is_blocked_internal_vendor(email, rec.get("name", "")):
                    entries.pop(email, None)
                    changed = True

    customers = hist.setdefault("customers", {})
    for cust, recs in list(customers.items()):
        if isinstance(recs, dict):
            for email in list(recs.keys()):
                rec = recs.get(email, {}) or {}
                if is_blocked_internal_vendor(email, rec.get("name", "")):
                    recs.pop(email, None)
                    changed = True
    return changed


def canonical_material_key(item_or_text, part_number=""):
    """Stable key used for vendor memory, awards, and price history.

    It intentionally normalizes common electrical wording without changing the
    displayed RFQ line item. This lets these variants learn together:
      3/4 EMT, 3/4\" EMT conduit, [EMT Conduit] 3/4\", Metallic
    """
    if isinstance(item_or_text, dict):
        desc = str(item_or_text.get("description", "") or "")
        part = str(item_or_text.get("part_number", "") or part_number or "")
    else:
        desc = str(item_or_text or "")
        part = str(part_number or "")
    part = re.sub(r"\s+", "", part.upper().strip())
    text = f"{part} {desc}" if part else desc
    text = text.lower()
    text = text.replace("&quot;", '"').replace("''", '"').replace(" in.", ' inch')
    text = re.sub(r"[\[\]\(\),;:]", " ", text)
    text = re.sub(r"\bstandard\b|\bmetallic\b|\bsteel\b|\bgalvanized\b|\bgalv\b|\bnon insulated\b|\bnon-insulated\b", " ", text)
    text = re.sub(r"\bconduit\b", "conduit", text)
    text = re.sub(r"\belectrical metallic tubing\b", "emt", text)
    text = re.sub(r"\bemt\b", "emt", text)
    text = re.sub(r"\bpvc\b", "pvc", text)
    text = re.sub(r"\brigid\b|\brmc\b", "rigid", text)
    text = re.sub(r"\s+", " ", text).strip()
    # Pull common trade size and core noun to the front for better matching.
    size = ""
    m = re.search(r"(\d+\s*(?:/\s*\d+)?|\d+\.\d+)\s*(?:\"|inch|in\b)", text)
    if m:
        size = re.sub(r"\s+", "", m.group(1)).replace("/", "/") + '"'
    keywords = []
    for kw in ["emt", "pvc", "rigid", "connector", "strap", "locknut", "nipple", "gutter", "wire", "cable", "breaker", "box", "washer", "nut", "rod", "strut", "paint", "tie"]:
        if re.search(r"\b" + re.escape(kw) + r"\b", text):
            keywords.append(kw)
    if part and len(part) >= 3 and not keywords:
        return "part:" + part[:80]
    key = " ".join(([size] if size else []) + keywords)
    if not key:
        key = re.sub(r"[^a-z0-9/\" ]+", " ", text)
        key = re.sub(r"\s+", " ", key).strip()[:90]
    return key or normalize_material_key(part, desc)


# -----------------------------
# MaINbox v3.9.1 Quote Coverage matching helpers
# -----------------------------
# These decide whether a line item that was quoted back to a customer covers a
# line item the customer requested. Matching is layered: a shared part number is
# the strongest signal, then the normalized electrical canonical key (so 3/4" EMT
# variants match each other but not 1" EMT), then a conservative description
# token-overlap fallback. They never mutate the displayed RFQ rows.
# v4.1.18: attachment/image -> coverage extraction limits. The image size floor keeps
# signature logos, dividers, and tracking pixels out of OCR while letting real
# screenshots/photos of material lists through (a pasted Outlook screenshot is
# practically always a PNG well above 60 KB). All overridable via environment.
COVERAGE_ATTACHMENT_DOC_EXTS = (".pdf", ".xlsx", ".xlsm", ".xls", ".xlsb", ".ods",
                                ".csv", ".tsv", ".doc", ".docx", ".txt", ".rtf")
COVERAGE_ATTACHMENT_IMG_EXTS = (".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp", ".webp")
COVERAGE_IMAGE_MIN_BYTES = int(os.environ.get("MAINBOX_COVERAGE_IMAGE_MIN_BYTES", "60000"))
COVERAGE_ATTACH_MAX_FILE_BYTES = int(os.environ.get("MAINBOX_COVERAGE_ATTACH_MAX_FILE_BYTES", str(25 * 1024 * 1024)))
COVERAGE_ATTACH_MAX_DOCS = int(os.environ.get("MAINBOX_COVERAGE_ATTACH_MAX_DOCS", "8"))
COVERAGE_ATTACH_MAX_IMAGES = int(os.environ.get("MAINBOX_COVERAGE_ATTACH_MAX_IMAGES", "4"))


# v4.1.22 (external audit round 4, finding #3): canonical unit-of-measure layer. Raw
# lowercase string comparison treated EA vs Each as a CONFLICT and let EA + FT quantities
# SUM. Physical units normalize to one token; pricing bases (/C per hundred, /M per
# thousand) are a different dimension entirely and are excluded from quantity math.
_COVERAGE_UOM_CANON = {
    "ea": "ea", "each": "ea", "pc": "ea", "pcs": "ea", "piece": "ea", "pieces": "ea",
    "unit": "ea", "units": "ea", "count": "ea",
    "ft": "ft", "foot": "ft", "feet": "ft", "'": "ft",
    "lf": "lf", "linft": "lf", "linearfoot": "lf", "linearfeet": "lf", "linealfoot": "lf",
    "in": "in", "inch": "in", "inches": "in",
    "rl": "rl", "roll": "rl", "rolls": "rl", "reel": "rl", "reels": "rl",
    "bx": "bx", "box": "bx", "boxes": "bx",
    "cs": "cs", "case": "cs", "cases": "cs",
    "bg": "bg", "bag": "bg", "bags": "bg",
    "pr": "pr", "pair": "pr", "pairs": "pr",
    "set": "set", "sets": "set", "kit": "kit", "kits": "kit", "lot": "lot", "lots": "lot",
    "lb": "lb", "lbs": "lb", "pound": "lb", "pounds": "lb",
    "gal": "gal", "gallon": "gal", "gallons": "gal",
    "c": "_basis_c", "/c": "_basis_c", "perhundred": "_basis_c",
    "m": "_basis_m", "/m": "_basis_m", "perthousand": "_basis_m",
}


def _coverage_uom_canonical(unit):
    """Canonical UOM token, '' when unknown/absent, '_basis_*' for pricing bases."""
    try:
        u = re.sub(r"[^a-z/']", "", str(unit or "").lower())
        if not u:
            return ""
        return _COVERAGE_UOM_CANON.get(u, u)
    except Exception:
        return ""


def _coverage_uom_compatible(req_unit, quoted_unit):
    """True when quantities in these units may be compared/summed. Unknown on either
    side is permissive (legacy rows have no unit); pricing bases never participate."""
    rc = _coverage_uom_canonical(req_unit)
    qc = _coverage_uom_canonical(quoted_unit)
    if qc.startswith("_basis_"):
        return False
    if not rc or not qc:
        return True
    return rc == qc


def _coverage_size_value(num_text):
    """Parse a trade-size token to a float key: '3/4' -> 0.75, '1-1/2' -> 1.5, '.75' -> 0.75."""
    try:
        t = str(num_text or "").strip()
        m = re.fullmatch(r"(\d+)[-\s](\d+)/(\d+)", t)
        if m:
            return round(int(m.group(1)) + int(m.group(2)) / float(m.group(3)), 4)
        m = re.fullmatch(r"(\d+)/(\d+)", t)
        if m:
            return round(int(m.group(1)) / float(m.group(2)), 4)
        return round(float(t), 4)
    except Exception:
        return None


# v4.1.34: bounded memo caches for the pure string-derived coverage helpers. These
# functions are called once per requested x quoted PAIR inside the allocator and the
# match gate, and reload_all used to trigger three full-store passes per click -- the
# same strings were being re-regexed millions of times. Values are stored frozen and
# returned as FRESH COPIES so the callers' mutability contract is exactly what it was.
_COV_MEMO_CAP = 60000

def _cov_memo_get(cache, key):
    return cache.get(key)

def _cov_memo_put(cache, key, value):
    if len(cache) >= _COV_MEMO_CAP:
        cache.clear()  # repopulation is cheap relative to the win; keeps memory bounded
    cache[key] = value

_COV_NORM_CACHE = {}
_COV_SPECFAM_CACHE = {}
_COV_CATTOK_CACHE = {}
_COV_NUMCAT_CACHE = {}
_COV_COMPACT_CACHE = {}
_COV_ITEMKEYS_CACHE = {}
_COV_PRICEEV_CACHE = {}


def _cov_item_strings(item):
    """(part_number, description) for dict/str items -- the ONLY fields the token/key
    helpers read, so this pair is a complete cache key for them."""
    if isinstance(item, str):
        return ("", item)
    if isinstance(item, dict):
        return (str(item.get("part_number", "") or ""), str(item.get("description", "") or ""))
    return None


def _coverage_spec_families(desc):
    # v4.1.34: memoized on the exact description string; families dict is stored frozen
    # and rebuilt as {family: set(values)} per call so callers may mutate their copy.
    key = str(desc or "")
    hit = _cov_memo_get(_COV_SPECFAM_CACHE, key)
    if hit is not None:
        return {f: set(v) for f, v in hit}
    fams = _coverage_spec_families_uncached(key)
    _cov_memo_put(_COV_SPECFAM_CACHE, key, tuple((f, frozenset(v)) for f, v in fams.items()))
    return fams


def _coverage_spec_families_uncached(desc):
    """v4.1.21 (external audit round 3, finding #1): extract specification-family values
    from a normalized description so mismatched specs can refuse a match. Families:
    trade size (normalized so 3/4 == 3/4in == .75 inch), pole count, phase count, wire/
    conductor count, NEMA configuration, voltage, amperage, wire gauge (#12/12AWG),
    schedule, and conductor size (MCM/kcmil). Returns {family: set(values)}."""
    fams = {}
    try:
        t = " " + str(desc or "").lower() + " "

        def _add(fam, val):
            if val is not None and val != "":
                fams.setdefault(fam, set()).add(val)

        # NEMA configuration (before generic numbers eat it): nema 5-20r / l5-30p, and
        # v4.1.22 (round 4, finding #10) the BARE form without the word NEMA (L5-30R).
        # Blank the matched text afterwards so '30p' inside a NEMA code can never be
        # misread as a 30-pole value by the generic families below.
        for m in re.finditer(r"nema\s*(l?\s*\d+)\s*-\s*(\d+)\s*(r|p)?", t):
            _add("nema", (re.sub(r"\s+", "", m.group(1)), m.group(2), m.group(3) or ""))
        t = re.sub(r"nema\s*l?\s*\d+\s*-\s*\d+\s*(?:r|p)?", " ", t)
        for m in re.finditer(r"\b(l?\d{1,2})\s*-\s*(\d{2})\s*(r|p)\b", t):
            _add("nema", (m.group(1), m.group(2), m.group(3)))
        t = re.sub(r"\bl?\d{1,2}\s*-\s*\d{2}\s*(?:r|p)\b", " ", t)
        # v4.1.22 (finding #10): VOLTAGE SYSTEMS before the size pass, so '120/208V' or
        # '208Y/120V' can never be misread as a fractional trade size. Stored as a SET so
        # 120/208V == 208Y/120V, and a bare 120V intersects a 120/208V system (no conflict).
        for m in re.finditer(r"\b(\d{2,3})\s*y?\s*/\s*(\d{2,3})\s*(?:v\b|vac\b|volt)", t):
            _add("volt", int(m.group(1)))
            _add("volt", int(m.group(2)))
        t = re.sub(r"\b\d{2,3}\s*y?\s*/\s*\d{2,3}\s*(?:v\b|vac\b|volt\w*)", " ", t)
        # v4.1.22 (finding #10): CABLE NOTATION 12/2, 12/3 (gauge/conductor count) before
        # the size pass -- an improper 'fraction' with a small conductor count is cable,
        # not a 6.0-inch trade size. Real trade fractions (3/4, 1/2) are proper fractions.
        for m in re.finditer(r"\b(1[0-8]|[2-9])\s*/\s*([2-4])\b(?!\s*\d)", t):
            _g, _c = int(m.group(1)), int(m.group(2))
            if _g > _c and _g >= 6:
                _add("gauge", _g)
                _add("wire", _c)
        t = re.sub(r"\b(?:1[0-8]|[6-9])\s*/\s*[2-4]\b(?!\s*\d)", " ", t)
        # pole / phase / wire counts (word, abbreviated, SP/DP/TP, and symbol forms)
        for m in re.finditer(r"\b(\d+)\s*(?:-\s*)?(?:p\b|pole\b|poles\b)", t):
            _add("pole", int(m.group(1)))
        if re.search(r"\bsp\b(?!\s*lash)", t) and re.search(r"pole|breaker|switch|disconnect|contactor", t):
            _add("pole", 1)
        if re.search(r"\bdp\b", t) and re.search(r"pole|breaker|switch|disconnect|contactor", t):
            _add("pole", 2)
        if re.search(r"\btp\b", t) and re.search(r"pole|breaker|switch|disconnect|contactor", t):
            _add("pole", 3)
        for m in re.finditer(r"\b(\d+)\s*(?:-\s*)?(?:ph\b|phase\b)", t):
            _add("phase", int(m.group(1)))
        for m in re.finditer(r"(\d)\s*[øØφΦ]", t):
            _add("phase", int(m.group(1)))  # v4.1.22: 1O/3O phase symbols
        if re.search(r"\bsingle\s*phase\b", t):
            _add("phase", 1)
        if re.search(r"\bthree\s*phase\b", t):
            _add("phase", 3)
        for m in re.finditer(r"\b(\d+)\s*(?:-\s*)?(?:wire\b|wires\b|conductor\b|conductors\b)", t):
            _add("wire", int(m.group(1)))
        # bare 'W' suffix means wire count ONLY for plausible 2-4W counts ('4W' feeder);
        # larger numbers with W are wattage, a different (unchecked) dimension.
        for m in re.finditer(r"\b([2-4])\s*(?:-\s*)?w\b", t):
            _add("wire", int(m.group(1)))
        # voltage / amperage
        for m in re.finditer(r"\b(\d+)\s*(?:v\b|vac\b|vdc\b|volt\b|volts\b)", t):
            _add("volt", int(m.group(1)))
        for m in re.finditer(r"\b(\d+)\s*(?:a\b|amp\b|amps\b|ampere\b)", t):
            _add("amp", int(m.group(1)))
        # wire gauge (#12, 12 awg, 12ga) and MCM/kcmil conductor size
        for m in re.finditer(r"#\s*(\d+)\b", t):
            _add("gauge", int(m.group(1)))
        for m in re.finditer(r"\b(\d+)\s*(?:awg\b|ga\b|gauge\b)", t):
            _add("gauge", int(m.group(1)))
        for m in re.finditer(r"\b(\d+)\s*(?:mcm\b|kcmil\b)", t):
            _add("mcm", int(m.group(1)))
        # schedule (sch 40 / schedule 80)
        for m in re.finditer(r"\bsch(?:edule)?\s*\.?\s*(\d+)\b", t):
            _add("sched", int(m.group(1)))
        # v4.1.23 (external audit round 5, finding #9): COLOR / FINISH family. Blue #12
        # THHN must never match red #12 THHN; an ivory device is not an almond device.
        # Conductor METALS (copper/aluminum) are deliberately excluded -- they are a
        # material spec with their own established handling, not a finish.
        for m in re.finditer(
                r"\b(black|white|red|blue|green|brown|orange|yellow|gray|grey|violet|purple|pink|"
                r"ivory|almond|tan|beige|stainless|galvanized|bronze|brass|chrome|nickel)\b", t):
            _c2 = m.group(1)
            _add("color", "gray" if _c2 == "grey" else _c2)
        # trade size / dimension: fraction or decimal, with or without an explicit
        # inch marker ('3/4 emt' has none). Mixed numbers first so 1-1/2 stays whole.
        # A bare INTEGER counts as a size only WITH an inch marker (a bare '2' is
        # more often a quantity/pole/wire count than a dimension).
        for m in re.finditer(r"\b(\d+[-\s]\d+/\d+|\d+/\d+)\s*(?:\"|''|in\b|inch(?:es)?\b|-?inch\b)?", t):
            _add("size", _coverage_size_value(m.group(1)))
        # Strip the fraction tokens before the scalar pass so the '4' inside '3/4 in'
        # cannot leak a phantom 4.0 size. The lookbehind (not \b) lets a LEADING dot
        # anchor ('.75 inch' must parse as 0.75, not 75).
        _t_scalar = re.sub(r"\b\d+[-\s]\d+/\d+|\b\d+/\d+", " ", t)
        for m in re.finditer(r"(?<![\w.])(\d*\.\d+|\d+)\s*(?:\"|''|in\b|inch(?:es)?\b|-?inch\b)", _t_scalar):
            _add("size", _coverage_size_value(m.group(1)))
    except Exception:
        pass
    return fams


def _coverage_spec_conflict(req_item, quoted_item):
    """True when the two lines carry values from the SAME specification family and those
    values are disjoint -- e.g. 1/2in vs 3/4in, 1-pole vs 2-pole, NEMA 5-20R vs 6-20R,
    3-phase vs 1-phase, sch40 vs sch80, #12 vs #10. Families present on only one side
    never block (a vendor rephrasing that omits the size is still allowed through)."""
    try:
        rdesc = str((req_item or {}).get("description", "") if isinstance(req_item, dict) else req_item or "")
        qdesc = str((quoted_item or {}).get("description", "") if isinstance(quoted_item, dict) else quoted_item or "")
        rf = _coverage_spec_families(rdesc)
        qf = _coverage_spec_families(qdesc)
        for fam, rvals in rf.items():
            qvals = qf.get(fam)
            if rvals and qvals and not (rvals & qvals):
                return True
        return False
    except Exception:
        return False


def _coverage_qty_value(item):
    """Parse an item's qty field to a float, or None when absent/unparseable."""
    try:
        raw = str((item or {}).get("qty", "") or "").strip().replace(",", "")
        if not raw:
            return None
        m = re.match(r"(\d+(?:\.\d+)?)", raw)
        return float(m.group(1)) if m else None
    except Exception:
        return None


# v4.1.21 (external audit round 3, finding #10): the AUTOMATIC attachment scanner needs a
# stricter phrase set than the general CUSTOMER_REQUEST_PHRASES -- 'please advise' /
# 'looking for' / 'can you help' on a submittal or packing list must not seed a coverage
# ledger. Explicit pricing intent only; the attached-list regex branches remain separate.
COVERAGE_ATTACH_REQUEST_PHRASES = [
    "please quote", "request for quote", "requesting a quote", "request a quote", "rfq",
    "price and availability", "pricing and availability", "p&a", "price & availability",
    "need pricing", "need a quote", "can you quote", "could you quote", "can you price",
    "could you price", "send me pricing", "send pricing", "looking for a quote",
    "quote the attached", "quote attached", "please price", "quote request",
    "need lead time and pricing", "provide price", "provide pricing", "provide a quote",
]

# v4.1.22 (external audit round 4, finding #6): bump this when the request gate or the
# extraction eligibility rules change -- negative examined-not-request decisions are
# checkpointed against it, so a gate improvement automatically re-examines old mail.
COVERAGE_REQUEST_GATE_VERSION = 1

# v4.1.26 (external audit round 8, defect #3): same idea for the VENDOR QUOTE scan.
# Only content-permanent non-candidates are ever checkpointed (no price in the body,
# no attachments, nothing quote-ish in subject/body) -- a message that carries prices
# or attachments but doesn't currently link to a coverage record stays retryable,
# because coverage records appear and disappear. Bump to re-examine everything.
COVERAGE_QUOTE_GATE_VERSION = 1

# v4.1.26 (round 8, defect #4): keyword gate for reading a candidate's attachments.
# Extended with rfq/bid so a vendor's attachment-only reply on a "Re: RFQ 123" /
# "Re: Bid - Building 4" subject qualifies. ('quotation' is already covered by 'quot'.)
_COVERAGE_QUOTEISH_RE = re.compile(r"quot|pric|avail|p&a|proposal|estimat|rfq|\bbid\b")


# v4.1.28 (external audit round 10, blocker #1): TEXT-QUALITY gate for the
# authoritative-empty decision. A nonblank extraction is NOT automatically a
# successful read -- OCR failure banners, parser error text, replacement-character
# soup, and symbol noise are all "text" that proves nothing about the document.
# Deleting stored quote rows on the strength of such text turned a transient OCR
# regression into permanent coverage loss. An empty reparse may only be treated
# as authoritative when the source text READS like a real document.
_COVERAGE_PARSE_FAILURE_MARKERS = re.compile(
    r"ocr\s*fail|fail(?:ed|ure)?\s*(?:to\s+)?(?:ocr|read|extract|pars)"
    r"|unreadable|illegible|could\s+not\s+(?:be\s+)?(?:read|extract|pars|process)"
    r"|pars(?:e|ing)\s*(?:error|fail)|extraction\s+(?:error|fail)"
    r"|corrupt(?:ed)?\s+(?:file|document|pdf)|password[\s-]*protected"
    # v4.1.29 (round 11): extraction-failure PROSE -- negated-success phrasings a
    # PDF/OCR library emits ("No text could be extracted", "returned no readable
    # text", "contains no extractable text", "produced an empty result"). Defense
    # in depth only: since v4.1.29 attachment-derived text can never authorize
    # deletion at all, these mainly harden the body-only path.
    r"|no\s+(?:readable\s+|extractable\s+|extracted\s+)?text\b"
    r"|(?:could|can)\s+(?:not|n't)\s+.{0,30}extract"
    r"|(?:produced|returned|yielded)\s+(?:an\s+)?empty"
    r"|nothing\s+(?:was\s+)?(?:extracted|recognized|detected)"
    r"|processing\s+(?:failed|did\s+not\s+complete)"
    r"|#{4,}|�{2,}", re.I)

# v4.1.30 (external audit round 12, finding #2): POSITIVE WITHDRAWAL INTENT. The
# v4.1.29 body-only deletion rule proved too broad -- a quote-like body whose prices
# the parser/price-regex missed ("100 EA A1 at ten dollars each") read as trustworthy,
# price-free prose and deleted the stored rows. Absence of evidence is not withdrawal:
# automatic deletion now additionally requires the vendor to have SAID they are
# withdrawing/superseding ("disregard", "cancelled", "superseded", "no bid", "unable
# to quote", "discontinued", ...). A merely price-free body keeps the rows.
_COVERAGE_WITHDRAWAL_INTENT_RE = re.compile(
    r"disregard|withdraw|rescind|void|\bcancel(?!lation)"
    r"|supersed|recall(?:ed|ing)?\b|revok"
    r"|discontinu|obsolete"
    r"|no[\s-]+bid|no[\s-]+quote|not\s+(?:quoting|bidding)"
    r"|unable\s+to\s+(?:quote|bid|price|supply|provide)"
    r"|can(?:no|')t\s+(?:quote|bid|price|supply)"
    r"|cannot\s+(?:quote|bid|price|supply)"
    r"|do\s+not\s+(?:use|apply|honor)\b"
    r"|please\s+ignore|remove\s+(?:our|th[ei]s|that)\s+quote", re.I)

# v4.1.42 (external audit): the pre-negation window must also cover ability/inability
# negations -- "we CAN'T cancel this quote" and "orders CANNOT be cancelled" are the
# opposite of withdrawal, and "unable to cancel" likewise.
# v4.1.43 (external audit of v4.1.42): CONDITIONAL/HYPOTHETICAL guards added -- a
# vendor describing what happens IF the customer cancels ("there may be cancellation
# fees if you cancel", "should you cancel", "if you wish to cancel") is stating
# policy, not withdrawing a quote.
_COVERAGE_WITHDRAWAL_NEGATION_PRE_RE = re.compile(
    r"(?:\bdo\s+not|\bdon['\u2019]t|\bnot|\bnever|\bno\s+longer|\bisn['\u2019]t|\bis\s+not|"
    r"\baren['\u2019]t|\bwon['\u2019]t|\bcan['\u2019]t|\bcannot|\bcan\s+not|\bunable\s+to|"
    r"\bplease\s+do\s+not|"
    r"\bif\s+you|\bshould\s+you|\bbefore\s+you|\bin\s+case\s+you|"
    r"\b(?:wish|want|need|decide|choose|elect|intend)\s+to"
    r")\s+(?:\w+\s+){0,2}$", re.I)

# v4.1.42: the post-match window must also exclude NON-INTENT contexts -- boilerplate
# legalese ("void where prohibited"), policy statements ("cancellation policy",
# "cancellation fees may apply"), and necessity phrasing ("no bid is necessary").
_COVERAGE_WITHDRAWAL_STILL_VALID_RE = re.compile(
    r"\b(?:remains?\s+valid|still\s+valid|still\s+stands?|still\s+good|still\s+honou?r|"
    r"not\s+(?:our|the|this|my)\s+quote|"
    r"where\s+prohibited|polic(?:y|ies)|fees?\s+(?:may\s+)?appl|charges?\s+(?:may\s+)?appl|"
    # v4.1.43: plural/are-form necessity ("no bid alternates ARE necessary").
    r"(?:is|are|was|were)\s+(?:not\s+)?(?:necessary|needed|required))\b", re.I)

# v4.1.43 (external audit of v4.1.42): "no bid" followed immediately by bid
# PARAPHERNALIA is a statement about bid mechanics, not a declined bid.
# v4.1.44 (fifth audit): generalized to ALL intent verbs -- the detector kept
# recognizing broad words (cancel / no quote / unable to quote / cannot supply /
# cannot price) without checking WHAT they refer to. "The cancel OPTION is
# available", "no bid RESULTS were found", "no quote NEEDED", "unable to quote
# the DELIVERY DATE", "cannot supply TRACKING information", "cannot price
# FREIGHT" are not withdrawals of the material quote. When the words immediately
# following the match name a non-quote object (logistics, paperwork, mechanics,
# fees) or elide into necessity ("needed"), the match is not withdrawal intent.
# A genuine withdrawal names the quote/bid/material ("no bid on the requested
# material", "unable to quote item ABC123", "cancel our quote") and none of
# these nouns follow it.
# v4.1.46 (seventh audit, #5): one qualifier word may sit between the determiner
# and the listed noun -- "cannot supply the MATERIAL submittal" previously slipped
# through because the guard could not see past "material". The filler is lazy and
# capped at two words, so "the requested connector" / "the requested item" (real
# withdrawal objects) still fall through to intent. New objects: escalation,
# order(s) ("cancel the order if the project is delayed" is an order instruction,
# not a quote withdrawal), installation/labor/services.
_COVERAGE_WITHDRAWAL_NONOBJECT_RE = re.compile(
    r"^\s*(?:(?:the|a|any|your|all|our)\s+)?(?:[a-z][a-z\-]*\s+){0,2}?"
    r"(?:option|button|policy|polic(?:y|ies)|window|period|deadline|form|forms?|"
    r"fees?|charges?|results?|history|records?|data|"
    r"needed|necessary|required|"
    r"bond|alternates?|packages?|lists?|tabs?|tabulations?|schedules?|"
    r"dates?|deadlines?|openings?|security|documents?|requirements?|"
    r"delivery|freight|shipping|shipment|tracking|lead\s*times?|eta|etas?|"
    r"times?|schedule|information|updates?|status|paperwork|documentation|"
    r"invoices?|invoicing|certs?|certificates?|"
    # v4.1.45 (sixth audit, finding #5): submittal/tax/certificate/terms objects --
    # "cannot supply the SUBMITTAL until approved", "unable to quote TAX until the
    # exemption certificate is received", "cannot quote FREIGHT CLASS", "cannot
    # supply the CERTIFICATE OF INSURANCE". None withdraw the material quote.
    r"submittals?|drawings?|shop\s+drawings?|cut\s*sheets?|"
    r"(?:sales\s+)?tax(?:es)?|exemptions?|"
    r"certificates?\s+of\s+insurance|cois?|w-?9s?|"
    r"payment\s+terms?|terms?\s+and\s+conditions|credit\s+terms?|"
    r"freight\s+class(?:es)?|documentation\s+packages?|"
    r"warrant(?:y|ies)|specs?|specifications?|approvals?|"
    r"tickets?|acknowledge?ments?|confirmations?|"
    r"escalations?|surcharges?|orders?|installation|labor|labour|services?|"
    # v4.1.47 (eighth audit #5): commissioning/testing/report objects -- "cannot
    # price COMMISSIONING", "cannot supply TEST REPORTS" are scope/documentation
    # statements, not material-quote withdrawals.
    r"commissioning|testing|startup|start-up|training|"
    r"test\s+reports?|reports?|mock-?ups?|samples?\s+reports?)\b", re.I)


def _coverage_withdrawal_intent_detected(text):
    """v4.1.35 (E5): the withdrawal regex alone deleted stored quotes on NEGATED
    statements ('please do NOT cancel this quote', 'not obsolete, remains valid',
    'cancel the previous request, not our quote'). Every match is now checked for a
    preceding negation and for validity-affirming / object-excluding language nearby;
    a match is only intent when at least one occurrence survives un-negated. When all
    matches are negated the stored rows are KEPT (no deletion, normal retry path)."""
    t = str(text or "")
    if not t:
        return False
    affirmative = False
    for m in _COVERAGE_WITHDRAWAL_INTENT_RE.finditer(t):
        pre = t[max(0, m.start() - 40):m.start()]
        if _COVERAGE_WITHDRAWAL_NEGATION_PRE_RE.search(pre):
            continue
        post = t[m.end():m.end() + 120]
        if _COVERAGE_WITHDRAWAL_STILL_VALID_RE.search(post):
            continue
        # v4.1.44: intent verb followed immediately by a non-quote object
        # ("cancel OPTION", "no bid RESULTS", "no quote NEEDED", "unable to
        # quote the DELIVERY date", "cannot supply TRACKING") is not a
        # withdrawal of the stored material quote.
        if _COVERAGE_WITHDRAWAL_NONOBJECT_RE.search(post):
            continue
        affirmative = True
        break
    return affirmative



def _coverage_reparse_text_trustworthy(text):
    """True when reparse text is plausible document content -- required before an
    EMPTY parse is allowed to delete previously stored quote rows."""
    t = str(text or "").strip()
    if len(t) < 15:
        return False               # too little content to be authoritative about anything
    if _COVERAGE_PARSE_FAILURE_MARKERS.search(t):
        return False               # the text itself says the read failed
    toks = t.split()
    if len(toks) >= 4:
        _alpha = sum(1 for _w in toks if sum(ch.isalpha() for ch in _w) >= 2)
        if _alpha / float(len(toks)) < 0.45:
            return False           # symbol/number soup, not prose or a real table
    try:
        _bad = t.count("�") + sum(1 for ch in t if ord(ch) < 9)
        if _bad > max(2, len(t) // 50):
            return False           # heavy mojibake / control characters
    except Exception:
        pass
    return True


def _looks_like_priced_quote_text(text):
    """v4.1.20 (external audit round 2, finding #2): quote-shaped price evidence, NOT just
    'contains a number with two decimals'. A customer request legitimately says
    '1.25 inch conduit', '2.00 inches', 'our target is $4.50 each', or 'beat the previous
    price of $12.75' -- none of those make it a vendor quote. What does:
      - two or more currency amounts (a priced line list),
      - a currency amount with per-unit pricing shorthand (/ea, /c, /m, per each ...),
      - unit-price / extended-price wording alongside multiple decimal amounts.
    Used by the customer-request attachment scan to veto vendor-quote mail from unknown
    senders without discarding real customer RFQs that merely mention a number."""
    try:
        t = str(text or "")
        if not t.strip():
            return False
        low = t.lower()
        money = re.findall(r"\$\s*\d[\d,]*(?:\.\d{1,2})?", t)
        if len(money) >= 2:
            return True
        per_unit = re.search(
            r"/\s*(?:ea|c|m|ft|pc)\b|\bper\s+(?:ea|each|c|m|hundred|thousand|ft|foot|pc|piece|unit)\b",
            low)
        if money and per_unit:
            return True
        decs = re.findall(r"\b\d{1,6}\.\d{2}\b", t)
        strong_ctx = re.search(r"unit\s*price|ext(?:ended)?\.?\s*price|price\s*each|net\s*price|list\s*price", low)
        if len(decs) >= 2 and strong_ctx:
            return True
        if len(decs) >= 3 and re.search(r"\b(?:price|pricing|quoted|net|total|subtotal)\b", low) and money:
            return True
        return False
    except Exception:
        return False


def _coverage_norm(text):
    # v4.1.34: memoized; strings are immutable so the cached value is returned directly.
    key = str(text or "")
    hit = _cov_memo_get(_COV_NORM_CACHE, key)
    if hit is not None:
        return hit
    out = _coverage_norm_uncached(key)
    _cov_memo_put(_COV_NORM_CACHE, key, out)
    return out


def _coverage_norm_uncached(text):
    t = str(text or "").lower()
    t = t.replace('&quot;', '"').replace("''", '"')
    t = re.sub(r"[^a-z0-9/\". ]+", " ", t)
    t = re.sub(r"\s+", " ", t).strip()
    return t


def _coverage_catalog_tokens(item):
    # v4.1.34: memoized on (part_number, description) -- the only fields read. A fresh
    # set copy is returned so the callers' mutability contract is unchanged.
    ks = _cov_item_strings(item)
    if ks is None:
        return _coverage_catalog_tokens_uncached(item)
    hit = _cov_memo_get(_COV_CATTOK_CACHE, ks)
    if hit is not None:
        return set(hit)
    out = _coverage_catalog_tokens_uncached(item)
    _cov_memo_put(_COV_CATTOK_CACHE, ks, frozenset(out))
    return out


def _coverage_catalog_tokens_uncached(item):
    """Distinctive catalog/part tokens from an item's part number AND description -- a
    token with BOTH a letter and a digit (e.g. '632s', '10awg', 'rt125'), length >= 3.
    Used so a bare catalog number matches whether it landed in the part field on one
    side and the description on the other (which is why 632S wasn't matching)."""
    try:
        if isinstance(item, str):
            item = {"description": item}
        if not isinstance(item, dict):
            return set()
        txt = (str(item.get("part_number", "") or "") + " " +
               str(item.get("description", "") or "")).lower()
        txt = re.sub(r"[^a-z0-9]+", " ", txt)
        toks = set()
        for t in txt.split():
            if len(t) >= 3 and any(c.isdigit() for c in t) and any(c.isalpha() for c in t):
                toks.add(t)
        return toks
    except Exception:
        return set()


def _coverage_numeric_catalog_tokens(item):
    # v4.1.34: memoized on (part_number, description) -- the only fields read. A fresh
    # set copy is returned so the callers' mutability contract is unchanged.
    ks = _cov_item_strings(item)
    if ks is None:
        return _coverage_numeric_catalog_tokens_uncached(item)
    hit = _cov_memo_get(_COV_NUMCAT_CACHE, ks)
    if hit is not None:
        return set(hit)
    out = _coverage_numeric_catalog_tokens_uncached(item)
    _cov_memo_put(_COV_NUMCAT_CACHE, ks, frozenset(out))
    return out


def _coverage_numeric_catalog_tokens_uncached(item):
    """Numeric-only catalog tokens used as a conservative fallback.

    Some vendor replies shorten manufacturer/catalog text. Example: the requested
    item may be "TPZ 1667", while the vendor replies only "1ea 1667- $150/c".
    The normal alphanumeric catalog-token matcher intentionally misses that because
    "1667" has no letters. This helper allows 3+ digit catalog numbers while
    stripping obvious prices so $150/c does not become a false part match.
    """
    try:
        if isinstance(item, str):
            item = {"description": item}
        if not isinstance(item, dict):
            return set()
        txt = (str(item.get("part_number", "") or "") + " " +
               str(item.get("description", "") or "")).lower()
        # Remove money/price fragments before collecting numbers.
        txt = re.sub(r"\$\s*\d+(?:[.,]\d+)?(?:\s*/\s*[a-z]+)?", " ", txt)
        txt = re.sub(r"\b\d+(?:[.,]\d+)?\s*/\s*(?:ea|each|c|ft|pc|pcs|m)\b", " ", txt)
        nums = set()
        for t in re.findall(r"\b\d{3,8}\b", txt):
            # Avoid common non-catalog noise. Quantities are already stored separately;
            # zip codes and years are not useful material identifiers here.
            if re.fullmatch(r"20\d{2}|19\d{2}", t):
                continue
            if re.fullmatch(r"\d{5}(?:\d{4})?", t):
                continue
            nums.add(t)
        return nums
    except Exception:
        return set()


def _coverage_has_quote_price_evidence(item):
    """True when a parsed quote line contains price/quote evidence near the item."""
    try:
        if isinstance(item, str):
            txt = item
        elif isinstance(item, dict):
            txt = " ".join(str(item.get(k, "") or "") for k in (
                "display", "description", "notes", "unit_price", "price", "total_price"))
        else:
            txt = ""
        # v4.1.34: memoized on the exact joined text (covers every field read above).
        hit = _cov_memo_get(_COV_PRICEEV_CACHE, txt)
        if hit is not None:
            return hit
        low = str(txt or "").lower()
        out = bool(re.search(r"\$\s*\d|\b\d+(?:\.\d+)?\s*/\s*(?:c|ea|each|ft|pc|m)\b|\bstock\b|\bquote\b|\bpriced?\b", low))
        _cov_memo_put(_COV_PRICEEV_CACHE, txt, out)
        return out
    except Exception:
        return False


def _coverage_reply_above_quote(text):
    """Reply text above the quoted history, with line breaks intact (for item extraction).
    _strip_reply_boilerplate_for_intent flattens newlines, which breaks line-based item
    parsing; this keeps the structure. Falls back to the whole text if no quoted-history
    marker is found or nothing precedes it (e.g. bottom-posted replies)."""
    raw = str(text or "").replace("\r\n", "\n").replace("\r", "\n")
    cut = len(raw)
    for pat in (r"(?m)^[ \t>]*On\s[\s\S]{0,300}?\bwrote:",
                r"(?im)^\s*-+\s*Original Message\s*-+",
                r"(?im)^\s*From:\s",
                r"(?m)^\s*_{5,}\s*$"):
        try:
            m = re.search(pat, raw)
        except Exception:
            m = None
        if m and m.start() < cut:
            cut = m.start()
    head = raw[:cut].strip()
    return head or raw.strip()


COVERAGE_ATTACH_PARSER_VERSION = 4  # bump to re-extract already-processed vendor quote replies


def _coverage_reassemble_columnar_quote(text):
    """Rebuild line items from a PDF quote whose text extractor emits ONE TABLE CELL PER
    LINE. Champion (and many vendor quote PDFs) come through PyMuPDF as:
        15 EA
        40ASW82P
        4in IPS, BG; .070in Wall; Elbow, 45 Degree x
        36in Radius; Plain End
        2.3  lb/EA
        $99.36
        $1,490.40
    -- the qty, part number, description, weight and price each land on their OWN line. The
    line-based item parser needs the qty/part/price together, so the standalone part-number
    line ('40ASW82P') gets dropped and the quote never flips coverage. This stitches each
    such block back into a single 'QTY UNIT PART DESC $PRICE' line the parser can read.
    Conservative: it only fires where a qty+unit line is immediately followed by a lone
    catalog code (letter+digit, >=5 chars) -- ordinary prose and normal single-line quote
    rows never match that shape, so they pass through untouched."""
    try:
        raw = str(text or "").replace("\r\n", "\n").replace("\r", "\n")
        lines = [ln.strip() for ln in raw.split("\n") if ln.strip()]
        unit = (r"(?:EA|EACH|PC|PCS|FT|LF|C|M|MFT|BX|BOX|CS|CASE|ROLL|ROLLS|SET|SETS|LOT|"
                r"PR|PAIR|PAIRS|KIT|CTN|CARTON|BAG|BAGS|LENGTH|LENGTHS)")
        qty_unit_re = re.compile(rf"^\d[\d,]*(?:\.\d+)?\s+{unit}$", re.I)
        price_re = re.compile(r"^\$?\s*\d[\d,]*\.\d{2,4}$")
        qty_re = re.compile(r"^\d[\d,]{0,7}$")
        unit_re = re.compile(rf"^{unit}$", re.I)
        weight_re = re.compile(r"^\d[\d,]*(?:\.\d+)?\s*(?:lb|lbs|kg|oz)\b", re.I)
        int_re = re.compile(r"^\d{1,3}$")
        code_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.\-/#]{3,}$")

        def is_code(s):
            if not code_re.fullmatch(s):
                return False
            c = re.sub(r"[^A-Za-z0-9]", "", s)
            return len(c) >= 5 and any(x.isdigit() for x in c) and any(x.isalpha() for x in c)

        out = []
        i = 0
        n = len(lines)
        while i < n:
            if qty_unit_re.match(lines[i]) and i + 1 < n and is_code(lines[i + 1]):
                qty_unit = lines[i]
                part = lines[i + 1]
                j = i + 2
                desc = []
                price = ""
                while j < n:
                    lj = lines[j]
                    if price_re.match(lj):
                        price = lj
                        j += 1
                        break
                    if weight_re.match(lj):      # unit-weight cell -- skip it
                        j += 1
                        continue
                    if qty_unit_re.match(lj) or is_code(lj) or int_re.match(lj):
                        break                    # start of the next item block
                    desc.append(lj)
                    j += 1
                merged = f"{qty_unit} {part} " + " ".join(desc)
                if price:
                    merged += " $" + re.sub(r"[^0-9.]", "", price)
                out.append(merged.strip())
                i = j
                continue
            # Pattern B -- part-first (e.g. Legrand 'Distributor Line Item' quotes). The table
            # renders one CELL per line in this order: line number / part code (sometimes with
            # the description merged onto the same line) / description line(s) / qty / unit /
            # $unit-price / [$total]. Detect a small integer (the table line number) followed
            # by a part code, find the qty+unit pair, then take the first price after them.
            # Stitched into 'QTY UNIT PART DESC $PRICE' so the line parser reads it, exactly
            # like Pattern A. All four pieces (part, qty, unit, price) must be found or the
            # lines pass through untouched.
            if int_re.match(lines[i]) and i + 1 < n:
                first = lines[i + 1]
                part = ""
                lead_desc = ""
                if is_code(first):
                    part = first
                else:
                    head = first.split(None, 1)
                    if len(head) == 2 and is_code(head[0]):
                        part, lead_desc = head[0], head[1]
                if part:
                    j = i + 2
                    desc = [lead_desc] if lead_desc else []
                    qty = ""
                    unit_tok = ""
                    price = ""
                    steps = 0
                    while j < n and steps < 12:
                        lj = lines[j]
                        if not qty and qty_re.match(lj) and j + 1 < n and unit_re.match(lines[j + 1]):
                            qty, unit_tok = lj, lines[j + 1]
                            j += 2
                            steps += 2
                            continue
                        if qty and price_re.match(lj):
                            price = lj
                            j += 1
                            break
                        if int_re.match(lj) and j + 1 < n:
                            nxt = lines[j + 1]
                            nh = nxt.split(None, 1)
                            if is_code(nxt) or (len(nh) == 2 and is_code(nh[0])):
                                break            # start of the next item block
                        if not qty:
                            desc.append(lj)      # description cells come before the qty cell
                        j += 1
                        steps += 1
                    if part and qty and unit_tok and price:
                        merged = f"{qty} {unit_tok} {part} " + " ".join(d for d in desc if d)
                        merged += " $" + re.sub(r"[^0-9.]", "", price)
                        out.append(merged.strip())
                        i = j
                        continue
            out.append(lines[i])
            i += 1
        return "\n".join(out)
    except Exception:
        return text or ""


def _coverage_compact_part_tokens(item):
    # v4.1.34: memoized on (part_number, description) -- the only fields read. A fresh
    # set copy is returned so the callers' mutability contract is unchanged.
    ks = _cov_item_strings(item)
    if ks is None:
        return _coverage_compact_part_tokens_uncached(item)
    hit = _cov_memo_get(_COV_COMPACT_CACHE, ks)
    if hit is not None:
        return set(hit)
    out = _coverage_compact_part_tokens_uncached(item)
    _cov_memo_put(_COV_COMPACT_CACHE, ks, frozenset(out))
    return out


def _coverage_compact_part_tokens_uncached(item):
    """Distinctive catalog/part codes with internal separators removed, so a difference in
    formatting cannot block a match: '40A-SW-82-P', '40A.SW.82.P', '40A/SW/82/P' and the
    bare '40ASW82P' all collapse to '40ASW82P'. A token is either a run of alphanumerics
    joined by '-', '.', or '/', or an already-joined run of 6+ chars; after compacting it
    must be >= 6 chars and carry BOTH a letter and a digit -- long and mixed enough to
    identify a specific product rather than a bare size, quantity, or spec ('070in', '22').
    Read from part_number AND description so a code in either field matches the other side.
    This is what let the Champion quote go unmatched: the vendor's PDF quotes '40ASW82P'
    while the request was written '40A-SW-82-P', and every existing key either kept the
    hyphens or split on them, so the two never lined up."""
    try:
        if isinstance(item, str):
            item = {"description": item}
        if not isinstance(item, dict):
            return set()
        txt = (str(item.get("part_number", "") or "") + " " +
               str(item.get("description", "") or "")).upper()
        out = set()
        for m in re.finditer(r"[A-Z0-9]+(?:[\-./][A-Z0-9]+)+|[A-Z0-9]{6,}", txt):
            compact = re.sub(r"[^A-Z0-9]", "", m.group(0))
            if len(compact) < 6 or not any(c.isdigit() for c in compact) or not any(c.isalpha() for c in compact):
                continue
            # Skip a bare quantity/dimension: digits followed only by a unit word ('1000FT',
            # '500MCM', '250KCMIL'). Those are packaging/spec, not product identity, and two
            # different wires both sold in '1000ft' reels must not match on it. A real part
            # (letters embedded, e.g. '40ASW82P', or a trailing revision like '12345A') is kept.
            if re.fullmatch(r"\d+(?:FT|IN|LB|LBS|PC|PCS|MM|CM|AWG|MCM|KCMIL|OZ|YD|SF|LF|CY|SY|GA|KG|HP|KW|KVA|EA)", compact):
                continue
            out.add(compact)
        return out
    except Exception:
        return set()


def coverage_item_keys(item):
    # v4.1.34: memoized on (part_number, description) -- the only fields read. A fresh
    # set copy is returned so the callers' mutability contract is unchanged.
    ks = _cov_item_strings(item)
    if ks is None:
        return coverage_item_keys_uncached(item)
    hit = _cov_memo_get(_COV_ITEMKEYS_CACHE, ks)
    if hit is not None:
        return set(hit)
    out = coverage_item_keys_uncached(item)
    _cov_memo_put(_COV_ITEMKEYS_CACHE, ks, frozenset(out))
    return out


def coverage_item_keys_uncached(item):
    """Return the set of keys a single material line can be matched on."""
    keys = set()
    try:
        if isinstance(item, str):
            item = {"description": item}
        if not isinstance(item, dict):
            return keys
        part = re.sub(r"\s+", "", str(item.get("part_number", "") or "").upper())
        if len(part) >= 3:
            keys.add("part:" + part[:80])
        ck = (canonical_material_key(item) or "").strip()
        if ck:
            keys.add(ck)
        desc_norm = _coverage_norm(item.get("description", ""))
        if desc_norm:
            keys.add("desc:" + desc_norm[:90])
    except Exception:
        pass
    return {k for k in keys if k}


# Trade sizes/units and generic material categories (PVC, EMT, rigid...) carry no product
# identity on their own; the distinctive noun is what separates a coupling from an adapter,
# or a bell end from pipe. Used by coverage_items_match to stop a coarse canonical-key match
# ('2"', '4" pvc') from marking different products as the same quoted line.
_COVERAGE_GENERIC_MATERIAL_WORDS = frozenset({
    "pvc", "emt", "rigid", "imc", "rmc", "conduit", "metallic", "steel",
    "galvanized", "galv",
})
_COVERAGE_UNIT_WORDS = frozenset({
    "ea", "each", "ft", "feet", "foot", "pc", "pcs", "case", "cs", "ct", "box",
    "in", "inch", "inches", "lb", "lbs", "roll", "rolls", "set", "sets",
    "length", "lengths", "bag", "bags", "lot", "sf", "lf", "cy", "sy", "mm",
})


def _coverage_distinctive_nouns(desc_norm):
    """Specific product nouns from a normalized description -- excludes pure trade sizes
    (2", 3/4"), bare numbers, price-per-unit fragments (200/c), units, and generic material
    categories (pvc/emt/rigid...). Two lines that share only a size or material but have
    DIFFERENT distinctive nouns (2" coupling vs 2" adapter) are different products."""
    out = set()
    try:
        for t in str(desc_norm or "").split():
            if len(t) <= 1:
                continue
            if re.fullmatch(r'\d+(?:[.,]\d+)?(?:/\d+)?"?', t):
                continue
            if re.fullmatch(r'\d+(?:[.,]\d+)?/[a-z]+', t):
                continue
            if t in _COVERAGE_UNIT_WORDS or t in _COVERAGE_GENERIC_MATERIAL_WORDS:
                continue
            out.add(t)
    except Exception:
        pass
    return out


# v3.9.57 over-match gate -------------------------------------------------------------------
# coverage_items_match is deliberately permissive (vendor rephrasings still match). On an RFQ
# where many lines share a brand/section word (MAREK, SUBMITTALS), an amperage rating (20A/30A)
# and a generic device word (RECEPTACLE/white/DECORA), that permissiveness let an UN-priced line
# take a DIFFERENT priced line's number -- '30A DRYER' grabbed the '30A PTAC' price; 'SINGLE POLE
# SWITCH', 'DUPLEX', and plain 'USB' grabbed the 'USB/GFI COMBO' price. The gate below requires a
# Quoted match to also agree on the *distinctive product token*, weighting tokens by how common
# they are across THIS record's own requested lines (so the gate adapts per-RFQ rather than
# leaning on a hand-maintained generic-word list).
_COVERAGE_RATING_RE = re.compile(r'\d+(?:\.\d+)?(?:a|amp|amps|v|volt|volts|w|watt|watts|p|ka|kv|kw|va|kva|hp)')


def _coverage_rating_tokens(desc_norm):
    """Electrical RATING / sizing specs that must AGREE for two lines to be the same product but
    are not product-identifying on their own: amperage/voltage/wattage/poles (20a, 120v, 100w,
    2p) AND wire gauge (10 awg, 350 mcm, 12 ga, 500 kcmil). '20A DRYER' vs '20A PTAC' and
    '12 AWG THHN' vs '10 AWG THHN' are different products despite sharing the rest of the line.
    The gauge number sits in its OWN token (e.g. '10' then 'awg'), so it is captured here as a
    paired spec rather than left as a bare number the distinctive-overlap step would discard."""
    s = str(desc_norm or "")
    out = set()
    try:
        for m in re.findall(r'\b\d+(?:\.\d+)?(?:a|amp|amps|v|volt|volts|w|watt|watts|p|ka|kv|kw|va|kva|hp)\b', s):
            out.add(m)
        for num, unit in re.findall(r'\b(\d+(?:\.\d+)?)\s*(awg|mcm|kcmil|ga)\b', s):
            out.add(num + unit)
    except Exception:
        pass
    return out


def _coverage_record_common_tokens(requested_items):
    """Description tokens that recur across MANY of a record's requested lines carry no product
    identity: brand/section names (MAREK, SUBMITTALS), shared ratings, and generic device words
    (RECEPTACLE, white, DECORA). Computed PER-RECORD so the over-match gate adapts to each RFQ.
    A token is 'common' once it appears in at least max(3, round(n/3)) of the n requested lines
    that carry any usable token. With < 3 such lines there is too little signal, so nothing is
    treated as common and the gate leans on its rating + distinctive-overlap checks alone."""
    try:
        from collections import Counter
        df = Counter()
        n = 0
        for it in requested_items or []:
            desc = it.get("description", "") if isinstance(it, dict) else str(it or "")
            toks = {t for t in _coverage_norm(desc).split()
                    if len(t) > 1 and not re.fullmatch(r'\d+(?:[.,]\d+)?(?:/\d+)?"?', t)}
            if not toks:
                continue
            n += 1
            for t in toks:
                df[t] += 1
        if n < 3:
            return set()
        thresh = max(3, int(round(n / 3.0)))
        return {t for t, c in df.items() if c >= thresh}
    except Exception:
        return set()


def _coverage_distinctive_product_tokens(desc_norm, common_tokens):
    """The product-identifying tokens of a line: what is left after removing pure sizes,
    electrical ratings, price-per-unit fragments, units, generic materials, and the record's own
    common tokens. For '20A white DECORA SINGLE POLE SWITCH' (SUBMITTALS/20A/white/DECORA common)
    this leaves {single, pole, switch}; for 'USB/GFI COMBO RECEPTACLE' it leaves {usb/gfi, combo}.
    _coverage_norm keeps '/', so 'usb/gfi' is one token distinct from a plain 'usb'."""
    out = set()
    try:
        for t in str(desc_norm or "").split():
            if len(t) <= 1:
                continue
            if t in common_tokens:
                continue
            if re.fullmatch(r'\d+(?:[.,]\d+)?(?:/\d+)?"?', t):
                continue
            if re.fullmatch(r'\d+(?:[.,]\d+)?/[a-z]+', t):
                continue
            if _COVERAGE_RATING_RE.fullmatch(t):
                continue
            if t in _COVERAGE_UNIT_WORDS or t in _COVERAGE_GENERIC_MATERIAL_WORDS:
                continue
            out.add(t)
    except Exception:
        pass
    return out


def _coverage_distinctive_match_ok(req_item, quoted_item, common_tokens):
    """Precision gate layered on top of coverage_items_match. A requested line should be marked
    Quoted by a priced reply line only when they are the SAME product -- not merely when they
    share a brand/section word, an amperage rating, or a generic device word. Passes when (a) the
    two share a part number (definitive); otherwise requires (b) compatible ratings AND a strong
    (>= 0.6 Jaccard) overlap of the distinctive product tokens. If either side has no distinctive
    token to compare, it defers to the base matcher (returns True) so genuine rephrasings of a
    line with only generic words are not lost."""
    try:
        rp = re.sub(r"\s+", "", str((req_item.get("part_number", "") if isinstance(req_item, dict) else "") or "").upper())
        qp = re.sub(r"\s+", "", str((quoted_item.get("part_number", "") if isinstance(quoted_item, dict) else "") or "").upper())
        if len(rp) >= 3 and rp == qp:
            return True
        # A shared distinctive part/catalog code (identical once '-', '.', '/' are removed)
        # is definitive even when the two sides DESCRIBE the product differently -- the
        # request says 'Champion 40A-SW-82-P 45deg', the PDF says '40ASW82P ... 4in IPS
        # Elbow 45 Degree' -- so don't require their prose to overlap once the code agrees.
        if _coverage_compact_part_tokens(req_item) & _coverage_compact_part_tokens(quoted_item):
            return True
        # v4.1.9: a shared catalog-style code of 5+ chars (letters AND digits, not a bare
        # dimension/quantity like '112in' or '1000ft') is likewise definitive -- this catches
        # short real part numbers such as Wiremold '711WH', which the 6+ char compact rule
        # above doesn't reach, while a rating like '20a' (3 chars) or a size never qualifies.
        for _t in (_coverage_catalog_tokens(req_item) & _coverage_catalog_tokens(quoted_item)):
            _c = re.sub(r"[^a-z0-9]", "", str(_t or "").lower())
            if (len(_c) >= 5 and any(ch.isdigit() for ch in _c) and any(ch.isalpha() for ch in _c)
                    and not re.fullmatch(
                        r"\d+(?:ft|in|lb|lbs|pc|pcs|mm|cm|awg|mcm|kcmil|oz|yd|sf|lf|cy|sy|ga|kg|hp|kw|kva|ea)", _c)):
                return True
        # v4.1.19 AUDIT FIX (external audit finding #5): the base matcher deliberately
        # accepts a SHORT (3-4 char) catalog code -- '632S' as the requested part number
        # matched inside the vendor's description -- and a NUMERIC-only catalog code
        # ('TPZ 1667' vs '1ea 1667- $150/c') when the quoted line shows price evidence.
        # This gate then vetoed both, leaving genuinely quoted lines Outstanding forever.
        # Accept them here under the same conditions the base matcher requires:
        # (a) short code: it is EXPLICITLY the requested item's part_number, the quoted
        #     line carries price evidence, and the code is not a measurement/rating/unit;
        # (b) numeric catalog: both sides agree on a numeric catalog token AND the quoted
        #     line carries price evidence (mirrors coverage_items_match exactly).
        _rp_compact = re.sub(r"[^a-z0-9]", "", rp.lower())
        if (3 <= len(_rp_compact) <= 4
                and any(ch.isdigit() for ch in _rp_compact)
                and not re.fullmatch(
                    r"\d+(?:ft|in|lb|lbs|pc|pcs|mm|cm|awg|mcm|kcmil|oz|yd|sf|lf|cy|sy|ga|kg|hp|kw|kva|ea|a|v|w|p|amp|ph)", _rp_compact)
                and _coverage_has_quote_price_evidence(quoted_item)):
            _q_codes = {re.sub(r"[^a-z0-9]", "", str(_t or "").lower())
                        for _t in (_coverage_catalog_tokens(quoted_item) | _coverage_numeric_catalog_tokens(quoted_item))}
            if _rp_compact in _q_codes:
                return True
        if (_coverage_numeric_catalog_tokens(req_item) & _coverage_numeric_catalog_tokens(quoted_item)) \
                and _coverage_has_quote_price_evidence(quoted_item):
            return True
        # v4.1.21 (external audit round 3, finding #1): SPECIFICATION-FAMILY GATE. Once no
        # shared part/catalog code has settled it, a quote whose size/pole/phase/wire/NEMA/
        # voltage/gauge/schedule CONFLICTS with the requested line is a DIFFERENT product --
        # a 3/4in connector must never mark a 1/2in connector Quoted just because the
        # product noun agrees. Families present on only one side never block.
        _rf = _coverage_spec_families(req_item.get("description", "") if isinstance(req_item, dict) else str(req_item or ""))
        _qf = _coverage_spec_families(quoted_item.get("description", "") if isinstance(quoted_item, dict) else str(quoted_item or ""))
        for _famname, _rvals in _rf.items():
            _qvals = _qf.get(_famname)
            if _rvals and _qvals and not (_rvals & _qvals):
                return False
        _sizes_agree = bool(_rf.get("size") and _qf.get("size") and (_rf["size"] & _qf["size"]))
        rdesc = _coverage_norm(req_item.get("description", "") if isinstance(req_item, dict) else str(req_item or ""))
        qdesc = _coverage_norm(quoted_item.get("description", "") if isinstance(quoted_item, dict) else str(quoted_item or ""))
        r_rate = _coverage_rating_tokens(rdesc)
        q_rate = _coverage_rating_tokens(qdesc)
        if r_rate and q_rate and not (r_rate & q_rate):
            return False
        r_prod = _coverage_distinctive_product_tokens(rdesc, common_tokens)
        q_prod = _coverage_distinctive_product_tokens(qdesc, common_tokens)
        # v4.1.21: when the explicit sizes AGREE, a size-shaped token ('3/4in') is not a
        # product difference -- drop digit-led tokens so '3/4 in connector' vs
        # '3/4in connector' isn't split by spacing (pre-existing miss surfaced in audit
        # round 3 testing; fails-safe direction, but needless Outstanding noise).
        if _sizes_agree:
            r_prod = {_t for _t in r_prod if not str(_t)[:1].isdigit()}
            q_prod = {_t for _t in q_prod if not str(_t)[:1].isdigit()}
        if not r_prod or not q_prod:
            return True
        inter = len(r_prod & q_prod)
        union = len(r_prod | q_prod)
        return union > 0 and (inter / float(union)) >= 0.6
    except Exception:
        return True


def coverage_items_match(req_item, quoted_item):
    """True if a quoted line plausibly covers a requested line."""
    try:
        rk = coverage_item_keys(req_item)
        qk = coverage_item_keys(quoted_item)
        if not rk or not qk:
            return False
        # Strongest: shared part number.
        rp = {k for k in rk if k.startswith("part:")}
        qp = {k for k in qk if k.startswith("part:")}
        if rp and (rp & qp):
            return True
        # v4.1.23 finding #1 / v4.1.24 (round 6, blocker #3): the EXPLICIT part-number
        # decision comes FIRST, before ANY description-derived matching. When both sides
        # carry a reliable explicit part number: equal after separator/case normalization
        # (40A-SW-82-P == 40ASW82P) is definitive -- MATCH; unequal is definitive the
        # other way -- REJECT. A shared code inside the descriptions (MODEL123) can never
        # bridge two conflicting explicit parts anymore; the priced substitute then flows
        # into the Check review path.
        def _reliable_pn(_it):
            _p = re.sub(r"[^A-Z0-9]", "", str((_it or {}).get("part_number", "") if isinstance(_it, dict) else "").upper())
            if len(_p) < 3:
                return ""
            # qty/unit fragments ('1EA', '50FT', '100PCS') that a parser sometimes drops
            # into the part field are NOT reliable part numbers.
            if re.fullmatch(r"\d+(?:EA|FT|PC|PCS|LF|SF|LB|LBS|RL|BX|CS|M|C)", _p):
                return ""
            return _p
        _rpn = _reliable_pn(req_item)
        _qpn = _reliable_pn(quoted_item)
        if _rpn and _qpn:
            if _rpn == _qpn:
                return True
            return False
        # Separator-insensitive part/catalog identity for rows where only ONE side has an
        # explicit part (the code may live inside the other side's description). Gated on
        # price evidence as before.
        comp = _coverage_compact_part_tokens(req_item) & _coverage_compact_part_tokens(quoted_item)
        if comp and _coverage_has_quote_price_evidence(quoted_item):
            return True
        # v4.1.22 finding #11 / v4.1.23 finding #7: the SPEC-CONFLICT veto runs BEFORE the
        # catalog-token fallbacks -- 'L5-30R' and 'L6-30R' share the bare token '30R', and
        # that fragment must never bridge a NEMA conflict (it marked the wrong line Waiting
        # and let a requote remove the wrong quote). Only genuinely identical explicit part
        # numbers (checked above) may override a spec conflict.
        if _coverage_spec_conflict(req_item, quoted_item):
            return False
        # Bare catalog-number match: a distinctive alphanumeric token (digit+letter,
        # e.g. '632s') shared across the two items' part/description. Handles a catalog
        # number stored as a part on one side and inside the description on the other.
        cat = _coverage_catalog_tokens(req_item) & _coverage_catalog_tokens(quoted_item)
        if cat:
            return True
        # Numeric-only catalog fallback for vendor shorthand. Example: requested
        # "TPZ 1667" vs vendor line "1ea 1667- $150/c". Gate it behind
        # quote/price evidence so random quantities, dates, and freight numbers do
        # not mark a requested item quoted.
        num_cat = _coverage_numeric_catalog_tokens(req_item) & _coverage_numeric_catalog_tokens(quoted_item)
        if num_cat and _coverage_has_quote_price_evidence(quoted_item):
            return True
        # Normalized electrical canonical key overlap (size + trade noun). A shared canonical
        # key is necessary but NOT sufficient: a bare trade size ('2"') or a generic material
        # category ('4" pvc') collides across genuinely different products (2" coupling vs 2"
        # adapter; 4" SCH 40 PVC pipe vs 4" PVC bell end). v3.9.25: block the canonical match
        # only when BOTH lines carry a specific product noun and those noun sets are disjoint.
        # Same-product rewords (e.g. '1" RIGID' vs '1" RIGID conduit', only generic words) are
        # unaffected, so vendor rephrasings still match.
        rc = {k for k in rk if not k.startswith("part:") and not k.startswith("desc:")}
        qc = {k for k in qk if not k.startswith("part:") and not k.startswith("desc:")}
        rd = next((k[5:] for k in rk if k.startswith("desc:")), "")
        qd = next((k[5:] for k in qk if k.startswith("desc:")), "")
        if rc and (rc & qc):
            r_nouns = _coverage_distinctive_nouns(rd)
            q_nouns = _coverage_distinctive_nouns(qd)
            conflicting = bool(r_nouns) and bool(q_nouns) and not (r_nouns & q_nouns)
            if not conflicting:
                return True
        # Conservative description token-overlap fallback.
        if rd and qd:
            rtok = {t for t in rd.split() if len(t) > 1}
            qtok = {t for t in qd.split() if len(t) > 1}
            if rtok and qtok:
                overlap = len(rtok & qtok)
                if overlap >= 2 and overlap >= min(len(rtok), len(qtok)) * 0.6:
                    return True
                if len(rtok) == 1 and rtok <= qtok:
                    return True
        # v4.1.23 (external audit round 5, finding #8): specification AGREEMENT is
        # positive evidence, not only conflict-prevention. '120/208V panel' and
        # '208Y/120V panel' share an agreeing voltage system and the same product noun
        # but no canonical size key, so every rule above missed them. Require: at least
        # one spec family with a non-empty intersection on BOTH sides, a shared
        # distinctive product noun, price evidence on the quoted line, and (already
        # guaranteed above) no conflicting family.
        try:
            _rf2 = _coverage_spec_families((req_item or {}).get("description", "") if isinstance(req_item, dict) else str(req_item or ""))
            _qf2 = _coverage_spec_families((quoted_item or {}).get("description", "") if isinstance(quoted_item, dict) else str(quoted_item or ""))
            _agree = sum(1 for _fam, _rv in _rf2.items()
                         if _rv and _qf2.get(_fam) and (_rv & _qf2[_fam]))
            if _agree >= 1 and _coverage_has_quote_price_evidence(quoted_item):
                _rn = _coverage_distinctive_nouns(rd)
                _qn = _coverage_distinctive_nouns(qd)
                if _rn and _qn and (_rn & _qn):
                    return True
        except Exception:
            pass
    except Exception:
        pass
    return False


def money_to_float(value):
    try:
        txt = re.sub(r"[^0-9.\-]", "", str(value or ""))
        return float(txt) if txt not in ["", ".", "-"] else None
    except Exception:
        return None


def purchase_history_line_noise_reason(value):
    """Return a reason when a candidate line is obviously not a material line."""
    line = re.sub(r"\s+", " ", str(value or "")).strip()
    low = line.lower()
    if not low:
        return "blank"
    if len(low) < 3:
        return "too_short"

    # Common RFQ/body/signature/logistics lines that should never become materials.
    reject_phrases = [
        "address:", "phone number:", "phone:", "tel:", "fax:", "email:", "from company:",
        "from:", "sent:", "to:", "cc:", "subject:", "external origin", "caution:",
        "please email", "email your quote", "provide your budget pricing",
        "provide your pricing", "we will need your pricing", "pricing back by",
        "quote directly", "please quote", "please provide", "request for quote",
        "budget pricing", "project manager", "territory manager", "sales manager",
        "customer service", "technical services", "thank you", "thanks", "regards",
        "sincerely", "best regards", "unsubscribe", "confidential", "terms and conditions",
        "purchase order", "order number", "order confirmation", "invoice attached",
        "please see attached", "see attached", "has shipped", "tracking", "delivered",
    ]
    if any(p in low for p in reject_phrases):
        return "body_or_signature_text"

    # Addresses and location lines are frequent false positives.
    if re.search(r"\b\d{3,6}\s+[-A-Za-z0-9 .']+\s+(street|st\.?|road|rd\.?|avenue|ave\.?|drive|dr\.?|lane|ln\.?|blvd|boulevard|parkway|pkwy|court|ct\.?|circle|cir\.?|place|plaza|way)\b", low):
        return "address"
    if re.search(r"\b[A-Za-z .'-]+,\s*(ny|nj|ct|pa|ca|fl|tx|ma|ri|de|md|va)\s+\d{5}(?:-\d{4})?\b", line, flags=re.I):
        return "city_state_zip"
    if re.fullmatch(r"\d{5}(?:-\d{4})?", low):
        return "zip_only"
    if re.fullmatch(r"[A-Za-z .'-]+,\s*[A-Z]{2}\s+\d{5}(?:-\d{4})?", line.strip()):
        return "city_state_zip"

    # Pure contact/phone/url/email lines.
    if re.search(r"\b\d{3}[-.) ]+\d{3}[-. ]+\d{4}\b", low):
        return "phone"
    if re.search(r"https?://|www\.|[\w.+-]+@[\w.-]+\.[a-z]{2,}", low):
        return "url_or_email"

    # Sentence-only instructions with no price/qty/catalog evidence.
    words = re.findall(r"[A-Za-z]+", low)
    has_money = bool(re.search(r"\$\s*\d|\b\d+\.\d{2,4}\b", line))
    has_qty = bool(re.search(r"^\s*\d+(?:\.\d+)?\s*(ea|each|ft|feet|pc|pcs|box|bag|roll|set|lot|m|c)\b", line, flags=re.I))
    has_catalog = bool(re.search(r"\b[A-Z]{1,6}[-/]?[0-9][A-Z0-9\-/.]{2,}\b|\b[0-9][A-Z]{1,5}[-/]?[A-Z0-9\-/.]{2,}\b", line))
    if len(words) >= 8 and not (has_money or has_qty or has_catalog):
        return "sentence_no_line_item_clue"

    return ""


def purchase_history_extract_part_number_from_text(value):
    """Best-effort catalog/part number finder for purchase history rows."""
    line = str(value or "")
    # Avoid picking up zip codes or phone numbers.
    if purchase_history_line_noise_reason(line) in ["address", "city_state_zip", "zip_only", "phone", "url_or_email"]:
        return ""
    patterns = [
        r"\b[A-Z]{1,8}[0-9][A-Z0-9]*(?:[-/.][A-Z0-9]+){1,4}\b",  # IP710-D2Z, ABC-123
        r"\b[0-9]{1,4}[A-Z]{1,8}[A-Z0-9]*(?:[-/.][A-Z0-9]+){0,4}\b",  # 2G11, 1EMT...
        r"\b[A-Z]{2,8}\d{2,}[A-Z0-9\-/.]*\b",  # THHN12 etc.
    ]
    for pat in patterns:
        m = re.search(pat, line)
        if m:
            token = m.group(0).strip(" -:;,")
            if re.fullmatch(r"\d{5}(?:-\d{4})?", token):
                continue
            return token
    return ""


def is_likely_purchase_material_row(row_or_desc):
    """Strict guard for old-email purchase-history rows.

    This rejects addresses/signatures/RFQ instructions and accepts only rows that
    have real line-item evidence: a trade material word, catalog/part number,
    quantity/unit, or price.
    """
    if isinstance(row_or_desc, dict):
        desc = str(row_or_desc.get("description", "") or "")
        part = str(row_or_desc.get("part_number", "") or "")
        qty = str(row_or_desc.get("qty", "") or "")
        unit = str(row_or_desc.get("unit", "") or "")
        unit_price = row_or_desc.get("unit_price")
        total_price = row_or_desc.get("total_price")
        raw_line = str(row_or_desc.get("raw_line", "") or "")
    else:
        desc = str(row_or_desc or "")
        part = ""
        qty = ""
        unit = ""
        unit_price = None
        total_price = None
        raw_line = ""

    text = re.sub(r"\s+", " ", f"{part} {desc}".strip()).strip()
    raw_text = re.sub(r"\s+", " ", raw_line or desc).strip()
    low = text.lower()
    if len(low) < 3:
        return False

    noise_reason = purchase_history_line_noise_reason(raw_text or text)
    if noise_reason:
        # Hard reject these even if a random number appears.
        return False

    material_words = [
        "emt", "pvc", "rigid", "conduit", "connector", "strap", "locknut", "bushing",
        "coupling", "nipple", "wire", "cable", "breaker", "panel", "box", "gutter",
        "kindorf", "strut", "washer", "nut", "rod", "paint", "tie", "fitting",
        "receptacle", "switch", "cover", "device", "transformer", "lug", "bolt",
        "screw", "anchor", "unistrut", "channel", "hubbell", "leviton", "burndy",
        "southwire", "thhn", "mc cable", "mccb", "gfci", "afci", "nema", "dimmer",
        "disconnect", "fuse", "ground", "clamp", "ring", "terminal", "pipe", "elbow"
    ]
    has_material_word = any(re.search(r"\b" + re.escape(w) + r"\b", low) for w in material_words)
    extracted_part = purchase_history_extract_part_number_from_text(raw_text or text)
    has_part = bool((part and len(re.sub(r"[^A-Za-z0-9]", "", part)) >= 3) or extracted_part)
    has_qty = bool(qty or re.search(r"^\s*\d+(?:\.\d+)?\s*(ea|each|ft|feet|pc|pcs|bag|box|roll|set|lot|m|c)\b", raw_text or text, flags=re.I))
    has_price = bool(unit_price is not None or total_price is not None or re.search(r"\$\s*\d", raw_text or text))

    # Accept catalog/price rows like "IP710-D2Z $72.69" even if they do not contain
    # an obvious trade word. Reject standalone prose/numbers.
    if has_part and (has_price or has_qty or has_material_word or len(low) <= 80):
        return True
    if has_material_word and (has_qty or has_price or has_part or unit):
        return True
    return False



def procurement_vendor_label(v):
    name = str(v.get("name", "") or "").strip()
    email = str(v.get("email", "") or "").strip()
    return f"{name} <{email}>" if name and email and name.lower() != email.lower() else (email or name)


def outlook_thread_init():
    """Initialize Outlook COM when Quote Intelligence runs from a background thread."""
    did_init = False
    try:
        if pythoncom:
            pythoncom.CoInitialize()
            did_init = True
    except Exception:
        did_init = False
    return did_init


def outlook_thread_uninit(did_init):
    try:
        if did_init and pythoncom:
            pythoncom.CoUninitialize()
    except Exception:
        pass


def outlook_msg_internet_id(msg):
    """v4.1.23 (external audit round 5, finding #6): normalized RFC-5322 Message-ID for a
    live Outlook message, '' on any failure. Quote identity keys on this instead of the
    EntryID, so a moved/restored message (new EntryID, same Message-ID) can never store
    the same vendor quote twice and double its allocated quantity."""
    try:
        pa = msg.PropertyAccessor
        try:
            raw = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
        except Exception:
            raw = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001E") or "")
        return re.sub(r"\s+", "", raw).strip().lower()
    except Exception:
        return ""


def outlook_attachment_is_inline(att):
    """Best-effort inline image detector so logos/signatures do not pollute OCR.

    v2.8.4I critical fix:
    Outlook can attach MAPI content-id metadata to a real RFQ/PO PDF. The prior
    version treated ANY content-id as inline, so NY-30906.pdf was skipped before
    SaveAsFile ever ran. We now only apply inline/signature skipping to image
    file extensions. PDFs, Excel files, Word docs, CSVs, ZIPs, etc. are NEVER
    skipped by this inline detector.
    """
    try:
        fname = str(getattr(att, "FileName", "") or "").strip().lower()
    except Exception:
        fname = ""

    image_exts = (".png", ".jpg", ".jpeg", ".gif", ".bmp", ".tif", ".tiff", ".webp")
    is_image = fname.endswith(image_exts)

    # Never classify real document/spreadsheet/archive attachments as inline.
    # This is the important fix for RFQ PDFs that Outlook marks with content-id.
    if not is_image:
        return False

    try:
        pa = att.PropertyAccessor
        content_id = pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x3712001F")
        if content_id:
            return True
    except Exception:
        pass

    try:
        if fname.startswith("image"):
            try:
                size = int(getattr(att, "Size", 0) or 0)
                if size < 60000:
                    return True
            except Exception:
                return True
    except Exception:
        pass
    return False


class CategoryPicker:
    def __init__(self, root, allow_auto_open=True):
        self.root = root
        self.allow_auto_open = allow_auto_open
        self.settings = load_mainbox_settings()
        self.root.title("Select Sales Category")
        remember_window_geometry(self.root, "Select Sales Category", "520x520")
        apply_theme(self.root)
        self.outlook = None
        self.namespace = None
        self.categories = []
        self.remember_category_var = tk.BooleanVar(value=bool(self.settings.get("remember_sales_category_on_startup", False)))
        self.setup_ui()
        self.load_cached_categories()

    def setup_ui(self):
        tk.Label(self.root, text="Select Your Sales Category", font=("Segoe UI", 18, "bold"), fg=_ACCENT, bg=_BG).pack(pady=15)
        tk.Label(self.root, text="Choose the Outlook category assigned to you.", font=("Segoe UI", 10), fg=_FG_DIM, bg=_BG).pack(pady=5)
        self.status_label = tk.Label(self.root, text="Loading cached categories...", font=("Segoe UI", 10, "italic"), fg=_FG_DIM, bg=_BG)
        self.status_label.pack(pady=5)
        self.category_list = tk.Listbox(self.root, height=14, font=("Segoe UI", 11), bg=_BG3, fg=_FG, selectbackground=_SEL_BG, selectforeground=_SEL_FG, borderwidth=0, highlightthickness=1, highlightcolor=_ACCENT, relief="flat")
        self.category_list.pack(fill="both", expand=True, padx=20, pady=10)
        self.category_list.bind("<Double-Button-1>", lambda event: self.open_monitor())
        tk.Checkbutton(
            self.root,
            text="Remember this category on startup",
            variable=self.remember_category_var,
            bg=_BG,
            fg=_FG,
            selectcolor=_BG3,
            activebackground=_BG,
        ).pack(anchor="w", padx=20, pady=(0, 6))
        btn_frame = tk.Frame(self.root, bg=_BG)
        btn_frame.pack(fill="x", padx=20, pady=15)
        tk.Button(btn_frame, text="Reload Categories", command=self.reload_categories_from_outlook).pack(side="left")
        tk.Button(btn_frame, text="Open Monitor", command=self.open_monitor).pack(side="right")

    def set_status(self, text):
        self.status_label.config(text=text, fg=_FG_DIM, bg=_BG)
        self.root.update_idletasks()

    def load_cached_categories(self):
        cache = load_json(CATEGORY_CACHE_FILE, {})
        self.categories = cache.get("categories", [])
        self.category_list.delete(0, tk.END)
        for category in self.categories:
            self.category_list.insert(tk.END, category)
        if self.categories:
            remembered = str(self.settings.get("remembered_sales_category", "") or "").strip()
            selected_index = 0
            if remembered:
                for idx, category in enumerate(self.categories):
                    if str(category or "").strip().lower() == remembered.lower():
                        selected_index = idx
                        break
            self.category_list.selection_set(selected_index)
            self.category_list.see(selected_index)
            self.set_status(f"Loaded {len(self.categories)} cached categories. Cached at: {cache.get('cached_at', 'unknown')}")
            if self.allow_auto_open and bool(self.settings.get("remember_sales_category_on_startup", False)) and remembered and self.categories[selected_index].strip().lower() == remembered.lower():
                self.set_status(f"Opening remembered category: {self.categories[selected_index]}")
                self.root.after(250, self.open_monitor)
        else:
            self.set_status("No cached categories yet. Click Reload Categories.")

    def save_category_cache(self):
        save_json(CATEGORY_CACHE_FILE, {"cached_at": datetime.now().strftime("%Y-%m-%d %I:%M %p"), "categories": self.categories})

    def find_sales_inbox_folder(self):
        try:
            folders = self.namespace.Folders
            for i in range(1, folders.Count + 1):
                root = folders.Item(i)
                if SALES_MAILBOX_NAME.lower() in str(root.Name).lower():
                    try:
                        return root.Folders.Item("Inbox")
                    except Exception:
                        return root
            for i in range(1, folders.Count + 1):
                root = folders.Item(i)
                try:
                    return root.Folders.Item(SALES_MAILBOX_NAME)
                except Exception:
                    pass
        except Exception:
            pass
        return None

    def reload_categories_from_outlook(self):
        self.category_list.delete(0, tk.END)
        self.categories = []
        self.set_status("Connecting to Outlook...")
        self.outlook, self.namespace = connect_outlook()
        if not self.namespace:
            self.set_status("Could not connect to Outlook.")
            return
        self.set_status("Finding Sales mailbox...")
        folder = self.find_sales_inbox_folder()
        if not folder:
            self.set_status("Sales mailbox not found.")
            messagebox.showerror("Sales Inbox Not Found", f"Could not find shared mailbox/folder named '{SALES_MAILBOX_NAME}'.")
            return
        try:
            self.set_status("Scanning Sales categories...")
            messages = folder.Items
            messages.Sort("[ReceivedTime]", True)
            categories_found = set()
            scanned = 0
            for msg in messages:
                if scanned >= 500:
                    break
                scanned += 1
                if scanned % 50 == 0:
                    self.set_status(f"Scanning categories... {scanned} emails checked")
                try:
                    msg_categories = str(msg.Categories or "").strip()
                    if not msg_categories:
                        continue
                    for part in msg_categories.split(","):
                        part = part.strip()
                        if part:
                            categories_found.add(part)
                except Exception:
                    continue
            self.categories = sorted(list(categories_found), key=str.lower)
            for category in self.categories:
                self.category_list.insert(tk.END, category)
            if self.categories:
                remembered = str(self.settings.get("remembered_sales_category", "") or "").strip()
                selected_index = 0
                if remembered:
                    for idx, category in enumerate(self.categories):
                        if str(category or "").strip().lower() == remembered.lower():
                            selected_index = idx
                            break
                self.category_list.selection_set(selected_index)
                self.category_list.see(selected_index)
                self.save_category_cache()
                self.set_status(f"Reloaded and cached {len(self.categories)} categories.")
            else:
                self.set_status("No categories found.")
        except Exception as e:
            self.set_status("Category reload failed.")
            messagebox.showerror("Category Load Error", f"Could not load categories from Sales inbox.\n\n{e}")

    def open_monitor(self):
        selected = self.category_list.curselection()
        if not selected:
            messagebox.showwarning("No Category Selected", "Please select a sales category first.")
            return
        selected_category = self.category_list.get(selected[0])
        try:
            settings = load_mainbox_settings()
            settings["remember_sales_category_on_startup"] = bool(self.remember_category_var.get())
            settings["remembered_sales_category"] = selected_category if bool(self.remember_category_var.get()) else ""
            save_json(MAINBOX_SETTINGS_FILE, settings)
        except Exception:
            pass
        self.set_status("Opening monitor...")

        # Simple standalone splash window while the full monitor initializes.
        # Keep this separate from the header/progress widgets so it does not
        # leave a moving green bar in the main UI.
        try:
            self.root.destroy()
        except Exception:
            pass

        main_root = tk.Tk()
        main_root.withdraw()

        splash = tk.Toplevel(main_root)
        splash.title("Opening MaINbox")
        splash.geometry("420x150")
        splash.resizable(False, False)
        splash.configure(bg=_BG)
        try:
            splash.attributes("-topmost", True)
        except Exception:
            pass
        tk.Label(splash, text="Opening MaINbox...", font=("Segoe UI", 16, "bold"), fg=_ACCENT, bg=_BG).pack(pady=(28, 8))
        tk.Label(splash, text=f"Loading category: {selected_category}", font=("Segoe UI", 10), fg=_FG, bg=_BG).pack(pady=4)
        tk.Label(splash, text="Please wait.", font=("Segoe UI", 9, "italic"), fg=_FG_DIM, bg=_BG).pack(pady=4)
        try:
            splash.update_idletasks()
            x = (splash.winfo_screenwidth() // 2) - (420 // 2)
            y = (splash.winfo_screenheight() // 2) - (150 // 2)
            splash.geometry(f"420x150+{x}+{y}")
            splash.update()
        except Exception:
            pass

        # Build the monitor while the real main window remains hidden.
        # Some PCs/Outlook profiles take a few seconds after category selection
        # to load cached data, connect to Outlook, and schedule startup checks.
        # Keep this plain splash visible for a minimum of 10 seconds so the app
        # never looks broken/frozen during that handoff.
        OutlookWorkflowMonitor(main_root, selected_category)

        def reveal_main_window():
            try:
                splash.destroy()
            except Exception:
                pass
            try:
                main_root.deiconify()
                main_root.lift()
                main_root.focus_force()
            except Exception:
                pass

        try:
            splash.lift()
            splash.focus_force()
        except Exception:
            pass
        main_root.after(10000, reveal_main_window)
        # v3.9.94: arm the UI-freeze detector on the long-lived main window. If the
        # event loop stops processing for >10s (a hang that later recovers, which
        # faulthandler never sees), crash_guard dumps every thread's stack to
        # mainbox_crash.log and logs how long the freeze lasted -- so the next
        # lockup names exactly what the main thread was stuck on. Guarded so a
        # missing/old crash_guard can never stop the app from starting.
        try:
            crash_guard.start_hang_detector(main_root)
        except Exception:
            pass
        main_root.mainloop()


