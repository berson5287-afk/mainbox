    def on_group_select(self, event=None):
        """v41: selecting a group is for selection/notes/actions only. It no longer filters the main email list."""
        selected = self.groups_tree.selection() if hasattr(self, "groups_tree") else []
        if not selected:
            return
        iid = selected[0]
        if iid.startswith("group:"):
            group_id = iid.split(":", 1)[1]
            self.mark_group_seen(group_id)
        elif iid.startswith("member:"):
            parts = iid.split(":", 2)
            if len(parts) == 3:
                self.mark_group_seen(parts[1])
                entry_id = parts[2]
                if self.tree.exists(entry_id):
                    self.tree.selection_set(entry_id)
                    self.tree.focus(entry_id)
                    self.tree.see(entry_id)
        self.load_selected_group_notes()

    def on_group_open_close(self, event=None):
        if not hasattr(self, "groups_tree"):
            return
        for group in self.groups_data.get("groups", []):
            iid = f"group:{group.get('id', '')}"
            if self.groups_tree.exists(iid):
                group["collapsed"] = not bool(self.groups_tree.item(iid, "open"))
        self.save_groups()

