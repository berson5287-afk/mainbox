        def apply_preset(*args):
            profile = profile_var.get()
            if profile == "conservative":
                followup_conf_var.set(0.86)
                triage_conf_var.set(0.78)
                relevance_var.set(0.78)
                spam_var.set(0.25)
                rescan_hours_var.set(18.0)
                scan_limit_var.set(12)
                preset_hint.config(text="Conservative = slower learning, fewer mistakes, more manual confirmation.")
            elif profile == "balanced":
                followup_conf_var.set(0.78)
                triage_conf_var.set(0.68)
                relevance_var.set(0.72)
                spam_var.set(0.35)
                rescan_hours_var.set(12.0)
                scan_limit_var.set(20)
                preset_hint.config(text="Balanced = current recommended behavior for daily business use.")
            elif profile == "fast":
                followup_conf_var.set(0.66)
                triage_conf_var.set(0.58)
                relevance_var.set(0.64)
                spam_var.set(0.45)
                rescan_hours_var.set(4.0)
                scan_limit_var.set(35)
                preset_hint.config(text="Fast = learns quicker and scans more, but may need more correction if it over-learns.")
            elif profile == "aggressive":
                # v4.1.51: every dial at its most aggressive allowed value, learned
                # rules apply immediately (no confirm gate), and unambiguous category
                # corrections durably type the sender. The Sticky-Type + Low-Floor
                # clamps still protect typed Customers/Vendors from auto-junking no
                # matter how aggressive these dials are.
                followup_conf_var.set(0.50)
                triage_conf_var.set(0.40)
                relevance_var.set(0.40)
                spam_var.set(0.45)
                rescan_hours_var.set(0.25)
                scan_limit_var.set(250)
                confirm_var.set(False)
                auto_type_var.set(True)
                preset_hint.config(text="Aggressive = fastest learning MaINbox allows: one correction locks a sender's workflow, "
                                        "unambiguous categories auto-type the sender (Customer Issue -> Customer, Vendor / Supplier -> Vendor, "
                                        "automated Junk -> Marketing), max scan volume. Customers/Vendors are still never auto-junked.")
            else:
                preset_hint.config(text="Custom = use your own thresholds below.")

        profile_var.trace_add("write", apply_preset)
        apply_preset()

