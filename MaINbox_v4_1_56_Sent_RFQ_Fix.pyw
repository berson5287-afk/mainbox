    def create_outlook_mail_item(self, to_addr, subject, body, display_only=True):
        outlook, namespace = self.fresh_outlook()
        if not outlook:
            raise Exception("Could not connect to Outlook.")
        mail = outlook.CreateItem(0)
        mail.To = to_addr
        mail.Subject = subject
        mail.HTMLBody = html_escape_basic(body)
        if display_only:
            self.display_outlook_item_foreground(mail)
        else:
            mail.Send()
        return True

    def create_or_update_outlook_commitment_reminder(self, item):
        """v3.8.15: drop (or reschedule) a real Outlook calendar reminder for a
        commitment so it shows in the user's Outlook calendar and alarms even when
        MaINbox is closed. Fully guarded and thread-safe; never raises, never blocks
        reminder creation. Returns True if an appointment was created/updated."""
        if not isinstance(item, dict):
            return False
        if not bool(self.settings.get("commitment_create_outlook_reminder", True)):
            return False
        did_init = outlook_thread_init()
        try:
            outlook, namespace = self.fresh_outlook()
            if not outlook:
                return False
            try:
                start_dt = datetime.fromisoformat(item.get("due_at", ""))
            except Exception:
                return False
            label = item.get("kind_label", "Promised date")
            subj = (item.get("subject", "") or "").strip()
            target = item.get("target_date", "")
            try:
                target_disp = datetime.fromisoformat(target).strftime("%m/%d/%Y") if target else ""
            except Exception:
                target_disp = str(target or "")
            appt_subject = f"Follow up: {label}" + (f" - {subj}" if subj else "")
            body_lines = [
                "MaINbox auto-reminder.",
                f"Type: {label}",
                f"Promised/target date: {target_disp}",
                f"From: {item.get('sender','')}",
                f"Subject: {subj}",
            ]
            matched = (item.get("matched_text", "") or "").strip()
            if matched:
                body_lines.append("")
                body_lines.append(f"Detected: {matched}")
            appt_body = "\n".join(body_lines)

            appt = None
            existing_id = item.get("outlook_appt_entry_id", "")
            if existing_id and namespace:
                try:
                    appt = namespace.GetItemFromID(existing_id)
                except Exception:
                    appt = None
            created_new = False
            if appt is None:
                appt = outlook.CreateItem(1)  # olAppointmentItem
                created_new = True
            appt.Subject = appt_subject
            appt.Body = appt_body
            appt.Start = start_dt
            appt.Duration = 15  # minutes
            appt.ReminderSet = True
            appt.ReminderMinutesBeforeStart = 0
            try:
                appt.BusyStatus = 0  # olFree - a reminder, not a blocking meeting
            except Exception:
                pass
            try:
                appt.Categories = "MaINbox Follow-Up"
            except Exception:
                pass
            appt.Save()
            try:
                new_id = appt.EntryID or ""
            except Exception:
                new_id = ""
            if new_id and new_id != existing_id:
                item["outlook_appt_entry_id"] = new_id
                try:
                    self.save_commitment_reminders()
                except Exception:
                    pass
            try:
                self.log(f"Outlook calendar reminder {'created' if created_new else 'updated'} for {start_dt.strftime('%m/%d %I:%M %p')}: {appt_subject[:60]}")
            except Exception:
                pass
            return True
        except Exception:
            return False
        finally:
            try:
                outlook_thread_uninit(did_init)
            except Exception:
                pass

    def learn_vendor_history_from_rfq(self, vendors, materials, group, emails):
        customer_hint = self.get_customer_hint_for_group(group, emails)
        hist = self.vendor_history
        now = datetime.now().isoformat()
        for vendor in vendors:
            email = str(vendor.get("email", "") or "").lower().strip()
            name = str(vendor.get("name", "") or email).strip()
            if not email or is_blocked_internal_vendor(email, name):
                continue
            vrec = hist.setdefault("vendors", {}).setdefault(email, {"email": email, "name": name, "times_used": 0, "last_used_at": ""})
            vrec["name"] = name or vrec.get("name", email)
            vrec["times_used"] = int(vrec.get("times_used", 0) or 0) + 1
            vrec["last_used_at"] = now
            if customer_hint:
                crec = hist.setdefault("customers", {}).setdefault(customer_hint, {}).setdefault(email, {"times_used": 0, "last_used_at": ""})
                crec["times_used"] = int(crec.get("times_used", 0) or 0) + 1
                crec["last_used_at"] = now
            for item in materials or []:
                key = normalize_material_key(item.get("part_number", ""), item.get("description", ""))
                if not key:
                    continue
                entries = hist.setdefault("materials", {}).setdefault(key, [])
                found = None
                for rec in entries:
                    if str(rec.get("email", "")).lower() == email:
                        found = rec
                        break
                if not found:
                    found = {"email": email, "name": name, "times_used": 0, "last_used_at": ""}
                    entries.append(found)
                found["times_used"] = int(found.get("times_used", 0) or 0) + 1
                found["last_used_at"] = now
                found["sample_description"] = item.get("description", "")
        self.save_vendor_history()
        try:
            self.record_procurement_request(vendors, materials, group, subject="RFQ")
        except Exception:
            pass

