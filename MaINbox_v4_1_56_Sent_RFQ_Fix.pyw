# ============================================================================
# v3.8.10  Commitment / promised-date auto follow-ups (engine)
# Scans OUTBOUND email body + attachment text for dated commitments and turns
# each into a dated follow-up that coexists with MaINbox's manual follow-ups
# and automatic scenario reminders (its own reminder lane). Pure text -> data;
# no Outlook / AI / tkinter calls here so it stays fully unit-testable.
# ============================================================================

_MONTHS = {
    'jan': 1, 'january': 1, 'feb': 2, 'february': 2, 'mar': 3, 'march': 3,
    'apr': 4, 'april': 4, 'may': 5, 'jun': 6, 'june': 6, 'jul': 7, 'july': 7,
    'aug': 8, 'august': 8, 'sep': 9, 'sept': 9, 'september': 9, 'oct': 10,
    'october': 10, 'nov': 11, 'november': 11, 'dec': 12, 'december': 12,
}
_WEEKDAYS = {
    'monday': 0, 'mon': 0, 'tuesday': 1, 'tue': 1, 'tues': 1, 'wednesday': 2,
    'wed': 2, 'thursday': 3, 'thu': 3, 'thur': 3, 'thurs': 3, 'friday': 4,
    'fri': 4, 'saturday': 5, 'sat': 5, 'sunday': 6, 'sun': 6,
}

COMMITMENT_KIND_LABELS = {
    'ship': 'Promised Ship Date',
    'arrival': 'Estimated Arrival/Delivery',
    'backorder': 'Backorder / Restock',
    'quote_expiration': 'Quote / Price Expiration',
    'callback': 'Promised Callback / Follow-up',
    'payment_due': 'Payment / Invoice Due',
    'lead_time': 'Lead Time',
    'will_call': 'Will-Call / Ready for Pickup',
    'rma': 'RMA / Return Window',
    'tracking': 'Tracking Provided - Confirm Delivery',
}

# Trigger keywords mapped to a commitment kind. The date classifier picks the
# kind whose keyword sits CLOSEST to a detected date; a date with no trigger
# keyword nearby is ignored (precision-first).
_TRIGGERS = [
    ('quote_expiration', r'expir\w*|valid\s+(?:through|thru|until|til|to|for)|good\s+(?:through|thru|until|til|for)|firm\s+(?:through|thru|until|til|for)|offer\s+valid|pricing\s+valid|quote\s+valid|price\s+valid'),
    ('payment_due', r'payment\s+due|invoice\s+due|balance\s+due|amount\s+due|remit\s+by|payable\s+by|due\s+date|net\s+\d{1,3}'),
    ('backorder', r'back\s?order\w*|restock\w*|back\s+in\s+stock|in\s+stock|expected\s+in|available\b'),
    ('will_call', r'will[\s-]?call|ready\s+for\s+(?:pick\s?up|pickup|collection|will\s?call)|available\s+for\s+pick\s?up|pick\s?up\s+ready'),
    ('rma', r'\brma\b|return\s+authorization|return\s+merchandise|return(?:ed)?\s+(?:by|within|before)'),
    ('ship', r'ship\w*|dispatch\w*|leaves?\s+our|will\s+ship|ships?\s+(?:on|by|out)?'),
    ('arrival', r'arriv\w*|delivery|deliver\w*|\beta\b|e\.t\.a|estimated\s+(?:time\s+of\s+arrival|delivery|arrival)|expected\s+(?:delivery|arrival|by)?|on\s*site|to\s+your\s+door|received\s+by'),
    ('callback', r'follow[\s-]?up|circle\s+back|get\s+back\s+to\s+you|touch\s+base|call\s+you|reach\s+out|update\s+you|let\s+you\s+know|advise\s+you|get\s+you\s+(?:a|an|the)'),
    ('lead_time', r'lead[\s-]?time'),
]
_TRIGGER_RES = [(k, re.compile(p, re.I)) for k, p in _TRIGGERS]

# ---- date sub-patterns -----------------------------------------------------
# Day/month alternations list MULTI-DIGIT forms first so "20" is not greedily
# matched as "2" by the single-digit alternative.
_D = r'3[01]|[12]\d|0?[1-9]'   # day 1-31
_M = r'1[0-2]|0?[1-9]'         # month 1-12
# Numeric M/D[/Y] - guarded so fractions/inches/part-numbers/ranges don't match.
_RX_NUM = re.compile(
    r'(?<![\d$/.\-])(?P<m>' + _M + r')[/\-](?P<d>' + _D + r')'
    r'(?:[/\-](?P<y>\d{4}|\d{2}))?'
    r'(?![\d"\u2019\'/])'
    r'(?!\s*(?:business|biz|working|days?|weeks?|wk|months?)\b)',
)
_RX_ISO = re.compile(r'(?<!\d)(?P<y>\d{4})-(?P<m>1[0-2]|0[1-9])-(?P<d>3[01]|[12]\d|0[1-9])(?!\d)')
_MON_ALT = (r'jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|'
            r'aug(?:ust)?|sep(?:t|tember)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?')
_RX_MON_DAY = re.compile(
    r'\b(?P<mon>' + _MON_ALT + r')\.?\s+(?P<d>' + _D + r')(?:st|nd|rd|th)?'
    r'(?:,?\s+(?P<y>\d{4}))?', re.I)
_RX_DAY_MON = re.compile(
    r'\b(?P<d>' + _D + r')(?:st|nd|rd|th)?\s+(?:of\s+)?(?P<mon>' + _MON_ALT + r')\.?'
    r'(?:,?\s+(?P<y>\d{4}))?', re.I)
_RX_WEEKDAY = re.compile(
    r'\b(?P<rel>next|this|coming)?\s*(?P<wd>monday|tuesday|wednesday|thursday|friday|saturday|sunday|'
    r'mon|tues?|wed|thur?s?|fri|sat|sun)\b', re.I)
_RX_THE_NTH = re.compile(r'\bthe\s+(?P<d>' + _D + r')(?:st|nd|rd|th)\b', re.I)
_RX_SPECIAL = re.compile(
    r'\b(?P<sp>today|tomorrow|end\s+of\s+(?:the\s+)?next\s+week|end\s+of\s+next\s+week|'
    r'end\s+of\s+(?:the\s+)?week|eow|end\s+of\s+(?:the\s+)?month|eom|end\s+of\s+next\s+month)\b', re.I)

# Relative durations ("in 3-5 business days", "2 week lead time", "within 10 days")
_RX_DUR = re.compile(
    r'(?P<n1>\d{1,3})\s*(?:[-\u2013]|to)\s*(?P<n2>\d{1,3})\s*(?P<unit2>business\s+day|biz\s+day|working\s+day|day|week|wk|month)s?'
    r'|(?P<n>\d{1,3})\s*(?P<unit>business\s+day|biz\s+day|working\s+day|day|week|wk|month)s?', re.I)
_RX_NET = re.compile(r'\bnet\s*(?P<net>\d{1,3})\b', re.I)
_RX_TRACKING = re.compile(
    r'\btracking\s*(?:#|number|no\.?|num)\b|\b(?:ups|fedex|usps|dhl|ontrac)\s+tracking\b'
    r'|\b1z[0-9a-z]{16}\b|\btracking\s*:', re.I)


def _clamp_day(y, m, d):
    """Return a valid date, clamping day to the month's last day if needed."""
    for dd in (d, 28):
        try:
            return date(y, m, min(dd, d))
        except ValueError:
            try:
                return date(y, m, dd)
            except ValueError:
                continue
    return None


def _resolve_md(m, d, y, ref):
    """Resolve a month/day(/year) to the nearest sensible date relative to ref.

    With an explicit year, use it. Without one, choose the nearest FUTURE
    occurrence; if that lands more than ~10 months out it is treated as a stale
    past date and rejected (returns None)."""
    if y is not None:
        if y < 100:
            y += 2000
        return _clamp_day(y, m, d)
    cand = _clamp_day(ref.year, m, d)
    if cand is None:
        return None
    if cand >= ref - timedelta(days=2):
        return cand
    nxt = _clamp_day(ref.year + 1, m, d)
    if nxt and (nxt - ref).days <= 305:
        return nxt
    return None


def _next_weekday(ref, wd, force_next=False):
    days = (wd - ref.weekday()) % 7
    if days == 0:
        days = 7  # treat bare weekday as the upcoming one, not today
    target = ref + timedelta(days=days)
    if force_next and (target - ref).days < 7:
        target += timedelta(days=7)
    return target


def _add_business_days(d, n):
    cur = d
    step = 1 if n >= 0 else -1
    remaining = abs(int(n))
    while remaining > 0:
        cur += timedelta(days=step)
        if cur.weekday() < 5:
            remaining -= 1
    return cur


def _end_of_week(ref):
    return ref + timedelta(days=(4 - ref.weekday()) % 7)  # Friday


def _end_of_month(ref):
    if ref.month == 12:
        nxt = date(ref.year + 1, 1, 1)
    else:
        nxt = date(ref.year, ref.month + 1, 1)
    return nxt - timedelta(days=1)


def _iter_date_matches(text, ref):
    """Yield (start, end, date_obj, basis) for every date expression in text.

    Higher-priority patterns are matched first and their spans are reserved so
    lower-priority patterns cannot double-match the same characters."""
    claimed = []

    def overlaps(s, e):
        return any(not (e <= cs or s >= ce) for cs, ce in claimed)

    out = []
    # 1) ISO  2) month-name  3) day-month  4) numeric
    for rx, basis in ((_RX_ISO, 'iso'), (_RX_MON_DAY, 'monthname'),
                       (_RX_DAY_MON, 'monthname'), (_RX_NUM, 'numeric')):
        for mt in rx.finditer(text):
            s, e = mt.start(), mt.end()
            if overlaps(s, e):
                continue
            gd = mt.groupdict()
            try:
                if 'mon' in gd and gd.get('mon'):
                    mon = _MONTHS.get(gd['mon'].lower().rstrip('.'))
                    if not mon:
                        continue
                    dd = int(gd['d'])
                    yy = int(gd['y']) if gd.get('y') else None
                    do = _resolve_md(mon, dd, yy, ref)
                else:
                    mm = int(gd['m']); dd = int(gd['d'])
                    yy = int(gd['y']) if gd.get('y') else None
                    do = _resolve_md(mm, dd, yy, ref)
            except Exception:
                do = None
            if do:
                claimed.append((s, e))
                out.append((s, e, do, basis))
    # 5) special words
    for mt in _RX_SPECIAL.finditer(text):
        s, e = mt.start(), mt.end()
        if overlaps(s, e):
            continue
        sp = re.sub(r'\s+', ' ', mt.group('sp').lower())
        if sp == 'today':
            do = ref
        elif sp == 'tomorrow':
            do = ref + timedelta(days=1)
        elif 'next week' in sp:
            do = _end_of_week(ref) + timedelta(days=7)
        elif 'next month' in sp:
            do = _end_of_month(ref if ref.month == 12 else date(ref.year, ref.month + 1, 1))
        elif sp in ('eow',) or 'week' in sp:
            do = _end_of_week(ref)
        elif sp in ('eom',) or 'month' in sp:
            do = _end_of_month(ref)
        else:
            do = None
        if do:
            claimed.append((s, e))
            out.append((s, e, do, 'phrase'))
    # 6) weekday names
    for mt in _RX_WEEKDAY.finditer(text):
        s, e = mt.start(), mt.end()
        if overlaps(s, e):
            continue
        wd = _WEEKDAYS.get(mt.group('wd').lower())
        if wd is None:
            continue
        force = bool(mt.group('rel') and mt.group('rel').lower() == 'next')
        do = _next_weekday(ref, wd, force_next=force)
        claimed.append((s, e))
        out.append((s, e, do, 'weekday'))
    # 7) "the 15th"
    for mt in _RX_THE_NTH.finditer(text):
        s, e = mt.start(), mt.end()
        if overlaps(s, e):
            continue
        dd = int(mt.group('d'))
        do = _clamp_day(ref.year, ref.month, dd)
        if do and do < ref:
            do = _clamp_day(ref.year + (ref.month == 12), (ref.month % 12) + 1, dd)
        if do:
            claimed.append((s, e))
            out.append((s, e, do, 'dayofmonth'))
    out.sort(key=lambda t: t[0])
    return out


def _nearest_trigger(window):
    """Return (kind, distance) for the trigger keyword closest to the END of the
    window (the date sits just after the window text we pass), or (None, None)."""
    best_kind, best_pos = None, -1
    for kind, rx in _TRIGGER_RES:
        for m in rx.finditer(window):
            if m.start() > best_pos:
                best_pos, best_kind = m.start(), kind
    if best_kind is None:
        return None, None
    return best_kind, len(window) - best_pos


def _snippet(text, s, e, pad=36):
    a = max(0, s - pad); b = min(len(text), e + 8)
    return re.sub(r'\s+', ' ', text[a:b]).strip()


def extract_commitment_dates(text, today=None, max_results=12):
    """Scan free text for dated business commitments.

    Returns a list of dicts sorted by date:
      {kind, label, date(date), date_iso, matched_text, basis, confidence}
    """
    if not text:
        return []
    ref = (today or datetime.now()).date() if isinstance(today, datetime) else (today or datetime.now().date())
    if isinstance(ref, datetime):
        ref = ref.date()
    text = str(text)
    low = text.lower()
    found = {}  # (kind, date_iso) -> dict (keep highest confidence)

    def add(kind, do, snippet, basis, conf):
        if not do:
            return
        if do < ref - timedelta(days=2) or (do - ref).days > 370:
            return
        key = (kind, do.isoformat())
        prev = found.get(key)
        if prev and prev['confidence'] >= conf:
            return
        found[key] = {
            'kind': kind, 'label': COMMITMENT_KIND_LABELS.get(kind, kind.title()),
            'date': do, 'date_iso': do.isoformat(),
            'matched_text': snippet, 'basis': basis, 'confidence': round(conf, 2),
        }

    # ---- pass 1: explicit dates classified by the nearest trigger keyword ----
    WINDOW_BEFORE = 64
    for s, e, do, basis in _iter_date_matches(text, ref):
        # "from <date>" is a start anchor, not a target commitment date.
        if low[max(0, s - 6):s].rstrip().endswith('from'):
            continue
        win = low[max(0, s - WINDOW_BEFORE):s]
        # also allow a trigger that appears right AFTER the date ("6/15 ship date")
        win_after = low[e:min(len(low), e + 22)]
        kind, dist = _nearest_trigger(win)
        if kind is None:
            ka, _ = _nearest_trigger(win_after)
            kind = ka
            dist = 0 if ka else None
        if kind is None:
            continue
        conf = 0.9
        if basis in ('weekday', 'dayofmonth'):
            conf = 0.72
        elif basis == 'phrase':
            conf = 0.8
        if dist is not None and dist > 48:
            conf -= 0.15
        add(kind, do, _snippet(text, s, e), basis, conf)

    # ---- pass 2: relative durations classified by the nearest trigger --------
    DUR_BEFORE = 52
    for dm in _RX_DUR.finditer(low):
        unit = (dm.group('unit2') or dm.group('unit') or '').lower()
        if dm.group('n2'):
            n = int(dm.group('n2'))
        elif dm.group('n1'):
            n = int(dm.group('n1'))
        else:
            n = int(dm.group('n'))
        win = low[max(0, dm.start() - DUR_BEFORE):dm.start()]
        kind, _dist = _nearest_trigger(win)
        if kind is None:
            continue
        if 'week' in unit or unit == 'wk':
            do = ref + timedelta(weeks=n)
        elif 'month' in unit:
            do = ref + timedelta(days=30 * n)
        elif 'business' in unit or 'biz' in unit or 'working' in unit:
            do = _add_business_days(ref, n)
        else:
            do = ref + timedelta(days=n)
        add(kind, do, _snippet(text, dm.start(), dm.end()), 'relative', 0.75)

    # ---- pass 3: payment terms "net 30" --------------------------------------
    for nm in _RX_NET.finditer(low):
        n = int(nm.group('net'))
        add('payment_due', ref + timedelta(days=n), _snippet(text, nm.start(), nm.end()), 'relative', 0.7)

    # ---- pass 4: tracking number => confirm delivery in a few business days ---
    if _RX_TRACKING.search(low):
        has_ship_or_arrival = any(k in ('ship', 'arrival') for (k, _d) in found.keys())
        if not has_ship_or_arrival:
            mt = _RX_TRACKING.search(text)
            add('tracking', _add_business_days(ref, 4),
                _snippet(text, mt.start(), mt.end()), 'tracking', 0.62)

    # ---- pass 5: will-call / ready-for-pickup with no explicit date ----------
    wc = re.search(_TRIGGERS[3][1], low, re.I)
    if wc and not any(k == 'will_call' for (k, _d) in found.keys()):
        add('will_call', _add_business_days(ref, 1),
            _snippet(text, wc.start(), wc.end()), 'default', 0.6)

    results = sorted(found.values(), key=lambda r: (r['date'], -r['confidence']))
    return results[:max_results]


def commitment_fire_datetime(target_date, buffer='morning_of', hour=8, now=None):
    """Compute when a reminder for target_date should fire, per the buffer rule."""
    now = now or datetime.now()
    if isinstance(target_date, datetime):
        target_date = target_date.date()
    hour = max(0, min(23, int(hour)))
    if buffer == 'day_after':
        d = _add_business_days(target_date, 1)
    elif buffer == 'two_days_before':
        d = _add_business_days(target_date, -2)
    else:  # morning_of
        d = target_date
    fire = datetime(d.year, d.month, d.day, hour, 0, 0)
    if fire <= now:
        fire = now + timedelta(minutes=1)
    return fire


def get_commitment_followup_message(kind, target_display, greeting="Hello"):
    msgs = {
        'ship': f"{greeting},\n\nFollowing up on this order - the promised ship date ({target_display}) is here. Can you confirm it has shipped and send tracking, or let me know the new ship date? I want to keep the customer updated.",
        'arrival': f"{greeting},\n\nFollowing up on delivery for this order. The estimated arrival was {target_display} - can you confirm it was delivered/received, or provide an updated ETA?",
        'backorder': f"{greeting},\n\nFollowing up on the backordered item(s). The expected restock/availability date was {target_display} - is this back in stock and ready to ship?",
        'quote_expiration': f"{greeting},\n\nFollowing up on the quote we sent - the pricing was valid through {target_display}. Would you like to move forward, or should I refresh the pricing?",
        'callback': f"{greeting},\n\nFollowing up as promised ({target_display}). I wanted to circle back on this - please let me know the latest and I'll keep things moving.",
        'payment_due': f"{greeting},\n\nA friendly reminder that payment for this invoice was due {target_display}. Please let me know if it has been sent or if you need anything from us.",
        'lead_time': f"{greeting},\n\nFollowing up on this order based on the lead time provided ({target_display}). Can you confirm status and an updated ship/arrival date?",
        'will_call': f"{greeting},\n\nFollowing up on the will-call/pickup order (ready around {target_display}). Can you confirm it's ready, or that it was picked up?",
        'rma': f"{greeting},\n\nFollowing up on the RMA/return (window around {target_display}). Can you confirm the return was received and that credit/replacement is processing?",
        'tracking': f"{greeting},\n\nFollowing up on this shipment - tracking was provided, so it should be arriving around now ({target_display}). Can you confirm delivery so I can update the customer?",
        'reply_needed': f"{greeting},\n\nThank you for your email - I'm working on this for you now and will follow up shortly with what you need. Please let me know if anything has changed in the meantime.",
    }
    return msgs.get(kind, f"{greeting},\n\nFollowing up on this item ({target_display}). Please advise the latest status.")


# ============================================================================
# ============================================================================
# v3.8.25  Stock & Subs mailbox search matcher (engine)
# Lets the user manually search their own Outlook mail (My Inbox / Sales / Sent,
# back N days, plus extra keywords) for stock/substitute/pricing mentions the AI
# may have missed, and import the best snippets. Pure text -> match + snippet.
# ============================================================================

# Words that signal a message is talking about availability / substitutes / pricing.
_STOCK_SIGNAL_RX = re.compile(
    r"\b(in stock|out of stock|stock|backorder|back order|back-order|restock|lead\s*time|"
    r"availab\w*|on hand|on-hand|qty\b|quantity|ship\w*|deliver\w*|\beta\b|substitut\w*|"
    r"equivalent|cross\s*ref\w*|alternat\w*|replace\w*|interchang\w*|price|pricing|quote|"
    r"\$\d|each\b|/ea\b|per\s*(?:ft|foot|piece|pc|ea))\b",
    re.I,
)


def _norm(s):
    return re.sub(r"\s+", " ", str(s or "")).strip()


def build_search_terms(item, extra_keywords=""):
    """Build the list of search terms for a line item plus any user keywords.

    Returns (required_terms, all_terms): required_terms are the strong identifiers
    (part number, key description tokens); all_terms includes extra keywords."""
    terms = []
    part = _norm(item.get("part_number", "")) if isinstance(item, dict) else ""
    desc = _norm(item.get("description", "")) if isinstance(item, dict) else ""
    mfg = _norm(item.get("manufacturer", "")) if isinstance(item, dict) else ""
    if part:
        terms.append(part)
    # Pull distinctive description tokens (length >= 3, skip pure stopwords/units).
    stop = {"the", "and", "for", "with", "ft", "in", "ea", "pcs", "pc", "each", "of", "x"}
    for tok in re.split(r"[\s,;/]+", desc):
        t = tok.strip().strip('".()').lower()
        if len(t) >= 3 and t not in stop and not t.isdigit():
            terms.append(tok.strip().strip('".()'))
    if mfg:
        terms.append(mfg)
    # de-dupe preserving order, case-insensitive
    seen = set()
    required = []
    for t in terms:
        k = t.lower()
        if k and k not in seen:
            seen.add(k)
            required.append(t)

    extra = []
    for kw in re.split(r"[,\n;]+", str(extra_keywords or "")):
        kw = kw.strip()
        if kw and kw.lower() not in seen:
            seen.add(kw.lower())
            extra.append(kw)

    all_terms = required + extra
    return required, all_terms


def message_matches_search(text, subject, required_terms, extra_terms,
                           match_mode="any", require_stock_signal=False):
    """Decide whether a message body+subject is relevant to the search.

    match_mode:
      - 'any'  : match if ANY required/extra term appears (default, most permissive)
      - 'all'  : match only if ALL required terms appear (extra terms still optional)
    require_stock_signal: also require a stock/availability/sub/pricing keyword.

    Returns (matched: bool, hit_terms: list)."""
    hay = (_norm(subject) + " \n " + _norm(text)).lower()
    if not hay.strip():
        return False, []
    req_hits = [t for t in required_terms if t and t.lower() in hay]
    extra_hits = [t for t in extra_terms if t and t.lower() in hay and t not in required_terms]

    if match_mode == "all" and required_terms:
        base = len(req_hits) == len([t for t in required_terms if t])
        # extra keywords broaden: an extra-term hit alone also qualifies
        matched = base or bool(extra_hits)
    else:
        matched = bool(req_hits) or bool(extra_hits)

    if matched and require_stock_signal:
        if not _STOCK_SIGNAL_RX.search(hay):
            return False, (req_hits + extra_hits)
    return matched, (req_hits + extra_hits)


def extract_stock_snippet(text, hit_terms, max_lines=3, max_chars=320):
    """Pull the most relevant lines from a matched message: lines containing a hit
    term or a stock/availability/pricing signal. Falls back to the first lines."""
    text = str(text or "")
    if not text.strip():
        return ""
    lows = [t.lower() for t in (hit_terms or []) if t]
    picked = []
    for raw in text.splitlines():
        line = _norm(raw)
        if not line:
            continue
        low = line.lower()
        if any(t in low for t in lows) or _STOCK_SIGNAL_RX.search(low):
            picked.append(line)
        if len(picked) >= max_lines:
            break
    if not picked:
        for raw in text.splitlines():
            line = _norm(raw)
            if line:
                picked.append(line)
            if len(picked) >= max_lines:
                break
    out = " | ".join(picked)
    return out[:max_chars]


# v3.8.15  Stock + Substitute intelligence (engine)
# After RFQ line items are extracted, surface sourcing intel from the app's own
# procurement memory (vendors/prices/lead-time notes), AI-suggested equivalents
# (local Ollama, safe-fail), and a pluggable external-stock provider seam so a
# live distributor/aggregator API can be wired later. Pure logic; no tkinter.
# Uses module-level helpers already defined elsewhere: canonical_material_key,
# money_to_float, extract_json_object, ai_model_for_task, and the OLLAMA_* globals.
# ============================================================================
import urllib.parse

# ---------------------------------------------------------------------------
# 1) Sourcing intel from the app's own procurement memory (no network needed)
# ---------------------------------------------------------------------------
def build_material_sourcing_intel(item, procurement_memory, max_price_points=12):
    """Aggregate what MaINbox already knows about sourcing one material line.

    Returns a dict:
      {key, found, sample_description, vendors[], cheapest, most_recent,
       price_points[], lead_time_hints[]}
    'vendors' is ranked best-first (preferred > awards > RFQs > has-price)."""
    mem = procurement_memory if isinstance(procurement_memory, dict) else {}
    key = canonical_material_key(item) if item else ""
    intel = {
        "key": key, "found": False, "sample_description": "",
        "vendors": [], "cheapest": None, "most_recent": None,
        "price_points": [], "lead_time_hints": [],
    }
    if not key:
        return intel

    mrec = (mem.get("materials", {}) or {}).get(key, {}) or {}
    vendors_out = []
    for email, stat in (mrec.get("vendors", {}) or {}).items():
        if not isinstance(stat, dict):
            continue
        lp = stat.get("last_unit_price", None)
        try:
            lp = float(lp) if lp not in (None, "") else None
        except Exception:
            lp = None
        vendors_out.append({
            "email": str(email or ""),
            "name": stat.get("name", email) or str(email or ""),
            "award_count": int(stat.get("award_count", 0) or 0),
            "request_count": int(stat.get("request_count", 0) or 0),
            "preferred": bool(stat.get("preferred", False)),
            "last_unit_price": lp,
            "last_requested_at": str(stat.get("last_requested_at", "") or ""),
            "last_awarded_at": str(stat.get("last_awarded_at", "") or ""),
        })
    vendors_out.sort(
        key=lambda v: (v["preferred"], v["award_count"], v["request_count"], v["last_unit_price"] is not None),
        reverse=True,
    )
    intel["vendors"] = vendors_out
    intel["sample_description"] = str(mrec.get("sample_description", "") or "")
    intel["found"] = bool(vendors_out) or bool(mrec)

    pts = [rec for rec in (mem.get("price_history", []) or [])
           if isinstance(rec, dict) and rec.get("material_key") == key]
    pts.sort(key=lambda r: str(r.get("created_at", "")), reverse=True)
    intel["price_points"] = pts[:max_price_points]

    priced = [v for v in vendors_out if v["last_unit_price"] is not None]
    if priced:
        intel["cheapest"] = min(priced, key=lambda v: v["last_unit_price"])

    def _recency(v):
        return max(v.get("last_awarded_at", ""), v.get("last_requested_at", ""))
    if vendors_out:
        mr = max(vendors_out, key=_recency)
        if _recency(mr):
            intel["most_recent"] = mr

    hints = []
    hint_rx = re.compile(r"lead\s*time|in\s*stock|back\s*order|backorder|weeks?|business\s*days?|\bdays?\b|ships?\b|eta\b", re.I)
    for rec in pts:
        note = str(rec.get("notes", "") or "")
        if note and hint_rx.search(note):
            who = rec.get("vendor_name") or rec.get("vendor_email") or ""
            hints.append(f"{str(rec.get('created_at',''))[:10]} {who}: {note[:140]}".strip())
    intel["lead_time_hints"] = hints[:8]
    return intel


def summarize_sourcing_intel_text(intel, item=None):
    """Human-readable summary for the panel / for copying into a line's Notes."""
    intel = intel or {}
    key = intel.get("key", "")
    lines = []
    desc = ""
    if isinstance(item, dict):
        desc = (item.get("description", "") or item.get("part_number", "") or "").strip()
    if desc:
        lines.append(f"Item: {desc}")
    lines.append(f"Match key: {key or '(none)'}")
    if not intel.get("found"):
        lines.append("")
        lines.append("No prior sourcing history for this item in procurement memory.")
        lines.append("Tip: use 'Suggest Substitutes (AI)' for equivalents, or 'Find Vendors' once you have history.")
        return "\n".join(lines)

    vendors = intel.get("vendors", []) or []
    lines.append("")
    lines.append(f"Vendors who have quoted/supplied this item ({len(vendors)}):")
    for v in vendors[:8]:
        bits = []
        if v.get("preferred"):
            bits.append("PREFERRED")
        if v.get("award_count"):
            bits.append(f"{v['award_count']} award(s)")
        if v.get("request_count"):
            bits.append(f"{v['request_count']} RFQ(s)")
        if v.get("last_unit_price") is not None:
            bits.append(f"last ${v['last_unit_price']:.2f}/unit")
        last = v.get("last_awarded_at") or v.get("last_requested_at") or ""
        if last:
            bits.append(f"last {str(last)[:10]}")
        lines.append(f"  - {v.get('name') or v.get('email')} <{v.get('email')}>: " + ", ".join(bits or ["history"]))

    ch = intel.get("cheapest")
    if ch and ch.get("last_unit_price") is not None:
        lines.append("")
        lines.append(f"Cheapest on record: {ch.get('name') or ch.get('email')} at ${ch['last_unit_price']:.2f}/unit")
    mr = intel.get("most_recent")
    if mr:
        when = mr.get("last_awarded_at") or mr.get("last_requested_at") or ""
        lines.append(f"Most recent source: {mr.get('name') or mr.get('email')} ({str(when)[:10]})")

    pts = intel.get("price_points", []) or []
    if pts:
        lines.append("")
        lines.append("Recent price/award points:")
        for r in pts[:6]:
            up = r.get("unit_price", "")
            up = f"${up}" if up not in (None, "") else "n/a"
            lines.append(f"  - {str(r.get('created_at',''))[:10]} {r.get('vendor_name') or r.get('vendor_email','')} | "
                         f"{r.get('qty','')} {r.get('unit','')} @ {up} | {str(r.get('notes','') or '')[:80]}")

    hints = intel.get("lead_time_hints", []) or []
    if hints:
        lines.append("")
        lines.append("Lead-time / availability notes seen before:")
        for h in hints[:6]:
            lines.append(f"  - {h}")
    return "\n".join(lines)


# ---------------------------------------------------------------------------
# 2) AI substitute / equivalent suggestions (local Ollama; safe-fail to [])
# ---------------------------------------------------------------------------
def parse_substitute_suggestions(obj, max_items=6):
    """Normalize an AI JSON payload into a clean substitute list."""
    if isinstance(obj, str):
        obj = extract_json_object(obj)
    rows = []
    if isinstance(obj, dict):
        rows = obj.get("substitutes") or obj.get("materials") or obj.get("items") or []
    elif isinstance(obj, list):
        rows = obj
    out = []
    for r in rows if isinstance(rows, list) else []:
        if not isinstance(r, dict):
            continue
        desc = str(r.get("description", "") or r.get("substitute", "") or r.get("item", "") or "").strip()
        part = str(r.get("part_number", "") or r.get("part", "") or r.get("catalog", "") or "").strip()
        mfg = str(r.get("manufacturer", "") or r.get("brand", "") or r.get("mfg", "") or "").strip()
        reason = str(r.get("reason", "") or r.get("why", "") or r.get("note", "") or "").strip()
        if not desc and not part:
            continue
        try:
            conf = float(r.get("confidence", 0) or 0)
        except Exception:
            conf = 0.0
        conf = max(0.0, min(1.0, conf))
        out.append({
            "description": desc, "part_number": part, "manufacturer": mfg,
            "reason": reason, "confidence": round(conf, 2),
        })
        if len(out) >= max_items:
            break
    return out


def ask_ollama_suggest_substitutes(item, max_items=4, timeout_seconds=60):
    """Ask the local model for functionally-equivalent substitute items.

    Returns a list of normalized substitute dicts, or [] on any failure / when
    AI is disabled. NEVER raises. Explicitly forbids invented stock/prices."""
    try:
        if not OLLAMA_ENABLED or not isinstance(item, dict):
            return []
        desc = str(item.get("description", "") or "").strip()
        part = str(item.get("part_number", "") or "").strip()
        mfg = str(item.get("manufacturer", "") or "").strip()
        if not desc and not part:
            return []
        try:
            n = max(1, min(8, int(max_items)))
        except Exception:
            n = 4
        prompt = f"""
You are MaINbox Procurement Intelligence for an electrical/construction distributor.
Suggest up to {n} functionally EQUIVALENT substitute items for the line below that are
commonly stocked and would satisfy the same requirement.

Line item:
- Description: {desc or "(none)"}
- Part / catalog #: {part or "(none)"}
- Manufacturer: {mfg or "(none)"}

Rules:
- Only suggest real, generally-available equivalents (alternate manufacturer, cross-reference,
  or a standard commercial equivalent). Prefer same trade size / rating / material.
- Do NOT invent live stock levels, availability, or prices. This is equivalence guidance only.
- If a standard catalog/cross number is well known, include it; otherwise leave part_number "".
- If you are unsure, return fewer items. Quality over quantity.
- Give a short reason for each (why it is an acceptable substitute).
- confidence is 0.0-1.0 (how confident you are it is a valid equivalent).

Return ONLY valid JSON, no markdown:
{{"substitutes": [{{"description": "", "manufacturer": "", "part_number": "", "reason": "", "confidence": 0.0}}]}}
""".strip()
        payload = {
            "model": ai_model_for_task("purchase", RFQ_TEXT_MODEL or OLLAMA_MODEL),
            "prompt": prompt,
            "stream": False,
            "keep_alive": AI_KEEP_ALIVE,
            "options": {"temperature": 0.1, "num_predict": 1200, "num_ctx": 8192, "top_k": 40, "top_p": 0.9},
        }
        data = json.dumps(payload).encode("utf-8")
        with ollama_open(data, task="purchase", timeout=max(int(timeout_seconds), 30)) as response:
            raw = response.read().decode("utf-8")
            result = json.loads(raw)
            obj = extract_json_object(result.get("response") or "")
            return parse_substitute_suggestions(obj, max_items=n)
    except Exception:
        return []


# ---------------------------------------------------------------------------
# 3) Pluggable external stock provider seam (disabled by default).
#    Lets a real distributor/aggregator API drop in later with no UI changes.
# ---------------------------------------------------------------------------
def lookup_external_stock(item, settings, timeout_seconds=20):
    """Return live stock records for an item, or [] when no provider is configured.

    Default provider is 'memory' (returns [] here; the memory view is built
    separately by build_material_sourcing_intel). When the user configures
    'http' + an endpoint, this performs a best-effort GET and maps a generic
    JSON response. ALWAYS safe-fails to []."""
    try:
        settings = settings or {}
        provider = str(settings.get("stock_lookup_provider", "memory") or "memory").strip().lower()
        if provider != "http":
            return []
        endpoint = str(settings.get("stock_http_endpoint", "") or "").strip()
        if not endpoint or not isinstance(item, dict):
            return []
        part = str(item.get("part_number", "") or "").strip()
        desc = str(item.get("description", "") or "").strip()
        q = part or desc
        if not q:
            return []
        sep = "&" if "?" in endpoint else "?"
        url = f"{endpoint}{sep}q={urllib.parse.quote(q)}"
        headers = {"Accept": "application/json"}
        api_key = str(settings.get("stock_http_api_key", "") or "").strip()
        if api_key:
            headers["Authorization"] = f"Bearer {api_key}"
        try:
            to = int(settings.get("stock_http_timeout", timeout_seconds) or timeout_seconds)
        except Exception:
            to = timeout_seconds
        req = urllib.request.Request(url, headers=headers, method="GET")
        with urllib.request.urlopen(req, timeout=max(to, 5)) as response:
            payload = json.loads(response.read().decode("utf-8"))
        return _normalize_external_stock_payload(payload)
    except Exception:
        return []


def _normalize_external_stock_payload(payload):
    """Map a generic provider JSON into a uniform stock record list. Safe-fails to []."""
    try:
        rows = []
        if isinstance(payload, dict):
            rows = payload.get("results") or payload.get("items") or payload.get("stock") or payload.get("data") or []
        elif isinstance(payload, list):
            rows = payload
        out = []
        for r in rows if isinstance(rows, list) else []:
            if not isinstance(r, dict):
                continue
            out.append({
                "vendor": str(r.get("vendor", "") or r.get("supplier", "") or r.get("seller", "") or ""),
                "qty_available": r.get("qty_available", r.get("quantity", r.get("stock", ""))),
                "location": str(r.get("location", "") or r.get("warehouse", "") or ""),
                "unit_price": r.get("unit_price", r.get("price", "")),
                "lead_time": str(r.get("lead_time", "") or r.get("eta", "") or ""),
                "source": str(r.get("source", "") or r.get("distributor", "") or ""),
                "url": str(r.get("url", "") or r.get("link", "") or ""),
            })
        return out[:25]
    except Exception:
        return []


# ============================================================================
# v3.8.18  Reply-needed / action-needed engine
# Turns an unanswered inbound 'Needs Reply' email into a clear, specific
# suggestion of what the user owes (send a quote / process the PO / answer a
# question), with line items + alternates pulled from the body. Pure text->data.
# ============================================================================

_QUOTE_KW = [
    "please quote", "pls quote", "quote", "pricing", "price and availability",
    "p&a", "p & a", "p and a", "need pricing", "can you price", "rfq",
    "request for quote", "get me a price", "what's the price", "whats the price",
    "cost on", "lead time", "availability",
]
_PO_KW = [
    "purchase order", "p.o.", "po number", "po #", "send the po", "send po",
    "release the order", "place the order", "issue a po", "cut a po", "proceed with the order",
]
_QUESTION_KW = [
    "please advise", "let me know", "can you", "could you", "would you", "when can",
    "do you have", "is this available", "are these available", "any update", "status on",
    "status of", "please confirm", "need this by", "need it by", "get back to me",
    "waiting on", "follow up", "following up", "any word", "hear back",
]


def _first_name(sender_name):
    s = re.sub(r"<[^>]*>", "", str(sender_name or "")).strip().strip('"').strip()
    if not s:
        return "them"
    # "Last, First" -> First
    if "," in s and "@" not in s:
        parts = [p.strip() for p in s.split(",")]
        if len(parts) == 2 and parts[1]:
            return parts[1].split()[0]
    if "@" in s and " " not in s:  # bare email
        local = s.split("@")[0]
        local = re.split(r"[._]", local)[0]
        return local.capitalize() if local else "them"
    return s.split()[0]


def classify_reply_request(text):
    """Return a request kind: 'po' | 'quote' | 'question' | 'respond'.

    PO/order-release is checked before quote because quote threads keep the word
    'quote' in the subject even once the customer is placing the order."""
    low = " " + re.sub(r"\s+", " ", str(text or "").lower()) + " "
    if any(k in low for k in _PO_KW):
        return "po"
    if any(k in low for k in _QUOTE_KW):
        return "quote"
    if "?" in str(text or "") or any(k in low for k in _QUESTION_KW):
        return "question"
    return "respond"


_ITEM_LINE_RX = re.compile(
    r"^\s*(?P<qty>\d{1,5}(?:,\d{3})*)\s*(?P<unit>x|ea|pcs?|pieces?|ft|'|\")?\b[\s\-:]*(?P<desc>[A-Za-z0-9][^\n]{1,60})\s*$",
)
_ALT_RX = re.compile(
    r"((?:[0-9][A-Za-z0-9./\-]*)(?:(?:,|/|\s+and\s+|\s+or\s+|\s+)[0-9][A-Za-z0-9./\-]*)*)"
    r"\s+(?:are|is)\s+(?:also\s+)?(?:ok|okay|acceptable|fine|good)\b",
    re.I,
)


def extract_request_items(body, max_items=4):
    """Pull quantity+description line items and any 'also OK' alternates.

    Lines are handled one at a time so an 'X and Y are also ok' alternates line is
    never mistaken for a quantity line item."""
    items = []
    alternates = []
    for line in str(body or "").splitlines():
        am = _ALT_RX.search(line)
        if am:
            alt = re.sub(r"\s+", " ", am.group(1)).strip(" .-")
            if alt and len(alt) <= 60:
                alternates.append(alt)
            continue
        m = _ITEM_LINE_RX.match(line)
        if not m:
            continue
        qty = m.group("qty")
        unit = (m.group("unit") or "").strip()
        desc = re.sub(r"\s+", " ", m.group("desc")).strip(" .-")
        if not desc or len(desc) < 2:
            continue
        if not re.search(r"[A-Za-z]", desc):
            # bare part number / numeric-only line (e.g. "221-420") is not a qty line
            continue
        if unit in ("", "x"):
            label = f"{qty}x {desc}"
        else:
            label = f"{qty} {unit} {desc}"
        items.append(label)
        if len(items) >= max_items:
            break
    return items, alternates


def summarize_reply_request(subject, body, sender_name):
    """Build a clear, specific 'what you owe' suggestion for an unanswered inbound.

    Returns {kind, action, detail, suggestion}."""
    subject = str(subject or "")
    body = str(body or "")
    name = _first_name(sender_name)
    combined = f"{subject}\n{body}"
    kind = classify_reply_request(combined)
    action = {
        "quote": "send a quote",
        "po": "process/confirm the PO",
        "question": "answer their question",
        "respond": "reply",
    }[kind]

    detail = ""
    if kind == "quote":
        items, alternates = extract_request_items(body)
        if items:
            detail = ", ".join(items[:4])
            if alternates:
                detail += f" (alternates OK: {', '.join(alternates[:2])})"
    elif kind == "question":
        # first question sentence, else first meaningful line
        q = ""
        for sent in re.split(r"(?<=[.?!])\s+", body):
            if "?" in sent:
                q = sent.strip()
                break
        if not q:
            for line in body.splitlines():
                if line.strip():
                    q = line.strip()
                    break
        detail = re.sub(r"\s+", " ", q)[:110]
    elif kind == "po":
        m = re.search(r"\b(?:po|p\.o\.|purchase order)\s*#?\s*([A-Za-z0-9\-]{3,})", combined, re.I)
        if m:
            detail = f"PO {m.group(1)}"
    else:
        for line in body.splitlines():
            if line.strip():
                detail = re.sub(r"\s+", " ", line.strip())[:110]
                break

    suggestion = f"Reply to {name}: {action}"
    if detail:
        suggestion += f" - {detail}"
    return {"kind": kind, "action": action, "detail": detail, "suggestion": suggestion}


def text_mentions_po_or_order(text):
    text = (text or "").lower()
    phrases = [
        "purchase order", "po", "p.o.", "issuing an order", "issue an order",
        "send over the order", "sending the order", "place the order", "placing the order",
        "we will proceed", "approved", "go ahead", "move forward with the order",
        "release the order", "will send the po", "will send po", "send the po"
    ]
    padded = f" {text} "
    for phrase in phrases:
        if phrase in padded:
            return True
    return False


def strip_ai_signature(text):
    if not text:
        return text

    lines = text.strip().splitlines()
    stop_phrases = [
        "best regards", "regards", "sincerely", "thank you", "thanks", "thanks,",
        "best", "best,", "warm regards", "kind regards"
    ]

    cleaned = []
    for line in lines:
        check = line.strip().lower().rstrip(",")
        if check in stop_phrases:
            break
        cleaned.append(line)

    return "\n".join(cleaned).strip()


