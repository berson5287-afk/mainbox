        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

    def _bridge_active_followups(self):
        """Active (not completed / not cancelled) follow-ups, mapped to the
        bridge item schema. Vendor is resolved from the email sender when the
        record is still available; extra keys pass through for Brain."""
        items = []
        for it in (self.followups or []):
            if not isinstance(it, dict):
                continue
            if it.get("completed") or it.get("cancelled"):
                continue
            entry_id = it.get("entry_id", "")
            email = self.get_email_by_id(entry_id) if entry_id else None
            vendor = ""
            if isinstance(email, dict):
                vendor = email.get("sender", "") or email.get("sender_email", "")
            due_at = it.get("due_at", "")
            due_ts = None
            if due_at:
                try:
                    due_ts = datetime.fromisoformat(due_at).timestamp()
                except Exception:
                    due_ts = None
            items.append({
                "id": entry_id or it.get("created_at", ""),
                "kind": "followup",
                "vendor": vendor,
                "subject": it.get("subject", ""),
                "due": due_at,
                "due_ts": due_ts,
                "status": "open",
                "note": it.get("message", ""),
                "category": it.get("category", ""),
                "group_id": it.get("group_id", ""),
            })
        return items

    def _bridge_followups_signature(self, items):
        """Cheap change key so the snapshot is only re-published when it actually
        changes (avoids a disk write on every 4s tick)."""
        return tuple(sorted(
            (i.get("id", ""), i.get("due", ""), i.get("status", ""),
             i.get("subject", ""), i.get("vendor", ""))
            for i in items
        ))

    def _bridge_publish_followups(self, force=False):
        """Publish the active follow-up snapshot to Brain. Skips the write when
        nothing changed since the last publish unless force=True."""
        if not getattr(self, "bridge", None):
            return
        try:
            items = self._bridge_active_followups()
            sig = self._bridge_followups_signature(items)
            if not force and sig == getattr(self, "_bridge_followups_sig", None):
                return
            self.bridge.publish_followups(items)
            self._bridge_followups_sig = sig
        except Exception as _bridge_err:
            try:
                self.log(f"Bridge: publish error ({_bridge_err})")
            except Exception:
                pass

    def _bridge_tick(self):
        # Heartbeat, answer Brain's commands, and refresh the follow-up snapshot
        # when it has changed. Reschedules every 4s. Guarded so bridge or Tcl
        # errors never reach the UI; when the window is destroyed the pending
        # after() is cancelled and this loop ends on its own.
        if not getattr(self, "bridge", None):
            return
        try:
            self.bridge.heartbeat(app_version=mainbox_version_number())
            self.bridge.poll_commands(handlers={
                # Brain explicitly asked for the latest -> force a publish.
                "refresh_followups": lambda args: self._bridge_publish_followups(force=True),
            })
            # Push the snapshot automatically whenever it has changed.
            self._bridge_publish_followups()
        except Exception as _bridge_err:
            try:
                self.log(f"Bridge: tick error ({_bridge_err})")
            except Exception:
                pass
        finally:
            try:
                self.root.after(4000, self._bridge_tick)
            except Exception:
                pass  # root destroyed during shutdown; stop quietly

    # ── AI Assistant adapters ──────────────────────────────────────────────────
    # These translate an engine decision record into primitives MaINbox already
    # has. The high-stakes "deploy a draft" path is only ever reached through a
    # user-initiated Approve in the log (never on the periodic timer), so it does
    # not reintroduce the v41 follow-up-timer freeze.
    def _assistant_theme(self):
        return {"bg": _BG, "bg2": _BG2, "bg3": _BG3, "fg": _FG,
                "fg_dim": _FG_DIM, "accent": _ACCENT}

    def _open_assistant_log(self):
        if not getattr(self, "assistant", None):
            try:
                msg = ("The AI Assistant engine isn't loaded.\n\n"
                       "Keep 'mainbox_assistant.py' in the same folder as this app, then restart.")
                if _ASSISTANT_IMPORT_ERROR:
                    msg += f"\n\nWhy it failed to load:\n{_ASSISTANT_IMPORT_ERROR}"
                messagebox.showinfo("AI Assistant", msg)
            except Exception:
                pass
            return
        try:
            open_assistant_log_window(self.root, self.assistant, theme=self._assistant_theme())
        except Exception:
            pass

    def _assistant_apply(self, rec):
        """Execute an action the assistant decided to AUTO/REVIEW (or that the
        user approved). Returns True on success."""
        try:
            p = rec.get("payload", {}) or {}
            email = self.get_email_by_id(p.get("entry_id", "")) or p.get("email")
            after = rec.get("after", {}) or {}
            kind = rec.get("kind", "")
            if kind in ("Category", "Status", "Urgency"):
                if not email:
                    return False
                # v4.1.16: an assistant action the user approved (or AUTO applied) can
                # reopen a closed email; record the explicit reopen so the closed guard
                # cannot re-close it at the next startup.
                _was_closed = self._email_was_closed_before_edit(email)
                if "category" in after:
                    email["category"] = after["category"]
                if "urgency" in after:
                    email["urgency"] = after["urgency"]
                if "status" in after:
                    email["status"] = after["status"]
                if _was_closed and not self.workflow_record_is_closed(email):
                    self._record_explicit_reopen_for_email(email, save=True)
                self.save_record(email)
                self.flush_status_data()
                self.render_email_rows()
            elif kind == "Group":
                if not email:
                    return False
                # Rule-based groupings are logged AFTER the email is already in the
                # group (visibility only) -- don't redundantly re-apply / re-render.
                if p.get("already_grouped"):
                    return True
                gid = p.get("group_id", "")
                if gid and self.get_group_by_id(gid):
                    self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = gid
                    self.mark_group_has_new(gid)
                    self.save_groups()
                    self.render_group_rows()
                else:
                    return False
            elif kind in ("Follow-up", "Reply draft"):
                row = p.get("due_row")
                if row:
                    # User-approved deployment of a due follow-up draft.
                    self.deploy_due_followup_row(row)
                elif p.get("schedule") and email:
                    # Skip if we're re-entering from inside schedule_ai_followup_if_needed
                    # (the caller's fall-through schedules it); the Approve button has
                    # the guard off, so it schedules here.
                    if not getattr(self, "_assistant_suppress_schedule", False):
                        self.schedule_ai_followup_if_needed(
                            email, triage_result=p.get("triage"), quick_result=p.get("quick")
                        )
                else:
                    return False
            elif kind == "Cleanup":
                # Quote thread is DONE. Two outcomes, two actions:
                #   * Won order / PO placed -> KEEP it: mark the whole thread
                #     Completed and archive the group (emails stay linked, reversible
                #     via unarchive). A placed order may need referencing later, so it
                #     is never deleted.
                #   * Dead / lost (cancellation, no-quote, customer declined / walked
                #     away) -> remove the whole thread from the grid via the app-only
                #     delete: snapshot to Deleted History, mark app_deleted (sync/scan
                #     honor it so it stays gone), cancel follow-ups. Outlook is NEVER
                #     touched and it is restorable from Deleted History.
                # v3.9.77: both paths now act on the ENTIRE thread, not just current
                # group members -- an untriaged/ungrouped sibling ("New", still in the
                # Sales/drip queue) used to be skipped, so only part of a thread got
                # handled (2 of 3).
                # Quote-Completion auto-cleanup logs its archive AFTER performing it
                # (visibility + Undo only, like a rule-based grouping) -- so never
                # re-archive/re-delete a thread from the log for one of those rows.
                if p.get("already_archived"):
                    return True
                eid = p.get("entry_id", "")
                gid = p.get("group_id", "") or self.get_group_id_for_email(eid)
                _closed_kind = p.get("closed_kind", "")
                _won = _closed_kind in ("won", "llm_won")
                _why = "Order placed / quote won" if _won else "Request cancelled / no-quote / declined"
                emails = self._collect_thread_emails(eid, gid)
                if not emails:
                    em = self.get_email_by_id(eid)
                    emails = [em] if em else []
                if _won:
                    for em in emails:
                        try:
                            self._cancel_active_followups_for_email(em, reason=_why)
                        except Exception:
                            pass
                        try:
                            em["status"] = "Completed"
                            self.save_record(em)
                        except Exception:
                            pass
                    try:
                        self.flush_status_data()
                    except Exception:
                        pass
                    if gid:
                        self._archive_group_by_id(gid)
                    else:
                        self.render_email_rows()
                else:
                    # Dead/lost: delete the whole thread to Deleted History (follow-ups
                    # cancelled). perform_app_delete handles the snapshot, app_deleted
                    # flags, index rebuild, save, and re-render.
                    self.perform_app_delete(emails, "cancel")
                    # If the group is now empty (its only thread was this one), archive
                    # the shell so it does not linger; a multi-thread project group with
                    # other live threads is left active.
                    if gid and self.get_group_by_id(gid) and not self.get_emails_for_group(gid):
                        self._archive_group_by_id(gid)
                return True
            # Mirror into the existing AI Triage Center history / learning trail.
            if email:
                try:
                    self.record_ai_triage_history(
                        email, before=rec.get("before", {}), after=after,
                        reason=rec.get("reason", ""), source="Assistant"
                    )
                except Exception:
                    pass
            return True
        except Exception:
            return False

    def _assistant_ask(self, rec):
        """Surface an uncertain item. In silent mode, bring the log up once so the
        user still sees it. Safe to call from the background triage thread: all Tk
        work is marshalled to the main thread."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or assistant.config.show_log:
                return

            def _open_if_needed():
                existing = getattr(assistant, "_log_win", None)
                try:
                    if existing and existing.winfo_exists():
                        return  # already visible; the new pending row will just appear
                except Exception:
                    pass
                open_assistant_log_window(self.root, assistant, theme=self._assistant_theme())

            self.root.after(0, _open_if_needed)
        except Exception:
            pass

    def _assistant_on_activity(self, rec):
        """Fires for every NEW assistant row. When 'Show this log' is CHECKED, pop
        the window for any new activity. (The UNCHECKED case -- open only when
        something needs attention -- is handled by _assistant_ask above, so the two
        are complementary and never double-open.) Thread-safe: opens on the main
        thread."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or not assistant.config.show_log:
                return

            def _open_if_needed():
                existing = getattr(assistant, "_log_win", None)
                try:
                    if existing and existing.winfo_exists():
                        return  # already visible; the new row appears via refresh
                except Exception:
                    pass
                open_assistant_log_window(self.root, assistant, theme=self._assistant_theme())

            self.root.after(0, _open_if_needed)
        except Exception:
            pass

    def _assistant_undo(self, rec):
        """Restore the pre-action category/urgency/status/group."""
        try:
            p = rec.get("payload", {}) or {}
            # Quote-Completion auto-cleanup archives a whole group (no single email to
            # restore), so its Undo un-archives that group and brings it back.
            if p.get("already_archived") and p.get("group_id"):
                g = self.get_group_by_id(p.get("group_id"))
                if g:
                    g["archived"] = False
                    g.pop("archived_at", None)
                    self.save_groups()
                    self.render_group_rows()
                    self.render_email_rows()
                return True
            email = self.get_email_by_id(p.get("entry_id", ""))
            if not email:
                return False
            before = rec.get("before", {}) or {}
            for f in ("category", "urgency", "status"):
                if f in before:
                    email[f] = before[f]
            if "group" in before:
                eid = email.get("entry_id", "")
                if before["group"]:
                    self.groups_data.setdefault("memberships", {})[eid] = before["group"]
                else:
                    self.groups_data.get("memberships", {}).pop(eid, None)
                self.save_groups()
                self.render_group_rows()
            self.save_record(email)
            self.flush_status_data()
            self.render_email_rows()
            return True
        except Exception:
            return False

    def _assistant_log_autogroup(self, email, group_id, reason="", rule=""):
        """Surface a RULE-based grouping (thread / business-key / learned) in the
        assistant log so the user can SEE it and re-group if it's wrong. These
        paths short-circuit before the AI-suggestion path, so without this they
        were invisible -- the user couldn't correct them. The email is already in
        the group, so this only records/visualizes it (payload already_grouped
        stops _assistant_apply from redundantly re-applying). dedup_key collapses
        repeats from re-scans onto one row."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or not assistant.config.enabled:
                return
            group = self.get_group_by_id(group_id)
            if not group:
                return
            eid = email.get("entry_id", "")
            assistant.handle(
                kind="Group", stakes=LOW, confidence=0.99,
                subject=email.get("subject", ""), sender=email.get("sender", ""),
                summary=f"Grouped into '{group.get('name','')}'",
                before={"group": ""}, after={"group": group.get("name", "")},
                reason=(reason or f"Auto-grouped by {rule or 'rule'} match."),
                payload={"entry_id": eid, "group_id": group_id, "already_grouped": True,
                         "group_rule": rule},
                dedup_key=f"group:{eid}",
            )
        except Exception:
            pass

    def _email_request_is_closed(self, email):
        """Heuristic: is this quote/request DONE, so its group can be archived?
        Returns (closed, phrase, kind) where kind is one of:
          - "cancelled": customer cancelled/disregarded ("no longer needed")
          - "no_quote" : a no-quote / no-bid decision ("we won't quote", "no bid")
          - "won"      : order placed / PO provided (via detect_won_order, whose
                         strong signals override a mis-tagged email_type)
        Kept tight to avoid false positives that would wrongly suppress a real
        follow-up. Only the top of the body (before quoted history) is scanned."""
        if not email:
            return False, "", ""
        try:
            subj = str(email.get("subject", "") or "")
            body = str(email.get("body", "") or "")
            email_type = str(email.get("email_type", "") or "").upper()
            head = re.split(r"\n\s*(?:from:|sent:|on .+ wrote:|-{3,}\s*original message)",
                            body, maxsplit=1, flags=re.I)[0]
            text = f"{subj}\n{head}".lower()
            cancelled_pats = [
                r"please\s+disregard",
                r"disregard\s+(?:this|that|these|the\s+(?:below|above|previous|prior|last))",
                r"no\s+longer\s+(?:requested|required|needed|necessary|valid|interested|moving\s+forward)",
                r"please\s+(?:cancel|void)\b",
                r"\bcancel\s+(?:this|that|the|my|our)\s+(?:order|quote|request|rfq|po|inquiry|job)",
                r"\bnever\s*mind\b",
                r"\bnevermind\b",
                r"\bwithdraw\s+(?:this|the|our|my)\b",
                r"please\s+ignore\s+(?:this|that|the|my|our|previous)",
                r"\bvoid\s+(?:this|the|our|my)\b",
                r"\bscratch\s+that\b",
            ]
            no_quote_pats = [
                r"\bno\s+quote\b",
                r"\bno[\s-]?bid\b",
                r"\b(?:we|i)(?:'?re|\s+are|\s+am)?\s+(?:not|won'?t|will\s+not)\s+(?:going\s+to\s+)?(?:quote|bid|quoting|bidding)\b",
                r"\b(?:not|won'?t|will\s+not)\s+(?:be\s+)?(?:quoting|bidding|quote|bid)\b",
                r"\b(?:we|i)(?:'?ll|\s+will)?\s+pass\s+on\s+(?:this|that|it)\b",
                r"\bdeclin(?:e|ing)\s+to\s+(?:quote|bid)\b",
            ]
            for pat in cancelled_pats:
                m = re.search(pat, text)
                if m:
                    return True, m.group(0).strip(), "cancelled"
            for pat in no_quote_pats:
                m = re.search(pat, text)
                if m:
                    return True, m.group(0).strip(), "no_quote"
            # v3.9.103: an email that is ALSO actively asking us for something -- a price,
            # availability, a lead time, a status/update, a confirmation, or any direct request --
            # is a LIVE inquiry, NOT a closed deal. The two fuzzy heuristics below were auto-
            # completing such threads: a customer politely following up ("please send pricing,
            # thanks for checking") tripped detect_lost_deal's "thanks for checking/your time", and
            # a future "looking to place the order soon" tripped detect_won_order's "place the
            # order". Suppress ONLY those inferred closes when the customer is clearly still engaged.
            # The EXPLICIT closes above (disregard/cancel/void, no-bid) are untouched, and a real
            # walk-away ("went with another") or real order ("here is the PO, go ahead") carries no
            # active-request language, so it still closes.
            active_inquiry = bool(re.search(
                r"\b(?:"
                r"any\s+update|any\s+word|status\s+(?:on|of|update|please)|update\s+(?:on|please|when|for)|"
                r"following\s+up|follow(?:ing)?\s*up|checking\s+in|where\s+(?:do\s+)?we\s+stand|"
                r"please\s+(?:advise|send|quote|confirm|provide|price)|please\s+let\s+(?:me|us)\s+know|"
                r"can\s+(?:you|we)\s+(?:quote|confirm|provide|send|get|check|advise|help)|"
                r"could\s+(?:you|we)\s+(?:quote|confirm|provide|send|please|check)|"
                r"would\s+you\s+(?:be\s+able|mind|please)|"
                r"do\s+you\s+have|are\s+(?:these|they|you)\s+(?:available|able)|"
                r"is\s+(?:this|it|that)\s+(?:still\s+)?available|still\s+available|"
                r"lead\s*time|when\s+(?:can|will|do|would|should)|how\s+(?:soon|long|much)\b|"
                r"need\s+(?:a\s+quote|pricing|price|availability|the\s+price|this|these|it)|"
                r"price\s+and\s+availability|pricing\s+and\s+availability|p\s*&\s*a\b|p\s+and\s+a\b|"
                r"send\s+(?:me|us|over)\s+(?:pricing|a\s+quote|the\s+price|price)|"
                r"still\s+(?:need|needed|looking|interested|waiting|require)|"
                r"waiting\s+(?:on|for)\s+(?:your|the|a|this)\b|"
                r"get\s+(?:me|us)\s+(?:a\s+)?(?:quote|price|pricing)"
                r")\b", text))
            # Won order -- shared detector; its strong signals (release/deliver, PO
            # provided) are type-agnostic, so a customer mis-tagged 'V' still closes.
            won, won_phrase = detect_won_order(text, email_type)
            if won and not active_inquiry:
                return True, won_phrase, "won"
            # Customer declined / walked away (lost deal). High-confidence walk-aways
            # archive like a cancellation; soft brush-offs are flagged for review only.
            lost, lost_phrase, lost_level = detect_lost_deal(text)
            if lost and not active_inquiry:
                return True, lost_phrase, ("declined" if lost_level == "high" else "declined_soft")
        except Exception:
            pass
        return False, "", ""

    def _assistant_propose_cleanup(self, email, reason="", kind="cancelled"):
        """When a quote/request is DONE -- a won order/PO, a cancellation, or a
        customer declining -- either auto-apply (if Auto-Archive is ON) or stage a
        'Cleanup' for the user's one-click Approve. Acts on the WHOLE thread, not
        just current group members. Outcome decides the action:
          * won/llm_won -> KEEP: mark the thread Completed and archive the group
            (emails stay linked, reversible via unarchive -- a placed order may
            need referencing).
          * cancelled/no_quote/declined/declined_soft/llm_lost -> DELETE the whole
            thread to Deleted History (app-only: Outlook untouched, restorable from
            Deleted History; follow-ups cancelled).

        `kind`: 'won' | 'cancelled' | 'no_quote' | 'declined' | 'declined_soft' |
        'llm_won' | 'llm_lost'. Soft ('declined_soft') and LLM-detected hits are
        ALWAYS held for review (never auto-applied), since they are heuristic --
        only the confident pattern hits ride the Auto-Archive setting."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or not assistant.config.enabled:
                return
            tags = {
                "won": "order placed", "llm_won": "order placed (review)",
                "cancelled": "request cancelled", "no_quote": "no quote / no bid",
                "declined": "customer declined", "declined_soft": "customer may have declined (review)",
                "llm_lost": "customer declined (review)",
            }
            tag = tags.get(kind, "request closed")
            won = kind in ("won", "llm_won")
            # heuristic hits are surfaced but never silently auto-archived
            force_review = kind in ("declined_soft", "llm_won", "llm_lost")
            auto = bool(getattr(assistant.config, "autoarchive_enabled", False)) and not force_review
            eid = email.get("entry_id", "")
            gid = self.get_group_id_for_email(eid)
            group = self.get_group_by_id(gid) if gid else None
            # v3.9.77: count + wording reflect the WHOLE thread (Cleanup now acts on
            # every loaded email in the thread, including an ungrouped/"New" sibling)
            # and the actual action -- a won order is KEPT (archive + mark complete),
            # while a dead/lost thread is DELETED to Deleted History (restorable,
            # Outlook untouched).
            _thread = self._collect_thread_emails(eid, gid or "")
            n = len(_thread) if _thread else (1 if self.get_email_by_id(eid) else 0)
            gname = group.get("name", "") if group else ""
            if won:
                if group:
                    verb = "Auto-archiving" if auto else "Archive"
                    summary = f"{verb} '{gname}' ({n} email(s), kept) \u2014 {tag}"
                    after = {"action": f"archive group; mark complete; keep {n} email(s) linked"}
                else:
                    summary = f"Mark complete ({n} email(s)) \u2014 {tag}"
                    after = {"action": "mark complete; stop follow-up"}
            else:
                verb = "Auto-deleting" if auto else "Delete"
                where = f" from '{gname}'" if group else ""
                summary = f"{verb} {n} thread email(s){where} to Deleted History \u2014 {tag}"
                after = {"action": f"delete {n} thread email(s) to Deleted History (restorable); cancel follow-ups"}
            if won:
                rsn = (f"Order placed / quote won (\u201c{reason}\u201d) \u2014 the quote is complete."
                       if reason else "Order placed / quote won \u2014 the quote is complete.")
            elif kind in ("declined", "declined_soft", "llm_lost"):
                rsn = (f"Customer declined / walked away (\u201c{reason}\u201d) \u2014 quote lost."
                       if reason else "Customer declined / walked away \u2014 quote lost.")
            else:
                rsn = (f"Request is dead (\u201c{reason}\u201d)." if reason
                       else "Request is cancelled.")
            assistant.handle(
                kind="Cleanup", stakes=HIGH, confidence=0.9,
                subject=email.get("subject", ""), sender=email.get("sender", ""),
                summary=summary, before={}, after=after, reason=rsn,
                payload={"entry_id": eid, "group_id": gid or "", "closed_kind": kind},
                dedup_key=f"cleanup:{eid}",
                hold_for_user=not auto, force_auto=auto,
            )
        except Exception:
            pass

    def _archive_group_by_id(self, group_id):
        """Archive a group by id (same effect as the Archive Group button, but with
        no tree selection needed). Emails stay in MaINbox; the group moves to
        archived. Returns True if it archived, False if already archived/missing."""
        try:
            group = self.get_group_by_id(group_id)
            if not group or group.get("archived"):
                return False
            group["archived"] = True
            group["archived_at"] = datetime.now().isoformat()
            if getattr(self, "active_group_filter", "all") == group_id:
                self.active_group_filter = "all"
            self.save_groups()
            self.render_group_rows()
            self.render_email_rows()
            return True
        except Exception:
            return False

    def _create_quote_completion_followup(self, group_id, anchor_email):
        """Drop ONE follow-up on the MANUAL lane (self.followups) for a finished
        quote group, so the pending PO/decision still gets chased after the group
        is archived. The manual lane is used on purpose: scenario reminders are
        auto-cancelled once their email is Completed (see get_followup_queue_items),
        but manual follow-ups survive a Completed/archived thread and still fire.
        Due time is settings-driven (default: +1 day at 07:00 -- the next morning).
        No-op if the group already has an active manual follow-up. Returns True if a
        follow-up was created."""
        try:
            if not anchor_email:
                return False
            s = getattr(self, "settings", {}) or {}
            days = int(s.get("quote_completion_followup_days", 1) or 0)
            hour = int(s.get("quote_completion_followup_hour", 7) or 0)
            minute = int(s.get("quote_completion_followup_minute", 0) or 0)
            due_at = (datetime.now() + timedelta(days=max(0, days))).replace(
                hour=max(0, min(23, hour)), minute=max(0, min(59, minute)),
                second=0, microsecond=0)
            # Don't stack a second reminder if this group already has an active one.
            for it in self.followups:
                if it.get("completed") or it.get("cancelled"):
                    continue
                if group_id and it.get("group_id") == group_id:
                    return False
            item = {
                "entry_id": anchor_email.get("entry_id", ""),
                "store_id": anchor_email.get("store_id", ""),
                "conversation_id": anchor_email.get("conversation_id", ""),
                "group_id": group_id,
                "subject": anchor_email.get("subject", ""),
                "source": anchor_email.get("source", ""),
                "category": anchor_email.get("category", "General"),
                "due_at": due_at.isoformat(), "message": "", "use_ai": True,
                "note": "Auto follow-up after quote completion",
                "source_reason": "quote_completion_autocleanup",
                "completed": False, "cancelled": False,
                "created_at": datetime.now().isoformat(),
            }
            self.followups.append(item)
            self._followup_dedup_needed = True
            try:
                anchor_email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
            except Exception:
                pass
            self.save_followups()
            return True
        except Exception:
            return False

    def _run_quote_completion_autocleanup(self):
        """Quote Completion auto-cleanup (opt-in; off by default). For each ACTIVE
        (non-archived) group where every email is closed (Completed/Low/Junk) AND at
        least one is genuinely Completed -- i.e. the quote is finished, not just a
        buried junk pile -- archive the group and schedule the chase follow-up.
        Returns the number of groups archived. Main-thread only (archives + renders).

        Re-fire safety: an archived group is skipped here, and reactivation only
        un-archives on a NEW inbound (which is not Completed), so the group can't
        immediately re-qualify; the follow-up dedup blocks a duplicate reminder."""
        archived = 0
        try:
            if not bool(getattr(self, "settings", {}).get("quote_completion_autocleanup_enabled", False)):
                return 0
            made_followup = False
            for _g in list(self.groups_data.get("groups", []) or []):
                if not isinstance(_g, dict) or _g.get("archived"):
                    continue
                _gid = _g.get("id", "")
                if not _gid:
                    continue
                _ge = [e for e in self.get_emails_for_group(_gid) if e]
                if not _ge:
                    continue
                if all(self.email_is_completed(e) for e in _ge) and any(e.get("status") == "Completed" for e in _ge):
                    _anchor = max(_ge, key=lambda e: e.get("received_timestamp", 0))
                    _made_fu = self._create_quote_completion_followup(_gid, _anchor)
                    if _made_fu:
                        made_followup = True
                    if self._archive_group_by_id(_gid):
                        archived += 1
                        # Surface this auto-cleanup in the assistant activity log so the
                        # user is AWARE it happened and can Undo (un-archive) it if it was
                        # wrong -- matching the visible one-click Cleanup on the detected-
                        # close path. Logged as an already-done action (no re-archiving).
                        self._assistant_log_quote_completion(_g, _anchor, len(_ge), _made_fu)
            if made_followup:
                try:
                    self.render_followup_preview_queue()
                except Exception:
                    pass
        except Exception:
            pass
        return archived

    def _assistant_log_quote_completion(self, group, anchor_email, email_count, followup_made=False):
        """Record a Quote-Completion auto-cleanup (group archived + optional chase
        follow-up) in the assistant activity log so it is VISIBLE and reversible --
        exactly like the detected-close Cleanup, so the user is aware and can Undo
        it. The archive has ALREADY happened, so this is logged as a done action:
        payload already_archived stops _assistant_apply from re-archiving, and the
        log's Undo un-archives via _assistant_undo. dedup_key collapses repeat scans
        of the same group onto one row. No-op if the assistant is off/absent."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or not assistant.config.enabled:
                return
            if not isinstance(group, dict):
                return
            gid = group.get("id", "")
            if not gid:
                return
            gname = group.get("name", "")
            anchor = anchor_email or {}
            _n = int(email_count or 0)
            _fu = " + scheduled a chase follow-up" if followup_made else ""
            assistant.handle(
                kind="Cleanup", stakes=HIGH, confidence=0.9,
                subject=anchor.get("subject", ""), sender=anchor.get("sender", ""),
                summary=f"Auto-archived '{gname}' ({_n} email(s), kept){_fu} \u2014 quote completed",
                before={}, after={"action": f"archive group; keep {_n} email(s) linked{_fu}"},
                reason=("Quote Completion auto-cleanup: every email in this group is closed "
                        "and at least one is Completed, so the finished quote group was "
                        "archived (emails kept and hidden; Undo to bring it back)."),
                payload={"entry_id": anchor.get("entry_id", ""), "group_id": gid,
                         "already_archived": True},
                dedup_key=f"qccleanup:{gid}",
                force_auto=True,
            )
        except Exception:
            pass

    def _assistant_correction_options(self, rec):
        """Build the dropdown choices shown when the user clicks 'Correct…' on an
        assistant log row. Returns {field,title,prompt,choices,current} or None."""
        try:
            kind = (rec or {}).get("kind", "")
            p = rec.get("payload", {}) or {}
            eid = p.get("entry_id", "")
            if kind in ("Follow-up", "Reply draft"):
                return {
                    "field": "action",
                    "title": "Correct follow-up",
                    "prompt": "What should happen with this follow-up?",
                    "choices": [
                        ("keep",   "Keep it (approve the reminder)"),
                        ("cancel", "Cancel this follow-up"),
                        ("never",  "Never follow up on this email/thread"),
                    ],
                    "current": "keep",
                }
            if kind == "Group":
                active = [g for g in self.groups_data.get("groups", []) if not g.get("archived")]
                cur = self.get_group_id_for_email(eid) or p.get("group_id", "")
                choices = [("", "— Ungroup (remove from group) —")]
                choices += [(g.get("id", ""), g.get("name", "(unnamed)")) for g in active]
                return {
                    "field": "group",
                    "title": "Move to the right group",
                    "prompt": "Which group does this email belong in?",
                    "choices": choices,
                    "current": cur,
                }
            email = self.get_email_by_id(eid) or {}
            if kind == "Category":
                return {"field": "category", "title": "Correct category",
                        "prompt": "Pick the correct category:",
                        "choices": [(c, c) for c in CATEGORIES],
                        "current": email.get("category", "")}
            if kind == "Status":
                return {"field": "status", "title": "Correct status",
                        "prompt": "Pick the correct status:",
                        "choices": [(s, s) for s in STATUSES],
                        "current": email.get("status", "")}
            if kind == "Urgency":
                return {"field": "urgency", "title": "Correct urgency",
                        "prompt": "Pick the correct urgency:",
                        "choices": [(u, u) for u in URGENCY_LEVELS],
                        "current": email.get("urgency", "")}
            return None
        except Exception:
            return None

    def _assistant_apply_correction(self, rec, field, value, display=""):
        """Apply a dropdown correction chosen in the assistant log AND teach
        MaINbox so it groups / follows up better next time. Returns True on
        success. Called once per selected row by the log window (so the two-step
        bulk flow just calls this repeatedly with the same chosen value)."""
        try:
            p = rec.get("payload", {}) or {}
            eid = p.get("entry_id", "")
            email = self.get_email_by_id(eid) or p.get("email")
            kind = rec.get("kind", "")

            # ---- Follow-up / Reply draft: keep / cancel / never ----
            if kind in ("Follow-up", "Reply draft") and field == "action":
                if value == "keep":
                    # User approval overrides the confidence gate: schedule directly.
                    if email:
                        self.schedule_ai_followup_if_needed(
                            email, triage_result=p.get("triage"),
                            quick_result=p.get("quick"), force=True)
                    # Flip the row to handled without re-running the gate.
                    self._assistant_suppress_schedule = True
                    try:
                        if rec.get("state") == "pending":
                            self.assistant.approve(rec.get("id", ""))
                    except Exception:
                        pass
                    finally:
                        self._assistant_suppress_schedule = False
                    return True
                if value in ("cancel", "never"):
                    if email:
                        self._cancel_active_followups_for_email(
                            email,
                            reason=("User: never follow up on this thread" if value == "never"
                                    else "User cancelled from assistant log"))
                        if value == "never" and eid:
                            existing = self.status_data.get(eid, {})
                            existing["prevent_future_followups"] = True
                            self.status_data[eid] = existing
                            try:
                                self.flush_status_data()
                            except Exception:
                                pass
                    try:
                        self.assistant.mark_undone(rec.get("id", ""))
                    except Exception:
                        pass
                    return True
                return False

            # ---- Group: move to a different group (or ungroup) + learn ----
            if kind == "Group" and field == "group":
                if not email:
                    return False
                prev_gid = self.get_group_id_for_email(eid) or p.get("group_id", "")
                if value == prev_gid:
                    return True  # nothing to change
                mems = self.groups_data.setdefault("memberships", {})
                if value:
                    if not self.get_group_by_id(value):
                        return False
                    mems[eid] = value
                    self.mark_group_has_new(value)
                else:
                    mems.pop(eid, None)
                self.save_groups()
                try:
                    self.learn_group_from_user_move(email, value, previous_group_id=prev_gid)
                except Exception:
                    pass
                p["group_id"] = value  # keep the row payload consistent for any re-apply
                gname = (self.get_group_by_id(value) or {}).get("name", "") if value else ""
                self.render_group_rows()
                self.render_email_rows()
                try:
                    self.assistant.mark_corrected(rec.get("id", ""),
                                                  {"group": gname or "(ungrouped)"})
                except Exception:
                    pass
                return True

            # ---- Category / Status / Urgency ----
            if kind in ("Category", "Status", "Urgency") and field in ("category", "status", "urgency"):
                if not email:
                    return False
                email[field] = value
                self.save_record(email)
                self.flush_status_data()
                self.render_email_rows()
                try:
                    self.assistant.mark_corrected(rec.get("id", ""), {field: value})
                except Exception:
                    pass
                return True

            return False
        except Exception:
            return False

    def _assistant_edit_record(self, rec):
        """Double-click handler from the Assistant log. Email-type rows open the
        full triage / teach editor (with a group control); follow-up rows open the
        follow-up actions dialog (cancel / reschedule / Outlook reminder)."""
        try:
            p = rec.get("payload", {}) or {}
            email = self.get_email_by_id(p.get("entry_id", "")) or p.get("email")
            parent = getattr(self.assistant, "_log_win", None) or self.root
            if rec.get("kind", "") in ("Follow-up", "Reply draft"):
                self._assistant_followup_actions(email, rec, parent=parent)
                return
            if not email:
                try:
                    messagebox.showinfo("Edit", "This email isn't in the active cache anymore, so it can't be edited from here.", parent=parent)
                except Exception:
                    pass
                return

            def _after_saved():
                try:
                    if hasattr(self.assistant, "_notify"):
                        self.assistant._notify()
                except Exception:
                    pass

            self.open_triage_teach_editor(email, rec=rec, parent=parent, on_saved=_after_saved, show_group=True)
        except Exception:
            pass

    def open_triage_teach_editor(self, email, rec=None, parent=None, on_saved=None, show_group=True):
        """Reusable 'Correct this triage' editor: category / urgency / status,
        follow-up learning + timing, and (optionally) a group selector to assign
        the email to a group or ungroup it. Mirrors the AI Triage Center editor so
        the learning behavior stays identical, and adds grouping."""
        if not email:
            return
        parent = parent or self.root
        rec = rec or {}
        entry_id = email.get("entry_id", "")
        edit = tk.Toplevel(parent)
        edit.title("Edit Triage / Teach MaINbox")
        remember_window_geometry(edit, "Edit Triage Teach MaINbox", "540x430")
        edit.transient(parent)
        try:
            edit.grab_set()
        except Exception:
            pass
        apply_theme(edit)
        tk.Label(edit, text="Correct this triage", font=("Segoe UI", 13, "bold"), bg=_BG, fg=_ACCENT).pack(anchor="w", padx=12, pady=(12, 4))
        subj = (email.get("subject", "") or rec.get("subject", "") or "No subject")
        tk.Label(edit, text=subj[:100], wraplength=480, bg=_BG, fg=_FG).pack(anchor="w", padx=12, pady=(0, 10))
        cat = tk.StringVar(value=email.get("category", "General"))
        urg = tk.StringVar(value=email.get("urgency", "Normal"))
        stat = tk.StringVar(value=email.get("status", "Needs Reply"))
        for label, var, vals in [("Workflow Category", cat, CATEGORIES), ("Urgency", urg, URGENCY_LEVELS), ("Status", stat, STATUSES)]:
            row = tk.Frame(edit, bg=_BG); row.pack(fill="x", padx=12, pady=5)
            tk.Label(row, text=label, width=18, anchor="w", bg=_BG, fg=_FG).pack(side="left")
            ttk.Combobox(row, textvariable=var, values=vals, state="readonly", width=28).pack(side="left")

        active_groups = [g for g in self.groups_data.get("groups", []) if not g.get("archived")]
        group_names = ["(Ungrouped)"] + [g.get("name", "(unnamed)") for g in active_groups]
        try:
            current_gid = self.get_group_id_for_email(entry_id) or ""
        except Exception:
            current_gid = ""
        current_group_name = next((g.get("name", "(unnamed)") for g in active_groups if g.get("id") == current_gid), "(Ungrouped)")
        group_var = tk.StringVar(value=current_group_name)
        if show_group:
            row = tk.Frame(edit, bg=_BG); row.pack(fill="x", padx=12, pady=5)
            tk.Label(row, text="Group", width=18, anchor="w", bg=_BG, fg=_FG).pack(side="left")
            ttk.Combobox(row, textvariable=group_var, values=group_names, state="readonly", width=28).pack(side="left")

        followup_behavior = tk.StringVar(value="Use Status/AI")
        followup_minutes = tk.StringVar(value="Use Default")
        row = tk.Frame(edit, bg=_BG); row.pack(fill="x", padx=12, pady=5)
        tk.Label(row, text="Follow-Up Learning", width=18, anchor="w", bg=_BG, fg=_FG).pack(side="left")
        ttk.Combobox(row, textvariable=followup_behavior, values=["Use Status/AI", "No Follow-Up", "Wait for Vendor", "Wait for Customer", "General Follow-Up Review"], state="readonly", width=28).pack(side="left")
        row = tk.Frame(edit, bg=_BG); row.pack(fill="x", padx=12, pady=5)
        tk.Label(row, text="Follow-Up Timing", width=18, anchor="w", bg=_BG, fg=_FG).pack(side="left")
        ttk.Combobox(row, textvariable=followup_minutes, values=["Use Default", "1 minute", "5 minutes", "15 minutes", "30 minutes", "1 hour", "2 hours", "4 hours", "Tomorrow", "3 days", "1 week"], state="readonly", width=28).pack(side="left")

        def save_edit():
            try:
                before = {"category": email.get("category", ""), "urgency": email.get("urgency", ""), "status": email.get("status", ""), "group": current_gid}
                # v4.1.16: the Teach editor can reopen a closed email; record the
                # explicit reopen so the closed guard cannot re-close it at startup.
                _was_closed = self._email_was_closed_before_edit(email)
                email["category"] = cat.get()
                email["urgency"] = urg.get()
                email["status"] = stat.get()
                email["is_new_import"] = False
                if _was_closed and not self.workflow_record_is_closed(email):
                    self._record_explicit_reopen_for_email(email, save=True)
                self.save_record(email)
                self.flush_status_data()
                try:
                    self.save_cached_state()
                except Exception:
                    pass
                try:
                    self.learn_from_user_correction(email, cat.get(), urg.get(), stat.get())
                except Exception:
                    pass

                new_gid = current_gid
                if show_group:
                    chosen = group_var.get()
                    if chosen == "(Ungrouped)":
                        self.groups_data.get("memberships", {}).pop(entry_id, None)
                        new_gid = ""
                    else:
                        gid = next((g.get("id") for g in active_groups if g.get("name", "(unnamed)") == chosen), "")
                        if gid:
                            self.groups_data.setdefault("memberships", {})[entry_id] = gid
                            try:
                                self.mark_group_has_new(gid)
                            except Exception:
                                pass
                            new_gid = gid
                    try:
                        self.save_groups()
                    except Exception:
                        pass

                fb = followup_behavior.get()
                minutes_choice = followup_minutes.get()
                minutes_val = self.followup_minutes_from_choice(minutes_choice)
                fb_map = {"No Follow-Up": "no_followup", "Wait for Vendor": "wait_for_vendor", "Wait for Customer": "wait_for_customer", "General Follow-Up Review": "followup_review"}
                learned_behavior = fb_map.get(fb, "")
                followup_note = ""
                if learned_behavior:
                    try:
                        self.learn_followup_behavior(email, learned_behavior, minutes_val, f"User taught follow-up behavior from Assistant editor: {fb}")
                    except Exception:
                        pass
                if learned_behavior == "no_followup":
                    cancelled = self._cancel_active_followups_for_email(email, "User taught No Follow-Up from Assistant editor")
                    followup_note = f" No-follow-up applied; cancelled {cancelled} active item(s)."
                elif learned_behavior or minutes_val is not None:
                    behavior_for_now = learned_behavior or "followup_review"
                    if minutes_val is None:
                        if behavior_for_now == "wait_for_vendor":
                            minutes_val = VENDOR_NO_RESPONSE_MINUTES
                        elif behavior_for_now == "wait_for_customer":
                            minutes_val = CUSTOMER_PO_FOLLOWUP_MINUTES
                        else:
                            minutes_val = CUSTOMER_PO_FOLLOWUP_MINUTES
                    scenario_type = "ai_followup_review"
                    if behavior_for_now == "wait_for_vendor":
                        scenario_type = "ai_vendor_followup_review"
                    elif behavior_for_now == "wait_for_customer":
                        scenario_type = "ai_customer_followup_review"
                    try:
                        scheduled = self.schedule_scenario_reminder(scenario_type, email, int(minutes_val), f"User set follow-up from Assistant editor: {fb}; timing {minutes_choice}")
                        self.save_scenario_reminders()
                        followup_note = (f" Follow-up review scheduled in {int(minutes_val)} minute(s)." if scheduled
                                         else " Follow-up not scheduled (a matching reminder may already exist).")
                    except Exception:
                        pass

                try:
                    self.record_ai_triage_history(
                        email, before=before,
                        after={"category": cat.get(), "urgency": urg.get(), "status": stat.get(),
                               "group": new_gid, "followup_behavior": fb, "followup_minutes": minutes_val},
                        reason="User corrected from Assistant log." + followup_note, source="User Edit")
                except Exception:
                    pass
                try:
                    self.sort_emails_for_display(); self.render_email_rows(); self.render_group_rows(); self.render_followup_preview_queue()
                except Exception:
                    pass
                edit.destroy()
                if callable(on_saved):
                    try:
                        on_saved()
                    except Exception:
                        pass
            except Exception as exc:
                try:
                    messagebox.showerror("Edit Triage", f"Could not save the correction.\n\n{exc}", parent=edit)
                except Exception:
                    pass

        btns = tk.Frame(edit, bg=_BG); btns.pack(fill="x", padx=12, pady=15)
        tk.Button(btns, text="Save Correction", command=save_edit, width=18).pack(side="left", padx=5)
        tk.Button(btns, text="Cancel", command=edit.destroy, width=12).pack(side="left", padx=5)

    def _cancel_active_followups_for_email(self, email, reason="Cancelled by user"):
        """Mark every active follow-up / tracking item for one email cancelled
        across all collections, persist, and teach 'no follow-up'. Returns count."""
        cancelled = 0
        now_iso = datetime.now().isoformat()
        try:
            for coll_name in ("followups", "scenario_reminders", "pending_reply_checks", "commitment_reminders"):
                coll = getattr(self, coll_name, None) or []
                for item in coll:
                    try:
                        if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                            item["cancelled"] = True
                            item["cancelled_at"] = now_iso
                            item["cancel_reason"] = reason
                            cancelled += 1
                    except Exception:
                        continue
            for saver in ("save_followups", "save_scenario_reminders", "save_commitment_reminders"):
                fn = getattr(self, saver, None)
                if callable(fn):
                    try:
                        fn()
                    except Exception:
                        pass
            try:
                self.flush_status_data()
            except Exception:
                pass
            try:
                self.learn_followup_behavior(email, "no_followup", None, reason)
            except Exception:
                pass
        except Exception:
            pass
        return cancelled

    def _assistant_followup_actions(self, email, rec, parent=None):
        """Manage the follow-up behind a log row: cancel it, change its date/time,
        or add / cancel a matching Outlook calendar reminder."""
        parent = parent or getattr(self.assistant, "_log_win", None) or self.root
        entry_id = (email or {}).get("entry_id", "") or ((rec.get("payload", {}) or {}).get("entry_id", ""))
        try:
            item = self.get_active_followup_for_email(entry_id)
        except Exception:
            item = None

        dlg = tk.Toplevel(parent)
        dlg.title("Follow-Up Actions")
        remember_window_geometry(dlg, "Assistant Follow-Up Actions", "460x300")
        dlg.transient(parent)
        try:
            dlg.grab_set()
        except Exception:
            pass
        apply_theme(dlg)
        title = (email or {}).get("subject", "") or rec.get("subject", "") or "this follow-up"
        tk.Label(dlg, text="Follow-Up Actions", font=("Segoe UI", 13, "bold"), bg=_BG, fg=_ACCENT).pack(anchor="w", padx=12, pady=(12, 4))
        tk.Label(dlg, text=str(title)[:90], wraplength=420, bg=_BG, fg=_FG).pack(anchor="w", padx=12, pady=(0, 8))

        status_var = tk.StringVar()

        def _set_status():
            if not item:
                status_var.set("No active follow-up found for this email (it may already be done or cancelled).")
            elif item.get("outlook_appt_entry_id"):
                status_var.set("An Outlook reminder is attached to this follow-up.")
            else:
                status_var.set("No Outlook reminder attached yet.")
        _set_status()

        def _refresh_log():
            try:
                if hasattr(self.assistant, "_notify"):
                    self.assistant._notify()
            except Exception:
                pass

        def do_cancel():
            if not email:
                return
            n = self._cancel_active_followups_for_email(email, "Cancelled from Assistant log")
            if item and item.get("outlook_appt_entry_id"):
                try:
                    self.cancel_outlook_reminder_for_item(item)
                except Exception:
                    pass
            try:
                self.sort_emails_for_display(); self.render_email_rows(); self.render_group_rows(); self.render_followup_preview_queue()
            except Exception:
                pass
            try:
                if rec.get("id") and hasattr(self.assistant, "mark_undone"):
                    self.assistant.mark_undone(rec.get("id"))
            except Exception:
                pass
            _refresh_log()
            try:
                messagebox.showinfo("Follow-Up Cancelled", f"Cancelled {n} active follow-up/tracking item(s) for this email.", parent=parent)
            except Exception:
                pass
            dlg.destroy()

        def do_change_date():
            dlg.destroy()
            try:
                if self.goto_email_in_app(entry_id):
                    self.open_followup_window()
                else:
                    messagebox.showinfo("Change Date", "Could not select this email in the list to reschedule.", parent=parent)
            except Exception:
                pass

        def do_set_reminder():
            if not item:
                try:
                    messagebox.showinfo("Set Reminder", "No active follow-up to attach a reminder to. Set a follow-up first via Change Date/Time.", parent=dlg)
                except Exception:
                    pass
                return
            ok = False
            try:
                ok = bool(self.create_or_update_outlook_commitment_reminder(item))
                if ok:
                    try:
                        self.save_followups()
                    except Exception:
                        pass
            except Exception:
                ok = False
            _set_status()
            try:
                messagebox.showinfo("Outlook Reminder",
                                    "Outlook reminder set for this follow-up." if ok else
                                    "Could not set the Outlook reminder. Make sure Outlook is open and the follow-up has a due time.",
                                    parent=dlg)
            except Exception:
                pass

        def do_cancel_reminder():
            if not (item and item.get("outlook_appt_entry_id")):
                try:
                    messagebox.showinfo("Cancel Reminder", "There's no Outlook reminder attached to this follow-up.", parent=dlg)
                except Exception:
                    pass
                return
            ok = self.cancel_outlook_reminder_for_item(item)
            _set_status()
            try:
                messagebox.showinfo("Outlook Reminder", "Outlook reminder cancelled." if ok else "Could not cancel the Outlook reminder.", parent=dlg)
            except Exception:
                pass

        bf = tk.Frame(dlg, bg=_BG); bf.pack(fill="x", padx=12, pady=8)
        tk.Button(bf, text="Cancel Follow-up", command=do_cancel, width=20).grid(row=0, column=0, padx=4, pady=4, sticky="w")
        tk.Button(bf, text="Change Date/Time", command=do_change_date, width=20).grid(row=0, column=1, padx=4, pady=4, sticky="w")
        tk.Button(bf, text="Set Outlook Reminder", command=do_set_reminder, width=20).grid(row=1, column=0, padx=4, pady=4, sticky="w")
        tk.Button(bf, text="Cancel Outlook Reminder", command=do_cancel_reminder, width=20).grid(row=1, column=1, padx=4, pady=4, sticky="w")
        tk.Label(dlg, textvariable=status_var, bg=_BG, fg=_FG_DIM, wraplength=420, justify="left").pack(anchor="w", padx=12, pady=(8, 4))
        tk.Button(dlg, text="Close", command=dlg.destroy, width=12).pack(anchor="e", padx=12, pady=(4, 12))

    def cancel_outlook_reminder_for_item(self, item):
        """Delete the Outlook calendar reminder previously created for a follow-up
        item (by stored EntryID) and clear the reference. Guarded + thread-safe."""
        if not isinstance(item, dict):
            return False
        appt_id = item.get("outlook_appt_entry_id", "")
        if not appt_id:
            return False
        did_init = outlook_thread_init()
        ok = False
        try:
            outlook, namespace = self.fresh_outlook()
            if outlook and namespace:
                try:
                    appt = namespace.GetItemFromID(appt_id)
                    if appt is not None:
                        appt.Delete()
                        ok = True
                except Exception:
                    ok = False
        finally:
            try:
                outlook_thread_uninit(did_init)
            except Exception:
                pass
        item["outlook_appt_entry_id"] = ""
        for saver in ("save_followups", "save_scenario_reminders", "save_commitment_reminders"):
            fn = getattr(self, saver, None)
            if callable(fn):
                try:
                    fn()
                except Exception:
                    pass
        try:
            self.log(f"Outlook reminder cancelled for follow-up: {(item.get('subject','') or '')[:60]}")
        except Exception:
            pass
        return ok

    def make_safe_email_snapshot(self, email):
        safe = dict(email or {})
        safe.pop("message", None)
        return safe

    def save_undo_state(self, label="last action"):
        """Store a small local snapshot so Ctrl+Z can undo the last user action."""
        try:
            snapshot = {
                "label": label,
                "saved_at": datetime.now().isoformat(),
                "emails": [self.make_safe_email_snapshot(e) for e in self.emails],
                "status_data": self.status_data,
                "followups": self.followups,
                "scenario_reminders": self.scenario_reminders,
                "commitment_reminders": getattr(self, "commitment_reminders", []),
                "pending_reply_checks": self.pending_reply_checks,
                "sent_waiting_placeholders": self.sent_waiting_placeholders,
                "sent_waiting_processed_sent_ids": getattr(self, "sent_waiting_processed_sent_ids", []),
                "commitment_processed_message_ids": getattr(self, "commitment_processed_message_ids", []),
                "groups_data": self.groups_data,
                "learning_data": self.learning_data,
                "triage_history": self.triage_history,
                "deleted_history": self.deleted_history,
                "active_filter": self.active_filter,
                "active_group_filter": self.active_group_filter,
            }
            snapshot = json.loads(json.dumps(snapshot, default=str))
            self.undo_stack.append(snapshot)
            if len(self.undo_stack) > getattr(self, "undo_limit", 10):
                self.undo_stack = self.undo_stack[-self.undo_limit:]
        except Exception:
            pass

    def undo_last_action(self, event=None):
        if not getattr(self, "undo_stack", None):
            try:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, "Nothing to undo.")
            except Exception:
                pass
            return "break"
        snap = self.undo_stack.pop()
        try:
            self.emails = snap.get("emails", [])
            for email in self.emails:
                email["message"] = None
                email["followup_time"] = self.get_followup_display_for_email(email.get("entry_id", ""))
            self._rebuild_email_index()  # keep O(1) index consistent after undo.
            self.status_data = snap.get("status_data", {})
            self.followups = snap.get("followups", [])
            self.scenario_reminders = snap.get("scenario_reminders", [])
            self.commitment_reminders = snap.get("commitment_reminders", getattr(self, "commitment_reminders", []))
            self.pending_reply_checks = snap.get("pending_reply_checks", [])
            # v3 efficiency: restored snapshot data must be re-deduped on the next save.
            self._followup_dedup_needed = True
            self.sent_waiting_placeholders = snap.get("sent_waiting_placeholders", [])
            self.sent_waiting_processed_sent_ids = snap.get("sent_waiting_processed_sent_ids", getattr(self, "sent_waiting_processed_sent_ids", []))
            self.commitment_processed_message_ids = snap.get("commitment_processed_message_ids", getattr(self, "commitment_processed_message_ids", []))
            self.groups_data = snap.get("groups_data", {"groups": [], "memberships": {}})
            self.learning_data = snap.get("learning_data", {"senders": {}, "domains": {}, "subjects": {}, "followups": {}, "group_rules": {}})
            self.triage_history = snap.get("triage_history", [])
            self.deleted_history = snap.get("deleted_history", [])
            self.active_filter = snap.get("active_filter", self.active_filter)
            self.active_group_filter = snap.get("active_group_filter", self.active_group_filter)

            # v4.1.16: undo restored a whole status_data snapshot -- reconcile the
            # machine-local closed ledger with it (in BOTH directions) so the guard
            # cannot silently re-apply an undone close/delete at the next startup,
            # and so an undone reopen re-closes durably.
            self._reconcile_closed_email_guard_after_undo()

            self.flush_status_data()
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_pending_reply_checks()
            self.save_sent_waiting_placeholders()
            self.save_groups()
            self.save_learning_rules()
            self.save_triage_history()
            self.save_deleted_history()
            self.save_cached_state()
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, f"Undid: {snap.get('label', 'last action')}")
        except Exception as exc:
            try:
                messagebox.showerror("Undo Failed", f"Could not undo the last action.\n\n{exc}")
            except Exception:
                pass
        return "break"

    def refresh_hotkey(self, event=None):
        self.refresh_new_emails()
        return "break"

    def followup_minutes_from_choice(self, choice):
        raw = (choice or "").strip().lower()
        if not raw or raw in ["default", "use default", "use status/ai"]:
            return None
        mapping = {
            "1 minute": 1, "5 minutes": 5, "15 minutes": 15, "30 minutes": 30,
            "1 hour": 60, "2 hours": 120, "4 hours": 240,
            "tomorrow": 24 * 60, "3 days": 3 * 24 * 60, "1 week": 7 * 24 * 60,
        }
        if raw in mapping:
            return mapping[raw]
        m = re.match(r"^(\d+)\s*(m|min|mins|minute|minutes)$", raw)
        if m:
            return int(m.group(1))
        m = re.match(r"^(\d+)\s*(h|hr|hrs|hour|hours)$", raw)
        if m:
            return int(m.group(1)) * 60
        if raw.isdigit():
            return int(raw)
        return None

