def apply_mainbox_settings(settings):
    """Apply visual settings to the existing module-level theme globals."""
    global CURRENT_MAINBOX_SETTINGS
    global _BG, _BG2, _BG3, _ACCENT, _ACCENT2, _BTN_BG, _BTN_FG, _FG, _FG_DIM, _SEL_BG, _SEL_FG, _ENTRY_BG, _BORDER, _FONT, _FONT_SIZE, _FONT_WEIGHT
    global OLLAMA_ENABLED, OLLAMA_MODEL, RFQ_TEXT_MODEL, RFQ_VISION_MODEL, RFQ_PARSER_MODE, RFQ_ENABLE_VISION_FALLBACK, RFQ_USE_SMARTSCAN_FOR_RFQ, RFQ_SMARTSCAN_PATH
    global AI_REPLY_MODEL, AI_TRIAGE_MODEL, AI_SUMMARY_MODEL, AI_QUOTE_MODEL, AI_PURCHASE_MODEL, AI_STATUS_MODEL
    global RFQ_OCR_PROGRAM_ORDER, RFQ_PDF_TEXT_EXTRACTION_ENABLED, RFQ_TESSERACT_OCR_ENABLED, RFQ_IMAGE_OCR_ENABLED, RFQ_EXPECTED_ITEM_COUNT_HINT
    global FOLLOWUP_LEARNING_APPLY_CONFIDENCE, AI_TRIAGE_GROUP_MIN_CONFIDENCE, MIN_BUSINESS_RELEVANCE_FOR_FOLLOWUP, MAX_SPAM_LIKELIHOOD_FOR_FOLLOWUP
    global AI_ENGINE_MIN_RESCAN_HOURS, AI_ENGINE_MAX_SCAN_PER_RUN
    global COVERAGE_DEBUG, RFQ_DEBUG_ATTACHMENTS  # v4.1.26: settings-driven diagnostics
    if not isinstance(settings, dict):
        settings = default_mainbox_settings()
    try:
        CURRENT_MAINBOX_SETTINGS = dict(settings)
    except Exception:
        CURRENT_MAINBOX_SETTINGS = {}
    if str(settings.get("theme", "dark")).lower() == "light":
        _BG        = "#f5f7fb"
        _BG2       = "#eef2f8"
        _BG3       = "#ffffff"
        _ACCENT    = "#2563eb"
        _ACCENT2   = "#1d4ed8"
        _BTN_BG    = "#e4ecf8"
        _BTN_FG    = "#0f1f33"
        _FG        = "#16202e"
        _FG_DIM    = "#5a6b82"
        _SEL_BG    = "#cfe0ff"
        _SEL_FG    = "#0b1626"
        _ENTRY_BG  = "#ffffff"
        _BORDER    = "#d7deea"
    else:
        _BG        = "#15181e"
        _BG2       = "#1c2027"
        _BG3       = "#222831"
        _ACCENT    = "#5b9dff"
        _ACCENT2   = "#3d7fe0"
        _BTN_BG    = "#2a313d"
        _BTN_FG    = "#e4ecf7"
        _FG        = "#e6ecf4"
        _FG_DIM    = "#8a98ad"
        _SEL_BG    = "#2f4d7a"
        _SEL_FG    = "#ffffff"
        _ENTRY_BG  = "#11141a"
        _BORDER    = "#2c343f"
    _FONT = str(settings.get("font_family", "Segoe UI") or "Segoe UI")
    try:
        _FONT_SIZE = max(7, min(18, int(settings.get("font_size", 9))))
    except Exception:
        _FONT_SIZE = 9
    _FONT_WEIGHT = "bold" if bool(settings.get("font_bold", False)) else "normal"

    # v2.10.34: Apply any saved custom color overrides on top of the theme defaults.
    # Each key is optional — if not saved, the theme default above is used.
    _color_map = {
        "color_bg":       "_BG",
        "color_bg2":      "_BG2",
        "color_bg3":      "_BG3",
        "color_accent":   "_ACCENT",
        "color_btn_bg":   "_BTN_BG",
        "color_btn_fg":   "_BTN_FG",
        "color_fg":       "_FG",
        "color_fg_dim":   "_FG_DIM",
        "color_sel_bg":   "_SEL_BG",
        "color_sel_fg":   "_SEL_FG",
        "color_entry_bg": "_ENTRY_BG",
    }
    import sys as _sys
    _mod = _sys.modules[__name__]
    for _skey, _gname in _color_map.items():
        _val = settings.get(_skey, "")
        if _val and str(_val).startswith("#") and len(str(_val)) in (4, 7):
            try:
                globals()[_gname] = str(_val)
            except Exception:
                pass

    # Apply saved AI/OCR settings to the existing module-level switches that the app already uses.
    OLLAMA_ENABLED = bool(settings.get("ai_enabled", OLLAMA_ENABLED))
    default_model = str(settings.get("ai_default_model", OLLAMA_MODEL) or OLLAMA_MODEL).strip()
    OLLAMA_MODEL = default_model
    AI_STATUS_MODEL = default_model
    AI_REPLY_MODEL = str(settings.get("ai_reply_model", default_model) or default_model).strip()
    AI_TRIAGE_MODEL = str(settings.get("ai_triage_model", default_model) or default_model).strip()
    AI_SUMMARY_MODEL = str(settings.get("ai_summary_model", default_model) or default_model).strip()
    AI_QUOTE_MODEL = str(settings.get("ai_quote_model", default_model) or default_model).strip()
    AI_PURCHASE_MODEL = str(settings.get("ai_purchase_model", RFQ_TEXT_MODEL or default_model) or RFQ_TEXT_MODEL or default_model).strip()
    RFQ_TEXT_MODEL = AI_PURCHASE_MODEL
    RFQ_VISION_MODEL = str(settings.get("ai_vision_model", RFQ_VISION_MODEL) or RFQ_VISION_MODEL).strip()
    RFQ_PARSER_MODE = str(settings.get("rfq_parser_mode", RFQ_PARSER_MODE) or "auto").strip().lower()
    RFQ_ENABLE_VISION_FALLBACK = bool(settings.get("rfq_vision_fallback_enabled", RFQ_ENABLE_VISION_FALLBACK))
    raw_order = str(settings.get("rfq_ocr_order", "docling,liteparse") or "docling,liteparse")
    RFQ_OCR_PROGRAM_ORDER = [x.strip().lower() for x in raw_order.replace(";", ",").split(",") if x.strip().lower() in ["docling", "liteparse"]]
    if not RFQ_OCR_PROGRAM_ORDER:
        RFQ_OCR_PROGRAM_ORDER = ["docling", "liteparse"]
    RFQ_PDF_TEXT_EXTRACTION_ENABLED = bool(settings.get("rfq_pdf_text_enabled", True))
    RFQ_TESSERACT_OCR_ENABLED = bool(settings.get("rfq_tesseract_enabled", True))
    RFQ_IMAGE_OCR_ENABLED = bool(settings.get("rfq_image_ocr_enabled", True))
    try:
        RFQ_EXPECTED_ITEM_COUNT_HINT = max(1, min(250, int(settings.get("rfq_expected_item_count_hint", RFQ_EXPECTED_ITEM_COUNT_HINT))))
    except Exception:
        pass
    RFQ_USE_SMARTSCAN_FOR_RFQ = bool(settings.get("rfq_use_smartscan", RFQ_USE_SMARTSCAN_FOR_RFQ))
    # RFQ_SMARTSCAN_PATH is always "__embedded__" — no external path saved.
    try:
        FOLLOWUP_LEARNING_APPLY_CONFIDENCE = max(0.50, min(0.95, float(settings.get("followup_learning_confidence", FOLLOWUP_LEARNING_APPLY_CONFIDENCE))))
    except Exception:
        pass
    try:
        AI_TRIAGE_GROUP_MIN_CONFIDENCE = max(0.40, min(0.95, float(settings.get("triage_group_min_confidence", AI_TRIAGE_GROUP_MIN_CONFIDENCE))))
    except Exception:
        pass
    try:
        MIN_BUSINESS_RELEVANCE_FOR_FOLLOWUP = max(0.40, min(0.95, float(settings.get("min_business_relevance_for_followup", MIN_BUSINESS_RELEVANCE_FOR_FOLLOWUP))))
    except Exception:
        pass
    try:
        MAX_SPAM_LIKELIHOOD_FOR_FOLLOWUP = max(0.05, min(0.80, float(settings.get("max_spam_likelihood_for_followup", MAX_SPAM_LIKELIHOOD_FOR_FOLLOWUP))))
    except Exception:
        pass
    try:
        AI_ENGINE_MIN_RESCAN_HOURS = max(0.25, min(72.0, float(settings.get("ai_engine_min_rescan_hours", AI_ENGINE_MIN_RESCAN_HOURS))))
    except Exception:
        pass
    try:
        AI_ENGINE_MAX_SCAN_PER_RUN = max(1, min(250, int(settings.get("ai_engine_max_scan_per_run", AI_ENGINE_MAX_SCAN_PER_RUN))))
    except Exception:
        pass

    # v4.1.26 (round 8, security): support diagnostics are a SETTINGS switch now.
    # The env vars remain a one-off session override; the setting turns both
    # channels on together for a support/pilot session and off for production.
    if bool(settings.get("support_diagnostics_enabled", False)):
        COVERAGE_DEBUG = True
        RFQ_DEBUG_ATTACHMENTS = True
    else:
        COVERAGE_DEBUG = os.environ.get("MAINBOX_COVERAGE_DEBUG", "0").strip().lower() in ["1", "true", "yes", "on"]
        RFQ_DEBUG_ATTACHMENTS = os.environ.get("MAINBOX_RFQ_DEBUG_ATTACHMENTS", "0").strip().lower() in ["1", "true", "yes", "on"]
    # v4.1.27 (round 9, blocker #10): machine policy can forbid diagnostics outright --
    # the user switch and env vars are both overridden.
    try:
        if isinstance(MAINBOX_MACHINE_POLICY, dict) and \
                MAINBOX_MACHINE_POLICY.get("support_diagnostics_allowed") is False:
            COVERAGE_DEBUG = False
            RFQ_DEBUG_ATTACHMENTS = False
    except Exception:
        pass

    # v3.8.36: drive the AI host routing from Settings when configured. Each value is
    # optional; when blank, the MAINBOX_REMOTE_* env vars / per-task models take over, so
    # clearing a field cleanly reverts to env/defaults rather than leaving a stale value.
    global _REMOTE_OLLAMA_BASE, REMOTE_LIGHT_MODEL
    _allow_insecure = bool(settings.get("remote_ai_allow_insecure_http", False))
    _env_remote = (os.environ.get("MAINBOX_REMOTE_OLLAMA", "").strip() or None)
    if _env_remote:
        _env_remote = _env_remote.rstrip("/")
    _host_ip = str(settings.get("remote_ai_host_ip", "") or "").strip()
    if _host_ip:
        try:
            _host_port = int(settings.get("remote_ai_host_port", 11434) or 11434)
        except Exception:
            _host_port = 11434
        # v4.1.26 (round 8, security): a bare host configured in Settings is built as
        # plain http:// -- allowed only for local/loopback targets unless the user has
        # explicitly accepted insecure transport (private VPN link). Entering
        # "https://host" in the host field is honored as-is. A refused host falls
        # back to LOCAL AI rather than sending mail content in cleartext.
        if "://" in _host_ip:
            _b = _host_ip.rstrip("/")
            try:
                from urllib.parse import urlparse as _up
                if _up(_b).port is None:
                    _b = f"{_b}:{_host_port}"
            except Exception:
                pass
            _REMOTE_OLLAMA_BASE = _remote_ai_base_secured(_b, _allow_insecure)
        else:
            _REMOTE_OLLAMA_BASE = _remote_ai_base_secured(f"http://{_host_ip}:{_host_port}", _allow_insecure)
    else:
        _REMOTE_OLLAMA_BASE = _remote_ai_base_secured(_env_remote, _allow_insecure)
    # Rebuild the per-task host model map from env, then overlay the Settings host models.
    REMOTE_MODEL_FOR_TASK.clear()
    for _pair in os.environ.get("MAINBOX_REMOTE_MODELS", "").split(","):
        if "=" in _pair:
            _ek, _ev = _pair.split("=", 1)
            if _ek.strip() and _ev.strip():
                REMOTE_MODEL_FOR_TASK[_ek.strip().lower()] = _ev.strip()
    _heavy_model = str(settings.get("remote_ai_heavy_model", "") or "").strip()
    if _heavy_model:
        for _t in ("summary", "quote", "purchase"):
            REMOTE_MODEL_FOR_TASK[_t] = _heavy_model
    _vision_model = str(settings.get("remote_ai_vision_model", "") or "").strip()
    if _vision_model:
        REMOTE_MODEL_FOR_TASK["vision"] = _vision_model
    # v3.9.0: host model for triage. When set, triage routes host-first (with automatic
    # local fallback to ai_model_for_task("triage")); when blank, triage reverts to the
    # spill-only behavior unless MAINBOX_REMOTE_TASKS explicitly opted it in.
    _triage_model = str(settings.get("remote_ai_triage_model", "") or "").strip()
    if _triage_model:
        REMOTE_MODEL_FOR_TASK["triage"] = _triage_model
        REMOTE_OLLAMA_TASKS.add("triage")
    elif "triage" not in _ENV_REMOTE_TASKS:
        REMOTE_OLLAMA_TASKS.discard("triage")
    # Host model for LIGHT tasks that spill over from this PC when it's busy (env fallback).
    # Per-task LOCAL models stay governed by the AI Settings section; this only affects spill.
    _light_model = str(settings.get("remote_ai_light_model", "") or "").strip()
    REMOTE_LIGHT_MODEL = _light_model or (os.environ.get("MAINBOX_REMOTE_LIGHT_MODEL", "").strip() or None)

def ai_model_for_task(task, fallback=None):
    task = str(task or "").strip().lower()
    mapping = {
        "reply": AI_REPLY_MODEL,
        "triage": AI_TRIAGE_MODEL,
        "summary": AI_SUMMARY_MODEL,
        "quote": AI_QUOTE_MODEL,
        "purchase": AI_PURCHASE_MODEL,
        "vision": RFQ_VISION_MODEL,
        "status": AI_STATUS_MODEL,
    }
    return str(mapping.get(task) or fallback or OLLAMA_MODEL).strip()


# ---------------------------------------------------------------------------
# v3.8.35 AI host routing: split AI work between the local Ollama and a more
# capable remote (home) Ollama, with automatic fallback.
#
#   - Light, latency-sensitive tasks (triage, reply, status) stay local.
#   - Heavy tasks (summary, quote, purchase, vision) go to the remote host
#     when one is configured AND reachable; otherwise they fall back to local.
#
# Enable by pointing MaINbox at the home machine, e.g. (Windows):
#     set MAINBOX_REMOTE_OLLAMA=http://100.x.x.x:11434      (home Tailscale IP)
#     set MAINBOX_REMOTE_MODELS=summary=qwen2.5:32b,quote=qwen2.5:32b,purchase=qwen2.5:32b,vision=llama3.2-vision:11b
# If MAINBOX_REMOTE_OLLAMA is unset, every task runs locally and behavior is
# unchanged. The remote-model override applies ONLY to remote calls, so a
# fallback to local always uses the normal (local) model name.
# ---------------------------------------------------------------------------
_LOCAL_OLLAMA_BASE = os.environ.get("MAINBOX_LOCAL_OLLAMA", "http://localhost:11434").rstrip("/")

# v4.1.26 (round 8, security): transport policy for the remote AI host. Email bodies
# and attachment text are sent to this endpoint, so plaintext HTTP to a NON-local host
# is refused unless the user explicitly opts in (Settings -> remote_ai_allow_insecure_http,
# for private VPN/Tailscale links they trust like localhost). https:// is always allowed;
# localhost/loopback is always allowed. A refused host returns None, which cleanly falls
# back to LOCAL AI -- degraded capability, never degraded confidentiality.
_REMOTE_AI_TRANSPORT_WARNING = ""

# v4.1.27 (external audit round 9, blocker #10): MACHINE POLICY. An administrator can
# enforce AI-security posture in %PROGRAMDATA%\MaINbox\policy.json -- a location normal
# users cannot write without elevation -- and those keys OVERRIDE user settings:
#   { "force_local_ai": true,              -> every remote AI host refused
#     "remote_ai_require_https": true,     -> user's insecure-HTTP opt-in is ignored
#     "remote_ai_host_allowlist": ["ai.corp.example", "100.64.1.5"],
#     "support_diagnostics_allowed": false -> diagnostics stay off even if the user
#                                             flips the settings switch }
# Absent file / absent key = no constraint (single-user installs behave exactly as
# before). The file is read once at startup; policy changes take effect on relaunch.
MAINBOX_MACHINE_POLICY_WARNING = ""

def _load_machine_policy():
    """Returns (policy_dict, permission_warning). v4.1.28 (round 10, blocker #6): the
    source cannot CREATE the ACLs (that is the installer's job -- documented), but it
    can VERIFY them: if the policy file is writable by this non-elevated process, a
    standard user could weaken it, so the mismatch is reported loudly. The policy is
    still ENFORCED either way -- a tamperable policy is never weaker than no policy,
    but the admin must know the guarantee they think they have is not real yet."""
    try:
        _pd = os.environ.get("PROGRAMDATA", "") or r"C:\ProgramData"
        _pp = os.path.join(_pd, "MaINbox", "policy.json")
        if os.path.isfile(_pp):
            with open(_pp, "r", encoding="utf-8") as _fh:
                _pol = json.load(_fh)
            if isinstance(_pol, dict):
                _warn = ""
                try:
                    _writable = False
                    try:
                        _t = open(_pp, "a")   # append-open: no content change, tests write ACL
                        _t.close()
                        _writable = True
                    except Exception:
                        _writable = False
                    _elevated = False
                    try:
                        import ctypes
                        _elevated = bool(ctypes.windll.shell32.IsUserAnAdmin())
                    except Exception:
                        _elevated = False
                    if _writable and not _elevated:
                        _warn = (f"Machine policy at {_pp!r} is WRITABLE by this non-elevated "
                                 "user -- a standard user could weaken it. The policy is being "
                                 "enforced anyway, but the installer must set the directory ACL "
                                 "to admin-write/user-read for the guarantee to be real.")
                        try:
                            print("MaINbox: " + _warn)
                        except Exception:
                            pass
                except Exception:
                    _warn = ""
                return _pol, _warn
    except Exception:
        pass
    return {}, ""

MAINBOX_MACHINE_POLICY, MAINBOX_MACHINE_POLICY_WARNING = _load_machine_policy()

def _remote_ai_base_secured(base, allow_insecure=False):
    global _REMOTE_AI_TRANSPORT_WARNING
    if not base:
        return None
    b = str(base).strip().rstrip("/")
    if not b:
        return None
    try:
        from urllib.parse import urlparse
        _u = urlparse(b if "://" in b else "http://" + b)
        _host = str(_u.hostname or "").strip().lower()
        _scheme = str(_u.scheme or "http").strip().lower()
    except Exception:
        return None
    _is_local = (_host in ("localhost", "::1")) or _host.startswith("127.")
    # v4.1.27: machine policy outranks user settings.
    _pol = MAINBOX_MACHINE_POLICY if isinstance(MAINBOX_MACHINE_POLICY, dict) else {}
    if bool(_pol.get("force_local_ai", False)) and not _is_local:
        _REMOTE_AI_TRANSPORT_WARNING = (
            f"Remote AI host {b!r} refused: machine policy enforces local-only AI.")
        try:
            print("MaINbox: " + _REMOTE_AI_TRANSPORT_WARNING)
        except Exception:
            pass
        return None
    if bool(_pol.get("remote_ai_require_https", False)):
        allow_insecure = False   # the user checkbox cannot override policy
    _allowlist = _pol.get("remote_ai_host_allowlist")
    if isinstance(_allowlist, list) and _allowlist and not _is_local:
        _allowed = {str(h).strip().lower() for h in _allowlist if str(h).strip()}
        if _host not in _allowed:
            _REMOTE_AI_TRANSPORT_WARNING = (
                f"Remote AI host {b!r} refused: not on the machine-policy allowlist.")
            try:
                print("MaINbox: " + _REMOTE_AI_TRANSPORT_WARNING)
            except Exception:
                pass
            return None
    if _scheme == "https" or _is_local or allow_insecure:
        _REMOTE_AI_TRANSPORT_WARNING = ""
        return b
    _REMOTE_AI_TRANSPORT_WARNING = (
        f"Remote AI host {b!r} refused: plain HTTP to a non-local host would send email "
        "content unencrypted. Use https://, or enable 'Allow insecure remote AI (HTTP)' in "
        "Settings if this is a trusted private link. Falling back to local AI.")
    try:
        print("MaINbox: " + _REMOTE_AI_TRANSPORT_WARNING)
    except Exception:
        pass
    return None

_REMOTE_OLLAMA_BASE = _remote_ai_base_secured(
    os.environ.get("MAINBOX_REMOTE_OLLAMA", "").strip() or None,
    # Settings are not loaded yet at import time; the env-only bootstrap honors an
    # explicit env opt-in, and apply_mainbox_settings() re-evaluates with the saved
    # setting immediately after settings load.
    os.environ.get("MAINBOX_REMOTE_ALLOW_HTTP", "0").strip().lower() in ["1", "true", "yes", "on"],
)

# Tasks routed to the remote host when one is configured (comma-separated env
# override). Move a task in or out of this set to change where it runs.
REMOTE_OLLAMA_TASKS = {
    t.strip().lower()
    for t in os.environ.get("MAINBOX_REMOTE_TASKS", "summary,quote,purchase,vision").split(",")
    if t.strip()
}

# Snapshot of the env-configured remote task set so Settings can toggle triage routing
# (remote_ai_triage_model) without clobbering an explicit MAINBOX_REMOTE_TASKS opt-in.
_ENV_REMOTE_TASKS = frozenset(REMOTE_OLLAMA_TASKS)

# Optional per-task model override used ONLY on the remote host. Format:
# "task=model,task=model". Tasks not listed keep their normal model name, so
# local fallback never asks the local box for a model it does not have.
REMOTE_MODEL_FOR_TASK = {}
for _pair in os.environ.get("MAINBOX_REMOTE_MODELS", "").split(","):
    if "=" in _pair:
        _k, _v = _pair.split("=", 1)
        if _k.strip() and _v.strip():
            REMOTE_MODEL_FOR_TASK[_k.strip().lower()] = _v.strip()

# Model the host uses for a LIGHT task that spills over from this PC when this PC is busy
# (env override; normally set in Settings). Empty/None disables light spill.
REMOTE_LIGHT_MODEL = (os.environ.get("MAINBOX_REMOTE_LIGHT_MODEL", "").strip() or None)

# Light tasks allowed to borrow a free host slot when this PC is saturated.
LIGHT_SPILL_TASKS = {"triage", "reply"}

# Per-host concurrency caps. Local stays high so existing behavior is unchanged;
# the remote cap protects a single home GPU from being overrun, which is what
# lets small local jobs and big remote jobs run in parallel.
_local_ai_sem = threading.BoundedSemaphore(max(1, int(os.environ.get("MAINBOX_LOCAL_AI_CONCURRENCY", "8"))))
_remote_ai_sem = threading.BoundedSemaphore(max(1, int(os.environ.get("MAINBOX_REMOTE_AI_CONCURRENCY", "1"))))

# Remote health is tracked by a lightweight background probe so routing
# decisions are instant and a sleeping/offline home PC does not stall calls.
REMOTE_PROBE_INTERVAL = max(5, int(os.environ.get("MAINBOX_REMOTE_PROBE_SECONDS", "15")))
_remote_available = True
_remote_state_lock = threading.Lock()
_remote_probe_started = False
_remote_probe_lock = threading.Lock()
_remote_probe_stop = threading.Event()


class _BufferedOllamaResponse:
    """Minimal stand-in for an http.client.HTTPResponse: callers use it inside
    a `with ... as response:` block and read the body with response.read()."""

    def __init__(self, body, status=200, host=""):
        self._body = body
        self.status = status
        self.host = host

    def read(self, *args, **kwargs):
        return self._body

    def getcode(self):
        return self.status

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        return False


def _remote_is_available():
    with _remote_state_lock:
        return _remote_available


def _set_remote_available(value):
    global _remote_available
    with _remote_state_lock:
        _remote_available = bool(value)


def _ping_remote_ollama():
    if not _REMOTE_OLLAMA_BASE:
        return False
    try:
        req = urllib.request.Request(_REMOTE_OLLAMA_BASE + "/api/tags", method="GET")
        with urllib.request.urlopen(req, timeout=3) as resp:
            resp.read()
            ok = getattr(resp, "status", 200) == 200
    except Exception:
        ok = False
    _set_remote_available(ok)
    return ok


def _remote_probe_loop():
    while True:
        _ping_remote_ollama()
        if _remote_probe_stop.wait(REMOTE_PROBE_INTERVAL):
            return


def _ensure_remote_probe():
    global _remote_probe_started
    if _remote_probe_started or not _REMOTE_OLLAMA_BASE:
        return
    with _remote_probe_lock:
        if _remote_probe_started:
            return
        threading.Thread(target=_remote_probe_loop, name="OllamaRemoteProbe", daemon=True).start()
        _remote_probe_started = True


def ai_host_for_task(task):
    """Base URL of the Ollama host that should serve this task right now.
    Mirrors ai_model_for_task, but picks the machine instead of the model."""
    if (_REMOTE_OLLAMA_BASE
            and str(task or "").strip().lower() in REMOTE_OLLAMA_TASKS
            and _remote_is_available()):
        return _REMOTE_OLLAMA_BASE
    return _LOCAL_OLLAMA_BASE


def _set_payload_model(data, model):
    """Return the request body with its model field replaced (no-op if model is falsy)."""
    if not model:
        return data
    try:
        payload = json.loads(data.decode("utf-8"))
        payload["model"] = model
        return json.dumps(payload).encode("utf-8")
    except Exception:
        return data


def _apply_remote_model(data, task):
    """Swap in the configured host model for this task, if any."""
    return _set_payload_model(data, REMOTE_MODEL_FOR_TASK.get(str(task or "").strip().lower()))


def _post_ollama_generate(base, data, timeout):
    req = urllib.request.Request(
        base.rstrip("/") + "/api/generate",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        body = resp.read()
        status = getattr(resp, "status", 200)
    return _BufferedOllamaResponse(body, status, base)


def ollama_open(data, task=None, timeout=OLLAMA_TIMEOUT_SECONDS):
    """Drop-in replacement for the urllib.request.urlopen(req, ...) pattern used by
    MaINbox's Ollama /api/generate calls.

    - Heavy tasks (summary, quote, purchase, vision) prefer the host, falling back to
      local if the host fails or is offline.
    - Light tasks (triage, reply) run on this PC; if this PC is busy they borrow a free
      host slot (using the host light model) to keep things moving, and only wait for a
      local slot when neither this PC nor the host has one free.
    Returns a response-like object that supports `with ... as r: r.read()`."""
    _ensure_remote_probe()
    t = str(task or "").strip().lower()

    # Heavy / vision: host first, automatic local fallback.
    if ai_host_for_task(task) == _REMOTE_OLLAMA_BASE and _REMOTE_OLLAMA_BASE:
        try:
            with _remote_ai_sem:
                return _post_ollama_generate(_REMOTE_OLLAMA_BASE, _apply_remote_model(data, task), timeout)
        except Exception:
            _set_remote_available(False)  # trip the breaker, then fall through to local
        with _local_ai_sem:
            return _post_ollama_generate(_LOCAL_OLLAMA_BASE, data, timeout)

    # Light tasks: prefer this PC; spill to a free host slot when this PC is saturated.
    if (t in LIGHT_SPILL_TASKS and _REMOTE_OLLAMA_BASE and REMOTE_LIGHT_MODEL
            and _remote_is_available()):
        if _local_ai_sem.acquire(blocking=False):
            try:
                return _post_ollama_generate(_LOCAL_OLLAMA_BASE, data, timeout)
            finally:
                _local_ai_sem.release()
        if _remote_ai_sem.acquire(blocking=False):   # this PC busy -> borrow host if a slot is free
            try:
                return _post_ollama_generate(_REMOTE_OLLAMA_BASE, _set_payload_model(data, REMOTE_LIGHT_MODEL), timeout)
            except Exception:
                _set_remote_available(False)
            finally:
                _remote_ai_sem.release()
        # neither free -> wait for a local slot
        with _local_ai_sem:
            return _post_ollama_generate(_LOCAL_OLLAMA_BASE, data, timeout)

    # Default local path (light tasks with no host spill configured, or any other task).
    with _local_ai_sem:
        return _post_ollama_generate(_LOCAL_OLLAMA_BASE, data, timeout)


def ollama_router_shutdown():
    """Optional: stop the background remote-health probe (e.g., on app exit)."""
    _remote_probe_stop.set()


def list_ollama_models(base_url, timeout=4):
    """Return a sorted list of installed model names from an Ollama host's /api/tags.
    Returns [] if the host is unreachable. Used to populate the Settings dropdowns."""
    base = str(base_url or "").strip().rstrip("/")
    if not base:
        return []
    try:
        req = urllib.request.Request(base + "/api/tags", method="GET")
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="replace"))
        names = [str(m.get("name", "")).strip() for m in data.get("models", []) if m.get("name")]
        return sorted(n for n in names if n)
    except Exception:
        return []



# v3.8.09: embedded SmartScan engine - line-skip + highlight off-by-one fixes (v3.8.08),
#          plus lighting-fixture vocabulary (emergency light/luminaire/ballast) so
#          legitimate lighting items no longer get a spurious review warning.
# v3.9.3: embedded SmartScan engine -> v2.8.4.  Part-number-aware de-duplication so the
#          canonical-key passes no longer collapse two rows that share a generic
#          description but carry DIFFERENT real catalog part numbers (e.g. T&B
#          TY523M vs TY523MX); the duplicate-WARNING audits are part-aware too.
