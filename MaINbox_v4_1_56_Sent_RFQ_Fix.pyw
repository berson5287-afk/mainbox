        clean_body = clean_body[:AI_TRIAGE_BODY_LIMIT]

    group_lines = []
    for group in groups or []:
        name = str(group.get("name", "")).strip()
        if not name:
            continue
        group_lines.append(f"- id={group.get('id','')} | name={name} | urgency={group.get('urgency','Normal')}")
    group_text = "\n".join(group_lines) if group_lines else "No user-created groups yet."

    related_text = "\n".join([f"- {line}" for line in related_subjects[:8]]) if related_subjects else "No exact-subject matches found in cache."
    signal_text = json.dumps(signal_context, indent=2) if isinstance(signal_context, dict) else str(signal_context)

    prompt = f"""
You are MaINbox v3 Followup Learning AI, a conservative business-email triage engine that follows learned user corrections and learned follow-up rules first.
Return ONLY valid JSON. No markdown. No explanation outside JSON.

Allowed workflow_category values: {CATEGORIES}
Allowed urgency values: {URGENCY_LEVELS}
Allowed status values: {STATUSES}
Allowed sender_type values: customer_or_prospect, vendor_or_supplier, internal, automated_or_marketing, system_or_informational, unknown

Important status rules:
- Incoming customer/vendor emails usually mean Status = "Needs Reply" because the user probably owes the next action.
- "Waiting on Customer" means the customer clearly promised to send PO/approval/info later, or the user already replied and is waiting.
- "Waiting on Vendor" means the vendor has NOT replied yet and the user is waiting for quote/ETA/pricing/stock.
- If a vendor says "here is your quote", "quote attached", "our price is", "lead time is", or similar, status should usually be "Needs Reply", NOT "Waiting on Vendor".
- Newsletters, marketing, noreply notifications, FYI-only emails, receipts with no action, and system alerts should be Low + Completed or Junk / Ignore.
- If Pre-AI signals include trusted_sender or learned_rule_source and there are no strong spam signals, do NOT mark the email as Junk / Ignore.
- Be skeptical about follow-ups. Only mark needs_followup=true when it is a real business workflow and the email clearly indicates the other party must send something later. If Pre-AI signals include learned_followup_behavior, follow that learned behavior unless strong spam/junk evidence exists.

Pre-AI business signals already detected:
{signal_text}

Exact/normalized same-subject related emails found in cache:
{related_text}

Existing user-created groups:
{group_text}

Email to triage:
Sender: {sender}
Subject: {subject}
Body:
{clean_body}

JSON format:
{{
  "workflow_category": "General",
  "urgency": "Normal",
  "status": "Needs Reply",
  "sender_type": "unknown",
  "sender_intent": "short description of who/why they are emailing",
  "business_relevance": 0.0,
  "spam_likelihood": 0.0,
  "needs_followup": false,
  "followup_reason": "short reason or empty",
  "suggested_group_id": "",
  "group_confidence": 0.0,
  "reason": "short reason"
}}
""".strip()

    payload = {
        "model": ai_model_for_task("triage"),
        "prompt": prompt,
        "stream": False,
        "keep_alive": AI_KEEP_ALIVE,
        "options": {"temperature": 0.02, "num_predict": 220, "num_ctx": 2048, "top_k": 10, "top_p": 0.65}
    }

    try:
        data = json.dumps(payload).encode("utf-8")
        with ollama_open(data, task="triage", timeout=OLLAMA_TIMEOUT_SECONDS) as response:
            raw = response.read().decode("utf-8")
            result = json.loads(raw)
            obj = extract_json_object(result.get("response") or "")
            return obj if isinstance(obj, dict) else None
    except Exception:
        return None

