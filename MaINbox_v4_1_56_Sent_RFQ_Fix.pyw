                self.root.wait_window(win)
                return decision.get("action", "skip")
            except Exception:
                try:
                    return "create" if messagebox.askyesno("Create Reminder?", "MaINbox found a possible ETA / lead-time reminder. Create it?") else "skip"
                except Exception:
