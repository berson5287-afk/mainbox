def _debug_artifact_housekeeping():
    """v3.9.105: keep diagnostic artifacts bounded so they can stay enabled.

    coverage_debug.log lives in AppData and only ever appends -- with
    COVERAGE_DEBUG on it grows forever. Rotate it once per launch: past ~5 MB,
    keep only the newest ~1 MB (a truncated head is fine for a debug tail-log).
    The RFQ attachment debug dir keeps a proof copy of every scanned attachment;
    prune copies older than 14 days. Best-effort and fully guarded: housekeeping
    must never affect startup."""
    try:
        if os.path.exists(COVERAGE_DEBUG_FILE) and os.path.getsize(COVERAGE_DEBUG_FILE) > 5 * 1024 * 1024:
            with open(COVERAGE_DEBUG_FILE, "rb") as _fh:
                _fh.seek(-1024 * 1024, os.SEEK_END)
                tail = _fh.read()
            nl = tail.find(b"\n")
            if nl >= 0:
                tail = tail[nl + 1:]
            with open(COVERAGE_DEBUG_FILE, "wb") as _fh:
                _fh.write(b"[log rotated by MaINbox housekeeping]\n" + tail)
    except Exception:
        pass
    try:
        if os.path.isdir(RFQ_DEBUG_DIR):
            cutoff = (datetime.now() - timedelta(days=14)).timestamp()
            for name in os.listdir(RFQ_DEBUG_DIR):
                p = os.path.join(RFQ_DEBUG_DIR, name)
                try:
                    if os.path.isfile(p) and os.path.getmtime(p) < cutoff:
                        os.remove(p)
                except Exception:
                    continue
    except Exception:
        pass
