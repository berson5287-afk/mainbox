        def save_settings():
            try:
                new_settings = {
                    "theme": theme_var.get(),
                    "font_family": font_family_var.get() or "Segoe UI",
                    "font_size": int(font_size_var.get()),
                    "font_bold": bool(font_bold_var.get()),
