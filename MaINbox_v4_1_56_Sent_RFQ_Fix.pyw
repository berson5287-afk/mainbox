        save_json(QUOTE_REQUESTS_FILE, self.quote_requests)

    # v2.10.24 RFQ Extractor Cache
    def save_rfq_cache(self):
        """Persist cached RFQ extractor state so reopening the RFQ screen is instant."""
        try:
            if not isinstance(getattr(self, "rfq_cache", None), dict):
                self.rfq_cache = {"records": {}, "updated_at": ""}
            self.rfq_cache.setdefault("records", {})
            self.rfq_cache["updated_at"] = datetime.now().isoformat()
            save_json(RFQ_CACHE_FILE, self.rfq_cache)
        except Exception:
            pass

    def get_rfq_cache_key(self, group_id):
        """Stable cache key for normal groups and single-email RFQs."""
        return str(group_id or "").strip()

    def get_rfq_cache_record(self, group_id):
        try:
            key = self.get_rfq_cache_key(group_id)
            rec = (getattr(self, "rfq_cache", {}) or {}).get("records", {}).get(key, {})
            return rec if isinstance(rec, dict) else {}
        except Exception:
            return {}

    def record_rfq_cache(self, group_id, materials=None, vendors=None, ocr_details=None, used_ai=False,
                         quote_text="", group=None, emails=None, customer_hint="", requested_records=None,
                         subject="", body=""):
        """Save the full RFQ extractor working state for fast reopen and future quote documentation."""
        try:
            key = self.get_rfq_cache_key(group_id)
            if not key:
                return
            if not isinstance(getattr(self, "rfq_cache", None), dict):
                self.rfq_cache = {"records": {}, "updated_at": ""}
            records = self.rfq_cache.setdefault("records", {})
            old = records.get(key, {}) if isinstance(records.get(key, {}), dict) else {}

            email_snapshot = []
            for e in emails or []:
                if not isinstance(e, dict):
                    continue
                email_snapshot.append({
                    "entry_id": e.get("entry_id", ""),
                    "sender": e.get("sender", ""),
                    "sender_email": e.get("sender_email", ""),
                    "subject": e.get("subject", ""),
                    "received": e.get("received", ""),
                    "received_timestamp": e.get("received_timestamp", 0),
                    "source": e.get("source", ""),
                    "conversation_id": e.get("conversation_id", ""),
                })

            group_snapshot = {}
            if isinstance(group, dict):
                group_snapshot = {
                    "id": group.get("id", group_id),
                    "name": group.get("name", ""),
                    "urgency": group.get("urgency", ""),
                    "status": group.get("status", ""),
                    "single_email_rfq": bool(group.get("single_email_rfq")),
                }

            rec = dict(old)
            rec.update({
                "group_id": group_id,
                "group": group_snapshot or old.get("group", {}),
                "emails": email_snapshot or old.get("emails", []),
                "materials": normalize_material_items(materials if materials is not None else old.get("materials", [])),
                "vendors": list(vendors if vendors is not None else old.get("vendors", [])),
                "ocr_details": list(ocr_details if ocr_details is not None else old.get("ocr_details", [])),
                "used_ai": bool(used_ai if used_ai is not None else old.get("used_ai", False)),
                "quote_text": str(quote_text if quote_text is not None else old.get("quote_text", "")),
                "customer_hint": customer_hint if customer_hint is not None else old.get("customer_hint", ""),
                "requested_records": list(requested_records if requested_records is not None else old.get("requested_records", [])),
                "subject": subject if subject is not None else old.get("subject", ""),
                "body": body if body is not None else old.get("body", ""),
                "updated_at": datetime.now().isoformat(),
            })
            records[key] = rec
            self.save_rfq_cache()
            # v3.9.1: capture the customer's requested line items into the quote
            # coverage ledger so outstanding (un-quoted) items can be surfaced.
            try:
                self.update_coverage_requested_from_rfq(
                    group_id,
                    rec.get("materials", []),
                    group=group or rec.get("group"),
                    emails=emails if emails else rec.get("emails", []),
                )
            except Exception:
                pass
        except Exception:
            pass

    # ============================================================
    # v3.9.1 Quote Coverage engine
    # ------------------------------------------------------------
    # Tracks which requested RFQ line items have been quoted back to the
    # customer and surfaces the still-outstanding items in a live queue plus a
    # status-bar counter. Requested items are captured when an RFQ is extracted
    # (record_rfq_cache hook). Quoted items are captured by parsing sent replies
    # during the Sent Items scan, and can also be checked off manually. A thread
    # is keyed by Outlook ConversationID when available, else by normalized
    # subject, so the customer request and the reply(s) line up on the same key.
    # ============================================================
    # v4.1.45 (sixth audit, finding #1): PO-OWNED FIELDS. A failed PO transaction
    # used to roll back by replacing the whole job record with its snapshot, which
    # also erased any change a NON-lock-aware coverage writer had made to that same
    # record in the meantime (the auditor demonstrated a concurrent vendor update
    # vanishing). Rollback is now SURGICAL: only the fields the PO transaction
    # itself writes are reverted, so a concurrent writer's fields survive.
    _PO_OWNED_RECORD_KEYS = (
        "po_received", "po_numbers", "po_received_at", "award_status",
        "awarded_lines", "awarded", "awarded_at", "po_awards", "updated_at",
    )

    def _coverage_revision(self):
        """Monotonic counter bumped on every successful coverage save. Lets a
        transaction observe that another writer committed inside its window."""
        return int(getattr(self, "_cov_revision", 0) or 0)

    def _restore_po_fields(self, rec, snapshot, touched_line_keys=None):
        """v4.1.45: revert ONLY this transaction's own writes on `rec`, using
        `snapshot` (the pre-transaction deep copy) as the source of truth for the
        PO-owned keys. Fields owned by other writers are left untouched. For the
        opt-in vendor flip, only the specific line keys this transaction set are
        reverted -- lines another writer changed keep that writer's value."""
        try:
            if not isinstance(rec, dict) or not isinstance(snapshot, dict):
                return
            for k in self._PO_OWNED_RECORD_KEYS:
                if k in snapshot:
                    rec[k] = copy.deepcopy(snapshot[k])
                else:
                    rec.pop(k, None)
            for k in (touched_line_keys or []):
                _snap_status = (snapshot.get("item_status") or {})
                _cur_status = rec.get("item_status")
                if isinstance(_cur_status, dict):
                    if k in _snap_status:
                        _cur_status[k] = _snap_status[k]
                    else:
                        _cur_status.pop(k, None)
                _snap_done = list(snapshot.get("manual_done_keys") or [])
                _cur_done = rec.get("manual_done_keys")
                if isinstance(_cur_done, list) and k not in _snap_done and k in _cur_done:
                    try:
                        _cur_done.remove(k)
                    except ValueError:
                        pass
                _snap_check = snapshot.get("check_keys")
                if isinstance(_snap_check, list) and k in _snap_check:
                    _cur_check = rec.setdefault("check_keys", [])
                    if isinstance(_cur_check, list) and k not in _cur_check:
                        _cur_check.append(k)
        except Exception:
            pass

    def _coverage_save_lock(self):
        """v4.1.43: re-entrant lock serializing coverage mutate+save+rollback spans.
        The app's single-Outlook-worker model owns most coverage writes, but manual
        check-offs run on the Tk thread; the PO transaction methods now roll back on
        a failed save, and a rollback must not interleave with another writer.
        RLock because _record_po_award/_persist_po_review_entry hold it across their
        own save_quote_coverage() call."""
        lk = getattr(self, "_cov_save_rlock", None)
        if lk is None:
            lk = self._cov_save_rlock = threading.RLock()
        return lk

    def save_quote_coverage(self):
        """v4.1.43 (external audit of v4.1.42, CRITICAL finding): persistence must
        REPORT its outcome. The previous body swallowed every storage exception and
        returned None, so the v4.1.42 'transactional' PO methods -- which wrapped
        this call in try/except expecting save_json's exception to propagate --
        could never observe a failed write: a disk-full/locked-file save returned
        success, memory diverged from disk, and the PO vanished on restart.

        Returns True only when save_json completed; on failure the error is written
        to a durable, bounded log (a .pyw has no console) and False is returned.
        Existing call sites that ignore the return value are unaffected."""
        with self._coverage_save_lock():
            _prev_updated = None
            try:
                if not isinstance(getattr(self, "quote_coverage", None), dict):
                    self.quote_coverage = {"threads": {}, "updated_at": ""}
                self.quote_coverage.setdefault("threads", {})
                # v4.1.44 (audit #5, minor): remember the prior timestamp so a FAILED
                # save leaves the whole structure byte-identical -- previously
                # updated_at advanced even when nothing was durably written, which
                # could signal a coverage revision that never reached disk.
                _prev_updated = self.quote_coverage.get("updated_at", "")
                self.quote_coverage["updated_at"] = datetime.now().isoformat()
                save_json(QUOTE_COVERAGE_FILE, self.quote_coverage)
                # v4.1.45: revision counter for concurrent-writer detection.
                try:
                    self._cov_revision = int(getattr(self, "_cov_revision", 0) or 0) + 1
                except Exception:
                    self._cov_revision = 1
                # v4.1.45 (sixth audit, finding #6): a True here means the PRIMARY
                # JSON write succeeded. save_json may still have failed its SQLite
                # mirror, which is recoverable (JSON stays authoritative and the
                # startup reconciliation repairs the mirror), but it should not be
                # invisible -- record it.
                try:
                    if _db_mirror_pending_has(QUOTE_COVERAGE_FILE):
                        _cov_debug("save_quote_coverage: JSON written, SQLite mirror PENDING "
                                   "(JSON authoritative; startup reconciliation will repair)")
                except Exception:
                    pass
                return True
            except Exception as exc:
                if _prev_updated is not None:
                    try:
                        self.quote_coverage["updated_at"] = _prev_updated
                    except Exception:
                        pass
                try:
                    _cov_debug(f"save_quote_coverage FAILED: {type(exc).__name__}: {exc}")
                except Exception:
                    pass
                try:
                    _path = data_path("mainbox_coverage_save_failures.log")
                    try:
                        if os.path.exists(_path) and os.path.getsize(_path) > 512 * 1024:
                            os.remove(_path)
                    except Exception:
                        pass
                    with open(_path, "a", encoding="utf-8") as _f:
                        _f.write(f"{datetime.now().isoformat()}  {type(exc).__name__}: {exc}\n")
                except Exception:
                    pass
                return False

    def coverage_thread_key(self, conversation_id="", subject=""):
        cid = str(conversation_id or "").strip()
        if cid:
            return "conv:" + cid
        subj = self._normalized_thread_subject(subject or "")
        if subj:
            return "subj:" + subj
        return ""

    def coverage_thread_key_for_email(self, email):
        if not isinstance(email, dict):
            return ""
        return self.coverage_thread_key(email.get("conversation_id", ""), email.get("subject", ""))

    # ------------------------------------------------------------------ #
    # v3.9.96: GROUP-OWNED coverage. A quote job spans several Outlook
    # conversations (the customer RFQ + each vendor RFQ you send + their
    # replies), so keying coverage per-conversation fragmented one job across
    # many ledgers and the vendor quotes never met the customer ledger. The
    # GROUP is the stable, user-owned anchor that already ties them together,
    # so coverage is now keyed grp:<group_id> and named like the group.
    # ------------------------------------------------------------------ #
    def _coverage_group_key(self, group_id):
        gid = str(group_id or "").strip()
        return ("grp:" + gid) if gid else ""

    def _coverage_conv_group_index(self):
        """{conversation_id: group_id} for grouped emails, so a vendor reply can be routed to
        its job's group via a grouped member that shares the reply's conversation (e.g. the
        vendor RFQ tracker). Cached; rebuilt only when the email list / memberships change."""
        memberships = (self.groups_data.get("memberships", {}) if isinstance(getattr(self, "groups_data", None), dict) else {}) or {}
        # v4.1.19 AUDIT FIX (external audit finding #2): the old signature was just
        # (len(memberships), len(emails)) -- MOVING an email between groups changes
        # neither length, so the cache kept returning the OLD group and a later vendor
        # reply could be routed into the wrong job's coverage ledger. The signature now
        # includes an order-independent fingerprint of the membership CONTENTS, so any
        # add/remove/move rebuilds the index. O(n) XOR of hashes: cheap (no allocation),
        # and far smaller than the email walk it guards.
        _mfp = 0
        try:
            for _mk, _mv in memberships.items():
                _mfp ^= hash((_mk, _mv))
        except Exception:
            _mfp = 0
        sig = (_mfp, len(memberships), len(getattr(self, "emails", []) or []))
        cache = getattr(self, "_conv_group_idx", None)
        if isinstance(cache, dict) and cache.get("sig") == sig:
            return cache.get("idx", {})
        idx = {}
        try:
            for em in (getattr(self, "emails", []) or []):
                if not isinstance(em, dict):
                    continue
                gid = memberships.get(em.get("entry_id", ""), "")
                if not gid:
                    continue
                cid = str(em.get("conversation_id", "") or "").strip()
                if cid and cid not in idx:
                    idx[cid] = gid
        except Exception:
            pass
        self._conv_group_idx = {"sig": sig, "idx": idx}
        return idx

    def _coverage_group_id_for_conversation(self, conversation_id):
        cid = str(conversation_id or "").strip()
        if not cid:
            return ""
        try:
            return self._coverage_conv_group_index().get(cid, "")
        except Exception:
            return ""

    def _merge_coverage_records(self, dst, src):
        """Lossless union of coverage record src into dst. Preserves every requested/quoted
        line item (deduped on the same specific keys the ledger uses), every manual item
        status, the manual-done / processed-sent / auto-waiting bookkeeping, and the
        sourcing-ack flag -- used when consolidating per-conversation fragments into a group
        ledger so nothing you have already marked is lost."""
        try:
            if not isinstance(dst, dict) or not isinstance(src, dict):
                return

            def _req_key(it):
                p = re.sub(r"\s+", "", str((it or {}).get("part_number", "") or "").upper())
                if len(p) >= 3:
                    # v4.1.21/v4.1.23/v4.1.24: keep in lockstep with
                    # update_coverage_requested's dedupe -- qty, description, AND the row's
                    # own source_ref folded in so same-part siblings survive merges too.
                    _q = re.sub(r"\s+", "", str((it or {}).get("qty", "") or "").lower())
                    _s = str((it or {}).get("source_ref", "") or "")
                    return "part:" + p[:80] + "|q:" + _q + "|d:" + _coverage_norm((it or {}).get("description", ""))[:80] + "|s:" + _s[-32:]
                q = re.sub(r"\s+", "", str((it or {}).get("qty", "") or "").lower())
                return "desc:" + q + "|" + _coverage_norm((it or {}).get("description", ""))[:120]

            for field in ("requested", "quoted"):
                d = dst.setdefault(field, [])
                if not isinstance(d, list):
                    d = dst[field] = []
                seen = {_req_key(it) for it in d}
                for it in (src.get(field, []) or []):
                    k = _req_key(it)
                    if k not in seen:
                        d.append(it)
                        seen.add(k)
            for field in ("manual_done_keys", "processed_sent_ids", "auto_waiting_keys"):
                d = dst.setdefault(field, [])
                if not isinstance(d, list):
                    d = dst[field] = []
                have = set(d)
                for v in (src.get(field, []) or []):
                    if v not in have:
                        d.append(v)
                        have.add(v)
            dst_is = dst.setdefault("item_status", {})
            if not isinstance(dst_is, dict):
                dst_is = dst["item_status"] = {}
            for kk, vv in (src.get("item_status", {}) or {}).items():
                if not dst_is.get(kk):
                    dst_is[kk] = vv
            if src.get("sourcing_ack"):
                dst["sourcing_ack"] = True
            # v3.9.100: PRESERVE dismissals. This was AND ("stay active unless BOTH fragments
            # were dismissed"), so folding a dismissed record beside a non-dismissed one -- or
            # into a freshly-created group ledger, which starts un-dismissed -- CLEARED the
            # dismissal, and dismissed quote requests re-appeared after the v3.9.96 group
            # consolidation. Now: once ANY folded fragment was dismissed, the ledger stays
            # dismissed (the user un-dismisses / requotes to bring it back).
            dst["dismissed"] = bool(dst.get("dismissed")) or bool(src.get("dismissed"))
            for field in ("subject", "customer", "customer_email", "conversation_id"):
                if not dst.get(field) and src.get(field):
                    dst[field] = src.get(field)
        except Exception:
            pass

    def _consolidate_group_coverage(self, group_id):
        """Fold any legacy per-conversation/per-subject coverage records tagged with this
        group_id into the single grp:<group_id> ledger, then drop the legacy keys. Lossless.
        Runs when a group is (re)extracted, so it touches ONE job at a time. Returns the
        group ledger key."""
        try:
            gid = str(group_id or "").strip()
            if not gid:
                return ""
            group_key = "grp:" + gid
            if not isinstance(getattr(self, "quote_coverage", None), dict):
                return group_key
            threads = self.quote_coverage.setdefault("threads", {})
            legacy_keys = [k for k, r in list(threads.items())
                           if k != group_key and isinstance(r, dict)
                           and str(r.get("group_id", "") or "") == gid]
            if not legacy_keys:
                return group_key
            dst = self.get_coverage_record(group_key, create=True)
            moved = False
            for k in legacy_keys:
                src = threads.get(k)
                if isinstance(src, dict):
                    self._merge_coverage_records(dst, src)
                    threads.pop(k, None)
                    moved = True
            if moved:
                dst["group_id"] = gid
                dst["updated_at"] = datetime.now().isoformat()
                self.save_quote_coverage()
            return group_key
        except Exception:
            return "grp:" + str(group_id or "").strip()

    def _migrate_coverage_to_group_keys(self):
        """One-time, idempotent: fold EVERY existing per-conversation coverage record that
        carries a group_id into its group's ledger, so coverage you captured before v3.9.96
        consolidates under the group on first launch. Backs the coverage file up first and
        sets a flag so it never re-runs. Records with no group_id (truly ungrouped) are left
        exactly as they are."""
        try:
            if not isinstance(getattr(self, "quote_coverage", None), dict):
                return
            if self.quote_coverage.get("group_consolidation_done"):
                return
            threads = self.quote_coverage.get("threads", {}) or {}
            gids = set()
            for k, r in threads.items():
                if not isinstance(r, dict):
                    continue
                g = str(r.get("group_id", "") or "")
                if g and k != ("grp:" + g):
                    gids.add(g)
            if gids:
                try:
                    import shutil
                    if os.path.exists(QUOTE_COVERAGE_FILE):
                        shutil.copy2(QUOTE_COVERAGE_FILE, QUOTE_COVERAGE_FILE + ".pre_group_migration.bak")
                except Exception:
                    pass
                for g in sorted(gids):
                    self._consolidate_group_coverage(g)
            self.quote_coverage["group_consolidation_done"] = True
            self.save_quote_coverage()
        except Exception:
            pass

    def _repair_dismissals_after_group_merge(self):
        """One-time recovery for the v3.9.96..v3.9.99 group-consolidation bug.

        The consolidation merge combined 'dismissed' with AND, so folding a dismissed
        per-conversation record into a group ledger -- or into a freshly-created group ledger,
        which starts un-dismissed -- CLEARED the dismissal, and dismissed quote requests came
        back on first launch of a group-coverage build. The merge is fixed now (v3.9.100), but
        the consolidation already ran once and saved the un-dismissed records, so the fix alone
        can't bring the dismissals back. Re-apply them from the pre-migration backup that
        _migrate_coverage_to_group_keys wrote before folding: any group that had ANY dismissed
        fragment is re-dismissed on its grp:<id> ledger, and any dismissed ungrouped record is
        re-dismissed by conversation id. Flag-gated so it runs once; a harmless no-op when the
        backup is absent (a fresh install that never hit the bug). Only ADDS dismissals -- it
        never resurfaces anything -- so the worst case is that a resurfaced item you decided to
        keep gets hidden again, which you undo with Re-quote / un-dismiss.
        """
        try:
            if not isinstance(getattr(self, "quote_coverage", None), dict):
                return
            if self.quote_coverage.get("dismissal_repair_after_group_merge_done"):
                return
            bak = QUOTE_COVERAGE_FILE + ".pre_group_migration.bak"
            if not os.path.exists(bak):
                # Nothing to recover from; mark done so we don't re-check every launch.
                self.quote_coverage["dismissal_repair_after_group_merge_done"] = True
                self.save_quote_coverage()
                return
            try:
                with open(bak, "r", encoding="utf-8") as _fh:
                    old = json.load(_fh)
            except Exception:
                # Transient read failure -- leave the flag UNSET so it retries next launch.
                return
            old_threads = (old or {}).get("threads", {}) or {}
            dismissed_gids = set()
            dismissed_convs = set()
            for k, r in old_threads.items():
                if not isinstance(r, dict) or not r.get("dismissed"):
                    continue
                gid = str(r.get("group_id", "") or "").strip()
                if gid:
                    dismissed_gids.add(gid)
                else:
                    cid = str(r.get("conversation_id", "") or "").strip()
                    if not cid and str(k).startswith("conv:"):
                        cid = str(k)[5:]
                    if cid:
                        dismissed_convs.add(cid)
            threads = self.quote_coverage.setdefault("threads", {})
            repaired = 0
            for gid in dismissed_gids:
                rec = threads.get("grp:" + gid)
                if isinstance(rec, dict) and not rec.get("dismissed"):
                    rec["dismissed"] = True
                    rec["updated_at"] = datetime.now().isoformat()
                    repaired += 1
            if dismissed_convs:
                for _k, rec in list(threads.items()):
                    if not isinstance(rec, dict) or rec.get("dismissed"):
                        continue
                    cid = str(rec.get("conversation_id", "") or "").strip()
                    if cid and cid in dismissed_convs:
                        rec["dismissed"] = True
                        rec["updated_at"] = datetime.now().isoformat()
                        repaired += 1
            self._dismissal_repair_count = repaired  # surfaced in the load log line below
            self.quote_coverage["dismissal_repair_after_group_merge_done"] = True
            self.save_quote_coverage()
        except Exception:
            pass

    def _migrate_coverage_schema_v2(self):
        """v4.1.23 (external audit round 5, finding #3): VERSIONED migration of ledgers
        created before the v4.1.22 data model. Without it, legacy requested rows have no
        line_id, so per-line manual statuses stayed keyed by bare part number and marking
        one 632S line still marked its sibling on every pre-existing job.

        For each record not yet at coverage_schema_version 2:
          - every requested row gets a stable content-derived line_id (ordinal-suffixed
            for identical siblings);
          - manual statuses / done-marks / waiting / check keys that map to exactly ONE
            line transfer to that line's lid; AMBIGUOUS shared manual statuses become
            'check' on every affected line (the user re-confirms once, instead of the
            status silently applying to lines it may not belong to); waiting/check keys
            broadcast to all affected lines (safe states);
          - quoted rows get stable quote_line_ids;
          - the record is stamped coverage_schema_version = 2 (idempotent -- reruns skip).
        """
        try:
            qc = getattr(self, "quote_coverage", None)
            if not isinstance(qc, dict):
                return False
            threads = qc.get("threads", {}) or {}
            changed = False
            for _tkey, rec in threads.items():
                if not isinstance(rec, dict):
                    continue
                try:
                    _ver = int(rec.get("coverage_schema_version", 1) or 1)
                except Exception:
                    _ver = 1
                if _ver >= 3:
                    continue
                if _ver >= 2:
                    # v4.1.24 (round 6, blocker #6): SCHEMA v3 stage for records the v2
                    # migration already stamped -- their quoted rows may carry only an
                    # EntryID identity. Tag them identity_legacy (their EntryID stays a
                    # local locator, never mistaken for the current message), so a new
                    # vendor message with identical line content is stored as NEW.
                    for _q3 in rec.get("quoted", []) or []:
                        if isinstance(_q3, dict) and not _q3.get("source_message_id") and not _q3.get("identity_legacy"):
                            _q3["identity_legacy"] = True
                            changed = True
                    rec["coverage_schema_version"] = 3
                    changed = True
                    continue
                requested = [r for r in (rec.get("requested", []) or []) if isinstance(r, dict)]
                legacy_map = {}
                _lid_seen = {str(r.get("line_id", "") or "") for r in requested if r.get("line_id")}
                for r in requested:
                    if r.get("line_id"):
                        continue
                    legacy_pk = self.coverage_item_primary_key(dict(r))  # pre-lid key
                    _base = "rl-" + hashlib.sha256(
                        f"{r.get('part_number','')}|{r.get('qty','')}|{r.get('unit','')}|{_coverage_norm(r.get('description',''))}".encode(
                            "utf-8", "ignore")).hexdigest()[:16]
                    _lid = _base
                    _ord = 2
                    while _lid in _lid_seen:
                        _lid = f"{_base}-{_ord}"
                        _ord += 1
                    _lid_seen.add(_lid)
                    r["line_id"] = _lid
                    if legacy_pk:
                        legacy_map.setdefault(legacy_pk, []).append("lid:" + _lid)
                    changed = True
                # translate manual per-item statuses
                st = rec.get("item_status", {})
                if isinstance(st, dict) and st:
                    new_st = {}
                    for k, v in st.items():
                        lids = legacy_map.get(k)
                        if not lids:
                            new_st[k] = v
                        elif len(lids) == 1:
                            new_st[lids[0]] = v
                        else:
                            for _l in lids:
                                new_st[_l] = "check"   # ambiguous shared status -> review
                    if new_st != st:
                        rec["item_status"] = new_st
                        changed = True
                # translate list-keyed state
                for _field, _broadcast_ok in (("manual_done_keys", False),
                                              ("auto_waiting_keys", True),
                                              ("check_keys", True)):
                    lst = rec.get(_field, []) or []
                    if not isinstance(lst, list) or not lst:
                        continue
                    new_lst = []
                    for k in lst:
                        lids = legacy_map.get(k)
                        if not lids:
                            new_lst.append(k)
                        elif len(lids) == 1 or _broadcast_ok:
                            new_lst.extend(lids)
                        else:
                            # ambiguous manual-done -> per-line Check instead of guessing
                            _st2 = rec.setdefault("item_status", {})
                            for _l in lids:
                                _st2.setdefault(_l, "check")
                    new_lst = list(dict.fromkeys(new_lst))
                    if new_lst != lst:
                        rec[_field] = new_lst
                        changed = True
                # stable quote-line ids for legacy quoted rows
                for _qi, q in enumerate(rec.get("quoted", []) or [], start=1):
                    if isinstance(q, dict) and not q.get("quote_line_id"):
                        q["quote_line_id"] = "ql-" + hashlib.sha256(
                            f"legacy|{_tkey}|{_qi}|{q.get('part_number','')}|{q.get('description','')}".encode(
                                "utf-8", "ignore")).hexdigest()[:16]
                        changed = True
                    if isinstance(q, dict) and not q.get("source_message_id") and not q.get("identity_legacy"):
                        q["identity_legacy"] = True  # v4.1.24 schema v3
                        changed = True
                rec["coverage_schema_version"] = 3
                changed = True
            if changed:
                self.save_quote_coverage()
                _cov_debug("COVERAGE MIGRATION: ledgers upgraded to schema v2 (stable line ids)")
            return changed
        except Exception:
            return False

    def _coverage_fold_conversation_into_group(self, conversation_id, gid):
        """v4.1.18 audit: fold any per-conversation ledger for this conversation into the
        group's ledger. The customer-attachment scan can run before a job has a group and
        key its ledger by conversation; when the sent-RFQ hook (or the scan itself, later)
        resolves the group, this fold guarantees ONE ledger per job instead of two
        fragments tracking the same items. Lossless via _merge_coverage_records."""
        try:
            cid = str(conversation_id or "").strip()
            gid = str(gid or "").strip()
            if not cid or not gid or not isinstance(getattr(self, "quote_coverage", None), dict):
                return False
            threads = self.quote_coverage.setdefault("threads", {})
            gkey = "grp:" + gid
            folded = False
            for k in list(threads.keys()):
                r = threads.get(k)
                if (not isinstance(r, dict) or k == gkey or str(k).startswith("grp:")
                        or str(r.get("conversation_id", "") or "").strip() != cid):
                    continue
                if isinstance(threads.get(gkey), dict):
                    self._merge_coverage_records(threads[gkey], r)
                    threads.pop(k, None)
                else:
                    r["group_id"] = gid
                    threads[gkey] = threads.pop(k)
                folded = True
                _cov_debug(f"COVERAGE-FOLD conversation ledger {k!r} -> {gkey!r}")
            if folded:
                self.save_quote_coverage()
            return folded
        except Exception:
            return False

    def get_coverage_record(self, thread_key, create=False):
        if not thread_key:
            return {}
        if not isinstance(getattr(self, "quote_coverage", None), dict):
            self.quote_coverage = {"threads": {}, "updated_at": ""}
        threads = self.quote_coverage.setdefault("threads", {})
        rec = threads.get(thread_key)
        if not isinstance(rec, dict):
            if not create:
                return {}
            rec = {
                "thread_key": thread_key,
                "subject": "",
                "customer": "",
                "customer_email": "",
                "group_id": "",
                "conversation_id": thread_key[5:] if thread_key.startswith("conv:") else "",
                "requested": [],
                "quoted": [],
                "manual_done_keys": [],
                "processed_sent_ids": [],
                "dismissed": False,
                "created_at": datetime.now().isoformat(),
                "updated_at": datetime.now().isoformat(),
            }
            threads[thread_key] = rec
        return rec

    def update_coverage_requested(self, thread_key, materials, subject="", customer="",
                                  customer_email="", group_id="", conversation_id="",
                                  source="rfq_extraction", replace_source=None, source_ref=""):
        """Merge requested line items into the coverage ledger for a thread.

        v3.9.83: pass replace_source="rfq_extraction" (the RFQ-extractor hook does) to
        REPLACE the items previously captured from the extractor rather than appending to
        them. Manually pasted lines use source="manual" and are never touched by that
        replace."""
        try:
            if not thread_key:
                return 0
            # v4.1.26 (round 8, defect #1): keep_duplicates=True. The occurrence-numbered
            # dedupe keys below (v4.1.25) exist precisely so two genuinely identical
            # requested rows ('10 EA 632S' twice in one BOM) both survive -- but this
            # normalize call was still collapsing them BEFORE that logic ever ran, so the
            # occurrence counter never saw the second row. Duplicates are preserved here
            # and the occurrence-suffixed keys handle re-feed idempotency.
            mats = normalize_material_items(materials or [], keep_duplicates=True)
            if not mats:
                return 0
            rec = self.get_coverage_record(thread_key, create=True)
            if subject:
                rec["subject"] = subject
            if customer:
                rec["customer"] = customer
            if customer_email:
                rec["customer_email"] = customer_email
            if group_id:
                rec["group_id"] = group_id
            if conversation_id and not rec.get("conversation_id"):
                rec["conversation_id"] = conversation_id
            existing = rec.setdefault("requested", [])
            # v3.9.83: when re-fed from the RFQ extractor, REPLACE the items previously
            # captured from that extractor instead of appending. save_current_rfq_cache()
            # re-runs this hook on EVERY edit/delete/add in the extractor with the COMPLETE
            # current mat_items, so the old append-only path kept stale copies: editing a
            # line changes its dedupe key, which left the pre-edit line in the ledger AND
            # added the fixed one ("pulling items before and after I fix them"), and deletes
            # in the editor never removed anything ("and then some"). Dropping the prior
            # extractor-sourced set first makes the ledger mirror the extractor exactly.
            # Lines added by hand via "Add to selected request" carry source="manual" and
            # are preserved. (Items from a pre-v3.9.83 ledger were already tagged
            # source="rfq_extraction", so they clear on the next re-feed too.)
            if replace_source:
                existing[:] = [it for it in existing
                               if str((it or {}).get("source", "")) != replace_source]
            # v3.9.24: dedupe requested line items on a SPECIFIC key -- part number when it is
            # a real part, otherwise the full normalized description -- instead of
            # coverage_item_keys(). The latter includes canonical_material_key(), whose coarse
            # "size + trade noun" key collapses genuinely distinct lines: every "thhn cable ..."
            # canonicalizes to "cable", so #12 black, #12 white, #10 green and #10 white were
            # treated as one item and only the first survived. The canonical key is still used
            # for quote<->request matching elsewhere, where that fuzziness is wanted.
            def _requested_dedup_key(it):
                p = re.sub(r"\s+", "", str(it.get("part_number", "") or "").upper())
                if len(p) >= 3:
                    # v4.1.21 (round 3, finding #3) + v4.1.23 (round 5, finding #2): fold
                    # the qty AND the normalized description into the part key so
                    # '10 EA 632S Floor 1' and '10 EA 632S Floor 2' remain SEPARATE
                    # requested lines. The same line re-fed still dedupes exactly.
                    _q = re.sub(r"\s+", "", str(it.get("qty", "") or "").lower())
                    # v4.1.24 (round 6, blocker #4): fold the per-call SOURCE reference in,
                    # so an identical requirement arriving in a DIFFERENT customer message
                    # ("send me another 10 of those") adds coverage instead of vanishing
                    # into the dedupe. Same-source re-feeds still dedupe exactly (the
                    # stored row remembers its own source_ref).
                    _s = str(it.get("source_ref", "") if isinstance(it, dict) and "source_ref" in it else source_ref or "")
                    return "part:" + p[:80] + "|q:" + _q + "|d:" + _coverage_norm(it.get("description", ""))[:80] + "|s:" + _s[-32:]
                # v3.9.53: for a line with no real part number, fold the qty into the key so two
                # genuinely separate request lines for the same product at different quantities
                # (e.g. "163x GANG 3/4 MUDRING" and "53x GANG 3/4 MUDRING") are both tracked
                # instead of collapsing to one. Same product + same qty still de-dupes as before,
                # and lines that share a real part number still de-dupe on the part number above.
                q = re.sub(r"\s+", "", str(it.get("qty", "") or "").lower())
                return "desc:" + q + "|" + _coverage_norm(it.get("description", ""))[:120]
            # v4.1.25 (round 7, blocker #2): occurrence-numbered keys so genuinely
            # repeated identical rows in ONE source both survive; the identical re-feed
            # still dedupes exactly (same content multiset -> same key multiset).
            _ex_ct = {}
            existing_keys = set()
            for r in existing:
                _b = _requested_dedup_key(r)
                _ex_ct[_b] = _ex_ct.get(_b, 0) + 1
                existing_keys.add(f"{_b}|n:{_ex_ct[_b]}")
            _batch_ct = {}
            # v4.1.22 (external audit round 4, finding #4): every requested line gets a
            # STABLE, content-derived line_id at creation. Manual statuses / waiting marks /
            # check flags key off it (see coverage_item_primary_key), so marking one
            # '632S' line can never mark its same-part sibling. Content-derived (not
            # random) so an extractor re-feed of the identical line KEEPS its id -- and
            # therefore keeps any manual status the user already set on it. An ordinal
            # suffix disambiguates truly identical duplicate lines.
            _lid_seen = {str(r.get("line_id", "") or "") for r in existing if isinstance(r, dict)}
            added = 0
            for m in mats:
                _mb = _requested_dedup_key(m)
                _batch_ct[_mb] = _batch_ct.get(_mb, 0) + 1
                mk = f"{_mb}|n:{_batch_ct[_mb]}"
                if mk in existing_keys:
                    continue
                _lid_base = "rl-" + hashlib.sha256(
                    f"{m.get('part_number','')}|{m.get('qty','')}|{m.get('unit','')}|{_coverage_norm(m.get('description',''))}".encode(
                        "utf-8", "ignore")).hexdigest()[:16]
                _lid = _lid_base
                _ord = 2
                while _lid in _lid_seen:
                    _lid = f"{_lid_base}-{_ord}"
                    _ord += 1
                _lid_seen.add(_lid)
                existing.append({
                    "display": material_display_text(m),
                    "qty": m.get("qty", ""),
                    "unit": m.get("unit", ""),
                    "part_number": m.get("part_number", ""),
                    "description": m.get("description", ""),
                    "line_id": _lid,           # v4.1.22: per-line state identity
                    "source_ref": str(source_ref or ""),  # v4.1.24: which message it came from
                    "added_at": datetime.now().isoformat(),
                    "source": source,          # v3.9.83: drives the replace-on-refeed filter
                    "group_id": group_id,      # v3.9.83
                })
                existing_keys.add(mk)
                added += 1
            rec["updated_at"] = datetime.now().isoformat()
            self.save_quote_coverage()
            return added
        except Exception:
            return 0

    def update_coverage_requested_from_rfq(self, group_id, materials, group=None, emails=None):
        """Hook used right after an RFQ is extracted/cached."""
        try:
            emails = emails or []
            conversation_id = ""
            subject = ""
            customer = ""
            customer_email = ""
            for e in emails:
                if not isinstance(e, dict):
                    continue
                if not conversation_id and e.get("conversation_id"):
                    conversation_id = e.get("conversation_id", "")
                if not subject and e.get("subject"):
                    subject = e.get("subject", "")
                if not customer and e.get("sender"):
                    customer = e.get("sender", "")
                if not customer_email and e.get("sender_email"):
                    customer_email = e.get("sender_email", "")
            if not subject and isinstance(group, dict):
                subject = group.get("name", "")
            # v3.9.96: anchor this job's coverage to the GROUP, not the (churning) conversation.
            # One ledger per quote job, keyed grp:<group_id> and named like the group, so the
            # customer RFQ, the vendor RFQs you send, and the vendor replies all feed ONE ledger.
            # Fold any older per-conversation records for this same group into it first, so a
            # re-extract consolidates (and never duplicates) and nothing you've marked is lost.
            group_key = self._coverage_group_key(group_id)
            if group_key:
                self._consolidate_group_coverage(group_id)
                thread_key = group_key
            else:
                thread_key = self.coverage_thread_key(conversation_id, subject)
            if not thread_key:
                return 0
            return self.update_coverage_requested(
                thread_key, materials, subject=subject, customer=customer,
                customer_email=customer_email, group_id=group_id, conversation_id=conversation_id,
                source="rfq_extraction", replace_source="rfq_extraction",  # v3.9.83
            )
        except Exception:
            return 0

    def send_materials_to_quote_coverage(self, materials, parent_window=None,
                                         default_name="", customer="", customer_email=""):
        """v4.1.6: seed Quote Coverage directly from a material list -- used when an
        RFQ is sent outside the normal flow (over the phone, or a request typed
        straight into Outlook) so the job still gets a coverage ledger. Prompts the
        user to create a NEW quote group or pick an EXISTING one, creates the group
        if needed (same shape as create_group), records the items as 'requested'
        (source='manual' so a later RFQ-extractor pass won't wipe them), refreshes
        the group + coverage views, and returns the group_id (or "" if cancelled).
        Fully guarded; safe to call from any window."""
        try:
            # v4.1.26 (round 8, defect #1): preserve identical repeated rows on the way
            # into the coverage ledger; update_coverage_requested's occurrence-numbered
            # keys give each its own line identity.
            mats = normalize_material_items(materials or [], keep_duplicates=True)
            if not mats:
                try:
                    messagebox.showinfo("Quote Coverage", "There are no material rows to send.",
                                        parent=parent_window or self.root)
                except Exception:
                    pass
                return ""
            groups = [g for g in self.groups_data.get("groups", [])
                      if isinstance(g, dict) and not g.get("archived")]
            groups.sort(key=lambda g: str(g.get("name", "")).lower())
            choice = self._prompt_coverage_group_target(groups, default_name, parent_window,
                                                        len(mats))
            if not choice:
                return ""
            if choice[0] == "new":
                name = (choice[1] or "").strip()
                if not name:
                    return ""
                urgency = self.choose_group_urgency("New Quote Group Urgency", initial="Normal") or "Normal"
                group_id = self._unique_group_id()  # v4.1.10: collision-proof
                self.groups_data.setdefault("groups", []).append({
                    "id": group_id, "name": name, "urgency": urgency, "collapsed": False,
                    "has_new": False, "created_at": datetime.now().isoformat(),
                    "notes": "", "archived": False})
                self.save_groups()
                new_group = True
            else:
                group_id = choice[1]
                new_group = False
            group = self.get_group_by_id(group_id)
            group_name = group.get("name", "") if isinstance(group, dict) else ""
            # Anchor to the group ledger, exactly like the RFQ-extractor hook, but
            # source='manual' so these survive a later extractor replace.
            group_key = self._coverage_group_key(group_id)
            if group_key:
                self._consolidate_group_coverage(group_id)
                thread_key = group_key
            else:
                thread_key = self.coverage_thread_key("", group_name)
            n = self.update_coverage_requested(
                thread_key, mats, subject=group_name, customer=customer,
                customer_email=customer_email, group_id=group_id, conversation_id="",
                source="manual", replace_source=None)
            try:
                self.save_quote_coverage()
            except Exception:
                pass
            try:
                self.active_group_filter = "all"
                self.render_group_rows()
            except Exception:
                pass
            try:
                verb = "New quote group" if new_group else "Added to quote group"
                messagebox.showinfo(
                    "Sent to Quote Coverage",
                    f"{verb}: {group_name}\n\n{n} item(s) are now tracked as Waiting in Quote "
                    "Coverage. Open Quote Coverage to see outstanding vs. quoted as vendor "
                    "replies come in.",
                    parent=parent_window or self.root)
            except Exception:
                pass
            return group_id
        except Exception as exc:
            try:
                messagebox.showerror("Quote Coverage", f"Could not send to Quote Coverage:\n{exc}",
                                     parent=parent_window or self.root)
            except Exception:
                pass
            return ""

    def _prompt_coverage_group_target(self, groups, default_name, parent_window, item_count):
        """v4.1.6: modal picker -- returns ('new', name) or ('existing', group_id) or None.
        A radio chooses New vs Existing; New has a name entry (prefilled), Existing has a
        dropdown of current groups."""
        try:
            dlg = tk.Toplevel(parent_window or self.root)
            dlg.title("Send to Quote Coverage")
            dlg.transient(parent_window or self.root)
            dlg.grab_set()
            try:
                apply_theme(dlg)
            except Exception:
                pass
            pad = {"padx": 12, "pady": 6}
            tk.Label(dlg, text=f"Send {item_count} item(s) to Quote Coverage as a Waiting quote job.",
                     font=("Segoe UI", 10, "bold"), justify="left").pack(anchor="w", **pad)
            mode = tk.StringVar(value="new" if not groups else "new")
            result = {"value": None}

            new_frame = tk.Frame(dlg)
            tk.Radiobutton(dlg, text="Create a NEW quote group:", variable=mode, value="new",
                           anchor="w").pack(anchor="w", padx=12)
            new_frame.pack(fill="x", padx=34)
            name_var = tk.StringVar(value=(default_name or "").strip())
            name_entry = tk.Entry(new_frame, textvariable=name_var, width=44)
            name_entry.pack(anchor="w", pady=(0, 4))

            exist_frame = tk.Frame(dlg)
            rb_exist = tk.Radiobutton(dlg, text="Add to an EXISTING quote group:", variable=mode,
                                      value="existing", anchor="w",
                                      state=("normal" if groups else "disabled"))
            rb_exist.pack(anchor="w", padx=12)
            exist_frame.pack(fill="x", padx=34)
            names = [g.get("name", "") for g in groups]
            ids = [g.get("id", "") for g in groups]
            sel_var = tk.StringVar(value=(names[0] if names else ""))
            combo = ttk.Combobox(exist_frame, textvariable=sel_var, values=names,
                                 state=("readonly" if names else "disabled"), width=42)
            combo.pack(anchor="w", pady=(0, 4))

            def _ok():
                if mode.get() == "existing" and names:
                    try:
                        idx = names.index(sel_var.get())
                    except ValueError:
                        idx = 0
                    result["value"] = ("existing", ids[idx])
                else:
                    result["value"] = ("new", name_var.get())
                dlg.destroy()

            def _cancel():
                result["value"] = None
                dlg.destroy()

            btns = tk.Frame(dlg)
            btns.pack(fill="x", **pad)
            tk.Button(btns, text="Cancel", command=_cancel).pack(side="right", padx=4)
            tk.Button(btns, text="Send", command=_ok,
                      font=("Segoe UI", 10, "bold")).pack(side="right", padx=4)
            try:
                name_entry.focus_set()
                dlg.bind("<Return>", lambda e: _ok())
                dlg.bind("<Escape>", lambda e: _cancel())
            except Exception:
                pass
            dlg.wait_window()
            return result["value"]
        except Exception:
            return None

    def _coverage_record_for_quote(self, subject="", body="", attachment_text="", sent_entry_id=""):
        """Find the coverage record a QUOTE covers, for a quote that isn't threaded to the
        original RFQ. Tries (1) subject reference, then (2) strong item match -- mirroring how
        the Waiting/request side links. Returns {} unless the reply looks like a quote (has a
        recognizable price) and is NOT an outgoing request (requests become Waiting and must
        never be recorded as quoted). The item-match path is ambiguity-guarded: if two records
        tie on the most item hits it returns {} rather than risk marking the wrong one quoted.
        attachment_text (PDF/Excel quote text) is included for the price gate and item match so
        a quote whose prices live only in an attachment still links."""
        try:
            # Gate on the NEW reply text only (above the quoted "On ... wrote:" history), so a
            # request quoted back underneath a price reply doesn't make us treat it as a request.
            gate_text = _strip_reply_boilerplate_for_intent(body or "")
            is_req = contains_any_phrase(gate_text.lower(), COVERAGE_OUTGOING_REQUEST_PHRASES)
            has_price = bool(re.search(r"\$\s*\d|\b\d+\.\d{2}\b", gate_text)) \
                or bool(re.search(r"\$\s*\d|\b\d+\.\d{2}\b", attachment_text or ""))
            _cov_debug(f"  LINK gate: is_request={is_req} has_price={has_price} attach_chars={len(attachment_text or '')} gate_text={gate_text[:120]!r}")
            if is_req:
                return {}
            if not has_price:
                return {}
            threads = (getattr(self, "quote_coverage", {}) or {}).get("threads", {})
            recs = [r for r in threads.values()
                    if isinstance(r, dict) and not r.get("dismissed") and r.get("requested")]
            _cov_debug(f"  LINK records available={len(recs)} subjects={[ (r.get('subject') or '')[:40] for r in recs ]}")
            if not recs:
                return {}
            # v4.1.9: group scoping. When the reply email itself belongs to a real group, that
            # group IS its quote job. Link straight to the record bound to that group when one
            # exists, and never let this reply link to a record bound to a DIFFERENT group --
            # that is how a rep's quote for one job (580 Stanley) got attached to another job
            # (MNPW Wiremold) that merely uses the same product family. Records with no group
            # binding stay eligible so legacy jobs keep working.
            reply_gid = ""
            if sent_entry_id:
                try:
                    reply_gid = str(self.get_group_id_for_email(sent_entry_id) or "").strip()
                except Exception:
                    reply_gid = ""
            if reply_gid:
                for rec in recs:
                    if str(rec.get("group_id", "") or "").strip() == reply_gid:
                        _cov_debug(f"  LINK matched by REPLY-GROUP -> {rec.get('subject')!r}")
                        return rec
                recs = [r for r in recs
                        if not str(r.get("group_id", "") or "").strip()
                        or str(r.get("group_id", "")).strip() == reply_gid]
                if not recs:
                    _cov_debug("  LINK: reply belongs to a different group than every record -> no link")
                    return {}
            # (1) subject reference -- most specific.
            msg_subj = self._normalized_thread_subject(subject or "")
            if msg_subj:
                best, best_len = {}, 0
                for rec in recs:
                    rs = self._normalized_thread_subject(rec.get("subject", ""))
                    if rs and len(rs) >= 5 and rs in msg_subj and len(rs) > best_len:
                        best, best_len = rec, len(rs)
                if best:
                    _cov_debug(f"  LINK matched by SUBJECT-REF -> {best.get('subject')!r}")
                    return best
            # (2) strong item match against a single record (>= 2 quoted items matched).
            quoted_items = extract_materials_from_quote_text(_coverage_reply_above_quote(body)) \
                or extract_materials_from_quote_text(body or "")
            if attachment_text:
                quoted_items = list(quoted_items) + extract_materials_from_quote_text(
                    _coverage_reassemble_columnar_quote(attachment_text))
            _cov_debug(f"  LINK item-match: quoted_items={len(quoted_items)} -> {[ (q.get('description') or q.get('part_number') or '')[:30] for q in quoted_items ]}")
            if not quoted_items:
                return {}
            scored = []
            for rec in recs:
                req = rec.get("requested", []) or []
                # v4.1.9: score with the SAME distinctive gate the flip uses, so a link needs
                # evidence that would actually mark something Quoted. The ungated matcher let a
                # quote for a different job link on shared brand/family words alone, and the
                # gated flip then found nothing -- which both mislinked the reply and sprayed
                # Check flags across an unrelated request.
                common = _coverage_record_common_tokens(req)
                hits = sum(1 for qi in quoted_items
                           if any(coverage_items_match(ri, qi)
                                  and _coverage_distinctive_match_ok(ri, qi, common)
                                  for ri in req))
                _cov_debug(f"    vs record {rec.get('subject')!r}: hits={hits} (req items={len(req)})")
                if hits >= 2:
                    scored.append((hits, rec))
            if not scored:
                _cov_debug("  LINK item-match: no record reached >=2 hits -> no link")
                return {}
            scored.sort(key=lambda t: t[0], reverse=True)
            if len(scored) > 1 and scored[0][0] == scored[1][0]:
                _cov_debug("  LINK item-match: AMBIGUOUS tie -> no link")
                return {}   # ambiguous -- two records share the top hit count; don't guess
            _cov_debug(f"  LINK matched by ITEM-MATCH -> {scored[0][1].get('subject')!r} (hits={scored[0][0]})")
            return scored[0][1]
        except Exception as _e:
            _cov_debug(f"  LINK exception: {_e!r}")
            return {}

    def update_coverage_quoted_from_sent(self, conversation_id="", subject="", body="",
                                         sent_entry_id="", sent_on="", attachment_text="",
                                         sender_email="", source_message_id="",
                                         attachment_incomplete=False):
        """Parse a reply for quoted line items and record them against the thread.

        Reads both the email body and, when provided, attachment_text (the text of a
        PDF/Excel/CSV quote) -- so a vendor whose prices are only in an attached PDF still
        flips the matching requested items to Quoted. No-ops unless the thread already has
        requested items recorded, so ordinary correspondence costs nothing. Each message is
        parsed once per thread.
        """
        try:
            # v3.9.96: prefer the GROUP ledger. Resolve this reply to its quote job's group via a
            # grouped member that shares the reply's conversation (e.g. the vendor RFQ tracker),
            # so the quote flips items in the one group ledger instead of a per-conversation
            # fragment. Falls back to the conversation/subject key, then the subject/item-match
            # link below -- so an ungrouped job behaves exactly as it does today.
            grp_id = self._coverage_group_id_for_conversation(conversation_id)
            group_key = self._coverage_group_key(grp_id)
            thread_key = group_key or self.coverage_thread_key(conversation_id, subject)
            rec = self.get_coverage_record(thread_key, create=False) if thread_key else {}
            if group_key and not (rec and rec.get("requested")):
                # group has no ledger yet (not re-extracted) -- try the legacy conversation key.
                thread_key = self.coverage_thread_key(conversation_id, subject)
                rec = self.get_coverage_record(thread_key, create=False) if thread_key else {}
            via = "thread" if (rec and rec.get("requested")) else ""
            _cov_debug(f"QUOTED-FROM-SENT subj={subject!r} conv={conversation_id!r} thread_key={thread_key!r} rec_via_thread={bool(via)} attach_chars={len(attachment_text or '')}")
            if not rec or not rec.get("requested"):
                # v3.9.4: a quote that isn't threaded to the original RFQ -- link by subject
                # reference or strong item match (gated to real quotes, never requests).
                rec = self._coverage_record_for_quote(subject, body, attachment_text,
                                                      sent_entry_id=sent_entry_id)
                via = "subject/item" if (rec and rec.get("requested")) else ""
            if not rec or not rec.get("requested"):
                _cov_debug("  -> NO record linked; nothing marked quoted")
                return 0
            _cov_debug(f"  -> linked via {via} to record subject={rec.get('subject')!r}")
            # v3.9.101: a quote flip must come FROM A VENDOR. The inbound scanner also sees the
            # job's OWN customer replying -- e.g. "I wanted the ASCO 917, not poke-thrus" with your
            # earlier priced poke-thrus quote attached -- and the item-name + any-price match would
            # then flip the customer's requested item to Quoted. When the sender is this record's
            # customer, it is never a vendor quote: skip the flip. Do NOT mark the message processed,
            # so a later genuine vendor quote on the same thread still flips normally.
            if sender_email and rec.get("customer_email"):
                _se = extract_email_address(str(sender_email))
                _ce = extract_email_address(str(rec.get("customer_email", "")))
                _from_customer = bool(_se and _ce and _se == _ce)
                if not _from_customer:
                    # v3.9.102: treat the whole customer COMPANY as the customer, not just the one
                    # contact -- a colleague at the customer (bob@ vs florin@, same domain) is still
                    # not a vendor. In this business a customer domain and a vendor domain are never
                    # the same company, so a same-domain sender is the customer. Guard: a shared
                    # free/public mailbox provider (gmail/outlook/yahoo/...) is NOT a company, so for
                    # those fall back to the exact-address match above (a customer on gmail must not
                    # block a different vendor who also happens to use gmail).
                    _sd = get_email_domain(sender_email)
                    _cd = get_email_domain(rec.get("customer_email", ""))
                    if _sd and _cd and _sd == _cd and _sd not in COVERAGE_PUBLIC_EMAIL_DOMAINS:
                        _from_customer = True
                if _from_customer:
                    _cov_debug(f"  -> message is FROM this job's customer ({_se or sender_email!r}, domain {get_email_domain(sender_email)!r}); not a vendor quote -- skipping flip")
                    return 0
            # v3.9.4 -- note if this sent reply acknowledges we're sourcing/working on it,
            # so the thread's un-quoted items auto-show as "Waiting" rather than Outstanding.
            try:
                if not rec.get("sourcing_ack") and contains_any_phrase(
                        (body or "").lower(), COVERAGE_SOURCING_ACK_PHRASES):
                    rec["sourcing_ack"] = True
            except Exception:
                pass
            processed = rec.setdefault("processed_sent_ids", [])
            # v4.1.23 (round 5, finding #6): the durable Message-ID is the PRIMARY quote
            # identity -- the same vendor quote resurfacing under a new EntryID (moved,
            # restored, other profile) must not be stored and allocated a second time.
            _msg_key = ("imid:" + source_message_id) if source_message_id else ""
            if (_msg_key and _msg_key in processed) or (sent_entry_id and sent_entry_id in processed):
                _cov_debug(f"  -> message already processed for this record; skip (idempotent)")
                return 0
            # Read items from the NEW reply text (above the quoted history) so a partial quote
            # marks only what was actually priced -- not the full item list quoted underneath.
            quoted_items = extract_materials_from_quote_text(_coverage_reply_above_quote(body)) \
                or extract_materials_from_quote_text(body or "")
            if attachment_text:
                quoted_items = list(quoted_items) + extract_materials_from_quote_text(
                    _coverage_reassemble_columnar_quote(attachment_text))
            # v3.9.26: only record line items that actually carry price/quote evidence as
            # "quoted". Email replies quote the original REQUEST beneath the new text, and the
            # reply/quoted-history split is imperfect on wrapped client bodies -- without this
            # gate, unpriced request lines parsed from the history get wrongly recorded as
            # quoted (then auto-flip those items to Quoted on the next inbox scan). Keep only
            # priced lines when any exist; otherwise fall back so a quote that formats prices
            # unusually is not dropped entirely.
            priced_items = [q for q in quoted_items if _coverage_has_quote_price_evidence(q)]
            if priced_items:
                quoted_items = priced_items
            elif attachment_text and not re.search(r"\$\s*\d|\b\d+\.\d{2}\b", attachment_text):
                # v3.9.76: only discard attachment-sourced items when the attachment text carries
                # NO price anywhere -- that signals an RFQ / spec sheet, not a quote. The earlier
                # v3.9.74 guard keyed off per-item price evidence, which wrongly threw away a real
                # PDF quote whose layout the parser reads into part#/description rows without a
                # price column (e.g. an Omni Cable quote): the text has prices, the matched items
                # don't, so those legitimately-quoted items were dropped and coverage never flipped.
                quoted_items = []
            _cov_debug(f"  -> quoted_items extracted={len(quoted_items)} requested_in_record={len(rec.get('requested', []))}")
            # v4.1.26 (round 8, defect #2): identify THIS message's previously stored rows
            # BEFORE the empty-parse early exit. The v4.1.25 replacement model only ran
            # after that exit, so a corrected reparse that now (correctly) yields NOTHING
            # -- an OCR fix revealing the old rows were phantoms, or a message re-read
            # after the vendor recalled the priced attachment -- left the stale rows in
            # place and the items stayed wrongly Quoted forever.
            quoted_list = rec.setdefault("quoted", [])
            _cur_ids = set()
            if source_message_id:
                _cur_ids.add(str(source_message_id))
            if sent_entry_id:
                _cur_ids.add(str(sent_entry_id))
            def _row_from_current_msg(_it):
                if not isinstance(_it, dict):
                    return False
                return (str(_it.get("source_message_id", "") or "") in _cur_ids
                        or str(_it.get("sent_entry_id", "") or "") in _cur_ids) \
                    and bool(str(_it.get("source_message_id", "") or "") or str(_it.get("sent_entry_id", "") or ""))
            _stale = [q0 for q0 in quoted_list if _row_from_current_msg(q0)]
            if not quoted_items:
                # v4.1.27 (external audit round 9, blocker #3): an empty reparse is only
                # AUTHORITATIVE when it is trustworthy. Two failure signatures must never
                # delete stored rows: (a) the attachment extraction was INCOMPLETE (a file
                # failed to save/parse -- the caller passes attachment_incomplete), and
                # (b) the source text still VISIBLY CARRIES PRICES but the parser got
                # nothing out of it -- that is a parser/OCR failure ("OCR FAILED ####"
                # garbage, layout regression), not proof the quote went away. In both
                # cases the stored rows stay and the message stays unprocessed for retry.
                # v4.1.29 (external audit round 11, blocker #1): STRUCTURAL rule replacing
                # the text heuristic the auditor kept (rightly) defeating. The difference
                # between the two text sources is epistemic, not cosmetic:
                #   - msg.Body is the EXACT message text from Outlook -- no extraction
                #     step, no OCR, nothing that can silently fail or partially succeed.
                #   - attachment_text is the OUTPUT OF AN EXTRACTION PIPELINE that can
                #     return failure prose ("No text could be extracted..."), a cover
                #     page while the priced pages silently failed, or any other artifact
                #     no heuristic can reliably distinguish from a real document.
                # Therefore ATTACHMENT-DERIVED TEXT CAN NEVER AUTHORIZE DELETION. An
                # empty reparse deletes stored rows ONLY when this reparse involved NO
                # attachment text at all and the vendor's own typed body -- trustworthy,
                # price-free prose -- is the entire source ("please disregard, item
                # discontinued"). Empty parses that involved attachments keep the stored
                # rows and retry; after the 5-pass giveup they surface in Attachment
                # Review for a human decision. The trust/price gates on the body remain
                # as defense in depth.
                _att_present = bool(str(attachment_text or "").strip())
                _body_txt = str(body or "")
                _src_has_price = bool(re.search(r"\$\s*\d|\b\d+\.\d{2}\b", _body_txt))
                _src_trustworthy = _coverage_reparse_text_trustworthy(_body_txt)
                # v4.1.30 (round 12, finding #2): deletion additionally requires POSITIVE
                # withdrawal intent in the body. A parser returning no rows from a body
                # whose written-out prices ("ten dollars each", "price 10 per each") the
                # price regex also missed must never be read as the vendor retracting the
                # quote -- only the vendor actually SAYING so is.
                _withdrawal_intent = bool(_coverage_withdrawal_intent_detected(
                    _coverage_reply_above_quote(_body_txt) or _body_txt))
                if _stale and _body_txt.strip() and not _att_present \
                        and not attachment_incomplete and not _src_has_price \
                        and _src_trustworthy and _withdrawal_intent:
                    # v4.1.26 (round 8, defect #2): the reparse of a real, non-empty source
                    # produced NO quote rows while rows from this same message are still
                    # stored -- the stored rows are obsolete (misparse / OCR phantom).
                    # The latest parse of a message is authoritative in the replacement
                    # model, including when it is authoritatively EMPTY: remove the stale
                    # rows and mark the message processed so they cannot resurrect.
                    quoted_list[:] = [q0 for q0 in quoted_list if not _row_from_current_msg(q0)]
                    if _msg_key:
                        processed.append(_msg_key)
                    if sent_entry_id:
                        processed.append(sent_entry_id)
                    rec["processed_sent_ids"] = processed[-400:]
                    _cov_debug(f"  -> corrected reparse yields NO quote rows; removed {len(_stale)} stale stored row(s) from this message and marked processed")
                    rec["updated_at"] = datetime.now().isoformat()
                    self.save_quote_coverage()
                    return 0
                if _stale and (_body_txt.strip() or _att_present) \
                        and (_att_present or attachment_incomplete or _src_has_price
                             or not _src_trustworthy or not _withdrawal_intent):
                    _cov_debug(f"  -> empty reparse NOT authoritative (attachments_involved={_att_present}, attachment_incomplete={attachment_incomplete}, body_shows_prices={_src_has_price}, body_trustworthy={_src_trustworthy}, withdrawal_intent={_withdrawal_intent}); keeping {len(_stale)} stored row(s), leaving unprocessed for retry")
                    rec["updated_at"] = datetime.now().isoformat()
                    self.save_quote_coverage()
                    return 0
                # Do NOT mark this EntryID as processed when parsing failed. Vendor replies often
                # vary in format or arrive with attachments; leaving it unprocessed lets later
                # extractor improvements / manual refreshes re-check the same message instead of
                # permanently freezing the coverage row at Waiting. (A genuinely EMPTY source --
                # no body text and no attachment text -- also lands here: there is nothing to be
                # authoritative about, so any stored rows from this message are left alone.)
                _cov_debug("  -> no quoted items parsed from reply; leave unprocessed for future retry")
                rec["updated_at"] = datetime.now().isoformat()
                self.save_quote_coverage()
                return 0
            # v3.9.26: dedupe stored quotes on a SPECIFIC key (part number when real, else the
            # full normalized description) instead of coverage_item_keys(), whose coarse
            # canonical key collapses distinct priced lines that share a size/material (e.g. a
            # 2" coupling and a 2" adapter both keyed '2"'), dropping all but the first.
            # v4.1.24 (external audit round 6, blockers #4 + #5): quote-line identity is
            # CONTENT-BASED per source message -- content fingerprint + occurrence ordinal,
            # never the absolute parser row. Re-parsing the same Message-ID with REORDERED
            # rows (a future parser/OCR improvement) dedupes exactly; genuinely repeated
            # identical rows ('50 EA 632S' twice) both survive and sum. Critically, a
            # STORED row's key uses ITS OWN source ids only -- the v4.1.23 key let the
            # CURRENT call's Message-ID leak into legacy stored rows, so a genuinely new
            # vendor message with identical line content was swallowed as a duplicate.
            # v4.1.25 (external audit round 7, blocker #1): a reprocessed source message
            # REPLACES its stored quote rows -- an OCR correction / parser upgrade /
            # manual rescan removes THAT message's stale rows before storing the fresh
            # parse, so a corrected '50 EA -> 100 EA' can never stack to 150 and an
            # obsolete duplicate row cannot linger. Rows from other messages are
            # untouched; manual overrides live on REQUESTED lines and are unaffected.
            # (v4.1.26: _cur_ids/_row_from_current_msg/_stale are computed ABOVE the
            # empty-parse exit so an authoritatively-empty reparse also replaces.)
            if _stale:
                quoted_list[:] = [q0 for q0 in quoted_list if not _row_from_current_msg(q0)]
                _cov_debug(f"  -> reprocessing this message: replaced {len(_stale)} stale stored quote row(s) with the fresh parse")

            def _q_content_key(it):
                p = re.sub(r"\s+", "", str(it.get("part_number", "") or "").upper())
                base = ("part:" + p[:80]) if len(p) >= 3 else ("desc:" + _coverage_norm(it.get("description", ""))[:120])
                _q = re.sub(r"\s+", "", str(it.get("qty", "") or "").lower())
                _src = str(source_message_id or sent_entry_id or "")
                return f"{base}|q:{_q}|msg:{_src[-40:]}"
            added = 0
            matched_existing = len(_stale)
            _new_ct = {}
            for _qrow, q in enumerate(quoted_items, start=1):
                _ck = _q_content_key(q)
                _new_ct[_ck] = _new_ct.get(_ck, 0) + 1
                # v4.1.22 (finding #1): PRESERVE qty/unit/price plus source identity through
                # the storage boundary -- without these fields the quantity-aware coverage
                # calculation had nothing to compare in the live path.
                quoted_list.append({
                    "display": material_display_text(q),
                    "part_number": q.get("part_number", ""),
                    "description": q.get("description", ""),
                    "qty": str(q.get("qty", "") or ""),
                    "unit": str(q.get("unit", "") or ""),
                    "price": str(q.get("price", q.get("unit_price", "")) or ""),
                    "quoted_at": sent_on or datetime.now().isoformat(),
                    "sent_entry_id": sent_entry_id,
                    "source_message_id": source_message_id,  # v4.1.23: durable identity
                    "source_row": _qrow,                     # metadata only, never identity
                    "vendor_email": str(sender_email or ""),  # v4.1.24: split-source policy
                    "quote_line_id": "ql-" + hashlib.sha256(
                        f"{_ck}|n:{_new_ct[_ck]}".encode("utf-8", "ignore")).hexdigest()[:16],
                    "source": "sent_reply_parse",
                })
                added += 1
            # Only mark processed after a real parse. This prevents one failed / unparseable
            # vendor reply from permanently blocking future coverage updates.
            # v4.1.23: record BOTH identities -- the durable Message-ID key plus the
            # EntryID for back-compat with pre-v4.1.23 ledgers.
            # v4.1.27 (round 9, blocker #4): an INCOMPLETE attachment extraction stores
            # what it did read but never marks the message processed -- the next pass
            # re-attempts the failed file, and the replacement model swaps this message's
            # rows for the fuller parse (no stacking).
            if (sent_entry_id or _msg_key) and (added or matched_existing) and not attachment_incomplete:
                if _msg_key:
                    processed.append(_msg_key)
                if sent_entry_id:
                    processed.append(sent_entry_id)
                rec["processed_sent_ids"] = processed[-400:]
            # v4.1.8: surface a priced vendor reply the matcher could not link. If THIS reply
            # carried priced lines but none matched any requested item, it is most likely a
            # substitute / reformatted quote (e.g. a KRALOY 078424 quoted against a requested
            # IPEX 077433). Flag the still-unquoted items "Check" (orange) with a note of who
            # replied, so the reply is reviewed instead of sitting silently as Waiting. If the
            # reply DID match something, the matcher worked -- nothing is flagged.
            try:
                requested = rec.get("requested", []) or []
                if requested:
                    common = _coverage_record_common_tokens(requested)
                    all_quoted = rec.get("quoted", []) or []
                    istatus = rec.get("item_status", {}) if isinstance(rec.get("item_status"), dict) else {}
                    def _is_quoted(_req):
                        return any(coverage_items_match(_req, _q) and _coverage_distinctive_match_ok(_req, _q, common)
                                   for _q in all_quoted)
                    check_keys = list(rec.get("check_keys", []) or [])
                    # Clear any flag on an item now genuinely quoted or set by the user.
                    if check_keys:
                        _kept = []
                        for _req in requested:
                            _pk = self.coverage_item_primary_key(_req)
                            if _pk and _pk in check_keys and not _is_quoted(_req) and not str(istatus.get(_pk, "") or ""):
                                _kept.append(_pk)
                        check_keys = _kept
                    reply_hit = any(
                        coverage_items_match(_req, _q) and _coverage_distinctive_match_ok(_req, _q, common)
                        for _req in requested for _q in quoted_items)
                    if quoted_items and not reply_hit:
                        # Candidates: items still unquoted and not user-set.
                        cands = []
                        for _req in requested:
                            _pk = self.coverage_item_primary_key(_req)
                            if not _pk or _pk in check_keys:
                                continue
                            if str(istatus.get(_pk, "") or "") or _is_quoted(_req):
                                continue
                            cands.append((_pk, _req))
                        # Prefer items that share a distinctive product word with the reply's
                        # full text (a KRALOY 'Tapered Conduit Plugs' quote lights up the
                        # requested 'Poly Plugs' lines, not the unrelated masks/gloves). If none
                        # share a word, fall back to flagging all so a reply is never missed.
                        reply_words = _coverage_distinctive_nouns(
                            _coverage_norm((body or "") + " " + (attachment_text or "")))
                        targeted = [_pk for _pk, _req in cands
                                    if reply_words & _coverage_distinctive_nouns(_coverage_norm(
                                        _req.get("description", "") if isinstance(_req, dict) else str(_req or "")))]
                        to_flag = targeted or [c[0] for c in cands]
                        for _pk in to_flag:
                            if _pk not in check_keys:
                                check_keys.append(_pk)
                        if to_flag:
                            rec["check_meta"] = {
                                "sender": extract_email_address(sender_email) or str(sender_email or ""),
                                "subject": str(subject or ""),
                                "date": sent_on or datetime.now().isoformat(),
                            }
                            _cov_debug("  -> priced reply matched no requested item; flagged unquoted items CHECK")
                    rec["check_keys"] = check_keys
            except Exception:
                pass
            _cov_debug(f"  -> marked {added} new quoted item(s); record now has {len(quoted_list)} quoted")
            rec["updated_at"] = datetime.now().isoformat()
            self.save_quote_coverage()
            return added
        except Exception as _e:
            _cov_debug(f"  QUOTED-FROM-SENT exception: {_e!r}")
            return 0

    def update_coverage_waiting_from_request(self, subject="", body="", sent_entry_id="", sent_on=""):
        """A sent OUTGOING quote/price-availability REQUEST (an RFQ you sent out) moves the
        matching customer's requested items to 'Waiting'. The request is its own thread, so it
        is linked to a coverage record by EITHER (a) the record's subject being referenced in
        the request subject (e.g. '... - 274870 Quote'), OR (b) the request's line items matching
        the record's requested items. Matched items are stored in auto_waiting_keys -- which sits
        BELOW a real quote and below your manual buttons in compute_coverage_for_record, so it can
        never hide a quote or override a manual status. Conservative + idempotent."""
        try:
            low_body = str(body or "").lower()
            if not contains_any_phrase(low_body, COVERAGE_OUTGOING_REQUEST_PHRASES):
                return 0
            req_subj = self._normalized_thread_subject(subject or "")
            try:
                req_items = extract_materials_from_quote_text(str(body or "")) or []
            except Exception:
                req_items = []
            threads = (getattr(self, "quote_coverage", {}) or {}).get("threads", {})
            changed_total = 0
            for _tkey, rec in threads.items():
                if not isinstance(rec, dict) or rec.get("dismissed"):
                    continue
                requested = rec.get("requested", []) or []
                if not requested:
                    continue
                rec_subj = self._normalized_thread_subject(rec.get("subject", ""))
                # (a) subject reference: the request's subject embeds this record's subject
                subj_link = bool(rec_subj and len(rec_subj) >= 5 and req_subj and rec_subj in req_subj)
                # (b) item link: how many of this record's requested items appear in the request
                matched = []
                if req_items:
                    matched = [req for req in requested
                               if any(coverage_items_match(req, ri) for ri in req_items)]
                strong_item_link = len(matched) >= 2 or (matched and len(matched) == len(requested))
                if not (subj_link or strong_item_link):
                    continue
                # which requested items to flip: the matched ones, or (subject link, items
                # un-parseable) all requested items.
                to_flip = matched if matched else (requested if subj_link else [])
                if not to_flip:
                    continue
                item_status = rec.get("item_status", {}) if isinstance(rec.get("item_status"), dict) else {}
                manual_done = set(rec.get("manual_done_keys", []) or [])
                quoted = rec.get("quoted", []) or []
                auto_wait = rec.setdefault("auto_waiting_keys", [])
                rec_changed = False
                for req in to_flip:
                    pk = self.coverage_item_primary_key(req)
                    if not pk or pk in auto_wait:
                        continue
                    if str(item_status.get(pk, "") or ""):            # explicit manual status wins
                        continue
                    if (coverage_item_keys(req) & manual_done) or any(
                            coverage_items_match(req, q) for q in quoted):   # already quoted
                        continue
                    auto_wait.append(pk)
                    rec_changed = True
                    changed_total += 1
                if rec_changed:
                    rec["updated_at"] = datetime.now().isoformat()
            if changed_total:
                self.save_quote_coverage()
            return changed_total
        except Exception:
            return 0

    def compute_coverage_for_record(self, rec):
        """Return (rows, outstanding_count). Each row has display, status, covered flag.

        Per-item status priority (highest first):
          1. an explicit manual status you set (Quoted/Waiting/Partial/No-bid/Outstanding)
          2. Quoted -- a priced item in your sent reply matches it (auto), or legacy manual-done
          3. Waiting -- you sent a sourcing ack in the thread, OR an outgoing request that
             covers this item (auto)
          4. Outstanding -- default
        Outstanding count = anything not Quoted and not No-bid (Waiting/Partial still need work).
        """
        rows = []
        outstanding = 0
        try:
            requested = rec.get("requested", []) if isinstance(rec, dict) else []
            quoted = rec.get("quoted", []) if isinstance(rec, dict) else []
            manual_done = set(rec.get("manual_done_keys", []) or []) if isinstance(rec, dict) else set()
            item_status = rec.get("item_status", {}) if isinstance(rec, dict) else {}
            if not isinstance(item_status, dict):
                item_status = {}
            sourcing_ack = bool(rec.get("sourcing_ack")) if isinstance(rec, dict) else False
            auto_waiting = set(rec.get("auto_waiting_keys", []) or []) if isinstance(rec, dict) else set()
            # v4.1.8: items flagged for manual review because a priced vendor reply came back
            # on the thread but matched none of the requested items (likely a substitute part).
            check_keys = set(rec.get("check_keys", []) or []) if isinstance(rec, dict) else set()
            # v3.9.57: per-record common-token map for the distinctive-product over-match gate.
            common_tokens = _coverage_record_common_tokens(requested)
            # v4.1.22 (external audit round 4, finding #2): ALLOCATION MODEL. Quoted
            # quantity is a finite resource that gets CONSUMED as it covers requested
            # lines -- one 20 EA quote can no longer independently satisfy both a 10 EA
            # and a 20 EA request for the same part. Each quoted line carries a mutable
            # remaining balance for this calculation; lines without a parseable quantity
            # are single-use full covers (legacy rows / unquantified quotes). Requested
            # lines allocate in ledger order. UOM compatibility (finding #3) is enforced
            # through the canonical layer: only compatible units allocate; a match that
            # exists ONLY in an incompatible unit yields CHECK, never a false Quoted.
            # v4.1.23 (external audit round 5, findings #4 + #5): SCORED, pre-pass
            # allocation. Edges are scored -- exact normalized part number (3), shared
            # catalog/compact code (2), compatible product match (1) -- and quoted
            # quantity is allocated highest-score first, so a generic 'connector' quote
            # can never steal the exact ABC123 quote away from the ABC123 request line.
            # No-quantity rules: an unquantified REQUEST consumes its quote line
            # ENTIRELY (single-use -- two Floor lines can't both go Quoted off one 1 EA
            # quote); when BOTH sides lack a quantity the result is CHECK, not Quoted.
            # Zero-allocated lines are left to Waiting/Outstanding, never Partial.
            _alloc_state = []
            for q in quoted:
                _alloc_state.append({
                    "q": q,
                    "remaining": _coverage_qty_value(q),   # None = unquantified
                    "used": False,
                    "unit": str((q or {}).get("unit", "") or "") if isinstance(q, dict) else "",
                })

            def _edge_score(_req, _q):
                # v4.1.24 (external audit round 6, blocker #2): deeper score levels so
                # an EXACT-DESCRIPTION quote is never stolen by request order -- exact
                # part (5) > exact normalized description (4) > shared catalog code (3)
                # > spec-family agreement (2) > compatible generic (1).
                try:
                    _rpn = re.sub(r"[^A-Z0-9]", "", str((_req or {}).get("part_number", "") or "").upper())
                    _qpn = re.sub(r"[^A-Z0-9]", "", str((_q or {}).get("part_number", "") or "").upper())
                    if len(_rpn) >= 3 and _rpn == _qpn:
                        return 5
                    _rdn = _coverage_norm((_req or {}).get("description", ""))
                    _qdn = _coverage_norm((_q or {}).get("description", ""))
                    if _rdn and _rdn == _qdn:
                        return 4
                    if (_coverage_compact_part_tokens(_req) & _coverage_compact_part_tokens(_q)) \
                            or (_coverage_catalog_tokens(_req) & _coverage_catalog_tokens(_q)):
                        return 3
                    _rf3 = _coverage_spec_families((_req or {}).get("description", ""))
                    _qf3 = _coverage_spec_families((_q or {}).get("description", ""))
                    if any(_rv and _qf3.get(_f) and (_rv & _qf3[_f]) for _f, _rv in _rf3.items()):
                        return 2
                except Exception:
                    pass
                return 1

            _edges = []
            _info = []
            for _ri, req in enumerate(requested):
                _req_unit = str((req or {}).get("unit", "") or "") if isinstance(req, dict) else ""
                _info.append({
                    "need": _coverage_qty_value(req), "alloc": 0.0, "covered": False,
                    "had_compatible": False, "had_incompatible": False, "unknown_pair": False,
                    "unknown_vendor_qty": False,   # v4.1.24 blocker #1
                    "vendor_domains": set(),       # v4.1.24 blocker #11 (split-source)
                    "src_msgs": set(),             # v4.1.25 blocker #8
                    "unknown_vendor_src": False,   # v4.1.25 blocker #8
                })
                for _qi, qs in enumerate(_alloc_state):
                    q = qs["q"]
                    if not coverage_items_match(req, q):
                        continue
                    if not _coverage_distinctive_match_ok(req, q, common_tokens):
                        _cov_debug("COVERAGE GATE blocked over-match: req=%r quoted=%r" % (
                            _coverage_norm(req.get("description", "") if isinstance(req, dict) else str(req)),
                            _coverage_norm(q.get("description", "") if isinstance(q, dict) else str(q))))
                        continue
                    if _coverage_uom_compatible(_req_unit, qs["unit"]):
                        _info[_ri]["had_compatible"] = True
                        _edges.append((-_edge_score(req, q), _ri, _qi))
                    else:
                        _info[_ri]["had_incompatible"] = True
            # v4.1.25 (round 7, blocker #3): CONSTRAINED-FIRST within each score tier --
            # requests with the fewest compatible quotes allocate before flexible ones,
            # so a single-option line is never starved by an earlier multi-option line.
            # (Full bipartite maximum-weight matching deliberately declined: the scored
            # constrained-greedy covers every realistic case at a fraction of the
            # complexity; documented deviation.)
            _req_edge_ct = {}
            for _e in _edges:
                _req_edge_ct[_e[1]] = _req_edge_ct.get(_e[1], 0) + 1
            _edges.sort(key=lambda _e: (_e[0], _req_edge_ct.get(_e[1], 0), _e[1], _e[2]))
            # v4.1.28 (external audit round 10, blocker #2): allocation LOTS are recorded
            # per quote line so the augmenting pass below can RELOCATE them. Only
            # quantified-request/quantified-quote allocations are movable; unquantified
            # consumption keeps its v4.1.23 single-use semantics untouched.
            _alloc_recs = {}
            for _negscore, _ri, _qi in _edges:
                inf = _info[_ri]
                qs = _alloc_state[_qi]
                if inf["covered"] or (inf["need"] is not None and inf["need"] <= 0 and inf["alloc"] > 0):
                    continue
                if inf["need"] is None:
                    # Unquantified request: consume ONE quote line entirely (single-use).
                    if qs["used"]:
                        continue
                    if qs["remaining"] is None:
                        # Both sides unknown: flag for CHECK; do not consume the line.
                        inf["unknown_pair"] = True
                        continue
                    if qs["remaining"] <= 0:
                        continue
                    inf["alloc"] += qs["remaining"]
                    qs["remaining"] = 0
                    qs["used"] = True
                    inf["covered"] = True
                    _vd = get_email_domain(str((qs["q"] or {}).get("vendor_email", "") if isinstance(qs["q"], dict) else ""))
                    if _vd:
                        inf["vendor_domains"].add(str(_vd).lower())
                    else:
                        inf["unknown_vendor_src"] = True
                    _qd0 = qs["q"] if isinstance(qs["q"], dict) else {}
                    inf["src_msgs"].add(str(_qd0.get("source_message_id", "") or _qd0.get("sent_entry_id", "") or "legacy-source"))
                else:
                    _need_now = inf["need"] - inf["alloc"]
                    if _need_now <= 0:
                        inf["covered"] = True
                        continue
                    if qs["remaining"] is None:
                        if qs["used"]:
                            continue
                        # v4.1.24 (external audit round 6, blocker #1): a quote whose
                        # quantity the PARSER could not read must not fully cover a KNOWN
                        # requested quantity -- missing usually means unread, not "the
                        # whole amount". New-format rows (they always carry a 'qty' field,
                        # empty when unparsed) flag CHECK for user confirmation. Only
                        # true LEGACY rows (no qty field at all, stored before v4.1.22)
                        # keep the single-use full-cover behavior, so existing ledgers do
                        # not flood with alarms.
                        # v4.1.25 (round 7, blocker #6): LEGACY rows lose the full-cover
                        # exemption too -- an unknown vendor quantity never silently closes
                        # a quantified requirement, old or new. Confirm each once; the
                        # manual per-line status then sticks permanently.
                        inf["unknown_vendor_qty"] = True
                        continue
                    elif qs["remaining"] > 0:
                        take = min(qs["remaining"], _need_now)
                        qs["remaining"] -= take
                        inf["alloc"] += take
                        # v4.1.28: vendor/source bookkeeping for quantified allocations is
                        # rebuilt AFTER the augmenting pass (lots can move); see below.
                        _alloc_recs.setdefault(_qi, []).append([_ri, take])
                        if inf["alloc"] >= inf["need"]:
                            inf["covered"] = True

            # v4.1.28 (external audit round 10, blocker #2): AUGMENTING REALLOCATION.
            # Scored greedy can strand a request whose only compatible quote was taken
            # by a line that had OTHER options (auditor's ABC123 case: exact-part edge
            # wins first, the code-match line starves even though a complete assignment
            # exists). For every starved quantified request, walk Kuhn-style augmenting
            # chains: relocate an existing allocation lot from the needed quote onto
            # another compatible quote (recursively), then give the freed capacity to
            # the starved line. Every edge used here already passed the full match +
            # distinctive + UOM gates, so any relocation target is a legitimate cover --
            # completeness is improved without ever loosening match safety. Unquantified
            # consumption (single-use lines) is never touched.
            try:
                _adj = {}
                for _negscore0, _ri0, _qi0 in _edges:   # already sorted best-score-first
                    _adj.setdefault(_ri0, []).append(_qi0)

                def _free_units(_qi_f, _amt_f, _visited):
                    """Raise quote _qi_f's remaining to >= _amt_f by relocating its
                    allocation lots onto other compatible quotes (recursive).
                    v4.1.29 (round 11, blocker #2): lots now SPLIT -- only the units
                    actually needed move, and they can move to a quote with less free
                    capacity than the whole lot. Combined with the deficit-aware caller
                    below, this is Ford-Fulkerson-style augmentation over integral lots:
                    if a rearrangement of allocations can cover a line, it is found."""
                    qs_f = _alloc_state[_qi_f]
                    if qs_f["remaining"] is None or qs_f.get("used"):
                        return False
                    if qs_f["remaining"] >= _amt_f:
                        return True
                    if _qi_f in _visited:
                        return False
                    _visited.add(_qi_f)
                    for _rec in list(_alloc_recs.get(_qi_f, [])):
                        _rj, _amt_j = _rec[0], _rec[1]
                        if _amt_j <= 0:
                            continue
                        _need_more = _amt_f - qs_f["remaining"]
                        if _need_more <= 0:
                            break
                        _mv = min(_amt_j, _need_more)
                        # v4.1.30 (external audit round 12, finding #3): the moved units
                        # may SPLIT ACROSS MULTIPLE destination quotes -- the v4.1.29 pass
                        # required one alternative to absorb the whole move, so a 2-unit
                        # lot could not relocate onto two 1-unit quotes (auditor's repro).
                        # Each destination now takes what it can (recursively freeing more
                        # when it is itself occupied) until the move is complete. This is
                        # per-edge flow pushing: the augmentation explores every feasible
                        # rearrangement of quantified lots the compatibility graph allows.
                        for _qk in _adj.get(_rj, []):
                            if _mv <= 0:
                                break
                            if _qk == _qi_f:
                                continue
                            qs_k = _alloc_state[_qk]
                            if qs_k["remaining"] is None or qs_k.get("used"):
                                continue
                            if qs_k["remaining"] < _mv:
                                _free_units(_qk, _mv, _visited)   # best effort: deepen
                            _fit = min(_mv, qs_k["remaining"])
                            if _fit <= 0:
                                continue
                            qs_k["remaining"] -= _fit
                            qs_f["remaining"] += _fit
                            _rec[1] -= _fit
                            _mv -= _fit
                            _alloc_recs.setdefault(_qk, []).append([_rj, _fit])
                            _cov_debug("COVERAGE AUGMENT: moved %s unit(s) of request #%d from quote #%d to quote #%d" % (
                                _fit, _rj, _qi_f, _qk))
                    return qs_f["remaining"] >= _amt_f

                for _ri0 in range(len(requested)):
                    inf0 = _info[_ri0]
                    # v4.1.29 (round 11, blocker #2): PARTIALLY covered requests are
                    # repaired too -- the v4.1.28 pass only rescued zero-allocation
                    # lines, so a line at 1-of-2 stayed Partial although relocating an
                    # existing lot could complete it (auditor's 2-EA repro).
                    if inf0["covered"] or inf0["need"] is None or not inf0["had_compatible"]:
                        continue
                    _need0 = inf0["need"]
                    if not isinstance(_need0, (int, float)) or _need0 <= 0:
                        continue
                    _deficit = _need0 - inf0["alloc"]
                    if _deficit <= 0:
                        inf0["covered"] = True
                        continue
                    for _qi0 in _adj.get(_ri0, []):
                        if _deficit <= 0:
                            break
                        qs0 = _alloc_state[_qi0]
                        if qs0["remaining"] is None or qs0.get("used"):
                            continue
                        if qs0["remaining"] < _deficit:
                            _free_units(_qi0, _deficit, set())
                        take0 = min(qs0["remaining"], _deficit)
                        if take0 <= 0:
                            continue
                        qs0["remaining"] -= take0
                        inf0["alloc"] += take0
                        _deficit -= take0
                        _alloc_recs.setdefault(_qi0, []).append([_ri0, take0])
                    if inf0["alloc"] >= _need0:
                        inf0["covered"] = True
            except Exception:
                pass   # augmentation is best-effort; greedy result stands if it fails

            # v4.1.28: rebuild vendor/source bookkeeping for QUANTIFIED allocations from
            # the final lot map (lots may have moved during augmentation). Unquantified
            # consumption recorded its vendor/source inline above and is untouched.
            try:
                for _qi0, _recs0 in _alloc_recs.items():
                    _qd0 = _alloc_state[_qi0]["q"] if isinstance(_alloc_state[_qi0]["q"], dict) else {}
                    _vd0 = get_email_domain(str(_qd0.get("vendor_email", "") or ""))
                    _src0 = str(_qd0.get("source_message_id", "") or _qd0.get("sent_entry_id", "") or "legacy-source")
                    for _rj0, _amt_j0 in _recs0:
                        if _amt_j0 <= 0:
                            continue
                        if _vd0:
                            _info[_rj0]["vendor_domains"].add(str(_vd0).lower())
                        else:
                            _info[_rj0]["unknown_vendor_src"] = True
                        _info[_rj0]["src_msgs"].add(_src0)
            except Exception:
                pass

            for _ri, req in enumerate(requested):
                req_keys = coverage_item_keys(req)
                pk = self.coverage_item_primary_key(req)
                manual = str(item_status.get(pk, "") or "").lower()
                # Manual/legacy done-marks: honor both the key set and the primary key
                # (new line_id-based marks land as 'lid:...', which coverage_item_keys
                # does not emit).
                matched_quote = bool(req_keys & manual_done) or (pk and pk in manual_done)
                inf = _info[_ri]
                _req_qty = inf["need"]
                _alloc_total = inf["alloc"]
                _qty_shortfall = False
                _uom_conflict = False
                if not matched_quote:
                    if inf["covered"] and len(inf.get("src_msgs") or ()) >= 2 and inf.get("unknown_vendor_src"):
                        # v4.1.25 (round 7, blocker #8): coverage combined from multiple
                        # source messages whose vendor identity could not be resolved --
                        # surface CHECK instead of silently assuming one vendor.
                        matched_quote = True
                        _uom_conflict = True
                        _cov_debug("COVERAGE SPLIT-SOURCE (unidentified): %d source messages cover %r -> Check" % (
                            len(inf["src_msgs"]),
                            _coverage_norm(req.get("description", "") if isinstance(req, dict) else str(req))))
                    elif inf["covered"] and len(inf.get("vendor_domains") or ()) >= 2:
                        # v4.1.24 (round 6, blocker #11): coverage assembled from 2+
                        # DISTINCT vendor domains is split sourcing -- surface CHECK
                        # ("split coverage available") for the user to approve, never a
                        # silent auto-Quoted. Single-vendor multi-line sums still close.
                        matched_quote = True
                        _uom_conflict = True  # renders as CHECK below
                        _cov_debug("COVERAGE SPLIT-SOURCE: %d vendor domains cover %r -> Check" % (
                            len(inf["vendor_domains"]),
                            _coverage_norm(req.get("description", "") if isinstance(req, dict) else str(req))))
                    elif inf["covered"]:
                        matched_quote = True
                    elif inf.get("unknown_vendor_qty") and inf["alloc"] <= 0:
                        # v4.1.24 (round 6, blocker #1): vendor quantity not detected.
                        matched_quote = True
                        _uom_conflict = True  # renders as CHECK below
                    elif inf["unknown_pair"]:
                        matched_quote = True
                        _uom_conflict = True  # renders as CHECK below
                    elif _alloc_total > 0:
                        matched_quote = True
                        _qty_shortfall = True
                        _cov_debug("COVERAGE QTY shortfall: requested %s, allocated %s for %r" % (
                            _req_qty, _alloc_total,
                            _coverage_norm(req.get("description", "") if isinstance(req, dict) else str(req))))
                    elif inf["had_incompatible"] and not inf["had_compatible"]:
                        matched_quote = True
                        _uom_conflict = True
                    # zero allocated with compatible matches: quoted quantity consumed by
                    # stronger/earlier lines -> stays un-matched (Waiting/Outstanding).
                covered = False
                covered_by = ""
                if manual in ("quoted", "waiting", "partial", "no_bid", "outstanding"):
                    status = manual
                    if manual == "quoted":
                        covered, covered_by = True, "manual"
                elif matched_quote and _uom_conflict:
                    status = "check"
                elif matched_quote and _qty_shortfall:
                    status = "partial"
                elif matched_quote:
                    status, covered, covered_by = "quoted", True, "quoted"
                elif pk in check_keys:
                    status = "check"
                elif sourcing_ack or (pk in auto_waiting):
                    status = "waiting"
                else:
                    status = "outstanding"
                if status not in ("quoted", "no_bid"):
                    outstanding += 1
                rows.append({
                    "display": req.get("display", "") or material_display_text(req),
                    "status": status,
                    "covered": covered,
                    "covered_by": covered_by,
                    "req": req,
                    # v4.1.22: allocation detail so the UI can explain a Partial.
                    "requested_qty": _req_qty,
                    "allocated_qty": round(_alloc_total, 4) if _alloc_total else 0,
                })
        except Exception:
            pass
        return rows, outstanding

    def coverage_set_item_status(self, thread_key, item_key, status):
        """Set a manual per-item coverage status that overrides auto-detection.
        'outstanding' forces Outstanding even if a sourcing ack would auto-set Waiting.
        Kept in sync with the legacy manual_done_keys list so older readers still agree."""
        rec = self.get_coverage_record(thread_key, create=False)
        if not rec or not item_key:
            return
        status = str(status or "").lower()
        if status not in ("quoted", "waiting", "partial", "no_bid", "outstanding"):
            return
        item_status = rec.setdefault("item_status", {})
        if not isinstance(item_status, dict):
            item_status = rec["item_status"] = {}
        item_status[item_key] = status
        # v4.1.8: setting a status is a review decision -- clear the Check flag on this item.
        if rec.get("check_keys"):
            rec["check_keys"] = [k for k in rec.get("check_keys", []) if k != item_key]
        done_keys = rec.setdefault("manual_done_keys", [])
        if status == "quoted":
            if item_key not in done_keys:
                done_keys.append(item_key)
        else:
            rec["manual_done_keys"] = [k for k in done_keys if k != item_key]
        rec["updated_at"] = datetime.now().isoformat()
        self.save_quote_coverage()

    def coverage_requote_items(self, thread_key, item_keys):
        """Re-quote items: clear their sticky manual status + the old matched quote so they leave
        'Quoted', then mark them Waiting via the auto (non-sticky) path so a fresh vendor reply
        still auto-flips them back to Quoted. The already-processed reply id is left in place so a
        rejected quote won't silently reappear -- only a NEW reply re-flips the item."""
        rec = self.get_coverage_record(thread_key, create=False)
        if not rec:
            return 0
        keyset = set(k for k in (item_keys or []) if k)
        if not keyset:
            return 0
        requested = rec.get("requested", []) or []
        targets = [r for r in requested if self.coverage_item_primary_key(r) in keyset]
        item_status = rec.get("item_status", {})
        if isinstance(item_status, dict):
            for k in list(keyset):
                item_status.pop(k, None)
        rec["manual_done_keys"] = [k for k in (rec.get("manual_done_keys", []) or []) if k not in keyset]
        quoted = rec.get("quoted", []) or []
        if targets:
            rec["quoted"] = [q for q in quoted if not any(coverage_items_match(t, q) for t in targets)]
        aw = rec.setdefault("auto_waiting_keys", [])
        if not isinstance(aw, list):
            aw = rec["auto_waiting_keys"] = []
        for k in keyset:
            if k not in aw:
                aw.append(k)
        rec["updated_at"] = datetime.now().isoformat()
        self.save_quote_coverage()
        return len(keyset)

    def coverage_item_primary_key(self, item):
        # v4.1.22 (external audit round 4, finding #4): a line's OWN stable id wins --
        # manual statuses, waiting marks, check flags, and requotes become truly per-line
        # (part-only keys made one 632S line's status bleed onto its same-part sibling).
        # Records created before v4.1.22 have no line_id and keep the legacy key chain,
        # so their previously saved statuses still resolve exactly as before.
        try:
            _lid = str((item or {}).get("line_id", "") or "") if isinstance(item, dict) else ""
            if _lid:
                return "lid:" + _lid
        except Exception:
            pass
        keys = sorted(coverage_item_keys(item))
        for k in keys:
            if k.startswith("part:"):
                return k
        # v3.9.83: prefer the DESCRIPTION key (unique per requested line) over the coarse
        # canonical key. canonical_material_key() deliberately collapses every same-trade
        # line to one token -- all "#4AWG ... Wire <color>" lines key to "wire", a 2" coupling
        # and a 2" adapter both key to '2"' -- so item_status / auto_waiting / manual_done were
        # all stored under a SHARED key. That made the Quote Coverage window apply one line's
        # status to every sibling line: selecting a single item and clicking "Set selected"
        # (Quoted/Waiting/etc.) bled onto all of them. The desc key is stable per line yet
        # distinct across lines, so per-item status becomes truly per-item. Quote<->request
        # MATCHING is unaffected: it uses the full key SET via coverage_items_match(), never
        # this single primary key.
        for k in keys:
            if k.startswith("desc:"):
                return k
        for k in keys:
            if not k.startswith("desc:"):
                return k
        return keys[0] if keys else ""

    def coverage_active_threads(self):
        """Threads with >=1 requested item that are not dismissed, outstanding-first."""
        out = []
        try:
            threads = (getattr(self, "quote_coverage", {}) or {}).get("threads", {})
            # v3.9.105: loop var renamed from "tk" -- it shadowed the tkinter import
            # inside this method, a landmine for any future edit that touches Tk here.
            for t_key, rec in threads.items():
                if not isinstance(rec, dict) or rec.get("dismissed"):
                    continue
                if not rec.get("requested"):
                    continue
                rows, outstanding = self.compute_coverage_for_record(rec)
                out.append({
                    "thread_key": t_key,
                    "rec": rec,
                    "rows": rows,
                    "outstanding": outstanding,
                    "requested_count": len(rows),
                    "updated_at": rec.get("updated_at", ""),
                })
            out.sort(key=lambda r: (r["outstanding"] > 0, r.get("updated_at", "")), reverse=True)
        except Exception:
            pass
        return out

    def coverage_outstanding_summary(self, threads=None):
        # v4.1.34: callers that already computed the pass hand it in; no-arg callers
        # keep the previous behavior exactly.
        if threads is None:
            threads = self.coverage_active_threads()
        thread_ct = sum(1 for t in threads if t["outstanding"] > 0)
        item_ct = sum(t["outstanding"] for t in threads)
        return thread_ct, item_ct

    def update_coverage_status_label(self, precomputed_threads=None):
        try:
            if not hasattr(self, "coverage_status_var"):
                return
            thread_ct, item_ct = self.coverage_outstanding_summary(threads=precomputed_threads)  # v4.1.34
            # v4.1.22 (external audit round 4, finding #9): exhausted attachment failures
            # must be operationally VISIBLE, not just a buried data record.
            _review_ct = 0
            try:
                _arn = (getattr(self, "quote_coverage", {}) or {}).get("attachment_review_needed", [])
                _review_ct = len(_arn) if isinstance(_arn, list) else 0
            except Exception:
                _review_ct = 0
            _review_note = f" | {_review_ct} attachment(s) need review (Quote Coverage → Attachment review)" if _review_ct else ""
            try:
                _sh = (getattr(self, "quote_coverage", {}) or {}).get("scan_health", [])
                if isinstance(_sh, list) and _sh:
                    _latest = _sh[-1]
                    _when = str((_latest or {}).get("at", ""))[:10]
                    _review_note += f" | scan notice ({_when}): see Full Update summary"
            except Exception:
                pass
            if item_ct > 0:
                self.coverage_status_var.set(
                    f"Quote coverage: {item_ct} item(s) need quotes in {thread_ct} thread(s)" + _review_note)
            else:
                self.coverage_status_var.set("Quote coverage: all requested items quoted" + _review_note)
        except Exception:
            pass

    def coverage_toggle_item_done(self, thread_key, item_key, done=True):
        rec = self.get_coverage_record(thread_key, create=False)
        if not rec or not item_key:
            return
        done_keys = rec.setdefault("manual_done_keys", [])
        if done:
            if item_key not in done_keys:
                done_keys.append(item_key)
        else:
            rec["manual_done_keys"] = [k for k in done_keys if k != item_key]
        rec["updated_at"] = datetime.now().isoformat()
        self.save_quote_coverage()

    def coverage_add_requested_lines(self, thread_key, lines_text, subject="", customer=""):
        """Manually add requested items from pasted text (one per line)."""
        # v4.1.26 (round 8, defect #1): a user pasting the same line twice means two
        # requirements -- keep duplicates all the way into the ledger.
        mats = extract_materials_from_quote_text(lines_text or "", keep_duplicates=True)
        if not mats:
            mats = []
            for ln in (lines_text or "").splitlines():
                ln = ln.strip(" -\u2022*\t")
                if ln:
                    q, u, d = split_qty_unit_description(ln)
                    mats.append({"qty": q, "unit": u, "part_number": "",
                                 "description": d or ln, "selected": True})
            mats = normalize_material_items(mats, keep_duplicates=True)
        return self.update_coverage_requested(thread_key, mats, subject=subject, customer=customer,
                                              source="manual")  # v3.9.83: survives RFQ re-feeds

    def coverage_dismiss_thread(self, thread_key, dismissed=True):
        rec = self.get_coverage_record(thread_key, create=False)
        if not rec:
            return
        rec["dismissed"] = bool(dismissed)
        rec["updated_at"] = datetime.now().isoformat()
        self.save_quote_coverage()

    def open_attachment_review_window(self, parent=None):
        """v4.1.26 (external audit round 8): Attachment Review as an actionable WORK
        QUEUE, not a buried data record. Every message whose attachments the coverage
        scan could not read (save failures after 5 passes, oversized/cap-skipped
        material) is listed with WHY it needs review, and can be opened in Outlook,
        retried by the scanner (its processed/negative/retry checkpoints are purged so
        the next pass genuinely re-attempts it), marked resolved, or permanently
        ignored (recorded with the reason so 'ignored' stays auditable)."""
        if not isinstance(getattr(self, "quote_coverage", None), dict):
            return
        win = tk.Toplevel(parent or self.root)
        win.title("MaINbox — Attachment Review (coverage scan work queue)")
        remember_window_geometry(win, "MaINbox Attachment Review", "980x480")
        try:
            apply_theme(win)
        except Exception:
            pass
        win.configure(bg=_BG)

        header = tk.Frame(win, bg=_BG2)
        header.pack(fill="x")
        tk.Label(header, text="Attachment Review", font=("Segoe UI", 13, "bold"),
                 fg=_FG, bg=_BG2).pack(side="left", padx=12, pady=8)
        count_var = tk.StringVar(value="")
        tk.Label(header, textvariable=count_var, font=("Segoe UI", 10),
                 fg=_ACCENT, bg=_BG2).pack(side="left", padx=8)

        wrap = tk.Frame(win, bg=_BG)
        wrap.pack(fill="both", expand=True, padx=8, pady=6)
        tree = ttk.Treeview(wrap, columns=("when", "sender", "subject", "reason"),
                            show="headings", selectmode="extended")
        for c, l, w in [("when", "When", 130), ("sender", "From", 170),
                        ("subject", "Subject", 300), ("reason", "Why it needs review", 330)]:
            tree.heading(c, text=l)
            tree.column(c, width=w, anchor="w")
        tree.pack(side="left", fill="both", expand=True)
        sb = ttk.Scrollbar(wrap, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y")

        def _queue():
            q = self.quote_coverage.setdefault("attachment_review_needed", [])
            if not isinstance(q, list):
                q = self.quote_coverage["attachment_review_needed"] = []
            return q

        def reload_rows():
            tree.delete(*tree.get_children())
            q = _queue()
            for i, ent in enumerate(q):
                if not isinstance(ent, dict):
                    continue
                tree.insert("", "end", iid=f"arn:{i}", values=(
                    str(ent.get("at", ""))[:16].replace("T", " "),
                    str(ent.get("sender", ""))[:60],
                    str(ent.get("subject", ""))[:120],
                    str(ent.get("reason", ""))[:160] + (f"  (attempts: {ent.get('attempts')})" if ent.get("attempts") else ""),
                ))
            count_var.set(f"{len([e for e in q if isinstance(e, dict)])} message(s) waiting")
            try:
                self.update_coverage_status_label()
            except Exception:
                pass

        def selected_entries():
            q = _queue()
            out = []
            for iid in tree.selection():
                try:
                    idx = int(str(iid).split(":", 1)[1])
                except Exception:
                    continue
                if 0 <= idx < len(q) and isinstance(q[idx], dict):
                    out.append(q[idx])
            return out

        def open_email():
            ents = selected_entries()
            if not ents:
                messagebox.showinfo("Attachment Review", "Select a message first.", parent=win)
                return
            ent = ents[0]
            eid = str(ent.get("entry_id", "") or "")
            opened = False
            ns = None
            try:
                ns = getattr(self, "namespace", None)
                if ns is None:
                    _o, ns = self.fresh_outlook()
            except Exception:
                ns = None
            if eid and ns:
                try:
                    it = ns.GetItemFromID(eid)
                    if it:
                        it.Display()
                        opened = True
                except Exception:
                    opened = False
            # v4.1.27 (round 9, secondary): EntryIDs change on move/restore/other-profile.
            # Fall back to the DURABLE Internet Message-ID and search the scan folders.
            if not opened and ns is not None:
                imid = str(ent.get("internet_message_id", "") or "").replace("imid:", "", 1).strip()
                if imid:
                    try:
                        _q = imid.replace("'", "''")
                        for _lbl, _folder in (self.coverage_inbox_folders_for_quote_scan(ns) or []):
                            try:
                                _found = _folder.Items.Restrict(
                                    "@SQL=\"http://schemas.microsoft.com/mapi/proptag/0x1035001E\" = '" + _q + "'")
                                _hit = _found.GetFirst()
                                if _hit is not None:
                                    _hit.Display()
                                    opened = True
                                    break
                            except Exception:
                                continue
                    except Exception:
                        pass
            if not opened:
                messagebox.showwarning(
                    "Attachment Review",
                    "Couldn't open that email in Outlook — not found by EntryID or Message-ID "
                    "(it may have been deleted or moved outside the scanned folders).", parent=win)

        def _purge_checkpoints(ent):
            """Remove every scanner checkpoint for this message so the next pass
            genuinely re-attempts it from scratch."""
            eid = str(ent.get("entry_id", "") or "")
            imid = str(ent.get("internet_message_id", "") or "")
            imid_key = ("imid:" + imid) if imid and not imid.startswith("imid:") else imid
            drop = {k for k in (eid, imid_key) if k}
            try:
                pl = self.quote_coverage.setdefault("processed_customer_request_ids", [])
                if isinstance(pl, list) and drop:
                    pl[:] = [x for x in pl if str(x) not in drop]
            except Exception:
                pass
            for _ledger in ("request_scan_retry_counts", "request_scan_savefail_counts",
                            "request_scan_negative",
                            "quote_scan_negative", "quote_scan_attach_retry"):  # v4.1.27
                try:
                    d = self.quote_coverage.get(_ledger)
                    if isinstance(d, dict) and eid:
                        d.pop(eid, None)
                except Exception:
                    pass

        def _remove_entries(ents):
            q = _queue()
            idset = {id(e) for e in ents}
            q[:] = [e for e in q if id(e) not in idset]

        def retry_selected():
            ents = selected_entries()
            if not ents:
                messagebox.showinfo("Attachment Review", "Select the message(s) to retry first.", parent=win)
                return
            for ent in ents:
                _purge_checkpoints(ent)
            _remove_entries(ents)
            self.save_quote_coverage()
            reload_rows()
            messagebox.showinfo(
                "Attachment Review",
                f"{len(ents)} message(s) re-queued. The next coverage scan (refresh / Full Update) "
                "will re-attempt their attachments from scratch.", parent=win)

        def resolve_selected():
            ents = selected_entries()
            if not ents:
                messagebox.showinfo("Attachment Review", "Select the message(s) to mark resolved first.", parent=win)
                return
            _remove_entries(ents)
            self.save_quote_coverage()
            reload_rows()

        def ignore_selected():
            ents = selected_entries()
            if not ents:
                messagebox.showinfo("Attachment Review", "Select the message(s) to ignore first.", parent=win)
                return
            if not messagebox.askyesno(
                    "Attachment Review",
                    f"Permanently ignore {len(ents)} message(s)? The scanner will never revisit them "
                    "and they leave this queue. (The decision is recorded, so it stays auditable.)",
                    parent=win):
                return
            # v4.1.27 (round 9, secondary): a permanent ignore records WHO and WHY, not
            # just when -- 'ignored' must stay explainable months later.
            try:
                from tkinter import simpledialog
                _why = simpledialog.askstring(
                    "Attachment Review",
                    "Why are these being ignored? (optional, recorded with the decision)",
                    parent=win) or ""
            except Exception:
                _why = ""
            try:
                import getpass
                _who = getpass.getuser() or ""
            except Exception:
                _who = str(os.environ.get("USERNAME", "") or "")
            ign = self.quote_coverage.setdefault("attachment_review_ignored", [])
            if not isinstance(ign, list):
                ign = self.quote_coverage["attachment_review_ignored"] = []
            for ent in ents:
                rec = dict(ent)
                rec["ignored_at"] = datetime.now().isoformat()
                rec["ignored_by"] = _who
                rec["ignored_reason"] = _why.strip()[:400]
                ign.append(rec)
            if len(ign) > 1000:
                del ign[:len(ign) - 1000]
            _remove_entries(ents)
            self.save_quote_coverage()
            reload_rows()

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=8, pady=(0, 8))
        tk.Button(btns, text="Open email", command=open_email,
                  bg=_ACCENT, fg="#ffffff", activebackground=_ACCENT2, activeforeground="#ffffff",
                  relief="flat", padx=12, pady=3, cursor="hand2",
                  font=("Segoe UI", _FONT_SIZE, "bold")).pack(side="left", padx=3)
        tk.Button(btns, text="Retry on next scan", command=retry_selected).pack(side="left", padx=3)
        tk.Button(btns, text="Mark resolved", command=resolve_selected).pack(side="left", padx=3)
        tk.Button(btns, text="Ignore permanently", command=ignore_selected).pack(side="left", padx=3)
        tk.Button(btns, text="↻ Refresh", command=reload_rows).pack(side="right", padx=3)
        tk.Label(win, text=("These are customer messages whose attachments the coverage scanner could not fully "
                            "read (save failures, oversized files, parser limits). Open the email to quote it by "
                            "hand, or Retry after fixing the cause — retried messages are re-examined from "
                            "scratch on the next scan pass."),
                 fg=_FG_DIM, bg=_BG, font=(_FONT, 8), wraplength=940,
                 justify="left", anchor="w").pack(fill="x", padx=12, pady=(0, 8))
        reload_rows()

    def open_quote_coverage_window(self):
        win = tk.Toplevel(self.root)
        win.title("MaINbox \u2014 Quote Coverage (outstanding line items)")
        remember_window_geometry(win, "MaINbox Quote Coverage", "1100x700")
        try:
            apply_theme(win)
        except Exception:
            pass
        win.configure(bg=_BG)

        header = tk.Frame(win, bg=_BG2)
        header.pack(fill="x")
        tk.Label(header, text="Quote Coverage", font=("Segoe UI", 14, "bold"),
                 fg=_FG, bg=_BG2).pack(side="left", padx=12, pady=8)
        summary_var = tk.StringVar(value="")
        tk.Label(header, textvariable=summary_var, font=("Segoe UI", 10),
                 fg=_ACCENT, bg=_BG2).pack(side="left", padx=8)
        tk.Button(header, text="\u21bb Refresh", command=lambda: reload_all(),
                  bg=_ACCENT, fg="#ffffff", activebackground=_ACCENT2, activeforeground="#ffffff",
                  relief="flat", padx=12, pady=4, cursor="hand2",
                  font=("Segoe UI", _FONT_SIZE, "bold")).pack(side="right", padx=10, pady=6)
        # v4.1.26 (round 8): the Attachment Review queue is one click away and shows
        # its backlog count right on the button.
        try:
            _arn0 = (self.quote_coverage or {}).get("attachment_review_needed", [])
            _arn_ct = len([e for e in _arn0 if isinstance(e, dict)]) if isinstance(_arn0, list) else 0
        except Exception:
            _arn_ct = 0
        tk.Button(header,
                  text=(f"\u26a0 Attachment review ({_arn_ct})" if _arn_ct else "Attachment review"),
                  command=lambda: self.open_attachment_review_window(parent=win),
                  relief="flat", padx=10, pady=4, cursor="hand2",
                  bg=("#7a5a1e" if _arn_ct else _BG3), fg=_FG,
                  font=("Segoe UI", _FONT_SIZE, "bold")).pack(side="right", padx=4, pady=6)

        body = tk.Frame(win, bg=_BG)
        body.pack(fill="both", expand=True, padx=8, pady=6)

        left = tk.LabelFrame(body, text="Customer requests", bg=_BG2, fg=_ACCENT, font=(_FONT, 9, "bold"))
        left.pack(side="left", fill="both", expand=False, padx=(0, 6))
        threads_tree = ttk.Treeview(left, columns=("thread", "out"), show="headings",
                                    height=24, selectmode="browse")
        threads_tree.heading("thread", text="Customer / Subject")
        threads_tree.heading("out", text="Outstanding")
        threads_tree.column("thread", width=360)
        threads_tree.column("out", width=100, anchor="center")
        threads_tree.pack(fill="both", expand=True, padx=4, pady=4)
        threads_tree.tag_configure("has_out", foreground="#3ea6ff")
        threads_tree.tag_configure("done", foreground="#5bd17a")

        right = tk.LabelFrame(body, text="Line items", bg=_BG2, fg=_ACCENT, font=(_FONT, 9, "bold"))
        right.pack(side="left", fill="both", expand=True)
        items_tree = ttk.Treeview(right, columns=("chk", "status", "item"), show="headings", selectmode="extended")
        items_tree.heading("chk", text="\u2611", command=lambda: toggle_check_all())
        items_tree.heading("status", text="Status")
        items_tree.heading("item", text="Requested item")
        items_tree.column("chk", width=34, anchor="center", stretch=False)
        items_tree.column("status", width=130, anchor="center")
        items_tree.column("item", width=500)
        items_tree.pack(fill="both", expand=True, padx=4, pady=4)
        items_tree.tag_configure("outstanding", foreground="#3ea6ff")
        items_tree.tag_configure("covered", foreground="#5bd17a")
        items_tree.tag_configure("waiting", foreground="#e6c84a")
        items_tree.tag_configure("partial", foreground="#e69a3e")
        items_tree.tag_configure("no_bid", foreground="#9aa0a6")
        items_tree.tag_configure("check", foreground="#ff9933")

        btns = tk.Frame(right, bg=_BG2)
        btns.pack(fill="x", padx=4, pady=(0, 4))
        tk.Label(btns, text="Set selected:", bg=_BG2, fg=_FG_DIM).pack(side="left", padx=(2, 4))
        tk.Button(btns, text="Quoted", command=lambda: set_item_status("quoted")).pack(side="left", padx=2)
        tk.Button(btns, text="Waiting", command=lambda: set_item_status("waiting")).pack(side="left", padx=2)
        tk.Button(btns, text="Partial", command=lambda: set_item_status("partial")).pack(side="left", padx=2)
        tk.Button(btns, text="No-bid", command=lambda: set_item_status("no_bid")).pack(side="left", padx=2)
        tk.Button(btns, text="Outstanding", command=lambda: set_item_status("outstanding")).pack(side="left", padx=2)
        tk.Button(btns, text="Re-quote", command=lambda: requote_selected(),
                  bg=_ACCENT, fg="#ffffff", activebackground=_ACCENT2, activeforeground="#ffffff",
                  relief="flat", padx=12, cursor="hand2", font=("Segoe UI", _FONT_SIZE, "bold")).pack(side="right", padx=3)
        tk.Button(btns, text="Dismiss this request", command=lambda: dismiss_current()).pack(side="right", padx=3)

        add_frame = tk.LabelFrame(right, text="Add requested items (paste one per line)",
                                  bg=_BG2, fg=_FG_DIM, font=(_FONT, 8, "bold"))
        add_frame.pack(fill="x", padx=4, pady=(0, 6))
        add_text = tk.Text(add_frame, height=3, wrap="word", bg=_BG3, fg=_FG, insertbackground=_FG)
        add_text.pack(fill="x", padx=4, pady=4)
        tk.Button(add_frame, text="Add to selected request",
                  command=lambda: add_lines()).pack(side="left", padx=4, pady=(0, 4))

        hint = ("Requested items are captured when you run Quote RFQ on a customer email; quoted items are "
                "detected from your sent replies in the same thread. Status auto-updates: Outstanding (no reply yet) "
                "\u2192 Waiting (you sent a sourcing reply like 'I will advise') \u2192 Quoted (a priced item in your reply "
                "matches). Use the buttons to override any item (Partial / No-bid / etc.); a manual status sticks.")
        tk.Label(win, text=hint, fg=_FG_DIM, bg=_BG, font=(_FONT, 8), wraplength=1060,
                 justify="left", anchor="w").pack(fill="x", padx=12, pady=(0, 8))

        CHK_OFF, CHK_ON = "\u2610", "\u2611"  # unchecked / checked glyphs
        state = {"current": None, "item_keys": {}, "checked": set()}

        def load_items(thread_key):
            state["current"] = thread_key
            state["item_keys"] = {}
            state["checked"] = set()
            items_tree.delete(*items_tree.get_children())
            rec = self.get_coverage_record(thread_key, create=False)
            if not rec:
                return
            rows, _out = self.compute_coverage_for_record(rec)
            _check_meta = rec.get("check_meta", {}) if isinstance(rec.get("check_meta"), dict) else {}
            for idx, row in enumerate(rows):
                label, tag = _COVERAGE_STATUS_DISPLAY.get(
                    row.get("status", "outstanding"), ("OUTSTANDING", "outstanding"))
                disp = row["display"]
                if row.get("status") == "check" and _check_meta:
                    _who = str(_check_meta.get("sender", "") or "").strip()
                    _when = str(_check_meta.get("date", "") or "")[:10]
                    _hint = " \u27f5 review reply" + (f" from {_who}" if _who else "") + (f" ({_when})" if _when else "")
                    disp = disp + _hint
                iid = f"item:{idx}"
                items_tree.insert("", "end", iid=iid, values=(CHK_OFF, label, disp), tags=(tag,))
                state["item_keys"][iid] = self.coverage_item_primary_key(row["req"])

        def reload_all():
            # v4.1.34: ONE coverage pass per reload. This used to run three full-store
            # computations (status label -> summary -> local pass); the label and the
            # summary now consume this pass's result.
            threads = self.coverage_active_threads()
            try:
                self.update_coverage_status_label(precomputed_threads=threads)
            except Exception:
                pass
            cur = state.get("current")
            threads_tree.delete(*threads_tree.get_children())
            for t in threads:
                rec = t["rec"]
                label = rec.get("customer", "") or rec.get("customer_email", "") or "?"
                subj = rec.get("subject", "") or "(no subject)"
                disp = f"{label} \u2014 {subj}"[:80]
                tag = "has_out" if t["outstanding"] > 0 else "done"
                out_disp = f"{t['outstanding']} / {t['requested_count']}"
                threads_tree.insert("", "end", iid=t["thread_key"], values=(disp, out_disp), tags=(tag,))
            thread_ct, item_ct = self.coverage_outstanding_summary(threads=threads)  # v4.1.34: reuse the pass above
            if item_ct:
                summary_var.set(f"{item_ct} item(s) still need quotes across {thread_ct} customer request(s)")
            else:
                summary_var.set("All requested items have been quoted.")
            if cur and threads_tree.exists(cur):
                threads_tree.selection_set(cur)
                load_items(cur)
            else:
                state["current"] = None
                items_tree.delete(*items_tree.get_children())

        def on_thread_select(event=None):
            sel = threads_tree.selection()
            if sel:
                load_items(sel[0])

        threads_tree.bind("<<TreeviewSelect>>", on_thread_select)

        def set_done(done):
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            sel = items_tree.selection()
            if not sel:
                messagebox.showinfo("Quote Coverage", "Select one or more line items first.")
                return
            for iid in sel:
                pk = state.get("item_keys", {}).get(iid, "")
                if pk:
                    self.coverage_toggle_item_done(cur, pk, done=done)
            reload_all()

        def set_item_status(status):
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            sel = target_iids()
            if not sel:
                messagebox.showinfo("Quote Coverage", "Check or select one or more line items first.")
                return
            for iid in sel:
                pk = state.get("item_keys", {}).get(iid, "")
                if pk:
                    self.coverage_set_item_status(cur, pk, status)
            reload_all()

        def add_lines():
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            txt = add_text.get("1.0", tk.END)
            n = self.coverage_add_requested_lines(cur, txt)
            add_text.delete("1.0", tk.END)
            reload_all()
            messagebox.showinfo("Quote Coverage", f"Added {n} requested item(s).")

        def dismiss_current():
            cur = state.get("current")
            if not cur:
                return
            if messagebox.askyesno("Dismiss request",
                                   "Remove this customer request from the coverage queue?"):
                self.coverage_dismiss_thread(cur, True)
                state["current"] = None
                reload_all()

        # ---- checkboxes / re-quote / double-click-to-email ----
        def toggle_check(iid):
            if iid in state["checked"]:
                state["checked"].discard(iid)
                items_tree.set(iid, "chk", CHK_OFF)
            else:
                state["checked"].add(iid)
                items_tree.set(iid, "chk", CHK_ON)

        def toggle_check_all():
            kids = items_tree.get_children()
            all_on = bool(kids) and all(i in state["checked"] for i in kids)
            for i in kids:
                if all_on:
                    state["checked"].discard(i)
                    items_tree.set(i, "chk", CHK_OFF)
                else:
                    state["checked"].add(i)
                    items_tree.set(i, "chk", CHK_ON)

        def on_items_click(event):
            if items_tree.identify_region(event.x, event.y) != "cell":
                return
            if items_tree.identify_column(event.x) == "#1":  # checkbox column
                row = items_tree.identify_row(event.y)
                if row:
                    toggle_check(row)
                    return "break"  # don't also change the row selection

        items_tree.bind("<Button-1>", on_items_click, add="+")

        def target_iids():
            # act on checked items; if none are checked, fall back to the highlighted selection
            if state["checked"]:
                return [i for i in items_tree.get_children() if i in state["checked"]]
            return list(items_tree.selection())

        def requote_selected():
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            rec = self.get_coverage_record(cur, create=False)
            if not rec:
                return
            keys = [state.get("item_keys", {}).get(i, "") for i in target_iids()]
            keys = [k for k in keys if k]
            if not keys:
                messagebox.showinfo("Quote Coverage", "Check the line items you want to re-quote first.")
                return
            keyset = set(keys)
            materials = normalize_material_items(
                [r for r in (rec.get("requested", []) or []) if self.coverage_item_primary_key(r) in keyset])
            if not materials:
                messagebox.showinfo("Quote Coverage", "Couldn't load those items to re-quote.")
                return
            # flip them to Waiting (auto, so a fresh vendor reply still auto-flips to Quoted), then refresh
            self.coverage_requote_items(cur, keys)
            reload_all()
            # open the RFQ & Materials extractor seeded with these items + suggested vendors
            group_id = rec.get("group_id", "") or ""
            try:
                group = self.get_group_by_id(group_id) if group_id else None
                emails = self.get_emails_for_group(group_id) if group_id else []
                if group or emails:
                    customer_hint = self.get_customer_hint_for_group(group, emails)
                else:
                    customer_hint = rec.get("customer", "") or ""
                vendors = self.suggest_vendors_for_materials(materials, customer_hint)
                self.open_quote_intelligence_window(
                    group_id, materials, vendors,
                    ["Re-quote from Quote Coverage \u2014 items carried over."], False,
                    requote_mode=True)  # v4.1.36: compose-only -- never mirror-replaces the ledger
            except Exception as e:
                messagebox.showwarning(
                    "Re-quote",
                    "Marked the items as Waiting, but couldn't open the RFQ extractor automatically "
                    f"(\u201c{e}\u201d). You can open it from the group's Quote RFQ button.")

        def _open_eid(eid):
            try:
                if self.goto_email_in_app(eid):
                    try:
                        self.root.lift()
                    except Exception:
                        pass
                    return True
            except Exception:
                pass
            try:
                ns = getattr(self, "namespace", None)
                if ns is None:
                    _o, ns = self.fresh_outlook()
                if ns:
                    it = ns.GetItemFromID(eid)
                    if it:
                        it.Display()
                        return True
            except Exception:
                pass
            return False

        def _eid_label(eid):
            e = self.get_email_by_id(eid)
            if e:
                subj = e.get("subject") or "(no subject)"
                who = e.get("sender") or e.get("sender_email") or ""
                when = e.get("received") or e.get("date") or ""
                return f"{subj}  \u2014  {who}  {when}".strip()
            try:
                ns = getattr(self, "namespace", None)
                if ns is None:
                    _o, ns = self.fresh_outlook()
                if ns:
                    it = ns.GetItemFromID(eid)
                    if it:
                        return f"{(getattr(it, 'Subject', '') or '(no subject)')}  \u2014  {getattr(it, 'SenderName', '')}"
            except Exception:
                pass
            return f"(email {str(eid)[:14]}\u2026)"

        def associated_entry_ids(rec):
            ids = []
            for eid in (rec.get("processed_sent_ids", []) or []):  # vendor quote replies
                if eid and eid not in ids:
                    ids.append(eid)
            gid = rec.get("group_id", "") if isinstance(rec, dict) else ""  # request-thread emails
            if gid:
                try:
                    for e in (self.get_emails_for_group(gid) or []):
                        eid = e.get("entry_id", "")
                        if eid and eid not in ids:
                            ids.append(eid)
                except Exception:
                    pass
            return ids

        def show_email_chooser(ids):
            top = tk.Toplevel(win)
            top.title("Associated emails")
            try:
                apply_theme(top)
            except Exception:
                pass
            top.configure(bg=_BG)
            tk.Label(top, text="This request is linked to more than one email. Open which one?",
                     bg=_BG, fg=_FG, font=(_FONT, 9), wraplength=560, justify="left").pack(fill="x", padx=10, pady=(10, 4))
            lb = tk.Listbox(top, width=96, height=min(12, max(3, len(ids))),
                            bg=_BG3, fg=_FG, selectbackground=_ACCENT, selectforeground="#ffffff", activestyle="none")
            lb.pack(fill="both", expand=True, padx=10, pady=6)
            for eid in ids:
                lb.insert("end", _eid_label(eid))

            def open_sel(event=None):
                s = lb.curselection()
                if not s:
                    return
                if not _open_eid(ids[s[0]]):
                    messagebox.showinfo("Quote Coverage",
                                        "That email couldn't be opened \u2014 it may have been moved, archived, or removed.")
                    return
                top.destroy()

            lb.bind("<Double-1>", open_sel)
            bf = tk.Frame(top, bg=_BG)
            bf.pack(fill="x", padx=10, pady=(0, 10))
            tk.Button(bf, text="Open", command=open_sel, bg=_ACCENT, fg="#ffffff",
                      activebackground=_ACCENT2, activeforeground="#ffffff", relief="flat",
                      padx=12, cursor="hand2").pack(side="right", padx=4)
            tk.Button(bf, text="Cancel", command=top.destroy, relief="flat", padx=12, cursor="hand2").pack(side="right", padx=4)

        def on_item_double(event=None):
            try:
                if items_tree.identify_column(event.x) == "#1":  # checkbox column toggles, doesn't navigate
                    return
            except Exception:
                pass
            cur = state.get("current")
            if not cur:
                return
            rec = self.get_coverage_record(cur, create=False)
            if not rec:
                return
            ids = associated_entry_ids(rec)
            if not ids:
                messagebox.showinfo("Quote Coverage", "No associated email is available to open for this request.")
                return
            if len(ids) == 1:
                if not _open_eid(ids[0]):
                    messagebox.showinfo("Quote Coverage",
                                        "That email couldn't be opened \u2014 it may have been moved, archived, or removed.")
                return
            show_email_chooser(ids)

        items_tree.bind("<Double-1>", on_item_double, add="+")

        reload_all()

