    def procurement_stats_for_material(self, item):
        key = canonical_material_key(item)
        return self.procurement_memory.get("materials", {}).get(key, {}) if key else {}

    def procurement_suggest_vendors_for_materials(self, materials, limit=12):
        scores = {}
        reasons = {}
        mem = self.procurement_memory or default_procurement_memory()
        for item in materials or []:
            key = canonical_material_key(item)
            if not key:
                continue
            mrec = mem.get("materials", {}).get(key, {})
            for email, stat in (mrec.get("vendors", {}) or {}).items():
                email = str(email or "").lower().strip()
                if not email or is_blocked_internal_vendor(email, stat.get("name", "")):
                    continue
                award_count = int(stat.get("award_count", 0) or 0)
                request_count = int(stat.get("request_count", 0) or 0)
                preferred = bool(stat.get("preferred", False))
                score = award_count * 12 + request_count * 3 + (20 if preferred else 0)
                last_price = stat.get("last_unit_price", None)
                if last_price not in [None, ""]:
                    score += 2
                scores[email] = scores.get(email, 0) + score
                bits = []
                if preferred: bits.append("preferred")
                if award_count: bits.append(f"{award_count} award(s)")
                if request_count: bits.append(f"{request_count} RFQ(s)")
                if last_price not in [None, ""]: bits.append(f"last ${last_price}/unit")
                reasons.setdefault(email, set()).add(f"{key}: " + ", ".join(bits or ["history"]))
        ranked = []
        for email, score in sorted(scores.items(), key=lambda x: x[1], reverse=True)[:limit]:
            vrec = mem.get("vendors", {}).get(email, {}) or (self.vendor_history or {}).get("vendors", {}).get(email, {})
            ranked.append({"email": email, "name": vrec.get("name", email), "score": score, "reason": "; ".join(sorted(reasons.get(email, [])))})
        return ranked

    def record_procurement_request(self, vendors, materials, group=None, subject=""):
        mem = self.procurement_memory
        now = datetime.now().isoformat()
        customer_hint = self.get_customer_hint_for_group(group, self.get_emails_for_group(group.get("id")) if group and group.get("id") else []) if group else ""
        for vendor in vendors or []:
            email = str(vendor.get("email", "") or "").lower().strip()
            if not email or is_blocked_internal_vendor(email, vendor.get("name", "")):
                continue
            vrec = mem.setdefault("vendors", {}).setdefault(email, {"email": email, "name": vendor.get("name", email), "request_count": 0, "award_count": 0, "last_used_at": ""})
            vrec["name"] = vendor.get("name", email) or vrec.get("name", email)
            vrec["request_count"] = int(vrec.get("request_count", 0) or 0) + 1
            vrec["last_used_at"] = now
            if customer_hint:
                vrec.setdefault("customers", {})[customer_hint] = int(vrec.setdefault("customers", {}).get(customer_hint, 0) or 0) + 1
            for item in materials or []:
                key = canonical_material_key(item)
                if not key:
                    continue
                mrec = mem.setdefault("materials", {}).setdefault(key, {"key": key, "sample_description": item.get("description", ""), "vendors": {}, "last_used_at": ""})
                if item.get("description") and not mrec.get("sample_description"):
                    mrec["sample_description"] = item.get("description", "")
                mrec["last_used_at"] = now
                stat = mrec.setdefault("vendors", {}).setdefault(email, {"email": email, "name": vendor.get("name", email), "request_count": 0, "award_count": 0})
                stat["name"] = vendor.get("name", email) or stat.get("name", email)
                stat["request_count"] = int(stat.get("request_count", 0) or 0) + 1
                stat["last_requested_at"] = now
        self.save_procurement_memory()

    def record_procurement_award(self, vendor, materials, group=None, unit_price=None, total_price=None, notes=""):
        mem = self.procurement_memory
        now = datetime.now().isoformat()
        email = str(vendor.get("email", "") or "").lower().strip()
        if not email or is_blocked_internal_vendor(email, vendor.get("name", "")):
            return 0
        vrec = mem.setdefault("vendors", {}).setdefault(email, {"email": email, "name": vendor.get("name", email), "request_count": 0, "award_count": 0})
        vrec["name"] = vendor.get("name", email) or vrec.get("name", email)
        vrec["award_count"] = int(vrec.get("award_count", 0) or 0) + 1
        vrec["last_awarded_at"] = now
        count = 0
        for item in materials or []:
            key = canonical_material_key(item)
            if not key:
                continue
            qty = str(item.get("qty", "") or "").strip()
            unit = str(item.get("unit", "") or "").strip()
            desc = str(item.get("description", "") or "").strip()
            mrec = mem.setdefault("materials", {}).setdefault(key, {"key": key, "sample_description": desc, "vendors": {}})
            if desc:
                mrec["sample_description"] = desc
            stat = mrec.setdefault("vendors", {}).setdefault(email, {"email": email, "name": vendor.get("name", email), "request_count": 0, "award_count": 0})
            stat["name"] = vendor.get("name", email) or stat.get("name", email)
            stat["award_count"] = int(stat.get("award_count", 0) or 0) + 1
            stat["preferred"] = True
            stat["last_awarded_at"] = now
            if unit_price is not None:
                stat["last_unit_price"] = unit_price
            award = {"created_at": now, "vendor": vendor, "material_key": key, "material": dict(item), "group_id": group.get("id", "") if group else "", "group_name": group.get("name", "") if group else "", "unit_price": unit_price, "total_price": total_price, "notes": notes}
            mem.setdefault("awards", []).append(award)
            if unit_price is not None or total_price is not None:
                mem.setdefault("price_history", []).append({"created_at": now, "vendor_email": email, "vendor_name": vendor.get("name", email), "material_key": key, "description": desc, "qty": qty, "unit": unit, "unit_price": unit_price, "total_price": total_price, "notes": notes})
            mem.setdefault("routing_rules", {}).setdefault(key, [])
            if email not in mem["routing_rules"][key]:
                mem["routing_rules"][key].insert(0, email)
            count += 1
        self.save_procurement_memory()
        return count

    def purchase_history_extract_job_hint(self, subject="", body=""):
        """Best-effort job/group matching for old purchase history.

        If the user names quote groups by job, this lets the scanner connect
        older vendor purchases back to those job names without requiring a
        separate job-number database.
        """
        combined = f"{subject}\n{body}".lower()
        best = ""
        for g in (self.groups_data or {}).get("groups", []) or []:
            name = str(g.get("name", "") or "").strip()
            if not name or len(name) < 3:
                continue
            if name.lower() in combined:
                return name
            # Also match compact job-like tokens from group names.
            for token in re.findall(r"[A-Za-z]{2,}\d{2,}|\d{4,}|[A-Z]{2,}-?\d{3,}", name, flags=re.I):
                if len(token) >= 4 and token.lower() in combined:
                    best = name
        if best:
            return best
        m = re.search(r"\b(?:job|project|po|req|requisition)\s*#?\s*[:\-]?\s*([A-Z0-9][A-Z0-9\-_/]{3,})", f"{subject}\n{body}", flags=re.I)
        return m.group(1).strip() if m else ""

    def purchase_history_candidate_lines(self, text):
        """Extract likely purchased/quoted material rows from an old email body.

        v2.10.23: tightened this so addresses, signature/contact info, RFQ prose,
        job notes, and quote instructions do not become "materials". It now favors
        true catalog/part/price/quantity lines such as "IP710-D2Z $72.69" or
        "25 EA 3/4 EMT connector $1.25".
        """
        text = text or ""
        rows = []
        for raw in text.splitlines():
            line = re.sub(r"\s+", " ", str(raw or "")).strip()
            if len(line) < 5 or len(line) > 240:
                continue
            if purchase_history_line_noise_reason(line):
                continue

            low = line.lower()
            has_trade_word = bool(re.search(r"\b(emt|pvc|rigid|conduit|connector|strap|locknut|bushing|coupling|nipple|wire|cable|breaker|panel|box|gutter|kindorf|strut|washer|nut|rod|paint|tie|fitting|receptacle|switch|cover|device|transformer|lug|bolt|screw|anchor|unistrut|channel|hubbell|leviton|burndy|southwire|thhn|mccb|gfci|afci|nema|dimmer|disconnect|fuse|clamp|terminal|elbow)\b", low))
            has_money = bool(re.search(r"\$\s*\d|\b\d+\.\d{2,4}\b", line))
            has_qty = bool(re.match(r"^\s*\d+(?:\.\d+)?\s*(?:ea|each|ft|feet|pc|pcs|box|bag|roll|set|lot|m|c)?\b", line, flags=re.I))
            part_guess = purchase_history_extract_part_number_from_text(line)

            # Conservative gate: must have real material evidence, not just prose.
            if not ((has_trade_word and (has_qty or has_money or part_guess)) or (part_guess and (has_money or has_qty))):
                continue

            # Qty/unit at start, e.g. 25 EA 3/4 EMT connector $1.25
            qty = ""
            unit = ""
            desc = line
            m = re.match(r"^\s*(\d+(?:\.\d+)?)\s*(ea|each|ft|feet|pc|pcs|box|bag|roll|set|lot|m|c)?\s*[xX\-:,]*\s*(.+)$", line, flags=re.I)
            if m:
                qty = m.group(1)
                unit = (m.group(2) or "").lower()
                if unit == "each":
                    unit = "ea"
                if unit == "feet":
                    unit = "ft"
                desc = m.group(3).strip()

            prices = []
            for pm in re.finditer(r"\$\s*([0-9][0-9,]*(?:\.\d{1,4})?)", line):
                val = money_to_float(pm.group(0))
                if val is not None:
                    prices.append(val)
            if not prices and any(x in low for x in ["price", "unit", "ext", "total", "quote"]):
                for pm in re.finditer(r"\b([0-9][0-9,]*\.\d{2})\b", line):
                    val = money_to_float(pm.group(1))
                    if val is not None:
                        prices.append(val)

            unit_price = prices[0] if prices else None
            total_price = prices[-1] if len(prices) > 1 else None

            desc = re.sub(r"\$\s*[0-9][0-9,]*(?:\.\d{1,4})?", " ", desc)
            desc = re.sub(r"\b(?:unit price|ext price|total|price|quote)\b\s*[:\-]?", " ", desc, flags=re.I)
            desc = re.sub(r"\s+", " ", desc).strip(" -:,;\t")
            if not desc or purchase_history_line_noise_reason(desc):
                continue

            row = {"qty": qty, "unit": unit, "description": desc, "part_number": part_guess, "unit_price": unit_price, "total_price": total_price, "raw_line": line}
            if not is_likely_purchase_material_row(row):
                continue
            rows.append(row)

        # If line parsing found nothing, use the existing RFQ material heuristic as a
        # last candidate builder, but run every result through the stricter guard.
        if not rows:
            for item in heuristic_extract_materials(text, max_items=25) or []:
                item = dict(item)
                item.setdefault("unit", "")
                item.setdefault("unit_price", None)
                item.setdefault("total_price", None)
                item.setdefault("raw_line", item.get("description", ""))
                if purchase_history_line_noise_reason(item.get("raw_line") or item.get("description")):
                    continue
                if not is_likely_purchase_material_row(item):
                    continue
                rows.append(item)

        # Deduplicate by normalized material key + qty/unit/price.
        cleaned = []
        seen = set()
        for r in rows:
            key = (canonical_material_key(r), str(r.get("qty", "")), str(r.get("unit", "")), str(r.get("unit_price", "")))
            if key in seen:
                continue
            seen.add(key)
            cleaned.append(r)
        return cleaned[:80]


