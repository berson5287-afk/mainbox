"""
MaINbox quote-pipeline ENTRY POINT (manual, flag-gated, inbound-half only).

This is the one piece that runs *inside* MaINbox. You paste a button + a tiny
method into your app (see the instructions delivered alongside this file); the
button calls run_quote_scan(self). Everything else lives in the standalone
modules on the bench.

SAFETY DIALS (edit these here):
  QUOTE_PIPELINE_ENABLED          False -> the button does nothing (safe to paste
                                  and ship; flip to True when you're ready).
  QUOTE_PIPELINE_DRY_RUN          True  -> scan + classify your real inbox and
                                  REPORT only. No writes, no drafts, no minting.
                                  Flip to False to actually mint + draft acks.
  QUOTE_PIPELINE_MAX_MINT_PER_SCAN  In live mode, the most new-customer RFQs to
                                  process per click (bounds blast radius; 1 = one
                                  ack draft per click, a controlled drip).

Staged rollout: ship with ENABLED=False -> flip ENABLED=True (still DRY_RUN) and
watch how your real mail classifies -> once you trust it, flip DRY_RUN=False and
it starts drafting (one RFQ per click). Nothing is ever SENT -- acks are drafts.

After minting + drafting the ack, the pipeline hands the customer RFQ to MaINbox's
OWN RFQ & Materials Extractor (QUOTE_PIPELINE_OPEN_EXTRACTOR) -- the same window you
use today: it extracts the email, shows the editable material grid + your vendor
recipients, and you Send RFQs Now. The pipeline's own SmartScan extraction
(QUOTE_PIPELINE_EXTRACT) is OFF by default and dormant, since that window owns it.
"""
from __future__ import annotations

import os
import sys
import json
import tempfile
import traceback
from datetime import datetime, timedelta, timezone
from typing import List, Optional

from quote_jobs_store import QuoteJobStore
from quote_jobs_controller import QuoteJobController
from inbound_store import InboundStore
from inbound_router import (InboundRouter, InboundMail, KeywordRfqScorer,
                            resolve_features, classify, Bucket)
from mainbox_contacts import (MaINboxContactLookup, build_customer_emails_from_categorized,
                              build_vendor_emails_from_categorized)
from mainbox_effects import MaINboxEffectsPort
from mainbox_rfq_scorer import HybridRfqScorer

# ------------------------------- safety dials -------------------------------
QUOTE_PIPELINE_ENABLED = True
QUOTE_PIPELINE_DRY_RUN = False
QUOTE_PIPELINE_MAX_MINT_PER_SCAN = 1
QUOTE_PIPELINE_OPEN_EXTRACTOR = True      # PRIMARY: after minting a customer RFQ, open MaINbox's
                                          # own RFQ & Materials Extractor on it (it extracts, you
                                          # pick items/vendors, Send RFQs Now). This is the handoff.
QUOTE_PIPELINE_EXTRACT = False           # DORMANT alt path: the pipeline's own SmartScan extraction
                                         # (+ confidence gate / review). Off because the extractor
                                         # window above owns extraction. True -> pipeline extracts too.
QUOTE_PIPELINE_CONFIRM_TRIAGE = ""       # set to a sender/subject substring (e.g. "harrand")
                                         # to MINT the newest matching triage item. When set, the
                                         # standing auto-mint pass STANDS DOWN (targeted-only scan).
QUOTE_PIPELINE_LIST_TRIAGE = ""          # READ-ONLY preview: set to a substring (or "*" for
                                         # all) to list matching triage items + what each has
                                         # to extract (attachments/body). Does NOT mint.
QUOTE_PIPELINE_SHOW_JOBS = ""            # READ-ONLY: set to "*" (all) or a job-id/customer
                                         # substring to view jobs + their extracted line items.
QUOTE_PIPELINE_ASK_UNRECOGNIZED = True   # after a scan, pop a checklist of strong-signal RFQs
                                         # from senders you HAVEN'T saved -- tick Quote and/or
                                         # Add-to-saved per row. This is how triage gets actioned.
QUOTE_PIPELINE_SHOW_SAVED = ""           # READ-ONLY: "customer", "vendor", or "*" to print your
                                         # saved sender lists (full add/edit/remove comes in Settings).
QUOTE_PIPELINE_USE_AI_SCORER = False     # the scan runs on the UI thread, so a slow/unreachable
                                         # Ollama would FREEZE the app (a blocking call per ambiguous
                                         # message). OFF -> keyword-only scoring (strong-phrase +
                                         # negative filter + keyword fallback): no network, never
                                         # freezes. True -> also ask Ollama on borderline messages
                                         # (only if you have a reliable local host; see timeout below).
QUOTE_PIPELINE_AI_SCORER_TIMEOUT = 4.0   # seconds per AI call when USE_AI_SCORER is True (kept short
                                         # so an unreachable host fails fast instead of hanging the UI).

# --- extraction review policy (DORMANT: only used when QUOTE_PIPELINE_EXTRACT is True) ---
QUOTE_PIPELINE_EXTRACT_REVIEW_MODE = "always"  # "always" -> always open SmartScan review;
                                               # "auto"   -> auto-draft when every row clears
                                               #             the confidence bar below.
QUOTE_PIPELINE_EXTRACT_CONFIDENCE = 0.90       # "auto" only: min row confidence to skip review.
                                               # NOTE: SmartScan grades rows green/yellow/red,
                                               # so this is BANDED (~3 real positions: ~.95 green,
                                               # ~.60 yellow, ~.30 red), not a continuous score.

# scan scope
SCAN_DAYS_BACK = 7
SCAN_MAX_MESSAGES = 50
_BODY_CAP = 5000
_OWN_DOMAINS = ("americanpoweresc.com",)
_CUSTOMER_CATEGORIES = ("Quote / Estimate",)
_VENDOR_CATEGORIES = ("Vendor / Supplier",)


# ------------------------------- data location ------------------------------
def _parent_data_dir() -> str:
    base = os.environ.get("LOCALAPPDATA") or os.path.join(os.path.expanduser("~"), "AppData", "Local")
    return os.path.join(base, "MaINbox")


def _pipeline_dir() -> str:
    d = os.path.join(_parent_data_dir(), "quote_pipeline")
    os.makedirs(d, exist_ok=True)
    return d


def _load_triage_rows() -> list:
    """Customer signal source: your category-tagged triage history (sender_email +
    category). Read-only; falls back to empty if absent."""
    import json
    path = os.path.join(_parent_data_dir(), "mainbox_triage_history.json")
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


# ---- saved sender lists (you grow these from the end-of-scan checklist) -----
_SAVED_FILES = {"customer": "saved_customers.json", "vendor": "saved_vendors.json"}


def _saved_path(kind: str) -> str:
    return os.path.join(_pipeline_dir(), _SAVED_FILES.get(kind, "saved_customers.json"))


def load_saved_senders(kind: str) -> set:
    """Saved emails (lowercased) for 'customer' or 'vendor'. Empty if none yet."""
    try:
        with open(_saved_path(kind), encoding="utf-8") as f:
            data = json.load(f)
        items = data if isinstance(data, list) else data.get("emails", [])
        return {str(e).strip().lower() for e in items if str(e).strip()}
    except (OSError, ValueError):
        return set()


def _write_saved(kind: str, emails: set) -> None:
    os.makedirs(_pipeline_dir(), exist_ok=True)
    with open(_saved_path(kind), "w", encoding="utf-8") as f:
        json.dump(sorted(emails), f, indent=2)


def add_saved_sender(kind: str, email: str) -> set:
    """Add an email to a saved list (idempotent). Returns the updated set."""
    email = str(email or "").strip().lower()
    cur = load_saved_senders(kind)
    if email and email not in cur:
        cur.add(email)
        try:
            _write_saved(kind, cur)
        except OSError:
            pass
    return cur


def remove_saved_sender(kind: str, email: str) -> set:
    """Remove an email from a saved list. Returns the updated set."""
    email = str(email or "").strip().lower()
    cur = load_saved_senders(kind)
    if email in cur:
        cur.discard(email)
        try:
            _write_saved(kind, cur)
        except OSError:
            pass
    return cur


def _recognized_customers() -> set:
    """Senders treated as known customers for auto-mint: your triage Quote/Estimate
    history UNION your saved customers. Used both for recognition wiring and to
    filter the end-of-scan candidate checklist."""
    return (build_customer_emails_from_categorized(
        _load_triage_rows(), customer_categories=_CUSTOMER_CATEGORIES,
        exclude_domains=_OWN_DOMAINS) | load_saved_senders("customer"))


def _quote_candidates(triage, recognized_customers) -> list:
    """Triage RFQs to offer in the end-of-scan checklist: senders NOT already
    recognized/saved, deduped by (sender, subject), newest first."""
    recognized = {str(e).strip().lower() for e in (recognized_customers or set())}
    seen, out = set(), []
    for e in sorted(triage or [], key=lambda x: x.get("received_at", ""), reverse=True):
        sender = str(e.get("sender", "") or "").strip()
        if not sender or sender.lower() in recognized:
            continue
        key = (sender.lower(), str(e.get("subject", "") or "").strip().lower())
        if key in seen:
            continue
        seen.add(key)
        out.append(e)
    return out


def _default_extraction_hook(job):
    print("[quote-pipeline] extraction not wired (QUOTE_PIPELINE_EXTRACT=False) -> 0 items")
    return []


# --------------------------- SmartScan extraction ---------------------------
# SmartScan tags each material row with ai_status / review_status. MaINbox's
# row->material mapping folds the first meaningful status into the "notes"
# string ("SmartScan | <file> | <status>"). These statuses mean "trust it":
_CONFIDENT_STATUSES = {"ok", "confirmed", "corrected"}
# RFQ-bearing attachment types we hand to SmartScan (skip signatures/logos):
_RFQ_ATTACHMENT_EXTS = (".pdf", ".xls", ".xlsx", ".csv",
                        ".png", ".jpg", ".jpeg", ".tif", ".tiff")
# Minimum email-body length to bother feeding to SmartScan (skips "thanks"-type
# bodies; a real typed takeoff is short, so keep this low):
_MIN_BODY_CHARS = 20


def _row_is_confident(row) -> bool:
    """A SmartScan material row is confident only if it carries an explicit
    trust status (ok/confirmed/corrected). Anything else -- a warning/error/
    suggestion, or no status at all (unreviewed/pending) -- is uncertain, which
    routes the whole extraction to the review window. Safe direction by default."""
    notes = str((row or {}).get("notes", "") or "").lower()
    segments = [seg.strip() for seg in notes.split("|")]
    return any(seg in _CONFIDENT_STATUSES for seg in segments)


# SmartScan grades categorically; map each status to a representative band so the
# user's confidence threshold has a meaning. Unknown/unreviewed -> mid (0.50).
_STATUS_CONF_BANDS = {
    "ok": 0.95, "confirmed": 0.95, "corrected": 0.95, "green": 0.95,
    "warning": 0.60, "suggestion": 0.60, "review": 0.60, "yellow": 0.60,
    "error": 0.30, "red": 0.30, "missing_candidate": 0.30, "rejected": 0.30,
}


def _row_confidence(row) -> float:
    """A SmartScan row's confidence as a 0..1 band, read from its status (folded
    into notes). Banded, not continuous -- SmartScan only grades green/yellow/red."""
    notes = str((row or {}).get("notes", "") or "").lower()
    for seg in (s.strip() for s in notes.split("|")):
        if seg in _STATUS_CONF_BANDS:
            return _STATUS_CONF_BANDS[seg]
    return 0.50


def _should_review(rows, mode, threshold) -> bool:
    """Whether to open the SmartScan review window. 'always' -> always (and with
    no rows there is nothing to auto-draft, so review regardless). 'auto' ->
    review only if any row falls below the confidence threshold."""
    if not rows:
        return True
    if str(mode or "").strip().lower() != "auto":
        return True
    return any(_row_confidence(r) < threshold for r in rows)


def _prep_rows(rows) -> list:
    """Final shaping before the rows become line items: drop anything the user
    rejected in review, and stamp status='green' on the survivors so the effects
    port's row->item mapper scores them high-confidence (the gate already decided
    they're trustworthy -- either all-confident headless, or user-reviewed)."""
    out = []
    for r in rows or []:
        if not isinstance(r, dict):
            continue
        if "rejected" in str(r.get("notes", "") or "").lower():
            continue
        if not str(r.get("description", "") or "").strip():
            continue
        r = dict(r)
        r["status"] = "green"
        out.append(r)
    return out


def _match_triage(triage, needle, limit=None):
    """Triage entries whose sender or subject contains `needle` (case-insensitive),
    newest first, capped at `limit`. Pure -- the minting itself is live."""
    needle = (needle or "").strip().lower()
    if not needle:
        return []
    matches = [e for e in (triage or [])
               if needle in str(e.get("sender", "") or "").lower()
               or needle in str(e.get("subject", "") or "").lower()]
    matches.sort(key=lambda e: e.get("received_at", ""), reverse=True)
    return matches[:limit] if limit else matches


def _auto_mint_targets(pending_newest_first, confirm_needle, max_n):
    """Which pending new-customer RFQs the standing auto-mint pass should take.
    When a targeted CONFIRM_TRIAGE is set, auto-mint stands down entirely (a
    targeted scan does ONLY the targeted thing); otherwise the newest `max_n`."""
    if (confirm_needle or "").strip():
        return []
    return list(pending_newest_first or [])[:max(0, int(max_n or 0))]


def _triage_signal(monitor, entry_id):
    """Best-effort one-liner describing a triage email's extractable content: its
    RFQ-type attachments and body length. This is what tells you which duplicate
    actually has a takeoff. Returns '?' if the item can't be opened."""
    if not entry_id:
        return "(no entry_id)"
    try:
        ns = _get_namespace(monitor)
        item = ns.GetItemFromID(entry_id)
        names = []
        atts = getattr(item, "Attachments", None)
        if atts and int(getattr(atts, "Count", 0) or 0):
            for i in range(1, int(atts.Count) + 1):
                fn = str(getattr(atts.Item(i), "FileName", "") or "")
                if fn.lower().endswith(_RFQ_ATTACHMENT_EXTS):
                    names.append(os.path.basename(fn))
        body_len = len(str(getattr(item, "Body", "") or "").strip())
        att_str = ", ".join(names) if names else "no RFQ attachments"
        return f"{att_str}; body {body_len}ch"
    except Exception:
        return "?"


def _get_namespace(monitor):
    """Return a MAPI namespace valid on the CURRENT thread.

    We deliberately do NOT reuse monitor.namespace: MaINbox creates it on its own
    thread (Outlook/AI work runs off the UI thread), and a COM interface is only
    legal on the apartment that created it -- borrowing it here raises
    RPC_E_WRONG_THREAD (-2147417842). A fresh Dispatch on this thread is always
    thread-valid (the effects port drafts the ack the same way). `monitor` is
    accepted for signature stability but intentionally unused."""
    import win32com.client  # local import: only on the live Windows/Outlook box
    try:
        import pythoncom
        pythoncom.CoInitialize()   # no-op if this thread is already initialized
    except Exception:
        pass
    return win32com.client.Dispatch("Outlook.Application").GetNamespace("MAPI")


def _gather_rfq_sources(monitor, source_entry_id):
    """Gather everything SmartScan should read from the RFQ email: document
    attachments (saved via Outlook's SaveAsFile) AND the email body as a temp
    .txt -- mirroring MaINbox's own RFQ flow, so material lists pasted into the
    body are caught, not just attached files. Returns (paths, note) where note
    is a human-readable summary of what was gathered (for the console)."""
    ns = _get_namespace(monitor)
    if ns is None:
        return [], "no Outlook namespace"
    item = ns.GetItemFromID(source_entry_id)
    tmpdir = tempfile.mkdtemp(prefix="mb_rfq_")
    paths, notes = [], []

    atts = getattr(item, "Attachments", None)
    if atts and int(getattr(atts, "Count", 0) or 0):
        for i in range(1, int(atts.Count) + 1):
            att = atts.Item(i)
            fname = str(getattr(att, "FileName", "") or "").strip()
            size = int(getattr(att, "Size", 0) or 0)
            if not fname or not fname.lower().endswith(_RFQ_ATTACHMENT_EXTS):
                continue
            dest = os.path.join(tmpdir, os.path.basename(fname))
            try:
                att.SaveAsFile(dest)
                paths.append(dest)
                notes.append(f"att:{os.path.basename(fname)}({size}B)")
            except Exception:
                notes.append(f"att-FAIL:{os.path.basename(fname)}")

    # Email body as .txt -- SmartScan's structured parser reads .txt. The
    # threshold only skips trivially short bodies (e.g. "thanks"); a real typed
    # takeoff can be well under 100 chars, so it must be low. (MaINbox's own flow
    # uses a higher gate here only because it has a separate short-list parser; we
    # don't, so the body must reach SmartScan directly.)
    body = str(getattr(item, "Body", "") or "").strip()
    if len(body) >= _MIN_BODY_CHARS:
        subj = str(getattr(item, "Subject", "") or "")
        sender = str(getattr(item, "SenderEmailAddress", "") or "")
        bpath = os.path.join(tmpdir, "email_body.txt")
        try:
            with open(bpath, "w", encoding="utf-8", errors="ignore") as fh:
                fh.write(f"Subject: {subj}\nFrom: {sender}\n\n")
                fh.write(body[:20000])
            paths.append(bpath)
            notes.append(f"body({len(body)}ch)")
        except Exception:
            notes.append("body-FAIL")
    else:
        notes.append(f"body-skip({len(body)}ch)")

    return paths, ", ".join(notes) if notes else "nothing gathered"


def _smartscan_extract(monitor, job):
    """Live extraction hook. Reuses YOUR SmartScan via the running module (no
    static import). Flow: gather the RFQ email's attachments AND body -> headless-
    extract each -> if every row is confident, return them (vendor RFQ drafts with
    no GUI); else open your review window (confidence colors + teaching) and use
    those rows.

    Returns SmartScan material-row dicts (the effects port maps them to line
    items). Any failure -> [] so the chain degrades to ack-only, never crashes."""
    try:
        source_entry_id = getattr(getattr(job, "customer", None), "source_entry_id", "") or ""
        if not source_entry_id:
            print(f"[quote-pipeline] {job.job_id}: no source_entry_id on job -> 0 items")
            return []

        host = sys.modules.get(type(monitor).__module__)
        extract_fn = getattr(host, "smartscan_extract_materials_from_saved_attachment", None)
        review_fn = getattr(host, "_run_smartscan_review_subprocess", None)
        if extract_fn is None:
            print("[quote-pipeline] SmartScan extractor not found on host module -> 0 items")
            return []

        paths, gather_note = _gather_rfq_sources(monitor, source_entry_id)
        print(f"[quote-pipeline] {job.job_id}: sources -> {gather_note}")
        if not paths:
            print(f"[quote-pipeline] {job.job_id}: nothing to extract -> 0 items")
            return []

        rows = []
        for p in paths:
            try:
                r, _msgs, _text = extract_fn(p, os.path.basename(p))
                n = len(r or [])
                print(f"[quote-pipeline]   {os.path.basename(p)} -> {n} row(s)")
                rows.extend(r or [])
            except Exception as exc:
                print(f"[quote-pipeline]   {os.path.basename(p)} -> extract failed: {exc}")

        if _should_review(rows, QUOTE_PIPELINE_EXTRACT_REVIEW_MODE, QUOTE_PIPELINE_EXTRACT_CONFIDENCE):
            mode = str(QUOTE_PIPELINE_EXTRACT_REVIEW_MODE or "").strip().lower()
            why = ("review mode = always" if mode != "auto"
                   else ("no rows extracted" if not rows
                         else f"a row is below confidence {QUOTE_PIPELINE_EXTRACT_CONFIDENCE}"))
            print(f"[quote-pipeline] {job.job_id}: {why} -> opening SmartScan review")
            if review_fn is None:
                print("[quote-pipeline] review function not found -> 0 items")
                return []
            rr, _m, _t = review_fn(paths, source_name=f"RFQ {job.job_id}")
            if not rr:
                print(f"[quote-pipeline] {job.job_id}: review returned no rows (cancelled) -> 0 items")
                return []
            final = rr
        else:
            print(f"[quote-pipeline] {job.job_id}: {len(rows)} row(s) clear confidence "
                  f"{QUOTE_PIPELINE_EXTRACT_CONFIDENCE} -> drafting (no review)")
            final = rows

        final = _prep_rows(final)
        print(f"[quote-pipeline] {job.job_id}: extraction -> {len(final)} line item(s)")
        return final
    except Exception as exc:
        print(f"[quote-pipeline] extraction error ({type(exc).__name__}: {exc}) -> 0 items")
        return []


# ------------------------------- pipeline build -----------------------------
def _build_pipeline(monitor):
    """Construct controller + ports + stores once, cached on the monitor. Wired to
    the LIVE app: vendors from monitor.vendor_history, customers from triage data."""
    vh = getattr(monitor, "vendor_history", {}) or {}
    print(f"[quote-pipeline] live vendor_history -> {len(vh.get('vendors', {}))} vendors, "
          f"{len(vh.get('customers', {}))} customers")     # temporary diagnostic
    existing = getattr(monitor, "_quote_pipeline", None)
    if existing is not None:
        return existing

    d = _pipeline_dir()
    store = QuoteJobStore(os.path.join(d, "quote_jobs.json"))
    inbound = InboundStore(os.path.join(d, "inbound.json"))

    lookup = MaINboxContactLookup(
        vendor_provider=lambda: (
            {str(e).lower() for e in (getattr(monitor, "vendor_history", {}) or {}).get("vendors", {})}
            | build_vendor_emails_from_categorized(
                _load_triage_rows(), vendor_categories=_VENDOR_CATEGORIES, exclude_domains=_OWN_DOMAINS)
            | load_saved_senders("vendor")),
        customer_provider=_recognized_customers,
        match_domains=True)

    port = MaINboxEffectsPort(
        event_log_path=os.path.join(d, "events.jsonl"),
        display_drafts=True,                 # so you SEE the ack draft open
        enable_popups=False,                 # no modal alerts during first runs
        extraction_hook=((lambda job: _smartscan_extract(monitor, job))
                         if QUOTE_PIPELINE_EXTRACT else _default_extraction_hook))

    controller = QuoteJobController(store, port)
    # Scoring runs on the UI thread during the scan. Default to keyword-only (no network)
    # so a slow/unreachable Ollama can never freeze the app; opt in to the AI verdict only
    # when explicitly enabled, and even then with a short timeout for fast failure.
    if QUOTE_PIPELINE_USE_AI_SCORER:
        scorer = HybridRfqScorer(timeout=QUOTE_PIPELINE_AI_SCORER_TIMEOUT)
    else:
        scorer = HybridRfqScorer(ai_complete=lambda _prompt: "")   # keyword-only; never calls the network
    router = InboundRouter(controller, inbound, lookup, scorer)

    pipeline = {"store": store, "inbound": inbound, "lookup": lookup,
                "port": port, "controller": controller, "router": router}
    monitor._quote_pipeline = pipeline
    return pipeline


# ------------------------------- inbox reading ------------------------------
def _open_inbox(monitor):
    """Open the Inbox robustly. Prefer the monitor's own (reconnect-aware)
    connection; if it isn't live yet, attach directly to the running Outlook
    (same process, same instance) so a freshly-launched app still scans."""
    # 1) the monitor's safe getter (reuses its reconnect logic) if it works
    try:
        folder = monitor.get_my_inbox_folder_safe()
        if folder is not None:
            return folder
    except Exception:
        pass
    # 2) the monitor's namespace directly, if present
    ns = getattr(monitor, "namespace", None)
    if ns is not None:
        try:
            return ns.GetDefaultFolder(6)
        except Exception:
            pass
    # 3) attach to the running Outlook directly
    try:
        import pythoncom
        try:
            pythoncom.CoInitialize()
        except Exception:
            pass
        import win32com.client
        ns2 = win32com.client.Dispatch("Outlook.Application").GetNamespace("MAPI")
        return ns2.GetDefaultFolder(6)
    except Exception as exc:
        raise RuntimeError(f"could not open Inbox (monitor connection not live, and "
                           f"direct Outlook attach failed: {exc})")


def _open_folders(monitor):
    """Folders to scan: the shared Sales inbox (where most customer RFQs land) plus
    the personal Inbox (a few land here too). Returns [(label, folder)], skipping
    any that can't be opened."""
    out = []
    try:
        sales = monitor.find_sales_inbox_folder_safe()
        if sales is not None:
            out.append(("sales", sales))
    except Exception:
        pass
    try:
        personal = _open_inbox(monitor)
        if personal is not None:
            out.append(("inbox", personal))
    except Exception:
        pass
    if not out:
        raise RuntimeError("could not open any mail folder (Sales mailbox not found, Inbox unavailable)")
    return out


def _read_recent_from_folder(folder, days_back: int, max_messages: int) -> List[InboundMail]:
    items = folder.Items
    try:
        items.Sort("[ReceivedTime]", True)   # newest first
    except Exception:
        pass
    cutoff = datetime.now(timezone.utc) - timedelta(days=days_back)
    out: List[InboundMail] = []
    count = 0
    for it in items:
        if count >= max_messages:
            break
        count += 1
        try:
            sender = str(getattr(it, "SenderEmailAddress", "") or "")
            subject = str(getattr(it, "Subject", "") or "")
            body = str(getattr(it, "Body", "") or "")[:_BODY_CAP]
            entry_id = str(getattr(it, "EntryID", "") or "")
            conv = str(getattr(it, "ConversationID", "") or "")
            rt = getattr(it, "ReceivedTime", None)
            received = str(rt) if rt is not None else ""
            try:
                has_att = bool(getattr(it, "Attachments", None) and it.Attachments.Count > 0)
            except Exception:
                has_att = False
        except Exception:
            continue                          # non-mail / COM hiccup -> skip
        if not entry_id or "@" not in sender:
            continue
        try:                                  # items are newest-first -> stop past the window
            if rt is not None and rt.year >= 1900:
                naive = datetime(rt.year, rt.month, rt.day, rt.hour, rt.minute, rt.second, tzinfo=timezone.utc)
                if naive < cutoff:
                    break
        except Exception:
            pass
        out.append(InboundMail(
            message_id=entry_id, sender=sender, subject=subject, body=body,
            conversation_id=conv or None, received_at=received, entry_id=entry_id,
            has_attachments=has_att))
    return out


def _read_recent_inbox(monitor, days_back: int, max_messages: int):
    """Scan all target folders, de-dup by entry_id. Returns (mails, per_folder_counts)."""
    folders = _open_folders(monitor)
    seen, mails, per_folder = set(), [], {}
    for label, folder in folders:
        try:
            got = _read_recent_from_folder(folder, days_back, max_messages)
        except Exception:
            got = []
        per_folder[label] = len(got)
        for m in got:
            if m.entry_id in seen:
                continue
            seen.add(m.entry_id)
            mails.append(m)
    print(f"[quote-pipeline] folders scanned: {per_folder}")
    return mails, per_folder


# ------------------------------- the scan ----------------------------------
def _classify_only(pipeline, mails: List[InboundMail]) -> List[dict]:
    """Dry-run: classify each mail with NO side effects (no queueing, no writes)."""
    store, lookup, scorer = pipeline["store"], pipeline["lookup"], pipeline["router"].scorer
    config = pipeline["router"].config
    rows = []
    for m in mails:
        feats = resolve_features(m, store, lookup, scorer)
        r = classify(feats, config)
        rows.append({"bucket": r.bucket, "auto": r.auto, "sender": m.sender,
                     "subject": m.subject, "reason": r.reason})
    return rows


def _summarize(rows: List[dict]) -> str:
    counts: dict = {}
    for r in rows:
        b = r["bucket"].value if hasattr(r["bucket"], "value") else str(r["bucket"])
        counts[b] = counts.get(b, 0) + 1
    lines = [f"{b}: {n}" for b, n in sorted(counts.items())]
    return "\n".join(lines) if lines else "(no mail in window)"


def _show_jobs(store, needle, info_fn):
    """Read-only dump of jobs and their extracted line items. `needle` of '*'/'all'
    shows everything; otherwise matches a job-id or customer-email substring."""
    needle = (needle or "").strip().lower()
    want_all = needle in ("*", "all")
    jobs = sorted(store.jobs.values(), key=lambda j: j.job_id, reverse=True)
    lines, shown = [], 0
    for job in jobs:
        cust = str(getattr(job.customer, "email", "") or "")
        if not want_all and needle not in job.job_id.lower() and needle not in cust.lower():
            continue
        shown += 1
        life = getattr(job.lifecycle, "value", str(job.lifecycle))
        lines.append(f"{job.job_id}  [{life}]  {cust}")
        if job.line_items:
            for li in job.line_items.values():
                lines.append(f"    \u2022 {li.qty} {li.uom} \u2014 {li.description}")
        else:
            lines.append("    (no line items extracted)")
    body = (f"{shown} job(s):\n\n" + "\n".join(lines)) if shown else \
           f"No jobs match {needle!r} ({len(store.jobs)} job(s) total)."
    print("\n[quote-pipeline] jobs:\n" + body)
    info_fn("Quote Scan \u2014 Jobs", body)


def _open_extractor_for_job(monitor, job, subject=""):
    """Hand a freshly-minted customer RFQ to MaINbox's OWN RFQ & Materials Extractor
    -- the same window you use today (it extracts the email, shows the editable
    grid, your vendor recipients, and Send RFQs Now). Reuses get_email_by_id when
    the mail is in MaINbox's list, else a minimal dict (the flow only needs the
    entry_id + subject and re-reads the rest from Outlook). Best-effort: any
    failure just logs, leaving the ack draft intact."""
    entry_id = str(getattr(getattr(job, "customer", None), "source_entry_id", "") or "")
    opener = getattr(monitor, "open_quote_intelligence_for_selected_email", None)
    if not entry_id or opener is None:
        print(f"[quote-pipeline] {getattr(job,'job_id','?')}: cannot open extractor "
              f"(entry_id={'yes' if entry_id else 'no'}, opener={'yes' if opener else 'no'})")
        return
    email = None
    getter = getattr(monitor, "get_email_by_id", None)
    if getter is not None:
        try:
            email = getter(entry_id)
        except Exception:
            email = None
    if not email:
        # Not in MaINbox's loaded list (common for a freshly-arrived RFQ). Build the
        # dict from what the job already captured from the source RFQ. Including the
        # conversation_id + sender is REQUIRED for Quote Coverage: it keys requested
        # items by ConversationID and matches them to your sent-reply quotes, and it
        # labels the coverage row with the customer. (The body is re-read from Outlook
        # by the extractor via entry_id, so it isn't needed here.)
        cust = getattr(job, "customer", None)
        conv = str(getattr(cust, "conversation_id", "") or "")
        cust_email = str(getattr(cust, "email", "") or "")
        cust_name = str(getattr(cust, "name", "") or "")
        email = {"entry_id": entry_id, "subject": subject or job.job_id,
                 "conversation_id": conv, "sender": cust_name or cust_email,
                 "sender_email": cust_email, "urgency": "Normal", "status": "Needs Reply"}
    try:
        opener(email=email)
        print(f"[quote-pipeline] {job.job_id}: opened RFQ extractor for the customer RFQ")
    except Exception as exc:
        print(f"[quote-pipeline] {job.job_id}: failed to open extractor "
              f"({type(exc).__name__}: {exc})")


def _show_saved(kind, info_fn):
    """Read-only dump of saved sender lists (full add/edit/remove lands in Settings)."""
    kinds = ["customer", "vendor"] if kind in ("*", "all") else [kind]
    lines = []
    for k in kinds:
        emails = sorted(load_saved_senders(k))
        lines.append(f"Saved {k}s ({len(emails)}):")
        if emails:
            lines.extend(f"  \u2022 {e}" for e in emails)
        else:
            lines.append("  (none)")
    body = "\n".join(lines)
    print("\n[quote-pipeline] saved senders:\n" + body)
    info_fn("Quote Scan \u2014 Saved senders", body)


def _show_candidates_window(monitor, pipeline, candidates):
    """End-of-scan checklist of strong-signal RFQs from senders you haven't saved.
    Two checkboxes per row: Quote (mint + ack + open your extractor now) and Add
    (save the sender so future emails auto-quote). Live UI; processing reuses the
    same confirm + handoff path as a recognized RFQ."""
    import tkinter as tk
    from tkinter import messagebox

    root = getattr(monitor, "root", None)
    if root is None:
        print("[quote-pipeline] no Tk root; cannot show RFQ candidate checklist")
        return
    router = pipeline["router"]

    win = tk.Toplevel(root)
    win.title("Quote Pipeline - RFQ candidates (not yet saved customers)")
    win.geometry("900x520")
    try:
        win.transient(root)
    except Exception:
        pass

    tk.Label(win, justify="left", anchor="w", wraplength=860,
             text="These look like RFQs but aren't from a saved customer. Tick "
                  "Quote to draft the ack + open the extractor now, and/or Add to "
                  "save the sender so future emails auto-quote.").pack(fill="x", padx=10, pady=(10, 6))

    mid = tk.Frame(win)
    mid.pack(fill="both", expand=True, padx=10)
    canvas = tk.Canvas(mid, highlightthickness=0)
    sb = tk.Scrollbar(mid, orient="vertical", command=canvas.yview)
    rows_frame = tk.Frame(canvas)
    rows_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
    canvas.create_window((0, 0), window=rows_frame, anchor="nw")
    canvas.configure(yscrollcommand=sb.set)
    canvas.pack(side="left", fill="both", expand=True)
    sb.pack(side="right", fill="y")

    hdr = tk.Frame(rows_frame)
    hdr.pack(fill="x", pady=(0, 4))
    tk.Label(hdr, text="Quote", width=6).pack(side="left")
    tk.Label(hdr, text="Add", width=5).pack(side="left")
    tk.Label(hdr, text="Sender", width=34, anchor="w").pack(side="left")
    tk.Label(hdr, text="Subject", anchor="w").pack(side="left", fill="x", expand=True)

    rowvars = []  # (entry, quote_var, add_var)
    for e in candidates:
        rf = tk.Frame(rows_frame)
        rf.pack(fill="x", pady=1)
        qv, av = tk.BooleanVar(value=False), tk.BooleanVar(value=False)
        tk.Checkbutton(rf, variable=qv, width=4).pack(side="left")
        tk.Checkbutton(rf, variable=av, width=4).pack(side="left")
        tk.Label(rf, text=str(e.get("sender", ""))[:34], width=34, anchor="w").pack(side="left")
        tk.Label(rf, text=str(e.get("subject", ""))[:64], anchor="w").pack(side="left", fill="x", expand=True)
        rowvars.append((e, qv, av))

    def process():
        quoted, saved = [], []
        for entry, qv, av in rowvars:
            sender = str(entry.get("sender", "") or "")
            if av.get() and sender:
                add_saved_sender("customer", sender)
                saved.append(sender)
            if qv.get():
                try:
                    job, _follow = router.confirm_new_customer(entry["message_id"])
                    quoted.append((job.job_id, sender))
                    if QUOTE_PIPELINE_OPEN_EXTRACTOR:
                        _open_extractor_for_job(monitor, job, entry.get("subject", ""))
                except Exception:
                    traceback.print_exc()
        win.destroy()
        msg = []
        if quoted:
            msg.append("Quoted (minted + ack drafted):\n" +
                       "\n".join(f"  \u2022 {who} ({jid})" for jid, who in quoted))
        if saved:
            msg.append("Saved to customers (auto-quote next time):\n" +
                       "\n".join(f"  \u2022 {s}" for s in saved))
        messagebox.showinfo("Quote Pipeline", "\n\n".join(msg) if msg else "Nothing selected.", parent=root)

    btns = tk.Frame(win)
    btns.pack(fill="x", padx=10, pady=10)
    tk.Button(btns, text="Cancel", command=win.destroy).pack(side="right", padx=4)
    tk.Button(btns, text="Process Selected", command=process,
              font=("Segoe UI", 10, "bold")).pack(side="right", padx=4)


def run_quote_scan(monitor):
    """Entry point called by the button. Honors the safety dials above."""
    try:
        from tkinter import messagebox
    except Exception:
        messagebox = None

    def _info(title, text):
        print(f"\n=== {title} ===\n{text}\n")
        if messagebox is not None:
            try:
                messagebox.showinfo(title, text)
            except Exception:
                pass

    if not QUOTE_PIPELINE_ENABLED:
        _info("Quote Pipeline", "Quote pipeline is OFF.\nSet QUOTE_PIPELINE_ENABLED = True in "
                                "mainbox_quote_pipeline_entry.py to enable.")
        return

    try:
        pipeline = _build_pipeline(monitor)
    except Exception:
        traceback.print_exc()
        _info("Quote Pipeline \u2014 Error", "Could not build the pipeline (see console).")
        return

    # ---- READ-ONLY: view jobs + their extracted items (no scan) ------------
    show = (QUOTE_PIPELINE_SHOW_JOBS or "").strip()
    if show:
        _show_jobs(pipeline["store"], show, _info)
        return

    # ---- READ-ONLY: view saved sender lists (no scan) ----------------------
    saved_show = (QUOTE_PIPELINE_SHOW_SAVED or "").strip()
    if saved_show:
        _show_saved(saved_show, _info)
        return

    try:
        mails, per_folder = _read_recent_inbox(monitor, SCAN_DAYS_BACK, SCAN_MAX_MESSAGES)
    except Exception:
        traceback.print_exc()
        _info("Quote Pipeline \u2014 Error",
              "Scan failed (see console). Make sure Outlook desktop is open, then try again.\n"
              "Nothing was changed.")
        return

    # ---- DRY RUN: classify + report, touch nothing -------------------------
    if QUOTE_PIPELINE_DRY_RUN:
        rows = _classify_only(pipeline, mails)
        for r in rows:
            b = r["bucket"].value if hasattr(r["bucket"], "value") else str(r["bucket"])
            print(f"[dry-run] {b:18} {r['sender']:32} {r['subject'][:50]!r}  ({r['reason']})")
        _info("Quote Scan (dry run)",
              f"Scanned {len(mails)} message(s) from {per_folder}. No changes made.\n\n{_summarize(rows)}\n\n"
              "Flip QUOTE_PIPELINE_DRY_RUN = False to start drafting.")
        return

    # ---- LIVE: route, then mint up to N newest new-customer RFQs ------------
    router = pipeline["router"]
    inbound = pipeline["inbound"]

    # ---- READ-ONLY: preview triage candidates (set QUOTE_PIPELINE_LIST_TRIAGE) --
    list_needle = (QUOTE_PIPELINE_LIST_TRIAGE or "").strip()
    if list_needle:
        items = (list(inbound.triage) if list_needle in ("*", "all")
                 else _match_triage(inbound.triage, list_needle, None))
        items.sort(key=lambda e: e.get("received_at", ""), reverse=True)
        lines = []
        for idx, e in enumerate(items, 1):
            sig = _triage_signal(monitor, e.get("entry_id", ""))
            ln = (f"  [{idx}] {str(e.get('received_at',''))[:16]}  {e.get('sender','')}  "
                  f"{str(e.get('subject',''))[:45]!r}\n        -> {sig}")
            print(ln)
            lines.append(ln)
        body = (f"Triage holds {len(inbound.triage)} item(s); "
                f"{len(items)} match {list_needle!r} (newest first):\n\n"
                + ("\n".join(lines) if lines else "  (no matches)")
                + "\n\nThis was read-only -- nothing minted. To mint one, clear "
                  "QUOTE_PIPELINE_LIST_TRIAGE and set QUOTE_PIPELINE_CONFIRM_TRIAGE "
                  "to a substring that uniquely picks it.")
        _info("Quote Scan \u2014 Triage preview", body)
        return

    routed = [router.handle(m) for m in mails]

    # the pending queue holds ONLY new-customer RFQs (that's the sole bucket that
    # queues there), so every entry is mintable. Newest first, capped.
    pending_new = list(inbound.pending)
    pending_new.sort(key=lambda e: e.get("received_at", ""), reverse=True)

    # CONFIRM_TRIAGE is an explicit, targeted action -- when it's set, the standing
    # auto-mint pass stands down so a targeted scan does ONLY the targeted thing (no
    # surprise second mint). MAX_MINT_PER_SCAN = 0 disables auto-mint entirely.
    needle = (QUOTE_PIPELINE_CONFIRM_TRIAGE or "").strip().lower()
    auto_targets = _auto_mint_targets(pending_new, needle, QUOTE_PIPELINE_MAX_MINT_PER_SCAN)

    minted = []
    to_open = []                                  # (job, subject) pairs to hand to the extractor
    for entry in auto_targets:
        try:
            job, _follow = router.confirm_new_customer(entry["message_id"])
            minted.append((job.job_id, entry.get("sender", "")))
            to_open.append((job, entry.get("subject", "")))
        except Exception:
            traceback.print_exc()

    # ---- optional: promote a TRIAGE item you target by sender/subject substring.
    # Triage items never auto-mint; this is the manual lever (until a triage UI
    # exists) and the way to push a known RFQ-with-attachment into extraction.
    confirmed = []
    if needle:
        matches = _match_triage(inbound.triage, needle, 1)   # newest match; explicit, independent of auto cap
        if not matches:
            print(f"[quote-pipeline] no triage item matches {needle!r} "
                  f"(triage holds {len(inbound.triage)} item(s))")
        for entry in matches:
            try:
                job, _follow = router.confirm_new_customer(entry["message_id"])
                confirmed.append((job.job_id, entry.get("sender", ""), entry.get("subject", "")))
                to_open.append((job, entry.get("subject", "")))
            except Exception:
                traceback.print_exc()

    summary = (f"Scanned {len(mails)} message(s).\n"
               f"Routed to queues; minted {len(minted)} new RFQ job(s) "
               f"(cap {QUOTE_PIPELINE_MAX_MINT_PER_SCAN}/scan).\n")
    if minted:
        summary += "Drafted 'I will advise' ack(s) for:\n" + \
                   "\n".join(f"  \u2022 {who} ({jid})" for jid, who in minted)
    if confirmed:
        summary += ("\nConfirmed triage RFQ(s) matching %r (minted + drafted ack):\n" % needle) + \
                   "\n".join(f"  \u2022 {who} \u2014 {subj[:40]} ({jid})"
                             for jid, who, subj in confirmed)
    if not minted and not confirmed and not needle:
        summary += ("\nNothing minted: the only auto-mint bucket is new-customer RFQs from "
                    "recognized senders, and those are already processed. Real RFQs from "
                    "unrecognized senders sit in TRIAGE -- set QUOTE_PIPELINE_CONFIRM_TRIAGE "
                    "to a subject/sender substring to mint one.")
    if to_open and QUOTE_PIPELINE_OPEN_EXTRACTOR:
        summary += "\n\nOpening the RFQ & Materials Extractor for the RFQ(s) above..."
    _info("Quote Scan", summary)

    # ---- handoff: open MaINbox's own RFQ extractor on each minted RFQ ------
    if QUOTE_PIPELINE_OPEN_EXTRACTOR:
        for job, subject in to_open:
            _open_extractor_for_job(monitor, job, subject)

    # ---- ask about strong-signal RFQs from senders you haven't saved -------
    if QUOTE_PIPELINE_ASK_UNRECOGNIZED:
        candidates = _quote_candidates(inbound.triage, _recognized_customers())
        if candidates:
            print(f"[quote-pipeline] {len(candidates)} unrecognized RFQ candidate(s) -> checklist")
            _show_candidates_window(monitor, pipeline, candidates)
        else:
            print("[quote-pipeline] no unrecognized RFQ candidates to ask about")
