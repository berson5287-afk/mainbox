    def _inbox_viewer_deleted_path(self):
        return data_path("mainbox_inbox_viewer_deleted.json")

    def _load_inbox_viewer_deleted(self):
        try:
            with open(self._inbox_viewer_deleted_path(), "r", encoding="utf-8") as f:
                data = json.load(f)
            return data if isinstance(data, list) else []
        except Exception:
            return []

    def _save_inbox_viewer_deleted(self, records):
        try:
            with open(self._inbox_viewer_deleted_path(), "w", encoding="utf-8") as f:
                json.dump(records, f, indent=1)
            return True
        except Exception:
            return False

    def _inbox_viewer_folder_sel_for_label(self, label):
        """Map a pane/mailbox label back to its saved folder pick (so restore
        knows which inbox to move the email back into)."""
        try:
            sels = self._inbox_viewer_selected_folders()
            labels = self._inbox_viewer_pane_labels()
            for sel, lbl in zip(sels, labels):
                if lbl == label:
                    return sel
        except Exception:
            pass
        return None

    def _inbox_viewer_locate_deleted_items(self, namespace, store_id):
        """WORKER-THREAD ONLY. The Deleted Items folder of the store the email
        lived in (locale-safe Store hop), falling back to the default store's."""
        try:
            if store_id:
                folders = namespace.Folders
                for i in range(1, folders.Count + 1):
                    try:
                        root = folders.Item(i)
                        if str(getattr(getattr(root, "Store", None), "StoreID", "") or "") == str(store_id):
                            return root.Store.GetDefaultFolder(3)  # olFolderDeletedItems
                    except Exception:
                        continue
        except Exception:
            pass
        try:
            return namespace.GetDefaultFolder(3)
        except Exception:
            return None

    def _inbox_viewer_find_by_message_id(self, folder, imid):
        """WORKER-THREAD ONLY. DASL find by Internet Message-ID (durable across
        the EntryID churn a folder move causes). Same proptag pair as the
        existing reopen fallbacks."""
        if folder is None or not imid:
            return None
        q = str(imid).replace("'", "''")
        for tag in ("0x1035001F", "0x1035001E"):
            try:
                found = folder.Items.Find(
                    "@SQL=\"http://schemas.microsoft.com/mapi/proptag/" + tag + "\" = '" + q + "'")
                if found is not None:
                    return found
            except Exception:
                continue
        return None

    def _inbox_viewer_delete_selected(self, event=None):
        """Delete key / context menu: move the selected viewer emails to their
        mailbox's Deleted Items (exactly what Delete does in Outlook), record
        them in the viewer's deleted history, and offer an Undo toast."""
        trees = [t for _l, t in getattr(self, "_inbox_viewer_trees", None) or []]
        active = getattr(self, "_inbox_viewer_active_tree", None)
        if active in trees:
            trees = [active] + [t for t in trees if t is not active]
        rows = []
        for tree in trees:
            rows = self._inbox_viewer_rows_for_tree_selection(tree)
            if rows:
                break
        if not rows:
            return "break"
        try:
            self._inbox_viewer_status_var.set(f"Deleting {len(rows)} email(s)...")
        except Exception:
            pass
        jobs = [dict(r) for r in rows]

        def work(outlook, namespace):
            deleted = []
            for row in jobs:
                try:
                    if row.get("store_id"):
                        msg = namespace.GetItemFromID(row["entry_id"], row["store_id"])
                    else:
                        msg = namespace.GetItemFromID(row["entry_id"])
                    imid = str(row.get("message_id", "") or "")
                    if not imid:
                        try:
                            imid = outlook_msg_internet_id(msg)
                        except Exception:
                            imid = ""
                    msg.Delete()
                    deleted.append({
                        "message_id": imid,
                        "entry_id": row.get("entry_id", ""),
                        "store_id": row.get("store_id", ""),
                        "subject": row.get("subject", ""),
                        "sender": row.get("sender", ""),
                        "sender_email": row.get("sender_email", ""),
                        "received": row.get("received", ""),
                        "folder": row.get("folder", ""),
                        "folder_sel": self._inbox_viewer_folder_sel_for_label(row.get("folder", "")),
                        "deleted_at": datetime.now().isoformat(timespec="seconds"),
                    })
                except Exception:
                    continue
            return deleted

        def done(deleted):
            deleted = deleted or []
            if deleted:
                hist = self._load_inbox_viewer_deleted()
                hist.extend(deleted)
                self._save_inbox_viewer_deleted(hist)
                gone = {d["entry_id"] for d in deleted}
                self._inbox_viewer_rows = [r for r in (self._inbox_viewer_rows or [])
                                           if r.get("entry_id") not in gone]
                self._render_inbox_viewer_rows()
                # v4.2.65 (Steve): a viewer delete lands in MaINbox's Deleted
                # History IMMEDIATELY (previously the sync sweep mirrored it
                # minutes later). Ingested rows go through the existing
                # app-delete choke point; not-ingested emails have no app row
                # to delete and are covered by the viewer history alone.
                try:
                    _app_rows = [self.get_email_by_id(eid) for eid in gone]
                    _app_rows = [r for r in _app_rows if isinstance(r, dict)]
                    if _app_rows:
                        self.perform_app_delete(_app_rows, "cancel")
                        ops_log("inbox_viewer", "delete_mirrored_to_app", count=len(_app_rows))
                except Exception:
                    pass
            failed = len(jobs) - len(deleted)
            note = f"Deleted {len(deleted)} email(s) to Deleted Items"
            if failed:
                note += f" ({failed} could not be deleted)"
            try:
                self._inbox_viewer_status_var.set(note + ".")
            except Exception:
                pass
            ops_log("inbox_viewer", "emails_deleted", count=len(deleted), failed=failed)
            if deleted:
                self._show_undo_toast(getattr(self, "_inbox_viewer_win", None) or self.root,
                                      note, action=lambda d=deleted: self._inbox_viewer_undelete(d))

        def error(exc):
            try:
                self._inbox_viewer_status_var.set(f"Delete failed: {exc}")
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-delete")
        return "break"

    def _inbox_viewer_undelete(self, records, on_finish=None):
        """Move emails back out of Deleted Items into their original inbox.
        Located by Message-ID; restored records leave the history."""
        jobs = [dict(r) for r in (records or []) if isinstance(r, dict)]
        if not jobs:
            return
        try:
            self._inbox_viewer_status_var.set(f"Restoring {len(jobs)} email(s)...")
        except Exception:
            pass

        def work(outlook, namespace):
            restored = []
            for rec in jobs:
                try:
                    deleted_folder = self._inbox_viewer_locate_deleted_items(namespace, rec.get("store_id", ""))
                    msg = self._inbox_viewer_find_by_message_id(deleted_folder, rec.get("message_id", ""))
                    if msg is None:
                        continue
                    target = None
                    sel = rec.get("folder_sel")
                    if isinstance(sel, dict):
                        try:
                            target, _lbl = self._inbox_viewer_resolve_folder(namespace, sel)
                        except Exception:
                            target = None
                    if target is None:
                        try:
                            target = deleted_folder.Store.GetDefaultFolder(6)
                        except Exception:
                            target = namespace.GetDefaultFolder(6)
                    msg.Move(target)
                    restored.append(rec.get("message_id", "") or rec.get("entry_id", ""))
                except Exception:
                    continue
            return restored

        def done(restored):
            restored = set(restored or [])
            if restored:
                hist = self._load_inbox_viewer_deleted()
                hist = [r for r in hist
                        if (r.get("message_id") or r.get("entry_id")) not in restored]
                self._save_inbox_viewer_deleted(hist)
                # v4.2.65: un-deleting in the viewer also un-deletes the app
                # side (the delete now mirrors immediately, so the restore
                # must too -- flags cleared, guard cleared, snapshot re-added).
                try:
                    _eids = [str(r.get("entry_id", "") or "") for r in jobs
                             if (r.get("message_id") or r.get("entry_id")) in restored]
                    _eids = [e for e in _eids
                             if e and isinstance(self.status_data.get(e), dict)
                             and self.status_data[e].get("app_deleted")]
                    if _eids:
                        self._undelete_app_emails(_eids, reason="viewer_restore")
                except Exception:
                    pass
            note = f"Restored {len(restored)} of {len(jobs)} email(s)."
            if len(restored) < len(jobs):
                note += " Unfound ones may have been moved or purged in Outlook."
            try:
                self._inbox_viewer_status_var.set(note)
            except Exception:
                pass
            ops_log("inbox_viewer", "emails_restored", restored=len(restored), asked=len(jobs))
            self._inbox_viewer_refresh(quiet=True)
            if on_finish:
                try:
                    on_finish()
                except Exception:
                    pass

        def error(exc):
            try:
                self._inbox_viewer_status_var.set(f"Restore failed: {exc}")
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-undelete")

    def open_inbox_viewer_deleted_history(self):
