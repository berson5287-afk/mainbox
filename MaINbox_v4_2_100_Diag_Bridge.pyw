    # ===================== Customizable main-screen buttons =====================
    # The four main button bars (left group/tools column, the Edit-Selected bar, the
    # Filters bar, and the bottom Action bar) are rendered from a single manifest so
    # the user can hide/show and reorder buttons (Settings -> Visual Settings -> Edit
    # Buttons). Each button's exact command/styling lives in its manifest 'make' so
    # behavior is identical to before; only WHICH buttons show and in WHAT order is
    # driven by a saved layout file.

    def _main_button_specs(self):
        """Single source of truth for every customizable main-screen button.
        Returns {toolbar_key: [ {id, label, section, make(parent)->Button, ...} ]}.
        'section' drives the default grouping/separator on the vertical group bar."""
        B = tk.Button

        def grp(parent, text, cmd):
            return B(parent, text=text, command=cmd, width=17)

        specs = {
            "group": [
                {"id": "new_group", "label": "New Group", "section": "group",
                 "make": lambda p: grp(p, "New Group", self.create_group)},
                {"id": "rename_group", "label": "Rename Group", "section": "group",
                 "make": lambda p: grp(p, "Rename Group", self.rename_selected_group)},
