                                       ["Opened from RFQ Review"], False))).pack(side="right", padx=3)

        # ---------------- message (v4.2.64: generic default + apply-to-all) ----
        msg_frame = tk.Frame(win, bg=_BG)
        msg_frame.pack(fill="x", padx=12, pady=(2, 0))
        msg_head = tk.Frame(msg_frame, bg=_BG)
        msg_head.pack(fill="x")
        tk.Label(msg_head, text="Message (each vendor's item list is added after it):",
                 font=(_FONT, _FONT_SIZE, "bold"), fg=_ACCENT, bg=_BG).pack(side="left")
        apply_all_var = tk.BooleanVar(value=True)

        def toggle_apply_all():
            for c in cards:
                m = c.get("msg")
                if m is None:
                    continue
                if apply_all_var.get():
                    m.pack_forget()
                else:
                    if not m.get("1.0", tk.END).strip():
                        m.insert("1.0", shared_msg.get("1.0", tk.END).strip())
                    m.pack(fill="x", padx=6, pady=(0, 6))

        tk.Checkbutton(msg_head, text="Apply same message to all vendors",
                       variable=apply_all_var, command=toggle_apply_all,
                       bg=_BG, fg=_FG, selectcolor=_BG3,
                       activebackground=_BG).pack(side="left", padx=14)
        shared_msg = tk.Text(msg_frame, height=3, bg=_BG3, fg=_FG, wrap="word",
                             font=(_FONT, _FONT_SIZE))
        shared_msg.insert("1.0", "Good morning,\n\nPlease provide price and availability for the following:")
        shared_msg.pack(fill="x", pady=(2, 0))

        # ---------------- prefill: per-ITEM vendor suggestions ----------------
        buckets = {}
        try:
            for ix, it in enumerate(items):
                try:
                    top = (self.suggest_vendors_for_materials([it], customer_hint) or [])[:1]
                except Exception:
                    top = []
                for v in top:
                    em = str(v.get("email", "") or "").lower().strip()
                    if em:
                        buckets.setdefault(em, set()).add(ix)
        except Exception:
            pass
        for em, ixs in list(buckets.items())[:8]:
            add_card(to=em, ixs=ixs)
        for v in (vendors or [])[:5]:
            em = str(v.get("email", "") or "").lower().strip()
            if em and em not in buckets:
                add_card(to=em)
        if not cards:
            show_placeholder()  # v4.2.64: Add Vendor button instead of a blank card
        refresh_items()

        # ---------------- bottom: send all ----------------
        def send_all():
            live = [c for c in cards if c["to"].get().strip() and c["items"]]
            if not live:
                messagebox.showwarning("Nothing to Send",
                                       "Assign at least one item to a vendor with a To address.", parent=win)
                return
            n_items = len({ix for c in live for ix in c["items"]})
            if not messagebox.askyesno(
                    "Send All RFQs",
                    f"Send {len(live)} email(s) -- one per vendor -- covering {n_items} item(s)?",
                    parent=win):
                return
            emails_for_group = self.get_emails_for_group(group_id) or []
            subject = f"Price and Availability Request - {gname}"[:150]
            sent = 0
            errors = []
            for c in live:
                to = c["to"].get().strip()
                cc = c["cc"].get().strip()
                mats = [items[ix] for ix in sorted(c["items"]) if 0 <= ix < len(items)]
                lines = "\n".join(
                    f"{(str(m.get('qty', '')) + ' ' + str(m.get('unit', ''))).strip()} - {m.get('description', '')}".strip(" -")
                    for m in mats)
                # v4.2.64: shared message by default; per-vendor text when
                # 'apply same message to all' is unchecked.
                msg_txt = shared_msg.get("1.0", tk.END).strip()
                if not apply_all_var.get():
                    m_widget = c.get("msg")
                    if m_widget is not None:
                        _own_txt = m_widget.get("1.0", tk.END).strip()
                        if _own_txt:
                            msg_txt = _own_txt
                if not msg_txt:
                    msg_txt = "Good morning,\n\nPlease provide price and availability for the following:"
                body = f"{msg_txt}\n\n{lines}\n\nThank you"
                try:
                    self.create_outlook_mail_item(to, subject, body, display_only=False, cc=cc)
                    sent += 1
                    try:
                        self.learn_vendor_history_from_rfq([{"email": to}], mats, group, emails_for_group)
                    except Exception:
                        pass
                    try:
                        self.record_procurement_request([{"email": to}], mats, group, subject=subject)
                    except Exception:
                        pass
                    try:
                        rec = self.get_coverage_record("grp:" + str(group_id), create=False)
                        if isinstance(rec, dict):
                            rec.setdefault("line_vendor_sends", []).append({
                                "vendor": to, "cc": cc,
                                "line_ids": [str(items[ix].get("line_id", "") or ix) for ix in sorted(c["items"])],
                                "descriptions": [str(items[ix].get("description", ""))[:60] for ix in sorted(c["items"])],
                                "at": datetime.now().isoformat()})
                            self.save_quote_coverage()
                    except Exception:
                        pass
                    ops_log("coverage", "rfq_review_sent", gid=str(group_id), vendor=to,
                            items=len(mats), cc=bool(cc))
                except Exception as exc:
                    errors.append(f"{to}: {exc}")
            note = f"Sent {sent} RFQ email(s) for '{gname[:40]}'."
            if errors:
                note += f" {len(errors)} failed: " + "; ".join(errors[:2])
            try:
                self.set_status(note)
            except Exception:
                pass
            messagebox.showinfo("RFQs Sent", note, parent=win)
            win.destroy()

        bot = tk.Frame(win, bg=_BG)
        bot.pack(fill="x", padx=12, pady=(2, 10))

        def add_vendor_via_picker():
            # v4.2.62 (Steve): pull open the saved vendors -- searchable, with
            # a New option for a blank card (mirrors the extractor's flow).
            res = self._pick_saved_vendor(win)
            if res is None:
                return
            add_card(to=res)

        tk.Button(bot, text="Add Vendor", width=12, command=add_vendor_via_picker).pack(side="left", padx=4)
        send_btn = tk.Button(bot, text=f"Send All RFQs Now", width=20, command=send_all,
                             bg=_ACCENT, fg="#ffffff", activebackground=_ACCENT2,
                             activeforeground="#ffffff", font=(_FONT, _FONT_SIZE, "bold"))
        send_btn.pack(side="right", padx=4)
        tk.Button(bot, text="Close", width=10, command=win.destroy).pack(side="right", padx=4)
        win.bind("<Escape>", lambda e: win.destroy())
        ops_log("coverage", "rfq_review_opened", gid=str(group_id), items=len(items),
                cards=len(cards))

    def _prepare_rfq_for_intake(self, group_id, thread_key, subject, customer_hint):
        """v4.2.58 Phase 2 (Steve's vision): when intake creates a grouped quote
        job, prepare its RFQ immediately -- read the ledger's Requested lines,
        run the vendor suggester, and seed the RFQ cache so Quote RFQ opens
        INSTANTLY pre-populated (items + suggested vendors). The user's flow
        becomes: notification -> open -> review recipients -> Send RFQs Now.
        MAIN THREAD ONLY (marshaled from the scan worker via root.after)."""
        try:
            gid = str(group_id or "").strip()
            if not gid or not self.get_group_by_id(gid):
                return
            rec = self.get_coverage_record("grp:" + gid, create=False)
            if not isinstance(rec, dict) or rec.get("dismissed"):
                return
            lines = [l for l in (rec.get("requested") or []) if isinstance(l, dict)]
            if len(lines) < 1:
                return
            existing = self.get_rfq_cache_record(gid)
            if existing and normalize_material_items(existing.get("materials", [])):
                return  # a prepared/extracted RFQ already exists -- never clobber it
            mats = normalize_material_items([{
                "qty": l.get("qty", ""), "unit": l.get("unit", ""),
                "part_number": l.get("part_number", ""),
                "description": l.get("description", ""),
            } for l in lines], keep_duplicates=True)
            if not mats:
                return
            vendors = []
            try:
                vendors = self.suggest_vendors_for_materials(mats, customer_hint) or []
            except Exception:
                vendors = []
            self.record_rfq_cache(gid, materials=mats, vendors=vendors,
                                  ocr_details=["Prepared automatically from the customer request (intake Phase 2)."],
                                  used_ai=False)
            ops_log("coverage", "rfq_prepared", gid=gid, items=len(mats),
                    vendors=len(vendors), subj=str(subject or "")[:80])
            try:
                _g = self.get_group_by_id(gid) or {}
                self.set_status(
                    f"RFQ prepared: '{_g.get('name', subject)[:50]}' -- {len(mats)} item(s), "
                    f"{len(vendors)} suggested vendor(s). Select the group and click Quote RFQ to review & send.")
            except Exception:
                pass
            # v4.2.60 Phase 2.1 (Steve): open the review window RIGHT NOW --
            # items + assigned vendors on screen, user edits/adds/removes, and
            # one button (Send RFQs Now) fires every vendor email at once.
            # Skipped when an RFQ window for this group is already open.
            if bool(self.settings.get("auto_open_rfq_on_intake", True)):
                try:
                    if gid not in (getattr(self, "_rfq_live_windows", {}) or {}):
                        try:
                            self.render_group_rows()
                        except Exception:
                            pass
                        # v4.2.61 Phase 2.2: the purpose-built Review & Send window
                        # (per-vendor item subsets + CC) replaces the extractor as
                        # the intake auto-open; setting rfq_review_window (default
                        # ON) falls back to the extractor when off.
                        if bool(self.settings.get("rfq_review_window", True)):
                            self.open_rfq_review_window(gid, mats, vendors, customer_hint)
                        else:
                            self.open_quote_intelligence_window(
                                gid, mats, vendors,
                                ["Prepared automatically from the customer request (intake Phase 2.1)."],
                                False)
                        ops_log("coverage", "rfq_auto_opened", gid=gid)
                except Exception:
                    pass
        except Exception:
            pass

    def suggest_vendors_for_materials(self, materials, customer_hint=""):
        vendor_scores = {}
        vendor_reasons = {}
        hist = self.vendor_history or default_vendor_history()
        # v2.8.4V: procurement memory has stronger signal than basic vendor history.
        for pv in self.procurement_suggest_vendors_for_materials(materials, limit=20):
            email = str(pv.get("email", "") or "").lower().strip()
            if email and not is_blocked_internal_vendor(email, pv.get("name", "")):
                vendor_scores[email] = vendor_scores.get(email, 0) + int(pv.get("score", 0) or 0) + 25
                vendor_reasons.setdefault(email, set()).add("procurement memory: " + str(pv.get("reason", "")))
        for item in materials or []:
            key = normalize_material_key(item.get("part_number", ""), item.get("description", ""))
            matches = hist.get("materials", {}).get(key, [])
            if not matches and item.get("description"):
                desc = str(item.get("description", "")).lower()
                for mat_key, mat_matches in hist.get("materials", {}).items():
                    if mat_key and (mat_key in desc or desc[:30] in mat_key):
                        matches.extend(mat_matches[:3])
            for match in matches:
                email = str(match.get("email", "") or "").lower().strip()
                if not email or is_blocked_internal_vendor(email, match.get("name", "")):
                    continue
                vendor_scores[email] = vendor_scores.get(email, 0) + 3 + int(match.get("times_used", 1) or 1)
                vendor_reasons.setdefault(email, set()).add(f"matched {item.get('part_number') or item.get('description','item')}")
        if customer_hint:
            for email, rec in hist.get("customers", {}).get(customer_hint, {}).items():
                if is_blocked_internal_vendor(email, rec.get("name", "")):
                    continue
                vendor_scores[email] = vendor_scores.get(email, 0) + int(rec.get("times_used", 1) or 1) + 2
                vendor_reasons.setdefault(email, set()).add("used for this customer/job before")
        # v2.9.5: Do NOT add every known vendor to every RFQ.
        # Vendors should only appear when they match the current material/customer
        # through procurement memory, material history, or customer/job history.
        # This fixes real vendors like David Lesser/Leviton appearing universally.
        ranked = []
        for email, score in sorted(vendor_scores.items(), key=lambda x: x[1], reverse=True)[:12]:
            rec = hist.get("vendors", {}).get(email, {}) or (self.procurement_memory or {}).get("vendors", {}).get(email, {})
            if is_blocked_internal_vendor(email, rec.get("name", "")):
                continue
            ranked.append({"email": email, "name": rec.get("name", email), "score": score, "reason": "; ".join(sorted(vendor_reasons.get(email, [])))})
        return ranked

