                                + str(_AUTO_GROUP_ENGINE_IMPORT_ERROR or "module missing"))
        if COVERAGE_INTAKE_ENGINE_AVAILABLE:
            lines.append(f"Coverage Intake Engine: Loaded v{COVERAGE_INTAKE_ENGINE_VERSION}")
        else:
            lines.append("Coverage Intake Engine: UNAVAILABLE")
            if self.settings.get("coverage_intake_engine_enabled", True):
                problems.append("Coverage Intake Engine unavailable -- customer-attachment ingestion is PAUSED\n"
                                "(rows are quarantined to Attachment Review, not committed).\n"
                                + str(_COVERAGE_INTAKE_IMPORT_ERROR or "module missing"))
        if PO_MATCH_ENGINE_AVAILABLE:
