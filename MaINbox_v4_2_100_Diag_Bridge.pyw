        def append_live_rfq_rows(rows, source_name="", page_number=None, preview_path=""):
            """Append page-ready RFQ rows while extraction continues in the background."""
            try:
                new_rows = normalize_material_items(rows or [])
                if not new_rows:
                    return 0
                existing = set()
                for m in mat_items:
                    existing.add(re.sub(r"\s+", " ", f"{m.get('qty','')}|{m.get('unit','')}|{m.get('description','')}|{m.get('part_number','')}".lower()).strip())
                added = 0
                for m in new_rows:
                    key = re.sub(r"\s+", " ", f"{m.get('qty','')}|{m.get('unit','')}|{m.get('description','')}|{m.get('part_number','')}".lower()).strip()
                    if key and key in existing:
                        continue
                    existing.add(key)
                    if page_number and not m.get("source_page"):
                        m["source_page"] = f"{source_name} page {page_number}"
                    # v4.2.0 (FINDING E): was an unconditional True, which would re-check a
                    # row the letterhead pass had just unchecked. Rows arriving WITHOUT the
                    # key still default to True, so behaviour is unchanged for everything
                    # except the rows v4.2.0 itself deselects.
                    m["selected"] = bool(m.get("selected", True))
                    mat_items.append(m)
                    added += 1
                if preview_path:
                    detail = f"{source_name} page {page_number}: rendered PDF page image saved for debug: {preview_path}"
                    if detail not in ocr_details:
                        ocr_details.append(detail)
                if added:
                    redraw_materials()
                    save_current_rfq_cache()
                    try:
                        if left_view_mode.get("mode") == "scan":
                            _load_scan_preview_image(True)
                    except Exception:
                        pass
                return added
            except Exception:
                return 0

