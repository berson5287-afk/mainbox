def get_app_data_dir():
    """Return a per-user writable data folder that works for .py and PyInstaller .exe builds."""
    base = os.environ.get("LOCALAPPDATA")
    if not base:
        base = os.path.join(os.path.expanduser("~"), "AppData", "Local")
    app_dir = os.path.join(base, APP_NAME)
    os.makedirs(app_dir, exist_ok=True)
    return app_dir


APP_DATA_DIR = get_app_data_dir()

# v4.1.15: monotonic machine-local close ledger. This intentionally lives OUTSIDE
# %LOCALAPPDATA%\MaINbox so restoring a stale full snapshot from another PC cannot
# roll a newer Completed/Low/Junk/app-deleted decision back to New on this machine.
DEVICE_GUARD_DIR = os.path.join(os.path.dirname(APP_DATA_DIR), "MaINbox_DeviceGuard")
CLOSED_EMAIL_GUARD_FILE = os.path.join(DEVICE_GUARD_DIR, "closed_email_guard.json")

# v3.9.84: install crash / silent-exit capture as EARLY as possible -- right
# after the data dir exists and before any Outlook/COM scan can run. crash_guard
# is a sibling module that lives next to this .pyw. A .pyw has no console, so
# tracebacks normally vanish and a native Outlook/COM access violation kills the
# process with nothing logged ("MaINbox just closed by itself"). crash_guard
# routes all of that -- native faults via faulthandler, uncaught main/thread
# exceptions, and Tk callback errors -- into mainbox_crash.log in APP_DATA_DIR,
# right beside coverage_debug.log. The whole thing is wrapped: if crash_guard.py
# is ever missing or fails to load, MaINbox launches exactly as it did before.
try:
    import crash_guard
    crash_guard.install(APP_DATA_DIR)
    crash_guard.patch_tk_class()
except Exception:
    pass


