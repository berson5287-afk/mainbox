    try:
        merged["quote_completion_followup_minute"] = max(0, min(59, int(merged.get("quote_completion_followup_minute", 0))))
    except Exception:
        merged["quote_completion_followup_minute"] = 0
    # v3.8.15 stock + substitute intelligence
    merged["stock_subs_enabled"] = bool(merged.get("stock_subs_enabled", True))
    merged["stock_subs_ai_substitutes"] = bool(merged.get("stock_subs_ai_substitutes", True))
    try:
