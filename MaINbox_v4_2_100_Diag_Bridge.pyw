                dirty = True
            if dirty or added_total:
                self.save_quote_coverage()
        except Exception:
            pass
        if added_total:
            try:
                self.root.after(0, self.update_coverage_status_label)
            except Exception:
                pass
        ops_log("scan", "customer_request_pass", added=added_total)
        return added_total

    def check_pending_sent_replies(self):
        manual_sent_updates = 0
        try:
            manual_sent_updates = self.scan_recent_sent_waiting_trackers(max_items=50, lookback_days=7)
        except Exception:
            manual_sent_updates = 0
        if not getattr(self, "pending_reply_checks", None):
            if manual_sent_updates:
                self.sort_emails_for_display()
                self.render_email_rows()
                try:
                    self.render_group_rows()
                except Exception:
                    pass
            return manual_sent_updates
        changed = False
        completed_count = 0
        self._begin_placeholder_batch()  # v3.8.24: coalesce per-reply placeholder writes/syncs
        for pending in self.pending_reply_checks:
            if pending.get("completed") or pending.get("cancelled"):
                continue
            email = self.get_email_by_id(pending.get("entry_id", "")) or self.find_email_for_followup_item(pending)
            if email and self.email_is_completed(email):
                pending["cancelled"] = True
                pending["cancelled_at"] = datetime.now().isoformat()
                pending["cancel_reason"] = "Cancelled automatic tracking: email marked Completed"
                changed = True
                continue
            sent_msg = self.find_sent_reply_for_pending_check(pending)
            if not sent_msg:
                continue
            if self.is_sent_message_thank_you_only(sent_msg):
                if email:
                    email["status"] = "Completed"
                    email["followup_time"] = ""
                    email["is_new_import"] = False
                    email["sent_waiting_tracker_active"] = False
                    email["smart_followup_closed_reason"] = "Simple thank-you/acknowledgement reply sent."
                    self.save_record(email)
                pending["completed"] = True
                pending["completed_at"] = datetime.now().isoformat()
                pending["completed_reason"] = "simple_ack_reply_found_in_sent_items"
                completed_count += 1
                changed = True
                continue
            # v4.1.83 (deferred from v4.1.78 as a product decision, now approved): a
            # DEFERRAL reply ('will advise', 'I'll get back to you') means WE owe the
            # answer -- the thread must surface as Needs Reply, not sink into 'Waiting
            # on Customer' where it reads as their move. Quote content in our own words
            # still wins (a real answer that also defers one line item is an answer).
            try:
                _own_p = self._own_reply_text(str(getattr(sent_msg, "Body", "") or ""))
                _is_deferral_p = (not self._reply_has_quote_content("", _own_p)
                                  and self._sent_reply_is_deferral(_own_p))
            except Exception:
                _is_deferral_p = False
            if _is_deferral_p:
                if email:
                    email["status"] = "Needs Reply"
                    email["followup_time"] = ""
                    email["is_new_import"] = False
                    email["sent_waiting_tracker_active"] = False
                    email["smart_followup_closed_reason"] = "Deferral reply sent ('will advise'); we owe the answer."
                    self.save_record(email)
                pending["completed"] = True
                pending["completed_at"] = datetime.now().isoformat()
                pending["completed_reason"] = "deferral_reply_found_in_sent_items"
                completed_count += 1
                changed = True
                continue
            if email:
                email["status"] = pending.get("target_status_after_send", "Waiting on Customer")
                email["followup_time"] = ""
                email["is_new_import"] = False
                email["sent_waiting_tracker_active"] = True
                email["sent_waiting_tracker_updated_at"] = datetime.now().isoformat()
                try:
                    email["sent_waiting_tracker_sent_timestamp"] = self.get_sent_msg_time(sent_msg).timestamp()
                except Exception:
                    email["sent_waiting_tracker_sent_timestamp"] = datetime.now().timestamp()
                self.save_record(email)
            # v3.9.27 duplicate fix: only create the separate "Sent / Waiting" placeholder
            # row when there is NO real row to carry the tracker. The old code created it
            # alongside the activated real row, showing two waiting rows for one send.
            if not email:
                placeholder_status = pending.get("target_status_after_send", "Waiting on Vendor")
                if placeholder_status in ["Waiting on Vendor", "Waiting on Customer"]:
                    placeholder = self.make_sent_waiting_placeholder(sent_msg, pending, placeholder_status)
                    self.add_or_update_sent_waiting_placeholder(placeholder)
            pending["completed"] = True
            pending["completed_at"] = datetime.now().isoformat()
            pending["completed_reason"] = "reply_found_in_sent_items"
            completed_count += 1
            changed = True
        self._flush_placeholder_batch()  # v3.8.24: single placeholder write + single resync
        if changed:
            self.flush_status_data()
            self.save_pending_reply_checks()
            self.save_cached_state()
            self.sort_emails_for_display()
            self.render_email_rows()
            try:
                self.render_group_rows()
            except Exception:
                pass
            self.followup_status_var.set(f"Follow-ups: sent reply detected, moved {completed_count} item(s) to waiting status")
        return completed_count

    def create_reply_draft_with_message(self, email, message_text, require_thread=False, target_status_after_send=None, followup_source="manual"):
        self.draft_busy = True
        msg = self.get_message_object(email)
        if not msg:
            self.draft_busy = False
            messagebox.showerror("Draft Error", "Could not reopen this email from Outlook. Try Refresh or Update.")
            return False
        try:
            html_message = html_escape_basic(message_text)
            try:
                reply = msg.Reply()
                self.display_outlook_item_foreground(reply)
                reply.HTMLBody = f"<p>{html_message}</p><br>" + reply.HTMLBody
                self.display_outlook_item_foreground(reply)
                self.root.after(500, lambda r=reply: self.bring_outlook_inspector_to_front(r))
                self.root.after(1200, lambda r=reply: self.bring_outlook_inspector_to_front(r))
            except Exception as reply_error:
                if require_thread:
                    self.draft_busy = False
                    messagebox.showerror("Threaded Reply Error", f"Outlook could not create a threaded reply for this item.\n\n{reply_error}")
                    return False
                outlook, namespace = self.fresh_outlook()
                if not outlook:
                    raise Exception("Could not reconnect to Outlook.Application")
                reply = outlook.CreateItem(0)
                sender_email = self.get_sender_email(msg)
                subject = email.get("subject", "")
                if not subject.lower().startswith("re:"):
                    subject = "RE: " + subject
                reply.To = sender_email
                reply.Subject = subject
                reply.HTMLBody = f"<p>{html_message}</p><br>"
                self.display_outlook_item_foreground(reply)
                self.root.after(500, lambda r=reply: self.bring_outlook_inspector_to_front(r))
                self.root.after(1200, lambda r=reply: self.bring_outlook_inspector_to_front(r))
            # Draft was created/opened. Until we can confirm the reply was actually sent,
            # this item should remain Needs Reply. A background sent-items check will move
            # it to Waiting on Customer/Vendor after the sent reply is detected.
            self.record_pending_reply_check(email, target_status_after_send, followup_source)
            email["status"] = "Needs Reply"
            email["is_new_import"] = False
            self.save_record(email)
            self.flush_status_data()
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.save_cached_state()
            self.draft_busy = False
            return True
        except Exception as e:
            self.draft_busy = False
            messagebox.showerror("Draft Error", f"Could not create draft.\n\n{e}")
            return False

    def create_ai_draft_reply(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return

        jobs = []
        total = len(selected_emails)
        for index, email in enumerate(selected_emails, start=1):
            try:
                body = self.load_body_if_needed(email)
            except Exception:
                body = email.get("body", "") or ""
            fallback = get_followup_message(email.get("category", "General"))
            jobs.append({
                "entry_id": email.get("entry_id", ""),
                "subject": email.get("subject", ""),
                "sender": email.get("sender", ""),
                "body": body,
                "category": email.get("category", "General"),
                "urgency": email.get("urgency", "Normal"),
                "status": email.get("status", "New"),
                "fallback": fallback,
            })
            if total == 1:
                self.render_body_preview(
                    email,
                    body,
                    extra_status="AI Reply clicked: body loaded into preview/cache. Drafting in background..."
                )

        self.save_cached_state()

        def worker(cancel_event):
            results = []
            for job in jobs:
                if cancel_event.is_set():
                    return {"cancelled": True, "results": results}
                ai_result = ask_ollama_for_reply(
                    subject=job["subject"],
                    sender=job["sender"],
                    body=job["body"],
                    category=job["category"],
                    urgency=job["urgency"],
                    status=job["status"],
                )
                text = job["fallback"]
                source = "template fallback"
                timing = ""
                if ai_result:
                    text = ai_result.get("text") if isinstance(ai_result, dict) else str(ai_result)
                    source = "Ollama"
                    if isinstance(ai_result, dict) and ai_result.get("total_duration"):
                        total_s = ai_result.get("total_duration", 0) / 1_000_000_000
                        load_s = (ai_result.get("load_duration") or 0) / 1_000_000_000
                        timing = f"{total_s:.1f}s / load {load_s:.1f}s"
                results.append({
                    "entry_id": job["entry_id"],
                    "message": text,
                    "source": source,
                    "timing": timing,
                })
            return {"cancelled": False, "results": results}

        def success(result):
            if result.get("cancelled"):
                self.ai_status_var.set("AI: draft generation cancelled")
                self.preview_text.insert(tk.END, "\nAI draft generation cancelled before opening remaining drafts.")
                return
            created = 0
            fallback_count = 0
            for row in result.get("results", []):
                email = self.get_email_by_id(row.get("entry_id", ""))
                if not email:
                    continue
                if row.get("source") != "Ollama":
                    fallback_count += 1
                if self.create_reply_draft_with_message(email, row.get("message", ""), require_thread=True):
                    created += 1
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(
                tk.END,
                f"Created {created} threaded draft(s).\n\n"
                f"AI source: {len(result.get('results', [])) - fallback_count} Ollama / {fallback_count} template fallback.\n"
                "The AI work ran in the background so the app should stay usable."
            )
            self.ai_status_var.set("AI: draft complete")

        def error(exc, tb):
            self.ai_status_var.set("AI: fallback after error")
            if messagebox.askyesno("AI Error", f"Ollama failed or timed out, but MaINbox is still usable.\n\nCreate template draft(s) instead?\n\n{exc}"):
                created = 0
                for job in jobs:
                    email = self.get_email_by_id(job.get("entry_id", ""))
                    if email and self.create_reply_draft_with_message(email, job.get("fallback", ""), require_thread=True):
                        created += 1
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, f"Created {created} template fallback draft(s) after AI error.")

        self.start_ai_task("drafting reply", worker, success, error)

    def create_urgent_ack_drafts(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return
        urgent_emails = [email for email in selected_emails if email.get("urgency") in ["High", "Critical"]]
        if not urgent_emails:
            answer = messagebox.askyesno("No High/Critical Selected", "None of the selected emails are marked High or Critical.\n\nCreate acknowledgment draft(s) anyway?")
            if not answer:
                return
            urgent_emails = selected_emails
        created = 0
        for email in urgent_emails:
            message = self.generate_reply_text(email, prefer_ai=True)
            if self.create_reply_draft_with_message(email, message, require_thread=True):
                created += 1
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Created {created} AI/threaded urgent acknowledgment draft(s).")


    def active_followup_count(self):
        manual = len([f for f in self.followups if not f.get("completed") and not f.get("cancelled")])
        scenarios = 0
        for f in self.scenario_reminders:
            if f.get("completed") or f.get("cancelled"):
                continue
            email = self.find_email_for_followup_item(f)
            if email and self.email_is_completed(email):
                continue
            scenarios += 1
        commitments = 0
        for f in getattr(self, "commitment_reminders", []):
            if f.get("completed") or f.get("cancelled"):
                continue
            email = self.find_email_for_followup_item(f)
            if email and self.email_is_completed(email):
                continue
            commitments += 1
        return manual + scenarios + commitments

    def format_due_display(self, due_at_raw):
        try:
            due_at = datetime.fromisoformat(due_at_raw)
            return due_at.strftime("%m/%d %I:%M %p")
        except Exception:
            return "Unknown"

    def find_email_for_followup_item(self, item):
        entry_id = item.get("entry_id", "")
        if entry_id:
            email = self.get_email_by_id(entry_id)
            if email:
                return email
        conversation_id = item.get("conversation_id", "")
        if conversation_id:
            for email in self.emails:
                if email.get("conversation_id") == conversation_id:
                    return email
        group_id = item.get("group_id", "")
        if group_id:
            for email in self.emails:
                if self.get_group_id_for_email(email.get("entry_id", "")) == group_id:
                    return email

        # If the user deleted the item from MaINbox but chose to keep its
        # follow-up, keep a safe snapshot so that one final follow-up can still
        # be reviewed/deployed without putting the email back into the main list.
        try:
            snapshot = item.get("deleted_email_snapshot")
            if isinstance(snapshot, dict) and snapshot.get("entry_id"):
                safe = dict(snapshot)
                safe.pop("message", None)
                safe["is_deleted_app_snapshot"] = True
                return safe
        except Exception:
            pass
        return None

    def get_followup_queue_items(self, include_completed=False):
        # v3.9.27 efficiency: this runs on every preview-queue render (every refresh /
        # AutoPilot cycle). Only re-run the 4-collection dedupe when something actually
        # added or replaced follow-up records; dedupe_followup_records() clears the flag.
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
        rows = []
        seen_queue_keys = set()
        for index, item in enumerate(self.followups):
            if not include_completed and (item.get("completed") or item.get("cancelled")):
                continue
            email = self.find_email_for_followup_item(item)
            group_name = ""
            if email:
                group_name = self.get_group_name_for_email(email.get("entry_id", "")) or ""
            status = "Cancelled" if item.get("cancelled") else "Completed" if item.get("completed") else "Active"
            queue_key = ("manual", status if include_completed else "Active", item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if queue_key in seen_queue_keys:
                continue
            seen_queue_keys.add(queue_key)
            rows.append({
                "queue_id": f"manual:{index}",
                "kind": "Manual follow-up",
                "due_at": item.get("due_at", ""),
                "due_display": self.format_due_display(item.get("due_at", "")),
                "subject": item.get("subject") or (email.get("subject", "") if email else "Email not loaded/found"),
                "group": group_name,
                "status": status,
                "note": item.get("message") or item.get("note") or "Manual scheduled follow-up",
                "item": item,
                "email": email,
            })
        for index, item in enumerate(self.scenario_reminders):
            if not include_completed and (item.get("completed") or item.get("cancelled")):
                continue
            email = self.find_email_for_followup_item(item)
            if email and self.email_is_completed(email) and not item.get("one_time_after_app_delete") and not (item.get("completed") or item.get("cancelled")):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Auto-cancelled: related email is Completed/Low/Junk."
                self.save_scenario_reminders()
                self.save_commitment_reminders()
                if not include_completed:
                    continue
            group_name = ""
            if email:
                group_name = self.get_group_name_for_email(email.get("entry_id", "")) or ""
            scenario_type = item.get("type", "scenario")
            if scenario_type == "vendor_no_response":
                kind = "Vendor no-response"
            elif scenario_type == "customer_po_order_followup":
                kind = "PO/order follow-up"
            else:
                kind = scenario_type.replace("_", " ").title()
            status = "Cancelled" if item.get("cancelled") else "Completed" if item.get("completed") else "Active"
            queue_key = (scenario_type, status if include_completed else "Active", item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if queue_key in seen_queue_keys:
                continue
            seen_queue_keys.add(queue_key)
            rows.append({
                "queue_id": f"scenario:{index}",
                "kind": kind,
                "due_at": item.get("due_at", ""),
                "due_display": self.format_due_display(item.get("due_at", "")),
                "subject": item.get("subject") or (email.get("subject", "") if email else "Email not loaded/found"),
                "group": group_name,
                "status": status,
                "note": item.get("note") or item.get("reason") or item.get("description") or "Automatic scenario reminder",
                "item": item,
                "email": email,
            })
        # v3.8.15: include the commitment/promised-date lane so created ETA / lead-time
        # reminders are visible immediately (upcoming preview + queue), not only when due.
        for index, item in enumerate(getattr(self, "commitment_reminders", [])):
            if not include_completed and (item.get("completed") or item.get("cancelled")):
                continue
            email = self.find_email_for_followup_item(item)
            if email and self.email_is_completed(email) and not (item.get("completed") or item.get("cancelled")):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Auto-cancelled: related email is Completed/Low/Junk."
                self.save_commitment_reminders()
                if not include_completed:
                    continue
            group_name = ""
            if email:
                group_name = self.get_group_name_for_email(email.get("entry_id", "")) or ""
            status = "Cancelled" if item.get("cancelled") else "Completed" if item.get("completed") else "Active"
            queue_key = (item.get("type", "commitment"), status if include_completed else "Active",
                         item.get("target_date", ""),
                         item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if queue_key in seen_queue_keys:
                continue
            seen_queue_keys.add(queue_key)
            rows.append({
                "queue_id": f"commitment:{index}",
                "kind": item.get("kind_label", "Promised date"),
                "due_at": item.get("due_at", ""),
                "due_display": self.format_due_display(item.get("due_at", "")),
                "subject": item.get("subject") or (email.get("subject", "") if email else "Email not loaded/found"),
                "group": group_name,
                "status": status,
                "note": item.get("note") or "Detected promised date / ETA reminder",
                "item": item,
                "email": email,
            })
        def sort_key(row):
            try:
                return datetime.fromisoformat(row.get("due_at") or "9999-12-31T23:59:59")
            except Exception:
                return datetime.max
        rows.sort(key=sort_key)
        return rows

    def open_followup_queue_window(self):
        win = tk.Toplevel(self.root)
        win.title("MaINbox Follow-Up Queue")
        remember_window_geometry(win, "MaINbox Follow-Up Queue", "1050x520")
        win.transient(self.root)

        header = tk.Frame(win)
        header.pack(fill="x", padx=10, pady=8)
        title_var = tk.StringVar()
        tk.Label(header, textvariable=title_var, font=("Segoe UI", 15, "bold")).pack(side="left")
        show_completed_var = tk.BooleanVar(value=False)
        tk.Checkbutton(header, text="Show completed/cancelled", variable=show_completed_var).pack(side="right", padx=5)

        columns = ("due", "type", "status", "group", "subject", "note")
        queue_tree = ttk.Treeview(win, columns=columns, show="headings", selectmode="extended")
        queue_tree.heading("due", text="Due")
        queue_tree.heading("type", text="Type")
        queue_tree.heading("status", text="Status")
        queue_tree.heading("group", text="Group")
        queue_tree.heading("subject", text="Subject")
        queue_tree.heading("note", text="Note")
        queue_tree.column("due", width=125)
        queue_tree.column("type", width=155)
        queue_tree.column("status", width=80, anchor="center")
        queue_tree.column("group", width=190)
        queue_tree.column("subject", width=285)
        queue_tree.column("note", width=300)
        queue_tree.pack(fill="both", expand=True, padx=10, pady=5)
        queue_tree.tag_configure("due", background="#fff2cc", foreground="black")
        queue_tree.tag_configure("overdue", background="#f4cccc", foreground="black")
        queue_tree.tag_configure("completed", background="#d9ead3", foreground="black")
        queue_tree.tag_configure("cancelled", background="#eeeeee", foreground="#777777")

        detail = tk.Text(win, height=5, wrap="word", font=("Segoe UI", 9))
        detail.pack(fill="x", padx=10, pady=(4, 6))

        queue_rows = []

        def selected_rows(show_warning=True):
            selected = queue_tree.selection()
            if not selected:
                if show_warning:
                    messagebox.showwarning("No Follow-Up Selected", "Please select one or more follow-up queue items first.")
                return []
            found = []
            selected_set = set(selected)
            for row in queue_rows:
                if row.get("queue_id") in selected_set:
                    found.append(row)
            return found

        def selected_row(show_warning=True):
            rows = selected_rows(show_warning=show_warning)
            return rows[0] if rows else None

        def refresh_queue():
            nonlocal queue_rows
            queue_tree.delete(*queue_tree.get_children())
            queue_rows = self.get_followup_queue_items(include_completed=show_completed_var.get())
            now = datetime.now()
            active = len([r for r in queue_rows if r.get("status") == "Active"])
            title_var.set(f"Follow-Up Queue — {active} active")
            for row in queue_rows:
                tags = []
                if row.get("status") == "Completed":
                    tags = ["completed"]
                elif row.get("status") == "Cancelled":
                    tags = ["cancelled"]
                else:
                    try:
                        due_at = datetime.fromisoformat(row.get("due_at", ""))
                        if due_at <= now:
                            tags = ["overdue"]
                        elif due_at <= now + timedelta(minutes=15):
                            tags = ["due"]
                    except Exception:
                        tags = []
                queue_tree.insert(
                    "", "end", iid=row["queue_id"],
                    values=(row["due_display"], row["kind"], row["status"], row["group"], row["subject"], row["note"]),
                    tags=tags,
                )
            detail.delete("1.0", tk.END)
            if queue_rows:
                detail.insert(tk.END, "Select one or more queue items to cancel, snooze, or trigger now. Open Related Email uses the first selected item.")
            else:
                detail.insert(tk.END, "No active follow-ups are currently queued.")
            self.followup_status_var.set(f"Follow-ups: {self.active_followup_count()} active")
            self.render_followup_preview_queue()

        def show_detail(event=None):
            row = selected_row(show_warning=False)
            if not row:
                detail.delete("1.0", tk.END)
                detail.insert(tk.END, "Select one or more queue items to cancel, snooze, or trigger now. Open Related Email uses the first selected item.")
                return
            email = row.get("email")
            detail.delete("1.0", tk.END)
            detail.insert(
                tk.END,
                f"Type: {row.get('kind')}\n"
                f"Due: {row.get('due_display')}\n"
                f"Status: {row.get('status')}\n"
                f"Group: {row.get('group') or 'None'}\n"
                f"Subject: {row.get('subject')}\n"
                f"Related email loaded: {'Yes' if email else 'No'}\n\n"
                f"Note: {row.get('note')}"
            )

        def open_related():
            row = selected_row()
            if not row:
                return
            email = row.get("email")
            if not email:
                messagebox.showinfo("Email Not Loaded", "This follow-up exists, but the related email is not currently loaded in the visible/cache email list. Try Refresh or Update.")
                return
            try:
                if self.tree.exists(email.get("entry_id", "")):
                    self.tree.selection_set(email["entry_id"])
                    self.tree.see(email["entry_id"])
            except Exception:
                pass
            body = self.load_body_if_needed(email)
            self.render_body_preview(email, body, extra_status="Opened from Follow-Up Queue.")
            win.lift()

        def cancel_selected():
            rows = [r for r in selected_rows() if r.get("status") == "Active"]
            if not rows:
                return
            if not messagebox.askyesno("Cancel Follow-Ups", f"Cancel {len(rows)} queued follow-up(s)?"):
                return
            for row in rows:
                item = row.get("item")
                if item is not None:
                    item["cancelled"] = True
                    item["cancelled_at"] = datetime.now().isoformat()
                    item["cancel_reason"] = "Cancelled from Follow-Up Queue"
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            refresh_queue()
            self.render_email_rows()
            self.render_group_rows()

        def snooze_rows(rows, due_at, label="custom"):
            changed = 0
            for row in rows:
                if row.get("status") != "Active":
                    continue
                item = row.get("item")
                if item is not None:
                    item["due_at"] = due_at.isoformat()
                    item["snoozed_at"] = datetime.now().isoformat()
                    item["snooze_label"] = label
                    email = row.get("email")
                    if email:
                        email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
                    changed += 1
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_cached_state()
            refresh_queue()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            return changed

        def parse_custom_snooze(raw):
            raw = (raw or "").strip()
            if not raw:
                return None
            now = datetime.now()
            for fmt in ["%m/%d/%Y %I:%M %p", "%m/%d/%y %I:%M %p", "%m/%d/%Y %H:%M", "%m/%d/%y %H:%M"]:
                try:
                    return datetime.strptime(raw.upper(), fmt)
                except Exception:
                    pass
            parsed_time = parse_followup_time(raw)
            return parsed_time

        def snooze_selected(minutes=None):
            rows = [r for r in selected_rows() if r.get("status") == "Active"]
            if not rows:
                return
            if minutes is None:
                custom = simpledialog.askstring(
                    "Custom Snooze",
                    "Enter snooze date/time. Examples:\n3:00 PM\n05/13/2026 9:30 AM",
                    parent=win
                )
                due_at = parse_custom_snooze(custom)
                if not due_at:
                    messagebox.showerror("Invalid Snooze", "Please enter a time like 3:00 PM or a date/time like 05/13/2026 9:30 AM.")
                    return
                label = custom
            else:
                due_at = datetime.now() + timedelta(minutes=minutes)
                label = f"{minutes} minutes"
            snooze_rows(rows, due_at, label=label)

        def snooze_dropdown_apply():
            label = snooze_var.get()
            options = {
                "15 min": 15,
                "30 min": 30,
                "1 hour": 60,
                "2 hours": 120,
                "Tomorrow 9 AM": None,
                "Custom date/time": None,
            }
            if label == "Tomorrow 9 AM":
                target = datetime.combine((datetime.now() + timedelta(days=1)).date(), datetime.strptime("9:00 AM", "%I:%M %p").time())
                rows = [r for r in selected_rows() if r.get("status") == "Active"]
                if rows:
                    snooze_rows(rows, target, label=label)
                return
            if label == "Custom date/time":
                snooze_selected(None)
                return
            snooze_selected(options.get(label, 30))

        def trigger_now():
            rows = [r for r in selected_rows() if r.get("status") == "Active"]
            if not rows:
                return
            for row in rows:
                item = row.get("item")
                if item is not None:
                    item["due_at"] = (datetime.now() - timedelta(seconds=1)).isoformat()
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.check_due_followups()
            refresh_queue()

        btns = tk.Frame(win)
        btns.pack(fill="x", padx=10, pady=(0, 10))
        tk.Button(btns, text="Open Related Email", command=open_related, width=18).pack(side="left", padx=4)
        tk.Button(btns, text="Trigger Now Selected", command=trigger_now, width=18).pack(side="left", padx=4)
        snooze_var = tk.StringVar(value="30 min")
        ttk.Combobox(btns, textvariable=snooze_var, values=["15 min", "30 min", "1 hour", "2 hours", "Tomorrow 9 AM", "Custom date/time"], state="readonly", width=18).pack(side="left", padx=4)
        tk.Button(btns, text="Snooze Selected", command=snooze_dropdown_apply, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Cancel Selected", command=cancel_selected, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Refresh", command=refresh_queue, width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Close", command=win.destroy, width=12).pack(side="right", padx=4)

        queue_tree.bind("<<TreeviewSelect>>", show_detail)
        show_completed_var.trace_add("write", lambda *_: refresh_queue())
        refresh_queue()
        try:
            win.lift()
            win.focus_force()
        except Exception:
            pass

    def open_followup_window(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return
        first_email = selected_emails[0]
        existing = self.get_active_followup_for_email(first_email["entry_id"])
        win = tk.Toplevel(self.root)
        win.title("Setup / Edit Follow Up")
        remember_window_geometry(win, "Setup Edit Follow Up", "560x430")
        win.resizable(False, False)
        win.transient(self.root)
        tk.Label(win, text="Setup / Edit Follow Up", font=("Segoe UI", 16, "bold")).pack(pady=12)
        tk.Label(win, text=f"{len(selected_emails)} email(s) selected.\nAt the follow-up time, the app will show a due follow-ups popup. You choose what to deploy.", font=("Segoe UI", 10)).pack(pady=4)
        if existing:
            try:
                existing_dt = datetime.fromisoformat(existing["due_at"])
                default_time = existing_dt.strftime("%I:%M %p")
                existing_text = f"Existing follow-up: {existing_dt.strftime('%m/%d/%Y %I:%M %p')}"
            except Exception:
                default_time = "3:00 PM"
                existing_text = "Existing follow-up found."
        else:
            default_time = "3:00 PM"
            existing_text = "No existing follow-up for the first selected email."
        tk.Label(win, text=existing_text, font=("Segoe UI", 9), fg=_FG_DIM).pack(pady=4)
        time_frame = tk.Frame(win)
        time_frame.pack(pady=10)
        tk.Label(time_frame, text="Follow-up:").pack(side="left", padx=5)
        time_var = tk.StringVar(value=default_time)
        followup_choices = [
            "1 minute", "5 minutes", "15 minutes", "30 minutes",
            "1 hour", "2 hours", "4 hours", "Tomorrow 9 AM", "3:00 PM"
        ]
        followup_box = ttk.Combobox(time_frame, textvariable=time_var, values=followup_choices, state="readonly", width=18)
        followup_box.pack(side="left", padx=5)
        tk.Label(time_frame, text="choose a preset").pack(side="left", padx=5)
        tk.Label(win, text="Scheduling again will replace any active follow-up for the selected email(s).\nThe app must remain open for scheduled follow-up popups to trigger.", font=("Segoe UI", 9), fg=_FG_DIM).pack(pady=8)

        def get_active_auto_followup_conflicts():
            """Return active automatic follow-up/tracking rows for the selected email(s).

            Manual follow-ups are now the user's authoritative reminder.  To keep
            the queue clean, creating a manual follow-up cannot leave an AI/vendor/
            customer/pending tracker active for the same email/thread.
            """
            conflicts = []
            seen = set()
            for email in selected_emails:
                for collection_name, index, item in self.get_active_automatic_tracking_for_email(email, include_pending=True):
                    key = (collection_name, index)
                    if key in seen:
                        continue
                    seen.add(key)
                    scenario_type = item.get("type", item.get("source", "automatic"))
                    conflicts.append({
                        "collection": collection_name,
                        "index": index,
                        "item": item,
                        "email": email,
                        "subject": item.get("subject") or email.get("subject", "") or "(No subject)",
                        "due": self.format_due_display(item.get("due_at", "")) if hasattr(self, "format_due_display") else item.get("due_at", ""),
                        "note": item.get("note", "") or item.get("reason", "") or item.get("source", "") or "Automatic follow-up/tracking",
                        "kind": scenario_type.replace("_", " ").title() if scenario_type else "Automatic Tracking",
                    })
            return conflicts

        def ask_manual_followup_with_auto_conflicts(conflicts):
            """
            If an automatic follow-up/tracker already exists, ask whether to
            replace it with the manual follow-up or stop. Returns: cancel or abort.
            """
            if not conflicts:
                return "cancel"

            dialog = tk.Toplevel(win)
            dialog.title("Automatic Follow-Up Already Exists")
            remember_window_geometry(dialog, "Automatic Follow-Up Conflict", "800x430")
            dialog.transient(win)
            self.safe_grab_set(dialog)
            dialog.resizable(True, True)

            tk.Label(
                dialog,
                text="An automatic follow-up/tracker already exists for the selected email(s).",
                font=("Segoe UI", 13, "bold")
            ).pack(anchor="w", padx=12, pady=(12, 4))
            tk.Label(
                dialog,
                text="To prevent duplicate reminders, creating the manual follow-up will cancel the existing automatic tracking.",
                font=("Segoe UI", 9)
            ).pack(anchor="w", padx=12, pady=(0, 8))

            frame = tk.Frame(dialog)
            frame.pack(fill="both", expand=True, padx=12, pady=6)
            columns = ("kind", "due", "subject", "note")
            tree = ttk.Treeview(frame, columns=columns, show="headings", height=8)
            tree.heading("kind", text="Existing Tracker")
            tree.heading("due", text="Due")
            tree.heading("subject", text="Subject")
            tree.heading("note", text="Note")
            tree.column("kind", width=170)
            tree.column("due", width=120)
            tree.column("subject", width=270)
            tree.column("note", width=300)
            tree.pack(side="left", fill="both", expand=True)
            yscroll = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)
            yscroll.pack(side="right", fill="y")
            tree.configure(yscrollcommand=yscroll.set)

            for row in conflicts:
                tree.insert("", "end", values=(row.get("kind", "Automatic"), row.get("due", ""), row.get("subject", ""), row.get("note", "")))

            result = {"choice": "abort"}

            def choose(choice):
                result["choice"] = choice
                dialog.destroy()

            btns = tk.Frame(dialog)
            btns.pack(fill="x", padx=12, pady=(8, 12))
            tk.Button(btns, text="Create Manual + Cancel Auto", command=lambda: choose("cancel"), width=28).pack(side="left", padx=4)
            tk.Button(btns, text="Do Not Create", command=lambda: choose("abort"), width=18).pack(side="right", padx=4)

            dialog.protocol("WM_DELETE_WINDOW", lambda: choose("abort"))
            win.wait_window(dialog)
            return result.get("choice", "abort")

        def schedule_or_edit():
            target_dt = parse_followup_time(time_var.get().strip())
            if not target_dt:
                messagebox.showerror("Invalid Time", "Please choose a dropdown value or enter something like 3:00 PM, 9 AM, 14:30, 1, 1 min, 30 minutes, 2 hours, or Tomorrow 9 AM.")
                return

            auto_conflicts = get_active_auto_followup_conflicts()
            auto_choice = ask_manual_followup_with_auto_conflicts(auto_conflicts)
            if auto_choice == "abort":
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, "Manual follow-up was not created. Existing automatic follow-up/tracking was left unchanged.")
                return

            self.save_undo_state("schedule/edit follow-up")
            scheduled_count = 0
            cancelled_auto_count = 0
            now_iso = datetime.now().isoformat()

            if auto_choice == "cancel":
                for conflict in auto_conflicts:
                    item = conflict.get("item")
                    if item and not item.get("completed") and not item.get("cancelled"):
                        item["cancelled"] = True
                        item["cancelled_at"] = now_iso
                        item["cancel_reason"] = "Cancelled by user while creating manual follow-up"
                        cancelled_auto_count += 1

            for email in selected_emails:
                for item in self.followups:
                    if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                        item["cancelled"] = True
                        item["cancelled_at"] = now_iso
                        item["cancel_reason"] = "Replaced by edited follow-up"
                item = {
                    "entry_id": email["entry_id"], "store_id": email.get("store_id", ""),
                    "conversation_id": email.get("conversation_id", ""), "group_id": self.get_group_id_for_email(email.get("entry_id", "")), "subject": email.get("subject", ""),
                    "source": email.get("source", ""), "category": email.get("category", "General"),
                    "due_at": target_dt.isoformat(), "message": "", "use_ai": True,
                    "completed": False, "cancelled": False, "created_at": now_iso
                }
                self.followups.append(item)
                self._followup_dedup_needed = True  # v3 efficiency: mark dirty.
                email["followup_time"] = target_dt.strftime("%m/%d %I:%M %p")
                scheduled_count += 1
            self.save_followups()
            if cancelled_auto_count:
                self.save_scenario_reminders()
                self.save_commitment_reminders()
                self.save_pending_reply_checks()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.save_cached_state()
            self.preview_text.delete("1.0", tk.END)
            extra = f"\nCancelled {cancelled_auto_count} existing automatic follow-up/tracking item(s)." if cancelled_auto_count else ""
            self.preview_text.insert(tk.END, f"Scheduled/edited {scheduled_count} manual follow-up(s) for {target_dt.strftime('%m/%d/%Y %I:%M %p')}.{extra}\n\nThe app must be open for the follow-up drafts to trigger.")
            win.destroy()

        def cancel_from_window():
            win.destroy()
            self.cancel_selected_followups()

        tk.Button(win, text="Save Follow Up", command=schedule_or_edit, width=24).pack(pady=8)
        tk.Button(win, text="Cancel Existing Follow Up", command=cancel_from_window, width=24).pack(pady=8)
        tk.Button(win, text="Close", command=win.destroy, width=24).pack(pady=8)

    def cancel_selected_followups(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return
        cancelled = 0
        now_iso = datetime.now().isoformat()
        for email in selected_emails:
            # Cancel both manual follow-ups and automatic AI/scenario tracking.
            # Previously this button only cancelled self.followups, so AI Follow-Up
            # Review rows in self.scenario_reminders could stay active and keep
            # returning in the queue even after the user thought they were cleared.
            for item in self.followups:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            for item in self.scenario_reminders:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            for item in self.pending_reply_checks:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            # v3.8.30: also cancel commitment reminders (promised dates / reply-needed)
            # for this email. Previously this handler called save_commitment_reminders()
            # but never modified the list, so a commitment reminder stayed active after the
            # user believed every follow-up/tracking item for the email had been cleared.
            for item in getattr(self, "commitment_reminders", []) or []:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            try:
                self.learn_followup_behavior(email, "no_followup", None, "User cancelled follow-up/tracking for this item.")
            except Exception:
                pass
            email["followup_time"] = ""
        self.save_followups()
        self.save_scenario_reminders()
        self.save_commitment_reminders()
        self.save_pending_reply_checks()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        self.save_cached_state()
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Cancelled {cancelled} active follow-up/tracking item(s).")

    def create_draft_reply(self):
        email = self.get_selected_email()
        if not email:
            return
        self.create_reply_draft_with_message(email, get_followup_message(email.get("category", "General")), require_thread=True)

    def open_selected_email(self):
        email = self.get_selected_email()
        if not email:
            return
        msg = self.get_message_object(email)
        if not msg:
            messagebox.showerror("Open Error", "Could not reopen this email from Outlook. Try Refresh or Update.")
            return
        try:
            email["is_new_import"] = False
            if self.tree.exists(email["entry_id"]):
                self.tree.item(email["entry_id"], tags=(self.get_row_tag(email),))
            msg.Display()
            try:
                inspector = msg.GetInspector
                if inspector:
                    inspector.Activate()
            except Exception:
                pass
        except Exception as e:
            email["message"] = None
            messagebox.showerror("Open Error", f"Could not open email.\n\n{e}")

    def change_category(self):
        self.save_cached_state()
        # v4.1.58: drain async saves; v4.1.60: drain ops log buffer before exit.
        try:
            flush_pending_async_saves(timeout_seconds=20.0)
        except Exception:
            pass
        try:
            ops_log("app", "session_end")
            _ops_log_flush_once()
        except Exception:
            pass
        self.root.destroy()
        picker_root = tk.Tk()
        CategoryPicker(picker_root, allow_auto_open=False)
        picker_root.mainloop()

    def on_close(self):
        try:
            if self.ai_cancel_event:
                self.ai_cancel_event.set()
        except Exception:
            pass
        self.auto_refresh_enabled = False
        self.followup_check_enabled = False
        self.flush_status_data()
        self.save_followups()
        self.save_pending_reply_checks()
        self.save_groups()
        try:
            self.save_learning_rules()
        except Exception:
            pass
        try:
            self.save_triage_history()
        except Exception:
            pass
        try:
            self.save_deleted_history()
        except Exception:
            pass
        try:
            self._bootstrap_closed_email_guard()
            self._save_closed_email_guard()
        except Exception:
            pass
        try:
            self.save_scenario_reminders()
            self.save_commitment_reminders()
        except Exception:
            pass
        try:
            self.save_sent_waiting_placeholders()
        except Exception:
            pass
        try:
            self.save_vendor_history()
        except Exception:
            pass
        try:
            self.save_quote_requests()
        except Exception:
            pass
        try:
            self.save_quote_coverage()  # v3.9.1
        except Exception:
            pass
        try:
            if isinstance(getattr(self, "procurement_memory", None), dict):
                self.procurement_memory["updated_at"] = datetime.now().isoformat()
                save_json(PROCUREMENT_MEMORY_FILE, self.procurement_memory)
        except Exception:
            pass
        self.save_cached_state()
        # v4.1.58: block (bounded) until the background persistence writer has the
        # queued cache/status writes on disk -- nothing rides only in memory at exit.
        try:
            flush_pending_async_saves(timeout_seconds=20.0)
        except Exception:
            pass
        # v4.1.60 fix: ops log buffer is drained by a daemon thread that exits
        # with the process -- flush explicitly so nothing is lost at close.
        try:
            ops_log("app", "session_end")
            _ops_log_flush_once()
        except Exception:
            pass
        self.root.destroy()


