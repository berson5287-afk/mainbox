    def _log_subject_merge_blocked_once(self, email, stale_gid, subject_key):
        """v4.2.89: telemetry for the staleness guard. Fires only when a same-subject
        group WAS available and the window refused it -- i.e. this email is about to
        start its own group where v4.2.88 would have merged it. That is the decision
        worth auditing, so record the group that was refused.

        Once-per-session per (email, group) pair, the v4.1.84 discipline: this sits in
        a grouping path that re-runs on every triage pass."""
        try:
            seen = getattr(self, "_subject_merge_block_logged", None)
            if seen is None:
                seen = self._subject_merge_block_logged = set()
            eid = str((email or {}).get("entry_id", "") or "")[-16:]
            key = (eid, str(stale_gid or ""))
            if key in seen:
                return
            seen.add(key)
            ops_log("group", "subject_merge_blocked",
                    eid=eid, why="stale", gid=str(stale_gid or "")[:32],
                    days=int(self.settings.get("group_subject_merge_max_age_days",
                                               GROUP_SUBJECT_MERGE_MAX_AGE_DAYS)
                             or GROUP_SUBJECT_MERGE_MAX_AGE_DAYS),
                    subj_key=str(subject_key or "")[:60],
                    subj=str((email or {}).get("subject", "") or "")[:60])
        except Exception:
            pass

    @staticmethod
    def _reply_sender_matches_tracker_recipient(reply_sender_email, reply_sender_name, tracker_row):
        """v4.1.77: does an inbound reply actually come from the party this tracker is
        waiting on? (reported: a P&A request sent to raulp@theaenterprises.com was
        auto-completed by a reply from victor@brazill.com -- a DIFFERENT vendor -- because
        every tracker-clear path matched by conversation/subject alone; multi-vendor RFQs
        legitimately share one thread/subject, so vendor B's reply must never close the
        tracker waiting on vendor A).

        Match order, most reliable first:
          1. address vs address: exact or same-domain (the domain tier is deliberate --
             victor@brazill.com correctly clears a tracker sent to caddy@brazill.com,
             a colleague answering for their team).
          2. display-name fallback: older trackers stored Outlook's .To display string
             ("Raul Pescoran") with no SMTP; compare normalized names, containment
             allowed (len >= 5) so "Raul Pescoran (T&A)" still matches.
          3. no recipient identity at all -> True (fail-open to the old behavior; a
             tracker with zero recipient info must not become permanently unclearable).
        Exceptions fail open for the same reason -- this guard narrows clearing, it must
        never break it."""
        try:
            candidates = []
            for key in ("recipient_smtp", "sender_email", "sender"):
                val = str((tracker_row or {}).get(key, "") or "").strip()
                if val:
                    candidates.append(val)
            if not candidates:
                return True
            reply_addr = extract_email_address(str(reply_sender_email or "")).lower()
            reply_domain = reply_addr.split("@", 1)[1] if "@" in reply_addr else ""
            addr_candidates = []
            name_candidates = []
            for cand in candidates:
                if "@" in cand:
                    # recipient_smtp may hold several addresses ("a@x; b@y")
                    for piece in re.split(r"[;,]", cand):
                        piece_addr = extract_email_address(piece).lower()
                        if piece_addr and "@" in piece_addr:
                            addr_candidates.append(piece_addr)
                elif re.match(r"\s*/o=", cand, flags=re.I) or "/cn=" in cand.lower():
                    # v4.2.86 (Danny/campbellanddawes, live 8/22 + 8/24): an
                    # UNRESOLVED EXCHANGE DN ("/O=EXCHANGELABS/.../CN=...") is not
                    # a display name -- it has no '@', fell into name_candidates,
                    # matched no human reply ever, and made the tracker PERMANENTLY
                    # unclearable by the very party it was waiting on
                    # (clear_skipped_sender_mismatch with waiting_on='/O=EXCHANGE...').
                    # A DN identifies nobody usefully here: skip it, so a tracker
                    # whose ONLY recipient identity is a DN falls through to the
                    # documented fail-open ("no recipient identity -> True").
                    continue
                else:
                    name_candidates.append(cand)
            if addr_candidates and reply_addr:
                for cand_addr in addr_candidates:
                    if reply_addr == cand_addr:
                        return True
                    cand_domain = cand_addr.split("@", 1)[1]
                    if reply_domain and cand_domain and reply_domain == cand_domain:
                        return True
                return False  # tracker knows its recipient addresses; reply matches none
            # Name-only rows (the pre-v4.1.77 shape): compare display names.
            def _norm_name(value):
                return re.sub(r"[^a-z0-9 ]+", " ", str(value or "").lower()).strip()
            reply_name = _norm_name(reply_sender_name)
            if not reply_name and reply_addr:
                reply_name = _norm_name(reply_addr.split("@", 1)[0].replace(".", " "))
            for cand in name_candidates:
                cand_name = _norm_name(cand)
                if not cand_name or not reply_name:
                    continue
                if cand_name == reply_name:
                    return True
                if len(cand_name) >= 5 and cand_name in reply_name:
                    return True
                if len(reply_name) >= 5 and reply_name in cand_name:
                    return True
            if name_candidates and reply_name:
                return False  # tracker knows a recipient name; reply is someone else
            return True
        except Exception:
            return True

    def _email_matches_recent_sent_thread(self, email, lookback_days=21):
        """v4.1.77: True when this inbound email is on a thread we recently SENT a
        request on (matched against sent/waiting trackers by conversation id, then by
        normalized subject). Cleared trackers count on purpose: the tracker being
        cleared does not un-send the request -- the thread is still ours. Used by the
        quote-content floor: a reply on a thread we asked a question on is business
        mail by definition, never junk."""
        try:
            conv = str((email or {}).get("conversation_id", "") or "").strip().lower()
            subj = normalize_subject_for_match((email or {}).get("subject", "") or "")
            if not conv and not subj:
                return False
            cutoff_ts = datetime.now().timestamp() - (lookback_days * 86400)
            for p in getattr(self, "sent_waiting_placeholders", []) or []:
                if not isinstance(p, dict):
                    continue
                try:
                    p_ts = float(p.get("received_timestamp", 0) or 0)
                except Exception:
                    p_ts = 0.0
                if p_ts and p_ts < cutoff_ts:
                    continue
                if conv:
                    p_conv = str(p.get("conversation_id", "") or "").strip().lower()
                    if p_conv and p_conv == conv:
                        return True
                if subj:
                    p_subj = str(p.get("normalized_subject", "") or "") or normalize_subject_for_match(p.get("subject", "") or "")
                    if p_subj and p_subj == subj:
                        return True
            return False
        except Exception:
            return False

    def make_sent_waiting_placeholder(self, sent_msg, pending=None, target_status="Waiting on Vendor"):
        """Create a visible main-window tracking row for a sent email we are waiting on.

        v2.10.8: Works for both MaINbox-created drafts and manually sent Outlook emails.
        """
        pending = pending or {}
        try:
            conversation_id = ""
            try:
                conversation_id = sent_msg.ConversationID or ""
            except Exception:
                conversation_id = pending.get("conversation_id", "")

            sent_entry_id = ""
            try:
                sent_entry_id = sent_msg.EntryID or ""
            except Exception:
                sent_entry_id = pending.get("sent_entry_id", "")

            subject = ""
            try:
                subject = sent_msg.Subject or pending.get("subject", "")
            except Exception:
                subject = pending.get("subject", "")

            sent_conversation_index = ""
            sent_internet_message_id = ""
            try:
                sent_conversation_index = str(getattr(sent_msg, "ConversationIndex", "") or pending.get("sent_conversation_index", "") or "")
            except Exception:
                sent_conversation_index = pending.get("sent_conversation_index", "") or ""
            try:
                pa = sent_msg.PropertyAccessor
                try:
                    sent_internet_message_id = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
                except Exception:
                    sent_internet_message_id = pending.get("sent_internet_message_id", "") or ""
            except Exception:
                sent_internet_message_id = pending.get("sent_internet_message_id", "") or ""

            if not conversation_id and not sent_entry_id and not subject:
                return None

            # One active waiting row per conversation. If Outlook lacks a conversation id,
            # fall back to sent EntryID / subject hash.
            if conversation_id:
                placeholder_id = f"sentwait:{conversation_id}"
            elif sent_entry_id:
                placeholder_id = f"sentwait:{sent_entry_id}"
            else:
                digest = hashlib.sha1(str(subject).encode("utf-8", "ignore")).hexdigest()[:16]
                placeholder_id = f"sentwait:subject:{digest}"

            recipient = ""
            try:
                recipient = sent_msg.To or ""
            except Exception:
                recipient = pending.get("recipient", "")

            # v4.1.77: .To above is Outlook's DISPLAY string ("Raul Pescoran") -- useless
            # for search and for correlating a future reply's sender with who we sent to.
            # Resolve the actual SMTP address of each To recipient (PR_SMTP_ADDRESS via
            # PropertyAccessor, fallback to Recipient.Address when it is already SMTP).
            # Runs on the Outlook WORKER like the PropertyAccessor read above; fail-soft
            # per recipient so one unresolvable entry never loses the others.
            recipient_smtp = ""
            try:
                _smtp_parts = []
                for _rcp in sent_msg.Recipients:
                    try:
                        try:
                            if int(getattr(_rcp, "Type", 1) or 1) != 1:  # olTo only
                                continue
                        except Exception:
                            pass
                        _addr = ""
                        try:
                            _addr = str(_rcp.PropertyAccessor.GetProperty(
                                "http://schemas.microsoft.com/mapi/proptag/0x39FE001F") or "")
                        except Exception:
                            _addr = ""
                        if "@" not in _addr:
                            try:
                                _raw = str(getattr(_rcp, "Address", "") or "")
                                if "@" in _raw and not _raw.lower().startswith("/o="):
                                    _addr = _raw
                            except Exception:
                                pass
                        _addr = extract_email_address(_addr).lower()
                        if _addr and "@" in _addr and _addr not in _smtp_parts:
                            _smtp_parts.append(_addr)
                    except Exception:
                        continue
                recipient_smtp = "; ".join(_smtp_parts)
            except Exception:
                recipient_smtp = ""
            if not recipient_smtp:
                recipient_smtp = str(pending.get("recipient_smtp", "") or "")

            sent_on = datetime.now()
            try:
                if sent_msg.SentOn:
                    sent_on = sent_msg.SentOn.replace(tzinfo=None)
            except Exception:
                try:
                    sent_on = datetime.fromisoformat(pending.get("sent_on", ""))
                except Exception:
                    pass

            placeholder = {
                "entry_id": placeholder_id,
                "sent_entry_id": sent_entry_id,
                "sent_conversation_index": sent_conversation_index,
                "sent_internet_message_id": sent_internet_message_id,
                "tracked_entry_id": pending.get("entry_id", ""),
                "tracked_store_id": pending.get("store_id", ""),
                "store_id": pending.get("store_id", ""),
                "conversation_id": conversation_id,
                "source": "Sent / Waiting",
                "subject": subject,
                "normalized_subject": normalize_subject_for_match(subject),
                "sender": recipient or pending.get("sender", "Sent RFQ / Reply"),
                "sender_email": recipient_smtp or recipient or pending.get("sender_email", ""),
                "recipient_smtp": recipient_smtp,
                "body": "",
                "body_loaded": False,
                "received": sent_on.strftime("%Y-%m-%d %I:%M %p"),
                "received_timestamp": sent_on.timestamp(),
                "outlook_categories": "",
                "category": pending.get("category", "Vendor / Supplier") or "Vendor / Supplier",
                "urgency": pending.get("urgency", "Normal") if pending.get("urgency") != "Low" else "Normal",
                "status": target_status or "Waiting on Vendor",
                "message": None,
                "is_new_import": False,
                "followup_time": "",
                "sender_type": "sent_placeholder",
                "email_type": "V" if target_status == "Waiting on Vendor" else "C",
                "sender_intent": "Waiting for vendor/customer response to sent email",
                "business_relevance": "1.0",
                "spam_likelihood": "0.0",
                "same_subject_related_count": 0,
                "has_attachments": False,
                "is_sent_waiting_placeholder": True,
                "created_at": datetime.now().isoformat(),
                "cleared": False,
            }
            return placeholder
        except Exception:
            return None

    def sync_sent_waiting_placeholders_into_email_list(self):
        """Keep active sent placeholders visible in the main list, without duplicate rows."""
        try:
            # v2.10.8 patch: app-deleted sent placeholders must stay gone after restart.
            # They are stored separately in mainbox_sent_waiting_placeholders.json, so
            # filter them against status_data before re-inserting them into self.emails.
            # v3.9.27 duplicate self-heal: a thread shows at most ONE tracker row. If a
            # loaded real email row is already the active tracker for a conversation
            # (sent_waiting_tracker_active), retire any placeholder for that same
            # conversation instead of showing both. This also cleans up the duplicate
            # pairs older versions created (they re-activated the real row AND added a
            # placeholder for the same send).
            tracked_conversations = set()
            for row in getattr(self, "emails", []) or []:
                if not isinstance(row, dict) or row.get("is_sent_waiting_placeholder"):
                    continue
                if row.get("sent_waiting_tracker_active"):
                    conv = str(row.get("conversation_id", "") or "").strip()
                    if conv:
                        tracked_conversations.add(conv)
            retired_any = False
            active = []
            for p in getattr(self, "sent_waiting_placeholders", []):
                pid = p.get("entry_id", "")
                if p.get("cleared"):
                    continue
                if pid and self.status_data.get(pid, {}).get("app_deleted"):
                    p["cleared"] = True
                    p["cleared_reason"] = "app_deleted"
                    continue
                p_conv = str(p.get("conversation_id", "") or "").strip()
                if p_conv and p_conv in tracked_conversations:
                    p["cleared"] = True
                    p["cleared_at"] = datetime.now().isoformat()
                    p["cleared_reason"] = "superseded_by_tracked_row"
                    retired_any = True
                    continue
                active.append(p)
            if retired_any:
                try:
                    # Persist the retirements; respects the placeholder batch if open.
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
            # Remove placeholder rows that were cleared/deleted from the visible list.
            active_ids = {p.get("entry_id", "") for p in active}
            self.emails = [e for e in self.emails if not e.get("is_sent_waiting_placeholder") or e.get("entry_id") in active_ids]
            # Index where each placeholder row currently lives so we can both add missing
            # rows and refresh rows that already exist.
            existing_index = {}
            for i, e in enumerate(self.emails):
                if e.get("is_sent_waiting_placeholder"):
                    existing_index.setdefault(e.get("entry_id", ""), i)
            for placeholder in active:
                pid = placeholder.get("entry_id", "")
                if not pid:
                    continue
                if pid not in existing_index:
                    self.emails.append(dict(placeholder))
                else:
                    # v3.9.1 fix: a second reply in the same conversation updates the stored
                    # placeholder (newer SentOn time, recipient, body), but the older code only
                    # ever APPENDED a placeholder once and skipped it forever after, so the
                    # already-visible row kept showing the first send time (e.g. the "will
                    # advise" reply at 7:46 stayed put after the quote went out at 8:49).
                    # Refresh the visible row in place from the updated placeholder, then
                    # re-overlay any durable user workflow choice (e.g. a manual Completed)
                    # so the newest send time/body shows without discarding the user's edits.
                    i = existing_index[pid]
                    merged = dict(self.emails[i])
                    merged.update(placeholder)
                    saved = self.status_data.get(pid, {}) if isinstance(self.status_data, dict) else {}
                    if saved:
                        self.apply_saved_workflow_to_email(merged, saved)
                    self.emails[i] = merged
            # v3 efficiency: rebuild index after placeholder sync changes self.emails.
            self._rebuild_email_index()
        except Exception:
            pass

    def thread_is_app_deleted_for_placeholder(self, placeholder):
        """v3.9.2: True if this Sent / Waiting placeholder belongs to a thread the user
        deleted from MaINbox only.

        The Sent Items scan re-sees the original sent message on every refresh, and in
        Cached Exchange Mode the sent message's own EntryID may differ from the id used to
        record the deletion (the deletion is recorded against the inbound message). The old
        guard only checked the placeholder's own entry_id, so a deleted thread came back as a
        Sent / Waiting echo. Matching on the conversation id (precise) catches that; a
        subject-only fallback is used ONLY when neither side has a conversation id, so
        unrelated same-subject RFQs are never suppressed.
        """
        try:
            if not isinstance(self.status_data, dict) or not isinstance(placeholder, dict):
                return False
            p_conv = str(placeholder.get("conversation_id", "") or "").strip().lower()
            p_subject = normalize_subject_for_match(placeholder.get("subject", "") or "")
            if not p_conv and not p_subject:
                return False
            for rec in self.status_data.values():
                if not isinstance(rec, dict) or not rec.get("app_deleted"):
                    continue
                rec_conv = str(rec.get("conversation_id", "") or "").strip().lower()
                if p_conv and rec_conv and rec_conv == p_conv:
                    return True
                if not p_conv and not rec_conv and p_subject:
                    rec_subject = normalize_subject_for_match(rec.get("subject", "") or rec.get("normalized_subject", "") or "")
                    if rec_subject and rec_subject == p_subject:
                        return True
            return False
        except Exception:
            return False

    def add_or_update_sent_waiting_placeholder(self, placeholder):
        if not placeholder:
            return False
        try:
            pid = placeholder.get("entry_id", "")
            if not pid:
                return False
            # v2.10.8 patch: do not recreate a sent/waiting placeholder that the
            # user already deleted from MaINbox only. This prevents it from coming
            # back when Sent Items are scanned after reopening the app.
            # v3.9.2: also suppress when the placeholder's THREAD was deleted (matched by
            # conversation id), since Cached Exchange Mode re-syncs change EntryIDs and the
            # placeholder's own id will not match the id the deletion was recorded against.
            if self.status_data.get(pid, {}).get("app_deleted") or self.thread_is_app_deleted_for_placeholder(placeholder):
                for existing in self.sent_waiting_placeholders:
                    if existing.get("entry_id") == pid:
                        existing["cleared"] = True
                        existing["cleared_reason"] = "app_deleted"
                        break
                self.save_sent_waiting_placeholders()
                return False
            updated = False
            for i, existing in enumerate(self.sent_waiting_placeholders):
                if existing.get("entry_id") == pid:
                    # v3.8.29 fix: do NOT resurrect a placeholder that a matching
                    # incoming reply already cleared. The Sent Items scan re-sees the
                    # original sent message on every refresh; the old code blindly set
                    # cleared=False here, so a tracker cleared by a reply would pop back
                    # and never go away (the "reply came in but the tracker is still
                    # sitting there" bug). Only un-clear if the user genuinely re-opened
                    # the thread by sending AGAIN after the clearing reply, i.e. this
                    # sent message is newer than the reply that cleared it.
                    # v3.9.27: the guard only protected "matching_reply_imported", but the
                    # bounded Outlook rescue scan clears with reason
                    # "bounded_outlook_thread_reply_found" -- those trackers were being
                    # resurrected on the next Sent Items pass whenever Cached Exchange
                    # Mode reassigned the sent message's EntryID (so the processed-id
                    # skip missed it). Protect every reply-based clear the same way, and
                    # never resurrect a placeholder retired by duplicate cleanup (its
                    # surviving sibling is the live tracker for that thread).
                    existing_reason = str(existing.get("cleared_reason", "") or "")
                    if existing.get("cleared") and existing_reason == "duplicate_placeholder_cleanup":
                        return False
                    if existing.get("cleared") and existing_reason in (
                        "matching_reply_imported",
                        "bounded_outlook_thread_reply_found",
                    ):
                        try:
                            # v4.2.2: new_send_ts is a SENT placeholder (local basis) while
                            # cleared_reply_timestamp was copied from an INBOUND row (UTC
                            # basis), so this comparison had the same 4h skew. Normalise the
                            # send side; the stored reply stamp is shifted to match.
                            new_send_ts = self._comparable_received_epoch(placeholder)
                            cleared_reply_ts = float(existing.get("cleared_reply_timestamp", 0) or 0)
                            if cleared_reply_ts > 0:
                                _off = (datetime.fromtimestamp(cleared_reply_ts)
                                        - datetime.utcfromtimestamp(cleared_reply_ts)).total_seconds()
                                cleared_reply_ts = cleared_reply_ts - _off
                        except Exception:
                            new_send_ts = 0
                            cleared_reply_ts = 0
                        if not (new_send_ts and cleared_reply_ts and new_send_ts > cleared_reply_ts + 30):
                            # Same original send (or older than the reply) -> leave it
                            # cleared and treat as a no-op so it stays out of the list.
                            return False
                    self.sent_waiting_placeholders[i].update(placeholder)
                    self.sent_waiting_placeholders[i]["cleared"] = False
                    updated = True
                    break
            if not updated:
                self.sent_waiting_placeholders.append(placeholder)
            self.save_sent_waiting_placeholders()
            # v3.9.89: keep this tracker grouped with the request it came from (and, once it
            # arrives, the vendor reply). Additive only -- never moves an already-grouped row.
            try:
                self._link_sent_tracker_to_request_group(placeholder)
            except Exception:
                pass
            # v4.1.63: if the origin link found nothing (a fresh-subject RFQ has no
            # originating request), fall back to inherit-from-source + unambiguous
            # token match against group names -- the reported 2150 Hempstead tracker.
            try:
                _pid = str(placeholder.get("entry_id", "") or "")
                if _pid and not self.groups_data.get("memberships", {}).get(_pid):
                    self.auto_group_sent_tracker(placeholder)
            except Exception:
                pass
            if getattr(self, "_placeholder_batch", 0):
                self._placeholder_batch_sync_dirty = True
            else:
                self.sync_sent_waiting_placeholders_into_email_list()
            return True
        except Exception:
            return False

    def _flag_tracked_reply_by_intent(self, reply_email, waiting_party=""):
        """v3.9.51: an inbound reply that just cleared one of our sent/waiting trackers is the
        response we were waiting on. Give it a sensible status automatically so the next step is
        smooth, using the existing non-AI analyze_reply_intent():
          - a question / 'please confirm' style reply  -> Needs Reply
          - a 'working on it' / 'I'll get back to you'  -> Waiting on Vendor / Waiting on Customer
            (Vendor vs Customer taken from the tracker we cleared -- whoever we sent to -- then the
             reply's own sender type, then the phrase wording)
          - a plain thank-you / acknowledgement         -> Completed
        Replies with no clear signal are left untouched for normal AI triage. A status the user set
        by hand is never overridden, and the flagged reply is marked settled so the background drip
        / AutoPilot do not re-classify over this rule.
        """
        try:
            if (not isinstance(reply_email, dict)
                    or reply_email.get("ai_user_locked")
                    or reply_email.get("is_sent_waiting_placeholder")):
                return
            try:
                self.load_body_if_needed(reply_email)
            except Exception:
                pass
            subject = reply_email.get("subject", "") or ""
            body = reply_email.get("body", "") or ""
            sender = reply_email.get("sender_email", "") or reply_email.get("sender", "") or ""
            intent = analyze_reply_intent(
                subject=subject, body=body, sender_or_recipient=sender,
                source=reply_email.get("source", ""), direction="inbound")
            new_status = ""
            if intent.get("is_closed_ack"):
                new_status = "Completed"
            elif intent.get("is_waiting"):
                party = waiting_party if waiting_party in ("Vendor", "Customer") else ""
                if not party:
                    _st = str(reply_email.get("sender_type", "") or reply_email.get("email_type", "") or "").lower()
                    if "customer" in _st or "prospect" in _st:
                        party = "Customer"
                    elif "vendor" in _st or "supplier" in _st:
                        party = "Vendor"
                if not party:
                    party = "Customer" if intent.get("intent") == "waiting_on_customer" else "Vendor"
                new_status = "Waiting on " + party
            else:
                _body_q = _strip_reply_boilerplate_for_intent(body) if body else ""
                if intent.get("intent") in ("needs_reply", "business_request") or ("?" in _body_q):
                    new_status = "Needs Reply"
            if not new_status:
                return
            # v4.2.26: this site BYPASSED the v4.2.11 clamp. A vendor's quote reply cleared
            # its tracker and landed here, a "?" in the body (or OUR OWN quoted "please
            # advise") set Needs Reply, and ai_user_locked=True froze it -- reported live on
            # NDattilo@hubbell (8/3 08:35, empty reason, locked). A reply on a thread WE
            # originated is answering us; it must not enter the reply queue from this path.
            new_status = self._clamp_status_for_sent_rfq_reply(
                reply_email, new_status, where="tracker_clear_flag")
            reply_email["status"] = new_status
            reply_email["ai_triaged_at"] = datetime.now().isoformat()
            reply_email["ai_triage_pending"] = False
            reply_email["ai_user_locked"] = True
            reply_email["is_new_import"] = False
            self.save_record(reply_email)
        except Exception:
            pass

    # v4.1.96: material vocabulary for the letterhead filter. A row naming real hardware is
    # KEPT whatever else it contains -- this is what stops the address/phone rules from ever
    # eating a genuine line, and it is what rescued 'ITW Buidex 560047 #12 Hex Washer Head
    # Drive, 2" Long #5 Point' (a SCREW) which the audit's own labels had wrongly flagged as
    # a street address because it contains the word 'Drive'.
    _CONTACT_FILTER_MATERIAL_WORDS = (
        "thhn", "thwn", "xhhw", "romex", "emt", "rigid", "imc", "pvc", "conduit", "wire",
        "cable", "coupling", "connector", "strap", "hub", "box", "boxes", "cover", "breaker",
        "panel", "lug", "fitting", "elbow", "nipple", "bushing", "anchor", "strut", "caddy",
        "clamp", "receptacle", "switch", "gang", "plate", "fixture", "lamp", "ballast",
        "transformer", "disconnect", "meter", "ground", "sleeve", "reducer", "condulet",
        "unistrut", "wiremold", "raceway", "fuse", "relay", "contactor", "gauge", "awg",
        "kcmil", "mcm", "aluminum", "copper", "galv", "stainless", "wedge", "washer", "bolt",
        "screw", "nut", "rod", "hanger", "bracket", "enclosure", "j-box", "jbox", "whip",
        "hex", "sleeve", "coupler", "adapter", "seal", "gasket", "terminal", "splice",
    )

    @classmethod
    def _looks_like_contact_or_letterhead(cls, desc):
        """v4.1.96: True when a would-be REQUESTED ITEM is really letterhead, contact detail
        or order-form chrome rather than material.

        Scored against the live store before shipping: of 3684 real ledger rows it removes
        379 of the 381 labelled bad (99%) and touches 2 of 3303 others -- and BOTH of those
        two ('Phone: (800) 847-7661', 'Fax: (865) 218-3461') are genuinely bad rows the
        label regexes missed, so effective precision is ~100%.

        Order matters: the material-word and wire-gauge escapes are checked FIRST, so a real
        line is never removed for containing an address-like fragment. '#6 THHN',
        '#3/0 aluminum', '25 - 5\" hubs RGS', 'DURA-LINE 10004464 4in PVC conduit' and
        '100 ft #6 THHN to 37 Ramland Rd' all survive (regression-tested)."""
        try:
            d = str(desc or "").strip()
            if not d:
                return False
            low = d.lower()
            # v4.2.68 (John DeRosa signature): 'East Union Avenue' -- the house number
            # was split off as the QUANTITY by a body parser, and the street name
            # contains the material word 'union' (a pipe fitting), so the substring
            # escape below kept it as a requested item. A short, DIGIT-FREE line that
            # ENDS in a street type is an address regardless of embedded material
            # words; real material lines carry sizes/counts (digits) or don't end in
            # street vocabulary. Computed here so it can bypass the escape.
            _bare_street = bool(
                len(d) <= 60 and not re.search(r"\d", low) and re.search(
                    r"\b(?:street|avenue|road|boulevard|lane|parkway|highway|terrace"
                    r"|st|ave|rd|blvd|ln|pkwy|hwy|ct|pl|ter)\b\.?\s*$", low))
            if not _bare_street and any(w in low for w in cls._CONTACT_FILTER_MATERIAL_WORDS):
                return False
            # a wire gauge / fractional size is material, full stop (the v4.1.85 lesson)
            if re.search(r"#\s*\d+(?:/\d+)?\b|\b\d+\s*(?:awg|kcmil|mcm)\b|\d+\s*/\s*\d+\s*\"", low):
                return False
            if re.search(r"^\s*\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}\s*$", low):
                return True
            if re.search(r"\b(?:phone|tel|fax|cell|mobile|office|direct)\b\s*[:.]?\s*"
                         r"(?:\+?1[-.\s]?)?\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}", low):
                return True
            # v4.2.27: single-LETTER phone labels. The BBJ submittal cover sheet wrote its
            # phones as "P: (914) 739-1902" -- the labelled-phone rule above requires a
            # full word, so these sailed through into the ledger.
            if re.search(r"^\s*[a-z]\s*[:.]\s*\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}\s*$", low):
                return True
            # v4.2.27: SPELLED-OUT state + zip ("New Rochelle, New York 10801"). The
            # city-state-zip rule below only knows two-letter abbreviations.
            if re.search(r",\s*(?:new\s+york|new\s+jersey|connecticut|pennsylvania|"
                         r"massachusetts|florida|texas|california|illinois|ohio|georgia|"
                         r"virginia|maryland)\s+\d{5}(?:-\d{4})?\b", low):
                return True
            # v4.2.27: a row that is ONLY a date is document chrome ("04/29/2026",
            # "Apr 28, 2026"), never material. v4.2.84 (Brewster xlsx, George Caruso
            # 8/24): ISO datetimes too -- spreadsheet date cells read back as
            # "2026-08-24 00:00:00" and landed as a requested item.
            if re.search(r"^\s*(?:\d{1,2}/\d{1,2}/\d{2,4}"
                         r"|\d{4}-\d{2}-\d{2}(?:\s+\d{1,2}:\d{2}(?::\d{2})?)?"
                         r"|(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?\s+"
                         r"\d{1,2},?\s+\d{4})\s*$", low):
                return True
            # v4.2.27: submittal/transmittal form labels as WHOLE rows -- the Procore
            # cover-sheet vocabulary observed live on the BBJ ledger. Whole-row match
            # only, so a real item mentioning "status" in passing is untouched.
            if re.fullmatch(r"\s*(?:status|open|closed|received|revision|data|attachments?|"
                            r"submittal\s+manager|issue\s+date|date\s+created|spec\s+section|"
                            r"ball\s+in\s+court|responsible\s+contractor|approver|approved|"
                            r"submitted\s+by|distribution(?:\s+list)?|transmittal|cover\s+sheet|"
                            r"description|location|type|number|title|project|general"
                            # v4.2.84 (Brewster purchase-form template, George Caruso 8/24):
                            # its header cells arrived as requested items. Whole-row only,
                            # as before -- "both ends threaded" is untouched. Note
                            # "purchase informat\w*": the template itself misspells
                            # "INFORMATON", which is exactly how it evaded the existing
                            # "purchase information" rule below.
                            r"|special\s+instructions?|buy\s+america\w*|purchase\s+informat\w*|"
                            r"dbe|mbe|sbe|wbe|lbe|both|vendor|supplier|"
                            r"date\s+needed|needed\s+by|required\s+by)\s*", low):
                return True
            if re.search(r"<\s*(?:tel|mailto)\s*:", low):
                return True
            if re.search(r"[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}", low):
                return True
            # v4.2.84: comma OPTIONAL -- "Independent Way Brewster NY 10509" (house
            # number split off as the qty by the sheet parser) has no comma and
            # sailed past this rule on George Caruso's 8/24 request.
            if re.search(r"\b[a-z][a-z\s\.]{2,26},?\s+(?:ny|nj|ct|pa|ma|fl|tx|ca|il|oh|ga|nc|va|md)"
                         r"\s+\d{5}(?:-\d{4})?\b", low):
                return True
            # house number may be hyphenated (Queens style '46-41 VERNON BLVD') and the line
            # may carry a job/contractor tag after a slash ('622 W 168 ST / ALLAN BRITEWAY')
            if re.search(r"^\s*\d{1,6}(?:-\d{1,6})?\s+[a-z0-9][a-z0-9\s\.\-']{2,30}\s+"
                         r"(?:rd|road|st|street|ave|avenue|blvd|boulevard|ln|lane|dr|drive|"
                         r"way|pkwy|parkway|hwy|highway|ct|court|pl|place|ter|terrace)\b\.?"
                         r"(?:\s*/\s*[a-z0-9\s\.\-'&]{2,40})?\s*$", low):
                return True
            # v4.2.5: ORDINAL STREET NAME, with NO leading house number required and NO
            # end anchor. The pattern above needs the line to START with the number and END
            # at the street type, which fails in the two ways seen live on PO CPCJ384:
            #   (a) the house number is split off as the QUANTITY before this ever runs, so
            #       '110 NORTH 63RD STREET' arrives here as 'NORTH 63RD STREET ...';
            #   (b) the PO renders two columns onto one text line, so the job name trails the
            #       address ('... 63RD STREET  AECOM-TISHMAN-BELMONT GRNDSND') and the end
            #       anchor cannot match either.
            # Measured before/after: '110 NORTH 63RD STREET' was already True, but
            # 'NORTH 63RD STREET AECOM-TISHMAN-BELMONT GRNDSND' and
            # '110 NORTH 63RD STREET AECOM-TISHMAN-BELMONT GRNDSND' were both False.
            # Requires an ORDINAL (63RD/40TH/31ST) immediately before the street type, which
            # is what makes it address-specific -- 'STREET LIGHT POLE' has no ordinal and is
            # never matched. The material-word escape at the top of this method still runs
            # FIRST, so a real line naming hardware is kept regardless.
            if re.search(r"\b\d{1,4}(?:st|nd|rd|th)\b\s+"
                         r"(?:street|st|ave|avenue|road|rd|blvd|boulevard|place|pl|drive|dr)\b", low):
                return True
            # v4.2.68: the bare-street test computed above (before the material-word
            # escape, which it must bypass -- 'East Union Avenue' contains 'union').
            if _bare_street:
                return True
            if re.search(r"\b(?:attn|attention|deliver\s*to|ship\s*to|bill\s*to|job\s*#|"
                         r"purchase\s+information|material\s+information|date\s+required|"
                         r"stage\s+in\s+shop|now\s+hiring|quantity\s*\|\s*description|"
                         r"mbe\s+sbe|daily\s+material|inside\s+sales|cust\.?\s*#|"
                         r"date\s+ordered|booked\s+date|order\s+date|customer\s+po\s+number|"
                         r"purchase\s+order\s+number|po\s+number)\b", low):
                return True
            if re.search(r"^\s*(?:www\.|https?://)", low):
                return True
            # v4.2.85 (George Caruso's Brewster xlsx): SPREADSHEET HELPER chrome.
            # The workbook's legend/helper cells were extracted as items: a literal
            # VLOOKUP formula, "Must use data validation if the table is filled out",
            # "Fomula to use if table is filled out" (the template's own typo -- match
            # the distinctive tail, not the misspelled word), and a "Location |
            # Address" column-legend pair.
            if re.search(r"\bvlookup\s*\(|\bdata\s+validation\b|"
                         r"if\s+(?:the\s+)?table\s+is\s+filled", low):
                return True
            if re.fullmatch(r"\s*\|?\s*(?:cost\s+code|location|address|description|qty|"
                            r"quantity|unit|item|notes?)"
                            r"(?:\s*\|\s*(?:cost\s+code|location|address|description|"
                            r"qty|quantity|unit|item|notes?))+\s*\|?\s*", low):
                return True
            return False
        except Exception:
            return False

    @staticmethod
    def _message_is_auto_reply(subject, body=""):
        """v4.1.95: True for an automatic out-of-office / vacation bounce.

        User's point, and it is the right one: 'even if she was a customer it should have
        seen it was an auto-reply and shouldn't have counted that as closing a quote'. An
        out-of-office is the mail SERVER talking, not the person -- it carries no answer, so
        it must never clear a tracker, close a thread, or archive a job. Nothing consulted
        this before: the phrase list that existed ('auto reply', 'out of office', ...) was
        local to the reactivation-reply check, gated on len(text) < 90, and invisible to
        every workflow decision.

        Subject is the strong signal (Outlook and most servers prefix it); body phrases are
        the fallback for servers that do not. Deliberately requires an AUTOMATIC-sounding
        phrase rather than merely mentioning being away, so a human writing 'I'm out
        tomorrow but here are the prices' is NOT suppressed."""
        try:
            subj = str(subject or "").strip().lower()
            if re.match(r"^\s*(?:re\s*:\s*|fw\s*:\s*|fwd\s*:\s*)*"
                        r"(?:automatic\s+reply|auto\s*-?\s*reply|autoreply|out\s+of\s+(?:the\s+)?office|"
                        r"away\s+from\s+(?:my\s+)?(?:desk|office)|on\s+vacation|vacation\s+reply)\b",
                        subj):
                return True
            text = re.sub(r"\s+", " ", str(body or "")).strip().lower()[:1200]
            if not text:
                return False
            strong = (
                "i am currently out of the office", "i'm currently out of the office",
                "i am out of the office", "i'm out of the office",
                "will be out of the office", "am currently away from the office",
                "this is an automatic reply", "this is an automated reply",
                "automatic reply", "auto-generated response",
                "thank you for your email. i am", "i am away from the office",
            )
            return any(p in text for p in strong)
        except Exception:
            return False

    def clear_sent_waiting_placeholder_for_reply(self, email):
        """When a matching incoming reply arrives, clear the sent-placeholder reminder.

        Match by Outlook conversation id first, then by normalized subject as a fallback.
        The timestamp guard keeps the original older inbox email from clearing a brand-new
        sent/waiting tracker.
        """
        try:
            if not email or email.get("is_sent_waiting_placeholder"):
                return False
            # v4.1.95: an out-of-office is the server talking, not the vendor. It carries no
            # answer, so it must not satisfy the tracker we are waiting on.
            if self._message_is_auto_reply(email.get("subject", ""),
                                           email.get("body", "") if email.get("body_loaded") else ""):
                try:
                    ops_log("tracker", "clear_skipped_auto_reply",
                            eid=str(email.get("entry_id", ""))[-16:],
                            subj=str(email.get("subject", ""))[:60], via="placeholder")
                except Exception:
                    pass
                return False
            conversation_id = email.get("conversation_id", "")
            subject_key = self._normalized_thread_subject(email.get("subject", ""))
            if not conversation_id and not subject_key:
                return False
            changed = False
            now = datetime.now().isoformat()
            for placeholder in getattr(self, "sent_waiting_placeholders", []):
                if placeholder.get("cleared"):
                    continue

                same_thread = False
                if conversation_id and placeholder.get("conversation_id") == conversation_id:
                    same_thread = True
                elif subject_key and self._normalized_thread_subject(placeholder.get("subject", "")) == subject_key:
                    same_thread = True
                if not same_thread:
                    continue

                # v4.1.77: same thread is not enough -- the reply must come from the party
                # this tracker is waiting on (multi-vendor RFQs share one thread/subject).
                if not self._reply_sender_matches_tracker_recipient(
                        email.get("sender_email", ""), email.get("sender", ""), placeholder):
                    self._log_clear_skip_once(
                        placeholder.get("entry_id", ""),
                        email.get("sender_email", ""),
                        placeholder.get("recipient_smtp") or placeholder.get("sender_email") or placeholder.get("sender"),
                        via="import_clear")
                    continue

                # Only clear when the incoming message is newer than the sent placeholder.
                # This prevents the original customer/vendor email in the same conversation from
                # immediately clearing the reminder during the next refresh.
                try:
                    # v4.2.2: the inbound row stores a UTC-based epoch and the placeholder
                    # a LOCAL one, so comparing them raw made a reply that arrived within
                    # ~4h of our send read as OLDER than the send -- and this guard then
                    # skipped clearing the tracker. Observed live on the Bayview thread:
                    # this path skipped it and bounded_outlook_thread_reply_found cleared
                    # it 5 minutes later instead. Both sides now share one basis.
                    email_ts = self._comparable_received_epoch(email)
                    placeholder_ts = self._comparable_received_epoch(placeholder)
                except Exception:
                    email_ts = 0
                    placeholder_ts = 0
                if placeholder_ts and email_ts and email_ts <= (placeholder_ts + 30):
                    continue

                placeholder["cleared"] = True
                placeholder["cleared_at"] = now
                placeholder["cleared_by_entry_id"] = email.get("entry_id", "")
                placeholder["cleared_reason"] = "matching_reply_imported"
                # v3.8.29: remember WHEN the clearing reply arrived. The Sent Items
                # scan re-sees the original sent message on later refreshes; the
                # resurrect guard in add_or_update_sent_waiting_placeholder() uses
                # this to tell "same old send" (keep cleared) apart from "user sent
                # again after the reply" (genuine re-open -> allow a fresh tracker).
                placeholder["cleared_reply_timestamp"] = email_ts
                changed = True
                # v3.9.89: the reply takes the tracker's place IN THE SAME GROUP -- inherit the
                # tracker's group so the request, the now-cleared tracker, and this reply stay
                # together. Additive: only sets a membership when the reply has none; never moves it.
                try:
                    _pg = self.groups_data.get("memberships", {}).get(placeholder.get("entry_id", ""), "")
                    _rid = email.get("entry_id", "")
                    if (_pg and _rid and self.get_group_by_id(_pg)
                            and not self.groups_data.get("memberships", {}).get(_rid)):
                        self.groups_data.setdefault("memberships", {})[_rid] = _pg
                except Exception:
                    pass
            if changed:
                # v3.9.51: flag the reply that cleared this sent placeholder by intent (see
                # _flag_tracked_reply_by_intent) so the next step is smooth. Placeholders do not
                # carry Vendor/Customer, so the helper derives it from the reply's own sender type.
                self._flag_tracked_reply_by_intent(email, "")
                active_ids = {p.get("entry_id", "") for p in self.sent_waiting_placeholders if not p.get("cleared")}
                self.emails = [e for e in self.emails if not e.get("is_sent_waiting_placeholder") or e.get("entry_id") in active_ids]
                self._rebuild_email_index()
                self.save_sent_waiting_placeholders()
                self.save_cached_state()
            return changed
        except Exception:
            return False


    def clear_existing_sent_waiting_tracker_rows_for_reply(self, reply_email):
        """Close older real-email rows that were only being shown as sent/waiting trackers.

        Sent tracking can be displayed in two ways:
        1) a separate Sent / Waiting placeholder row, and
        2) the original customer/vendor row re-activated to Waiting after the user sends a reply.

        clear_sent_waiting_placeholder_for_reply() handles #1. This handles #2 so that when a
        newer inbound reply arrives, the older "I sent this out" tracker row leaves the main
        active pane and the new reply becomes the item the user sees/acts on.
        """
        try:
            if not reply_email or reply_email.get("is_sent_waiting_placeholder"):
                return False
            # v4.1.95: same rule as the placeholder path -- an auto-reply is not the response
            # we are waiting on, so it may not retire the tracker row either.
            if self._message_is_auto_reply(
                    reply_email.get("subject", ""),
                    reply_email.get("body", "") if reply_email.get("body_loaded") else ""):
                try:
                    ops_log("tracker", "clear_skipped_auto_reply",
                            eid=str(reply_email.get("entry_id", ""))[-16:],
                            subj=str(reply_email.get("subject", ""))[:60], via="row")
                except Exception:
                    pass
                return False
            reply_id = str(reply_email.get("entry_id", "") or "")
            conversation_id = str(reply_email.get("conversation_id", "") or "").strip()
            subject_key = self._normalized_thread_subject(reply_email.get("subject", ""))
            if not conversation_id and not subject_key:
                return False
            try:
                reply_ts = float(reply_email.get("received_timestamp", 0) or 0)
            except Exception:
                reply_ts = 0
            if not reply_ts:
                return False

            changed = False
            cleared_at = datetime.now().isoformat()
            waiting_party = ""  # v3.9.51: which side the cleared tracker was waiting on (Vendor/Customer)
            for tracked in list(getattr(self, "emails", []) or []):
                try:
                    if not isinstance(tracked, dict):
                        continue
                    if tracked.get("is_sent_waiting_placeholder"):
                        continue
                    tracked_id = str(tracked.get("entry_id", "") or "")
                    if tracked_id and tracked_id == reply_id:
                        continue
                    # Only close rows MaINbox explicitly woke up as sent-waiting trackers.
                    # This avoids completing normal/manual Waiting items that are unrelated to
                    # the sent-tracker feature.
                    if not tracked.get("sent_waiting_tracker_active"):
                        continue

                    same_thread = False
                    tracked_conv = str(tracked.get("conversation_id", "") or "").strip()
                    if conversation_id and tracked_conv and tracked_conv == conversation_id:
                        same_thread = True
                    elif subject_key and self._normalized_thread_subject(tracked.get("subject", "")) == subject_key:
                        same_thread = True
                    if not same_thread:
                        continue

                    # v4.1.77: a re-activated tracker row IS the original inbound email, so its
                    # sender fields name the party we are waiting on -- the reply must come from
                    # them (person or same domain), not from another vendor on the shared thread.
                    if not self._reply_sender_matches_tracker_recipient(
                            reply_email.get("sender_email", ""), reply_email.get("sender", ""), tracked):
                        continue

                    try:
                        tracked_ts = float(tracked.get("sent_waiting_tracker_sent_timestamp", 0) or tracked.get("received_timestamp", 0) or 0)
                    except Exception:
                        tracked_ts = 0
                    # The response must be newer than the row/tracker it is clearing. Give Outlook
                    # a small clock/conversation-sync cushion so the original row cannot clear itself.
                    if tracked_ts and reply_ts <= (tracked_ts + 30):
                        continue

                    tracked["sent_waiting_tracker_active"] = False
                    tracked["sent_waiting_tracker_cleared_at"] = cleared_at
                    tracked["sent_waiting_tracker_cleared_by_entry_id"] = reply_id
                    tracked["sent_waiting_tracker_cleared_reason"] = "matching_reply_imported"
                    _orig_tracked_status = tracked.get("status")
                    if _orig_tracked_status == "Waiting on Vendor" and not waiting_party:
                        waiting_party = "Vendor"
                    elif _orig_tracked_status == "Waiting on Customer" and not waiting_party:
                        waiting_party = "Customer"
                    if _orig_tracked_status in ("Waiting on Vendor", "Waiting on Customer"):
                        # v4.1.91: the reply ARRIVING is not the work being DONE -- only a
                        # confidently closing reply still completes; anything else hands the
                        # ball back to us. See _status_after_tracker_clear.
                        tracked["status"] = self._status_after_tracker_clear(reply_id, tracked)
                    tracked["is_new_import"] = False
                    self.save_record(tracked)
                    changed = True
                except Exception:
                    continue

            if changed:
                # v3.9.51: the inbound reply that just cleared a tracker is the response we were
                # waiting on -- flag it by intent so the next step is smooth (a question -> Needs
                # Reply; "working on it / I'll get back to you" -> Waiting on Vendor/Customer matching
                # who we sent to; a plain thanks -> Completed).
                self._flag_tracked_reply_by_intent(reply_email, waiting_party)
                self.flush_status_data()
                # Remove completed tracker rows from the default active pane immediately; they remain
                # available under Completed/search/history if the user needs them.
                self._rebuild_email_index()
                self.save_cached_state()
            return changed
        except Exception:
            return False

    def sweep_sent_waiting_trackers_against_loaded_replies(self):
        """Hard cleanup for Sent / Waiting trackers that already have a newer reply loaded.

        This covers the real-world Joanne case where both rows are visible/searchable:
        - a Sent / Waiting tracker row from the sent email, and
        - a newer inbound RE: row from the other person.

        The older cleanup depended on the incoming import event or the backing
        sent_waiting_placeholders list. If the reply was already in the cache/search list,
        or the visible tracker row was orphaned from that backing list, the row could sit
        in the main pane forever. This sweep compares every visible Sent / Waiting tracker
        against every loaded non-placeholder reply and removes/completes only trackers that
        have a clearly newer matching reply.
        """
        changed = False
        cleared_replies = 0
        try:
            rows = list(getattr(self, "emails", []) or [])
            if not rows:
                return 0

            def norm_subject(value):
                # Use the global normalizer here because it strips RE/FW/External prefixes
                # consistently for both sent placeholders and already-cached inbound replies.
                try:
                    return normalize_subject_for_match(value or "")
                except Exception:
                    try:
                        return self._normalized_thread_subject(value or "")
                    except Exception:
                        return str(value or "").strip().lower()

            def row_ts(row):
                """Return a sortable timestamp for sent/reply matching.

                Older cached rows can have only the display string (for example
                '2026-06-08 12:33 PM') and no received_timestamp. The earlier
                hard cleanup skipped those rows because timestamp was 0, which
                let old Sent / Waiting trackers stay visible even after the
                matching reply was already loaded.
                """
                if not isinstance(row, dict):
                    return 0.0
                # v4.1.86: the TRACKER's own send time comes FIRST. For a real inbound row
                # ACTIVATED as a tracker (the dominant flow -- user replies in Outlook), the
                # meaningful "when did we send" is sent_waiting_tracker_sent_timestamp; its
                # received_timestamp is when the CUSTOMER's mail arrived, hours earlier. With
                # the old order the tracker looked far older than it was, so the newer-reply
                # guard below passed for messages that PREDATE our reply -- including the very
                # email the tracker was created from, which then auto-completed it (reproduced
                # live: S5 replied 21:41:50, cleared by its own 21:37 inbound). Placeholders are
                # unaffected: they carry no tracker timestamp and fall through to
                # received_timestamp, which for them IS the send time.
                for key in ("sent_waiting_tracker_sent_timestamp", "received_timestamp", "sent_timestamp"):
                    try:
                        value = row.get(key, 0)
                        if value not in (None, ""):
                            ts = float(value)
                            if ts > 0:
                                return ts
                    except Exception:
                        pass
                for key in ("received", "sent_on", "created_at", "updated_at"):
                    value = str(row.get(key, "") or "").strip()
                    if not value:
                        continue
                    # Drop timezone suffixes only for display-string fallback matching;
                    # we only need relative ordering inside the same Outlook mailbox.
                    value_clean = value.replace("T", " ")
                    value_clean = re.sub(r"\.\d+", "", value_clean)
                    value_clean = re.sub(r"(Z|[+-]\d{2}:?\d{2})$", "", value_clean).strip()
                    for fmt in (
                        "%Y-%m-%d %I:%M %p",
                        "%Y-%m-%d %H:%M",
                        "%Y-%m-%d %H:%M:%S",
                        "%m/%d/%Y %I:%M %p",
                        "%m/%d/%Y %H:%M",
                        "%m/%d/%y %I:%M %p",
                        "%m/%d/%y %H:%M",
                    ):
                        try:
                            return datetime.strptime(value_clean, fmt).timestamp()
                        except Exception:
                            continue
                    try:
                        return datetime.fromisoformat(value_clean).timestamp()
                    except Exception:
                        pass
                return 0.0

            replies = []
            for row in rows:
                if not isinstance(row, dict):
                    continue
                if row.get("is_sent_waiting_placeholder") or row.get("source") == "Sent / Waiting":
                    continue
                ts = row_ts(row)
                if not ts:
                    continue
                subj = norm_subject(row.get("subject", ""))
                conv = str(row.get("conversation_id", "") or "").strip()
                if not conv and not subj:
                    continue
                replies.append((row, conv, subj, ts))
            if not replies:
                return 0

            def matches_reply(tracker, reply_conv, reply_subj):
                tracker_conv = str(tracker.get("conversation_id", "") or "").strip()
                if tracker_conv and reply_conv and tracker_conv == reply_conv:
                    return True
                tracker_subj = norm_subject(tracker.get("subject", ""))
                if tracker_subj and reply_subj and tracker_subj == reply_subj:
                    return True
                return False

            now = datetime.now().isoformat()
            active_placeholder_ids = set()
            for placeholder in getattr(self, "sent_waiting_placeholders", []) or []:
                if not isinstance(placeholder, dict) or placeholder.get("cleared"):
                    continue
                sent_ts = row_ts(placeholder)
                if not sent_ts:
                    continue
                for reply, reply_conv, reply_subj, reply_ts in replies:
                    if reply_ts <= sent_ts + 30:
                        continue
                    if not matches_reply(placeholder, reply_conv, reply_subj):
                        continue
                    # v4.1.77: the reply must come from the party this tracker waits on.
                    if not self._reply_sender_matches_tracker_recipient(
                            reply.get("sender_email", ""), reply.get("sender", ""), placeholder):
                        continue
                    placeholder["cleared"] = True
                    placeholder["cleared_at"] = now
                    placeholder["cleared_by_entry_id"] = reply.get("entry_id", "")
                    placeholder["cleared_reason"] = "matching_reply_imported"
                    placeholder["cleared_reply_timestamp"] = reply_ts
                    pid = placeholder.get("entry_id", "")
                    if pid:
                        rec = self.status_data.get(pid, {}) if isinstance(self.status_data, dict) else {}
                        if isinstance(rec, dict):
                            rec.update({
                                "status": "Completed",
                                "sent_waiting_cleared": True,
                                "sent_waiting_cleared_at": now,
                                "sent_waiting_cleared_by_entry_id": reply.get("entry_id", ""),
                                "updated_at": now,
                            })
                            self.status_data[pid] = rec
                    changed = True
                    cleared_replies += 1
                    break

            for placeholder in getattr(self, "sent_waiting_placeholders", []) or []:
                if isinstance(placeholder, dict) and not placeholder.get("cleared"):
                    pid = placeholder.get("entry_id", "")
                    if pid:
                        active_placeholder_ids.add(pid)

            # Also remove orphaned visible Sent / Waiting rows even if their backing
            # placeholder record is missing/stale. This is intentionally limited to rows
            # explicitly marked as Sent / Waiting so normal Waiting-on-Vendor rows are not touched.
            kept = []
            for row in rows:
                if not isinstance(row, dict):
                    continue
                is_visible_tracker = bool(row.get("is_sent_waiting_placeholder") or row.get("source") == "Sent / Waiting")
                if not is_visible_tracker:
                    kept.append(row)
                    continue
                pid = row.get("entry_id", "")
                if row.get("is_sent_waiting_placeholder") and pid in active_placeholder_ids:
                    # Keep active placeholders unless a newer reply proves this visible row is stale.
                    pass
                sent_ts = row_ts(row)
                should_remove = False
                if sent_ts:
                    for reply, reply_conv, reply_subj, reply_ts in replies:
                        if reply_ts <= sent_ts + 30:
                            continue
                        # v4.1.77: the reply must come from the party this tracker waits on.
                        if not self._reply_sender_matches_tracker_recipient(
                                reply.get("sender_email", ""), reply.get("sender", ""), row):
                            continue
                        if matches_reply(row, reply_conv, reply_subj):
                            should_remove = True
                            row["cleared"] = True
                            row["cleared_at"] = now
                            row["cleared_by_entry_id"] = reply.get("entry_id", "")
                            row["cleared_reason"] = "matching_reply_imported"
                            row["cleared_reply_timestamp"] = reply_ts
                            if pid:
                                rec = self.status_data.get(pid, {}) if isinstance(self.status_data, dict) else {}
                                if isinstance(rec, dict):
                                    rec.update({
                                        "status": "Completed",
                                        "sent_waiting_cleared": True,
                                        "sent_waiting_cleared_at": now,
                                        "sent_waiting_cleared_by_entry_id": reply.get("entry_id", ""),
                                        "updated_at": now,
                                    })
                                    self.status_data[pid] = rec
                            changed = True
                            cleared_replies += 1
                            break
                if not should_remove:
                    kept.append(row)

            if changed:
                self.emails = kept
                self._rebuild_email_index()
                try:
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
                try:
                    self.flush_status_data()
                except Exception:
                    pass
                try:
                    self.save_cached_state()
                except Exception:
                    pass
            return cleared_replies
        except Exception:
            return 0

    def assign_imported_reply_to_tracker_group(self, reply_email, tracker=None):
        """Put a rescued incoming reply into the same group as the waiting tracker it replaces.

        The normal auto-group path intentionally has safety guards (especially domain guards),
        but this path is different: the reply has already matched an active sent/waiting tracker
        by Outlook thread/subject and newer timestamp. In that case it should inherit the exact
        group from the tracker/original row so the old tracker can be replaced by the real reply
        inside the correct quote/job group.
        """
        try:
            if not isinstance(reply_email, dict) or not isinstance(tracker, dict):
                return False
            reply_id = str(reply_email.get("entry_id", "") or "").strip()
            if not reply_id or self.get_group_id_for_email(reply_id):
                return False

            candidates = []
            for key in ("entry_id", "tracked_entry_id", "original_entry_id", "source_entry_id", "parent_entry_id"):
                value = str(tracker.get(key, "") or "").strip()
                if value and value not in candidates:
                    candidates.append(value)

            group_id = ""
            for candidate_id in candidates:
                group_id = self.get_group_id_for_email(candidate_id)
                if group_id and self.get_group_by_id(group_id):
                    break

            # If the visible tracker row is grouped only by thread membership somewhere else,
            # use the existing thread resolver as a final safe fallback.
            if not group_id:
                group_id = self.find_group_id_for_thread(tracker, skip_entry_id=reply_id)
            if not group_id:
                group_id = self.find_group_id_for_thread(reply_email, skip_entry_id=reply_id)

            group = self.get_group_by_id(group_id) if group_id else None
            if not group:
                return False

            self.groups_data.setdefault("memberships", {})[reply_id] = group_id
            reply_email["thread_group_rule"] = "sent_waiting_tracker_group"
            reply_email["sent_waiting_tracker_group_id"] = group_id
            reply_email["sent_waiting_tracker_group_name"] = group.get("name", "")
            reply_email["sent_waiting_tracker_grouped_from_entry_id"] = candidates[0] if candidates else ""
            self.mark_group_has_new(group_id)
            self.save_groups()
            return True
        except Exception:
            return False

    def import_matching_inthread_reply_from_outlook(self, msg, folder_label="", tracker=None, silent=True):
        """Import a real inbound reply that matched an active Waiting/Sent tracker.

        v3.9.19 fix: Sales mailbox refresh normally honors the selected Outlook
        category, which is correct for new unrelated mail, but vendor replies can
        arrive uncategorized. If a reply is in the same thread as an active
        sent/waiting tracker, it must be imported even when the category filter
        would have skipped it; otherwise the old Waiting row remains visible and
        the user never sees the answer in MaINbox.
        """
        try:
            source_label = "Sales" if "sales" in str(folder_label or "").lower() else "My Inbox"
            email = self.build_email_data(msg, source_label)
            if not email:
                return False
            entry_id = str(email.get("entry_id", "") or "").strip()
            if not entry_id:
                return False
            already_loaded = bool(self.get_email_by_id(entry_id))
            is_new = self.upsert_email(email)
            try:
                self.assign_imported_reply_to_tracker_group(email, tracker=tracker)
            except Exception:
                pass
            try:
                self.suppress_my_inbox_duplicate_when_sales_copy_exists(email)
            except Exception:
                pass
            if is_new and email.get("urgency") != "Low":
                try:
                    self.handle_new_email_after_import(email, silent=silent)
                except Exception:
                    pass
                try:
                    scheduled_commitments = self.scan_outlook_message_for_commitments(msg, email, direction=source_label)
                    if scheduled_commitments:
                        email["followup_time"] = self.get_followup_display_for_email(email.get("entry_id", ""))
                except Exception:
                    pass
            if is_new or not already_loaded:
                try:
                    self.save_record(email)
                    self.flush_status_data()
                except Exception:
                    pass
            return bool(is_new or not already_loaded)
        except Exception:
            return False

    def scan_outlook_inbox_for_sent_waiting_thread_replies(self, max_items=80, lookback_days=7):
        """Bounded rescue scan for active Waiting/Sent trackers.

        v3.9.20 performance fix: v3.9.19 proved the right idea, but it could be
        too broad during Refresh because it scanned many Outlook messages against
        every active Waiting row. This version keeps the same behavior but only
        looks at recent, active tracker candidates and only imports a reply after
        a cheap thread/subject match is found.
        """
        running_flag = "_sent_waiting_thread_scan_running"
        last_flag = "_sent_waiting_thread_scan_last_at"
        try:
            if getattr(self, running_flag, False):
                return 0
            now_ts_guard = datetime.now().timestamp()
            last_ts_guard = float(getattr(self, last_flag, 0) or 0)
            # Refresh can call reconciliation several times; one bounded scan is enough.
            if last_ts_guard and (now_ts_guard - last_ts_guard) < 8:
                return 0
            setattr(self, running_flag, True)
            setattr(self, last_flag, now_ts_guard)
        except Exception:
            pass

        try:
            # v3.9.27 fix (the "ty reply never cleared the tracker" bug): the old caps
            # silently clamped the caller's max_items=160 down to 70 AND that budget was
            # shared across folders. My Inbox is scanned first, so on any busy mailbox it
            # consumed the entire budget and the Sales Inbox was NEVER reached. Replies
            # that live only in the Sales Inbox (uncategorized customer replies are not
            # imported by the category-filtered refresh) could then never clear their
            # tracker. The budget is now PER FOLDER and honors the caller up to 200.
            try:
                per_folder_max = max(15, min(int(max_items or 80), 200))
            except Exception:
                per_folder_max = 160
            try:
                lookback_days = max(1, min(int(lookback_days or 7), 14))
            except Exception:
                lookback_days = 7

            def norm_subject(value):
                try:
                    return normalize_subject_for_match(value or "")
                except Exception:
                    try:
                        return self._normalized_thread_subject(value or "")
                    except Exception:
                        return str(value or "").strip().lower()

            def parse_row_ts(row):
                if not isinstance(row, dict):
                    return 0.0
                # v4.1.86: the TRACKER's own send time comes FIRST. For a real inbound row
                # ACTIVATED as a tracker (the dominant flow -- user replies in Outlook), the
                # meaningful "when did we send" is sent_waiting_tracker_sent_timestamp; its
                # received_timestamp is when the CUSTOMER's mail arrived, hours earlier. With
                # the old order the tracker looked far older than it was, so the newer-reply
                # guard below passed for messages that PREDATE our reply -- including the very
                # email the tracker was created from, which then auto-completed it (reproduced
                # live: S5 replied 21:41:50, cleared by its own 21:37 inbound). Placeholders are
                # unaffected: they carry no tracker timestamp and fall through to
                # received_timestamp, which for them IS the send time.
                for key in ("sent_waiting_tracker_sent_timestamp", "received_timestamp", "sent_timestamp"):
                    try:
                        value = row.get(key, 0)
                        if value not in (None, ""):
                            ts = float(value)
                            if ts > 0:
                                return ts
                    except Exception:
                        pass
                for key in ("received", "sent_on", "created_at", "updated_at"):
                    value = str(row.get(key, "") or "").strip()
                    if not value:
                        continue
                    value_clean = value.replace("T", " ")
                    value_clean = re.sub(r"\.\d+", "", value_clean)
                    value_clean = re.sub(r"(Z|[+-]\d{2}:?\d{2})$", "", value_clean).strip()
                    for fmt in ("%Y-%m-%d %I:%M %p", "%Y-%m-%d %H:%M", "%Y-%m-%d %H:%M:%S", "%m/%d/%Y %I:%M %p", "%m/%d/%Y %H:%M", "%m/%d/%y %I:%M %p", "%m/%d/%y %H:%M"):
                        try:
                            return datetime.strptime(value_clean, fmt).timestamp()
                        except Exception:
                            continue
                    try:
                        return datetime.fromisoformat(value_clean).timestamp()
                    except Exception:
                        pass
                return 0.0

            trackers = []
            cutoff_dt = datetime.now() - timedelta(days=lookback_days)
            cutoff_ts = cutoff_dt.timestamp()

            def add_tracker(kind, row):
                if not isinstance(row, dict):
                    return
                if row.get("cleared"):
                    return
                subj_key = norm_subject(row.get("subject", ""))
                conv_id = str(row.get("conversation_id", "") or row.get("sent_conversation_id", "") or row.get("sent_waiting_tracker_conversation_id", "") or "").strip()
                sent_ts = parse_row_ts(row)
                # Keep the rescue scan focused. Very old or keyless rows should not make
                # Refresh walk the whole mailbox.
                if sent_ts and sent_ts < cutoff_ts:
                    return
                if not subj_key and not conv_id:
                    return
                trackers.append({"kind": kind, "row": row, "ts": sent_ts, "subject_key": subj_key, "conversation_id": conv_id})

            for p in getattr(self, "sent_waiting_placeholders", []) or []:
                if isinstance(p, dict) and not p.get("cleared"):
                    add_tracker("placeholder", p)
            for row in getattr(self, "emails", []) or []:
                if not isinstance(row, dict):
                    continue
                if row.get("sent_waiting_tracker_active") or row.get("is_sent_waiting_placeholder") or row.get("source") == "Sent / Waiting":
                    add_tracker("row", row)
                elif row.get("status") in ("Waiting on Vendor", "Waiting on Customer") and row.get("urgency") != "Low":
                    add_tracker("waiting_row", row)

            if not trackers:
                return 0

            # Newest active trackers first and cap the total work. This avoids Refresh
            # hanging when old Waiting rows have accumulated.
            trackers.sort(key=lambda x: float(x.get("ts") or 0), reverse=True)
            trackers = trackers[:50]

            conv_map = {}
            subj_map = {}
            for t in trackers:
                if t.get("conversation_id"):
                    conv_map.setdefault(t["conversation_id"], []).append(t)
                if t.get("subject_key"):
                    subj_map.setdefault(t["subject_key"], []).append(t)

            outlook, namespace = self.fresh_outlook()
            if not namespace:
                return 0
            folders = self.coverage_inbox_folders_for_quote_scan(namespace)
            if not folders:
                try:
                    folders = [("My Inbox", namespace.GetDefaultFolder(6))]
                except Exception:
                    folders = []
            if not folders:
                return 0

            changed = False
            cleared = 0
            now = datetime.now().isoformat()
            seen_msg_ids = set()

            def clear_tracker(kind, tracker_row, reply_entry_id, reply_ts):
                nonlocal changed, cleared
                sent_ts = parse_row_ts(tracker_row)
                if sent_ts and reply_ts and reply_ts <= sent_ts + 30:
                    return False
                if kind == "placeholder" or tracker_row.get("is_sent_waiting_placeholder") or tracker_row.get("source") == "Sent / Waiting":
                    tracker_row["cleared"] = True
                    tracker_row["cleared_at"] = now
                    tracker_row["cleared_by_entry_id"] = reply_entry_id
                    tracker_row["cleared_reason"] = "bounded_outlook_thread_reply_found"
                    tracker_row["cleared_reply_timestamp"] = reply_ts
                    pid = tracker_row.get("entry_id", "")
                    if pid and isinstance(getattr(self, "status_data", None), dict):
                        rec = self.status_data.get(pid, {})
                        if isinstance(rec, dict):
                            rec.update({
                                "status": "Completed",
                                "sent_waiting_cleared": True,
                                "sent_waiting_cleared_at": now,
                                "sent_waiting_cleared_by_entry_id": reply_entry_id,
                                "sent_waiting_cleared_reason": "bounded_outlook_thread_reply_found",
                                "updated_at": now,
                            })
                            self.status_data[pid] = rec
                else:
                    tracker_row["sent_waiting_tracker_active"] = False
                    tracker_row["sent_waiting_tracker_cleared_at"] = now
                    tracker_row["sent_waiting_tracker_cleared_by_entry_id"] = reply_entry_id
                    tracker_row["sent_waiting_tracker_cleared_reason"] = "bounded_outlook_thread_reply_found"
                    if tracker_row.get("status") in ("Waiting on Vendor", "Waiting on Customer"):
                        # v4.1.91: same rule as the matching_reply_imported path -- a reply
                        # landing is not the work finishing. This is the exact site the probe
                        # caught closing 'FW: CM92425' (Waiting on Customer -> Completed).
                        tracker_row["status"] = self._status_after_tracker_clear(
                            reply_entry_id, tracker_row)
                    tracker_row["is_new_import"] = False
                    try:
                        self.save_record(tracker_row)
                    except Exception:
                        pass
                changed = True
                cleared += 1
                return True

            total_checked = 0
            for folder_label, folder in folders:
                try:
                    items = folder.Items
                    try:
                        cut_str = cutoff_dt.strftime("%m/%d/%Y %I:%M %p")
                        items = items.Restrict(f"[ReceivedTime] >= '{cut_str}'")
                    except Exception:
                        pass
                    try:
                        items.Sort("[ReceivedTime]", True)
                    except Exception:
                        pass
                    folder_checked = 0
                    for msg in items:
                        # v3.9.27: per-folder budget. The old shared total made the first
                        # folder (My Inbox) starve the Sales Inbox entirely.
                        if folder_checked >= per_folder_max:
                            break
                        folder_checked += 1
                        total_checked += 1
                        try:
                            try:
                                recv_dt = msg.ReceivedTime.replace(tzinfo=None)
                            except Exception:
                                recv_dt = None
                            if recv_dt is not None and recv_dt < cutoff_dt:
                                break
                            recv_ts = recv_dt.timestamp() if recv_dt else datetime.now().timestamp()
                            try:
                                entry_id = str(msg.EntryID or "")
                            except Exception:
                                entry_id = ""
                            if entry_id and entry_id in seen_msg_ids:
                                continue
                            if entry_id:
                                seen_msg_ids.add(entry_id)
                            try:
                                subject = str(msg.Subject or "")
                            except Exception:
                                subject = ""
                            try:
                                conv_id = str(msg.ConversationID or "").strip()
                            except Exception:
                                conv_id = ""
                            subj_key = norm_subject(subject)
                            candidates = []
                            if conv_id and conv_id in conv_map:
                                candidates.extend(conv_map.get(conv_id, []))
                            if subj_key and subj_key in subj_map:
                                for t in subj_map.get(subj_key, []):
                                    if t not in candidates:
                                        candidates.append(t)
                            if not candidates:
                                continue

                            # v4.2.88: OWNERSHIP GATE on the v3.9.19 category bypass.
                            # import_matching_inthread_reply_from_outlook deliberately ignores
                            # the Sales category filter, and its docstring justifies that for
                            # replies that arrive UNCATEGORIZED -- but the code never checked,
                            # so a message explicitly tagged to ANOTHER rep was imported too.
                            # Reproduced live (2026-08-25): Louis Ferro's 1:53pm "STOCK CHECK
                            # SUB 2" was tagged 'JS, Canals' (NOT in the SB restrict set, all
                            # 4746 scanned) yet landed in the SB main window -- it merely shared
                            # a normalized subject with an SB tracker armed at 1:10pm, and the
                            # sender guard passed because it really was from Louis. Rule, in the
                            # SHARED Sales mailbox only (My Inbox is personal and is never
                            # category-filtered, so it is untouched): no categories at all ->
                            # allow, exactly as v3.9.19 intended; carries MY category -> allow;
                            # carries only OTHER people's categories -> skip this message
                            # entirely, so it is neither imported nor allowed to clear a
                            # tracker. Fail-safe direction, same as v4.1.91: my row keeps
                            # waiting rather than silently closing on another rep's mail.
                            if "sales" in str(folder_label or "").lower():
                                try:
                                    _msg_cats = str(msg.Categories or "").strip()
                                except Exception:
                                    _msg_cats = ""
                                if _msg_cats and not self.email_has_outlook_category(
                                        _msg_cats, self.selected_sales_category):
                                    self._log_foreign_category_skip_once(
                                        entry_id, _msg_cats, subject)
                                    continue

                            # v4.1.77: who actually sent this reply? Needed to keep vendor B's
                            # reply from clearing the tracker waiting on vendor A (multi-vendor
                            # RFQs share one thread/subject). SMTP first (PidTagSenderSmtpAddress),
                            # then the raw sender address, plus display name for legacy
                            # name-only tracker rows.
                            reply_sender_smtp = ""
                            reply_sender_name = ""
                            try:
                                reply_sender_smtp = str(msg.PropertyAccessor.GetProperty(
                                    "http://schemas.microsoft.com/mapi/proptag/0x5D01001F") or "")
                            except Exception:
                                reply_sender_smtp = ""
                            if "@" not in reply_sender_smtp:
                                try:
                                    _raw_sender = str(getattr(msg, "SenderEmailAddress", "") or "")
                                    if "@" in _raw_sender and not _raw_sender.lower().startswith("/o="):
                                        reply_sender_smtp = _raw_sender
                                except Exception:
                                    pass
                            try:
                                reply_sender_name = str(getattr(msg, "SenderName", "") or "")
                            except Exception:
                                reply_sender_name = ""

                            imported = False
                            for t in list(candidates):
                                row = t.get("row")
                                if not isinstance(row, dict) or row.get("cleared"):
                                    continue
                                sent_ts = float(t.get("ts") or parse_row_ts(row) or 0)
                                if sent_ts and recv_ts <= sent_ts + 30:
                                    continue
                                # v4.1.77: same thread is NOT enough -- the reply must come from
                                # the party THIS tracker is waiting on (reported: brazill's reply
                                # auto-completed the theaenterprises tracker on the shared
                                # "solar NYPA P&A" thread). Mismatched trackers stay active for
                                # their own vendor's reply.
                                if not self._reply_sender_matches_tracker_recipient(
                                        reply_sender_smtp, reply_sender_name, row):
                                    self._log_clear_skip_once(
                                        row.get("entry_id", ""),
                                        reply_sender_smtp or reply_sender_name,
                                        row.get("recipient_smtp") or row.get("sender_email") or row.get("sender"),
                                        subj=str(subject or "")[:60])
                                    continue
                                try:
                                    if entry_id and not imported:
                                        existing_reply = self.get_email_by_id(entry_id)
                                        if existing_reply:
                                            self.assign_imported_reply_to_tracker_group(existing_reply, tracker=row)
                                            imported = True
                                        else:
                                            self.import_matching_inthread_reply_from_outlook(msg, folder_label=folder_label, tracker=row, silent=True)
                                            imported = True
                                except Exception:
                                    pass
                                # v3.9.27: clear EVERY matching tracker for this reply. The old
                                # break-after-first left sibling trackers (e.g. a placeholder AND
                                # a re-activated real row for the same thread) sitting active.
                                clear_tracker(t.get("kind", "row"), row, entry_id, recv_ts)
                        except Exception:
                            continue
                except Exception:
                    continue

            if changed:
                active_ids = {p.get("entry_id", "") for p in getattr(self, "sent_waiting_placeholders", []) or [] if isinstance(p, dict) and not p.get("cleared")}
                self.emails = [
                    e for e in (getattr(self, "emails", []) or [])
                    if not (isinstance(e, dict) and (e.get("is_sent_waiting_placeholder") or e.get("source") == "Sent / Waiting") and e.get("entry_id", "") not in active_ids)
                ]
                try:
                    self._rebuild_email_index()
                except Exception:
                    pass
                try:
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
                try:
                    self.flush_status_data()
                except Exception:
                    pass
                try:
                    self.save_cached_state()
                except Exception:
                    pass
            return cleared
        except Exception:
            return 0
        finally:
            try:
                setattr(self, running_flag, False)
            except Exception:
                pass

    def _status_after_tracker_clear(self, reply_entry_id, tracker_row=None,
                                    default_status="Needs Reply"):
        """v4.1.91: a clearing tracker means THE REPLY ARRIVED -- not that the work is done.

        Both clear paths used to force 'Completed' the moment any in-thread reply landed.
        That is backwards for the dominant case: we asked the customer a question, they
        ANSWERED, and the RFQ became MORE actionable, not finished. Reported live on the
        Gobin thread (we asked 'What job is this for?' 07:59, customer answered 08:03, the
        row went Completed 08:05) and caught again by the probe on real mail
        ('FW: CM92425', Waiting on Customer -> Completed).

        Rule: only a CONFIDENTLY CLOSING reply still completes; anything else -- including
        'unsure' -- returns the ball to us as Needs Reply. Fails safe by construction: an
        unreadable/unloaded body, an exception, or an ambiguous intent all fall through to
        the default, so the failure mode is 'a finished thread waits to be closed by hand'
        rather than 'a live RFQ silently disappears'.

        Deliberately reads only the CACHED body -- no COM, no AI, no blocking -- because
        this runs inside the sent/inbox scan loops. Deeper thread assessment belongs on the
        triage queue, off this hot path."""
        try:
            rep = self.get_email_by_id(str(reply_entry_id or "")) if reply_entry_id else None
            if not isinstance(rep, dict):
                return default_status
            body = rep.get("body", "") if rep.get("body_loaded") else ""
            # v4.1.95: belt-and-braces. The clear sites already refuse auto-replies, but if
            # one ever reaches here it must never be read as a closing reply.
            if self._message_is_auto_reply(rep.get("subject", ""), body):
                return default_status
            intent = analyze_reply_intent(
                subject=str(rep.get("subject", "") or ""), body=str(body or ""),
                sender_or_recipient=str(rep.get("sender_email", "") or rep.get("sender", "") or ""),
                source=str(rep.get("source", "") or ""), direction="inbound")
            if intent.get("is_closed_ack") and intent.get("intent") != "won_order":
                return "Completed"
            # v4.2.26: same bypass as _flag_tracked_reply_by_intent -- the default below is
            # "Needs Reply", which is wrong when the reply is on a thread WE originated.
            _clamped = self._clamp_status_for_sent_rfq_reply(rep, default_status,
                                                             where="tracker_clear_status")
            if _clamped != default_status:
                return _clamped
            try:
                ops_log("tracker", "clear_kept_open",
                        reply=str(reply_entry_id or "")[-16:],
                        intent=str(intent.get("intent", "")),
                        body_loaded=bool(rep.get("body_loaded")))
            except Exception:
                pass
            # v4.1.92: we were UNSURE, so queue the row for a better-informed second look
            # on the triage queue (see _thread_reassess_context). Purely additive: if the
            # reassessment never runs, the row just stays open, which is already correct.
            try:
                if isinstance(tracker_row, dict):
                    tracker_row["thread_reassess_pending"] = True
                    tracker_row["thread_reassess_reason"] = (
                        "tracker cleared, but the incoming reply was not confidently closing "
                        "(intent=%s)" % str(intent.get("intent", ""))[:40])
                    tracker_row["ai_triage_pending"] = True
            except Exception:
                pass
            return default_status
        except Exception:
            return default_status

    def _thread_reassess_context(self, email):
        """v4.1.92: when v4.1.91 was UNSURE and kept a row open, let the AI take a second,
        better-informed look -- on the TRIAGE QUEUE, never on the scan hot path.

        The user's design: MaINbox already pulls bodies effectively instantly, so hand the
        previous message in the thread to the triage queue and flag WHAT the AI is being
        asked to decide. Returns extra signal_context keys that get merged into the triage
        prompt's Pre-AI signals; {} when this row is not flagged, so the normal path is
        untouched.

        Why this is safe: it can only ever UPGRADE an unsure verdict. If the thread walk
        finds nothing, the body will not load, Outlook is busy, or the AI is offline, the
        row simply stays where v4.1.91 left it -- open. Nothing here can re-introduce a
        wrong close.

        One-shot: the flag is CLEARED as it is read, so a row cannot loop through
        reassessment on every drip tick.

        Uses load_body_if_needed, which returns instantly for an already-cached body,
        shares _outlook_worker_lock, and degrades to subject-only when Outlook is busy."""
        try:
            if not isinstance(email, dict) or not email.get("thread_reassess_pending"):
                return {}
            email["thread_reassess_pending"] = False      # one-shot, read-and-clear
            cid = str(email.get("conversation_id", "") or "").strip()
            if not cid:
                return {}
            try:
                mine = float(email.get("received_timestamp", 0) or 0)
            except Exception:
                mine = 0.0
            prev = None
            prev_ts = -1.0
            for other in list(getattr(self, "emails", []) or []):
                if not isinstance(other, dict) or other is email:
                    continue
                if other.get("is_sent_waiting_placeholder"):
                    continue
                if str(other.get("conversation_id", "") or "").strip() != cid:
                    continue
                try:
                    ots = float(other.get("received_timestamp", 0) or 0)
                except Exception:
                    continue
                if mine and ots >= mine:
                    continue
                if ots > prev_ts:
                    prev, prev_ts = other, ots
            if prev is None:
                return {"reassess_task": "decide_if_request_is_answered",
                        "reassess_reason": str(email.get("thread_reassess_reason", ""))[:120],
                        "previous_message_excerpt": "(no earlier message found in this thread)"}
            try:
                body = self.load_body_if_needed(prev) or ""
            except Exception:
                body = str(prev.get("body", "") or "")
            try:
                body = self._strip_signature_block(self._own_reply_text(body))
            except Exception:
                pass
            return {
                "reassess_task": "decide_if_request_is_answered",
                "reassess_reason": str(email.get("thread_reassess_reason", ""))[:120],
                "previous_message_subject": str(prev.get("subject", ""))[:120],
                "previous_message_from": str(prev.get("sender_email", "")
                                             or prev.get("sender", ""))[:80],
                "previous_message_excerpt": str(body or "").strip()[:800],
            }
        except Exception:
            return {}

    @staticmethod
    def _sent_reply_is_outbound_rfq(own_text):
        """v4.1.94: True when OUR message is us ASKING for pricing, not us ANSWERING.

        'Good afternoon, please provide me with price and availability for 40pcs of 6"
        rigid strut straps.' -- an RFQ we sent to a VENDOR. _reply_has_quote_content says
        True for it, because its keyword list ('price and availability', 'availability',
        'lead time') is DIRECTION-AGNOSTIC: identical whether we are requesting pricing or
        supplying it. So the replied-RFQ archive read our outward RFQ as our substantive
        answer to the CUSTOMER and archived the job before anything was quoted (reported:
        'RE: 220000 Astoria - 7/28/26 RFQ' archived after a 1-item vendor request whose only
        response was an out-of-office).

        The same shape is already guarded in the sent scan (v3.8.12's
        please provide|price and avail|pls quote|... escape hatch that clears a false
        closed_ack); this is that protection, applied to the archive path too.

        Conservative: an explicit REQUEST phrase, and no evidence we supplied actual
        numbers -- a real quote carrying '$' or per-unit pricing is never an RFQ, even when
        it also asks something."""
        try:
            text = str(own_text or "").strip().lower()
            if not text:
                return False
            if re.search(r"\$\s*\d", text):
                return False
            if re.search(r"\b\d+(?:\.\d+)?\s*(?:/\s*)?(?:ea|each|pcs?|per\s+(?:ea|foot|ft))\b"
                         r"\s*(?:@|=|\$)", text):
                return False
            return bool(re.search(
                r"please\s+provide\s+me\s+with|please\s+provide|price\s+and\s+avail|"
                r"pricing\s+and\s+avail|pls\s+quote|please\s+quote|can\s+you\s+quote|"
                r"bid\s+pricing|need\s+pricing\s+on|quote\s+the\s+following|"
                r"please\s+advise\s+pricing|can\s+you\s+price|looking\s+for\s+pricing\s+on",
                text))
        except Exception:
            return False

    @staticmethod
    def _sent_reply_is_question_back(own_text):
        """v4.1.91: True when OUR reply's own words ASK the other side something and carry
        no answer -- 'What job is this for?', 'Do you need these galvanized?'.

        A question back is a FOURTH reply category the code never modelled (it knew
        thank-you ack, deferral, real quote). Anything that was not an ack or a deferral
        fell through as 'we answered it'. Reproduced live: a clarifying question ending in
        'Thanks' classified as closed_ack and closed the whole RFQ in one step
        (New -> Completed) via the v3.9.70 block.

        Conservative: needs an actual '?' in our own words, and stays False for a long
        reply (>600 chars of own text), where a trailing question is far more likely to be
        a footnote on a real answer than the point of the message."""
        try:
            text = str(own_text or "").strip()
            if not text or "?" not in text:
                return False
            if len(text) > 600:
                return False
            return True
        except Exception:
            return False

    def auto_group_conversation_threads(self, max_new_groups=25):
        """v4.1.90: give an ungrouped THREAD a group of its own.

        Reported twice (Gobin '22-0400 | FRE Breathsaver XW | 155', and
        caity@innercityelectric 'CM92425' with FOUR messages): every message shared one
        Outlook ConversationID and one normalized subject, yet all stayed flat. The
        auto-group engine only ever answers "which EXISTING group should this join?" --
        it scored unrelated groups, logged action=none / "Winner margin is only 0%", and
        was right to decline. Nothing ever asked "do these messages form a group of
        their own?", so a purely inbound thread only got a group when some OTHER path
        made one (sent_tracker_request_pairing / auto_coverage_sent_rfq). This adds the
        missing question.

        Deliberately conservative -- identity, never similarity:
          * groups strictly by Outlook ConversationID, the thread's own identity. No
            subject/token/fuzzy matching, so it cannot produce the wrong-join failures
            the engine's margin rules exist to prevent.
          * needs 2+ live rows; app-deleted rows and sent/waiting placeholders excluded.
          * if ANY row in the thread already belongs to a group, the ungrouped siblings
            JOIN that group -- never a second competing group for one thread.
          * a brand-new group is created only when at least one row is still open. A
            thread where everything is already Completed is left flat: manufacturing
            groups for closed history would flood the group list for no work value.
          * max_new_groups caps the FIRST sweep so healing the backlog cannot explode
            the list in one pass; the rest heal on later sweeps.

        Returns the number of rows newly assigned, so the caller repaints."""
        changed = 0
        try:
            if not isinstance(getattr(self, "groups_data", None), dict):
                return 0
            memberships = self.groups_data.setdefault("memberships", {})
            status_data = getattr(self, "status_data", None)
            buckets = {}
            for e in list(getattr(self, "emails", []) or []):
                if not isinstance(e, dict) or e.get("is_sent_waiting_placeholder"):
                    continue
                eid = str(e.get("entry_id", "") or "")
                cid = str(e.get("conversation_id", "") or "").strip()
                if not eid or not cid:
                    continue
                if isinstance(status_data, dict):
                    _sd = status_data.get(eid)
                    if isinstance(_sd, dict) and _sd.get("app_deleted"):
                        continue
                buckets.setdefault(cid, []).append(e)

            created = 0
            for cid, rows in buckets.items():
                if len(rows) < 2:
                    continue
                ids = [str(r.get("entry_id", "") or "") for r in rows]
                gid_existing = ""
                for _i in ids:
                    _g = memberships.get(_i, "")
                    if _g and self.get_group_by_id(_g):
                        gid_existing = _g
                        break
                if gid_existing:
                    for _i in ids:
                        if not memberships.get(_i):
                            memberships[_i] = gid_existing
                            changed += 1
                    continue
                if created >= max_new_groups:
                    continue
                try:
                    if not any(not self.email_is_completed(r) for r in rows):
                        continue
                except Exception:
                    continue
                try:
                    _oldest = min(rows, key=lambda r: float(r.get("received_timestamp", 0) or 0))
                except Exception:
                    _oldest = rows[0]
                name = str(_oldest.get("subject", "") or "").strip()
                name = re.sub(r"^(?:\s*(?:re|fw|fwd)\s*:\s*)+", "", name, flags=re.I).strip()
                if not name:
                    name = "Thread"
                new_gid = self._unique_group_id()
                self.groups_data.setdefault("groups", []).append({
                    "id": new_gid, "name": name[:80], "urgency": "Normal",
                    "collapsed": False, "has_new": False,
                    "created_at": datetime.now().isoformat(), "notes": "",
                    "archived": False, "auto_created_reason": "conversation_thread"})
                for _i in ids:
                    memberships[_i] = new_gid
                created += 1
                changed += len(ids)
                try:
                    ops_log("group", "thread_group_created", gid=new_gid,
                            name=name[:60], rows=len(ids), cid=str(cid)[:16])
                except Exception:
                    pass
            if changed:
                self.save_groups()
        except Exception:
            pass
        return changed

    def reconcile_sent_waiting_placeholders_against_replies(self):
        """Clear any active sent/waiting tracker that already has a newer in-thread reply in
        the loaded email list. The per-message clear during a scan only fires while a reply is
        first being imported; since Sent Items (which create the trackers) are scanned AFTER
        the inbox, a reply imported in the same cycle can miss its tracker and then fall outside
        the incremental scan window, so it is never re-checked. This sweep re-checks every loaded
        reply against the current trackers, reusing the same conversation/subject + timestamp
        matching, so a received response always clears its tracker regardless of scan ordering.

        Returns the number of replies that cleared at least one tracker (0 if none), so callers
        that gate a repaint on "did anything change" treat a reconciliation-only clear as a change."""
        cleared = 0
        try:
            placeholders = getattr(self, "sent_waiting_placeholders", [])
            # v4.1.63 retro-heal: group any ACTIVE tracker still sitting flat (created
            # before the token-match grouping existed, or when the match was ambiguous
            # and a competing group has since been archived). Counted as a change so
            # the caller repaints.
            try:
                _members = self.groups_data.get("memberships", {}) if isinstance(getattr(self, "groups_data", None), dict) else {}
                for _p in placeholders:
                    if isinstance(_p, dict) and not _p.get("cleared") and not _members.get(str(_p.get("entry_id", "") or "")):
                        if self.auto_group_sent_tracker(_p):
                            cleared += 1
            except Exception:
                pass
            # v4.1.90: same sweep, the other missing half -- give an ungrouped
            # conversation thread a group of its own (see auto_group_conversation_threads).
            # Counted as a change so the caller repaints, exactly like the retro-heal above.
            try:
                cleared += int(self.auto_group_conversation_threads() or 0)
            except Exception:
                pass
            has_active_placeholder = any(not p.get("cleared") for p in placeholders)
            has_active_real_row_tracker = any(
                isinstance(row, dict) and row.get("sent_waiting_tracker_active")
                for row in (getattr(self, "emails", []) or [])
            )
            # First run the hard sweep. It catches already-loaded replies and orphaned
            # visible Sent / Waiting rows, not just brand-new import events.
            cleared += int(self.sweep_sent_waiting_trackers_against_loaded_replies() or 0)
            # Then ask Outlook itself: for each active sent tracker, scan recent incoming
            # messages and link by the actual thread/conversation chain. This catches cases
            # where the reply exists in Outlook but was not present in the cached row list.
            cleared += int(self.scan_outlook_inbox_for_sent_waiting_thread_replies(max_items=160, lookback_days=14) or 0)
            if not has_active_placeholder and not has_active_real_row_tracker:
                return cleared
            for e in list(self.emails):
                if not e.get("is_sent_waiting_placeholder"):
                    placeholder_cleared = self.clear_sent_waiting_placeholder_for_reply(e)
                    row_cleared = self.clear_existing_sent_waiting_tracker_rows_for_reply(e)
                    if placeholder_cleared or row_cleared:
                        cleared += 1
            # One final sweep handles rows that became orphaned during the per-reply clear.
            cleared += int(self.sweep_sent_waiting_trackers_against_loaded_replies() or 0)
        except Exception:
            pass
        return cleared

    def infer_status_after_reply_sent(self, email, target_status_after_send=None):
        # An explicit caller-provided target always wins (e.g. a vendor-no-response
        # follow-up that KNOWS it is chasing a vendor).
        if target_status_after_send in ["Waiting on Customer", "Waiting on Vendor"]:
            return target_status_after_send
        current = email.get("status", "") if email else ""
        if current in ["Waiting on Customer", "Waiting on Vendor"]:
            return current
        # v4.1.38: the DURABLE relationship type decides the direction BEFORE any
        # category/subject heuristic. The prior code inferred "vendor" from the
        # workflow category, so a reply to a Customer whose category had been
        # mis-classified "Vendor / Supplier" was recorded as Waiting-on-Vendor --
        # which then let the outbound quote be treated as a vendor RFQ. A confirmed
        # Customer is Waiting-on-Customer; a confirmed Vendor is Waiting-on-Vendor.
        try:
            _dtype = self._durable_email_type_for_email(email if isinstance(email, dict) else {})
        except Exception:
            _dtype = ""
        if _dtype == "C":
            return "Waiting on Customer"
        if _dtype == "V":
            return "Waiting on Vendor"
        # Type unknown -- fall back to the category/source/subject signal as before.
        category = (email.get("category", "") if email else "").lower()
        source = (email.get("source", "") if email else "").lower()
        subject = (email.get("subject", "") if email else "").lower()
        if "vendor" in category or "supplier" in category or "vendor" in source or "vendor" in subject:
            return "Waiting on Vendor"
        return "Waiting on Customer"

    def record_pending_reply_check(self, email, target_status_after_send=None, followup_source="manual"):
        if not email:
            return
        entry_id = email.get("entry_id", "")
        conversation_id = email.get("conversation_id", "")
        if not entry_id and not conversation_id:
            return
        existing_status = self.status_data.get(entry_id, {}) if entry_id else {}
        if entry_id and (existing_status.get("app_deleted") or existing_status.get("prevent_future_followups")):
            # Deleted-from-app items may still get one final kept follow-up, but
            # they should not start another sent-reply tracking cycle afterward.
            return
        target_status = self.infer_status_after_reply_sent(email, target_status_after_send)
        for item in self.pending_reply_checks:
            if item.get("completed") or item.get("cancelled"):
                continue
            if (entry_id and item.get("entry_id") == entry_id) or (conversation_id and item.get("conversation_id") == conversation_id):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Replaced by newer reply draft"
        self.pending_reply_checks.append({
            "entry_id": entry_id,
            "conversation_id": conversation_id,
            "store_id": email.get("store_id", ""),
            "subject": email.get("subject", ""),
            "created_at": datetime.now().isoformat(),
            "target_status_after_send": target_status,
            "category": email.get("category", ""),
            "urgency": email.get("urgency", ""),
            "source": followup_source,
            "completed": False,
            "cancelled": False,
        })
        self._followup_dedup_needed = True  # v3 efficiency: mark dirty.
        self.save_pending_reply_checks()

    def find_sent_reply_for_pending_check(self, pending):
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return None
        conversation_id = pending.get("conversation_id", "")
        if not conversation_id:
            return None
        try:
            created_at = datetime.fromisoformat(pending.get("created_at", "")) - timedelta(seconds=5)
        except Exception:
            created_at = datetime.now() - timedelta(days=1)
        try:
            sent_folder = namespace.GetDefaultFolder(5)  # olFolderSentMail
            items = sent_folder.Items
            items.Sort("[SentOn]", True)
            checked = 0
            for msg in items:
                if checked >= 150:
                    break
                checked += 1
                try:
                    sent_on = msg.SentOn
                    if sent_on and sent_on.replace(tzinfo=None) < created_at:
                        break
                    msg_conversation_id = ""
                    try:
                        msg_conversation_id = msg.ConversationID
                    except Exception:
                        msg_conversation_id = ""
                    if msg_conversation_id and msg_conversation_id == conversation_id:
                        return msg
                except Exception:
                    continue
        except Exception:
            return None
        return None

    @staticmethod
    def _own_reply_text(body):
        """v4.1.78: the reply author's OWN words -- the body text ABOVE the quoted
        history. A sent reply's .Body carries the whole chain underneath, so any
        content test run on the full body actually tests the OTHER side's words
        (reported: a bare 'will advise' reply was ruled a substantive quote because
        the CUSTOMER'S quoted P&A request below it contained pricing language).
        Cuts at the earliest of the standard Outlook/Gmail chain markers; if the cut
        would leave nothing (unusual formatting), returns the full body unchanged so
        every existing behavior is preserved for bodies we cannot split."""
        try:
            text = str(body or "")
            if not text.strip():
                return text
            cut = len(text)
            for pat in (
                r"(?im)^\s*-{2,}\s*original\s+message\s*-{2,}\s*$",
                r"(?im)^\s*_{6,}\s*$",                       # Outlook reply separator
                r"(?im)^\s*from:\s.+$",                      # embedded header block
                r"(?im)^\s*on .{5,120} wrote:\s*$",          # Gmail-style
                r"(?im)^\s*-{2,}\s*forwarded\s+message\s*-{2,}\s*$",
            ):
                m = re.search(pat, text)
                if m and m.start() < cut:
                    cut = m.start()
            own = text[:cut]
            return own if own.strip() else text
        except Exception:
            return str(body or "")

    @staticmethod
    def _strip_signature_block(own_text):
        """v4.1.87: cut the sender's SIGNATURE / contact block off a reply's own words.
        _own_reply_text removes the quoted history but keeps the signature, which on a
        real reply is ~460 characters (banner + name/title + address + phone + mailto /
        URL lines) -- enough on its own to blow the 400-char conservatism cap in
        _sent_reply_is_deferral, which is why that guard never fired in production.
        Cuts at the earliest recognised signature marker; if the cut would leave
        nothing (a reply that is only a signature) the text is returned unchanged so
        no caller ever receives an empty string it did not receive before."""
        try:
            text = str(own_text or "")
            if not text.strip():
                return text
            cut = len(text)
            for pat in (
                r"(?m)^\s*--\s*$",                                   # RFC-style delimiter
                r"(?i)<mailto:",                                     # Outlook plain-text sig
                r"(?im)^\s*\**\s*now\s+hiring\b",                    # marketing banner line
                r"(?im)^\s*https?://",                               # bare URL line
                r"(?im)^[^\n]{0,70}\b(?:managing\s+member|inside\s+sales|sales\s+manager|"
                r"president|owner|estimator|purchasing\s+agent)\b[^\n]{0,40}$",
                r"(?im)^\s*(?:o|t|p|f|c|tel|phone|cell|fax|direct|office)\s*[:.]\s*"
                r"(?:\+?1[-.\s]?)?\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}",
            ):
                m = re.search(pat, text)
                if m and m.start() < cut:
                    cut = m.start()
            head = text[:cut]
            return head if head.strip() else text
        except Exception:
            return str(own_text or "")

    @staticmethod
    def _sent_reply_is_deferral(own_text):
        """v4.1.78: True when the reply's own words only PROMISE an answer later --
        'will advise', 'I'll get back to you', 'checking on it', 'quote to follow'.
        A deferral is neither a thank-you ack nor a substantive quote: the ball is
        still in OUR court, so nothing downstream may treat the thread as answered.
        Conservative: only short replies qualify (a long reply that happens to
        contain 'will advise' about one line item is likely a real answer).
        v4.1.87: measure that length on SIGNATURE-STRIPPED words. The live S5
        reproduction read 510 chars of which 458 were the signature, so the cap below
        rejected a bare 'Will advise.' without ever testing it -- at all three call
        sites. Only this length basis changes; the patterns are untouched, and callers
        still run _reply_has_quote_content on the UNSTRIPPED text first, so a genuine
        quote can never be re-read as a deferral."""
        try:
            text = str(OutlookWorkflowMonitor._strip_signature_block(own_text)).strip().lower()
            if not text or len(text) > 400:
                return False
            for pat in (
                r"\bwill\s+advise\b", r"\bwe(?:'| wi)ll\s+advise\b", r"\bi(?:'| wi)ll\s+advise\b",
                r"\b(?:will|we'll|i'll)\s+get\s+back\s+to\s+you\b",
                r"\b(?:will|we'll|i'll)\s+follow\s+up\b",
                r"\b(?:will|we'll|i'll)\s+revert\b",
                r"\bget(?:ting)?\s+back\s+to\s+you\s+(?:soon|shortly|asap|tomorrow|monday|today)\b",
                r"\b(?:checking|working)\s+on\s+(?:it|this|that)\b",
                r"\blet\s+me\s+check\b", r"\bwill\s+check\b",
                r"\b(?:quote|pricing|p&a|price)\s+to\s+follow\b",
                r"\b(?:will|we'll|i'll)\s+(?:send|have)\s+(?:the\s+)?(?:quote|pricing|p&a|prices?|numbers)\b",
            ):
                if re.search(pat, text):
                    return True
            return False
        except Exception:
            return False

    def _reply_has_quote_content(self, subject, body):
        """v4.1.71: True when text reads like an actual quote / price / availability
        answer (so it is NOT a mere thank-you/ack even if it also closes with 'thanks').
        Conservative signals: a currency amount, qty/each pricing, or explicit
        stock/availability/lead-time/pricing language."""
        try:
            text = ((subject or "") + "\n" + (body or "")).lower()
            if re.search(r"\$\s*\d", text):
                return True
            if re.search(r"\b\d+(?:\.\d+)?\s*(?:/\s*)?(?:ea|each|pcs?|pieces?|per\s+(?:ea|foot|ft|piece|unit))\b", text):
                return True
            for kw in ("in stock", "in-stock", "in our stock", "have this all in stock",
                       "availability", "available", "lead time", "lead-time", "weeks out",
                       "days out", "your cost", "your price", "unit price", "list price",
                       "net price", "priced at", "the price is", "cost is", "pricing is",
                       "price and availability", "p&a is", "quoted at", "we can do them"):
                if kw in text:
                    return True
        except Exception:
            pass
        return False

    def is_sent_message_thank_you_only(self, sent_msg):
        """Skip placeholder creation for simple thank-you/acknowledgement replies.

        Uses the restored Phase 1 Smart Followup intent detector instead of the
        old 7-term/260-char check, so punctuated acknowledgements and common
        short closers do not create unnecessary sent/waiting trackers.

        v4.1.71: a reply that carries actual QUOTE content (a price, or stock/
        availability/lead-time language) is NOT a simple acknowledgement even if it
        also closes with 'thanks' -- e.g. 'Your cost is $100, we have this in stock.
        Thanks!'. The intent detector keyed on the trailing 'thanks' and tagged the
        whole reply as a closed ack, so the reply-driven archive (and the pending-reply
        tracker, which shares this helper) treated a real P&A reply as an empty
        thank-you. Quote content overrides the ack classification.
        """
        try:
            subject = ""
            body = ""
            recipient = ""
            try:
                subject = sent_msg.Subject or ""
            except Exception:
                subject = ""
            try:
                body = sent_msg.Body or ""
            except Exception:
                body = ""
            try:
                recipient = sent_msg.To or ""
            except Exception:
                recipient = ""
            # v4.1.78: test the reply author's OWN words only. The full .Body carries the
            # quoted chain underneath, so the OTHER side's P&A request text was making a
            # bare 'will advise' read as a substantive quote (reported: whole group
            # archived off a two-word deferral). Subject is deliberately excluded too --
            # an RFQ thread's subject legitimately names pricing language.
            _own = self._own_reply_text(body)
            if self._reply_has_quote_content("", _own):
                return False
            intent = analyze_reply_intent(subject=subject, body=body, sender_or_recipient=recipient, source="Sent Items", direction="outbound")
            return bool(intent.get("is_closed_ack"))
        except Exception:
            return False

    def get_sent_msg_time(self, sent_msg):
        try:
            if sent_msg.SentOn:
                return sent_msg.SentOn.replace(tzinfo=None)
        except Exception:
            pass
        return datetime.now()

    def find_existing_email_for_sent_message(self, sent_msg):
        """Find the MaINbox row/thread a sent Outlook message belongs to."""
        conversation_id = ""
        subject_key = ""
        try:
            conversation_id = sent_msg.ConversationID or ""
        except Exception:
            conversation_id = ""
        try:
            subject_key = self._normalized_thread_subject(sent_msg.Subject or "")
        except Exception:
            subject_key = ""
        # v4.1.13: a SUBJECT-ONLY match (no conversation-id agreement) must be distinctive.
        # A brand-new send titled just 'P&A' normalizes identically to every old 'RE: P&A'
        # in the box, so it silently claimed some unrelated thread: that row was flipped to
        # Waiting, no tracker was created, and no coverage could follow. Generic short
        # subjects (no digits, under 10 chars -- 'p&a', 'quote', 'rfq', 'wagos') now only
        # match through the conversation id, which genuine replies always carry.
        if subject_key and len(subject_key) < 10 and not any(c.isdigit() for c in subject_key):
            subject_key = ""
        best = None
        best_seen = -1
        for email in self.emails:
            if email.get("is_sent_waiting_placeholder"):
                continue
            same = False
            if conversation_id and email.get("conversation_id") == conversation_id:
                same = True
            elif subject_key and self._normalized_thread_subject(email.get("subject", "")) == subject_key:
                same = True
            if not same:
                continue
            seen = email.get("received_timestamp", 0) or email.get("sent_timestamp", 0) or 0
            try:
                seen = float(seen)
            except Exception:
                seen = 0
            if best is None or seen > best_seen:
                best = email
                best_seen = seen
        return best

    def sent_message_looks_like_business_tracker(self, sent_msg):
        """Allow brand-new sent RFQ/request emails to create a tracker row."""
        try:
            subject = ""
            body = ""
            try:
                subject = sent_msg.Subject or ""
            except Exception:
                subject = ""
            try:
                body = (sent_msg.Body or "")[:1200]
            except Exception:
                body = ""
            text = f"{subject}\n{body}".lower()
            markers = [
                "quote", "rfq", "request for quote", "price", "pricing",
                "availability", "lead time", "material", "can you quote",
                "please quote", "please provide", "send over", "vendor", "supplier",
                "estimate", "bid", "stock", "qty", "quantity"
            ]
            return any(m in text for m in markers)
        except Exception:
            return False

    def activate_existing_email_after_sent_message(self, email, sent_msg, target_status="Waiting on Vendor"):
        """If user replies from an existing/completed row, wake it up and show Waiting on Vendor."""
        if not email:
            return False
        try:
            # v4.1.16: the user sending a reply from Outlook on a completed/hidden
            # row is an explicit human decision to work the thread again. Record it
            # as such, or the closed guard re-completes the row at the next startup
            # and the wake-up (plus its Waiting tracker) silently disappears.
            _was_closed = self._email_was_closed_before_edit(email)
            changed = False
            if email.get("status") != target_status:
                email["status"] = target_status
                changed = True
            if email.get("urgency") == "Low" or not email.get("urgency"):
                email["urgency"] = "Normal"
                changed = True
            if email.get("category") in ("", "Junk / Ignore"):
                email["category"] = "Vendor / Supplier"
                changed = True
            email["is_new_import"] = False
            email["sent_waiting_tracker_active"] = True
            email["sent_waiting_tracker_updated_at"] = datetime.now().isoformat()
            try:
                email["sent_waiting_tracker_sent_timestamp"] = self.get_sent_msg_time(sent_msg).timestamp()
            except Exception:
                email["sent_waiting_tracker_sent_timestamp"] = datetime.now().timestamp()
            try:
                email["sent_waiting_tracker_sent_entry_id"] = sent_msg.EntryID or ""
            except Exception:
                pass
            try:
                email["sent_waiting_tracker_conversation_index"] = str(getattr(sent_msg, "ConversationIndex", "") or "")
            except Exception:
                pass
            try:
                pa = sent_msg.PropertyAccessor
                email["sent_waiting_tracker_internet_message_id"] = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
            except Exception:
                pass
            # If it was previously removed from MaINbox only, restore visibility.
            entry_id = email.get("entry_id", "")
            if entry_id:
                existing = self.status_data.get(entry_id, {})
                if existing.get("app_deleted"):
                    existing["app_deleted"] = False
                    existing.pop("deleted_from_app_at", None)
                    self.status_data[entry_id] = existing
                    changed = True
            if _was_closed and not self.workflow_record_is_closed(email):
                self._record_explicit_reopen_for_email(email, save=True)
            self.save_record(email)
            return changed
        except Exception:
            return False

    def scan_recent_sent_waiting_trackers(self, max_items=80, lookback_days=10):
        """Scan recent Sent Items so manual Outlook sends also create/update trackers.

        v2.10.8 behavior:
        - If user sends a reply in an existing MaINbox thread, even if it was Completed/Low,
          the existing row becomes Waiting on Vendor unless the sent message is only a thank-you.
        - If user sends a brand-new RFQ/request, a Sent / Waiting placeholder appears in the main list.
        """
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return 0
        changed_count = 0
        cutoff = datetime.now() - timedelta(days=lookback_days)
        _cov_debug(f"=== SENT SCAN start (coverage-debug build) max_items={max_items} lookback_days={lookback_days} cutoff={cutoff.isoformat()} ===")
        processed = set()
        self._begin_commitment_batch()  # v3.8.23: coalesce per-message commitment/cache writes
        try:
            processed = set(getattr(self, "sent_waiting_processed_sent_ids", []) or [])
        except Exception:
            processed = set()
        # v4.1.56: a message sent FROM the shared Sales mailbox is saved into THAT
        # store's Sent Items, which this scan never read (only GetDefaultFolder(5)) --
        # so the send was never seen: no tracker, and therefore no auto quote
        # coverage. Walk BOTH sent folders; per-folder fast-skip state and fault
        # isolation (a broken Sales store can never break the user's own scan).
        _sent_folders = []
        try:
            _own_sent = namespace.GetDefaultFolder(5)  # olFolderSentMail
            if _own_sent is not None:
                _sent_folders.append(("My Sent", _own_sent))
        except Exception:
            pass
        try:
            _sales_sent = self._find_sales_sent_folder_in(namespace)
            if _sales_sent is not None:
                _dup = False
                try:
                    _sid_new = str(getattr(_sales_sent, "EntryID", "") or "")
                    _dup = any(_sid_new and _sid_new == str(getattr(_f, "EntryID", "") or "")
                               for _lbl, _f in _sent_folders)
                except Exception:
                    _dup = False
                if not _dup:
                    _sent_folders.append(("Sales Sent", _sales_sent))
        except Exception:
            pass
        _fold_state = getattr(self, "_sent_tracker_folder_state", None)
        if not isinstance(_fold_state, dict):
            _fold_state = {}
            self._sent_tracker_folder_state = _fold_state
        for _sf_label, sent_folder in _sent_folders:
          # v4.1.57: the shared Sales mailbox's SENT ITEMS holds EVERY salesperson's
          # outgoing mail. Same ownership rule as the inbound scans (v4.1.54): only
          # the user's own Sent folder is unconditionally theirs; messages from any
          # other sent folder must carry the selected sales category tag before ANY
          # tracker / coverage / commitment work. Without this, v4.1.56's Sales Sent
          # walk ingested colleagues' sends (e.g. TR while running as SB).
          _sales_cat_gate = (_sf_label != "My Sent")
          try:
              items = sent_folder.Items
              items.Sort("[SentOn]", True)
              # v4.1.59 (full audit, finding #1): for a GATED folder (Sales Sent), ask
              # OUTLOOK to filter by the selected sales category first -- the same
              # server-side Keywords Restrict the main import uses. Without it, the
              # v4.1.57 per-message gate skipped colleagues' sends CORRECTLY but still
              # NAVIGATED them (SentOn + EntryID + Categories COM reads per message,
              # uncounted by any budget) all the way to the date cutoff -- on a busy
              # shared mailbox that is thousands of COM reads per tick, recurring
              # background load felt as the whole computer bogging down. The restrict
              # also makes the fast-skip meaningful again: count/newest are computed on
              # the FILTERED view, so a colleague sending mail no longer invalidates
              # the skip every pass. The per-message gate below stays as belt-and-
              # braces for the fallback path and against Restrict oddities.
              _cat_restricted = False
              if _sales_cat_gate:
                  try:
                      _cat = str(getattr(self, "selected_sales_category", "") or "")
                      if _cat.strip():
                          _cat_sql = _cat.replace("'", "''")
                          _restricted = items.Restrict(
                              f"@SQL=\"urn:schemas-microsoft-com:office:office#Keywords\" LIKE '%{_cat_sql}%'")
                          _restricted.Sort("[SentOn]", True)
                          items = _restricted
                          _cat_restricted = True
                  except Exception:
                      _cat_restricted = False
              # v3.9.93: this scan re-walks and re-reads ~50 recent Sent-item bodies via Outlook
              # COM every periodic tick. The tick runs on the Tk MAIN thread, so when Outlook is
              # slow to fetch those bodies the whole UI freezes for 20-30s -- and it was doing this
              # every cycle EVEN WHEN nothing had been sent since the previous pass. Skip the heavy
              # per-item walk when the Sent folder is unchanged (same item count AND same newest
              # EntryID) since the last pass: with no new sent item there is no new tracker to
              # create, and an incoming reply still clears its tracker when it is imported. Any new
              # (or removed) sent item changes the count or the newest id and runs the full scan,
              # which re-runs the reconcile sweep too. Cheap: Count + one EntryID read, no bodies.
              try:
                  _cur_count = int(getattr(items, "Count", 0) or 0)
              except Exception:
                  _cur_count = -1
              _cur_newest_id = ""
              try:
                  _first_item = items.GetFirst()
                  if _first_item is not None:
                      _cur_newest_id = str(getattr(_first_item, "EntryID", "") or "")
              except Exception:
                  _cur_newest_id = ""
              # v4.1.56: fast-skip state is PER FOLDER now (My Sent / Sales Sent each
              # remember their own count + newest id), and an unchanged folder skips
              # to the NEXT folder instead of returning -- returning here would have
              # made an unchanged My Sent hide a brand-new Sales-mailbox send.
              _prev_count, _prev_newest_id = _fold_state.get(_sf_label, (None, None))
              if (_cur_newest_id and _prev_newest_id is not None
                      and _cur_newest_id == _prev_newest_id and _cur_count == _prev_count):
                  _cov_debug(f"  SENT FOLDER {_sf_label!r} unchanged (count={_cur_count}, newest EntryID stable) -> skip heavy walk this pass")
                  ops_log("scan", "sent_pass", folder=_sf_label, skipped="unchanged", count=_cur_count)
                  continue
              # New/removed sent item since last pass -- remember this state and do the full scan.
              _fold_state[_sf_label] = (_cur_count, _cur_newest_id)
              try:
                  _fp = ""
                  try:
                      _fp = sent_folder.FolderPath
                  except Exception:
                      _fp = getattr(sent_folder, "Name", "?")
                  _cov_debug(f"  SENT FOLDER scanned: {_fp!r}  total_items={items.Count}")
                  # v4.1.59 (audit finding #3): this newest-8 preview did its COM reads
                  # (Subject + SentOn per item) even with debugging OFF, because the
                  # f-strings evaluate before _cov_debug's no-op return. Gate the loop.
                  if COVERAGE_DEBUG:
                      _n = 0
                      for _it in items:
                          try:
                              _cov_debug(f"    newest[{_n}]: subj={getattr(_it, 'Subject', '')!r} sent={self.get_sent_msg_time(_it).isoformat()}")
                          except Exception:
                              pass
                          _n += 1
                          if _n >= 8:
                              break
              except Exception as _e:
                  _cov_debug(f"  SENT FOLDER diag exception: {_e!r}")
              checked = 0
              # v4.1.59 (audit finding #2): bound RAW navigation like both inbound
              # coverage scans do. When the category Restrict is unavailable, gated
              # skips are uncounted by 'checked', so without this cap the walk was
              # unbounded up to the date cutoff on a busy shared folder.
              _raw_nav = 0
              _raw_nav_cap = 4000
              # v4.1.23 (external audit round 5, finding #16): advance-first GetFirst/GetNext
              # iteration -- this scan routes priced sent messages into Quote Coverage and
              # breaks on an old date, so it must not depend on Python enumeration honoring
              # Items.Sort(). Same pattern as both coverage scans.
              try:
                  _nav_msg = items.GetFirst()
              except Exception:
                  _nav_msg = None
              while _nav_msg is not None:
                  msg = _nav_msg
                  try:
                      _nav_msg = items.GetNext()
                  except Exception:
                      _nav_msg = None
                  _raw_nav += 1
                  if _raw_nav > _raw_nav_cap:
                      break
                  if checked >= max_items:
                      break
                  try:
                      sent_on = self.get_sent_msg_time(msg)
                      if sent_on < cutoff:
                          break
                      sent_entry_id = ""
                      try:
                          sent_entry_id = msg.EntryID or ""
                      except Exception:
                          sent_entry_id = ""
                      # v4.1.57: Sales-Sent messages must be tagged with the selected
                      # sales category before ANY work (subject/body read, intent,
                      # tracker, coverage, commitments). Checked BEFORE the max_items
                      # budget so a busy shared Sales Sent full of colleagues' sends
                      # cannot starve the walk before reaching THIS user's tagged send
                      # (that would drop the user's own tracker -- the bug just fixed).
                      # One cheap COM property read, before the heavy Body fetch, and
                      # deliberately NOT added to 'processed': tags are mutable, so a
                      # send tagged for this user later is picked up on the next pass.
                      if _sales_cat_gate:
                          try:
                              _msg_cats = msg.Categories or ""
                          except Exception:
                              _msg_cats = ""
                          if not self.email_has_outlook_category(_msg_cats, self.selected_sales_category):
                              continue
                      checked += 1
                      # Re-process existing conversations if needed. v3.8.12: do NOT skip the
                      # whole Sent item just because sent-waiting tracking already handled it;
                      # the ETA/lead-time commitment scanner has its own processed list.
                      already_tracker_processed = bool(sent_entry_id and sent_entry_id in processed)
                      try:
                          msg_subject = getattr(msg, "Subject", "") or ""
                      except Exception:
                          msg_subject = ""
                      try:
                          msg_body = getattr(msg, "Body", "") or ""
                      except Exception:
                          msg_body = ""
                      try:
                          msg_to = getattr(msg, "To", "") or ""
                      except Exception:
                          msg_to = ""
                      reply_intent = analyze_reply_intent(subject=msg_subject, body=msg_body, sender_or_recipient=msg_to, source="Sent Items", direction="outbound")
                      # v4.1.83 (audit: one real RFQ send classified closed-ack and skipped
                      # forever): a send whose OWN words explicitly ASK for pricing is a
                      # request, never a pure thank-you -- clear the ack flag so it gets a
                      # tracker. Checked on the own text only, so a quoted chain cannot fake it.
                      if reply_intent.get("is_closed_ack"):
                          try:
                              _own_scan = self._own_reply_text(msg_body).lower()
                              if re.search(r"please\s+provide|price\s+and\s+avail|pls\s+quote|please\s+quote|bid\s+pricing|can\s+you\s+quote", _own_scan):
                                  reply_intent = dict(reply_intent)
                                  reply_intent["is_closed_ack"] = False
                          except Exception:
                              pass
                      _msg_priced = bool(re.search(r"\$\s*\d|\b\d+\.\d{2}\b", msg_body or ""))
                      if _msg_priced:
                          _cov_debug(f"SENT-PRICED subj={msg_subject!r} sent_on={sent_on.isoformat()} closed_ack={bool(reply_intent.get('is_closed_ack'))} already_processed={already_tracker_processed}")
                      if reply_intent.get("is_closed_ack"):
                          # A pure thank-you makes no tracker -- but a thank-you that carries
                          # line-item pricing is still a quote, so let the coverage hook record it
                          # before we skip the tracker logic for this message. (v3.9.4)
                          if _msg_priced:
                              _cov_debug("  closed-ack BUT priced -> routing to quote coverage hook")
                              try:
                                  _cid = ""
                                  try:
                                      _cid = msg.ConversationID or ""
                                  except Exception:
                                      _cid = ""
                                  self.update_coverage_quoted_from_sent(
                                      conversation_id=_cid, subject=msg_subject, body=msg_body,
                                      sent_entry_id=sent_entry_id, sent_on=sent_on.isoformat(),
                                      source_message_id=outlook_msg_internet_id(msg))
                              except Exception:
                                  pass
                          if sent_entry_id:
                              processed.add(sent_entry_id)
                          # v3.9.70: a pure thank-you/ack closes the loop. Before skipping
                          # tracker creation, close the matching INBOUND thread so it does
                          # not linger as Needs Reply / Waiting after we have acked. Only an
                          # open, non-user-locked row is touched. If that thread is a won/
                          # closed deal in a group, surface the archive Cleanup too (deduped).
                          # v4.1.91: ...unless our reply was a QUESTION BACK. The ack test above
                          # runs on the FULL sent body, so the customer's own quoted "Thanks" can
                          # tip a clarifying question into closed_ack -- reproduced live: "What job
                          # is this for? ... Thanks" took an RFQ New -> Completed in one step. Test
                          # OUR OWN signature-stripped words; a question means the ball is with THEM
                          # and the request is emphatically not finished.
                          _q_back = False
                          try:
                              _own_ack = self._strip_signature_block(self._own_reply_text(msg_body))
                              if (self._sent_reply_is_question_back(_own_ack)
                                      and not self._reply_has_quote_content("", _own_ack)):
                                  _q_back = True
                                  ops_log("tracker", "ack_skipped_question_back",
                                          subj=str(msg_subject or "")[:60],
                                          own=str(_own_ack or "").strip()[:80])
                          except Exception:
                              _q_back = False
                          try:
                              _ex = None if _q_back else self.find_existing_email_for_sent_message(msg)
                              if (_ex and not _ex.get("ai_user_locked")
                                      and _ex.get("status") in ("Needs Reply", "Waiting on Customer", "Waiting on Vendor", "New", "")):
                                  _ex["status"] = "Completed"
                                  _ex["ai_triaged_at"] = datetime.now().isoformat()
                                  _ex["ai_triage_pending"] = False
                                  self.save_record(_ex)
                                  try:
                                      if self.get_group_id_for_email(_ex.get("entry_id", "")):
                                          self.load_body_for_rfq(_ex)
                                          _cl, _ph, _kd = self._email_request_is_closed(_ex)
                                          if _cl:
                                              self._assistant_propose_cleanup(_ex, _ph, _kd)
                                  except Exception:
                                      pass
                          except Exception:
                              pass
                          continue

                      existing_email = self.find_existing_email_for_sent_message(msg)
                      created_or_updated = False
                      placeholder = None
                      if already_tracker_processed:
                          # Tracker was already handled by an older refresh; leave statuses alone
                          # but still allow the commitment scanner below to run once.
                          pass
                      elif existing_email:
                          # Use the existing row's direction/category instead of forcing every
                          # sent tracker to Waiting on Vendor. Smart Followup may override when
                          # the sent text explicitly says we are waiting on a vendor/customer.
                          target_status = reply_intent.get("status") if reply_intent.get("is_waiting") else ""
                          if target_status not in ["Waiting on Vendor", "Waiting on Customer"]:
                              target_status = self.infer_status_after_reply_sent(existing_email)
                          if self.activate_existing_email_after_sent_message(existing_email, msg, target_status):
                              created_or_updated = True
                          # Smart Followup learning must reinforce whenever the sent reply
                          # clearly indicates we are waiting on a vendor/customer, even if the
                          # row was already in the correct status (in that case activate_*
                          # returns False, and the old code skipped learning here). The
                          # processed-sent-ID set above guarantees each sent message only
                          # teaches once, so this cannot inflate confidence on repeated scans.
                          if reply_intent.get("is_waiting") and target_status in ("Waiting on Vendor", "Waiting on Customer"):
                              behavior = "wait_for_vendor" if target_status == "Waiting on Vendor" else "wait_for_customer"
                              minutes = VENDOR_NO_RESPONSE_MINUTES if target_status == "Waiting on Vendor" else CUSTOMER_PO_FOLLOWUP_MINUTES
                              self.learn_followup_behavior(existing_email, behavior, minutes, "Smart Followup: sent reply intent is waiting.")
                          # v4.1.13: an RFQ sent by REPLYING inside an existing thread (the most
                          # common real flow -- the customer's request row gets activated as the
                          # tracker, and NO placeholder is made) must also get auto quote coverage.
                          # Same hook, with the activated row standing in as the tracker; all the
                          # usual guards apply inside (Waiting-on-Vendor only, unpriced, no
                          # existing ledger for the group, items must parse).
                          if target_status == "Waiting on Vendor":
                              try:
                                  _tv_cid = ""
                                  try:
                                      _tv_cid = str(msg.ConversationID or "")
                                  except Exception:
                                      _tv_cid = ""
                                  _tv = {
                                      "entry_id": existing_email.get("entry_id", ""),
                                      "status": "Waiting on Vendor",
                                      "subject": msg_subject or existing_email.get("subject", ""),
                                      "conversation_id": _tv_cid or str(existing_email.get("conversation_id", "") or ""),
                                      "sent_entry_id": sent_entry_id,
                                      "received_timestamp": sent_on.timestamp(),
                                  }
                                  self._auto_create_coverage_for_sent_rfq(
                                      _tv, sent_body=msg_body, sent_subject=msg_subject, sent_msg=msg)
                              except Exception:
                                  pass
                          # v3.9.27 duplicate fix: the activated real row IS the tracker now
                          # (status=Waiting + sent_waiting_tracker_* fields). The old code ALSO
                          # created a separate "Sent / Waiting" placeholder here, so every sent
                          # reply in an existing thread showed TWO waiting rows for the same
                          # thing in the main pane. One tracker per thread: real row wins. Any
                          # older saved placeholder for this conversation is retired below in
                          # sync_sent_waiting_placeholders_into_email_list().
                          placeholder = None
                      elif not already_tracker_processed:
                          # Brand-new outgoing RFQ/request that did not start from an imported row.
                          if self.sent_message_looks_like_business_tracker(msg) or reply_intent.get("needs_tracker"):
                              target_status = reply_intent.get("status") if reply_intent.get("status") in ["Waiting on Vendor", "Waiting on Customer"] else "Waiting on Vendor"
                              pending = {
                                  "category": reply_intent.get("category") or "Vendor / Supplier",
                                  "urgency": "Normal",
                                  "subject": msg_subject,
                                  "sent_entry_id": sent_entry_id,
                                  "sent_on": sent_on.isoformat(),
                                  "reply_intent": reply_intent.get("intent", ""),
                              }
                              placeholder = self.make_sent_waiting_placeholder(msg, pending, target_status)
                              if self.add_or_update_sent_waiting_placeholder(placeholder):
                                  created_or_updated = True
                                  # v4.1.11: the tracker is created and (inside add_or_update)
                                  # grouped with its originating request. If that group has no
                                  # coverage ledger yet, create it from the sent RFQ's own item
                                  # list -- full dupe-guards inside; no-op when one exists.
                                  try:
                                      self._auto_create_coverage_for_sent_rfq(
                                          placeholder, sent_body=msg_body, sent_subject=msg_subject, sent_msg=msg)
                                  except Exception:
                                      pass

                      if created_or_updated:
                          changed_count += 1
                      # v3.8.10: scan the sent message for dated commitments (ship/ETA,
                      # quote expiration, backorder, callbacks, payment due, etc.).
                      try:
                          commit_target = existing_email or (placeholder if isinstance(placeholder, dict) else None)
                          if commit_target:
                              scheduled_commitments = self.scan_outlook_message_for_commitments(msg, commit_target, direction="Sent")
                              if scheduled_commitments:
                                  changed_count += scheduled_commitments
                      except Exception:
                          pass
                      # v3.9.1: parse this sent reply for quoted line items and mark them
                      # covered on the matching coverage thread. Self-guards: no-op unless the
                      # thread already has requested items, and dedupes per sent EntryID.
                      try:
                          msg_conv_id = ""
                          try:
                              msg_conv_id = msg.ConversationID or ""
                          except Exception:
                              msg_conv_id = ""
                          # v3.9.54: only run the quote-matcher on a sent message that actually
                          # carries pricing. Without this gate an outgoing RFQ (a request with no
                          # prices) was parsed as a "quote" -- and because no line carries a price,
                          # the no-priced-lines fallback inside update_coverage_quoted_from_sent
                          # kept every parsed line -- wrongly marking the customer's OWN requested
                          # items as Quoted. The other two callers of this hook already gate on price.
                          if re.search(r"\$\s*\d|\b\d+\.\d{2}\b", msg_body or ""):
                              self.update_coverage_quoted_from_sent(
                                  conversation_id=msg_conv_id,
                                  subject=msg_subject,
                                  body=msg_body,
                                  sent_entry_id=sent_entry_id,
                                  sent_on=sent_on.isoformat(),
                                  source_message_id=outlook_msg_internet_id(msg),
                              )
                          # v3.9.4: if this sent item is an OUTGOING request (RFQ you sent out),
                          # move the matching customer's requested items to "Waiting".
                          self.update_coverage_waiting_from_request(
                              subject=msg_subject,
                              body=msg_body,
                              sent_entry_id=sent_entry_id,
                              sent_on=sent_on.isoformat(),
                          )
                      except Exception:
                          pass
                      if sent_entry_id:
                          processed.add(sent_entry_id)
                  except Exception:
                      continue
              ops_log("scan", "sent_pass", folder=_sf_label, restricted=bool(_cat_restricted),
                      raw_nav=_raw_nav, checked=checked, new_trackers=changed_count)
          except Exception as _sf_err:
            # v4.1.62: a swallowed per-folder failure previously left the ops log
            # with NO sent_pass records at all -- log the error so a dead folder
            # walk is visible in production instead of silent.
            ops_log("scan", "sent_pass", folder=_sf_label, error=repr(_sf_err))
            continue

        try:
            self.sent_waiting_processed_sent_ids = list(processed)[-1000:]
        except Exception:
            pass
        # v4.1.12 one-time BACKFILL: every RFQ sent before this feature existed is in
        # sent_waiting_processed_sent_ids, so the per-message loop above will never revisit
        # it -- which is why nothing was auto-created for jobs already in flight. Walk the
        # ACTIVE Waiting-on-Vendor trackers from the last 21 days instead, fetch each sent
        # body by EntryID, and run the same auto-coverage flow (all its guards apply: a job
        # that already has a ledger is untouched, priced sends skip, no items -> no ledger).
        try:
            # v4.1.82: marker bumped to v4 -- the extractor now reads the two-line,
            # plural and footage-lead item families and the image-OCR floor is fixed,
            # so the SAME bounded walk re-attempts the active trackers whose earlier
            # auto-create failed with zero items (20 of 90 audited threads). All the
            # usual guards still apply: existing ledgers untouched, priced sends skip.
            if (bool(self.settings.get("auto_coverage_from_sent_rfq", True))
                    and isinstance(getattr(self, "quote_coverage", None), dict)
                    and self.quote_coverage.get("auto_coverage_backfill_v4") != 1):
                _bf_cut = datetime.now() - timedelta(days=21)
                _bf_done = 0
                # v4.1.13: candidates are BOTH kinds of tracker -- standalone Sent/Waiting
                # placeholders AND real rows activated as trackers by a reply-in-thread RFQ
                # (v4.1.12 only walked placeholders, missing the most common real flow).
                _bf_cands = []
                for _ph in list(getattr(self, "sent_waiting_placeholders", []) or []):
                    if (isinstance(_ph, dict) and not _ph.get("cleared")
                            and str(_ph.get("status", "") or "") == "Waiting on Vendor"
                            and _ph.get("sent_entry_id")):
                        try:
                            _ts = float(_ph.get("received_timestamp", 0) or 0)
                        except Exception:
                            continue
                        _bf_cands.append((_ph.get("entry_id", ""), str(_ph.get("status", "")),
                                          str(_ph.get("subject", "") or ""),
                                          str(_ph.get("conversation_id", "") or ""),
                                          str(_ph.get("sent_entry_id", "")), _ts))
                for _em in list(getattr(self, "emails", []) or []):
                    if (isinstance(_em, dict) and _em.get("sent_waiting_tracker_active")
                            and not _em.get("is_sent_waiting_placeholder")
                            and str(_em.get("status", "") or "") == "Waiting on Vendor"
                            and _em.get("sent_waiting_tracker_sent_entry_id")):
                        try:
                            _ts = float(_em.get("sent_waiting_tracker_sent_timestamp", 0) or 0)
                        except Exception:
                            continue
                        _bf_cands.append((_em.get("entry_id", ""), "Waiting on Vendor",
                                          str(_em.get("subject", "") or ""),
                                          str(_em.get("conversation_id", "") or ""),
                                          str(_em.get("sent_waiting_tracker_sent_entry_id", "")), _ts))
                for _eid, _st, _subj, _cid, _sid, _ts in _bf_cands:
                    if _bf_done >= 40:
                        break
                    try:
                        if datetime.fromtimestamp(_ts) < _bf_cut:
                            continue
                    except Exception:
                        continue
                    _bmsg = None
                    try:
                        _bmsg = namespace.GetItemFromID(_sid)
                    except Exception:
                        _bmsg = None
                    if _bmsg is None:
                        continue
                    try:
                        _bbody = str(getattr(_bmsg, "Body", "") or "")
                        _bsubj = str(getattr(_bmsg, "Subject", "") or "") or _subj
                    except Exception:
                        continue
                    _bf_done += 1
                    try:
                        self._auto_create_coverage_for_sent_rfq(
                            {"entry_id": _eid, "status": _st, "subject": _bsubj,
                             "conversation_id": _cid, "sent_entry_id": _sid,
                             "received_timestamp": _ts},
                            sent_body=_bbody, sent_subject=_bsubj, sent_msg=_bmsg)
                    except Exception:
                        pass
                self.quote_coverage["auto_coverage_backfill_v4"] = 1
                self.save_quote_coverage()
                _cov_debug(f"AUTO-COVERAGE v3 backfill: examined {_bf_done} tracker(s) (placeholders + activated rows)")
        except Exception:
            pass
        # v3.8.23: close the batch. A scan that detected commitments (or marked a
        # message processed) set _commitment_batch_cache_dirty; combined with the
        # changed_count save below this resolves to a single save_cached_state().
        batch_touched_cache = bool(getattr(self, "_commitment_batch_cache_dirty", False))
        if changed_count:
            self.sync_sent_waiting_placeholders_into_email_list()
            self.flush_status_data()
            self.save_sent_waiting_placeholders()
            self._commitment_batch_cache_dirty = True  # fold the tracker's own cache save into the flush
        self._flush_commitment_batch()
        if not changed_count and batch_touched_cache:
            # commitments were created but no tracker change; flush already wrote cache.
            pass
        # v3.8.38: Sent Items are scanned AFTER the inbox, so a reply imported earlier in the
        # same cycle can miss its just-created tracker (the per-message clear only fires while
        # the reply is being imported, after which it ages out of the incremental scan window).
        # Reconcile every loaded reply against the trackers so a received response always
        # clears its tracker, regardless of scan ordering.
        cleared_count = self.reconcile_sent_waiting_placeholders_against_replies()
        return changed_count + cleared_count

    def coverage_inbox_folders_for_quote_scan(self, namespace=None):
        """Return all inbound folders that can receive vendor quotes.

        The first v3.9.4 scanner only looked at the default Inbox. In real use, vendor
        quote replies may land in the shared Sales mailbox, so coverage stayed at Waiting
        even though the reply was imported elsewhere in MaINbox. Keep this folder list
        narrow (My Inbox + Sales Inbox) and dedupe by EntryID/FolderPath to avoid double scans.
        """
        folders = []
        seen = set()

        def add_folder(folder, label):
            if not folder:
                return
            try:
                key = str(getattr(folder, "EntryID", "") or "")
            except Exception:
                key = ""
            if not key:
                try:
                    key = str(getattr(folder, "FolderPath", "") or getattr(folder, "Name", "") or label)
                except Exception:
                    key = label
            if key in seen:
                return
            seen.add(key)
            folders.append((label, folder))

        try:
            if namespace:
                add_folder(namespace.GetDefaultFolder(6), "My Inbox")  # olFolderInbox
        except Exception:
            pass
        try:
            # v3.9.85: was self.find_sales_inbox_folder_safe(), which reads self.namespace --
            # a COM object bound to the Tk MAIN-thread apartment. This method runs on the
            # background quote-scan worker (scan_recent_inbox_for_quotes -> here), so touching
            # the main-thread namespace raised RPC_E_WRONG_THREAD (0x8001010e) and intermittently
            # took the whole process down ("MaINbox just closed by itself"). fresh_outlook()
            # already handed us a thread-local `namespace`; resolve Sales through the worker-safe
            # variant, which never touches self.namespace. (My Inbox above already uses the passed
            # namespace correctly; both callers of this method pass a fresh_outlook() namespace.)
            if namespace:
                add_folder(self._find_sales_inbox_folder_in(namespace), "Sales Inbox")
        except Exception:
            pass
        return folders

    def _attachment_quote_text_from_msg(self, msg, max_atts=10):
        """Extract text from a live Outlook message's DOCUMENT attachments (PDF, Excel,
        CSV, Word, text) so a vendor quote sent as a PDF can be read for Quote Coverage.
        Returns concatenated text, or '' when there are no document attachments or on any
        failure. Reuses the same temp-save + best-effort text/OCR path the RFQ scanner
        uses, and always cleans up its temp folder. A cheap extension pass runs first so
        no temp folder is created unless a real document is actually attached.

        v3.9.91: a delivered message's attachments never change, so the coverage scan reads
        each message's PDFs/Excels ONCE per run instead of re-saving and re-parsing them on
        every 90s/180s pass -- that repeated parse churn was the avoidable load in the coverage
        logs. Only SUCCESSFUL (non-empty) extractions are cached, keyed by EntryID (stable within
        a session); an empty/failed parse is never cached, so it is retried and a transient blip
        can't permanently drop a vendor quote. The cache is bounded and clears on restart.
        """
        # v4.1.27 (external audit round 9, blocker #4): per-attachment INTEGRITY tracking,
        # same model the customer-request scan has had since v4.1.20. Any eligible
        # document that fails to save, raises during parse, yields no text, or sits
        # beyond the attachment cap sets _vendor_attach_last_failed -- callers must then
        # treat the extraction as INCOMPLETE: rows parsed from the surviving siblings may
        # be stored, but the message is not marked processed and an empty parse is never
        # treated as authoritative.
        self._vendor_attach_last_failed = False
        self._vendor_attach_failed_names = []   # v4.1.28: which files could not be read
        cache = getattr(self, "_attachment_text_cache", None)
        if cache is None:
            cache = self._attachment_text_cache = {}
        _ck = ""
        try:
            _ck = str(getattr(msg, "EntryID", "") or "")
        except Exception:
            _ck = ""
        if _ck and _ck in cache:
            return cache[_ck]   # cached results are COMPLETE extractions only (see below)
        try:
            atts = msg.Attachments
            count = int(getattr(atts, "Count", 0) or 0)
        except Exception:
            self._vendor_attach_last_failed = True   # attachments unreadable != no attachments
            return ""
        if count <= 0:
            return ""
        doc_exts = (".pdf", ".xlsx", ".xls", ".csv", ".doc", ".docx", ".txt", ".rtf")
        candidates = []
        for i in range(1, count + 1):
            try:
                att = atts.Item(i)
                fname = safe_filename_piece(getattr(att, "FileName", "") or f"attachment_{i}", f"attachment_{i}")
                if os.path.splitext(fname)[1].lower() not in doc_exts:
                    continue
                if outlook_attachment_is_inline(att):
                    continue
                if len(candidates) >= max_atts:
                    # v4.1.27: an eligible document BEYOND the cap was never read --
                    # that is an incomplete extraction, not a clean skip.
                    self._vendor_attach_last_failed = True
                    self._vendor_attach_failed_names.append(fname + " (beyond attachment cap)")
                    break
                candidates.append((att, fname))
            except Exception:
                self._vendor_attach_last_failed = True
                continue
        if not candidates:
            return ""
        text_parts = []
        temp_root = ""
        try:
            temp_root = tempfile.mkdtemp(prefix="mainbox_cov_")
            for att, fname in candidates:
                try:
                    path = os.path.join(temp_root, fname)
                    att.SaveAsFile(path)
                    if not os.path.exists(path):
                        self._vendor_attach_last_failed = True   # save silently produced nothing
                        self._vendor_attach_failed_names.append(fname + " (save produced no file)")
                        continue
                    t = read_text_from_file_best_effort(path)
                    if t and t.strip():
                        # v4.1.30 (external audit round 12, finding #1): NONEMPTY output
                        # that is extractor FAILURE PROSE ("No text could be extracted
                        # from this page", parse-error banners, '####' noise) is an
                        # INDETERMINATE read, not a successful one. The v4.1.29 rule
                        # already kept stored rows safe, but because the helper reported
                        # 'complete', the retry ledger never advanced and the message
                        # rescanned forever without ever reaching Attachment Review.
                        # Marker-based only (no density heuristics here: a legitimate
                        # price table is number-heavy and must not be misflagged).
                        if _COVERAGE_PARSE_FAILURE_MARKERS.search(t[:3000]):
                            self._vendor_attach_last_failed = True
                            self._vendor_attach_failed_names.append(fname + " (extractor returned failure text)")
                        else:
                            text_parts.append("\n--- Attachment: %s ---\n%s" % (fname, t[:18000]))
                    else:
                        # v4.1.27: an eligible document that yields NO text is indeterminate
                        # (image-only PDF whose OCR failed, protected file, unsupported
                        # layout) -- never proof it holds no quote.
                        self._vendor_attach_last_failed = True
                        self._vendor_attach_failed_names.append(fname + " (no text extracted)")
                except Exception:
                    self._vendor_attach_last_failed = True
                    self._vendor_attach_failed_names.append(fname + " (save/parse exception)")
                    continue
        except Exception:
            self._vendor_attach_last_failed = True
            return ""
        finally:
            try:
                if temp_root and os.path.isdir(temp_root):
                    shutil.rmtree(temp_root, ignore_errors=True)
            except Exception:
                pass
        _res = "\n".join(text_parts)
        # v4.1.30 (round 12): STRUCTURED OUTCOME for callers -- the shape the auditor
        # has asked for across three rounds, populated from the per-file tracking above.
        self._vendor_attach_last_result = {
            "complete": not self._vendor_attach_last_failed,
            "files_failed": list(self._vendor_attach_failed_names),
            "chars": len(_res),
            "files_read": len(text_parts),
        }
        if _ck and _res and not self._vendor_attach_last_failed:
            # Cache COMPLETE successful extractions only -- caching a partial result would
            # make every retry return the partial set without re-attempting the failed file.
            try:
                if len(cache) >= 800:
                    cache.clear()
                cache[_ck] = _res
            except Exception:
                pass
        return _res

    @staticmethod
    def _trim_ocr_text_to_material_table(text):
        """v4.1.83: purchase-form screenshots carry a letterhead block (company name,
        DATE/JOB#/DELIVER TO fields) above the actual material table. When the OCR text
        contains a QUANTITY/DESCRIPTION-style table header, everything above it is form
        chrome -- return only the text from the header down (verified against the real
        Verde 'DAILY MATERIAL' form OCR, where the v4.1.82 parse turned 'VERDE ELECTRIC
        DAILY MATE' and 'DELIVER TO: 31-03 20th ave' into ledger items). No header ->
        text returned unchanged."""
        try:
            t = str(text or "")
            m = re.search(r"(?im)^.*\bquantity\b.{0,40}\bdescription\b.*$", t)
            if m:
                return t[m.end():]
            m = re.search(r"(?im)^\s*.?\s*material\s+information\s*.?\s*$", t)
            if m:
                return t[m.end():]
            return t
        except Exception:
            return str(text or "")

    @staticmethod
    def _filter_ocr_letterhead_items(items):
        """v4.1.83: drop OCR-derived 'items' that are really letterhead/form chrome or
        signature-banner text. Applied to IMAGE-sourced parses only -- structured
        documents (Excel/PDF tables) keep their own machinery. Rules, each grounded in
        real junk rows from production ('AMERICAN POWER', 'ELECTRICAL SUPPLY CO.',
        'MBE SBE ! LBE', 'DELIVER TO: ...', 'VERDE ELECTRIC DAILY MATE'):
          - form-field labels and cert strings by stoplist;
          - signature-banner phrases (now hiring / inside sales / inquiries);
          - qty-less ALL-CAPS rows with no digits anywhere (company letterhead reads
            as capitals; a real item without a qty still carries a size or part code).
        A row with a quantity is never dropped by the caps rule -- OCR'd real items
        keep their numbers."""
        _stop = re.compile(
            r"purchase\s+information|material\s+information|deliver\s+to\b|date\s+required"
            r"|stage\s+in\s+shop|daily\s+mat|job\s*#\s*:|\bdate\s*:"
            r"|now\s+hiring|inside\s+sales|inquiries\s*&?\s*referrals"
            r"|^\W*(?:mbe|sbe|lbe|dbe|wbe)\b(?:\W+(?:mbe|sbe|lbe|dbe|wbe)\b)*\W*$",
            re.I)
        # v4.1.85: OCR-TOLERANT second pass. The v4.1.83 patterns assume clean text, but
        # these rows arrive from Tesseract: live testing produced 'DELIVERTO: 12 Hardscrabble'
        # (space lost) and 'oB#9931' (from 'JOB #: 9931' -- J misread, colon dropped), both of
        # which defeated the whitespace-and-colon-dependent patterns above and reached a real
        # ledger. Matching a DE-SPACED copy of the row removes the whole class of
        # lost/merged-space failures in one step.
        _stop_despaced = re.compile(
            r"purchaseinformation|materialinformation|deliverto|daterequired|stageinshop"
            r"|dailymat|nowhiring|insidesales|inquiries", re.I)
        # Local copy of the material vocabulary -- this is a @staticmethod, so it cannot
        # reach the module-level extractor's compiled pattern.
        _mat_words = re.compile(
            r"\b(emt|pvc|rigid|imc|conduits?|wires?|cables?|breakers?|disconnects?|receptacles?"
            r"|switch(?:es)?|box(?:es)?|connectors?|couplings?|straps?|struts?|pipes?|elbows?"
            r"|bends?|fittings?|hubs?|thhn|thwn|awg|mcm|copper|aluminum)\b", re.I)
        out = []
        try:
            for it in items or []:
                if not isinstance(it, dict):
                    continue
                desc = str(it.get("description", "") or "")
                blob = (desc + " " + str(it.get("part_number", "") or "")).strip()
                if not blob:
                    continue
                if _stop.search(blob):
                    continue
                despaced = re.sub(r"\s+", "", blob)
                if _stop_despaced.search(despaced):
                    continue
                qty = str(it.get("qty", "") or "").strip()
                # v4.1.85: a qty-less row carrying a form/reference NUMBER (#9931, PO#12345)
                # is a header field, not material. Deliberately requires 3+ digits so wire
                # gauges survive -- '#6 THHN', '#10 green', '#3/0' are real items and must
                # never be dropped by this rule.
                if not qty and re.search(r"#\s*\d{3,}", despaced) and not _mat_words.search(blob):
                    continue
                if not qty:
                    letters = [c for c in blob if c.isalpha()]
                    has_digit = any(c.isdigit() for c in blob)
                    if letters and not has_digit and all(c.isupper() for c in letters):
                        continue  # qty-less ALL-CAPS, no digits: letterhead, not material
                out.append(it)
        except Exception:
            return list(items or [])
        return out

    def _coverage_materials_from_msg_attachments(self, msg, include_images=True, source_label=""):
        """v4.1.18: extract LINE ITEMS from a live Outlook message's attachments for
        Quote Coverage -- documents (PDF/Excel/Word/CSV/text) AND pictures: attached
        photos or screenshots PASTED INTO THE BODY (Outlook stores those as inline
        image attachments with a content-id, which the older inline detector skipped
        as signature noise; here any image >= COVERAGE_IMAGE_MIN_BYTES counts as real
        content, so a screenshot of a material list is read while logos are not).

        Extraction ladder per file (all existing, battle-tested machinery):
          1. extract_structured_materials_from_saved_attachment -- structured
             Excel/PDF-table parse with header mapping; falls through internally to
             read_text_from_file_best_effort (PyMuPDF -> pdfplumber -> pypdf ->
             Tesseract OCR; images OCR'd directly) + flat-text row parsing.
          2. If that yields nothing: raw text -> extract_materials_from_quote_text
             over the columnar-reassembled text.

        Returns normalized material dicts (each tagged source_file). Successful
        (non-empty) results are cached per EntryID for the session -- a delivered
        message's attachments never change, so OCR runs at most once per message.
        Fail-soft everywhere: any COM/parse error just skips that file."""
        self._coverage_attach_last_save_failed = False
        # v4.1.31: structured decision consumed by the customer-request scan.
        self._coverage_intake_last_result = {
            "decision": "bypass", "document_role": "unknown",
            "review_reason": "", "metrics": {}, "warnings": [],
            "engine_available": bool(COVERAGE_INTAKE_ENGINE_AVAILABLE),
        }
        # v4.1.22 (external audit round 4, finding #8): parse EXCEPTIONS after a successful
        # save are tracked like save failures -- one attachment parsing while another dies
        # mid-extraction must not let the message complete silently.
        self._coverage_attach_last_parse_failed = False
        # v4.1.23 (round 5, finding #11): oversized / cap-deferred material was silently
        # treated as an empty parse; the flag routes it to Attachment Review instead.
        self._coverage_attach_last_skipped_material = False
        cache = getattr(self, "_coverage_attach_mats_cache", None)
        if cache is None:
            cache = self._coverage_attach_mats_cache = {}
        _ck = ""
        try:
            _ck = str(getattr(msg, "EntryID", "") or "")
        except Exception:
            _ck = ""
        if _ck and _ck in cache:
            return [dict(m) for m in cache[_ck]]
        try:
            atts = msg.Attachments
            count = int(getattr(atts, "Count", 0) or 0)
        except Exception:
            return []
        if count <= 0:
            return []
        docs = []
        imgs = []
        for i in range(1, min(count, 20) + 1):
            try:
                att = atts.Item(i)
                fname = safe_filename_piece(getattr(att, "FileName", "") or f"attachment_{i}", f"attachment_{i}")
                ext = os.path.splitext(fname)[1].lower()
                try:
                    size = int(getattr(att, "Size", 0) or 0)
                except Exception:
                    size = 0
                if size > COVERAGE_ATTACH_MAX_FILE_BYTES:
                    _cov_debug(f"ATTACH-ITEMS {source_label} skip oversized {fname!r} ({size} bytes)")
                    self._coverage_attach_last_skipped_material = True  # v4.1.23 finding #11
                    continue
                if ext in COVERAGE_ATTACHMENT_DOC_EXTS:
                    docs.append((att, fname, size))
                elif include_images and ext in COVERAGE_ATTACHMENT_IMG_EXTS and size >= COVERAGE_IMAGE_MIN_BYTES:
                    # Inline OR attached: a screenshot pasted into the body is exactly
                    # the content this feature exists for. The size floor excludes
                    # tiny divider/tracker images only (v4.1.82: it was 60KB, which
                    # discarded the user's real 9-34KB list screenshots before OCR).
                    # v4.1.82 SIGNATURE SUPPRESSION, before the MAX_IMAGES cap so
                    # boilerplate cannot crowd out the real screenshot: an identical
                    # (filename, size) pair seen on several DIFFERENT messages is a
                    # signature banner ('NOW HIRING' etc. rides on every send), not
                    # content -- skip it without spending OCR. First sightings still
                    # OCR normally (results are cached per EntryID anyway).
                    _sig_stats = getattr(self, "_coverage_signature_img_stats", None)
                    if _sig_stats is None:
                        _sig_stats = self._coverage_signature_img_stats = {}
                    _sig_key = (fname.lower(), size)
                    _seen_on = _sig_stats.setdefault(_sig_key, set())
                    if _ck:
                        _seen_on.add(_ck)
                    if len(_seen_on) >= COVERAGE_SIGNATURE_IMG_SEEN_MAX:
                        _cov_debug(f"ATTACH-ITEMS {source_label} skip recurring signature image {fname!r} ({size} bytes, seen on {len(_seen_on)} messages)")
                        continue
                    imgs.append((att, fname, size))
            except Exception:
                continue
        if len(docs) > COVERAGE_ATTACH_MAX_DOCS or len(imgs) > COVERAGE_ATTACH_MAX_IMAGES:
            self._coverage_attach_last_skipped_material = True  # v4.1.23: cap-deferred files
            _cov_debug(f"ATTACH-ITEMS {source_label}: {max(0, len(docs) - COVERAGE_ATTACH_MAX_DOCS)} doc(s) / "
                       f"{max(0, len(imgs) - COVERAGE_ATTACH_MAX_IMAGES)} image(s) beyond caps -- flagged for review")
        docs = docs[:COVERAGE_ATTACH_MAX_DOCS]
        imgs = imgs[:COVERAGE_ATTACH_MAX_IMAGES]
        # v4.1.20 (external audit round 2, finding #1): PER-ATTACHMENT save tracking.
        # v4.1.19 only flagged a failure when NO attachment saved -- so a logo that saved
        # fine masked the material-list PDF whose SaveAsFile failed, and after the empty-
        # parse retries the message was marked processed with the PDF never inspected.
        # The flag now means "at least one ELIGIBLE attachment could not be saved"; the
        # caller must not mark the message done while it is set, and partial results are
        # NOT session-cached so the failed file is genuinely re-attempted on retry.
        self._coverage_attach_last_save_failed = False
        if not docs and not imgs:
            return []
        mats = []
        saved_ct = 0
        failed_ct = 0
        temp_root = ""
        try:
            temp_root = tempfile.mkdtemp(prefix="mainbox_cov_req_")
            for _fidx, (att, fname, size) in enumerate(docs + imgs, start=1):
                try:
                    # v4.1.18 audit: index prefix so two attachments with the SAME filename
                    # (common with image001.png) cannot overwrite each other in the temp dir.
                    path = os.path.join(temp_root, f"{_fidx:02d}_{fname}")
                    try:
                        att.SaveAsFile(path)
                    except Exception:
                        failed_ct += 1
                        _cov_debug(f"ATTACH-ITEMS {source_label} SAVE FAILED for {fname!r}")
                        continue
                    if not os.path.exists(path):
                        failed_ct += 1
                        _cov_debug(f"ATTACH-ITEMS {source_label} save produced no file for {fname!r}")
                        continue
                    saved_ct += 1
                    items = []
                    _parse_exc = 0
                    try:
                        items = extract_structured_materials_from_saved_attachment(path, fname, keep_duplicates=True) or []
                    except Exception:
                        items = []
                        _parse_exc += 1
                    _is_img_file = os.path.splitext(fname)[1].lower() in COVERAGE_ATTACHMENT_IMG_EXTS
                    if not items:
                        try:
                            t = read_text_from_file_best_effort(path) or ""
                            # v4.1.83: purchase-form screenshots OCR their letterhead
                            # block above the material table -- trim to the table first
                            # (image files only; structured docs keep their machinery).
                            if _is_img_file:
                                t = self._trim_ocr_text_to_material_table(t)
                            if t.strip():
                                items = extract_materials_from_quote_text(
                                    _coverage_reassemble_columnar_quote(t), keep_duplicates=True) or []
                        except Exception:
                            items = []
                            _parse_exc += 1
                    # v4.1.83: image-derived rows also pass the letterhead/banner filter
                    # (real production junk: 'AMERICAN POWER', 'MBE SBE ! LBE', 'DELIVER
                    # TO: ...' were shipped into a live ledger by the v4.1.82 backfill).
                    if items and _is_img_file:
                        items = self._filter_ocr_letterhead_items(items)
                    if _parse_exc >= 2 or (_parse_exc and not items):
                        # Both extraction ladders raised (or the only one tried raised and
                        # produced nothing): this file was never actually read.
                        self._coverage_attach_last_parse_failed = True
                        _cov_debug(f"ATTACH-ITEMS {source_label} PARSE FAILED for {fname!r}")
                    kept = 0
                    for it in items:
                        if isinstance(it, dict):
                            it.setdefault("source_file", fname)
                            mats.append(it)
                            kept += 1
                    _cov_debug(f"ATTACH-ITEMS {source_label} file={fname!r} size={size} -> {kept} item(s)")
                except Exception:
                    continue
        except Exception:
            self._coverage_attach_last_save_failed = True
            return []
        finally:
            try:
                if temp_root and os.path.isdir(temp_root):
                    shutil.rmtree(temp_root, ignore_errors=True)
            except Exception:
                pass
        if failed_ct > 0:
            self._coverage_attach_last_save_failed = True
            _cov_debug(f"ATTACH-ITEMS {source_label}: {failed_ct} of {saved_ct + failed_ct} eligible attachment(s) failed to save -- caller must not mark this message done")
        mats = normalize_material_items(mats, keep_duplicates=True)[:150]
        # v4.1.31: WHOLE-DOCUMENT + POSITIVE-ROW gate.  Existing OCR/SmartScan
        # extraction remains unchanged; this engine decides whether those candidates
        # are safe customer-request rows, a commercial/internal document to reject,
        # or an ambiguous result to quarantine for Attachment Review.
        try:
            _engine_enabled = bool((getattr(self, "settings", {}) or {}).get("coverage_intake_engine_enabled", True))
        except Exception:
            _engine_enabled = True
        # v4.1.35 (F5): the intake engine judges CUSTOMER-REQUEST extraction only.
        # Since v4.1.31 it also ran on the sent-RFQ path, where the sender is our own
        # address, so the internal-sender veto silently emptied every sent-RFQ
        # attachment ingestion. The sent path is the user's own deliberate action --
        # the contamination class this engine guards against does not apply there.
        _intake_applies = (source_label == "customer-request")
        if _intake_applies and _engine_enabled and COVERAGE_INTAKE_ENGINE_AVAILABLE and _COVERAGE_INTAKE_ENGINE is not None:
            try:
                try:
                    _ctx_subject = str(getattr(msg, "Subject", "") or "")
                except Exception:
                    _ctx_subject = ""
                try:
                    _ctx_body = str(getattr(msg, "Body", "") or "")[:8000]
                except Exception:
                    _ctx_body = ""
                try:
                    _ctx_sender = str(self.get_sender_email(msg) or "")
                except Exception:
                    _ctx_sender = ""
                try:
                    _ctx_sender_name = str(getattr(msg, "SenderName", "") or "")
                except Exception:
                    _ctx_sender_name = ""
                try:
                    _ctx_conv = str(getattr(msg, "ConversationID", "") or "")
                except Exception:
                    _ctx_conv = ""
                _ctx_type = ""
                try:
                    _saved_row = self.get_email_by_id(_ck) or {}
                    _ctx_type = normalize_email_type_code((_saved_row or {}).get("email_type", ""))
                except Exception:
                    _ctx_type = ""
                try:
                    _internal_domains = tuple(sorted(self._own_mailbox_domains(getattr(self, "namespace", None))))
                except Exception:
                    _internal_domains = ()
                _source_files = ", ".join([str(x[1]) for x in (docs + imgs)])
                _intake = _COVERAGE_INTAKE_ENGINE.evaluate_customer_request(
                    mats,
                    IntakeContext(
                        subject=_ctx_subject, body=_ctx_body, sender_email=_ctx_sender,
                        sender_name=_ctx_sender_name, sender_type=_ctx_type,
                        internal_domains=_internal_domains, source_file=_source_files,
                        message_id=_ck, conversation_id=_ctx_conv,
                    ),
                )
                self._coverage_intake_last_result = _intake.to_dict()
                self._coverage_intake_last_result["engine_available"] = True
                if _intake.decision == IntakeDecision.ACCEPT:
                    mats = normalize_material_items(_intake.accepted_items, keep_duplicates=True)[:150]
                else:
                    mats = []
                _cov_debug(
                    f"COVERAGE-INTAKE {source_label}: decision={_intake.decision.value} "
                    f"role={_intake.document_role.value} candidates={_intake.metrics.get('candidate_rows', 0)} "
                    f"accepted={_intake.metrics.get('accepted_rows', 0)} reason={_intake.review_reason!r}"
                )
            except Exception as _intake_exc:
                # v4.1.35 (E1): FAIL CLOSED. The protection was enabled and errored --
                # committing rows through the legacy parser is exactly the contamination
                # path the engine exists to stop. Quarantine to Attachment Review; the
                # Review entry names the cause and Retry re-attempts after a fix.
                self._coverage_intake_last_result = {
                    "decision": "quarantine", "document_role": "unknown",
                    "review_reason": f"Coverage Intake Engine error (rows quarantined, not committed): {_intake_exc}",
                    "metrics": {}, "warnings": [], "engine_available": True,
                }
                mats = []
                _cov_debug(f"COVERAGE-INTAKE FAIL-CLOSED after engine error: {_intake_exc!r}")
        elif _intake_applies and _engine_enabled and not COVERAGE_INTAKE_ENGINE_AVAILABLE:
            # v4.1.35 (E1): FAIL CLOSED. The setting says the intake safety engine is
            # ON but the module is missing/old/broken -- do NOT fall back to the parser
            # that caused the Bid-document contamination. Quarantine instead.
            self._coverage_intake_last_result = {
                "decision": "quarantine", "document_role": "unknown",
                "review_reason": ("Coverage Intake Engine unavailable (rows quarantined, not committed): "
                                  + str(_COVERAGE_INTAKE_IMPORT_ERROR or "module missing")),
                "metrics": {}, "warnings": [], "engine_available": False,
            }
            mats = []
            _cov_debug("COVERAGE-INTAKE FAIL-CLOSED: engine unavailable; rows quarantined")
        # Cache ONLY complete ACCEPTED extractions.  Rejected/quarantined documents
        # must not be cached as material lists.
        # retry return the partial set without ever re-attempting the failed file.
        # v4.1.22: a parse exception is incomplete too.
        if _ck and mats and failed_ct == 0 and not getattr(self, "_coverage_attach_last_parse_failed", False):
            try:
                if len(cache) >= 400:
                    cache.clear()
                cache[_ck] = [dict(m) for m in mats]
            except Exception:
                pass
        return mats

    def scan_recent_inbox_for_quotes(self, max_items=150, lookback_days=14):
        """v3.9.5: Vendor pricing arrives inbound -- in My Inbox OR shared Sales Inbox.
        Scan both folders for priced vendor replies; any priced reply whose line items match a
        coverage record's requested items flips those items to Quoted. Linking/gating is handled
        by update_coverage_quoted_from_sent, so this remains conservative and idempotent."""
        self._last_quote_scan_folder_errors = []   # v4.1.28 (round 10, blocker #4)
        self._last_quote_scan_health = []          # v4.1.30 (round 12, finding #5)
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            self._last_quote_scan_folder_errors.append("Outlook namespace unavailable")
            return 0
        marked = 0
        # v3.9.74: only pay to read PDF/Excel attachments when coverage is actually in use
        # (some thread still has requested items). Cheap one-time check before the folder walk.
        threads_now = (getattr(self, "quote_coverage", {}) or {}).get("threads", {})
        open_cov = any(isinstance(r, dict) and r.get("requested") for r in threads_now.values())
        cutoff = datetime.now() - timedelta(days=lookback_days)
        _cov_debug(f"=== INBOX QUOTE SCAN start max_items={max_items} lookback_days={lookback_days} cutoff={cutoff.isoformat()} ===")
        folders = self.coverage_inbox_folders_for_quote_scan(namespace)
        if not folders:
            _cov_debug("INBOX QUOTE SCAN: no inbound folders available")
            return 0
        seen_message_ids = set()
        # v4.1.26 (round 8, defect #3): SAFE negative-decision cache. Content-permanent
        # non-candidates only: a message with no price in its body, no attachments, and
        # nothing quote-ish in subject/body can NEVER become a vendor quote, so it is
        # checkpointed and skipped for free on every later pass. Messages that carry
        # prices or attachments but don't currently link stay retryable (coverage
        # records come and go; update_coverage_quoted_from_sent stays the gatekeeper).
        _qneg = self.quote_coverage.setdefault("quote_scan_negative", {}) if isinstance(getattr(self, "quote_coverage", None), dict) else {}
        if not isinstance(_qneg, dict):
            _qneg = self.quote_coverage["quote_scan_negative"] = {}
        _qneg_dirty = False
        for folder_label, inbox in folders:
            # v4.1.54: the shared Sales mailbox holds EVERY salesperson's mail. Only the
            # user's own inbox is unconditionally theirs; any other inbound folder (the
            # Sales Inbox) must carry the selected sales category tag before its mail is
            # ingested -- the same rule the main import has always applied. Without this,
            # a colleague's tagged message (e.g. TR while running as SB) had its
            # attachments read and could be queued into Attachment Review.
            _sales_cat_gate = (folder_label != "My Inbox")
            try:
                try:
                    folder_path = str(getattr(inbox, "FolderPath", "") or getattr(inbox, "Name", "") or folder_label)
                except Exception:
                    folder_path = folder_label
                _cov_debug(f"INBOX QUOTE SCAN folder={folder_label!r} path={folder_path!r}")
                items = inbox.Items
                # v3.9.6: trim to the recent window BEFORE reading any message bodies, so a large
                # or uncached shared mailbox isn't fully walked (150+ body reads) on every scan.
                # Restrict can fail on some stores/providers -> fall back to the full collection.
                try:
                    _cut_str = cutoff.strftime("%m/%d/%Y %I:%M %p")
                    items = items.Restrict(f"[ReceivedTime] >= '{_cut_str}'")
                except Exception:
                    pass
                # v4.1.26 (round 8, defect #3): PERSISTENT ALTERNATING CURSOR, same design
                # as the customer-request scan (v4.1.25). A pass that stops at a cap
                # records the oldest position it reached; passes alternate between new
                # mail (top) and backfill continuation (below the cursor), so a vendor
                # quote at position 151 of a busy shared inbox is reached on the next
                # pass instead of being starved forever. Cursor clears when a backfill
                # pass reaches the cutoff (window fully traversed).
                _qcursors = self.quote_coverage.setdefault("quote_scan_cursors", {})
                if not isinstance(_qcursors, dict):
                    _qcursors = self.quote_coverage["quote_scan_cursors"] = {}
                _qcur = _qcursors.get(folder_label) if isinstance(_qcursors.get(folder_label), dict) else {}
                _backfill = bool(_qcur.get("backfill_next")) and bool(str(_qcur.get("oldest_reached", "") or ""))
                _boundary_skip = set()
                if _backfill:
                    try:
                        # v4.1.27 (round 9, blocker #2): the cursor is MINUTE-precision
                        # (Outlook Restrict granularity), so a strict '<' permanently
                        # skipped any message received in the SAME minute as the cursor
                        # but below the cap. Backfill now includes the boundary minute
                        # (< cursor + 1 minute) and free-skips the messages already
                        # processed IN that minute via their recorded EntryIDs.
                        _b_edge = _qcur["oldest_reached"]
                        try:
                            _b_dt = datetime.strptime(_b_edge, "%m/%d/%Y %I:%M %p") + timedelta(minutes=1)
                            _b_edge = _b_dt.strftime("%m/%d/%Y %I:%M %p")
                            _boundary_skip = set(_qcur.get("boundary_ids", []) or [])
                        except Exception:
                            pass   # unparseable stored cursor -> legacy strict behavior
                        items = items.Restrict(f"[ReceivedTime] < '{_b_edge}'")
                        _cov_debug(f"INBOX QUOTE SCAN cursor: backfill pass below {_b_edge!r} (boundary-inclusive, {len(_boundary_skip)} id(s) pre-done) in {folder_label!r}")
                    except Exception:
                        _backfill = False
                try:
                    items.Sort("[ReceivedTime]", True)
                except Exception:
                    pass
                # v4.1.26 (round 8, defect #3): 'checked' now counts only CANDIDATES
                # (priced body, or attachment-bearing quote-ish mail) -- routine
                # correspondence no longer consumes the scan window. 'walked' caps novel
                # examinations; 'raw_walked' is the ultimate COM-traffic safety cap.
                checked = 0
                walked = 0
                raw_walked = 0
                _hit_cap = False
                _last_recv = None
                _minute_key = None
                _minute_ids = []   # v4.1.27: EntryIDs seen in the CURRENT minute (newest-first walk)
                # v4.1.22 (finding #15): same advance-first GetFirst/GetNext iteration as
                # the customer-request scan, replacing direct enumeration after Sort().
                try:
                    _nav_msg = items.GetFirst()
                except Exception:
                    _nav_msg = None
                # v4.1.29 (round 11, finding #3): free-skipping remembered boundary
                # messages must not consume the raw-COM allowance that exists to bound
                # REAL work (body reads, attachment parses) -- otherwise a backfill pass
                # into a huge same-minute burst spends its whole budget re-skipping what
                # it already did and never advances (auditor's 5,200-burst repro). The
                # raw cap is extended by exactly the boundary-set size: skips are cheap
                # GetNext calls, so the true COM ceiling is 5000 + |boundary| (boundary <= 20000, so <= 25000)
                # navigations with the same 5000-real-message work bound as before.
                _raw_cap = 5000 + len(_boundary_skip)
                while _nav_msg is not None:
                    msg = _nav_msg
                    try:
                        _nav_msg = items.GetNext()
                    except Exception:
                        _nav_msg = None
                    raw_walked += 1
                    if checked >= max_items or walked >= 1000 or raw_walked >= _raw_cap:
                        _hit_cap = True
                        break
                    try:
                        try:
                            recv_dt = msg.ReceivedTime.replace(tzinfo=None)
                        except Exception:
                            recv_dt = None
                        if recv_dt is not None and recv_dt < cutoff:
                            break
                        if recv_dt is not None:
                            _last_recv = recv_dt
                        try:
                            entry_id = msg.EntryID or ""
                        except Exception:
                            entry_id = ""
                        # v4.1.27 (round 9, blocker #2): remember which messages live in the
                        # minute we may stop in, so a boundary-inclusive backfill can skip
                        # exactly them without re-consuming the window.
                        # v4.1.28 (round 10, blocker #3): stored as 16-hex SHA1 HASHES with
                        # a 5000 cap (~80 KB worst case) instead of 500 full EntryIDs --
                        # the old cap stalled traversal at ~650 messages in one minute
                        # because the boundary memory could not grow past 500. 5000 matches
                        # the raw-COM work bound: a burst the scanner can physically walk,
                        # the cursor can remember (20000-hash memory, ~360 KB only when a
                        # minute actually bursts). Beyond that is beyond any per-pass budget BY DESIGN (Outlook Restrict is minute-granular, so a
                        # seconds+ID compound cursor is not implementable at the API level;
                        # the boundary-ID set IS the tie-breaker) -- and the overflow is
                        # LOGGED rather than silent.
                        _bh = ""
                        if entry_id:
                            _bh = hashlib.sha1(str(entry_id).encode("utf-8", "ignore")).hexdigest()[:16]
                        if recv_dt is not None and _bh:
                            _mk = recv_dt.strftime("%m/%d/%Y %I:%M %p")
                            if _mk != _minute_key:
                                _minute_key = _mk
                                _minute_ids = []
                            if len(_minute_ids) < 20000:
                                _minute_ids.append(_bh)
                            elif len(_minute_ids) == 20000:
                                _minute_ids.append("__overflow__")  # sentinel: record once
                                # v4.1.30 (round 12, finding #5): _cov_debug is OFF in
                                # production, so saturation must surface through channels
                                # the user actually sees: the scan-health list (shown in
                                # the Full Update summary) and a persisted note in the
                                # coverage ledger (shown in the coverage status label).
                                _note = (f"Mail burst: minute {_mk} holds over 20,000 messages; the scan cannot "
                                         f"guarantee reaching every message in that minute. Anything missed can be "
                                         f"linked manually from Quote Coverage.")
                                try:
                                    self._last_quote_scan_health.append(_note)
                                except Exception:
                                    pass
                                try:
                                    _sh = self.quote_coverage.setdefault("scan_health", [])
                                    if isinstance(_sh, list):
                                        _sh.append({"at": datetime.now().isoformat(), "note": _note})
                                        if len(_sh) > 50:
                                            del _sh[:len(_sh) - 50]
                                        _qneg_dirty = True
                                except Exception:
                                    pass
                                _cov_debug(f"INBOX QUOTE SCAN: {_note}")
                        if entry_id and entry_id in seen_message_ids:
                            continue
                        if entry_id:
                            seen_message_ids.add(entry_id)
                        if entry_id and (_bh in _boundary_skip or entry_id in _boundary_skip):
                            continue   # v4.1.27: already processed in the boundary minute
                                       # (raw-EntryID check keeps pre-v4.1.28 cursors working)
                        # Free skip: examined on an earlier pass and content-permanently
                        # not a candidate (no price, no attachments, nothing quote-ish).
                        if entry_id and int(_qneg.get(entry_id, -1)) == COVERAGE_QUOTE_GATE_VERSION:
                            continue
                        # v4.1.54: Sales-Inbox messages must be tagged with the selected
                        # sales category before ANY ingestion work (body read, attachment
                        # parse, coverage flip, Attachment Review queue). Deliberately NOT
                        # checkpointed in the negative cache: category tags are mutable,
                        # so a message tagged for this user later becomes visible on the
                        # next pass. One cheap COM property read; happens before the
                        # 'walked' budget so a colleague-heavy Sales Inbox cannot starve
                        # the user's own scan window.
                        if _sales_cat_gate:
                            try:
                                _msg_cats = msg.Categories or ""
                            except Exception:
                                _msg_cats = ""
                            if not self.email_has_outlook_category(_msg_cats, self.selected_sales_category):
                                # v4.2.66 Phase 3: a reply on ONE OF OUR RFQ THREADS is our
                                # work regardless of category -- an uncategorized vendor
                                # reply in the shared Sales inbox was otherwise invisible
                                # to the quote scan FOREVER (a vendor never tags SB; the
                                # wire-quote reply only flipped because a human tagged it).
                                # One extra COM read (ConversationID) only on messages
                                # about to be skipped, then a local dict lookup.
                                _conv_ours = False
                                try:
                                    _cv = str(msg.ConversationID or "")
                                    _conv_ours = bool(_cv and self._coverage_group_id_for_conversation(_cv))
                                except Exception:
                                    _conv_ours = False
                                if not _conv_ours:
                                    continue
                        walked += 1
                        try:
                            body = msg.Body or ""
                        except Exception:
                            body = ""
                        try:
                            subj = msg.Subject or ""
                        except Exception:
                            subj = ""
                        has_price = bool(re.search(r"\$\s*\.?\d|\b\d+\.\d{2}\b", body))
                        _quoteish = bool(_COVERAGE_QUOTEISH_RE.search((subj + " " + body).lower()))
                        try:
                            _has_attach = int(getattr(msg.Attachments, "Count", 0) or 0) > 0
                        except Exception:
                            _has_attach = False
                        try:
                            conv_id = msg.ConversationID or ""
                        except Exception:
                            conv_id = ""
                        # v4.1.26 (round 8, defect #4): a reply whose CONVERSATION links to
                        # an open coverage record qualifies for the attachment read even
                        # with no keyword at all -- the vendor who answers "Attached." on
                        # the RFQ thread is exactly the quote this scan exists to catch.
                        _conv_linked = False
                        if _has_attach and not _quoteish and open_cov and conv_id:
                            try:
                                if self._coverage_group_id_for_conversation(conv_id):
                                    _conv_linked = True
                                else:
                                    _tk = self.coverage_thread_key(conv_id, subj)
                                    _lr = self.get_coverage_record(_tk, create=False) if _tk else None
                                    _conv_linked = bool(_lr and _lr.get("requested"))
                            except Exception:
                                _conv_linked = False
                        # v3.9.74: vendor quotes often arrive as a PDF/Excel with NO price in the
                        # email body, so the old body-price pre-filter dropped them entirely. When
                        # coverage is in use and the message reads like a quote (or its thread is
                        # linked to a coverage record), pull text from its document attachments so
                        # those line items can flip requested -> Quoted. Body-priced mail keeps its
                        # fast path; attachment text is added on top.
                        attach_text = ""
                        _att_incomplete = False
                        if open_cov and _has_attach and (_quoteish or has_price or _conv_linked):
                            # v4.1.27 (round 9, blocker #4): bounded retry for messages whose
                            # attachments keep failing -- after 5 failed passes the message
                            # goes to Attachment Review (visible work) instead of silently
                            # consuming every future scan pass.
                            _qart = self.quote_coverage.setdefault("quote_scan_attach_retry", {})
                            if not isinstance(_qart, dict):
                                _qart = self.quote_coverage["quote_scan_attach_retry"] = {}
                            if int(_qart.get(entry_id, 0) or 0) >= 5:
                                pass   # gave up on the attachments; body-price path below still works
                            else:
                                try:
                                    attach_text = self._attachment_quote_text_from_msg(msg)
                                except Exception:
                                    attach_text = ""
                                _att_incomplete = bool(getattr(self, "_vendor_attach_last_failed", False))
                                # v4.2.50: an IMAGE-style quote PDF (no text layer) "succeeds"
                                # with a near-empty yield -- Brian's 685KB ADC quote extracted
                                # exactly 2 chars, matched nothing, and never escalated because
                                # nothing technically FAILED. Treat a trivial yield from a real
                                # document attachment as incomplete so the existing 5-pass retry
                                # -> Attachment Review machinery surfaces it as visible work.
                                if not _att_incomplete and len((attach_text or "").strip()) < 40:
                                    try:
                                        _doc_exts = (".pdf", ".xlsx", ".xls", ".docx", ".doc", ".csv")
                                        for _ai in range(1, int(getattr(msg.Attachments, "Count", 0) or 0) + 1):
                                            try:
                                                _an = str(msg.Attachments.Item(_ai).FileName or "").lower()
                                            except Exception:
                                                continue
                                            if _an.endswith(_doc_exts):
                                                _att_incomplete = True
                                                try:
                                                    self._vendor_attach_failed_names = [_an]
                                                except Exception:
                                                    pass
                                                break
                                    except Exception:
                                        pass
                                if _att_incomplete:
                                    _tries = int(_qart.get(entry_id, 0) or 0) + 1
                                    _qart[entry_id] = _tries
                                    _qneg_dirty = True
                                    if _tries >= 5:
                                        # v4.1.28 (round 10, blocker #5): the entry carries
                                        # its DURABLE identity (Message-ID, sender, conv,
                                        # failed file names) so the review window's
                                        # Message-ID fallback and Retry actually have
                                        # something to work with after EntryID churn.
                                        try:
                                            _arnq = self.quote_coverage.setdefault("attachment_review_needed", [])
                                            if isinstance(_arnq, list):
                                                try:
                                                    _v_imid = re.sub(r"\s+", "", str(outlook_msg_internet_id(msg) or "")).lower()
                                                except Exception:
                                                    _v_imid = ""
                                                try:
                                                    _v_sender = self.get_sender_email(msg) or str(getattr(msg, "SenderName", "") or "")
                                                except Exception:
                                                    _v_sender = ""
                                                _arnq.append({
                                                    "entry_id": entry_id,
                                                    "internet_message_id": _v_imid,
                                                    "subject": str(subj or "")[:160],
                                                    "sender": str(_v_sender or "")[:120],
                                                    "conversation_id": str(conv_id or ""),
                                                    "failed_files": list(getattr(self, "_vendor_attach_failed_names", []) or [])[:10],
                                                    "reason": "vendor quote attachment(s) could not be fully read after 5 scan passes",
                                                    "attempts": _tries,
                                                    "at": datetime.now().isoformat(),
                                                })
                                                ops_log("coverage", "attachment_review_queued",
                                                        eid=str(entry_id or "")[-16:], subj=str(subj or ""),
                                                        sender=str(_v_sender or ""), attempts=_tries,
                                                        failed_files=list(getattr(self, "_vendor_attach_failed_names", []) or [])[:6])
                                                if len(_arnq) > 1000:
                                                    del _arnq[:len(_arnq) - 1000]
                                        except Exception:
                                            pass
                                        _cov_debug(f"INBOX QUOTE SCAN: attachments still failing for {subj!r} after {_tries} passes -- queued for Attachment Review")
                                elif entry_id in _qart:
                                    _qart.pop(entry_id, None)
                                    _qneg_dirty = True
                        if not has_price and not attach_text:
                            # Checkpoint ONLY the content-permanent case. A quote-ish or
                            # attachment-bearing message stays retryable: attachments may
                            # parse later (extractor upgrades) and coverage links change.
                            if entry_id and not _has_attach and not _quoteish and not has_price:
                                _qneg[entry_id] = COVERAGE_QUOTE_GATE_VERSION
                                _qneg_dirty = True
                            continue
                        checked += 1  # candidate consumed part of the scan window
                        # v3.9.101: capture who SENT this inbound message so the flip can require a
                        # VENDOR. The customer's own reply lands in this same inbox scan (e.g. the
                        # customer re-stating the item they want, with your earlier priced quote
                        # attached), and without the sender the item-name + any-price match flips
                        # the customer's requested item to Quoted.
                        try:
                            _in_sender = self.get_sender_email(msg) or ""
                        except Exception:
                            _in_sender = ""
                        _cov_debug(f"INBOX-CANDIDATE folder={folder_label!r} subj={subj!r} body_priced={has_price} attach_chars={len(attach_text)} attach_incomplete={_att_incomplete} conv_linked={_conv_linked} sender={_in_sender!r} recv={(recv_dt.isoformat() if recv_dt else '?')}")
                        added = self.update_coverage_quoted_from_sent(
                            conversation_id=conv_id, subject=subj, body=body, attachment_text=attach_text,
                            sent_entry_id=entry_id, sent_on=(recv_dt.isoformat() if recv_dt else datetime.now().isoformat()),
                            sender_email=_in_sender, source_message_id=outlook_msg_internet_id(msg),
                            attachment_incomplete=_att_incomplete)  # v4.1.27: partial reads never finalize
                        if added:
                            marked += added
                    except Exception:
                        continue
                # v4.1.26 (round 8, defect #3): persist the cursor decision for this folder
                # -- identical semantics to the customer-request scan. A capped BACKFILL
                # pass advances the cursor deeper; a capped TOP pass keeps the (deeper)
                # stored cursor so backfill progress is never lost; any pass that fully
                # traverses its window clears the cursor.
                try:
                    if _hit_cap and _last_recv is not None:
                        _entry = dict(_qcur) if isinstance(_qcur, dict) else {}
                        if _backfill or not str(_entry.get("oldest_reached", "") or ""):
                            _entry["oldest_reached"] = _last_recv.strftime("%m/%d/%Y %I:%M %p")
                            # v4.1.27 (round 9, blocker #2): record WHICH messages in the
                            # boundary minute were already covered, so the next backfill
                            # includes that minute without repeating them. Only refreshed
                            # when oldest_reached itself moves (they belong together).
                            _entry["boundary_ids"] = list(_minute_ids)[:20000] if _minute_key == _entry["oldest_reached"] else []
                        _entry["backfill_next"] = not _backfill
                        _qcursors[folder_label] = _entry
                        _qneg_dirty = True
                        _cov_debug(f"INBOX QUOTE SCAN cursor saved for {folder_label!r}: oldest={_entry.get('oldest_reached')!r} backfill_next={_entry.get('backfill_next')} boundary_ids={len(_entry.get('boundary_ids', []) or [])} (checked={checked} walked={walked} raw={raw_walked})")
                    elif folder_label in _qcursors:
                        _qcursors.pop(folder_label, None)
                        _qneg_dirty = True
                        _cov_debug(f"INBOX QUOTE SCAN cursor cleared for {folder_label!r} (window fully traversed)")
                except Exception:
                    pass
            except Exception as _e:
                # v4.1.28 (round 10, blocker #4): a folder that died before being inspected
                # must be DISTINGUISHABLE from "scanned, nothing found". The error is
                # surfaced to the caller (Full Update shows it as a warning) instead of
                # only being swallowed into the debug log.
                try:
                    self._last_quote_scan_folder_errors.append(f"{folder_label}: {_e!r:.120}")
                except Exception:
                    pass
                _cov_debug(f"INBOX QUOTE SCAN folder exception {folder_label!r}: {_e!r}")
        # Bound + persist the negative cache and cursors (piggybacks the coverage save).
        try:
            if len(_qneg) > 8000:
                # Oldest-insertion trim: dict preserves insertion order.
                for _k in list(_qneg.keys())[:len(_qneg) - 8000]:
                    _qneg.pop(_k, None)
            if _qneg_dirty:
                self.save_quote_coverage()
        except Exception:
            pass
        ops_log("scan", "vendor_quote_pass", marked=marked)
        return marked

    def _own_mailbox_domains(self, namespace=None):
        """v4.1.20 (external audit round 2, finding #4): the signed-in mailbox's SMTP
        domain(s), resolved once and cached for the session. Lets the customer-attachment
        scan classify same-domain senders as INTERNAL before any sender-level learning
        exists, so your own replies landing in the shared Sales inbox -- or a brand-new
        colleague -- can never seed customer-requested coverage items."""
        cached = getattr(self, "_own_domains_cache", None)
        if isinstance(cached, set) and cached:
            return cached
        doms = set()
        try:
            ns = namespace or getattr(self, "namespace", None)
            cu = getattr(ns, "CurrentUser", None) if ns is not None else None
            addr = ""
            if cu is not None:
                try:
                    ae = cu.AddressEntry
                    try:
                        exu = ae.GetExchangeUser()
                        if exu is not None:
                            addr = str(exu.PrimarySmtpAddress or "")
                    except Exception:
                        pass
                except Exception:
                    pass
                if not addr:
                    try:
                        addr = str(getattr(cu, "Address", "") or "")
                    except Exception:
                        addr = ""
            d = get_email_domain(addr)
            if d:
                doms.add(str(d).lower())
        except Exception:
            pass
        # v4.1.31: configured aliases + employee-learned domains.  Outlook
        # CurrentUser often exposes only the primary SMTP domain while shared
        # mailboxes and aliases use another company domain.
        try:
            if COVERAGE_INTAKE_ENGINE_AVAILABLE:
                doms.update(configured_internal_domains(getattr(self, "settings", {}) or {}, doms))
            else:
                _raw = str((getattr(self, "settings", {}) or {}).get("internal_domains", "") or "")
                _raw += "," + str(os.environ.get("MAINBOX_INTERNAL_DOMAINS", "") or "")
                for _tok in re.split(r"[,;\s]+", _raw.lower()):
                    _tok = _tok.strip().lstrip("@")
                    if _tok and "." in _tok:
                        doms.add(_tok)
        except Exception:
            pass
        try:
            for _row in (getattr(self, "emails", []) or []):
                if not isinstance(_row, dict) or normalize_email_type_code(_row.get("email_type", "")) != "E":
                    continue
                _ed = str(get_email_domain(_row.get("sender_email", "") or _row.get("sender", "")) or "").lower()
                if _ed:
                    doms.add(_ed)
        except Exception:
            pass
        if doms:
            self._own_domains_cache = doms
        return doms

    def scan_recent_inbox_for_customer_request_attachments(self, max_items=80, lookback_days=10, max_new=10):
        """v4.1.18: CUSTOMER REQUEST ATTACHMENT COVERAGE. A customer's item list often
        arrives as a PDF/Excel attachment or a screenshot pasted into the body -- not as
        typed text -- so nothing reached the coverage ledger. This scan walks the same
        inbound folders as the vendor-quote scan and, for messages that read like a
        QUOTE REQUEST and carry document attachments or meaningful body images, extracts
        their line items and creates/updates the thread's coverage ledger (items land
        Outstanding; the normal outgoing-RFQ hook flips them Waiting and vendor pricing
        flips them Quoted, exactly like typed items).

        Conservative + idempotent by construction:
        - each message is examined ONCE ever (persistent processed-ID ledger inside the
          coverage file, so it survives restarts and rides the cloud backup);
        - request gate: customer-request phrases, RFQ/P&A subjects, or explicit
          "quote the attached list / see screenshot" language -- priced vendor quotes
          never qualify (they are the OTHER scan's job);
        - relationship gate: durable Vendor/Marketing/Internal senders never create
          requested items (v4.1.17 sticky types feed this);
        - dismissed ledgers are never resurrected;
        - max_new caps how many NEW messages get the (OCR-capable) extraction per pass,
          so a first run over a busy inbox spreads across refreshes instead of stalling;
        - runs inside the same serialized Outlook worker contexts as the quote scan.

        Gated by settings['auto_coverage_from_customer_attachments'] (default ON)."""
        try:
            # v4.1.39: this scan now hosts BOTH customer-request mining and PO-award
            # detection. Run it if EITHER feature is enabled; the request-creation work
            # inside still respects auto_coverage_from_customer_attachments, and PO
            # detection has its own _po_award_enabled() gate. Previously PO detection
            # could never run when attachment auto-coverage was off, despite its own
            # settings being on.
            _attach_cov_on = bool(self.settings.get("auto_coverage_from_customer_attachments", True))
            _po_on = False
            try:
                _po_on = self._po_award_enabled()
            except Exception:
                _po_on = False
            if not _attach_cov_on and not _po_on:
                return 0
        except Exception:
            pass
        if not isinstance(getattr(self, "quote_coverage", None), dict):
            return 0
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return 0
        processed_list = self.quote_coverage.setdefault("processed_customer_request_ids", [])
        if not isinstance(processed_list, list):
            processed_list = self.quote_coverage["processed_customer_request_ids"] = []
        processed = set(str(x) for x in processed_list)
        # v4.1.22 (external audit round 4, finding #6): NEGATIVE-DECISION checkpointing.
        # A message examined and found NOT to be a request is remembered (with the gate
        # version), so signature-image/invoice traffic stops re-consuming the scan window
        # every pass and older RFQs beneath it are reached. Bumping the gate version
        # re-examines everything automatically.
        negative = self.quote_coverage.setdefault("request_scan_negative", {})
        if not isinstance(negative, dict):
            negative = self.quote_coverage["request_scan_negative"] = {}
        cutoff = datetime.now() - timedelta(days=lookback_days)
        _cov_debug(f"=== CUSTOMER REQUEST ATTACHMENT SCAN start max_items={max_items} lookback_days={lookback_days} max_new={max_new} ===")
        self._last_req_scan_folder_errors = []   # v4.1.28 (round 10, blocker #4)
        folders = self.coverage_inbox_folders_for_quote_scan(namespace)
        if not folders:
            return 0
        added_total = 0
        new_processed = 0
        dirty = False
        seen_ids = set()
        for folder_label, inbox in folders:
            if new_processed >= max_new:
                break
            # v4.1.54: same Sales-mailbox ownership rule as the vendor-quote scan -- only
            # messages tagged with the selected sales category are ingested from any
            # folder other than the user's own inbox.
            _sales_cat_gate = (folder_label != "My Inbox")
            try:
                items = inbox.Items
                try:
                    _cut_str = cutoff.strftime("%m/%d/%Y %I:%M %p")
                    items = items.Restrict(f"[ReceivedTime] >= '{_cut_str}'")
                except Exception:
                    pass
                # v4.1.21 (external audit round 3, finding #6): STARVATION FIX part 1 --
                # restrict so routine traffic never consumes the scan window. Fail-soft:
                # some stores reject DASL restrictions; the walk below still works.
                # v4.2.57: the old clause was hasattachment=1 ONLY -- the FINAL layer that
                # kept Steve's no-attachment typed-list test invisible (server-side, so the
                # relaxed in-loop gate never even saw the message). Now: attachment-bearing
                # OR a request-shaped SUBJECT, matching the in-loop gate's vocabulary.
                # v4.2.59: Steve's second rig test (subject just 'request', phrase
                # 'price and availability' ONLY in the body) proved subject vocab
                # is not enough -- real customers title requests blandly. The
                # Restrict now also matches the request PHRASES in the BODY
                # (validated live: this store accepts textdescription LIKE and the
                # test email is in the set). Fail-soft chain: full clause ->
                # subject clause -> attachment-only -> unrestricted walk.
                _req_restrict_full = (
                    '@SQL="urn:schemas:httpmail:hasattachment"=1'
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%quot%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%rfq%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%p&a%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%pric%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%estimate%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%bid%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%material%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%price and availability%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%please quote%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%can you quote%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%need pricing%\''
                    # v4.2.68 (John DeRosa 8/21): ORDER-shaped customer asks. His FW had
                    # only inline signature images (Exchange evaluates hasattachment=0 for
                    # inline-only -- validated live: the message was absent from this
                    # restrict's result set), subject "Pipe delivery" has no quote vocab,
                    # and the ask was "we need the following Pipe" -- fulfillment wording,
                    # not pricing wording. Same class as the v4.2.57/59 restrict holes.
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%we need the following%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%can you deliver%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%do this delivery%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%can you supply%\''
                    # v4.2.71 (Roger Ezri 8/21 11:52): "Please provide a quote for the
                    # following items" -- 'provide a quote' has ALWAYS been in the
                    # in-loop phrase list, but this DASL body subset was hand-copied
                    # and drifted, so the server never returned the message (its only
                    # attachments were inline signature GIFs -> hasattachment=0).
                    # Mirror the remaining in-loop request phrases customers use.
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%a quote for%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%provide a quote%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%provide pric%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%request a quote%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%requesting a quote%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%looking for a quote%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%please price%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%quote the attached%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%could you quote%\''
                    ' OR "urn:schemas:httpmail:textdescription" LIKE \'%can you price%\'')
                _req_restrict_subj = (
                    '@SQL="urn:schemas:httpmail:hasattachment"=1'
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%quot%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%rfq%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%p&a%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%pric%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%estimate%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%bid%\''
                    ' OR "urn:schemas:httpmail:subject" LIKE \'%material%\'')
                try:
                    items = items.Restrict(_req_restrict_full)
                except Exception:
                    try:
                        items = items.Restrict(_req_restrict_subj)
                    except Exception:
                        try:
                            items = items.Restrict('@SQL="urn:schemas:httpmail:hasattachment"=1')
                        except Exception:
                            pass
                # v4.1.25 (external audit round 7, blocker #7): PERSISTENT SCAN CURSOR.
                # When a pass ends at a cap, the oldest-reached position is stored and
                # passes ALTERNATE between new mail (top) and backfill continuation
                # (below the cursor), guaranteeing eventual traversal of the whole
                # window no matter how many attachment-bearing messages sit above an
                # old RFQ. The cursor clears when a backfill pass reaches the cutoff.
                _cursors = self.quote_coverage.setdefault("request_scan_cursors", {})
                if not isinstance(_cursors, dict):
                    _cursors = self.quote_coverage["request_scan_cursors"] = {}
                _cur = _cursors.get(folder_label) if isinstance(_cursors.get(folder_label), dict) else {}
                _backfill = bool(_cur.get("backfill_next")) and bool(str(_cur.get("oldest_reached", "") or ""))
                if _backfill:
                    try:
                        # v4.1.27 (round 9, blocker #2): the cursor is MINUTE-precision, so
                        # a strict '<' permanently skipped messages received in the same
                        # minute as the cursor but below the cap. Include the boundary
                        # minute; this scan's durable processed/negative checkpoints
                        # free-skip everything already handled in it, so nothing repeats
                        # and nothing is lost.
                        _b_edge = _cur["oldest_reached"]
                        try:
                            _b_dt = datetime.strptime(_b_edge, "%m/%d/%Y %I:%M %p") + timedelta(minutes=1)
                            _b_edge = _b_dt.strftime("%m/%d/%Y %I:%M %p")
                        except Exception:
                            pass
                        items = items.Restrict(f"[ReceivedTime] < '{_b_edge}'")
                        _cov_debug(f"REQ-ATTACH cursor: backfill pass below {_b_edge!r} (boundary-inclusive) in {folder_label!r}")
                    except Exception:
                        _backfill = False
                try:
                    items.Sort("[ReceivedTime]", True)
                except Exception:
                    pass
                _hit_cap = False
                _last_recv = None
                # STARVATION FIX part 2: 'checked' now counts only ELIGIBLE candidates
                # (attachment-bearing, not yet processed), so 80 routine emails can no
                # longer hide an older customer RFQ beneath them. 'walked' hard-caps the
                # raw COM traffic in case the DASL restriction was rejected.
                checked = 0
                walked = 0
                raw_walked = 0
                _skip_ct = 0    # v4.1.30: checkpointed free-skips (navigation, not work)
                # v4.1.22 (external audit round 4, finding #15): advance-first
                # GetFirst/GetNext iteration -- direct Python enumeration does not
                # reliably honor Items.Sort() on all stores. The cursor advances BEFORE
                # the body runs, so every 'continue' below remains safe.
                try:
                    _nav_msg = items.GetFirst()
                except Exception:
                    _nav_msg = None
                while _nav_msg is not None:
                    msg = _nav_msg
                    try:
                        _nav_msg = items.GetNext()
                    except Exception:
                        _nav_msg = None
                    # v4.1.23 (external audit round 5, finding #10): already-checkpointed
                    # messages (processed or negative) no longer consume the walk budget --
                    # otherwise 1,000 routine attachment emails permanently hid the RFQ
                    # beneath them on EVERY pass. raw_walked is the ultimate COM-traffic
                    # safety cap; 'walked' counts only NOVEL examinations.
                    # v4.1.30 (external audit round 12, finding #4): TWO-BUDGET model, same
                    # as the vendor-quote scan. Checkpointed free-skips no longer consume
                    # the 5000 examination budget -- 5000 already-processed same-minute
                    # messages could otherwise permanently hide the unprocessed request
                    # beneath them (every pass re-navigated the same checkpoints and hit
                    # the raw cap before reaching it). Skips are cheap navigations, bounded
                    # separately at 30000; real examinations stay bounded at 5000.
                    raw_walked += 1
                    if checked >= max_items or new_processed >= max_new or walked >= 1000 \
                            or (raw_walked - _skip_ct) >= 5000 or raw_walked >= 30000:
                        _hit_cap = True  # v4.1.25: remember we stopped at a cap, not the cutoff
                        break
                    try:
                        try:
                            recv_dt = msg.ReceivedTime.replace(tzinfo=None)
                        except Exception:
                            recv_dt = None
                        if recv_dt is not None and recv_dt < cutoff:
                            break
                        if recv_dt is not None:
                            _last_recv = recv_dt
                        try:
                            entry_id = str(msg.EntryID or "")
                        except Exception:
                            entry_id = ""
                        if not entry_id or entry_id in processed or entry_id in seen_ids:
                            if entry_id and entry_id in processed:
                                _skip_ct += 1   # v4.1.30: checkpointed navigation, not work
                            continue
                        if int(negative.get(entry_id, -1)) == COVERAGE_REQUEST_GATE_VERSION:
                            _skip_ct += 1       # v4.1.30: checkpointed navigation, not work
                            continue  # v4.1.22: examined before, not a request -- free skip
                        # v4.1.54: Sales-Inbox messages must carry the selected sales
                        # category before ANY ingestion work. Counted as a cheap skip
                        # (one COM property read), NOT checkpointed (tags are mutable),
                        # and placed before the walk budget so colleague-tagged mail
                        # cannot starve this user's request scan.
                        if _sales_cat_gate:
                            try:
                                _msg_cats = msg.Categories or ""
                            except Exception:
                                _msg_cats = ""
                            if not self.email_has_outlook_category(_msg_cats, self.selected_sales_category):
                                _skip_ct += 1
                                continue
                        walked += 1
                        seen_ids.add(entry_id)
                        # Cheap gate 1 (v4.2.56 RELAXED): attachment-bearing messages always
                        # qualify, as before. A NO-attachment message now stays eligible when
                        # its SUBJECT is request-shaped -- Phase 1's typed-into-the-body
                        # intake (v4.2.54/55) sat behind the old bare 'continue' here, which
                        # is why Steve's live gmail test ('urgent quote', 0 attachments) was
                        # never examined and left ZERO store traces. Non-quoteish
                        # no-attachment mail is version-checkpointed (one navigation per
                        # gate version, no Body read) so the walk stays cheap.
                        try:
                            _att_ct = int(getattr(msg.Attachments, "Count", 0) or 0)
                        except Exception:
                            _att_ct = 0
                        if _att_ct <= 0:
                            try:
                                _subjq = bool(re.search(
                                    r"\brfq\b|\bp\s*&\s*a\b|quot|pric|estimate|bid\b|material",
                                    str(getattr(msg, "Subject", "") or "").lower()))
                            except Exception:
                                _subjq = False
                            if not _subjq:
                                # v4.2.59: bland subject ('request') -- probe the BODY for
                                # a request phrase before checkpointing. One Body read per
                                # NOVEL message ever (version-checkpointed after), which is
                                # the defense when a store rejects the body DASL clause.
                                _bodyq = False
                                try:
                                    _probe = str(msg.Body or "")[:4000].lower()
                                    _bodyq = bool(re.search(
                                        r"price and availability|pricing and availability|please quote|"
                                        r"can you quote|need pricing|need a quote|request for quote|quote request|"
                                        r"we need the following|can you deliver|do this delivery|can you supply",
                                        _probe))
                                except Exception:
                                    _bodyq = False
                                if not _bodyq:
                                    negative[entry_id] = COVERAGE_REQUEST_GATE_VERSION
                                    dirty = True
                                    _skip_ct += 1
                                    continue
                        # v4.1.19 AUDIT FIX (finding #13): EntryIDs change on move/copy/
                        # restore/another profile, so key the processed ledger by the durable
                        # RFC-5322 Message-ID when available (EntryID kept as fallback and
                        # for back-compat with entries recorded by v4.1.18).
                        _imid_key = ""
                        try:
                            _pa = msg.PropertyAccessor
                            try:
                                _imid_raw = str(_pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
                            except Exception:
                                _imid_raw = str(_pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001E") or "")
                            _imid_norm = re.sub(r"\s+", "", _imid_raw).strip().lower()
                            if _imid_norm:
                                _imid_key = "imid:" + _imid_norm
                        except Exception:
                            _imid_key = ""
                        if _imid_key and _imid_key in processed:
                            # Same message already handled (possibly under an older EntryID).
                            processed_list.append(entry_id)
                            processed.add(entry_id)
                            dirty = True
                            continue

                        def _mark_done(_eid=entry_id, _ik=_imid_key):
                            processed_list.append(_eid)
                            processed.add(_eid)
                            if _ik:
                                processed_list.append(_ik)
                                processed.add(_ik)
                        try:
                            subj = msg.Subject or ""
                        except Exception:
                            subj = ""
                        try:
                            body = (msg.Body or "")[:6000]
                        except Exception:
                            body = ""
                        # v4.1.20 (external audit round 2, finding #3): request detection must
                        # read the NEWLY WRITTEN text. For a REPLY in a thread, the quoted
                        # history below the fresh text contains the customer's ORIGINAL
                        # "please quote the attached list" -- which let an unknown vendor's
                        # "see attached" answer qualify as a customer request. Replies now
                        # qualify only on their fresh text; an original (non-reply) message
                        # can still qualify by its subject (RFQ / P&A ...).
                        try:
                            _fresh = _strip_reply_boilerplate_for_intent(body)
                        except Exception:
                            _fresh = body
                        _is_reply = bool(re.match(r"\s*(?:re|fw|fwd)\s*:", subj, flags=re.I))
                        low = (_fresh if _is_reply else (subj + "\n" + _fresh)).lower()
                        # v4.1.21 (external audit round 3, finding #9): resolve the sender's
                        # relationship type BEFORE the request gate, so a KNOWN CUSTOMER's
                        # attachment-only reply ("Attached.") in a quote thread can qualify.
                        sender_email = ""
                        sender_name = ""
                        try:
                            sender_email = self.get_sender_email(msg) or ""
                        except Exception:
                            sender_email = ""
                        try:
                            sender_name = str(getattr(msg, "SenderName", "") or "")
                        except Exception:
                            sender_name = ""
                        # Gate 3: relationship type. Vendors' priced replies belong to the
                        # quote scan; marketing/internal mail never creates requested items.
                        row = self.get_email_by_id(entry_id) or {}
                        _dtype = self._durable_email_type_for_email(
                            {"entry_id": entry_id, "email_type": (row or {}).get("email_type", "")})
                        if not _dtype:
                            # v4.1.19 AUDIT FIX (finding #3): no saved row yet -- fall back to
                            # the user's own SENDER-LEVEL teaching so a known vendor's "please
                            # see attached quote" can never be mistaken for a customer request.
                            try:
                                _lh, _ls = self.get_learning_hint_for_email(
                                    {"sender_email": sender_email, "sender": sender_name, "subject": subj})
                                if _lh and _ls in ("sender", "domain"):
                                    _dtype = normalize_email_type_code(_lh.get("email_type", ""))
                            except Exception:
                                pass
                        if not _dtype and sender_email:
                            # v4.1.20 (finding #4): same-domain senders are INTERNAL even
                            # before any learning exists -- your own replies in the shared
                            # Sales inbox must never seed customer-requested items.
                            try:
                                _own = self._own_mailbox_domains(namespace)
                                _sd = str(get_email_domain(sender_email) or "").lower()
                                if _own and _sd and _sd in _own:
                                    _dtype = "E"
                            except Exception:
                                pass
                        if _dtype in ("V", "M", "E"):
                            _cov_debug(f"REQ-ATTACH skip {subj!r}: sender type {_dtype}")
                            _mark_done()
                            dirty = True
                            continue
                        # v4.2.68 (John DeRosa 8/21): a FORWARD from a KNOWN CUSTOMER
                        # carries its request in the FORWARDED section -- his fresh text
                        # was just "Can you guys do this delivery for me TUESDAY 6AM?"
                        # while the material list sat below the embedded From:. The
                        # fresh-text-only rule (v4.1.20) exists for RE: quoted-history
                        # noise; for a customer FW the forwarded content IS the payload,
                        # so intent detection reads the full body. Gated on durable type
                        # C so an unknown vendor's forwarded chain still cannot qualify.
                        _is_forward = bool(re.match(r"\s*(?:fw|fwd)\s*:", subj, flags=re.I))
                        if _is_forward and _dtype == "C":
                            low = (subj + "\n" + body).lower()
                        # v4.1.38 PO-AWARD DETECTION. A customer PURCHASE ORDER often
                        # arrives as a PDF -- sometimes on the RFQ thread ("here is the
                        # PO"), sometimes forwarded in a DIFFERENT chain. Before the
                        # request gate (a PO is not a request, so it would otherwise be
                        # checkpointed negative and lost), ask the PO-match engine whether
                        # this attachment-bearing customer/unknown message is a PO for an
                        # open job. A confident match is QUEUED for the main-thread popup;
                        # detection never mutates coverage here on the worker thread.
                        try:
                            if self._po_award_enabled():
                                _po_store_id = ""
                                try:
                                    _po_store_id = str(getattr(getattr(msg, "Parent", None), "StoreID", "") or "")
                                except Exception:
                                    _po_store_id = ""
                                _po_queued = self._detect_and_queue_customer_po(
                                    msg=msg, entry_id=entry_id, store_id=_po_store_id,
                                    subject=subj, body=body, fresh_text=_fresh,
                                    sender_email=sender_email, sender_name=sender_name,
                                    durable_type=_dtype, namespace=namespace,
                                    imid_key=_imid_key)
                                if _po_queued == "retry":
                                    # v4.1.39a: PO attachment could not be read this pass.
                                    # Do NOT mark done and do NOT negative-checkpoint --
                                    # leave the message unprocessed so a later scan (when
                                    # the attachment/OCR is available) can re-examine it.
                                    _cov_debug(f"REQ-ATTACH {subj!r}: PO attachment unreadable -- leaving for retry")
                                    continue
                                if _po_queued:
                                    # This message is a recognized PO -- do not also try to
                                    # mine it for requested items. Mark done so it is not
                                    # re-examined; the popup handles the coverage action.
                                    _cov_debug(f"REQ-ATTACH {subj!r}: recognized as a customer PO, queued for review")
                                    _mark_done()
                                    dirty = True
                                    continue
                        except Exception as _po_exc:
                            _cov_debug(f"REQ-ATTACH PO detection error on {subj!r}: {_po_exc!r}")
                        # v4.2.87 (Steve, Danny/campbellanddawes): the customer RETURNED
                        # OUR OWN BID DOCUMENT -- Danny writes "$OK" on the ERP bid PDF
                        # and sends it back through Acrobat, so the body is pure Adobe
                        # boilerplate and no wording detector can ever see the go-ahead.
                        # The attachment FILENAME is the signal: an S-numbered document
                        # (S100101819-0001.pdf) is our paperwork; a customer does not
