def _clone_required_sync_default(path, fallback=None):
    if path in DB_SYNC_REQUIRED_DEFAULTS:
        try:
            return json.loads(json.dumps(DB_SYNC_REQUIRED_DEFAULTS[path]))
        except Exception:
            return DB_SYNC_REQUIRED_DEFAULTS[path]
    return fallback


def _ensure_required_sync_file(path, fallback=None):
    """Create critical sync JSON + SQLite mirror records when they are missing.

    This is intentionally narrow: only files listed in DB_SYNC_REQUIRED_DEFAULTS
    are auto-created. Existing data is never overwritten.
    """
    if path not in DB_SYNC_REQUIRED_DEFAULTS:
        return fallback
    data = _clone_required_sync_default(path, fallback)
    try:
        save_json(path, data)
    except Exception:
        traceback.print_exc()
    return data

