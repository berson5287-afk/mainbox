    def get_customer_hint_for_group(self, group, emails):
        """v4.2.54 Phase 1: the customer is the earliest EXTERNAL sender of the
        group's INBOUND mail (email address preferred) -- never a vendor we
        happened to send to (the wire-quote ledger stored brian@bandbelec.com,
        the VENDOR, as 'customer', which mis-anchored the replied-RFQ sweep).
        When the request reached us via an INTERNAL forward, the embedded
        'From: Name <addr>' in the forward header identifies the real customer."""
        internal = set()
        try:
            internal = {str(d).strip().lower() for d in (configured_internal_domains() or []) if d}
        except Exception:
            internal = set()
        internal.add("americanpoweresc.com")
        _free = ("gmail.com", "outlook.com", "yahoo.com", "hotmail.com")

        def _external(dom):
            return bool(dom) and dom not in internal and not any(f in dom for f in _free)

        try:
            inbound = [e for e in (emails or []) if isinstance(e, dict)
                       and not e.get("is_sent_waiting_placeholder")
                       and not str(e.get("source", "")).lower().startswith("sent")]
            inbound.sort(key=lambda e: float(e.get("received_timestamp", 0) or 0))
            for email in inbound:
                addr = extract_email_address(email.get("sender_email") or email.get("sender") or "")
                dom = get_email_domain(addr)
                if _external(dom):
                    return addr or dom
                if dom and dom in internal:
                    m = re.search(r"^From:\s*(?:\"?[^\"<\r\n]*\"?\s*)?<?([^>\s\r\n]+@[^>\s\r\n]+)>?",
                                  str(email.get("body", "") or ""), re.M | re.I)
                    if m:
                        fwd_addr = m.group(1).strip().lower().rstrip(">")
                        if _external(get_email_domain(fwd_addr)):
                            return fwd_addr
        except Exception:
            pass
        # Legacy fallback: first non-freemail display-name domain, else group name.
        text = (group.get("name", "") if group else "")
        for email in emails or []:
            sender = email.get("sender", "") or ""
            domain = get_email_domain(sender)
            if domain and not any(x in domain for x in _free):
                return domain
        return text.strip().lower()[:80]

    def extract_attachment_text_for_email(self, email, saved_file_callback=None,
                                          skip_inline_images=False, seen_inline_keys=None):
        """Save Outlook attachments to a temp folder, extract text/OCR, and return text + debug details.

        saved_file_callback(path, filename) may be supplied by Quote Intelligence. It runs
        while the temp attachment still exists, so structured extraction can reuse the same
        saved file instead of re-downloading from Outlook or trying to access the temp folder
        after cleanup.

        v2.8.1 fix: this method can run safely inside the background Quote Intelligence
        thread because it initializes COM before touching Outlook objects. It also logs
        attachment count and filenames so the user can see exactly what happened.
        """
        did_com = outlook_thread_init()
        extracted = []
        details = []
        temp_root = ""
        # v3.9.92: serialize this Outlook attachment read against the background quote-coverage
        # scan. Both call att.SaveAsFile on the SAME Outlook profile; running them at the same
        # time disconnects the attachment COM objects (RPC_E_DISCONNECTED / 0x80010108 -- a NATIVE
        # fault Python's try/except cannot catch, which crashed the app when the RFQ extractor ran
        # during a scan). The scan acquires this same lock non-blocking and simply skips its pass
        # while we hold it, so there is no deadlock; no attachment-read path runs under
        # run_outlook_worker, so there is no reentrancy. Generous timeout, then proceed degraded
        # rather than hang if a pass somehow runs long.
        _olock = getattr(self, "_outlook_worker_lock", None)
        _olock_held = False
        if _olock is not None:
            try:
                _olock_held = bool(_olock.acquire(timeout=180))
                if not _olock_held:
                    details.append("note: proceeded without the Outlook serialization lock (busy > 180s)")
            except Exception:
                _olock_held = False
        try:
            msg = self.get_message_object(email)
            if not msg:
                details.append(f"{email.get('subject','Email')}: could not reopen Outlook message for attachment scan")
                return "", details
            try:
                atts = msg.Attachments
                count = int(atts.Count or 0)
            except Exception as exc:
                details.append(f"{email.get('subject','Email')}: could not read Outlook Attachments collection ({exc})")
                return "", details
            if count <= 0:
                details.append(f"{email.get('subject','Email')}: no Outlook attachments found")
                return "", details
            details.append(f"{email.get('subject','Email')}: Outlook reports {count} attachment(s)")
            temp_root = tempfile.mkdtemp(prefix="mainbox_qie_")
            for i in range(1, min(count, 15) + 1):
                try:
                    att = atts.Item(i)
                    raw_name = getattr(att, "FileName", "") or f"attachment_{i}"
                    fname = safe_filename_piece(raw_name, f"attachment_{i}")
                    try:
                        size = int(getattr(att, "Size", 0) or 0)
                    except Exception:
                        size = 0
                    ext_lower = os.path.splitext(fname)[1].lower()
                    # v2.10.41: In AI Only / vision mode, never skip image attachments as inline —
                    # they may be real scanned RFQ images. Only apply inline-skip in text/OCR modes.
                    ai_only_active = RFQ_PARSER_MODE in ["ai_only", "0", "false", "no", "off", "none"]
                    is_vision_image = ext_lower in (".png", ".jpg", ".jpeg", ".webp", ".bmp")
                    is_inline = outlook_attachment_is_inline(att)

                    # v2.10.33: Rescue inline body images that are large enough to be real
                    # content (>8 KB rules out 1x1 tracking pixels, small logos, dividers).
                    # Save them and pass through saved_file_callback so SmartScan's vision
                    # path can scan them — e.g. a photo of a quote pasted into the email body.
                    if is_inline and is_vision_image and saved_file_callback:
                        try:
                            inline_size = int(getattr(att, "Size", 0) or 0)
                        except Exception:
                            inline_size = 0
                        # v4.2.22: do not save inline images we already know we will not use.
                        # Reported: one plain body RFQ saved 17 files and queued 14 inline
                        # images for SmartScan review, then concluded "No real Outlook document
                        # attachments" and skipped the review window -- every one of those saves
                        # was thrown away. The 8 KB gate below was meant to rule out tracking
                        # pixels and dividers, but a signature block runs 8-30 KB so all five
                        # pass on every email, every time.
                        if skip_inline_images:
                            details.append(
                                f"{fname}: inline body image skipped -- the email body already "
                                f"parsed cleanly, so no vision pass is needed ({inline_size} bytes)")
                            continue
                        # v4.2.22: and never save the SAME image twice in one run. A thread of
                        # three replies re-sends the identical signature block each time, which
                        # is how 14 saves happened for 5 distinct images.
                        if isinstance(seen_inline_keys, set):
                            _key = (fname.lower(), inline_size)
                            if _key in seen_inline_keys:
                                details.append(
                                    f"{fname}: identical inline image already saved earlier in "
                                    f"this run ({inline_size} bytes) -- not saved again")
                                continue
                            seen_inline_keys.add(_key)
                        if inline_size >= 8192:
                            inline_fname = f"inline_body_image_{i}{ext_lower}"
                            inline_path = os.path.join(temp_root, inline_fname)
                            try:
                                att.SaveAsFile(inline_path)
                                if os.path.exists(inline_path):
                                    details.append(f"{fname}: rescued as inline body image ({inline_size} bytes) → SmartScan vision path")
                                    try:
                                        saved_file_callback(inline_path, inline_fname)
                                    except Exception as cb_exc:
                                        details.append(f"{inline_fname}: inline image SmartScan callback failed ({cb_exc})")
                                else:
                                    details.append(f"{fname}: inline image save failed — Outlook did not write file")
                            except Exception as inline_exc:
                                details.append(f"{fname}: inline image rescue failed ({inline_exc})")
                            continue
                        else:
                            details.append(f"{fname}: skipped inline image (too small at {inline_size} bytes — likely logo/signature/tracker)")
                            continue

                    if is_inline and not (ai_only_active and is_vision_image):
                        details.append(f"{fname}: skipped inline/signature image")
                        continue
                    if ext_lower in (".pdf", ".xlsx", ".xls", ".csv", ".doc", ".docx", ".txt", ".rtf", ".png", ".jpg", ".jpeg", ".webp", ".bmp"):
                        details.append(f"{fname}: accepted as real RFQ/document attachment; saving original Outlook file")
                    path = os.path.join(temp_root, fname)
                    att.SaveAsFile(path)
                    if RFQ_DEBUG_ATTACHMENTS and os.path.exists(path):
                        try:
                            os.makedirs(RFQ_DEBUG_DIR, exist_ok=True)
                            debug_copy = os.path.join(RFQ_DEBUG_DIR, fname)
                            shutil.copy2(path, debug_copy)
                            details.append(f"{fname}: DEBUG proof copy of original Outlook attachment saved to {debug_copy}")
                        except Exception as dbg_exc:
                            details.append(f"{fname}: DEBUG proof copy failed ({dbg_exc})")
                    if not os.path.exists(path):
                        details.append(f"{fname}: Outlook did not save file")
                        continue
                    details.append(f"{fname}: saved original Outlook attachment to temp file ({size} bytes)")
                    if saved_file_callback:
                        try:
                            saved_file_callback(path, fname)
                        except Exception as cb_exc:
                            details.append(f"{fname}: structured extraction callback failed ({cb_exc})")
                    text = read_text_from_file_best_effort(path)
                    if text and text.strip():
                        extracted.append(f"\n--- Attachment: {fname} ---\n{text[:18000]}")
                        details.append(f"{fname}: saved {size} bytes, extracted {len(text)} chars")
                    else:
                        ext = os.path.splitext(fname)[1].lower() or "unknown type"
                        details.append(f"{fname}: saved {size} bytes, no text extracted from {ext}; install OCR extras/Tesseract; for .xls/.doc files install Microsoft Office or pandas engines")
                except Exception as exc:
                    details.append(f"Attachment {i}: extraction failed ({exc})")
        finally:
            try:
                if temp_root:
                    shutil.rmtree(temp_root, ignore_errors=True)
            except Exception:
                pass
            outlook_thread_uninit(did_com)
            if _olock_held:
                try:
                    _olock.release()
                except Exception:
                    pass
        return "\n".join(extracted), details

    def load_body_for_rfq(self, email):
        """Always try to read the current Outlook body for RFQ extraction.

        The normal preview cache may intentionally store body_loaded=True even if Outlook
        was unavailable at that moment. Quote RFQ should not trust that empty cache.
        """
        cached = str(email.get("body", "") or "")
        if cached.strip():
            return cached
        msg = None
        try:
            msg = self.get_message_object(email)
        except Exception:
            msg = None
        if msg:
            try:
                body = str(getattr(msg, "Body", "") or "")
                if body.strip():
                    email["body"] = body
                    email["body_loaded"] = True
                    try:
                        self.save_cached_state()
                    except Exception:
                        pass
                    return body
            except Exception:
                pass
            try:
                html_body = str(getattr(msg, "HTMLBody", "") or "")
                if html_body.strip():
                    body = re.sub(r"(?i)<br\s*/?>", "\n", html_body)
                    body = re.sub(r"(?i)</p\s*>", "\n", body)
                    body = re.sub(r"<[^>]+>", " ", body)
                    body = re.sub(r"&nbsp;", " ", body)
                    body = re.sub(r"&amp;", "&", body)
                    body = re.sub(r"&quot;", "\"", body)
                    body = re.sub(r"&#39;", "'", body)
                    body = re.sub(r"\s+", " ", body)
                    email["body"] = body
                    email["body_loaded"] = True
                    try:
                        self.save_cached_state()
                    except Exception:
                        pass
                    return body
            except Exception:
                pass
        return cached

    def collect_quote_text_for_group(self, group_id):
        emails = self.get_emails_for_group(group_id)
        parts = []
        ocr_details = []
        for email in sorted(emails, key=lambda e: e.get("received_timestamp", 0), reverse=True)[:12]:
            try:
                body = self.load_body_for_rfq(email)
            except Exception:
                body = email.get("body", "") or ""
            parts.append(f"\n--- Email ---\nFrom: {email.get('sender','')}\nSubject: {email.get('subject','')}\nBody:\n{body[:8000]}")
            att_text, details = self.extract_attachment_text_for_email(email)
            if att_text:
                parts.append(att_text)
            ocr_details.extend(details)
        return "\n".join(parts), ocr_details

    def _deselect_letterhead_rows(self, materials, where=""):
        """v4.2.0: mark letterhead/contact rows UNCHECKED instead of dropping them.

        FINDING E. `_looks_like_contact_or_letterhead` had exactly ONE call site --
        inside `update_coverage_requested` (v4.1.96) -- and that block ends `mats =
        _kept`, which rebinds a LOCAL. The caller's list is never mutated, so the
        `materials` handed to the RFQ window kept every letterhead row. v4.1.96
        therefore protected the coverage LEDGER but not the RFQ the vendor receives,
        which is the CM31026 complaint shape ("all it extracted was 2 lines which
        were the address"). Measured over 4,977 real customer attachments: 8.8% of
        files emit at least one such row -- including our OWN
        'Ramland Road, Orangeburg, NY 10962' and '228-3772 Phone 718-731-8300'.

        DESELECT, NOT DROP -- deliberately. The detector is pattern-based, and
        pattern matchers are wrong sometimes; dropping would silently delete a real
        line item from a vendor RFQ. The RFQ window is human-reviewed before
        sending, so an unchecked row costs one glance when the filter is wrong and
        nothing when it is right. Rows already carrying selected=False are left
        alone, and a row is never re-checked here.

        Returns the number of rows deselected. Never raises: on any failure the
        list is returned exactly as it arrived (fail-safe = current behaviour).
        """
        n = 0
        try:
            for m in (materials or []):
                try:
                    if not isinstance(m, dict):
                        continue
                    if m.get("selected", True) is False:
                        continue
                    desc = str(m.get("description", "") or "")
                    if desc and self._looks_like_contact_or_letterhead(desc):
                        m["selected"] = False
                        m["notes"] = (str(m.get("notes", "") or "")
                                      + "; looks like letterhead/contact - unchecked by MaINbox").strip("; ").strip()
                        n += 1
                except Exception:
                    continue
            if n:
                try:
                    ops_log("coverage", "letterhead_rows_deselected", n=n,
                            total=len(materials or []), where=str(where)[:40])
                except Exception:
                    pass
        except Exception:
            return 0
        return n

    def extract_materials_for_group(self, group_id, progress_callback=None):
        """v4.2.0 wrapper -- see _deselect_letterhead_rows (FINDING E).

        The original body is preserved byte-identical as
        `extract_materials_for_group_inner`. This wrapper only marks letterhead rows
        unchecked on the way out, so the RFQ window, `record_rfq_cache` and vendor
        suggestion all see the same reviewed set. Placed here rather than in
        `normalize_material_items` (20+ callers) or inside the 2,463-line
        `open_quote_intelligence_window`.
        """
        result = self.extract_materials_for_group_inner(group_id, progress_callback=progress_callback)
        try:
            self._deselect_letterhead_rows(result[0], where="extract_materials_for_group")
        except Exception:
            pass
        return result

    def extract_materials_for_group_inner(self, group_id, progress_callback=None):
        r"""STRICT vision-only RFQ extraction build.

        v2.8.4K is intentionally diagnostic and routes each real Outlook attachment by type. PDFs now use fast text-first extraction before slower vision fallback:
        - Creates %TEMP%\MaINbox_RFQ_Debug immediately at app startup.
        - Saves the original Outlook attachments through the existing SaveAsFile path.
        - Copies each saved attachment into the debug folder as proof.
        - For PDFs, first sends selectable PDF/table text to llama3.2:3b; only if weak/empty, renders limited pages to llama3.2-vision.
        - Sends XLSX/CSV/TXT/DOC-readable attachment text/table content to the normal text Llama model.
        - DOES NOT fall back to the old regex extractor when strict mode is on.

        This prevents the old EMT/PVC fallback result from hiding the real failure.
        """
        group = self.get_group_by_id(group_id)
        emails = self.get_emails_for_group(group_id)
        subject = group.get("name", "Quote Group") if group else "Quote Group"
        sender = emails[0].get("sender", "") if emails else ""
        detected_item_count = _rfq_expected_item_count_from_text("\n".join([subject] + [str(e.get("subject", "") or "") for e in emails]))
        try:
            configured_item_hint = int(getattr(self, "settings", {}).get("rfq_expected_item_count_hint", RFQ_EXPECTED_ITEM_COUNT_HINT))
        except Exception:
            configured_item_hint = RFQ_EXPECTED_ITEM_COUNT_HINT
        expected_item_count = detected_item_count or configured_item_hint

        parts = []
        ocr_details = []

        def log(message):
            try:
                msg = str(message)
            except Exception:
                msg = repr(message)
            # IMPORTANT: do not call log() from inside log(); that caused
            # "maximum recursion depth exceeded" immediately when RFQ scanning started.
            # Keep a local details trail and send the same message to the progress popup.
            try:
                ocr_details.append(msg)
            except Exception:
                pass
            if progress_callback:
                try:
                    progress_callback(msg)
                except Exception:
                    pass

        def log_many(messages):
            """Log a list/tuple of extraction status messages without breaking RFQ routing.

            v2.10.54: SmartScan was actually being called, but the RFQ route then
            called log_many() before this helper existed in this scope. That raised
            NameError and made MaINbox discard SmartScan's rows and fall back to the
            built-in extractor. Keep this helper local so both SmartScan and fallback
            status details use the same progress popup/detail trail.
            """
            if not messages:
                return
            if isinstance(messages, (str, bytes)):
                log(messages)
                return
            try:
                iterator = list(messages)
            except Exception:
                iterator = [messages]
            for item in iterator:
                log(item)

        def on_vision_page_result(src_name, page_number, page_rows, preview_path=""):
            """Send completed page rows to the UI/progress handler as soon as one page is done.

            The final cached result is still saved at the end.  When the RFQ window is already
            open, this event lets it append page results while later pages continue scanning.
            """
            try:
                clean_rows = normalize_material_items(page_rows or [])
                if not clean_rows:
                    return
                evt = {
                    "type": "rfq_page_result",
                    "group_id": group_id,
                    "source_name": src_name,
                    "page_number": page_number,
                    "preview_path": preview_path,
                    "rows": clean_rows,
                }
                if progress_callback:
                    try:
                        progress_callback(evt)
                    except Exception:
                        pass
                log(f"{src_name} page {page_number}: page-ready extraction returned {len(clean_rows)} row(s)")
            except Exception as cb_exc:
                log(f"{src_name} page {page_number}: page-ready UI callback failed ({cb_exc})")

        vision_materials = []
        body_typed_list_handled = False  # v3.9.52: set when a plain typed-list body is parsed line-by-line (skips SmartScan + AI re-parse)
        # v4.2.21: rows the DETERMINISTIC numbered-list parser found in the email BODY.
        # Kept separate from vision_materials on purpose so they can be merged with dedup
        # AFTER the attachments are processed -- the body and an attachment can each carry
        # part of one RFQ, and the old gate let either one silence the other.
        body_numbered_rows = []
        # v4.2.22: (filename, size) of every inline image saved in THIS run, so a thread that
        # re-sends the same signature block on every reply saves it once, not once per email.
        seen_inline_image_keys = set()
        deferred_review_image_paths = []  # v3.9.99: inline/pasted images held back; reviewed only if the body yields 0 rows
        review_cancelled = False  # v4.2.6: user closed the SmartScan review without sending rows back
        saved_attachment_paths = []
        saved_count = 0

        try:
            os.makedirs(RFQ_DEBUG_DIR, exist_ok=True)
            _rfq_debug_write("01_rfq_extraction_started.txt", (
                f"RFQ extraction started: {datetime.now().isoformat()}\n"
                f"Group: {subject}\n"
                f"Emails in group: {len(emails)}\n"
                f"Text model: {RFQ_TEXT_MODEL}\n"
                f"Vision model: {RFQ_VISION_MODEL}\n"
                f"Strict vision only: {RFQ_STRICT_VISION_ONLY}\n"
                f"Max PDF pages: {RFQ_VISION_MAX_PAGES}\n"
                f"Debug folder: {RFQ_DEBUG_DIR}\n"
            ))
        except Exception as exc:
            log(f"RFQ debug folder could not be initialized ({exc})")

        log(f"STRICT RFQ DEBUG MODE: debug folder = {RFQ_DEBUG_DIR}")
        log(f"RFQ extractor models: normal text={RFQ_TEXT_MODEL}, RFQ vision={RFQ_VISION_MODEL}, max_pdf_pages={RFQ_VISION_MAX_PAGES}")
        log(f"Parser-first mode: {RFQ_PARSER_MODE}. SmartScan default: {RFQ_USE_SMARTSCAN_FOR_RFQ}. SmartScan review window: {RFQ_SMARTSCAN_REVIEW_BEFORE_SEND}. Direct PDF tables: {RFQ_DIRECT_TABLE_PARSE}. Direct spreadsheets: True. Slow vision fallback enabled: {RFQ_ENABLE_VISION_FALLBACK}")
        log("Strict mode is ON: old regex fallback is disabled. PDFs use Docling/LiteParse direct table parsing first; spreadsheets use direct cell/table parsing first; llama3.2:3b is only used if needed. Vision is used only for images or if explicitly enabled.")
        if expected_item_count:
            log(f"Expected RFQ item count hint for AI prompt: {expected_item_count}. This is not used as a hard parser limit.")

        def on_saved_attachment(path, fname):
            nonlocal saved_count
            saved_count += 1
            source_name = fname or os.path.basename(str(path or "attachment"))
            review_path = ""
            try:
                size = os.path.getsize(path) if path and os.path.exists(path) else 0
            except Exception:
                size = 0
            log(f"OUTLOOK SAVE PROOF #{saved_count}: {source_name} saved to {path} ({size} bytes)")
            try:
                # Copy the exact saved Outlook attachment into the debug folder so the user can verify it.
                # IMPORTANT for SmartScan review mode: extract_attachment_text_for_email() deletes its
                # temporary Outlook-save folder when it returns.  v2.10.26 queued that temp path and
                # SmartScan opened later with a dead/missing file, which produced 0 lines even when
                # standalone SmartScan worked.  Queue this persistent proof copy instead.
                os.makedirs(RFQ_DEBUG_DIR, exist_ok=True)
                ext = os.path.splitext(source_name)[1] or os.path.splitext(str(path))[1]
                proof_name = _safe_debug_name(f"saved_original_{saved_count}_{os.path.splitext(source_name)[0]}") + ext
                proof_path = os.path.join(RFQ_DEBUG_DIR, proof_name)
                shutil.copy2(path, proof_path)
                review_path = proof_path
                log(f"DEBUG PROOF COPY: {proof_path}")
                try:
                    ext_l = os.path.splitext(source_name)[1].lower()
                    if ext_l in [".xls", ".xlsx", ".xlsm", ".xlsb", ".csv"]:
                        preview_png = create_rfq_spreadsheet_preview_image(path, source_name)
                        if preview_png:
                            log(f"{source_name}: spreadsheet preview image saved for debug: {preview_png}")
                        else:
                            log(f"{source_name}: spreadsheet preview image could not be created; falling back to source text review")
                except Exception as prev_exc:
                    log(f"{source_name}: spreadsheet preview image failed ({prev_exc})")
            except Exception as copy_exc:
                log(f"{source_name}: could not copy saved original into debug folder ({copy_exc})")
                try:
                    if path and os.path.exists(path):
                        # Last-resort persistent copy outside the soon-deleted temp Outlook folder.
                        keep_dir = os.path.join(tempfile.gettempdir(), "MaINbox_SmartScan_Review")
                        os.makedirs(keep_dir, exist_ok=True)
                        ext = os.path.splitext(source_name)[1] or os.path.splitext(str(path))[1]
                        keep_name = _safe_debug_name(f"review_{datetime.now().strftime('%Y%m%d_%H%M%S')}_{saved_count}_{os.path.splitext(source_name)[0]}") + ext
                        review_path = os.path.join(keep_dir, keep_name)
                        shutil.copy2(path, review_path)
                        log(f"SmartScan persistent review copy: {review_path}")
                except Exception as keep_exc:
                    log(f"{source_name}: could not create SmartScan persistent review copy ({keep_exc})")

            try:
                _rfq_debug_write(f"02_saved_attachment_{saved_count}_{source_name}.txt", (
                    f"Original filename: {source_name}\n"
                    f"Saved temp path: {path}\n"
                    f"SmartScan review path: {review_path or path}\n"
                    f"Size bytes: {size}\n"
                    f"Vision model: {RFQ_VISION_MODEL}\n"
                ))
            except Exception:
                pass

            if RFQ_USE_SMARTSCAN_FOR_RFQ and RFQ_SMARTSCAN_REVIEW_BEFORE_SEND:
                try:
                    candidate = review_path if (review_path and os.path.exists(review_path)) else path
                    if candidate and os.path.exists(candidate):
                        saved_attachment_paths.append(candidate)
                        if RFQ_SMARTSCAN_PAGEWISE_PDF and _smartscan_is_multipage_document(candidate):
                            log(f"{source_name}: queued multipage document for SmartScan pagewise pre-scan + merged-list review: {candidate}")
                        else:
                            log(f"{source_name}: queued persistent file for full SmartScan review: {candidate}")
                    else:
                        log(f"{source_name}: SmartScan review could not queue file because no saved copy exists")
                    log(f"{source_name}: queued for full SmartScan review window. Built-in attachment parser skipped for this attachment.")
                    return
                except Exception as queue_exc:
                    log(f"{source_name}: could not queue SmartScan review ({queue_exc}); falling back to headless/built-in route.")

            if RFQ_USE_SMARTSCAN_FOR_RFQ:
                try:
                    srows, smsgs, smerged = smartscan_extract_materials_from_saved_attachment(path, source_name, progress_callback=None)
                    if smsgs:
                        log_many(smsgs)
                    if smerged:
                        try:
                            parts.append(f"\n--- SmartScan Extracted Text: {source_name} ---\n" + smerged[:12000])
                        except Exception:
                            pass
                    if srows:
                        vision_materials.extend(srows)
                        log(f"{source_name}: SMARTSCAN RFQ SUCCESS - added {len(srows)} material row(s). Built-in RFQ extractor skipped for this attachment.")
                        return
                    log(f"{source_name}: SmartScan returned 0 rows; falling back to built-in RFQ extractor.")
                except Exception as smartscan_exc:
                    log(f"{source_name}: SmartScan RFQ route failed ({smartscan_exc}); falling back to built-in RFQ extractor.")
                    try:
                        _rfq_debug_write(f"99_smartscan_exception_{source_name}.txt", traceback.format_exc())
                    except Exception:
                        pass

            try:
                ext_lower = os.path.splitext(source_name)[1].lower()
                # v2.10.40: When parser mode is "off" (AI Only), skip all text/OCR extraction
                # and send the saved attachment file directly to llama3.2-vision as an image.
                # This mirrors the manual workflow (saved file -> vision model) that gives the
                # best accuracy for PDFs and images without any intermediate text conversion.
                ai_only_mode = RFQ_PARSER_MODE in ["ai_only", "0", "false", "no", "off", "none"]
                if ai_only_mode and ext_lower in [".pdf", ".png", ".jpg", ".jpeg", ".webp", ".bmp"]:
                    log(f"{source_name}: AI Only mode — sending saved file directly to vision model {RFQ_VISION_MODEL}")
                    rows, msgs = vision_first_extract_materials_from_saved_attachment(path, source_name, target_count=expected_item_count, page_callback=on_vision_page_result)
                    if msgs:
                        log_many(msgs)
                    route_label = f"direct vision model {RFQ_VISION_MODEL} (AI Only)"
                elif ext_lower == ".pdf":
                    # v2.8.4K: PDF text-first route. Many supplier/Kojo PDFs contain real selectable table text.
                    # This is much faster and usually more complete than rendering every page to llama3.2-vision.
                    rows, msg = ai_first_extract_materials_from_saved_attachment(path, source_name, subject=subject, sender=sender, expected_item_count=expected_item_count)
                    log(msg)
                    route_label = f"PDF text-first model {RFQ_TEXT_MODEL}"
                    current_count = len(rows or [])
                    if (not rows or current_count < int(os.environ.get("MAINBOX_RFQ_MIN_TEXT_ROWS_BEFORE_VISION", "8"))) and RFQ_ENABLE_VISION_FALLBACK:
                        log(f"{source_name}: PDF parser/text-first returned {current_count} row(s); trying optional vision fallback on up to {RFQ_VISION_MAX_PAGES} page(s)")
                        vrows, vmsgs = vision_first_extract_materials_from_saved_attachment(path, source_name, target_count=expected_item_count, page_callback=on_vision_page_result)
                        if vmsgs:
                            log_many(vmsgs)
                        if vrows and len(vrows) > len(rows or []):
                            rows = vrows
                            route_label = f"PDF vision fallback model {RFQ_VISION_MODEL}"
                        elif rows:
                            log(f"{source_name}: keeping PDF parser/text-first result because vision did not improve row count")
                    elif not rows or current_count < int(os.environ.get("MAINBOX_RFQ_MIN_TEXT_ROWS_BEFORE_VISION", "8")):
                        log(f"{source_name}: PDF parser/text-first returned {current_count} row(s); slow vision fallback is OFF. Set MAINBOX_RFQ_ENABLE_VISION_FALLBACK=1 only for scanned/image PDFs.")
                elif ext_lower in [".png", ".jpg", ".jpeg", ".webp", ".bmp"]:
                    rows, msgs = vision_first_extract_materials_from_saved_attachment(path, source_name)
                    if msgs:
                        log_many(msgs)
                    route_label = f"vision model {RFQ_VISION_MODEL}"
                else:
                    rows, msg = ai_first_extract_materials_from_saved_attachment(path, source_name, subject=subject, sender=sender, expected_item_count=expected_item_count)
                    msgs = [msg]
                    log_many(msgs)
                    route_label = f"text model {RFQ_TEXT_MODEL}"

                if rows:
                    vision_materials.extend(rows)
                    log(f"{source_name}: STRICT RFQ AI SUCCESS via {route_label} - added {len(rows)} material row(s)")
                else:
                    log(f"{source_name}: STRICT RFQ AI returned 0 usable rows via {route_label}")
            except Exception as vision_exc:
                log(f"{source_name}: STRICT RFQ AI ERROR ({vision_exc})")
                try:
                    _rfq_debug_write(f"99_rfq_ai_exception_{source_name}.txt", traceback.format_exc())
                except Exception:
                    pass

        for email in sorted(emails, key=lambda e: e.get("received_timestamp", 0), reverse=True)[:12]:
            try:
                body = self.load_body_for_rfq(email)
            except Exception:
                body = email.get("body", "") or ""
            parts.append(f"\n--- Email ---\nFrom: {email.get('sender','')}\nSubject: {email.get('subject','')}\nBody:\n{body[:12000]}")
            try:
                _rfq_debug_write("04_email_body_used_for_rfq.txt", body[:12000])
            except Exception:
                pass
            quick_rows = extract_materials_from_quote_text(body)
            # v3.9.52: a plain typed material list pasted in the email body (every line like
            # "50 ft - 750 AL BRBW X 4 SETS", or "500 mcm - CU black") must be parsed line-by-line,
            # NOT handed to SmartScan's table/column parser below. SmartScan is built for attachment
            # documents and corrupts such lists -- the "X N SETS" multiplier becomes its own phantom
            # row and real footages get dropped (the exact Quote-Coverage corruption seen on the
            # Edenwald RFQ). extract_typed_list_materials_from_body also recovers lines the quick
            # parser's filter drops because it doesn't recognize the unit (e.g. "500 mcm - CU black").
            typed_rows = extract_typed_list_materials_from_body(body)
            list_like_lines = [
                _ll for _ll in (body or "").splitlines()
                # v3.9.58: also count wire-gauge lines that begin with "#4AWG", "#8 AWG", etc.
                # Without the "#\d" alternative these lines were invisible to the typed-list
                # detector, so body_is_clean_typed_list stayed False and the body was handed to
                # BOTH SmartScan and the AI fallback -- each splitting the same line differently,
                # which produced the duplicate/mangled Quote Coverage rows. The >=60% threshold
                # below still guards against prose that merely mentions a "#4" in passing.
                if re.match(r"^\s*(?:[-*\u2022]\s*)?(?:#\s*\d|\d)", _ll)
            ]
            body_is_clean_typed_list = bool(
                len(typed_rows) >= 2
                and len(list_like_lines) >= 2
                and len(typed_rows) >= max(2, int(len(list_like_lines) * 0.6))
            )
            # The body is ALSO fed to SmartScan's structured parser below when it's
            # long enough (the >120 gate). Running both parsers on the same body and
            # keeping both results is what produced duplicate rows (raw quick-parse
            # rows + cleaned SmartScan rows). Only keep the quick-parse rows when
            # SmartScan will NOT take this body; if SmartScan whiffs, the
            # existing_count==0 fallback further below still recovers the body.
            _smartscan_will_take_body = bool(
                RFQ_USE_SMARTSCAN_FOR_RFQ and body and len(body.strip()) > 120
                and not body_is_clean_typed_list
            )
            # v4.2.21: a NUMBERED list with parenthesised quantities is the most common
            # shape in real customer RFQs and the most reliably parseable. Tried FIRST,
            # because on the reported "hubbell raco" body (35 such lines) the two existing
            # parsers returned 1 row (a signature street address) and 0 rows respectively,
            # so the body fell through to the text model -- minutes, for one wrong row.
            numbered_rows = extract_numbered_qty_list_from_body(body)
            qty_last_rows = extract_qty_last_list_from_body(body)  # v4.2.47
            if len(numbered_rows) >= 2:
                body_numbered_rows.extend(numbered_rows)
                body_typed_list_handled = True
                log(f"Email body: numbered material list detected -- parsed "
                    f"{len(numbered_rows)} row(s) directly, no AI needed. SmartScan table "
                    f"parser bypassed for this body.")
            elif len(qty_last_rows) >= 2:
                # v4.2.47: qty-LAST footage lists ("#4/0 AWG GREEN - 2,000'") --
                # the Wire Quote JFK shape every qty-first parser whiffed on.
                body_numbered_rows.extend(qty_last_rows)
                body_typed_list_handled = True
                log(f"Email body: qty-last footage list detected -- parsed "
                    f"{len(qty_last_rows)} row(s) directly, no AI needed. SmartScan table "
                    f"parser bypassed for this body.")
            elif body_is_clean_typed_list:
                vision_materials.extend(typed_rows)
                body_typed_list_handled = True
                log(f"Email body: plain typed material list detected -- parsed {len(typed_rows)} "
                    f"row(s) line-by-line; SmartScan table parser bypassed for this body "
                    f"(prevents 'X N SETS' phantom rows in Quote Coverage)")
            elif quick_rows and not _smartscan_will_take_body:
                vision_materials.extend(quick_rows)
                log(f"Email body: simple typed-list parser found {len(quick_rows)} material row(s)")
            elif quick_rows:
                log(f"Email body: {len(quick_rows)} quick-parse row(s) deferred to SmartScan "
                    f"structured parser (single source, avoids duplicate rows)")
            log(f"Processing email: {email.get('subject','')} from {email.get('sender','')}")

            # v2.10.33: Feed the email body through SmartScan as a .txt file so its
            # structured parser (not just the end-of-pipeline LLM fallback) can find
            # typed material lists pasted directly into the email body.
            # Only do this when SmartScan is active and the body has meaningful content
            # (>120 chars after stripping whitespace — rules out empty/signature-only bodies).
            body_clean = body.strip() if body else ""
            if RFQ_USE_SMARTSCAN_FOR_RFQ and body_clean and len(body_clean) > 120 and not body_is_clean_typed_list:
                body_txt_fd = None
                body_txt_path = ""
                try:
                    body_txt_fd, body_txt_path = tempfile.mkstemp(
                        prefix="mainbox_rfq_body_",
                        suffix=".txt"
                    )
                    with os.fdopen(body_txt_fd, "w", encoding="utf-8", errors="ignore") as bfh:
                        bfh.write(f"Subject: {email.get('subject', '')}\n")
                        bfh.write(f"From: {email.get('sender', '')}\n\n")
                        bfh.write(body_clean[:20000])
                    body_txt_fd = None  # closed by fdopen context manager
                    body_fname = f"email_body_{safe_filename_piece(email.get('subject', 'email'), 'email')[:40]}.txt"
                    log(f"Email body: saved as temp .txt for SmartScan structured parser ({len(body_clean)} chars)")
                    try:
                        on_saved_attachment(body_txt_path, body_fname)
                    except Exception as body_cb_exc:
                        log(f"Email body SmartScan callback failed ({body_cb_exc})")
                except Exception as body_txt_exc:
                    log(f"Email body .txt save for SmartScan failed ({body_txt_exc})")
                finally:
                    try:
                        if body_txt_path and os.path.exists(body_txt_path):
                            os.remove(body_txt_path)
                    except Exception:
                        pass

            try:
                # v4.2.22: if the deterministic numbered-list parser already read this body,
                # its inline images are signature art, not the RFQ -- skip saving them. The
                # photo-of-an-RFQ workflow is untouched, because in that case the body has no
                # numbered list, numbered_rows is empty, and the images are still saved.
                _skip_inline = bool(numbered_rows and len(numbered_rows) >= 2)
                att_text, details = self.extract_attachment_text_for_email(
                    email, saved_file_callback=on_saved_attachment,
                    skip_inline_images=_skip_inline, seen_inline_keys=seen_inline_image_keys)
                # Keep the text only for user/debug visibility, not for fallback extraction in strict mode.
                if att_text:
                    parts.append(att_text[:12000])
                if details:
                    log_many(details)
            except Exception as exc:
                log(f"Attachment save/extract path failed for email ({exc})")
                try:
                    _rfq_debug_write("99_attachment_save_exception.txt", traceback.format_exc())
                except Exception:
                    pass

        if RFQ_USE_SMARTSCAN_FOR_RFQ and RFQ_SMARTSCAN_REVIEW_BEFORE_SEND and saved_attachment_paths:
            try:
                unique_paths = []
                seen_paths = set()
                for sp in saved_attachment_paths:
                    key = os.path.abspath(str(sp))
                    if key not in seen_paths and os.path.exists(key):
                        unique_paths.append(sp)
                        seen_paths.add(key)
                if not unique_paths:
                    dead_count = len(saved_attachment_paths)
                    log(f"SmartScan review had {dead_count} queued attachment path(s), but none still exist. This should not happen after v2.10.27 persistent-copy fix; check RFQ debug folder.")
                # v3.9.99: the review window used to open for EVERY queued file -- including the
                # synthetic ones MaINbox itself creates: the email body saved as a temp .txt
                # (v2.10.33 structured-parser feed) and rescued inline body images (signature
                # logos routinely pass the 8 KB gate). So an RFQ whose list is typed IN THE BODY
                # popped a SmartScan review (plus its console window) over the user's own email
                # text or a logo, hung until closed, returned 0 rows, and only THEN fell back to
                # body extraction. Classify the queue: only a real Outlook DOCUMENT attachment
                # justifies opening review. If there are none, skip review entirely and extract
                # from the body right away; inline/pasted IMAGES are held back and reviewed only
                # if the body then yields 0 rows (preserves the photo-of-an-RFQ workflow).
                def _is_synthetic_review_file(p):
                    b = os.path.basename(str(p)).lower()
                    return ("email_body_" in b) or ("inline_body_image_" in b)
                _real_doc_paths = [p for p in unique_paths if not _is_synthetic_review_file(p)]
                _image_exts = (".png", ".jpg", ".jpeg", ".webp", ".bmp")
                if not _real_doc_paths:
                    deferred_review_image_paths = [
                        p for p in unique_paths
                        if _is_synthetic_review_file(p) and os.path.splitext(str(p))[1].lower() in _image_exts
                    ]
                    log("No real Outlook document attachments -- the RFQ content is in the email body"
                        + (f" (plus {len(deferred_review_image_paths)} inline/pasted image(s), held back)" if deferred_review_image_paths else "")
                        + ". Skipping the SmartScan review window and extracting from the body directly.")
                else:
                    log(f"Opening SmartScan review window for {len(unique_paths)} saved attachment(s). Correct rows there, then click Done → Send Back to MaINbox.")
                    rrows, rmsgs, rmerged = _run_smartscan_review_subprocess(unique_paths, subject, progress_callback=progress_callback)
                    log_many(rmsgs)
                    if rmerged:
                        parts.append("\n--- SmartScan Reviewed Text ---\n" + rmerged[:50000])
                    if rrows is None:
                        # v4.2.6: CANCEL MEANS CANCEL. Proven from the user's own RFQ progress
                        # log on PO CPCJ384:
                        #   SmartScan review was cancelled by user.
                        #   SmartScan review returned 0 rows; MaINbox will try the email
                        #     body/text fallback if available.
                        #   Email-body RFQ source detected; ...
                        #   Email body: simple parser found 4 material row(s)
                        # Cancelling fell straight into the "email body" fallback, which is fed
                        # the WHOLE accumulated quote_text -- attachment text included (the same
                        # log records "CPCJ384.PDF: saved 327455 bytes, extracted 35049 chars").
                        # So the built-in parser ran over the very attachments the log had just
                        # promised three times were "skipped for this attachment", and the user
                        # got a different engine's answer after explicitly rejecting a scan.
                        review_cancelled = True
                        log("SmartScan review was CANCELLED by the user (window closed without "
                            "Done -> Send Back to MaINbox). Nothing will be re-extracted from these "
                            "attachment(s) by the built-in parser. Re-open Send to RFQ to scan again, "
                            "or use Done -> Send Back to MaINbox to accept SmartScan's rows.")
                    elif rrows:
                        vision_materials.extend(rrows)
                        log(f"SMARTSCAN REVIEW SUCCESS - accepted {len(rrows)} corrected material row(s) from SmartScan.")
                    else:
                        log("SmartScan review returned 0 rows; MaINbox will try the email body/text fallback if available.")
            except Exception as review_exc:
                log(f"SmartScan full review route failed ({review_exc}); MaINbox will try the email body/text fallback if available.")
                try:
                    _rfq_debug_write("99_smartscan_review_exception.txt", traceback.format_exc())
                except Exception:
                    pass

        quote_text = "\n".join(parts)

        # v4.2.21: MERGE the body-typed rows with whatever the attachments produced,
        # instead of letting either silence the other. Reported: "what if the customer
        # puts some info in the body and an attachment -- will it grab both?" It did not:
        # the body pass was gated on (saved_count == 0 or existing_count == 0), so a
        # SINGLE row from an attachment discarded every item typed in the body, silently.
        # Safe against the CPCJ384 duplicate-row incident because these rows come only
        # from the deterministic body parser, which never sees attachment text.
        if body_numbered_rows:
            _before = len(vision_materials)
            vision_materials, _dupes, _conflicts = merge_material_sources(
                vision_materials, body_numbered_rows)
            _added = len(vision_materials) - _before
            log(f"Email body + attachments merged: {len(body_numbered_rows)} body row(s), "
                f"{_added} added, {_dupes} duplicate(s) skipped"
                + (f", {_conflicts} kept with a QUANTITY CONFLICT (flagged for review)"
                   if _conflicts else ""))

        # v2.8.4U: email-body RFQs are valid RFQs too.
        # The PDF/XLSX fixes made strict mode attachment-first, which was great for
        # documents but caused plain email requests with no attachment/table to return
        # zero items.  We now treat the combined email body text as its own source.
        # This runs after attachments so a perfect Docling/XLSX parse is left alone,
        # but if nothing was found from files, the normal text model can extract the
        # typed material list from the email body.
        try:
            existing_count = len(normalize_material_items(vision_materials))
            if review_cancelled:
                # v4.2.6: this is the block the user's log identified as the actual source of
                # the substituted rows. It is LABELLED email-body, and its own comment says
                # "Keep this limited to email body mode. The old broad regex was bad for PDFs"
                # -- but it is handed `quote_text`, which by this point also contains every
                # attachment's extracted text. After an explicit cancel that is exactly the
                # wrong thing to do, so it is skipped outright.
                log("Skipping the email-body/text fallback because the SmartScan review was "
                    "CANCELLED. No rows will be produced from the cancelled scan.")
            elif quote_text.strip() and (saved_count == 0 or existing_count == 0) and not body_typed_list_handled:
                log("Email-body RFQ source detected; trying text-model extraction from the email body")
                body_rows = ask_ollama_extract_materials(subject, sender, quote_text)
                if body_rows:
                    vision_materials.extend(body_rows)
                    log(f"Email body: text model found {len(body_rows)} material row(s)")
                else:
                    # Keep this limited to email body mode. The old broad regex was bad
                    # for PDFs, but it is useful as a last-resort for short typed lists.
                    simple_rows = extract_materials_from_quote_text(quote_text)
                    if simple_rows:
                        vision_materials.extend(simple_rows)
                        log(f"Email body: simple parser found {len(simple_rows)} material row(s)")
                    else:
                        log("Email body: no material rows found by text model or simple parser")
        except Exception as body_exc:
            log(f"Email body extraction failed ({body_exc})")
            try:
                _rfq_debug_write("99_email_body_extraction_exception.txt", traceback.format_exc())
            except Exception:
                pass

        # v3.9.99: last-resort review of inline/pasted body IMAGES, held back above. Only
        # runs when the body-first extraction produced NOTHING -- e.g. a photo of an RFQ
        # pasted into an otherwise-short email. A signature logo landing here costs one
        # (windowless) review at most in the rare 0-row case, instead of on every body RFQ.
        if deferred_review_image_paths:
            try:
                if not normalize_material_items(vision_materials):
                    log(f"Email body produced 0 material rows; opening SmartScan review for {len(deferred_review_image_paths)} inline/pasted image(s) as a last resort.")
                    drows, dmsgs, dmerged = _run_smartscan_review_subprocess(deferred_review_image_paths, subject, progress_callback=progress_callback)
                    log_many(dmsgs)
                    if drows is None:
                        # v4.2.6: same cancel/empty conflation as the document review above.
                        log("Inline/pasted image review was CANCELLED by the user; no rows accepted from it.")
                    elif drows:
                        vision_materials.extend(drows)
                        log(f"SMARTSCAN REVIEW SUCCESS - accepted {len(drows)} material row(s) from inline/pasted image review.")
                    else:
                        log("Inline/pasted image review returned 0 rows.")
                else:
                    log(f"Skipped SmartScan review of {len(deferred_review_image_paths)} inline/pasted image(s): the email body already produced material rows.")
            except Exception as dr_exc:
                log(f"Deferred inline-image review failed ({dr_exc}); continuing with body results.")
                try:
                    _rfq_debug_write("99_deferred_image_review_exception.txt", traceback.format_exc())
                except Exception:
                    pass

        try:
            _rfq_debug_write("03_rfq_extraction_finished.txt", (
                f"Finished: {datetime.now().isoformat()}\n"
                f"Saved attachments seen by callback: {saved_count}\n"
                f"Strict AI material rows: {len(vision_materials)}\n"
                f"Strict mode: {RFQ_STRICT_VISION_ONLY}\n"
                f"Details:\n" + "\n".join(str(x) for x in ocr_details[-200:])
            ))
        except Exception:
            pass

        if saved_count == 0:
            log("NO OUTLOOK ATTACHMENTS WERE SAVED. Email-body extraction was attempted as the RFQ source.")
            try:
                _rfq_debug_write("98_no_attachments_saved.txt", "No Outlook attachments reached the saved_file_callback. Email-body extraction was attempted instead.")
            except Exception:
                pass

        materials = normalize_material_items(vision_materials)
        if RFQ_STRICT_VISION_ONLY:
            if not materials:
                log("STRICT RESULT: 0 rows from RFQ AI/body extraction. Check the debug folder for saved originals, parsed table text, text_model_response files, and email body logs.")
            return materials, quote_text, ocr_details, True

        # Optional escape hatch if MAINBOX_RFQ_STRICT_VISION_ONLY=0 is set.
        ai_materials = ask_ollama_extract_materials(subject, sender, quote_text)
        if ai_materials:
            materials.extend(ai_materials)
        if not materials:
            materials = extract_materials_from_quote_text(quote_text)
        return normalize_material_items(materials), quote_text, ocr_details, True


    def _all_saved_vendors(self):
        """v4.2.62: every vendor MaINbox knows -- procurement memory (194+ with
        usage counts), vendor history, and V-typed saved contacts -- deduped by
        email, most-used first. Feeds the Add Vendor picker."""
        out = {}
        try:
            pm = getattr(self, "procurement_memory", None) or {}
            for em, rec in (pm.get("vendors") or {}).items():
                em = str(em or "").lower().strip()
                if not em or "@" not in em:
                    continue
                score = int(rec.get("request_count", 0) or 0) + 2 * int(rec.get("award_count", 0) or 0)
                name = re.sub(r"\s*<[^>]*>\s*", "", str(rec.get("name", "") or "")).strip()
                out[em] = {"email": em, "name": name, "score": score}
        except Exception:
            pass
        try:
            vh = (getattr(self, "vendor_history", None) or {}).get("vendors") or {}
            items = vh.items() if isinstance(vh, dict) else []
            for em, rec in items:
                em = str(em or "").lower().strip()
                if not em or "@" not in em:
                    continue
                if not isinstance(rec, dict):
                    rec = {}
                cur = out.setdefault(em, {"email": em, "name": "", "score": 0})
                cur["score"] += int(rec.get("times_used", 0) or 0)
                if not cur["name"]:
                    cur["name"] = re.sub(r"\s*<[^>]*>\s*", "", str(rec.get("name", "") or "")).strip()
        except Exception:
            pass
        try:
            ct = self._load_contact_types()
            for em, rec in (ct.get("contacts") or {}).items():
                if str((rec or {}).get("code", "")) == "V":
                    em = str(em or "").lower().strip()
                    if em and "@" in em:
                        out.setdefault(em, {"email": em, "name": "", "score": 0})
        except Exception:
            pass
        return sorted(out.values(), key=lambda v: (-v["score"], v["email"]))

    def _pick_saved_vendor(self, parent):
        """v4.2.62 (Steve): the Add Vendor picker -- searchable saved-vendor
        list, Enter/double-click selects, 'New (blank)' opens an empty card.
        Returns an email string, '' for a blank card, or None on cancel."""
        vendors = self._all_saved_vendors()
        result = {"value": None}
        dlg = tk.Toplevel(parent)
        dlg.title("Add Vendor")
        remember_window_geometry(dlg, "MaINbox RFQ Vendor Picker", "480x460")
        dlg.transient(parent)
        apply_theme(dlg)
        tk.Label(dlg, text="Add Vendor", font=(_FONT, 13, "bold"), fg=_ACCENT, bg=_BG).pack(anchor="w", padx=12, pady=(10, 2))
        tk.Label(dlg, text="Search saved vendors (Enter or double-click to select), or click New for a blank card.",
                 bg=_BG, fg=_FG_DIM, wraplength=440, justify="left").pack(anchor="w", padx=12, pady=(0, 6))
        search_var = tk.StringVar()
        ent = tk.Entry(dlg, textvariable=search_var, width=48)
        ent.pack(fill="x", padx=12)
        lst_frame = tk.Frame(dlg, bg=_BG)
        lst_frame.pack(fill="both", expand=True, padx=12, pady=6)
        lb = tk.Listbox(lst_frame, activestyle="none")
        sb = ttk.Scrollbar(lst_frame, orient="vertical", command=lb.yview)
        lb.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y")
        lb.pack(side="left", fill="both", expand=True)
        shown = []

        def refresh(*_):
            q = search_var.get().strip().lower()
            lb.delete(0, tk.END)
            shown.clear()
            for v in vendors:
                hay = (v["email"] + " " + v["name"]).lower()
                if not q or all(part in hay for part in q.split()):
                    shown.append(v)
                    label = (f"{v['name']}  <{v['email']}>" if v["name"] else v["email"])
                    if v["score"]:
                        label += f"   ({v['score']} uses)"
                    lb.insert(tk.END, label[:80])
                if len(shown) >= 400:
                    break
            if shown:
                lb.selection_set(0)
        search_var.trace_add("write", refresh)
        refresh()

        def choose(event=None):
            sel = lb.curselection()
            if sel and shown:
                result["value"] = shown[sel[0]]["email"]
                dlg.destroy()
        def new_blank():
            result["value"] = ""
            dlg.destroy()
        lb.bind("<Double-1>", choose)
        btns = tk.Frame(dlg, bg=_BG)
        btns.pack(fill="x", padx=12, pady=(0, 10))
        sel_btn = tk.Button(btns, text="Select", width=10, command=choose, bg=_ACCENT, fg="#ffffff",
                            activebackground=_ACCENT2, activeforeground="#ffffff",
                            font=(_FONT, _FONT_SIZE, "bold"))
        sel_btn.pack(side="right", padx=4)
        tk.Button(btns, text="New (blank)", width=11, command=new_blank).pack(side="right", padx=4)
        tk.Button(btns, text="Cancel", width=9, command=dlg.destroy).pack(side="left", padx=4)
        dlg.bind("<Return>", choose)
        dlg.bind("<Escape>", lambda e: dlg.destroy())
        ent.focus_set()
        self.safe_grab_set(dlg)
        parent.wait_window(dlg)
        return result["value"]

    def open_rfq_review_window(self, group_id, materials, vendors=None, customer_hint=""):
        """v4.2.61 Phase 2.2 (Steve's design): the RFQ Review & Send window.
        Items on the left (add/edit/remove); VENDOR CARDS on the right, each
        with To + CC and its assigned item subset (per-item vendor suggestions
        prefill the cards); one button sends one email per vendor with just
        their items -- different subsets to different vendors in one shot.
        Reuses create_outlook_mail_item (now with cc), vendor-history and
        procurement-request recording per send."""
        group = self.get_group_by_id(group_id) or {}
        gname = str(group.get("name", "") or "Quote job")
        items = [dict(m) for m in normalize_material_items(materials or [], keep_duplicates=True)]
        if not items:
            try:
                self.set_status("RFQ Review: no items to review.")
            except Exception:
                pass
            return

        win = tk.Toplevel(self.root)
        win.title(f"RFQ Review & Send -- {gname[:60]}")
        remember_window_geometry(win, "MaINbox RFQ Review Send", "1240x680")
        win.transient(self.root)
        apply_theme(win)
        tk.Label(win, text=f"RFQ Review & Send -- {gname[:70]}", font=(_FONT, 14, "bold"),
                 fg=_ACCENT, bg=_BG).pack(anchor="w", padx=14, pady=(10, 2))
        tk.Label(win, text="Assign items to vendors (an item may go to several). Edit To/CC per vendor. "
                           "One click sends one email per vendor with just their items.",
                 bg=_BG, fg=_FG_DIM, wraplength=1150, justify="left").pack(anchor="w", padx=14, pady=(0, 6))

        paned = tk.PanedWindow(win, orient="horizontal", sashwidth=6, bg=_BORDER, bd=0, opaqueresize=True)
        paned.pack(fill="both", expand=True, padx=12, pady=(0, 4))

        # ---------------- left: items ----------------
        left = tk.Frame(paned, bg=_BG)
        paned.add(left, minsize=420)
        tk.Label(left, text="Items", font=(_FONT, _FONT_SIZE, "bold"), fg=_ACCENT, bg=_BG).pack(anchor="w", padx=4)
        it_holder = tk.Frame(left, bg=_BG)
        it_holder.pack(fill="both", expand=True)
        itree = ttk.Treeview(it_holder, columns=("qty", "unit", "desc", "vendors"), show="headings",
                             selectmode="extended")
        for cid, lab, w_ in (("qty", "Qty", 60), ("unit", "Unit", 55), ("desc", "Description", 330),
                             ("vendors", "Assigned to", 160)):
            itree.heading(cid, text=lab)
            itree.column(cid, width=w_, minwidth=40, anchor="w", stretch=(cid == "desc"))
        ivsb = ttk.Scrollbar(it_holder, orient="vertical", command=itree.yview)
        itree.configure(yscrollcommand=ivsb.set)
        ivsb.pack(side="right", fill="y")
        itree.pack(side="left", fill="both", expand=True)
        itree.tag_configure("unassigned", background="#5c2a2a")

        # ---------------- right: vendor cards ----------------
        right = tk.Frame(paned, bg=_BG)
        paned.add(right, minsize=430)
        head = tk.Frame(right, bg=_BG)
        head.pack(fill="x")
        tk.Label(head, text="Vendors", font=(_FONT, _FONT_SIZE, "bold"), fg=_ACCENT, bg=_BG).pack(side="left", padx=4)
        unassigned_var = tk.StringVar(value="")
        tk.Label(head, textvariable=unassigned_var, bg=_BG, fg="#ff8888").pack(side="left", padx=10)
        canvas = tk.Canvas(right, bg=_BG, highlightthickness=0)
        vsb = ttk.Scrollbar(right, orient="vertical", command=canvas.yview)
        cards_frame = tk.Frame(canvas, bg=_BG)
        cards_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=cards_frame, anchor="nw")
        canvas.configure(yscrollcommand=vsb.set)
        vsb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)

        cards = []  # [{"to": StringVar, "cc": StringVar, "items": set(idx), "frame":, "lb":, "msg":}]
        # v4.2.64 (Steve): with NO suggested vendors, show a single Add Vendor
        # button instead of a blank card; it disappears once a vendor is added.
        placeholder = {"frame": None}

        def show_placeholder():
            if placeholder["frame"] is not None:
                return
            ph = tk.Frame(cards_frame, bg=_BG2, highlightbackground=_BORDER, highlightthickness=1)
            ph.pack(fill="x", padx=6, pady=18)
            tk.Label(ph, text="No vendor suggestions for these items yet.",
                     bg=_BG2, fg=_FG_DIM).pack(pady=(12, 4))
            tk.Button(ph, text="Add Vendor", width=16, bg=_ACCENT, fg="#ffffff",
                      activebackground=_ACCENT2, activeforeground="#ffffff",
                      font=(_FONT, _FONT_SIZE, "bold"),
                      command=lambda: add_vendor_via_picker()).pack(pady=(0, 14))
            placeholder["frame"] = ph

        def hide_placeholder():
            if placeholder["frame"] is not None:
                try:
                    placeholder["frame"].destroy()
                except Exception:
                    pass
                placeholder["frame"] = None

        def item_label(ix):
            it = items[ix]
            q = f"{it.get('qty', '')} {it.get('unit', '')}".strip()
            return f"{q} - {it.get('description', '')}"[:80]

        def assigned_vendor_names(ix):
            out = []
            for c in cards:
                if ix in c["items"]:
                    addr = c["to"].get().strip()
                    out.append((addr.split("@")[0] if "@" in addr else addr or "?")[:14])
            return ", ".join(out)

        def refresh_items():
            sel = itree.selection()
            itree.delete(*itree.get_children())
            unassigned = 0
            for ix, it in enumerate(items):
                names = assigned_vendor_names(ix)
                tags = () if names else ("unassigned",)
                if not names:
                    unassigned += 1
                itree.insert("", "end", iid=str(ix),
                             values=(it.get("qty", ""), it.get("unit", ""),
                                     it.get("description", ""), names), tags=tags)
            unassigned_var.set(f"{unassigned} item(s) unassigned" if unassigned else "all items assigned")
            for s in sel:
                try:
                    if itree.exists(s):
                        itree.selection_add(s)
                except Exception:
                    pass

        def refresh_card(c):
            c["lb"].delete(0, tk.END)
            for ix in sorted(c["items"]):
                if 0 <= ix < len(items):
                    c["lb"].insert(tk.END, item_label(ix))
            c["_ixs"] = sorted(c["items"])

        def add_card(to="", cc="", ixs=None):
            hide_placeholder()
            card = tk.Frame(cards_frame, bg=_BG2, highlightbackground=_BORDER, highlightthickness=1)
            card.pack(fill="x", padx=6, pady=5)
            row1 = tk.Frame(card, bg=_BG2)
            row1.pack(fill="x", padx=6, pady=(6, 2))
            tk.Label(row1, text="To:", bg=_BG2, fg=_FG, width=4, anchor="e").pack(side="left")
            to_var = tk.StringVar(value=to)
            tk.Entry(row1, textvariable=to_var, width=34).pack(side="left", padx=(2, 8))
            tk.Label(row1, text="CC:", bg=_BG2, fg=_FG, width=4, anchor="e").pack(side="left")
            cc_var = tk.StringVar(value=cc)
            tk.Entry(row1, textvariable=cc_var, width=26).pack(side="left", padx=2)
            c = {"to": to_var, "cc": cc_var, "items": set(ixs or []), "frame": card}
            tk.Button(row1, text="X", width=2, command=lambda: remove_card(c)).pack(side="right", padx=4)
            lb = tk.Listbox(card, height=4, activestyle="none")
            lb.pack(fill="x", padx=6, pady=2)
            c["lb"] = lb
            row2 = tk.Frame(card, bg=_BG2)
            row2.pack(fill="x", padx=6, pady=(0, 6))
            tk.Button(row2, text="← Assign selected items",
                      command=lambda: assign_selected(c)).pack(side="left", padx=2)
            tk.Button(row2, text="Remove selected line",
                      command=lambda: unassign_line(c)).pack(side="left", padx=6)
            # v4.2.64: per-vendor message -- visible only when 'apply same
            # message to all' is unchecked; prefilled from the shared message.
            cmsg = tk.Text(card, height=3, bg=_BG3, fg=_FG, wrap="word",
                           font=(_FONT, _FONT_SIZE))
            c["msg"] = cmsg
            if not apply_all_var.get():
                cmsg.insert("1.0", shared_msg.get("1.0", tk.END).strip())
                cmsg.pack(fill="x", padx=6, pady=(0, 6))
            cards.append(c)
            refresh_card(c)
            refresh_items()
            return c

        def remove_card(c):
            try:
                c["frame"].destroy()
            except Exception:
                pass
            if c in cards:
                cards.remove(c)
            refresh_items()

        def assign_selected(c):
            for s in itree.selection():
                try:
                    c["items"].add(int(s))
                except Exception:
                    continue
            refresh_card(c)
            refresh_items()

        def unassign_line(c):
            sel = list(c["lb"].curselection())
            ixs = c.get("_ixs", sorted(c["items"]))
            for pos in reversed(sel):
                try:
                    c["items"].discard(ixs[pos])
                except Exception:
                    pass
            refresh_card(c)
            refresh_items()

        # ---------------- item edit dialogs (Enter = OK) ----------------
        def item_dialog(title, it=None):
            dlg = tk.Toplevel(win)
            dlg.title(title)
            dlg.transient(win)
            apply_theme(dlg)
            out = {}
            vals = {}
            for i, (lab, key, w_) in enumerate((("Qty", "qty", 10), ("Unit", "unit", 10),
                                                ("Description", "description", 48))):
                tk.Label(dlg, text=lab + ":", bg=_BG, fg=_FG).grid(row=i, column=0, sticky="e", padx=8, pady=4)
                v = tk.StringVar(value=str((it or {}).get(key, "")))
                tk.Entry(dlg, textvariable=v, width=w_).grid(row=i, column=1, sticky="w", padx=8, pady=4)
                vals[key] = v
            def ok(event=None):
                out.update({k: v.get().strip() for k, v in vals.items()})
                dlg.destroy()
            btns = tk.Frame(dlg, bg=_BG)
            btns.grid(row=3, column=0, columnspan=2, pady=8)
            okb = tk.Button(btns, text="OK", width=10, command=ok, bg=_ACCENT, fg="#ffffff")
            okb.pack(side="left", padx=4)
            tk.Button(btns, text="Cancel", width=10, command=dlg.destroy).pack(side="left", padx=4)
            dlg.bind("<Return>", ok)
            dlg.bind("<Escape>", lambda e: dlg.destroy())
            okb.focus_set()
            self.safe_grab_set(dlg)
            win.wait_window(dlg)
            return out if out.get("description") else None

        def add_item():
            it = item_dialog("Add Item")
            if it:
                items.append({"qty": it["qty"], "unit": it["unit"], "part_number": "",
                              "description": it["description"]})
                refresh_items()

        def edit_item():
            sel = itree.selection()
            if not sel:
                return
            ix = int(sel[0])
            it = item_dialog("Edit Item", items[ix])
            if it:
                items[ix].update({"qty": it["qty"], "unit": it["unit"], "description": it["description"]})
                for c in cards:
                    refresh_card(c)
                refresh_items()

        def remove_item():
            sel = sorted((int(s) for s in itree.selection()), reverse=True)
            for ix in sel:
                items.pop(ix)
                for c in cards:
                    c["items"] = {j - 1 if j > ix else j for j in c["items"] if j != ix}
            for c in cards:
                refresh_card(c)
            refresh_items()

        ibtns = tk.Frame(left, bg=_BG)
        ibtns.pack(fill="x", pady=4)
        tk.Button(ibtns, text="Add Item", width=10, command=add_item).pack(side="left", padx=3)
        tk.Button(ibtns, text="Edit Item", width=10, command=edit_item).pack(side="left", padx=3)
        tk.Button(ibtns, text="Remove Item", width=11, command=remove_item).pack(side="left", padx=3)
        tk.Button(ibtns, text="Full Extractor...", width=14,
                  command=lambda: (win.destroy(),
                                   self.open_quote_intelligence_window(
