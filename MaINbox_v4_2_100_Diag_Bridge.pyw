        except Exception:
            pass
        # v4.1.9: one-time heal for coverage records the single-email Quote RFQ path bound to a
        # phantom 'single_email_rfq:<entry_id>' group id (an id that never existed in Groups, so
        # group routing could never fire for them). For each: use the original email's REAL
        # group when it has one, otherwise create the group now (named from the record's
        # customer/subject) with the original email as a member; then move the ledger to
        # grp:<real id> (merging losslessly if one already exists) and rebind. Runs after
        # groups_data is loaded because it needs memberships; guarded by its own flag.
        try:
            if isinstance(getattr(self, "quote_coverage", None), dict) \
                    and self.quote_coverage.get("single_rfq_group_migration") != 1:
                _threads = self.quote_coverage.setdefault("threads", {})
                _members = self.groups_data.setdefault("memberships", {})
                _changed = False
                for _key in [k for k in list(_threads.keys()) if str(k).startswith("grp:single_email_rfq:")]:
                    _rec = _threads.get(_key)
                    if not isinstance(_rec, dict):
                        continue
                    _eid = str(_key)[len("grp:single_email_rfq:"):].strip()
                    _gid = str(_members.get(_eid, "") or "").strip() if _eid else ""
