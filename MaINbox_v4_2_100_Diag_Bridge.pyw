def default_procurement_memory():
    return {
        "materials": {},        # normalized_key -> material profile + vendor stats
        "vendors": {},          # email -> vendor profile + award/request stats
        "awards": [],           # award history records
        "price_history": [],    # item/vendor price records
        "routing_rules": {},    # normalized_key -> preferred vendor emails
        "rfq_extraction_corrections": [],  # user corrections from RFQ grid/source review
        "updated_at": "",
    }

def recent_rfq_extraction_learning_prompt(max_items=12):
    """Return compact user-correction guidance for RFQ extraction prompts."""
    try:
        mem = load_json(PROCUREMENT_MEMORY_FILE, default_procurement_memory())
        corrections = mem.get("rfq_extraction_corrections", []) if isinstance(mem, dict) else []
        if not isinstance(corrections, list) or not corrections:
            return "No prior RFQ extraction corrections saved yet."
        lines = []
        for rec in corrections[-int(max_items):]:
            if not isinstance(rec, dict):
                continue
            field = str(rec.get("field", "") or "").strip()
            before = re.sub(r"\s+", " ", str(rec.get("before", "") or "").strip())[:90]
            after = re.sub(r"\s+", " ", str(rec.get("after", "") or "").strip())[:90]
            desc = re.sub(r"\s+", " ", str(rec.get("description", "") or "").strip())[:120]
            if field and (before or after or desc):
                action = str(rec.get("action", "") or "").strip()
                if action.startswith("add") and field == "row":
                    lines.append(f"- User added missing line item near source/order context: {before or '(blank)'} -> {after or '(blank)'}. Treat similar highlighted/order-adjacent lines as separate RFQ items.")
                else:
                    lines.append(f"- User corrected {field}: {before or '(blank)'} -> {after or '(blank)'} for item: {desc}")
        return "\n".join(lines[-int(max_items):]) if lines else "No prior RFQ extraction corrections saved yet."
    except Exception:
        return "No prior RFQ extraction corrections saved yet."

