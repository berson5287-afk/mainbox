            "sent_waiting_tracker_sent_timestamp": email.get("sent_waiting_tracker_sent_timestamp", existing.get("sent_waiting_tracker_sent_timestamp", 0)),
            "ai_user_locked": bool(email.get("ai_user_locked", existing.get("ai_user_locked", False))),
