    def _auto_create_coverage_for_sent_rfq_inner(self, placeholder, sent_body="", sent_subject="", sent_msg=None):
        """v4.1.12: AUTO QUOTE COVERAGE, create-first. When a vendor RFQ is sent from Outlook,
        the tracker scan creates the Sent/Waiting tracker; THIS then always finishes the chain:
          1. ensure the tracker has a group -- reuse its group when the pairing already found one,
             otherwise CREATE one immediately (named from the RFQ subject). The v4.1.11 version
             gated everything on the pairing finding the original request first, which is exactly
             backwards for 'P&A -' subjects the token matcher cannot catch -- so nothing fired;
          2. create the group's coverage ledger from the item list in the RFQ actually sent,
             every line marked Waiting;
          3. hunt for the ORIGINAL customer request by matching its body against the requested
             items. A clear, dominant match links it into the group automatically (you can always
             move it out). Anything less queues a picker: the top candidates are shown after the
             scan for you to choose, or skip.
        Dupe-guards unchanged from v4.1.11: Waiting-on-Vendor + unpriced sends only; never touches
        a group that already has a ledger (active or dismissed); items tagged 'rfq_extraction' so a
        manual Quote RFQ REPLACES them; per-item dedupe; no items -> no ledger, no group created.
        Gated by settings['auto_coverage_from_sent_rfq'] (default ON)."""
        try:
            if not bool(self.settings.get("auto_coverage_from_sent_rfq", True)):
                return False
            if not isinstance(placeholder, dict):
                return False
            if str(placeholder.get("status", "") or "") != "Waiting on Vendor":
                return False
            pid = placeholder.get("entry_id", "")
            if not pid:
                return False
            # v4.1.38 RECIPIENT VETO: this hook builds a ledger of items WE requested
            # from a VENDOR. If the sent message went to a known CUSTOMER, it cannot be
            # a vendor RFQ no matter what the (possibly mis-inferred) tracker status
            # says -- it is our quote/reply going out, and its attachment is a quote we
            # SENT, not a customer's request. Resolve the recipient and refuse.
            try:
                if self._sent_recipient_is_known_customer(placeholder):
                    _cov_debug("SENT-RFQ veto: recipient is a known customer -- not a vendor RFQ")
                    return False
            except Exception:
                pass
            body = str(sent_body or "")
            if re.search(r"\$\s*\d", body):
                return False              # priced send = a quote, not an RFQ
            # v4.1.38 ATTACHMENT-AWARE PRICE VETO: the body often has no "$" because the
            # prices live in the attached quote document. A priced/commercial quote in
            # the SENT attachment is still a quote we are SENDING, not an RFQ -- veto it.
            try:
                if sent_msg is not None and self._sent_attachment_looks_priced(sent_msg):
                    _cov_debug("SENT-RFQ veto: sent attachment is a priced quote document")
                    return False
            except Exception:
                pass
            mats = []
            if body.strip():
                # v4.1.26 (round 8, defect #1): keep identical repeated rows from the
                # sent-RFQ body -- they become separate requested lines in the ledger.
                mats = normalize_material_items(
                    extract_materials_from_quote_text(
                        _coverage_reassemble_columnar_quote(body), keep_duplicates=True) or [],
                    keep_duplicates=True)
                if not mats:
                    # v4.2.48: qty-LAST footage lists ("#4/0 AWG GREEN - 2,000'") --
                    # same parser as the v4.2.47 extractor fix. Brian's wire-quote
                    # send hit this exact hole: tracker created, auto_create ok:false
                    # in 24ms because the qty-first parser saw 0 items in the body.
                    # (v4.2.78: the parser now also reads "- qty 25" / "- 10 pcs" endings.)
                    _ql_rows = extract_qty_last_list_from_body(body)
                    if len(_ql_rows) >= 2:
                        mats = normalize_material_items(_ql_rows, keep_duplicates=True)
                if not mats:
                    # v4.2.78 (Steve): sentence-form RFQs ("can you quote 25 X and
                    # 500ft of Y?") parse to zero items in every line parser, so the
                    # whole auto-coverage chain -- ledger, request hunt, picker --
                    # never fired on a tersely written 'P&A' send. The anchored
                    # sentence extractor is the last resort before giving up.
                    _sn_rows = extract_request_sentence_items(body)
                    if _sn_rows:
                        mats = normalize_material_items(_sn_rows, keep_duplicates=True)
            # v4.1.18: the item list is often NOT typed into the RFQ body -- it rides
            # along as the customer's forwarded attachment (PDF/Excel) or a screenshot
            # pasted into the send. When the body yields nothing, or explicitly points
            # at attached material, read the sent message's own attachments/images too.
            if sent_msg is not None and (
                    not mats
                    or re.search(r"attach|screenshot|image below|picture|photo|see (?:the )?list", body.lower())):
                try:
                    _amats = self._coverage_materials_from_msg_attachments(
                        sent_msg, include_images=True, source_label="sent-rfq")
                except Exception:
                    _amats = []
                if _amats:
                    # v4.1.26 (round 8, defect #1): preserve genuine duplicate rows WITHIN
                    # each source (a BOM listing '10 EA 632S' twice is two requirements),
                    # but stay occurrence-aware ACROSS sources so an item that appears in
                    # both the typed body and the attachment isn't double-counted: each
                    # body occurrence absorbs at most one matching attachment occurrence.
                    _amats = normalize_material_items(_amats, keep_duplicates=True)
                    if mats:
                        def _xsrc_key(_r):
                            return re.sub(r"\s+", " ",
                                          f"{_r.get('qty','')}|{_r.get('unit','')}|{_r.get('part_number','')}|{_r.get('description','')}".lower()).strip()
                        _bod_ct = {}
                        for _r in mats:
                            _k = _xsrc_key(_r)
                            _bod_ct[_k] = _bod_ct.get(_k, 0) + 1
                        for _r in _amats:
                            _k = _xsrc_key(_r)
                            if _bod_ct.get(_k, 0) > 0:
                                _bod_ct[_k] -= 1   # already represented by a body row
                                continue
                            mats.append(_r)
                    else:
                        mats = _amats
            if not mats:
                return False
            if not isinstance(getattr(self, "quote_coverage", None), dict):
                return False
            threads = self.quote_coverage.setdefault("threads", {})
            memberships = self.groups_data.setdefault("memberships", {})
            gid = str(memberships.get(pid, "") or "")
            if gid and not self.get_group_by_id(gid):
                gid = ""
            # v4.1.18 audit: the customer-attachment scan may have keyed this job's ledger
            # by conversation before it was grouped -- fold that fragment into the group
            # key first so this hook sees ONE ledger and never creates a duplicate.
            if gid:
                self._coverage_fold_conversation_into_group(
                    str(placeholder.get("conversation_id", "") or ""), gid)
            if gid and isinstance(threads.get("grp:" + gid), dict):
                return False              # this job already has a ledger -- never touch it
            subj = str(sent_subject or placeholder.get("subject", "") or "")
            # v4.1.14: decide the group BEFORE creating one. The v4.1.13 flow always spun up a
            # NEW group for an ungrouped tracker and then tried to pull the original request in --
            # exactly backwards when the request already lives in a group (an RFQ sent with a
            # fresh subject for a job like '1598 HBL Controlled' fragmented into its own group).
            # Now: hunt for the original request FIRST; a dominant match whose email is already
            # grouped means the tracker JOINS that group; a dominant ungrouped match gets a new
            # group holding both; anything ambiguous gets a new group + the picker.
            self_row = None
            if pid and not str(pid).startswith("sentwait:"):
                _se = self.get_email_by_id(pid)
                if _se and not _se.get("is_sent_waiting_placeholder"):
                    self_row = _se
            cands = []
            adopt_eid = ""
            adopt_gid = ""
            adopt_how = ""
            if not gid and self_row is None:
                # v4.1.79: cheap signals FIRST -- conversation ancestry, the user's own
                # 'This is for <customer> at <job>' line, subject tokens. In the 21-day
                # audit the item-overlap scorer below linked only 8 of 90 RFQ threads to
                # their original request (the request often arrives as an attachment, so
                # there is no body text to overlap); these signals need no item text at
                # all. Unambiguous-only: any doubt falls through to the scorer/picker.
                try:
                    _sig_eid, _sig_gid, _sig_how = self._signal_original_request(
                        placeholder, sent_subject=subj,
                        sent_own_body=self._own_reply_text(body))
                except Exception:
                    _sig_eid, _sig_gid, _sig_how = "", "", ""
                if _sig_eid:
                    adopt_eid = _sig_eid
                    adopt_how = _sig_how
                    _cg = str(memberships.get(adopt_eid, "") or "")
                    if _cg and self.get_group_by_id(_cg):
                        adopt_gid = _cg
                elif _sig_gid and self.get_group_by_id(_sig_gid):
                    adopt_gid = _sig_gid
                    adopt_how = _sig_how
            if not gid and self_row is None and not adopt_eid and not adopt_gid:
                try:
                    cands = self._score_original_request_candidates({"requested": mats}, placeholder)
                except Exception:
                    cands = []
                if cands:
                    best = cands[0]
                    second_score = cands[1][1] if len(cands) > 1 else 0.0
                    # Dominant either way: (a) most items found in one email, clearly ahead of the
                    # runner-up; or (b) the ONLY candidate at all, on >=2 hard part hits covering
                    # at least half the job -- with zero competition, demanding 80% just pushed
                    # obvious matches to the picker.
                    _dominant = (best[3] >= 2 and ((best[1] >= 0.8 and (best[1] - second_score) >= 0.3)
                                                   or (len(cands) == 1 and best[1] >= 0.5)))
                    if _dominant:
                        adopt_eid = best[0]
                        _cg = str(memberships.get(adopt_eid, "") or "")
                        if _cg and self.get_group_by_id(_cg):
                            adopt_gid = _cg
            if not gid:
                if adopt_gid:
                    gid = adopt_gid
                    memberships[pid] = gid
                    self.save_groups()
                else:
                    # Create the group NOW -- the ledger must not wait for a request match.
                    gname = re.sub(r"^\s*(?:re|fw|fwd)\s*:\s*", "", subj, flags=re.I)
                    gname = re.sub(r"^\s*p\s*&\s*a\s*[-:]*\s*", "", gname, flags=re.I).strip()[:80] or "Quote job"
                    gid = self._unique_group_id()
                    self.groups_data.setdefault("groups", []).append({
                        "id": gid, "name": gname, "urgency": "Normal", "collapsed": False,
                        "has_new": False, "created_at": datetime.now().isoformat(), "notes": "",
                        "archived": False, "auto_created_reason": "auto_coverage_sent_rfq"})
                    memberships[pid] = gid
                    self.save_groups()
            key = "grp:" + gid
            # v4.1.18 audit: same fold for the just-created/adopted group -- a
            # conversation-keyed ledger from the attachment scan becomes THIS ledger.
            self._coverage_fold_conversation_into_group(
                str(placeholder.get("conversation_id", "") or ""), gid)
            if isinstance(threads.get(key), dict):
                if adopt_gid:
                    # Joined a job that ALREADY has a ledger: the grouping is the win here --
                    # the sent tracker is now filed with its job; the existing ledger is never
                    # touched (its Waiting marks come from the normal outgoing-RFQ hook).
                    self.save_quote_coverage()
                    _cov_debug(f"AUTO-COVERAGE v3: tracker adopted into existing group {gid} "
                               f"(ledger already present; left untouched)")
                    return True
                return False
            added = self.update_coverage_requested(
                key, mats, subject=subj, group_id=gid,
                conversation_id=str(placeholder.get("conversation_id", "") or ""),
                source="rfq_extraction")
            if not added:
                return False
            rec = self.get_coverage_record(key)
            if isinstance(rec, dict):
                aw = rec.setdefault("auto_waiting_keys", [])
                for _it in rec.get("requested", []) or []:
                    _pk = self.coverage_item_primary_key(_it)
                    if _pk and _pk not in aw:
                        aw.append(_pk)
                rec["auto_coverage_created"] = True
                rec["auto_coverage_from_sent_id"] = str(placeholder.get("sent_entry_id", "") or "")
                rec["updated_at"] = datetime.now().isoformat()
            # 3) tie in the ORIGINAL customer request. A real inbound row standing in as the
            # tracker IS the original request; an adopted/dominant candidate links directly;
            # anything ambiguous goes to the picker.
            linked = False
            if self_row is not None:
                linked = self._link_original_request_to_group(pid, gid, key, linked_by="reply_in_thread")
            elif adopt_eid:
                linked = self._link_original_request_to_group(
                    adopt_eid, gid, key, linked_by=(adopt_how or "item_overlap"))
            if not linked:
                # v4.2.78 (Steve): a request that could not be auto-linked also offers
                # EXISTING coverage records (ranked by item-name + quantity evidence)
                # in the picker -- 'which job does this P&A belong to' -- instead of
                # only original-request emails, which are often absent for bare
                # 'P&A' subjects.
                _rec_cands = []
                try:
                    _rec_cands = self._score_coverage_record_candidates(mats, exclude_key=key)
                except Exception:
                    _rec_cands = []
                if cands or _rec_cands:
                    self._queue_request_link_prompt(gid, key, subj, cands[:5],
                                                    record_candidates=_rec_cands[:5])
            self.save_quote_coverage()
            _cov_debug(f"AUTO-COVERAGE v3: group {gid}{' (adopted)' if adopt_gid else ''} ledger created "
                       f"with {added} item(s); candidates={len(cands)} auto_linked={linked}")
            return True
        except Exception:
            return False

    _REQUEST_LINK_SUBJECT_STOPWORDS = frozenset({
        "quote", "quotes", "quotation", "quotes", "request", "requests", "rfq", "pricing",
        "price", "prices", "avail", "availability", "need", "needed", "please", "thanks",
        "thank", "info", "information", "material", "materials", "order", "orders", "job",
        "project", "update", "updated", "asap", "your", "with", "from", "this", "that",
        "have", "here", "attached", "attachment", "urgent", "follow", "following", "regarding",
    })

    @classmethod
    def _subject_words_for_request_link(cls, text):
        """v4.2.1: plain subject WORDS, for the original-request prefilter fallback.

        `extract_group_match_tokens` is a job/PO-CODE extractor -- by design it only
        yields tokens that CONTAIN A DIGIT -- so for a job named in words ('Bayview
        quote P&A', 'NYPA Caddy Quote P&A') it returns an empty set, and any prefilter
        built on it silently does nothing at all. This is the fallback tier: distinctive
        words only (>=4 chars, generic RFQ vocabulary removed), so 'Bayview' matches
        'Bayview' while 'quote' / 'request' / 'P&A' match nothing and cannot drag in
        every quote email in the mailbox.
        """
        try:
            low = re.sub(r"^\s*(?:re|fw|fwd)\s*:\s*", "", str(text or ""), flags=re.I).lower()
            words = set(re.findall(r"[a-z][a-z0-9'&/-]{3,}", low))
            return {w for w in words if w not in cls._REQUEST_LINK_SUBJECT_STOPWORDS}
        except Exception:
            return set()

    @staticmethod
    def _comparable_received_epoch(row):
        """v4.2.2: `received_timestamp` on ONE COMMON BASIS, for comparing an inbound
        row against one of our own sent/placeholder rows.

        MEASURED over the live store (5,703 rows with a parsable display time):

            My Inbox        3573 rows   epoch reads 4h BEHIND the displayed time
            Sales           1539 rows   epoch reads 4h BEHIND the displayed time
            Sent / Waiting   591 rows   epoch MATCHES the displayed time

        i.e. every INBOUND row stores a UTC-based epoch while every SENT placeholder
        stores a LOCAL one. Nothing normalises them, so any inbound-vs-sent comparison
        is wrong by the UTC offset (4h on EDT, 5h on EST -- and it moves twice a year).
        Against day-scale thresholds (7/14/21 days) that is noise, but these four call
        sites order events that are MINUTES apart, so it inverts them:
          * a reply arriving within ~4h of our send reads as OLDER than the send, so
            the "only clear when the reply is newer" guard skips it (observed live on
            the Bayview thread: cleared 5 min late by a different path instead);
          * post-send mail reads as pre-send, so it becomes a wrongly-ELIGIBLE
            candidate for the ORIGINAL customer request (observed: the vendor's own
            reply tying the real request at score 1.0).

        Deliberately a READ-TIME accessor: the stored data is left exactly as it is.
        Rewriting `received_timestamp` on 5,703 rows would touch every consumer, some
        of which may be implicitly compensating for the skew today. Keyed on `source`,
        which is the invariant the measurement actually shows -- and it is the same
        signal the surrounding code already uses to tell our own mail from theirs.

        Fails safe: anything unparsable returns 0.0, which every caller already treats
        as "no timestamp available" and skips the comparison entirely.
        """
        try:
            if not isinstance(row, dict):
                return 0.0
            ts = float(row.get("received_timestamp", 0) or 0)
            if ts <= 0:
                return 0.0
            # SOURCE alone decides the basis. Deliberately NOT the placeholder flags:
            # a real inbound row ACTIVATED as a tracker keeps source=My Inbox/Sales but
            # carries sender_type="sent_placeholder", and its received_timestamp is still
            # the CUSTOMER's arrival time on the UTC basis (the v4.1.86 case). Keying on
            # those flags left 12 such rows in the live store unshifted and still 4h wrong;
            # the flags mark the tracker ROLE, not the time basis.
            src = str(row.get("source", "") or "").strip().lower()
            if src.startswith("sent"):
                return ts                      # already on the local basis
            # Inbound: shift onto the same basis the sent rows use. The offset is taken
            # AT that timestamp, so DST is handled rather than assumed.
            offset = (datetime.fromtimestamp(ts) - datetime.utcfromtimestamp(ts)).total_seconds()
            return ts - offset
        except Exception:
            return 0.0

    def _score_original_request_candidates(self, rec, placeholder):
        """v4.1.12: rank inbound emails as the likely ORIGINAL customer request for a coverage
        ledger, by how many of the requested items their body contains (gated item matching --
        the same evidence bar the flip uses). Returns [(entry_id, score, label, hits), ...] best
        first. score = matched requested items / total requested. Conservative candidacy: needs
        >=2 gated hits (>=1 when the job has a single line). Only inbound, non-placeholder mail
        received BEFORE the RFQ was sent, within 21 days; body loads capped at 15 (subject-token
        prefilter orders the queue so likely matches load first)."""
        out = []
        try:
            requested = (rec or {}).get("requested", []) or []
            if not requested:
                return out
            need = 2 if len(requested) >= 2 else 1
            common = _coverage_record_common_tokens(requested)
            try:
                # v4.2.2: both sides go through _comparable_received_epoch so the
                # inbound (UTC-based) and sent (local-based) epochs are on ONE basis.
                sent_ts = self._comparable_received_epoch(placeholder)
            except Exception:
                sent_ts = 0.0
            cutoff_ts = sent_ts - 21 * 86400 if sent_ts else 0.0
            subj_tokens = extract_group_match_tokens(str(placeholder.get("subject", "") or ""))
            # v4.2.1: subj_tokens is EMPTY for any job named in words, because
            # extract_group_match_tokens only returns digit-bearing job/PO codes. `pre` was
            # then 0 for every single email and this pool silently degraded to pure
            # reverse-chronological order. Measured on the reported Bayview thread: pool of
            # 1,736 with pre=1 on ZERO of them, so the 15-body-load budget went to whatever
            # was newest -- four of our OWN outbound P&A messages and four marketing emails
            # -- while the actual customer request (a 3/3 item match) sat at rank 27 and was
            # never read. No candidate meant no link AND no picker prompt.
            subj_words = self._subject_words_for_request_link(placeholder.get("subject", ""))
            ph_conv = str((placeholder or {}).get("conversation_id", "") or "")
            pool = []
            for e in getattr(self, "emails", []) or []:
                if not isinstance(e, dict) or e.get("is_sent_waiting_placeholder"):
                    continue
                if e.get("sender_type") == "sent_placeholder":
                    continue
                # v4.2.1: our OWN outbound can never be the customer's original request. The
                # placeholder flag above does NOT catch these rows (it is unset on them), so
                # the scan was spending budget reading our own sent RFQs -- including the very
                # placeholder it is trying to find the request for.
                if str(e.get("source", "") or "").strip().lower().startswith("sent"):
                    continue
                # v4.2.1: a message inside OUR OWN RFQ thread cannot be the request that
                # prompted that RFQ. This matters because the time filter below cannot be
                # trusted to exclude it: received_timestamp is stored inconsistently --
                # inbound rows carry UTC while the sent placeholder carries local time, so on
                # the reported thread the vendor's 08:25 reply reads as ts 04:25 against the
                # placeholder's 07:27 and therefore looks like it PREDATES the RFQ. Without
                # this guard that reply tied the real customer request at score 1.0 and was
                # offered as a candidate for "the original customer request". Keyed on
                # ConversationID -- identity, not similarity. (The timestamp skew itself is a
                # separate defect and is deliberately NOT addressed here.)
                if ph_conv and str(e.get("conversation_id", "") or "") == ph_conv:
                    continue
                ts = self._comparable_received_epoch(e)          # v4.2.2: same basis
                if sent_ts and not (cutoff_ts <= ts <= sent_ts + 60):
                    continue
                # Two tiers: a shared job/PO CODE still outranks everything (unchanged for
                # numbered jobs); a shared distinctive subject WORD is the new fallback.
                if subj_tokens and (subj_tokens & extract_group_match_tokens(e.get("subject", ""))):
                    pre = 2
                elif subj_words and (subj_words & self._subject_words_for_request_link(e.get("subject", ""))):
                    pre = 1
                else:
                    pre = 0
                pool.append((pre, ts, e))
            pool.sort(key=lambda t: (-t[0], -t[1]))
            loads = 0
            attempts = 0
            for _pre, _ts, e in pool:
                body = str(e.get("body", "") or "")
                if not body.strip():
                    # v4.2.1: a load that comes back EMPTY -- EntryID drift under Cached
                    # Exchange Mode ("Could not open the item"), a permission error, or
                    # genuinely empty mail -- used to burn one of the 15 slots. Only a load
                    # that actually produced text counts now; a separate attempt ceiling
                    # still bounds the COM work so this cannot walk the whole mailbox.
                    if loads >= 15 or attempts >= 40:
                        continue
                    attempts += 1
                    try:
                        body = str(self.load_body_for_rfq(e) or "")
                    except Exception:
                        body = ""
                    if not body.strip():
                        continue
                    loads += 1
                # v4.2.1: match the email LINE BY LINE instead of as one blob.
                # _coverage_distinctive_match_ok is a LINE-vs-LINE precision gate whose final
                # test is a Jaccard >= 0.6 overlap of distinctive product tokens. Jaccard is
                # SYMMETRIC, so comparing a three-word requested line against a whole email
                # body puts an enormous token set on one side and the ratio can essentially
                # never reach 0.6. Measured on the reported Bayview request: coverage_items_match
                # returned True for all three items and this gate then vetoed all three, so an
                # email containing every ledger line verbatim scored ZERO hits. Feeding it one
                # body line at a time restores the contract the gate was designed for, and the
                # same request now scores 3/3 on the exact lines that carry the items.
                blob_lines = [{"description": _ln.strip()}
                              for _ln in (str(e.get("subject", "") or "") + "\n" + body)[:20000].splitlines()
                              if _ln.strip()][:400]
                hits = 0
                for req in requested:
                    for _bl in blob_lines:
                        try:
                            if coverage_items_match(req, _bl) and _coverage_distinctive_match_ok(req, _bl, common):
                                hits += 1
                                break
                        except Exception:
                            continue
                if hits < need:
                    continue
                score = hits / float(len(requested))
                label = f"{e.get('sender','')} \u2014 {str(e.get('subject',''))[:60]} ({e.get('received','')})"
                out.append((e.get("entry_id", ""), round(score, 3), label, hits))
            out.sort(key=lambda t: (-t[1], -t[3]))
        except Exception:
            pass
        return out

    def _link_original_request_to_group(self, request_entry_id, gid, key, linked_by="item_overlap_or_manual"):
        """v4.1.12: tie a found original request into the job -- membership (only when the email
        is not already in a DIFFERENT group), plus customer/subject on the ledger.

        v4.1.79: also records STRUCTURED LINEAGE on the ledger -- how this link was made
        (linked_by signal), when, and the request's drift-proof identity (Internet
        Message-ID alongside the EntryID). Additive keys only: the coverage file is
        load-bearing production data with a deliberately SYNC save, so the existing
        shape is never rewritten, and readers that do not know 'lineage' ignore it."""
        try:
            if not request_entry_id:
                return False
            em = self.get_email_by_id(request_entry_id)
            if not em:
                return False
            memberships = self.groups_data.setdefault("memberships", {})
            cur = str(memberships.get(request_entry_id, "") or "")
            if cur and cur != gid and self.get_group_by_id(cur):
                return False          # respect an existing grouping -- never move it
            memberships[request_entry_id] = gid
            self.save_groups()
            rec = self.get_coverage_record(key)
            if isinstance(rec, dict):
                rec["customer"] = str(em.get("sender", "") or "") or rec.get("customer", "")
                _ce = extract_email_address(em.get("sender_email", "") or "")
                if _ce:
                    rec["customer_email"] = _ce
                _sj = str(em.get("subject", "") or "")
                if _sj:
                    rec["subject"] = _sj
                rec["original_request_entry_id"] = request_entry_id
                rec["lineage"] = {
                    "request_entry_id": request_entry_id,
                    "request_msg_id": str(em.get("internet_message_id", "") or ""),
                    "request_sender": extract_email_address(em.get("sender_email", "") or ""),
                    "linked_by": str(linked_by or ""),
                    "linked_at": datetime.now().isoformat(),
                }
                rec["updated_at"] = datetime.now().isoformat()
                self.save_quote_coverage()
            try:
                ops_log("coverage", "request_linked", key=str(key)[-40:], gid=str(gid),
                        how=str(linked_by or ""), req=str(request_entry_id)[-16:],
                        sender=str(em.get("sender_email", "") or "")[:50])
            except Exception:
                pass
            _cov_debug(f"AUTO-COVERAGE v2: original request {request_entry_id[:18]}... linked into group {gid} ({linked_by})")
            return True
        except Exception:
            return False

    def _group_vendor_recipients(self, gid, conversation_id=""):
        """v4.1.80: the vendor addresses/domains this job's RFQs were SENT TO, from the
        sent/waiting trackers grouped with it (or sharing its conversation). Used to
        keep pairing from ever linking a VENDOR REPLY as the 'original customer
        request': v4.1.79's retro-heal trusted the triage-stamped email_type C on two
        vendor replies (sales@allfasteners.com, m_roche@gumcash.com) and mislinked
        them -- the sender we asked for pricing can never be the customer who asked us."""
        addrs, domains, names = set(), set(), set()
        try:
            memberships = self.groups_data.get("memberships", {})
            conv = str(conversation_id or "").strip().lower()
            for p in getattr(self, "sent_waiting_placeholders", []) or []:
                if not isinstance(p, dict):
                    continue
                same_group = gid and str(memberships.get(p.get("entry_id", ""), "") or "") == gid
                same_conv = conv and str(p.get("conversation_id", "") or "").strip().lower() == conv
                if not (same_group or same_conv):
                    continue
                for field in ("recipient_smtp", "sender_email", "sender"):
                    for piece in re.split(r"[;,]", str(p.get(field, "") or "")):
                        piece = piece.strip()
                        if not piece:
                            continue
                        a = extract_email_address(piece).lower()
                        if a and "@" in a:
                            addrs.add(a)
                            domains.add(a.split("@", 1)[1])
                        elif "@" not in piece:
                            # v4.1.81: pre-v4.1.77 trackers store the recipient as a
                            # DISPLAY NAME only ("M Roche") -- keep it for name matching,
                            # because for those rows the address sets stay empty and the
                            # v4.1.80 exclusion silently never fired (the second mislink).
                            nm = re.sub(r"[^a-z0-9 ]+", " ", piece.lower()).strip()
                            if len(nm) >= 5:
                                names.add(nm)
        except Exception:
            pass
        return addrs, domains, names

    def _sender_disqualified_as_customer(self, email_row, vendor_addrs, vendor_domains,
                                         vendor_names=(), before_ts=0.0):
        """v4.1.80/81: True when this email's sender cannot be the original CUSTOMER:
        it is one of the vendors this job's RFQs were sent to (address or domain, or --
        v4.1.81 -- a DISPLAY-NAME match, because pre-v4.1.77 trackers carry no SMTP and
        the address sets alone let two vendor replies through twice), a durably-typed
        V/E/M sender, our own internal mail, or -- the decisive, data-independent gate --
        mail that arrived AFTER the RFQ went out (before_ts): the original request
        always PRECEDES the send; anything later in scope is a vendor-side reply. The
        triage-stamped email_type on a row is advisory and is NOT trusted here."""
        try:
            if before_ts:
                try:
                    _ts = float(email_row.get("received_timestamp", 0) or 0)
                except Exception:
                    _ts = 0.0
                if _ts and _ts > float(before_ts) + 60:
                    return True
            addr = extract_email_address(str(email_row.get("sender_email", "") or "")).lower()
            if addr and "@" in addr:
                if addr in vendor_addrs:
                    return True
                if addr.split("@", 1)[1] in vendor_domains:
                    return True
                durable = self.get_saved_contact_type(addr)
                if durable in ("V", "E", "M"):
                    return True
            if vendor_names:
                for cand in (str(email_row.get("sender", "") or ""),
                             str(email_row.get("sender_email", "") or "")):
                    nm = re.sub(r"[^a-z0-9 ]+", " ", cand.lower()).strip()
                    if len(nm) < 5:
                        continue
                    for vn in vendor_names:
                        if vn == nm or vn in nm or nm in vn:
                            return True
            try:
                if self._sender_is_internal(email_row):
                    return True
            except Exception:
                pass
            return False
        except Exception:
            return False

    @staticmethod
    def _parse_rfq_job_line(text):
        """v4.1.79: pull (customer_hint, job_hint) out of the sent RFQ's OWN words.
        The user names the job in almost every send -- 'This is for Verde at the LNG
        Plant in Astoria', 'These are for Campbell & Dawes at 1251 6th', 'for Welsbach
        at NYCDEP Oakwood Beach project' -- and until now nothing read it. Conservative:
        first match wins, hints are short, and a miss returns ('','') so callers lose
        nothing."""
        try:
            t = str(text or "")
            m = re.search(
                r"(?i)\b(?:this\s+is|these\s+are)\s+for\s+"
                r"(?P<cust>[A-Za-z][\w&.\-'’ ]{1,40}?)\s+at\s+"
                r"(?P<job>[^\r\n.!?]{3,70})", t)
            if m:
                return (m.group("cust").strip(" .,-"), m.group("job").strip(" .,-"))
            m = re.search(
                r"(?i)\b(?:bid\s+pricing|pricing|price\s+and\s+availability)\s+for\s+"
                r"(?P<cust>[A-Za-z][\w&.\-'’ ]{1,30}?)\s+(?:below|at\s+(?P<job>[^\r\n.!?]{3,70}))", t)
            if m:
                return (m.group("cust").strip(" .,-"), (m.group("job") or "").strip(" .,-"))
            return ("", "")
        except Exception:
            return ("", "")

    def _signal_original_request(self, placeholder, sent_subject="", sent_own_body=""):
        """v4.1.79: find the ORIGINAL customer request for a sent vendor RFQ from cheap,
        COM-free signals, strongest first. Returns (request_eid, group_id, how) with
        empty strings when nothing is UNAMBIGUOUS -- ambiguity always falls through to
        the existing item-overlap scorer / picker rather than guessing.

          S1 conversation ancestry -- the send is a RE:/FW: inside a conversation that
             contains an inbound email: that email IS what the user replied/forwarded.
          S2 job line -- 'This is for <customer> at <job>' in the send's own words,
             matched against non-archived group names (customer token + a job token,
             or two job tokens). Exactly one group qualifies or the signal abstains.
          S3 subject tokens -- the v4.1.63 rule: the sent subject shares >= 2
             distinctive tokens with exactly ONE non-archived group.
        For S2/S3 the request email is the earliest inbound customer (type-C) member
        of the matched group; a group with members from TWO different external senders
        typed C is ambiguous and abstains."""
        try:
            send_ts = 0.0
            try:
                # v4.2.2: one basis for the inbound-vs-sent comparisons below.
                send_ts = self._comparable_received_epoch(placeholder)
            except Exception:
                send_ts = 0.0
            conv = str((placeholder or {}).get("conversation_id", "") or "").strip()
            memberships = self.groups_data.setdefault("memberships", {})

            # v4.1.80: the vendors THIS send/job goes to can never be the customer.
            # The send's own recipient is always excluded (replying inside a vendor
            # thread must not link the vendor's earlier mail as the 'request').
            _v_addrs, _v_domains, _v_names = self._group_vendor_recipients(
                str((placeholder or {}).get("group_id", "") or ""), conversation_id=conv)
            for piece in re.split(r"[;,]", str((placeholder or {}).get("recipient_smtp", "")
                                               or (placeholder or {}).get("sender_email", "") or "")):
                piece = piece.strip()
                a = extract_email_address(piece).lower()
                if a and "@" in a:
                    _v_addrs.add(a)
                    _v_domains.add(a.split("@", 1)[1])
                elif len(piece) >= 5 and "@" not in piece:
                    _v_names.add(re.sub(r"[^a-z0-9 ]+", " ", piece.lower()).strip())

            # ---- S1: conversation ancestry ----
            if conv:
                best = None
                for e in getattr(self, "emails", []) or []:
                    if not isinstance(e, dict) or e.get("is_sent_waiting_placeholder"):
                        continue
                    if e.get("sender_type") == "sent_placeholder":
                        continue
                    if str(e.get("conversation_id", "") or "").strip() != conv:
                        continue
                    if self._sender_disqualified_as_customer(e, _v_addrs, _v_domains,
                                                             vendor_names=_v_names, before_ts=send_ts):
                        continue  # v4.1.80/81: vendor/internal/post-send mail is not the request
                    try:
                        ts = self._comparable_received_epoch(e)   # v4.2.2: vs send_ts
                    except Exception:
                        ts = 0.0
                    if send_ts and ts > send_ts + 60:
                        continue
                    if best is None or ts > best[0]:
                        best = (ts, e)
                if best is not None:
                    eid = str(best[1].get("entry_id", "") or "")
                    if eid:
                        return (eid, str(memberships.get(eid, "") or ""), "conversation_ancestry")

            def _tokens(value):
                try:
                    return set(extract_group_match_tokens(str(value or "")))
                except Exception:
                    return set()

            def _group_request_email(gid):
                """Earliest inbound type-C member; '' if none; None if AMBIGUOUS.
                v4.1.80: members whose sender is one of this job's RFQ vendors (or a
                durable V/E/M, or internal) are excluded BEFORE the type check -- the
                triage-stamped C on a vendor reply mislinked two ledgers in v4.1.79."""
                g_addrs, g_domains, g_names = self._group_vendor_recipients(gid)
                g_addrs |= _v_addrs
                g_domains |= _v_domains
                g_names |= _v_names
                senders = {}
                for eid2, g2 in memberships.items():
                    if g2 != gid:
                        continue
                    em2 = self.get_email_by_id(eid2)
                    if not isinstance(em2, dict) or em2.get("is_sent_waiting_placeholder"):
                        continue
                    if self._sender_disqualified_as_customer(em2, g_addrs, g_domains,
                                                             vendor_names=g_names, before_ts=send_ts):
                        continue
                    code = (self.get_saved_contact_type(em2.get("sender_email", ""))
                            or infer_email_type_code(em2))
                    if code != "C":
                        continue
                    addr = extract_email_address(em2.get("sender_email", "") or "").lower()
                    try:
                        ts2 = float(em2.get("received_timestamp", 0) or 0)
                    except Exception:
                        ts2 = 0.0
                    cur = senders.get(addr)
                    if cur is None or ts2 < cur[0]:
                        senders[addr] = (ts2, str(em2.get("entry_id", "") or ""))
                if not senders:
                    return ""
                if len(senders) > 1:
                    return None
                return list(senders.values())[0][1]

            groups = [g for g in (self.groups_data.get("groups", []) or [])
                      if isinstance(g, dict) and not g.get("archived")]

            # ---- S2: the job line in the user's own words ----
            cust, job = self._parse_rfq_job_line(sent_own_body)
            if cust or job:
                cust_toks = _tokens(cust)
                job_toks = _tokens(job)
                hits = []
                for g in groups:
                    name_toks = _tokens(g.get("name", ""))
                    if not name_toks:
                        continue
                    c_hit = len(cust_toks & name_toks) if cust_toks else 0
                    j_hit = len(job_toks & name_toks) if job_toks else 0
                    if (c_hit and j_hit) or j_hit >= 2 or (c_hit and not job_toks):
                        hits.append(g)
                if len(hits) == 1:
                    gid = str(hits[0].get("id", "") or "")
                    req = _group_request_email(gid)
                    if req is not None:
                        return (req, gid, "job_line")

            # ---- S3: subject tokens vs exactly one group ----
            subj_toks = _tokens(sent_subject or (placeholder or {}).get("subject", ""))
            if len(subj_toks) >= 2:
                hits = [g for g in groups if len(subj_toks & _tokens(g.get("name", ""))) >= 2]
                if len(hits) == 1:
                    gid = str(hits[0].get("id", "") or "")
                    req = _group_request_email(gid)
                    if req is not None:
                        return (req, gid, "subject_tokens")
            return ("", "", "")
        except Exception:
            return ("", "", "")

    def _coverage_retro_heal_lineage(self):
        """v4.1.79 one-time RETRO-HEAL (user-approved: auto-link unambiguous): walk the
        existing coverage ledgers that have items but NO customer link -- 43 of 90 RFQ
        threads in the 21-day audit -- and back-link the original request using COM-free
        signals only (this runs on the MAIN thread via root.after; no Outlook access,
        no body loads):
          a. group_member  -- the group already holds inbound type-C mail from exactly
             one customer; its earliest email is the request. (Grouping often worked
             while pairing did not -- this alone repairs a large share.)
          b. conversation  -- an inbound email shares the ledger's conversation id.
          c. subject_tokens -- exactly one inbound type-C email shares >= 2 distinctive
             subject tokens, received before the ledger existed.
        First unambiguous signal wins; anything else is left for the picker. Every link
        is ops-logged (coverage/retro_heal_linked) and recorded in the ledger's lineage.
        Marker 'lineage_retro_heal_v1' makes this run once; failures leave the marker
        unset so the next boot retries."""
        try:
            cov = getattr(self, "quote_coverage", None)
            if not isinstance(cov, dict) or cov.get("lineage_retro_heal_v3") == 1:
                return
            threads = cov.get("threads", {})
            if not isinstance(threads, dict):
                return
            memberships = self.groups_data.setdefault("memberships", {})
            linked = skipped = 0
            for key, rec in list(threads.items()):
                if not isinstance(rec, dict) or rec.get("dismissed"):
                    continue
                if str(rec.get("customer_email", "") or "").strip():
                    continue
                if not (rec.get("requested") or []):
                    continue
                gid = str(rec.get("group_id", "") or "")
                conv = str(rec.get("conversation_id", "") or "").strip()
                # v4.1.80/81: this job's RFQ vendors can never be its customer, and the
                # original request must PREDATE the ledger (a vendor reply always arrives
                # after the RFQ went out). v1 trusted the triage-stamped C and mislinked
                # two vendor replies; v2's address-only exclusion missed pre-v4.1.77
                # display-name trackers and mislinked the SAME two again -- the time
                # gate closes that class regardless of what identity the tracker holds.
                v_addrs, v_domains, v_names = self._group_vendor_recipients(gid, conversation_id=conv)
                created_ts = 0.0
                try:
                    created_ts = datetime.fromisoformat(
                        str(rec.get("created_at", "") or "").split("+")[0]).timestamp()
                except Exception:
                    created_ts = 0.0
                req_eid, how = "", ""
                # a. group member
                if gid and self.get_group_by_id(gid):
                    senders = {}
                    for eid2, g2 in memberships.items():
                        if g2 != gid:
                            continue
                        em2 = self.get_email_by_id(eid2)
                        if not isinstance(em2, dict) or em2.get("is_sent_waiting_placeholder"):
                            continue
                        if self._sender_disqualified_as_customer(em2, v_addrs, v_domains,
                                                                 vendor_names=v_names, before_ts=created_ts):
                            continue
                        code = (self.get_saved_contact_type(em2.get("sender_email", ""))
                                or infer_email_type_code(em2))
                        if code != "C":
                            continue
                        addr = extract_email_address(em2.get("sender_email", "") or "").lower()
                        try:
                            ts2 = float(em2.get("received_timestamp", 0) or 0)
                        except Exception:
                            ts2 = 0.0
                        cur = senders.get(addr)
                        if cur is None or ts2 < cur[0]:
                            senders[addr] = (ts2, str(em2.get("entry_id", "") or ""))
                    if len(senders) == 1:
                        req_eid, how = list(senders.values())[0][1], "group_member"
                    elif len(senders) > 1:
                        skipped += 1
                        continue  # two customers in one group -- picker territory
                # b. conversation
                if not req_eid:
                    if conv:
                        best = None
                        for e in getattr(self, "emails", []) or []:
                            if not isinstance(e, dict) or e.get("is_sent_waiting_placeholder"):
                                continue
                            if e.get("sender_type") == "sent_placeholder":
                                continue
                            if str(e.get("conversation_id", "") or "").strip() != conv:
                                continue
                            if self._sender_disqualified_as_customer(e, v_addrs, v_domains,
                                                                     vendor_names=v_names, before_ts=created_ts):
                                continue  # v4.1.80/81: vendor/post-send mail in the RFQ thread is not the request
                            try:
                                ts = float(e.get("received_timestamp", 0) or 0)
                            except Exception:
                                ts = 0.0
                            if best is None or ts < best[0]:
                                best = (ts, str(e.get("entry_id", "") or ""))
                        if best is not None and best[1]:
                            req_eid, how = best[1], "conversation"
                # c. subject tokens
                if not req_eid:
                    try:
                        subj_toks = set(extract_group_match_tokens(str(rec.get("subject", "") or "")))
                    except Exception:
                        subj_toks = set()
                    if len(subj_toks) >= 2:
                        cands = []
                        for e in getattr(self, "emails", []) or []:
                            if not isinstance(e, dict) or e.get("is_sent_waiting_placeholder"):
                                continue
                            if self._sender_disqualified_as_customer(e, v_addrs, v_domains,
                                                                     vendor_names=v_names, before_ts=created_ts):
                                continue
                            code = (self.get_saved_contact_type(e.get("sender_email", ""))
                                    or infer_email_type_code(e))
                            if code != "C":
                                continue
                            try:
                                etoks = set(extract_group_match_tokens(str(e.get("subject", "") or "")))
                            except Exception:
                                etoks = set()
                            if len(subj_toks & etoks) >= 2:
                                cands.append(str(e.get("entry_id", "") or ""))
                            if len(cands) > 1:
                                break
                        if len(cands) == 1 and cands[0]:
                            req_eid, how = cands[0], "subject_tokens"
                if req_eid and gid:
                    if self._link_original_request_to_group(req_eid, gid, key, linked_by="retro_heal:" + how):
                        linked += 1
                        try:
                            ops_log("coverage", "retro_heal_linked", key=str(key)[-40:],
                                    how=how, req=str(req_eid)[-16:])
                        except Exception:
                            pass
                else:
                    skipped += 1
            cov["lineage_retro_heal_v3"] = 1
            self.save_quote_coverage()
            try:
                ops_log("coverage", "retro_heal_done", linked=linked, skipped=skipped)
            except Exception:
                pass
        except Exception:
            pass

    def _queue_request_link_prompt(self, gid, key, subject, candidates, record_candidates=None):
        """v4.1.12: remember that this new auto-created coverage still needs its original request
        picked by the user. The scan runs on a WORKER thread, so no UI here -- the queue is drained
        on the main thread by _process_pending_request_link_prompts() after the scan repaints.
        v4.2.78: record_candidates carries existing coverage records as pickable homes too."""
        try:
            q = getattr(self, "_pending_request_link_prompts", None)
            if not isinstance(q, list):
                q = []
                self._pending_request_link_prompts = q
            if any(isinstance(p, dict) and p.get("gid") == gid for p in q):
                return
            q.append({"gid": gid, "key": key, "subject": str(subject or ""),
                      "candidates": list(candidates or []),
                      "record_candidates": list(record_candidates or []),
                      "created_at": datetime.now().isoformat()})
        except Exception:
            pass

    def _score_coverage_record_candidates(self, mats, exclude_key=""):
        """v4.2.78 (Steve): rank EXISTING coverage records as the likely home for a sent
        RFQ that could not be auto-linked -- the bare-'P&A'-subject case. Evidence is the
        same gated item matcher every flip uses (name match through the distinctive-noun
        gate), with a bonus for an exact quantity match, so similar-sounding text can
        never outrank a real line hit. Returns [(thread_key, score, label, hits), ...]
        best first, capped at 8. Read-only; safe on the worker thread."""
        out = []
        try:
            mats = [m for m in (mats or []) if isinstance(m, dict)]
            if not mats:
                return out

            def _qty_eq(a, b):
                try:
                    return abs(float(str(a).replace(",", "").strip())
                               - float(str(b).replace(",", "").strip())) < 0.01
                except Exception:
                    return False

            threads = (getattr(self, "quote_coverage", {}) or {}).get("threads", {})
            for tkey, rec in list(threads.items()):
                if not isinstance(rec, dict) or rec.get("dismissed") or tkey == exclude_key:
                    continue
                requested = rec.get("requested", []) or []
                if not requested:
                    continue
                common = _coverage_record_common_tokens(requested)
                hits = 0
                qty_hits = 0
                for req in requested:
                    for m in mats:
                        try:
                            if coverage_items_match(req, m) and _coverage_distinctive_match_ok(req, m, common):
                                hits += 1
                                if _qty_eq(req.get("qty", ""), m.get("qty", "")):
                                    qty_hits += 1
                                break
                        except Exception:
                            continue
                if not hits:
                    continue
                score = min(1.0, (hits + 0.5 * qty_hits) / float(max(1, len(mats))))
                label = (str(rec.get("subject", "") or rec.get("customer", "") or tkey)[:70]
                         + " (%d of %d item(s), %d qty match)" % (hits, len(mats), qty_hits))
                out.append((tkey, score, label, hits))
            out.sort(key=lambda c: (-c[1], -c[3]))
        except Exception:
            pass
        return out[:8]

    def _resolve_record_link_choice(self, gid, key, target_key):
        """v4.2.78 (Steve): the user picked an EXISTING coverage record as the home of an
        unlinkable sent RFQ. Adopt that record's group (move this auto group's members --
        the tracker -- over), flip the record's matching requested items to Waiting (same
        guards as the outgoing-request hook: manual status, manual-done and quoted all
        win), append any request line the record does not already have, absorb the auto
        ledger's processed-sent bookkeeping, drop the auto ledger and retire the
        now-empty auto-created group. Deliberately does NOT blind-merge requested rows:
        the request's lines are usually the record's own lines re-typed (often with
        typos), and a lossless merge would shelve near-duplicates."""
        try:
            threads = self.quote_coverage.setdefault("threads", {})
            target = threads.get(target_key)
            if not isinstance(target, dict) or target_key == key:
                return False
            tgid = str(target.get("group_id", "") or "")
            if not tgid and str(target_key).startswith("grp:"):
                tgid = str(target_key)[4:]
            if tgid and not self.get_group_by_id(tgid):
                tgid = ""
            memberships = self.groups_data.setdefault("memberships", {})
            if tgid and tgid != gid:
                for _eid, _g in list(memberships.items()):
                    if _g == gid:
                        memberships[_eid] = tgid
            src = threads.pop(key, None)
            if isinstance(src, dict):
                req_t = target.setdefault("requested", [])
                if not isinstance(req_t, list):
                    req_t = target["requested"] = []
                common = _coverage_record_common_tokens(req_t)
                aw = target.setdefault("auto_waiting_keys", [])
                if not isinstance(aw, list):
                    aw = target["auto_waiting_keys"] = []
                item_status = target.get("item_status", {}) if isinstance(target.get("item_status"), dict) else {}
                manual_done = set(target.get("manual_done_keys", []) or [])
                quoted = target.get("quoted", []) or []
                for m in (src.get("requested", []) or []):
                    if not isinstance(m, dict):
                        continue
                    match_req = None
                    for req in req_t:
                        try:
                            if coverage_items_match(req, m) and _coverage_distinctive_match_ok(req, m, common):
                                match_req = req
                                break
                        except Exception:
                            continue
                    if match_req is None:
                        # v4.2.80 (live rig 0822B): SECOND-CHANCE loose match before
                        # appending. The user just re-typed their own lines from memory
                        # ("200A meter sockets" / '4" square 1900 boxes'), and the
                        # strict distinctive-noun gate -- built to keep MONEY off the
                        # wrong line -- fails on plural/word-order drift, so both rows
                        # were appended as near-duplicates. For the "is this line
                        # already on the job?" question, plain coverage_items_match is
                        # the right bar: the cost of looseness is skipping a dupe
                        # append; the cost of strictness is creating one.
                        for req in req_t:
                            try:
                                if coverage_items_match(req, m):
                                    match_req = req
                                    break
                            except Exception:
                                continue
                    if match_req is None:
                        req_t.append(m)          # a genuinely new line for this job
                        match_req = m
                    pk = self.coverage_item_primary_key(match_req)
                    if (pk and pk not in aw
                            and not str(item_status.get(pk, "") or "")
                            and not (coverage_item_keys(match_req) & manual_done)
                            and not any(coverage_items_match(match_req, q) for q in quoted)):
                        aw.append(pk)
                for field in ("processed_sent_ids",):
                    d = target.setdefault(field, [])
                    if not isinstance(d, list):
                        d = target[field] = []
                    have = set(d)
                    for v in (src.get(field, []) or []):
                        if v not in have:
                            d.append(v)
                            have.add(v)
                target["updated_at"] = datetime.now().isoformat()
            _g_list = self.groups_data.get("groups", [])
            _auto = next((g for g in _g_list if g.get("id") == gid), None)
            if (_auto and _auto.get("auto_created_reason") == "auto_coverage_sent_rfq"
                    and not any(v == gid for v in memberships.values())):
                self.groups_data["groups"] = [g for g in _g_list if g.get("id") != gid]
            self.save_groups()
            self.save_quote_coverage()
            ops_log("coverage", "pa_group_pick_record", target=str(target_key)[:40],
                    from_group=str(gid), moved=bool(tgid))
            _cov_debug(f"PA-PICKER: sent RFQ linked into existing record {target_key} (group {tgid or 'kept'})")
            return True
        except Exception:
            return False

    def _resolve_request_link_choice(self, gid, key, cand_eid):
        """v4.1.14: apply the user's pick from the link-the-original-request dialog. If the chosen
        email is UNGROUPED (or already in this group), link it in place. If it lives in ANOTHER
        group -- the user just told us this job belongs THERE -- adopt that group: move this auto
        group's members (the tracker) over, merge/re-key the ledger to grp:<target> (lossless via
        _merge_coverage_records when one exists), fill customer from the pick, and retire the now
        empty auto-created group. Never moves the chosen email itself."""
        try:
            if not cand_eid:
                return False
            memberships = self.groups_data.setdefault("memberships", {})
            cur = str(memberships.get(cand_eid, "") or "")
            if not cur or cur == gid or not self.get_group_by_id(cur):
                return self._link_original_request_to_group(cand_eid, gid, key)
            # --- adopt the candidate's group ---
            for _eid, _g in list(memberships.items()):
                if _g == gid:
                    memberships[_eid] = cur
            threads = self.quote_coverage.setdefault("threads", {})
            src = threads.pop(key, None)
            tkey = "grp:" + cur
            if isinstance(src, dict):
                src["group_id"] = cur
                src["thread_key"] = tkey
                if isinstance(threads.get(tkey), dict):
                    self._merge_coverage_records(threads[tkey], src)
                else:
                    threads[tkey] = src
            em = self.get_email_by_id(cand_eid)
            rec = threads.get(tkey)
            if em and isinstance(rec, dict):
                rec["customer"] = str(em.get("sender", "") or "") or rec.get("customer", "")
                _ce = extract_email_address(em.get("sender_email", "") or "")
                if _ce:
                    rec["customer_email"] = _ce
                rec["original_request_entry_id"] = cand_eid
                rec["updated_at"] = datetime.now().isoformat()
            _g_list = self.groups_data.get("groups", [])
            _auto = next((g for g in _g_list if g.get("id") == gid), None)
            if (_auto and _auto.get("auto_created_reason") == "auto_coverage_sent_rfq"
                    and not any(v == gid for v in memberships.values())):
                self.groups_data["groups"] = [g for g in _g_list if g.get("id") != gid]
            self.save_groups()
            self.save_quote_coverage()
            _cov_debug(f"AUTO-COVERAGE v3: user pick adopted existing group {cur}; auto group {gid} folded in")
            return True
        except Exception:
            return False

    def _process_pending_request_link_prompts(self):
        """v4.1.12: MAIN-thread drain of the link-the-original-request queue. One simple picker
        per pending job: the top candidates (best first, with their match strength), Link / Skip.
        Skip leaves the job fully functional (group + tracker + ledger) -- the request can always
        be added to the group by hand later."""
        item = None
        q = None
        try:
            q = getattr(self, "_pending_request_link_prompts", None)
            if not isinstance(q, list) or not q:
                return
            item = q.pop(0)
            gid = item.get("gid", "")
            key = item.get("key", "")
            cands = [c for c in (item.get("candidates") or []) if c and c[0]]
            rec_cands = [c for c in (item.get("record_candidates") or []) if c and c[0]]
            if not gid or (not cands and not rec_cands):
                self.root.after(200, self._process_pending_request_link_prompts)
                return
            # v4.2.78: one ranked list of BOTH kinds of home -- existing coverage
            # records ("jobs") and original-request emails -- best evidence first.
            entries = ([("rec", c[0], float(c[1] or 0), str(c[2] or "")) for c in rec_cands]
                       + [("email", c[0], float(c[1] or 0), str(c[2] or "")) for c in cands])
            entries.sort(key=lambda e: -e[2])
            # v4.1.19 AUDIT FIX (external audit finding #1): this dialog referenced
            # undefined names (BG_COLOR/FG_COLOR/ENTRY_BG/BUTTON_BG -- the real theme
            # globals are _BG/_FG/_ENTRY_BG/_BTN_BG), so construction died on NameError,
            # the blanket except swallowed it, and because the item was popped first the
            # linking opportunity was silently discarded. The picker NEVER worked. Fixed
            # names; construction failures are now logged and the item is re-queued
            # (bounded retries) instead of vanishing.
            win = tk.Toplevel(self.root)
            win.title("Quote Coverage \u2014 link the original request")
            win.configure(bg=_BG)
            win.transient(self.root)
            tk.Label(win, text=("A quote request was sent:\n" + str(item.get("subject", ""))[:90]
                                + "\n\nWhich job or original request does it belong to?"),
                     bg=_BG, fg=_FG, justify="left").pack(anchor="w", padx=12, pady=(10, 6))
            lb = tk.Listbox(win, width=100, height=min(8, max(3, len(entries))),
                            bg=_ENTRY_BG, fg=_FG, selectbackground="#4a6ea9")
            for _kind, _tid, _score, _label in entries:
                try:
                    _pfx = "Existing job" if _kind == "rec" else "Request email"
                    lb.insert("end", f"{int(round(_score * 100))}% \u2014 {_pfx}: {_label}")
                except Exception:
                    lb.insert("end", str(_label))
            lb.pack(fill="both", expand=True, padx=12, pady=4)
            lb.selection_set(0)
            btns = tk.Frame(win, bg=_BG)
            btns.pack(fill="x", padx=12, pady=(6, 10))

            def _done_next():
                try:
                    win.destroy()
                except Exception:
                    pass
                self.root.after(200, self._process_pending_request_link_prompts)

            def _do_link(event=None):
                try:
                    sel = lb.curselection()
                    if sel:
                        _kind, _tid = entries[sel[0]][0], entries[sel[0]][1]
                        ok = (self._resolve_record_link_choice(gid, key, _tid) if _kind == "rec"
                              else self._resolve_request_link_choice(gid, key, _tid))
                        if ok:
                            try:
                                self.render_group_rows()
                            except Exception:
                                pass
                except Exception:
                    pass
                _done_next()

            tk.Button(btns, text="Link selected", command=_do_link,
                      bg="#2f6feb", fg="white").pack(side="right", padx=4)
            # v4.2.78: 'Skip' renamed -- what it always did IS keeping the auto-created
            # group, which is the 'create a new group' choice in this dialog.
            tk.Button(btns, text="Keep as new group", command=_done_next,
                      bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
            win.protocol("WM_DELETE_WINDOW", _done_next)
            # v4.2.78: standing rule -- Enter confirms (link the selected row),
            # Escape keeps the new group; the list has focus so arrows work.
            win.bind("<Return>", _do_link)
            win.bind("<Escape>", lambda _e=None: _done_next())
            try:
                win.lift()
                win.focus_force()
                lb.focus_set()
            except Exception:
                pass
        except Exception as _link_exc:
            # v4.1.19: never silently discard a linking opportunity. Log it and re-queue
            # the item (max 3 attempts) so a transient construction failure retries.
            _cov_debug(f"REQUEST-LINK picker failed to open: {_link_exc!r}")
            try:
                if isinstance(item, dict):
                    item["_retries"] = int(item.get("_retries", 0) or 0) + 1
                    if item["_retries"] <= 3 and isinstance(q, list):
                        q.append(item)
                        self.root.after(1500, self._process_pending_request_link_prompts)
            except Exception:
                pass

    def _find_request_email_for_tracker(self, placeholder):
        """v3.9.89: for a tracker on an email sent directly from Outlook (no tracked_entry_id link),
        find the originating customer request by shared job/PO/project key -- the 'customer name +
        job name/#' match. Conservative: needs a strong shared token from extract_group_match_tokens;
        returns None (leave it for manual grouping) when nothing matches."""
        try:
            tracker_tokens = extract_group_match_tokens(placeholder.get("subject", ""))
            if not tracker_tokens:
                return None
            best = None
            best_hits = 0
            best_ts = 0.0
            for e in getattr(self, "emails", []) or []:
                if not isinstance(e, dict) or e.get("is_sent_waiting_placeholder"):
                    continue
                if e.get("sender_type") == "sent_placeholder":
                    continue
                if e.get("entry_id", "") == placeholder.get("entry_id", ""):
                    continue
                hits = tracker_tokens & extract_group_match_tokens(
                    " ".join([str(e.get("subject", "") or ""), str(e.get("body", "") or "")[:1200]]))
                if not hits:
                    continue
                ts = float(e.get("received_timestamp", 0) or 0)
                if len(hits) > best_hits or (len(hits) == best_hits and ts > best_ts):
                    best = e
                    best_hits = len(hits)
                    best_ts = ts
            return best
        except Exception:
            return None

    def _maybe_start_diag_bridge(self):
        """v4.1.64: start the localhost diagnostic bridge when MAINBOX_DIAG=1.

        Threading contract (matches the rest of MaINbox):
        - Bridge HTTP threads NEVER touch Tk or COM.
        - Main-thread actions marshal via root.after (run_on_main).
        - Outlook actions run through run_outlook_worker exactly like the scans;
          a busy worker returns 409 to the client instead of queueing.
        - Synthetic emails get entry_id 'diag:<hex>' and never reach Outlook.
        """
        if str(os.environ.get("MAINBOX_DIAG", "")).strip() != "1":
            return
        try:
            import mainbox_diag_bridge as _dbr
        except Exception as e:
            ops_log("diag", "bridge_import_failed", error=repr(e))
            return

        app = self

        def _cb_state():
            trackers = [p for p in (getattr(app, "sent_waiting_placeholders", []) or []) if isinstance(p, dict)]
            return {
                "version": APP_TITLE,
                "sales_category": str(getattr(app, "selected_sales_category", "") or ""),
                "emails_loaded": len(getattr(app, "emails", []) or []),
                "trackers_active": sum(1 for p in trackers if not p.get("cleared")),
                "trackers_cleared": sum(1 for p in trackers if p.get("cleared")),
                "groups": len((getattr(app, "groups_data", {}) or {}).get("groups", []) or []),
                "flags": {
                    "ai_task_running": bool(getattr(app, "ai_task_running", False)),
                    "auto_refresh_running": bool(getattr(app, "auto_refresh_running", False)),
                    "_refresh_running": bool(getattr(app, "_refresh_running", False)),
                    "draft_busy": bool(getattr(app, "draft_busy", False)),
                },
                "sent_folder_state": dict(getattr(app, "_sent_tracker_folder_state", {}) or {}),
                "now": datetime.now().isoformat(timespec="seconds"),
            }

        def _cb_trackers():
            out = []
            for p in list(getattr(app, "sent_waiting_placeholders", []) or []):
                if not isinstance(p, dict):
                    continue
                out.append({k: p.get(k) for k in (
                    "entry_id", "subject", "sender_email", "status", "cleared", "cleared_reason",
                    "created_at", "cleared_at", "conversation_id", "tracked_entry_id")})
            return out

        def _cb_groups():
            gd = getattr(app, "groups_data", {}) or {}
            members = gd.get("memberships", {}) or {}
            counts = {}
            for _eid, _gid in list(members.items()):
                counts[_gid] = counts.get(_gid, 0) + 1
            return {"groups": [{"id": g.get("id"), "name": g.get("name"),
                                "archived": bool(g.get("archived")),
                                "members": counts.get(g.get("id"), 0)}
                               for g in (gd.get("groups", []) or []) if isinstance(g, dict)],
                    "total_memberships": len(members)}

        def _cb_emails(n, q):
            ql = str(q or "").lower()
            rows = []
            for e in sorted(list(getattr(app, "emails", []) or []),
                            key=lambda x: x.get("received_timestamp", 0) if isinstance(x, dict) else 0,
                            reverse=True):
                if not isinstance(e, dict):
                    continue
                if ql and ql not in str(e.get("subject", "")).lower() and ql not in str(e.get("sender_email", "")).lower():
                    continue
                rows.append({k: e.get(k) for k in (
                    "entry_id", "subject", "sender_email", "source", "category", "urgency",
                    "status", "email_type", "received", "is_sent_waiting_placeholder")})
                if len(rows) >= n:
                    break
            return rows

        def _cb_coverage(job):
            # v4.2.78: the store keys records under "threads" (thread_key -> record);
            # "jobs" was a schema that never shipped, so this endpoint always returned
            # an empty list -- caught while verifying the v4.2.77 injections.
            cov = getattr(app, "quote_coverage", {}) or {}
            threads = cov.get("threads", {}) if isinstance(cov, dict) else {}
            if job:
                return {"job": job, "data": threads.get(job)}
            out = []
            for tkey, r in list(threads.items()):
                if not isinstance(r, dict):
                    continue
                out.append({"job": tkey,
                            "label": str(r.get("subject", "") or r.get("customer", "") or "")[:90],
                            "items": len(r.get("requested", []) or []),
                            "quoted": len(r.get("quoted", []) or []),
                            "dismissed": bool(r.get("dismissed"))})
            return {"jobs": out}

        # ---- v4.2.10 PHASE 1 DIAGNOSTIC SURFACE (READ ONLY) ----------------------
        # Every callback below only READS in-memory state, exactly like _cb_state /
        # _cb_groups above. Nothing mutates, nothing touches COM, nothing sends. They
        # exist because diagnosing a single row has meant hand-assembling the same
        # facts out of four stores and several greps every time.

        def _cb_why(eid):
            """Full decision trace for ONE row: what it is, who decided its status,
            which learned rule applied and at what confidence, how it got into its
            group, its tracker state, its coverage linkage, and the ops-log lines that
            mention it. This is the query that would have answered the 1598 PT
            'why is a vendor quote Needs Reply' question in one call."""
            eid = str(eid or "").strip()
            if not eid:
                return {"error": "eid required"}
            row = None
            for e in (getattr(app, "emails", []) or []):
                if isinstance(e, dict) and str(e.get("entry_id", "")) == eid:
                    row = e
                    break
            saved = (getattr(app, "status_data", {}) or {}).get(eid)
            if row is None and isinstance(saved, dict):
                row = dict(saved, entry_id=eid)
            if row is None:
                # allow a suffix match so a short id from the ops log is usable
                for k, v in (getattr(app, "status_data", {}) or {}).items():
                    if k.endswith(eid) and isinstance(v, dict):
                        eid, row = k, dict(v, entry_id=k)
                        break
            if row is None:
                return {"error": "no row for that entry_id", "eid": eid}

            addr = str(row.get("resolved_sender_smtp") or row.get("sender_email") or "").lower()
            domain = addr.split("@", 1)[1] if "@" in addr else ""
            # v4.2.11: the attribute is learning_data (12250). Reading "learning_rules"
            # silently returned {} and /why reported NO domain rule for brazill.com --
            # when that rule is exactly what explains the mistyping.
            lr = getattr(app, "learning_data", {}) or {}
            sender_rule = (lr.get("senders", {}) or {}).get(addr)
            domain_rule = (lr.get("domains", {}) or {}).get(domain)
            contacts = {}
            try:
                contacts = (app._load_contact_types() or {}).get("contacts", {})
            except Exception:
                contacts = {}

            gid = ""
            try:
                gid = app.get_group_id_for_email(eid) or ""
            except Exception:
                gid = ""
            group = None
            try:
                group = app.get_group_by_id(gid) if gid else None
            except Exception:
                group = None

            cov = None
            try:
                rec = (getattr(app, "quote_coverage", {}) or {}).get("threads", {}).get("grp:" + gid)
                if isinstance(rec, dict):
                    reqs = rec.get("requested") or []
                    quoted = {str(q.get("description", ""))[:40] for q in (rec.get("quoted") or [])}
                    cov = {"requested": len(reqs), "quoted": len(rec.get("quoted") or []),
                           "fully_quoted": bool(reqs) and all(
                               str(r.get("description", ""))[:40] in quoted for r in reqs),
                           "dismissed": bool(rec.get("dismissed"))}
            except Exception:
                cov = None

            ops = []
            try:
                short = eid[-16:]
                for rec in (app._diag_bridge.read_opslog_tail(4000) if getattr(app, "_diag_bridge", None) else []):
                    blob = json.dumps(rec, default=str)
                    if short in blob:
                        ops.append(rec)
                ops = ops[-40:]
            except Exception:
                ops = []

            return {
                "entry_id": eid,
                # v4.2.11: report WHERE each fact came from. The LIVE row and the SAVED
                # record can disagree -- thread_group_rule is persisted but missing from
                # the working set -- and that disagreement is itself the diagnosis.
                "source_of_row": ("live+saved" if isinstance(saved, dict) else "live-only"),
                "live_vs_saved_differs": sorted(
                    k for k in ("status", "email_type", "urgency", "category",
                                "thread_group_rule", "sent_waiting_tracker_active")
                    if isinstance(saved, dict) and row.get(k) != saved.get(k)),
                "row": {k: row.get(k) for k in (
                    "subject", "sender", "sender_email", "resolved_sender_smtp", "source",
                    "status", "email_type", "urgency", "category", "received",
                    "received_timestamp", "conversation_id", "internet_message_id",
                    "updated_at", "workflow_closed_at", "app_deleted", "ai_user_locked",
                    "ai_triage_reason", "ai_triaged_at", "sender_type", "sender_intent",
                    "business_relevance", "spam_likelihood", "learned_rule_source",
                    "thread_group_rule", "sent_waiting_tracker_active",
                    "sent_waiting_tracker_group_name", "followup_blocked_reason",
                    "rescued_at", "reactivation_reason")},
                "typing": {
                    "address": addr, "domain": domain,
                    "contact_registry": contacts.get(addr),
                    "sender_rule": sender_rule,
                    "domain_rule": domain_rule,
                    "durable_type": (app._durable_email_type_for_email(row)
                                     if hasattr(app, "_durable_email_type_for_email") else None),
                },
                "clamps": {
                    "is_reply_on_our_sent_rfq_thread":
                        app._reply_is_on_our_sent_rfq_thread(row)
                        if hasattr(app, "_reply_is_on_our_sent_rfq_thread") else None,
                    "sender_is_do_not_reply":
                        app._sender_is_do_not_reply(row)
                        if hasattr(app, "_sender_is_do_not_reply") else None,
                },
                "group": ({"id": gid, "name": group.get("name"), "archived": group.get("archived"),
                           "auto_created_reason": group.get("auto_created_reason"),
                           "reactivated_at": group.get("reactivated_at"),
                           "members": len(app.get_emails_for_group(gid) or [])}
                          if group else {"id": gid or None}),
                "coverage": cov,
                "ops_log": ops,
            }

        def _cb_rules(addr):
            """Learned sender + domain rules and the contact registry for one address --
            with the CONFIDENCE, which is what explains a rule that looks right but is
            not being applied (brazill.com: correct 'V' at confidence 0.4)."""
            addr = str(addr or "").strip().lower()
            lr = getattr(app, "learning_data", {}) or {}  # v4.2.11: was learning_rules
            domain = addr.split("@", 1)[1] if "@" in addr else addr
            try:
                contacts = (app._load_contact_types() or {}).get("contacts", {})
            except Exception:
                contacts = {}
            return {
                "address": addr, "domain": domain,
                "contact_registry": contacts.get(addr),
                "sender_rule": (lr.get("senders", {}) or {}).get(addr),
                "domain_rule": (lr.get("domains", {}) or {}).get(domain),
                "followup_rule": (lr.get("followups", {}) or {}).get("sender:" + addr)
                                  or (lr.get("followups", {}) or {}).get("domain:" + domain),
                "siblings": {k: {"email_type": v.get("email_type"), "status": v.get("status")}
                             for k, v in list((lr.get("senders", {}) or {}).items())
                             if domain and k.endswith("@" + domain)},
            }

        def _cb_settings():
            """Effective settings, so a diagnosis never has to guess which toggles are
            live (quote_completion_autocleanup_enabled, rfq_use_smartscan, ...)."""
            s = dict(getattr(app, "settings", {}) or {})
            return {k: s[k] for k in sorted(s)}

        def _cb_audit():
            """Same checks as the standalone auditor, run against LIVE in-memory state.
            Read-only: it reports, it never repairs."""
            out = []

            def _closed(e):
                return (str(e.get("status", "")) == "Completed"
                        or str(e.get("urgency", "")) == "Low"
                        or "junk" in str(e.get("category", "")).lower())

            try:
                cov_threads = (getattr(app, "quote_coverage", {}) or {}).get("threads", {})
                for g in list((getattr(app, "groups_data", {}) or {}).get("groups", []) or []):
                    if not isinstance(g, dict) or g.get("archived"):
                        continue
                    gid = g.get("id", "")
                    ms = [e for e in (app.get_emails_for_group(gid) or [])
                          if isinstance(e, dict) and not e.get("app_deleted")]
                    if not ms:
                        continue
                    openrows = [e for e in ms if not _closed(e)]
                    if not openrows and any(str(e.get("status")) == "Completed" for e in ms):
                        out.append({"severity": "HIGH", "kind": "group_should_be_archived",
                                    "gid": gid, "subject": g.get("name", ""),
                                    "detail": "all %d members closed, group still active" % len(ms)})
                        continue
                    rec = cov_threads.get("grp:" + gid) or {}
                    reqs = rec.get("requested") or []
                    quoted = {str(q.get("description", ""))[:40] for q in (rec.get("quoted") or [])}
                    fully = bool(reqs) and all(str(r.get("description", ""))[:40] in quoted for r in reqs)
                    cust_done = any(str(e.get("email_type", "")).upper() == "C"
                                    and str(e.get("status")) == "Completed" for e in ms)
                    if fully and cust_done and openrows:
                        out.append({"severity": "HIGH", "kind": "group_blocked_by_open_rows",
                                    "gid": gid, "subject": g.get("name", ""),
                                    "detail": "ledger fully quoted, customer RFQ Completed, "
                                              "%d row(s) still open" % len(openrows),
                                    "blockers": [{"entry_id": e.get("entry_id"),
                                                  "subject": str(e.get("subject", ""))[:50],
                                                  "status": e.get("status")} for e in openrows[:5]]})
                for e in (getattr(app, "emails", []) or []):
                    if not isinstance(e, dict) or e.get("app_deleted"):
                        continue
                    if (str(e.get("thread_group_rule", "")) == "sent_waiting_tracker_group"
                            and str(e.get("status")) == "Needs Reply"):
                        out.append({"severity": "MED", "kind": "sent_rfq_reply_needs_reply",
                                    "entry_id": e.get("entry_id"),
                                    "subject": str(e.get("subject", ""))[:50],
                                    "detail": "reply on our own sent-RFQ thread in the reply queue"})
                    if e.get("sent_waiting_tracker_active") and str(e.get("status")) == "Completed":
                        out.append({"severity": "LOW", "kind": "tracker_active_on_completed",
                                    "entry_id": e.get("entry_id"),
                                    "subject": str(e.get("subject", ""))[:50],
                                    "detail": "Completed row still carries an active tracker"})
                # v4.2.13: an ARCHIVED group that still holds open rows. Reported via
                # "RE: Eastchester SER", where the close anchored on our own sent-waiting
                # placeholder and left the customer's actual request at Needs Reply.
                # SURFACED, NEVER REPAIRED: measured 54 of 162 archived groups in this
                # state with 45 rows at Needs Reply, and several are genuinely live work
                # (two open invoices in "1597-006", 16 open rows in WELSBACH- NYCDEP), so
                # auto-completing them would bury real obligations. v4.2.13 cancels their
                # REMINDERS on archive; deciding the rows themselves stays with the user.
                _mem = (getattr(app, "groups_data", {}) or {}).get("memberships", {}) or {}
                for g in list((getattr(app, "groups_data", {}) or {}).get("groups", []) or []):
                    if not isinstance(g, dict) or not g.get("archived"):
                        continue
                    gid = g.get("id", "")
                    openrows = []
                    for e in (app.get_emails_for_group(gid) or []):
                        if not isinstance(e, dict) or e.get("app_deleted"):
                            continue
                        if e.get("is_sent_waiting_placeholder"):
                            continue
                        if not _closed(e):
                            openrows.append(e)
                    if not openrows:
                        continue
                    _nr = sum(1 for e in openrows if str(e.get("status")) == "Needs Reply")
                    out.append({"severity": "LOW" if not _nr else "MED",
                                "kind": "archived_group_open_rows",
                                "gid": gid, "subject": str(g.get("name", ""))[:50],
                                "detail": "archived group still holds %d open row(s), %d at "
                                          "Needs Reply" % (len(openrows), _nr),
                                "blockers": [{"entry_id": e.get("entry_id"),
                                              "subject": str(e.get("subject", ""))[:50],
                                              "status": e.get("status")} for e in openrows[:5]]})
            except Exception as exc:
                out.append({"severity": "ERROR", "kind": "audit_failed", "detail": repr(exc)})
            order = {"HIGH": 0, "MED": 1, "LOW": 2, "ERROR": 0}
            out.sort(key=lambda f: order.get(f.get("severity"), 9))
            counts = {}
            for f in out:
                counts[f.get("severity")] = counts.get(f.get("severity"), 0) + 1
            return {"counts": counts, "findings": out[:400]}

        def _cb_scan_sent(done):
            def _work(outlook, namespace):
                return app.scan_recent_sent_waiting_trackers(max_items=50, lookback_days=7)
            return app.run_outlook_worker(_work, on_done=done, on_error=lambda _e: done({"error": repr(_e)}),
                                          label="diag-sent-scan")

        def _cb_reconcile(done):
            def _work(outlook, namespace):
                return app.reconcile_sent_waiting_placeholders_against_replies()
            return app.run_outlook_worker(_work, on_done=done, on_error=lambda _e: done({"error": repr(_e)}),
                                          label="diag-reconcile")

        def _cb_inject(payload):
            # Runs ON MAIN (marshaled by the bridge). Real import pipeline, no COM.
            import secrets as _sec
            eid = "diag:" + _sec.token_hex(6)
            now = datetime.now()
            email = {
                "entry_id": eid, "store_id": "", "conversation_id": str(payload.get("conversation_id", "") or ""),
                "source": str(payload.get("source", "My Inbox") or "My Inbox"),
                "subject": str(payload.get("subject", "") or ""),
                "normalized_subject": normalize_subject_for_match(str(payload.get("subject", "") or "")),
                "sender": str(payload.get("sender", payload.get("sender_email", "diag")) or "diag"),
                "sender_email": str(payload.get("sender_email", "diag@synthetic.local") or "diag@synthetic.local"),
                "body": str(payload.get("body", "") or ""), "body_loaded": True,
                "received": now.strftime("%Y-%m-%d %I:%M %p"), "received_timestamp": now.timestamp(),
                "outlook_categories": str(payload.get("outlook_categories", "") or ""),
                "category": str(payload.get("category", "General") or "General"),
                "urgency": str(payload.get("urgency", "Normal") or "Normal"),
                "status": str(payload.get("status", "New") or "New"),
                "email_type": str(payload.get("type", payload.get("email_type", "")) or ""),
                "message": None, "is_new_import": True, "has_attachments": False,
                "followup_time": "", "is_synthetic_diag": True,
            }
            is_new = app.upsert_email(email)
            if is_new:
                try:
                    app.handle_new_email_after_import(email, silent=True)
                except Exception:
                    pass
            ph_cleared = bool(app.clear_sent_waiting_placeholder_for_reply(email))
            row_cleared = bool(app.clear_existing_sent_waiting_tracker_rows_for_reply(email))
            try:
                app._rebuild_email_index()
                app.render_email_rows()
            except Exception:
                pass
            gid = (app.groups_data.get("memberships", {}) or {}).get(eid, "")
            ops_log("diag", "inject_email", eid=eid, subj=email["subject"],
                    grouped=str(gid or ""), ph_cleared=ph_cleared, row_cleared=row_cleared)
            return {"entry_id": eid, "is_new": bool(is_new), "group_id": str(gid or ""),
                    "category": email.get("category"), "urgency": email.get("urgency"),
                    "status": email.get("status"), "email_type": email.get("email_type"),
                    "tracker_placeholder_cleared": ph_cleared, "tracker_row_cleared": row_cleared}

        def _cb_purge():
            # Runs ON MAIN. Remove every synthetic row + its memberships.
            before = len(getattr(app, "emails", []) or [])
            app.emails = [e for e in (getattr(app, "emails", []) or [])
                          if not (isinstance(e, dict) and str(e.get("entry_id", "")).startswith("diag:"))]
            members = app.groups_data.get("memberships", {}) or {}
            for k in [k for k in list(members.keys()) if str(k).startswith("diag:")]:
                members.pop(k, None)
            try:
                app._rebuild_email_index()
                app.render_email_rows()
            except Exception:
                pass
            removed = before - len(app.emails)
            ops_log("diag", "purge_synthetic", removed=removed)
            return {"removed": removed}

        callbacks = {
            "state": _cb_state, "trackers": _cb_trackers, "groups": _cb_groups,
            "emails": _cb_emails, "coverage": _cb_coverage,
            # v4.2.10 phase 1: read-only diagnostic surface. The bridge tolerates a
            # missing callback, so an older bridge module simply 404s these.
            "why": _cb_why, "rules": _cb_rules, "settings": _cb_settings, "audit": _cb_audit,
            "opslog_path": lambda: OPS_LOG_FILE,
            "run_on_main": lambda fn: app.root.after(0, fn),
            "scan_sent": _cb_scan_sent, "reconcile": _cb_reconcile,
            "inject_email": _cb_inject, "purge_synthetic": _cb_purge,
        }
        try:
            self._diag_bridge = _dbr.DiagBridge(APP_DATA_DIR, callbacks)
            port = self._diag_bridge.start()
            token_path = self._diag_bridge.write_token_file()
            ops_log("diag", "bridge_started", port=port, token_file=token_path,
                    bridge_version=getattr(_dbr, "ENGINE_VERSION", "?"))
        except Exception as e:
            ops_log("diag", "bridge_start_failed", error=repr(e))

    _TRACKER_GROUP_STOPWORDS = frozenset((
        "re", "fw", "fwd", "the", "and", "for", "p&a", "pa", "quote", "order", "quotes",
        "ave", "avenue", "st", "street", "rd", "road", "blvd", "ny", "nj", "llc", "inc",
        "gate", "job", "bid", "new", "york", "material", "materials", "request", "wire",
    ))

    def _tracker_group_tokens(self, text):
        try:
            toks = set()
            for t in re.split(r"[^a-z0-9]+", str(text or "").lower()):
                if len(t) >= 3 and t not in self._TRACKER_GROUP_STOPWORDS:
                    toks.add(t)
            return toks
        except Exception:
            return set()

    def auto_group_sent_tracker(self, placeholder, pending=None):
        """v4.1.63 (reported: the 2150 Hempstead tracker sat outside its job group):
        put a new Sent/Waiting tracker into the job group it belongs to.

        Two signals, strongest first:
        1. INHERIT -- the RFQ was created from a tracked source email that is already
           a group member (pending['entry_id']); the tracker joins that group.
        2. TOKEN MATCH -- the tracker subject shares >=2 distinctive tokens (numbers
           or words len>=3, stopwords dropped) with EXACTLY ONE group name, e.g.
           'P&A- 2150 HEMPSTEAD TPKE Southwire Wire' vs
           '240950 - 2150 HEMPSTEAD TPKE ELMONT, NY 11003 - GATE 5' shares
           {2150, hempstead, tpke}. Ambiguity (two groups matching) -> do nothing;
           a wrong join is worse than a flat row.

        Returns the joined group_id or ''. Also used by the reconcile sweep to
        retro-heal trackers created before this existed."""
        try:
            if not isinstance(placeholder, dict) or placeholder.get("cleared"):
                return ""
            pid = str(placeholder.get("entry_id", "") or "")
            if not pid:
                return ""
            memberships = self.groups_data.setdefault("memberships", {})
            if memberships.get(pid):
                return memberships.get(pid)
            groups = [g for g in (self.groups_data.get("groups", []) or [])
                      if isinstance(g, dict) and g.get("id") and not g.get("archived")]
            if not groups:
                return ""
            # Signal 1: inherit the tracked source email's group.
            src_eid = str((pending or {}).get("entry_id", "") or placeholder.get("tracked_entry_id", "") or "")
            if src_eid:
                gid = memberships.get(src_eid, "")
                if gid and any(g.get("id") == gid for g in groups):
                    memberships[pid] = gid
                    try:
                        self.mark_group_has_new(gid, save=False)
                    except Exception:
                        pass
                    self.save_groups()
                    ops_log("group", "tracker_joined", gid=str(gid), how="inherited",
                            subj=str(placeholder.get("subject", "") or ""))
                    return gid
            # Signal 2: unambiguous token match against group names.
            toks = self._tracker_group_tokens(placeholder.get("subject", ""))
            if len(toks) < 2:
                return ""
            best = []
            for g in groups:
                shared = toks & self._tracker_group_tokens(g.get("name", ""))
                if len(shared) >= 2:
                    best.append((len(shared), g.get("id"), sorted(shared)))
            if not best:
                return ""
            best.sort(reverse=True)
            if len(best) > 1 and best[0][0] == best[1][0]:
                ops_log("group", "tracker_join_ambiguous",
                        subj=str(placeholder.get("subject", "") or ""), candidates=len(best))
                return ""
            gid = best[0][1]
            memberships[pid] = gid
            try:
                self.mark_group_has_new(gid, save=False)
            except Exception:
                pass
            self.save_groups()
            ops_log("group", "tracker_joined", gid=str(gid), how="token_match",
                    shared=best[0][2], subj=str(placeholder.get("subject", "") or ""))
            return gid
        except Exception:
            return ""

    def _log_clear_skip_once(self, tracker_id, reply_sender, waiting_on, **extra):
        """v4.1.84: the v4.1.77 sender-mismatch telemetry fires inside per-candidate
        loops that re-run on EVERY import/scan pass, so production logged 1033 events
        across only 59 unique (tracker, sender) pairs -- 17x duplication that bloats
        mainbox_ops_log.jsonl and drowns the signal it was added to provide. Log each
        distinct pair once per session; the guard's BEHAVIOR is unchanged."""
        try:
            seen = getattr(self, "_clear_skip_logged", None)
            if seen is None:
                seen = self._clear_skip_logged = set()
            key = (str(tracker_id or "")[-24:], str(reply_sender or "").lower()[:60])
            if key in seen:
                return
            seen.add(key)
            ops_log("tracker", "clear_skipped_sender_mismatch",
                    tracker=key[0], reply_sender=str(reply_sender or "")[:60],
                    waiting_on=str(waiting_on or "")[:60], **extra)
        except Exception:
            pass

