    def _refresh_filter_button_styles(self):
        """Highlight the active filter with a soft accent TINT + accent-colored bold
        text (a modern 'selected' look), not a loud saturated fill. Inactive buttons
        use the normal face. Cooperates with the subtle global hover lift."""
        active = getattr(self, "active_filter", "all")
        for key, btn in getattr(self, "_filter_buttons", {}).items():
            try:
                if key == active:
                    base_bg = _mainbox_mix(btn, _ACCENT, _BG, 0.70)  # muted accent tint
                    base_fg = _ACCENT
                    weight = "bold"
                else:
                    base_bg = _BTN_BG
                    base_fg = _BTN_FG
                    weight = "normal"
                btn._mainbox_orig_bg = base_bg
                btn.configure(fg=base_fg, font=(_FONT, _FONT_SIZE, weight))
                if getattr(btn, "_mainbox_hovering", False):
                    btn.configure(bg=_mainbox_mix_white(btn, base_bg, 0.10))
                else:
                    btn.configure(bg=base_bg)
            except Exception:
                pass

