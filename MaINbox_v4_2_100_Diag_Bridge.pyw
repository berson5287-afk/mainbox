    def get_sales_inbox_duplicate_key(self, email):
        """Return a conservative duplicate key for Sales/My Inbox duplicate suppression."""
        if not isinstance(email, dict):
            return None
        sender_email = str(email.get("sender_email", "") or "").strip().lower()
        sender_name = str(email.get("sender", "") or "").strip().lower()
        sender_key = sender_email or sender_name
        subject_key = normalize_subject_for_match(email.get("subject", "") or "")
        if not sender_key or not subject_key:
            return None
        try:
            # Same delivered email usually lands in both mailboxes within a few seconds/minutes.
            # Use a 5-minute bucket so tiny delivery-time differences still match, without
            # suppressing separate replies with the same subject hours apart.
            received_bucket = int(float(email.get("received_timestamp", 0) or 0) // 300)
        except Exception:
            received_bucket = 0
        conversation_id = str(email.get("conversation_id", "") or "").strip().lower()
        return (sender_key, subject_key, conversation_id, received_bucket)

    def emails_look_like_same_sales_inbox_duplicate(self, a, b):
        """True only when a Sales copy and My Inbox copy look like the same delivered email."""
        if not a or not b:
            return False
        sources = {str(a.get("source", "")), str(b.get("source", ""))}
        if sources != {"Sales", "My Inbox"}:
            return False
        sender_a = (str(a.get("sender_email", "") or a.get("sender", "") or "").strip().lower())
        sender_b = (str(b.get("sender_email", "") or b.get("sender", "") or "").strip().lower())
        if not sender_a or sender_a != sender_b:
            return False
        subj_a = normalize_subject_for_match(a.get("subject", "") or "")
        subj_b = normalize_subject_for_match(b.get("subject", "") or "")
        if not subj_a or subj_a != subj_b:
            return False
        conv_a = str(a.get("conversation_id", "") or "").strip().lower()
        conv_b = str(b.get("conversation_id", "") or "").strip().lower()
        if conv_a and conv_b and conv_a != conv_b:
            return False
        try:
            delta = abs(float(a.get("received_timestamp", 0) or 0) - float(b.get("received_timestamp", 0) or 0))
        except Exception:
            delta = 0
        return delta <= 600

    def suppress_my_inbox_duplicate_when_sales_copy_exists(self, email):
        """If the same email exists in Sales and My Inbox, hide only the My Inbox duplicate."""
        if not isinstance(email, dict):
            return False
        if email.get("source") not in ("Sales", "My Inbox"):
            return False
        changed = False
        candidates = []
        if email.get("source") == "My Inbox":
            candidates = [e for e in self.emails if e is not email and e.get("source") == "Sales"]
            # v4.1.8 fix: start with no copy to suppress. This must stay None until the loop
            # below actually finds a matching Sales twin -- otherwise EVERY My Inbox email
            # (even one with no Sales duplicate at all) falls through the "if not my_copy"
            # guard and gets forced to Low + hidden, which then makes the import gate skip
            # grouping. That buried real vendor quote replies that only ever arrived in My
            # Inbox (e.g. a forwarded "FW: P&A - RE: <job>").
            my_copy = None
        else:
            candidates = [e for e in self.emails if e is not email and e.get("source") == "My Inbox"]
            my_copy = None
        for other in candidates:
            if self.emails_look_like_same_sales_inbox_duplicate(email, other):
                if email.get("source") == "My Inbox":
                    my_copy = email
                else:
                    my_copy = other
                break
        if not my_copy:
            return False
        if my_copy.get("urgency") != "Low":
            my_copy["urgency"] = "Low"
            changed = True
        my_copy["sales_inbox_duplicate_hidden"] = True
        my_copy["sales_inbox_duplicate_hidden_at"] = datetime.now().isoformat()
        my_copy["is_new_import"] = False
        if changed:
            self.save_record(my_copy)
            self.flush_status_data()
        return changed

    def import_from_folder(self, folder, source_label, scan_limit=None, category_filter=False, since_dt=None, reset_mode=False, silent=False):
        added_or_updated = 0
        self._begin_commitment_batch()  # v3.8.23: coalesce per-email commitment/cache writes
        try:
            messages = folder.Items
            messages.Sort("[ReceivedTime]", True)
            iterable = messages
            using_restrict = False
            if category_filter:
                try:
                    category = self.selected_sales_category.replace("'", "''")
                    restricted = messages.Restrict(f"@SQL=\"urn:schemas-microsoft-com:office:office#Keywords\" LIKE '%{category}%'")
                    restricted.Sort("[ReceivedTime]", True)
                    iterable = restricted
                    using_restrict = True
                except Exception:
                    iterable = messages
                    using_restrict = False
            # v3.9.23: Outlook's default `for item in Items` enumerator does NOT reliably
            # honor .Sort(), so a small newest-first scan window could silently miss the very
            # newest emails (the reported "inbox not importing everything" bug). Collect items
            # in dependable newest-first order via GetFirst/GetNext (which DOES honor the
            # active sort), then process that list. Fall back to the raw collection only if
            # GetFirst/GetNext yields nothing, so import never breaks entirely.
            ordered = []
            try:
                m = iterable.GetFirst()
                guard = 0
                while m is not None and guard < 100000:
                    guard += 1
                    ordered.append(m)
                    if scan_limit is not None and len(ordered) >= scan_limit:
                        break
                    if since_dt:
                        try:
                            if m.ReceivedTime.replace(tzinfo=None) < since_dt:
                                break
                        except Exception:
                            pass
                    m = iterable.GetNext()
            except Exception:
                ordered = []
            scan_source = ordered if ordered else iterable
            scanned = 0
            for msg in scan_source:
                if scan_limit is not None and scanned >= scan_limit:
                    break
                scanned += 1
                if not silent and scanned % 100 == 0:
                    self.update_loading(f"Scanning {source_label}... {scanned} checked")
                try:
                    received = msg.ReceivedTime
                    if since_dt and received.replace(tzinfo=None) < since_dt:
                        break
                    if category_filter and not using_restrict:
                        outlook_categories = msg.Categories or ""
                        if not self.email_has_outlook_category(outlook_categories, self.selected_sales_category):
                            continue
                    email = self.build_email_data(msg, source_label)
                    if not email:
                        continue
                    is_new = self.upsert_email(email)
                    self.suppress_my_inbox_duplicate_when_sales_copy_exists(email)
                    if is_new and email.get("urgency") != "Low":
                        self.handle_new_email_after_import(email, silent=silent)
                    self.clear_sent_waiting_placeholder_for_reply(email)
                    self.clear_existing_sent_waiting_tracker_rows_for_reply(email)
                    # v3.8.12: scan newly imported vendor/customer replies for ETA, lead-time,
                    # ship/delivery dates, quote expirations, and other dated commitments.
                    # This is intentionally only for new imports so refresh stays fast.
                    if is_new:
                        try:
                            scheduled_commitments = self.scan_outlook_message_for_commitments(msg, email, direction=source_label)
                            if scheduled_commitments:
                                email["followup_time"] = self.get_followup_display_for_email(email.get("entry_id", ""))
                                added_or_updated += scheduled_commitments
                        except Exception:
                            pass
                    if is_new or not silent:
                        added_or_updated += 1
                except Exception:
                    # v4.1.25 (external audit round 7, blocker #5): per-message failures
                    # are COUNTED, not just absorbed -- Full Update rolls back when they
                    # exceed a tolerance instead of silently committing a thinned mailbox.
                    try:
                        self._last_folder_scan_msg_errors = int(getattr(self, "_last_folder_scan_msg_errors", 0) or 0) + 1
                    except Exception:
                        pass
                    continue
            self._flush_commitment_batch()
            return added_or_updated
        except Exception as e:
            # v4.1.24 (external audit round 6, blocker #10): record that this folder scan
            # ended INCOMPLETE -- Full Update reads this flag and rolls back instead of
            # saving a partial list over the previously complete cache.
            try:
                self._last_folder_scan_incomplete = True
            except Exception:
                pass
            try:
                self._flush_commitment_batch()
            except Exception:
                pass
            if self.is_outlook_disconnect_error(e):
                self.reset_outlook_connection(source_label)
                if not silent:
                    self.preview_text.delete("1.0", tk.END)
                    self.preview_text.insert(tk.END, f"Outlook disconnected while scanning {source_label}. MaINbox will reconnect and retry on the next refresh.")
            elif not silent:
                messagebox.showerror("Import Error", f"Could not import from {source_label}.\n\n{e}")
            return added_or_updated

    def build_email_data(self, msg, source_label):
        try:
            # v4.2.53: capture attachment FILENAMES (names only -- Count + FileName
            # reads, no per-attachment PropertyAccessor, so scan cost stays flat).
            # Text-only triage was blind to attachments; a PO-patterned filename is
            # the hard signal the quick-intent PO rule keys on. Capped at 15.
            attachment_names = ""
            try:
                _atts = msg.Attachments
                _acount = int(getattr(_atts, "Count", 0) or 0)
                if _acount:
                    _anames = []
                    for _ai in range(1, min(_acount, 15) + 1):
                        try:
                            _anm = str(_atts.Item(_ai).FileName or "").strip()
                            if _anm:
                                _anames.append(_anm)
                        except Exception:
                            continue
                    attachment_names = "; ".join(_anames)
            except Exception:
                attachment_names = ""
            subject = msg.Subject or ""
            sender = msg.SenderName or ""
            try:
                sender_email = self.get_sender_email(msg)
            except Exception:
                sender_email = ""
            received = msg.ReceivedTime
            entry_id = msg.EntryID
            outlook_categories = msg.Categories or ""
            store_id = ""
            try:
                store_id = msg.Parent.StoreID
            except Exception:
                store_id = ""
            conversation_id = ""
            try:
                conversation_id = msg.ConversationID
            except Exception:
                conversation_id = ""
            conversation_index = ""
            try:
                conversation_index = str(getattr(msg, "ConversationIndex", "") or "")
            except Exception:
                conversation_index = ""
            internet_message_id = ""
            in_reply_to_id = ""
            references_ids = ""
            user_replied = False
            try:
                pa = msg.PropertyAccessor
                try:
                    internet_message_id = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
                except Exception:
                    try:
                        internet_message_id = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001E") or "")
                    except Exception:
                        internet_message_id = ""
                try:
                    in_reply_to_id = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1042001F") or "")
                except Exception:
                    try:
                        in_reply_to_id = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1042001E") or "")
                    except Exception:
                        in_reply_to_id = ""
                try:
                    references_ids = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1039001F") or "")
                except Exception:
                    try:
                        references_ids = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1039001E") or "")
                    except Exception:
                        references_ids = ""
                try:
                    # PR_LAST_VERB_EXECUTED: 102 = Reply, 103 = Reply All. If set, the
                    # user already replied to THIS message, so it no longer "Needs
                    # Reply". Guarded: absent/unreadable -> user_replied stays False.
                    _last_verb = pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x10810003")
                    user_replied = int(_last_verb or 0) in (102, 103)
                except Exception:
                    user_replied = False
            except Exception:
                pass
            saved = self.find_saved_status_for_email_fields(
                entry_id=entry_id,
                conversation_id=conversation_id,
                conversation_index=conversation_index,
                sender_email=sender_email,
                sender=sender,
                subject=subject,
                received_timestamp=received.timestamp(),
                source=source_label,
                internet_message_id=internet_message_id,  # v3.9.82: drift-proof match key
            )
            if saved.get("app_deleted"):
                return None
            if saved.get("closed_guard_applied") and entry_id:
                healed = dict(self.status_data.get(entry_id, {}) or {})
                healed.update(saved)
                healed["entry_id"] = entry_id
                healed["internet_message_id"] = internet_message_id or healed.get("internet_message_id", "")
                healed["conversation_index"] = conversation_index or healed.get("conversation_index", "")
                self.status_data[entry_id] = healed
            # If Outlook resurfaced the same message with a new EntryID, carry the old
            # saved workflow state forward to the new EntryID immediately.
            if saved and entry_id and entry_id not in self.status_data:
                carried = dict(saved)
                carried.update({
                    "carried_from_entry_id": carried.get("entry_id", ""),
                    "entry_id": entry_id,                        # v3.9.88: inner id matches the new key it is stored under
                    "internet_message_id": internet_message_id,  # v3.9.88: persist the drift-proof key onto the healed record
                    "updated_at": datetime.now().isoformat(),
                    "subject": subject,
                    "normalized_subject": normalize_subject_for_match(subject),
                    "sender": sender,
                    "sender_email": sender_email,
                    "received": received.strftime("%Y-%m-%d %I:%M %p"),
                    "received_timestamp": received.timestamp(),
                    "source": source_label,
                    "conversation_id": conversation_id,
                    "conversation_index": conversation_index,
                    "store_id": store_id,
                })
                self.status_data[entry_id] = carried
                try:
                    self.flush_status_data()
                except Exception:
                    pass
            # v3.9.88: self-immunize against FUTURE EntryID drift. Records saved before
            # v3.9.82 (or any without it) carry no Internet Message-ID, so a Cached Exchange
            # Mode resync can only match them on the fragile subject/sender/timestamp path --
            # which is exactly what let a wave of old closed emails resurface as New after a
            # resync. When this message hit its OWN saved record directly (no drift this time),
            # stamp the durable server-assigned Message-ID (and conversation id) onto it so the
            # NEXT resync matches it by Message-ID. In-memory only -- no per-email flush; it
            # persists on the next status save and is cheap to redo, so it adds no I/O here.
            elif internet_message_id and entry_id:
                try:
                    _rec = self.status_data.get(entry_id)
                    if isinstance(_rec, dict):
                        if not str(_rec.get("internet_message_id", "") or "").strip():
                            _rec["internet_message_id"] = internet_message_id
                        if conversation_id and not str(_rec.get("conversation_id", "") or "").strip():
                            _rec["conversation_id"] = conversation_id
                except Exception:
                    pass
            # v3.9.13: resolve the real SMTP for EX-type senders, but reuse any value we
            # already have -- persisted on the saved record, or cached earlier this session --
            # so GetExchangeUser()/PropertyAccessor (COM/GAL calls) don't run for every email
            # on every refresh. That per-email resolution was freezing the UI on refresh.
            resolved_sender_smtp = (saved.get("resolved_sender_smtp", "") if saved else "")
            if not resolved_sender_smtp:
                try:
                    _smtp_cache = getattr(self, "_resolved_smtp_cache", None)
                    if _smtp_cache is None:
                        _smtp_cache = self._resolved_smtp_cache = {}
                    cache_key = sender_email or sender
                    if cache_key and cache_key in _smtp_cache:
                        resolved_sender_smtp = _smtp_cache[cache_key]
                    else:
                        stype = (getattr(msg, "SenderEmailType", "") or "").upper()
                        if stype == "SMTP":
                            resolved_sender_smtp = sender_email
                        else:
                            try:
                                exu = msg.Sender.GetExchangeUser()
                                if exu:
                                    resolved_sender_smtp = exu.PrimarySmtpAddress or ""
                            except Exception:
                                pass
                            if not resolved_sender_smtp:
                                try:
                                    resolved_sender_smtp = msg.PropertyAccessor.GetProperty(
                                        "http://schemas.microsoft.com/mapi/proptag/0x39FE001F")
                                except Exception:
                                    pass
                        if cache_key:
                            _smtp_cache[cache_key] = resolved_sender_smtp
                except Exception:
                    pass
            category = saved.get("category") or classify_category(subject)
            # v4.2.68 (Steve: John typed C yet category Vendor / Supplier): the keyword
            # fallback above tags any subject containing delivery/order/shipment as
            # Vendor / Supplier -- words customer mail carries constantly ("Pipe
            # delivery for Tuesday"). The sticky-category clamp (v4.2.26) only inspects
            # categories PROPOSED by automation later, so this import-time stamp stuck.
            # Mirror Rule 1 here: a sender the registry knows as Customer/Employee is
            # never SEEDED Vendor / Supplier either.
            if category == "Vendor / Supplier" and not saved.get("category"):
                _imp_dtype = normalize_email_type_code(saved.get("email_type")) \
                    or self.get_saved_contact_type(sender_email or sender)
                if _imp_dtype in ("C", "E"):
                    category = "General"
                    try:
                        ops_log("triage", "import_category_clamped",
                                sender=str(sender_email or sender)[:60],
                                subj=str(subject or "")[:60], durable=_imp_dtype)
                    except Exception:
                        pass
            urgency = saved.get("urgency") or classify_urgency(subject)
            status = saved.get("status", "New")
            # If Outlook shows the user already replied to THIS message, it no longer
            # "Needs Reply" -- they've done the reply that status implies. Flip it to
            # the matching "Waiting on ..." so the row reflects reality. Display-level
            # and idempotent (re-derived each scan); a genuinely new inbound reply is a
            # different message with its own flag, so it still shows Needs Reply.
            if user_replied and status == "Needs Reply":
                status = "Waiting on Vendor" if str(saved.get("email_type", "")).upper() == "V" else "Waiting on Customer"
            # v4.1.55: a sender saved as Customer/Vendor/Employee is typed at IMPORT,
            # before any AI runs -- a brand-new email from a saved customer arrives
            # as C instead of waiting for (or fighting) the triage inference.
            _seed_type = ""
            if not normalize_email_type_code(saved.get("email_type")):
                _seed_type = self.get_saved_contact_type(sender_email or sender)
            return {
                "entry_id": entry_id, "store_id": store_id, "conversation_id": conversation_id,
                "conversation_index": conversation_index, "internet_message_id": internet_message_id,
                "in_reply_to_id": in_reply_to_id, "references_ids": references_ids,
                "source": source_label, "subject": subject, "normalized_subject": normalize_subject_for_match(subject),
                "sender": sender, "sender_email": sender_email, "body": "",
                "body_loaded": False, "received": received.strftime("%Y-%m-%d %I:%M %p"),
                "received_timestamp": received.timestamp(), "outlook_categories": outlook_categories,
                "category": category, "urgency": urgency, "status": status, "message": None,
                "user_replied": user_replied,
                "is_new_import": False, "followup_time": self.get_followup_display_for_email(entry_id),
                "sender_type": saved.get("sender_type", "") or (EMAIL_TYPE_TO_SENDER_TYPE.get(_seed_type) if _seed_type else "") or "unknown", "email_type": saved.get("email_type", "") or _seed_type, "sender_intent": saved.get("sender_intent", ""),
                "reply_intent": saved.get("reply_intent", ""),
                "business_relevance": saved.get("business_relevance", ""), "spam_likelihood": saved.get("spam_likelihood", ""),
                "same_subject_related_count": saved.get("same_subject_related_count", 0),
                "ai_triaged_at": saved.get("ai_triaged_at", ""), "ai_triage_pending": saved.get("ai_triage_pending", False), "needs_followup_ai": saved.get("needs_followup_ai", False),
                "has_attachments": bool(getattr(msg, "Attachments", None) and getattr(msg.Attachments, "Count", 0)),
                "attachment_names": attachment_names,  # v4.2.53: PO-rule signal
                "resolved_sender_smtp": resolved_sender_smtp or "",
                "ai_user_locked": bool(saved.get("ai_user_locked", False)),
                "workflow_closed_at": saved.get("workflow_closed_at", ""),
                "explicit_reopened_at": saved.get("explicit_reopened_at", ""),
                "closed_guard_applied": bool(saved.get("closed_guard_applied", False)),
            }
        except Exception:
            return None

    def email_has_outlook_category(self, msg_categories, required_category):
        if not required_category:
            return True
        if not msg_categories:
            return False
        # Outlook can separate categories with ',' or ';' (locale/version dependent);
        # casefold both sides so a deliberately tagged email is never missed on a
        # case/whitespace/separator mismatch.
        raw = re.split(r"[;,]", str(msg_categories))
        parts = [p.strip().casefold() for p in raw if p.strip()]
        return required_category.strip().casefold() in parts

    def update_email_rows_in_place(self, emails):
        """Repaint specific rows without rebuilding the whole tree.

        v4.2.98 (measured, not guessed): AI triage drains its backlog one email every
        ~10s, and each completion called sort_emails_for_display + render_email_rows +
        render_group_rows + render_followup_preview_queue on the MAIN thread.
        render_email_rows deletes and reinserts EVERY visible row (654 emails, 245
        groups here), so one changed field cost a full rebuild. Live capture during a
        20-email import: a 150-240 ms hitch every ~10 seconds for the whole backlog --
        about 3.5 minutes of periodic stutter, which is what "it gets slow when the
        refresh auto-runs" actually was. The refresh itself measured clean.

        Returns True only if EVERY row was updated in place. Any doubt -> False, and
        the caller does the full render it always did. Bails when:
          * the tree or a row is missing
          * the row no longer matches the active filter (it may need removing)
          * its importance rank changed (rank decides which block it sits in)
          * its group membership changed (decides whether it is a group child)
          * it was never rendered with placement stamps (nothing to compare against)
        so a row can never be left showing new text in a stale position."""
        try:
            tree = getattr(self, "tree", None)
            if tree is None or not emails:
                return False
            rows = []
            for email in emails:
                if not isinstance(email, dict):
                    return False
                eid = str(email.get("entry_id", "") or "")
                if not eid or not tree.exists(eid):
                    return False
                if "_row_rank" not in email or "_row_gid" not in email:
                    return False
                if not self.email_matches_active_filter(email):
                    return False
                if self.get_importance_rank(email) != email.get("_row_rank"):
                    return False
                gid = self.get_group_id_for_email(eid) or ""
                if gid != str(email.get("_row_gid", "") or ""):
                    return False
                rows.append((eid, email, gid))
            for eid, email, gid in rows:
                subject = ("   \u21b3 " + email["subject"]) if gid else email["subject"]
                tree.item(
                    eid,
                    values=(
                        email["source"], email["received"], email["sender"],
                        self.get_email_type_code(email), subject,
                        email["outlook_categories"], email["category"], email["urgency"],
                        email["status"], email.get("followup_time", "")
                    ),
                    tags=(self.get_row_tag(email),)
                )
            return True
        except Exception:
            return False

    def render_email_rows(self):
        current_selection = set(self.tree.selection())
        self.tree.delete(*self.tree.get_children())
        visible_count = 0

        # v3 efficiency: build a single O(n) followup display dict before the
        # render loop so each row no longer triggers linear reminder scans.
        # v3.8.12 includes manual follow-ups, scenario reminders, and commitment
        # ETA/lead-time reminders so detected dates are visible immediately.
        _followup_display: dict = {}
        _followup_sort: dict = {}
        for _items in (getattr(self, "followups", []) or [], getattr(self, "scenario_reminders", []) or [], getattr(self, "commitment_reminders", []) or []):
            for _f in _items:
                if not isinstance(_f, dict) or _f.get("completed") or _f.get("cancelled"):
                    continue
                _eid = _f.get("entry_id", "")
                if not _eid:
                    continue
                _due_raw = _f.get("due_at", "") or ""
                try:
                    _due = datetime.fromisoformat(_due_raw).strftime("%m/%d %I:%M %p")
                except Exception:
                    _due = "Scheduled"
                if _eid not in _followup_display or _due_raw < _followup_sort.get(_eid, "9999"):
                    _followup_display[_eid] = _due
                    _followup_sort[_eid] = _due_raw

        def group_rank(group):
            urgency = group.get("urgency", "Normal")
            if urgency == "Critical":
                return 0
            if urgency == "High":
                return 1
            if urgency == "Low":
                return 6
            return 2

        # v3 efficiency: build group_id → visible member rows once instead of
        # scanning self.emails separately for every group header.
        visible_group_members_by_id = {}
        for _email in self.emails:
            try:
                _gid = self.get_group_id_for_email(_email.get("entry_id", ""))
                if _gid and self.email_matches_filter_only(_email):
                    visible_group_members_by_id.setdefault(_gid, []).append(_email)
            except Exception:
                pass

        def insert_group_header_and_members(group):
            nonlocal visible_count
            group_id = group.get("id", "")
            if not group_id:
                return set()
            members = list(visible_group_members_by_id.get(group_id, []))
            if not members:
                return set()
            is_open = not bool(group.get("collapsed", False))
            symbol = "▼" if is_open else "▶"
            group_urgency = group.get("urgency", "Normal")
            header_iid = f"groupheader:{group_id}"
            if self.tree.exists(header_iid):  # v4.1.10: duplicate id must never abort the render
                return set()
            self.tree.insert(
                "", "end", iid=header_iid,
                values=(
                    "GROUP", "", "", "",
                    f"{symbol} {group.get('name', 'Untitled Group')}  ({len(members)} email{'s' if len(members) != 1 else ''})",
                    "", "Quote Group", group_urgency, "", ""
                ),
                tags=("group_header_new",) if group.get("has_new") else ("group_header",)
            )
            visible_count += 1
            inserted_members = set()
            if is_open:
                members.sort(key=lambda email: (self.get_importance_rank(email), -email.get("received_timestamp", 0)))
                for email in members:
                    inserted_members.add(email.get("entry_id", ""))
                    if self.tree.exists(email["entry_id"]):  # v4.1.10: skip dup, never crash
                        continue
                    email["followup_time"] = _followup_display.get(email.get("entry_id", ""), "")
                    # v4.2.98: remember what decided this row's PLACEMENT, so the
                    # in-place updater can tell "same slot, new text" from "this row
                    # has to move" and bail to a full render for the latter.
                    email["_row_rank"] = self.get_importance_rank(email)
                    email["_row_gid"] = group_id
                    self.tree.insert(
                        "", "end", iid=email["entry_id"],
                        values=(
                            email["source"], email["received"], email["sender"], self.get_email_type_code(email), "   ↳ " + email["subject"],
                            email["outlook_categories"], email["category"], email["urgency"],
                            email["status"], email.get("followup_time", "")
                        ),
                        tags=(self.get_row_tag(email),)
                    )
                    visible_count += 1
            return inserted_members

        # In All/Ungrouped mode, groups act like priority containers inside the normal urgency/status list.
        # Each group appears before regular email rows at the urgency level assigned to that group.
        if self.active_group_filter in ["all", "ungrouped"]:
            displayed_group_members = set()
            sorted_groups = sorted(
                [g for g in self.groups_data.get("groups", []) if not g.get("archived", False)],
                key=lambda g: (group_rank(g), str(g.get("name", "")).lower())
            )
            sorted_emails = sorted(self.emails, key=lambda email: (self.get_importance_rank(email), -email.get("received_timestamp", 0)))

            for rank in range(0, 7):
                if self.active_group_filter != "ungrouped":
                    for group in [g for g in sorted_groups if group_rank(g) == rank]:
                        displayed_group_members.update(insert_group_header_and_members(group))
                for email in [e for e in sorted_emails if self.get_importance_rank(e) == rank]:
                    entry_id = email.get("entry_id", "")
                    if entry_id in displayed_group_members:
                        continue
                    if self.get_group_id_for_email(entry_id) and self.active_group_filter == "all":
                        continue
                    if not self.email_matches_active_filter(email):
                        continue
                    if self.tree.exists(email["entry_id"]):  # v4.1.10: skip dup, never crash
                        continue
                    email["followup_time"] = _followup_display.get(email.get("entry_id", ""), "")
                    email["_row_rank"] = self.get_importance_rank(email)   # v4.2.98
                    email["_row_gid"] = ""
                    self.tree.insert(
                        "", "end", iid=email["entry_id"],
                        values=(
                            email["source"], email["received"], email["sender"], self.get_email_type_code(email), email["subject"],
                            email["outlook_categories"], email["category"], email["urgency"],
                            email["status"], email.get("followup_time", "")
                        ),
                        tags=(self.get_row_tag(email),)
                    )
                    visible_count += 1
        else:
            for email in self.emails:
                email["followup_time"] = _followup_display.get(email.get("entry_id", ""), "")
                if not self.email_matches_active_filter(email):
                    continue
                if self.tree.exists(email["entry_id"]):  # v4.1.10: skip dup, never crash
                    continue
                email["_row_rank"] = self.get_importance_rank(email)   # v4.2.98
                email["_row_gid"] = self.get_group_id_for_email(email.get("entry_id", "")) or ""
                self.tree.insert(
                    "", "end", iid=email["entry_id"],
                    values=(
                        email["source"], email["received"], email["sender"], self.get_email_type_code(email), email["subject"],
                        email["outlook_categories"], email["category"], email["urgency"],
                        email["status"], email.get("followup_time", "")
                    ),
                    tags=(self.get_row_tag(email),)
                )
                visible_count += 1

        still_exists = [iid for iid in current_selection if self.tree.exists(iid)]
        if still_exists:
            self.tree.selection_set(still_exists)
        current = self.filter_label_var.get() if hasattr(self, "filter_label_var") else "Current Filter: Show All"
        self.view_label.config(text=f"Sales category: '{self.selected_sales_category}' | {current.replace('Current Filter: ', '')} | Showing {visible_count}")

    def get_email_type_code(self, email):
        code = infer_email_type_code(email)
        if isinstance(email, dict):
            email["email_type"] = code
        return code

    def cycle_selected_email_type_hotkey(self, event=None):
        selected_emails = self.get_selected_emails(show_warning=False)
        if not selected_emails:
            try:
                messagebox.showinfo("Change Type", "Please select email(s) first.")
            except Exception:
                pass
            return "break"
        order = ["", "C", "V", "E", "M"]
        current = self.get_email_type_code(selected_emails[0])
        next_code = order[(order.index(current) + 1) % len(order)] if current in order else "C"
        self.save_undo_state("change email type")
        with self._bulk_write():
            for email in selected_emails:
                email["email_type"] = next_code
                self.save_record(email)
        self.flush_status_data()
        self.render_email_rows()
        self.save_cached_state()
        try:
            self.email_type_var.set(next_code)
        except Exception:
            pass
        try:
            self.preview_text.delete("1.0", tk.END)
            label = EMAIL_TYPE_NAMES.get(next_code, "Unknown")
            self.preview_text.insert(tk.END, f"Type set to {next_code or 'blank'} ({label}) for {len(selected_emails)} selected email(s).")
        except Exception:
            pass
        return "break"

    def apply_workflow_hotkey_profile(self, profile_name, event=None):
        """Apply common workflow classification profiles from Ctrl+Shift hotkeys."""
        profiles = {
            "vendor": {
                "label": "Vendor",
                "category": "Vendor / Supplier",
                "urgency": "Normal",
                "status": "New",
                "email_type": "V",
            },
            "customer": {
                "label": "Customer Quote/Estimate",
                "category": "Quote / Estimate",
                "urgency": "Normal",
                "status": "New",
                "email_type": "C",
            },
            "employee": {
                "label": "Employee",
                "category": "General",
                "urgency": "Normal",
                "status": "New",
                "email_type": "E",
            },
            "marketing": {
                "label": "Marketing",
                "category": "Junk / Ignore",
                "urgency": "Low",
                "status": "Completed",
                "email_type": "M",
            },
            "normal": {
                "label": "Normal/Reset",
                "category": "General",
                "urgency": "Normal",
                "status": "New",
                "email_type": "",
            },
        }
        profile = profiles.get(profile_name)
        if not profile:
            return "break"
        selected_emails = self.get_selected_emails(show_warning=False)
        if not selected_emails:
            try:
                messagebox.showinfo("Workflow Hotkey", "Please select email(s) first.")
            except Exception:
                pass
            return "break"
        self.save_undo_state(f"apply {profile['label']} workflow hotkey")
        _guard_changed = False
        with self._bulk_write():
            for email in selected_emails:
                _was_closed = self.workflow_record_is_closed(email) or bool(self._find_closed_email_guard(email, self.status_data.get(email.get("entry_id", ""), {})))
                email["category"] = profile["category"]
                email["urgency"] = profile["urgency"]
                email["status"] = profile["status"]
                email["email_type"] = profile["email_type"]
                email["is_new_import"] = False
                # v3.9.47: a hotkey profile is an explicit manual decision; lock it from AI re-triage.
                email["ai_user_locked"] = True
                email["ai_triaged_at"] = email.get("ai_triaged_at") or datetime.now().isoformat()
                email["ai_triage_pending"] = False
                if _was_closed and not self.workflow_record_is_closed(email):
                    email["explicit_reopened_at"] = datetime.now().isoformat()
                    email["workflow_closed_at"] = ""
                    if self.clear_closed_email_guard(email, save=False):
                        _guard_changed = True
                self.save_record(email)
            if _guard_changed:
                self._save_closed_email_guard()
        self.flush_status_data()
        self.render_email_rows()
        self.save_cached_state()
        try:
            self.category_var.set(profile["category"])
            self.urgency_var.set(profile["urgency"])
            self.status_var.set(profile["status"])
            self.email_type_var.set(profile["email_type"])
        except Exception:
            pass
        try:
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, f"Applied {profile['label']} profile to {len(selected_emails)} selected email(s).")
        except Exception:
            pass
        # v4.1.55: first-time offer -- a hotkey profile that sets a C/V/E type is a
        # deliberate manual typing; offer to remember it for the sender(s).
        try:
            self._offer_save_contact_type(selected_emails, profile.get("email_type", ""))
        except Exception:
            pass
        return "break"

    def email_matches_filter_only(self, email):
        """Apply the top filter without applying the group filter. Used so group containers can live inside urgency sorting."""
        if self.active_filter == "all":
            return email.get("urgency") != "Low" and email.get("status") != "Completed"
        if self.active_filter == "needs_reply":
            return email.get("status") == "Needs Reply"
        if self.active_filter == "waiting_customer":
            return email.get("status") == "Waiting on Customer"
        if self.active_filter == "waiting_vendor":
            return email.get("status") == "Waiting on Vendor"
        if self.active_filter == "completed":
            return email.get("status") == "Completed"
        if self.active_filter == "urgent":
            return email.get("urgency") in ["High", "Critical"] and email.get("status") != "Completed"
        if self.active_filter == "followups":
            return bool(self.get_active_followup_for_email(email.get("entry_id")))
        if self.active_filter == "low":
            return email.get("urgency") == "Low"
        return email.get("urgency") != "Low"

