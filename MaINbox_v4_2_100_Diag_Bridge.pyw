            filt.append({"id": f"filter_{_key}", "label": _txt, "section": "filter",
                         "pad": 4, "pady": 5, "make": _mk_filter})
        filt.append({"id": "delete_app_only", "label": "Delete from App Only", "section": "filter_tools",
                     "pad": 4, "pady": 5,
                     "make": lambda p: tk.Button(p, text="Delete from App Only", command=self.delete_low_hidden_from_app)})
        filt.append({"id": "deleted_history", "label": "Deleted History", "section": "filter_tools",
                     "pad": 4, "pady": 5,
                     "make": lambda p: tk.Button(p, text="Deleted History", command=self.open_deleted_history_window)})
        filt.append({"id": "search", "label": "Search", "section": "filter_tools",
                     "pad": 4, "pady": 5,
                     "make": lambda p: tk.Button(p, text="Search", command=self.open_search_window)})
        specs["filter"] = filt
        return specs

    def _button_layout_path(self):
        return data_path("mainbox_button_layout.json")

    def _load_button_layout(self):
        try:
            with open(self._button_layout_path(), "r", encoding="utf-8") as f:
                data = json.load(f)
            return data if isinstance(data, dict) else {}
        except Exception:
            return {}

    def _save_button_layout(self, layout):
        try:
            with open(self._button_layout_path(), "w", encoding="utf-8") as f:
                json.dump(layout, f, indent=2)
            return True
        except Exception:
            return False

    def _merged_button_order(self, key, specs=None):
        """[(spec, visible)] for toolbar `key`: saved order/visibility first, then any
        manifest buttons not in the saved layout appended (visible) -- so a button
        added in a later version still appears without wiping the user's layout."""
        if specs is None:
            specs = self._main_button_specs().get(key, [])
        by_id = {s["id"]: s for s in specs}
        saved = self._load_button_layout().get(key, [])
        result, seen = [], set()
        for row in saved:
            if not isinstance(row, dict):
                continue
            bid = row.get("id")
            if bid in by_id and bid not in seen:
                result.append((by_id[bid], bool(row.get("v", True))))
                seen.add(bid)
        for s in specs:
            if s["id"] not in seen:
                result.append((s, True))
                seen.add(s["id"])
        return result

    def _build_toolbar(self, key):
        """(Re)render one button bar from the manifest + saved layout. Safe to call
        again any time (e.g. after the Edit Buttons dialog saves) -- it clears and
        rebuilds only that bar's buttons; the frame itself stays put."""
        frame = self._toolbar_frames.get(key) if isinstance(getattr(self, "_toolbar_frames", None), dict) else None
        if not frame:
            return
        try:
            if not frame.winfo_exists():
                return
        except Exception:
            return
        for child in frame.winfo_children():
            child.destroy()
        if key == "filter":
            self._filter_buttons = {}
        specs = self._main_button_specs().get(key, [])
        vertical = (key == "group")
        last_section = None
        for spec, visible in self._merged_button_order(key, specs):
            if not visible:
                continue
            if vertical and last_section is not None and spec.get("section") != last_section:
                tk.Frame(frame, bg=_BORDER, height=1).pack(fill="x", padx=6, pady=(5, 4))
            try:
                btn = spec["make"](frame)
            except Exception:
                continue
            if vertical:
                btn.pack(anchor="w", pady=2)
            else:
                btn.pack(side="left", padx=spec.get("pad", 5), pady=spec.get("pady", 0))
            last_section = spec.get("section")
        if key == "filter":
            try:
                self._refresh_filter_button_styles()
            except Exception:
                pass

    def open_button_editor(self):
        """Settings -> Visual Settings -> Edit Buttons. Tick to show / untick to hide
        a button; arrows reorder. Changes apply live (and persist) on Save."""
        specs_all = self._main_button_specs()
        order = ["group", "edit", "filter", "action"]
        titles = {"group": "Left Group / Tools column", "edit": "Edit Selected Email(s) bar",
                  "filter": "Filters bar", "action": "Bottom Action bar"}
        win = tk.Toplevel(self.root)
        win.title("Edit Buttons")
        remember_window_geometry(win, "MaINbox Edit Buttons", "560x740")
        win.transient(self.root)
        apply_theme(win)
        tk.Label(win, text="Edit Buttons", font=(_FONT, 16, "bold"), fg=_ACCENT, bg=_BG).pack(anchor="w", padx=14, pady=(12, 2))
        tk.Label(win, text="Tick to show a button, untick to hide it. Use the arrows to reorder within a bar. "
                           "Changes apply when you click Save.",
                 bg=_BG, fg=_FG_DIM, wraplength=520, justify="left").pack(anchor="w", padx=14, pady=(0, 8))

        holder = tk.Frame(win, bg=_BG)
        holder.pack(fill="both", expand=True, padx=0, pady=0)
        canvas = tk.Canvas(holder, bg=_BG, highlightthickness=0)
        scroll = ttk.Scrollbar(holder, orient="vertical", command=canvas.yview)
        content = tk.Frame(canvas, bg=_BG)
        content.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=content, anchor="nw")
        canvas.configure(yscrollcommand=scroll.set)
        canvas.pack(side="left", fill="both", expand=True)
        scroll.pack(side="right", fill="y")

        state = {}        # key -> [[id, label, BooleanVar], ...] in current order
        row_frames = {}   # key -> frame the rows live in

        for key in order:
            specs = specs_all.get(key, [])
            state[key] = [[s["id"], s["label"], tk.BooleanVar(value=vis)]
                          for s, vis in self._merged_button_order(key, specs)]

        def render_rows(key):
            rf = row_frames[key]
            for ch in rf.winfo_children():
                ch.destroy()
            for idx, (bid, label, var) in enumerate(state[key]):
                row = tk.Frame(rf, bg=_BG2)
                row.pack(fill="x", pady=1)
                tk.Checkbutton(row, variable=var, bg=_BG2, fg=_FG, selectcolor=_BG3, activebackground=_BG2).pack(side="left")
                tk.Label(row, text=label, bg=_BG2, fg=_FG, anchor="w", width=26).pack(side="left", padx=(2, 6))
                tk.Button(row, text="\u25b2", width=2, command=lambda k=key, i=idx: move(k, i, -1)).pack(side="left", padx=1)
                tk.Button(row, text="\u25bc", width=2, command=lambda k=key, i=idx: move(k, i, 1)).pack(side="left", padx=1)

        def move(key, idx, delta):
            lst = state[key]
            j = idx + delta
            if 0 <= j < len(lst):
                lst[idx], lst[j] = lst[j], lst[idx]
                render_rows(key)

        for key in order:
            lf = tk.LabelFrame(content, text=titles.get(key, key), bg=_BG2, fg=_ACCENT, padx=8, pady=6)
            lf.pack(fill="x", padx=14, pady=6)
            rf = tk.Frame(lf, bg=_BG2)
            rf.pack(fill="x")
            row_frames[key] = rf
            render_rows(key)

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=14, pady=10)

        def do_save():
            layout = {}
            for key in order:
                layout[key] = [{"id": bid, "v": bool(var.get())} for bid, label, var in state[key]]
            self._save_button_layout(layout)
            for key in order:
                try:
                    self._build_toolbar(key)
                except Exception:
                    pass
            win.destroy()

        def do_reset():
            if messagebox.askyesno("Reset Buttons",
                                   "Restore every button to its default order and make them all visible?",
                                   parent=win):
                self._save_button_layout({})
                for key in order:
                    try:
                        self._build_toolbar(key)
                    except Exception:
                        pass
                win.destroy()

        tk.Button(btns, text="Save", command=do_save, bg=_ACCENT, fg="#ffffff",
                  activebackground=_ACCENT2, activeforeground="#ffffff",
                  font=(_FONT, _FONT_SIZE, "bold"), width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Cancel", command=win.destroy, width=10).pack(side="right", padx=4)
        tk.Button(btns, text="Reset to defaults", command=do_reset, width=16).pack(side="left", padx=4)

    # ------------------------------------------------------------------
    # v4.2.34 Inbox Viewer: a live, Outlook-style view of the user's chosen
    # inbox folders INSIDE MaINbox, so grouping/organizing no longer requires
    # flipping to Outlook and hoping the sync caught up. Phase 1 of 3
    # (viewer + mailbox picker + own-category highlight + column editor);
    # drag-to-group and send land in later phases. All Outlook reads go
    # through run_outlook_worker (never the Tk thread); workers return plain
    # dicts only. Config lives in its own file (mainbox_inbox_viewer.json),
    # mirroring the button-layout store, so mainbox_settings.json is untouched.
    # ------------------------------------------------------------------

    def _inbox_viewer_config_path(self):
        return data_path("mainbox_inbox_viewer.json")

    def _load_inbox_viewer_config(self):
        try:
            with open(self._inbox_viewer_config_path(), "r", encoding="utf-8") as f:
                data = json.load(f)
            return data if isinstance(data, dict) else {}
        except Exception:
            return {}

    def _save_inbox_viewer_config(self, updates):
        """Read-modify-write so folder and column saves never clobber each other."""
        cfg = self._load_inbox_viewer_config()
        try:
            cfg.update(updates or {})
            with open(self._inbox_viewer_config_path(), "w", encoding="utf-8") as f:
                json.dump(cfg, f, indent=2)
            return True
        except Exception:
            return False

    def _inbox_viewer_column_specs(self):
        """Single source of truth for Inbox Viewer columns (id order = Treeview
        values order, so ids may be hidden/reordered but never re-mapped)."""
        return [
            {"id": "categories", "label": "Categories", "width": 110},
            {"id": "company", "label": "Company", "width": 110, "default_visible": False},
            {"id": "from", "label": "From", "width": 170},
            {"id": "sender_email", "label": "Email Address", "width": 190, "default_visible": False},
            {"id": "subject", "label": "Subject", "width": 380},
            {"id": "group", "label": "Group", "width": 130},
            {"id": "status", "label": "Status", "width": 110, "default_visible": False},
            {"id": "received", "label": "Received", "width": 130},
            {"id": "folder", "label": "Mailbox", "width": 100},
        ]

    def _merged_inbox_viewer_columns(self):
        """[(spec, visible, width)] -- saved order/visibility/width first, then any
        columns added in a later version appended per their default (same
        forward-compat merge as _merged_button_order)."""
        specs = self._inbox_viewer_column_specs()
        by_id = {s["id"]: s for s in specs}
        saved = self._load_inbox_viewer_config().get("columns", [])
        result, seen = [], set()
        for row in saved if isinstance(saved, list) else []:
            if not isinstance(row, dict):
                continue
            cid = row.get("id")
            if cid in by_id and cid not in seen:
                spec = by_id[cid]
                try:
                    width = int(row.get("w") or spec.get("width", 100))
                except Exception:
                    width = spec.get("width", 100)
                result.append((spec, bool(row.get("v", True)), width))
                seen.add(cid)
        for s in specs:
            if s["id"] not in seen:
                result.append((s, bool(s.get("default_visible", True)), s.get("width", 100)))
                seen.add(s["id"])
        return result

    def _apply_inbox_viewer_columns(self, tree):
        """(Re)apply saved column order/visibility/widths to a live viewer tree.
        Safe to call again any time (the column editor calls it on Save)."""
        try:
            merged = self._merged_inbox_viewer_columns()
            for spec, _visible, width in merged:
                tree.heading(spec["id"], text=spec["label"],
                             command=lambda c=spec["id"]: self._inbox_viewer_sort_by(c))
                tree.column(spec["id"], width=max(40, int(width)), minwidth=40,
                            stretch=(spec["id"] == "subject"), anchor="w")
            visible = [spec["id"] for spec, vis, _w in merged if vis]
            if not visible:
                visible = ["subject", "received"]
            tree["displaycolumns"] = visible
        except Exception:
            pass

    def _inbox_viewer_selected_folders(self):
        """Saved folder picks, or the stock My Inbox + Sales pair when nothing
        was ever chosen. Sentinel dicts ({'default': ...}) are resolved on the
        worker so first-run needs no Outlook call to build a default config."""
        saved = self._load_inbox_viewer_config().get("folders", [])
        picks = [f for f in saved if isinstance(f, dict) and f.get("selected", True)] \
            if isinstance(saved, list) else []
        if picks:
            return picks
        return [{"default": "my_inbox", "store": "My Inbox"},
                {"default": "sales_inbox", "store": SALES_MAILBOX_NAME}]

    def _inbox_viewer_company_from_email(self, addr):
        try:
            domain = addr.split("@", 1)[1] if "@" in (addr or "") else ""
            return domain.split(".")[0].capitalize() if domain else ""
        except Exception:
            return ""

    def _inbox_viewer_enumerate_inboxes_work(self, namespace):
        """WORKER-THREAD ONLY. Every store Outlook exposes, with its locale-safe
        default Inbox (Store hop first, named subfolder fallback -- same order
        as _find_sales_sent_folder_in). Plain dicts only."""
        found = []
        try:
            folders = namespace.Folders
            for i in range(1, folders.Count + 1):
                try:
                    root = folders.Item(i)
                    store_name = str(root.Name)
                    inbox = None
                    try:
                        inbox = root.Store.GetDefaultFolder(6)  # olFolderInbox, locale-safe
                    except Exception:
                        try:
                            inbox = root.Folders.Item("Inbox")
                        except Exception:
                            inbox = None
                    if inbox is None:
                        continue
                    found.append({
                        "store": store_name,
                        "name": str(getattr(inbox, "Name", "Inbox") or "Inbox"),
                        "entry_id": str(getattr(inbox, "EntryID", "") or ""),
                        "store_id": str(getattr(inbox, "StoreID", "") or ""),
                    })
                except Exception:
                    continue
        except Exception:
            pass
        return found

    def _inbox_viewer_resolve_folder(self, namespace, sel):
        """WORKER-THREAD ONLY. Resolve one saved pick to (folder, label).
        EntryID first, then a store-name walk (EntryIDs drift under Cached
        Exchange Mode, so a stale id must not blank the whole mailbox)."""
        label = str(sel.get("store") or sel.get("name") or "Inbox")
        if sel.get("default") == "my_inbox":
            try:
                return namespace.GetDefaultFolder(6), "My Inbox"
            except Exception:
                return None, label
        if sel.get("default") == "sales_inbox":
            return self._find_sales_inbox_folder_in(namespace), SALES_MAILBOX_NAME
        try:
            if sel.get("entry_id"):
                return namespace.GetFolderFromID(sel["entry_id"], sel.get("store_id") or None), label
        except Exception:
            pass
        try:
            folders = namespace.Folders
            for i in range(1, folders.Count + 1):
                root = folders.Item(i)
                if str(root.Name).strip().lower() == str(sel.get("store", "")).strip().lower():
                    try:
                        return root.Store.GetDefaultFolder(6), label
                    except Exception:
                        try:
                            return root.Folders.Item("Inbox"), label
                        except Exception:
                            return None, label
        except Exception:
            pass
        return None, label

    def _inbox_viewer_collect_work(self, namespace, folder_sels, limit):
        """WORKER-THREAD ONLY. Newest `limit` mail items per selected folder as
        plain dicts (no COM objects cross the marshal boundary). Mail only
        (Class 43) in Phase 1 -- meeting requests etc. are skipped."""
        rows, errors = [], []
        for sel in folder_sels:
            try:
                folder, label = self._inbox_viewer_resolve_folder(namespace, sel)
            except Exception as exc:
                folder, label = None, str(sel.get("store", "?"))
                errors.append(f"{label}: {exc}")
            if folder is None:
                errors.append(f"Could not open inbox for '{label}'")
                continue
            try:
                items = folder.Items
                items.Sort("[ReceivedTime]", True)
            except Exception as exc:
                errors.append(f"{label}: {exc}")
                continue
            count = 0
            try:
                msg = items.GetFirst()
            except Exception:
                msg = None
            while msg is not None and count < limit:
                try:
                    if int(getattr(msg, "Class", 0) or 0) == 43:  # olMail
                        received_disp, received_ts = "", 0.0
                        rt = getattr(msg, "ReceivedTime", None)
                        if rt is not None:
                            try:
                                received_disp = rt.strftime("%a %m/%d %I:%M %p")
                            except Exception:
                                received_disp = str(rt)
                            try:
                                received_ts = rt.timestamp()
                            except Exception:
                                received_ts = 0.0
                        sender_email = self.get_sender_email(msg)
                        # v4.2.40 linking foundation: Message-ID (drift-proof
                        # identity) + ConversationID captured on every scan.
                        imid = ""
                        try:
                            imid = outlook_msg_internet_id(msg)
                        except Exception:
                            imid = ""
                        conv_id = ""
                        try:
                            conv_id = str(msg.ConversationID or "")
                        except Exception:
                            conv_id = ""
                        rows.append({
                            "message_id": imid,
                            "conversation_id": conv_id,
                            "entry_id": str(getattr(msg, "EntryID", "") or ""),
                            "store_id": str(getattr(getattr(msg, "Parent", None), "StoreID", "") or ""),
                            "subject": str(getattr(msg, "Subject", "") or ""),
                            "sender": str(getattr(msg, "SenderName", "") or ""),
                            # v4.2.43 FIX: the From column's id is "from", but rows only
                            # carried "sender" -- the cell lookup row.get("from") was
                            # always empty, so From rendered blank since v4.2.34.
                            "from": str(getattr(msg, "SenderName", "") or ""),
                            "sender_email": sender_email,
                            "company": self._inbox_viewer_company_from_email(sender_email),
                            "categories": str(getattr(msg, "Categories", "") or ""),
                            "unread": bool(getattr(msg, "UnRead", False)),
                            "received": received_disp,
                            "received_ts": received_ts,
                            "folder": label,
                        })
                        count += 1
                except Exception:
                    pass
                try:
                    msg = items.GetNext()
                except Exception:
                    break
        return {"rows": rows, "errors": errors}

    def _inbox_viewer_make_tree(self, parent):
        """One viewer Treeview with scrollbars, columns, highlight tags and
        bindings. Used for the single view and for every split pane."""
        col_ids = [s["id"] for s in self._inbox_viewer_column_specs()]
        tree = ttk.Treeview(parent, columns=col_ids, show="headings", selectmode="extended")
        vsb = ttk.Scrollbar(parent, orient="vertical", command=tree.yview)
        hsb = ttk.Scrollbar(parent, orient="horizontal", command=tree.xview)
        tree.configure(yscrollcommand=vsb.set, xscrollcommand=hsb.set)
        vsb.pack(side="right", fill="y")
        hsb.pack(side="bottom", fill="x")
        tree.pack(side="left", fill="both", expand=True)
        self._apply_inbox_viewer_columns(tree)
        # Own-category rows get a tinted background (the Outlook-side "my
        # emails" cue Steve works from); unread stays bold like Outlook.
        # v4.2.74 (Steve): unread rows also get the same YELLOW highlight a group
        # gets when new mail arrives (#4a3800/#ffd966, the group_header_new
        # colors), so new/unread mail stands out at a glance. A row that is BOTH
        # mine and unread keeps the mine background (the claim cue) and takes the
        # yellow text + bold, so the two cues stay distinguishable.
        _stg = self.settings if isinstance(getattr(self, "settings", None), dict) else {}
        mine_bg = _stg.get("color_inbox_viewer_mine_bg", "#1f4a5f")
        unread_bg = _stg.get("color_inbox_viewer_unread_bg", "#4a3800")
        unread_fg = _stg.get("color_inbox_viewer_unread_fg", "#ffd966")
        tree.tag_configure("unread", background=unread_bg, foreground=unread_fg,
                           font=(_FONT, _FONT_SIZE, "bold"))
        tree.tag_configure("mine", background=mine_bg)
        tree.tag_configure("mine_unread", background=mine_bg, foreground=unread_fg,
                           font=(_FONT, _FONT_SIZE, "bold"))
        tree.bind("<Double-1>", lambda e: self._inbox_viewer_open_selected())
        tree.bind("<Button-3>", self._inbox_viewer_context_menu)
        # Panes each keep their own Treeview selection, so remember which tree
        # the user touched last -- selection lookups prefer it.
        tree.bind("<<TreeviewSelect>>", lambda e, t=tree: setattr(self, "_inbox_viewer_active_tree", t), add="+")
        # v4.2.42: feed the optional reading pane (debounced; no-op when off).
        tree.bind("<<TreeviewSelect>>", self._inbox_viewer_on_select_preview, add="+")
        # v4.2.36 Phase 2: drag rows out of the viewer onto a group in the main
        # window. add="+" keeps the default Treeview click/selection behavior.
        tree.bind("<ButtonPress-1>", self._inbox_viewer_drag_press, add="+")
        tree.bind("<B1-Motion>", self._inbox_viewer_drag_motion, add="+")
        tree.bind("<ButtonRelease-1>", self._inbox_viewer_drag_release, add="+")
        # v4.2.38: Delete key deletes the selected emails (real Outlook delete
        # into that mailbox's Deleted Items; undo toast + history to restore).
        tree.bind("<Delete>", self._inbox_viewer_delete_selected)
        return tree

    def _inbox_viewer_pane_labels(self):
        """Mailbox labels for split panes, in configured order -- must produce
        the same strings the scan worker stamps into row['folder']."""
        labels = []
        for sel in self._inbox_viewer_selected_folders():
            if sel.get("default") == "my_inbox":
                labels.append("My Inbox")
            elif sel.get("default") == "sales_inbox":
                labels.append(SALES_MAILBOX_NAME)
            else:
                labels.append(str(sel.get("store") or sel.get("name") or "Inbox"))
        return labels

    def _build_inbox_viewer_body(self, pane_labels=None):
        """(Re)build the viewer's tree area: one flat list, or -- when the
        'Split panes' toggle is on (v4.2.35) -- one resizable pane per mailbox
        in a vertical tk.PanedWindow (drag the sash between panes)."""
        area = getattr(self, "_inbox_viewer_pane_area", None)
        try:
            if area is None or not area.winfo_exists():
                return
        except Exception:
            return
        for ch in area.winfo_children():
            ch.destroy()
        self._inbox_viewer_trees = []
        self._inbox_viewer_pane_headers = {}
        split = bool(self._load_inbox_viewer_config().get("split_panes", False))
        if not split:
            holder = tk.Frame(area, bg=_BG)
            holder.pack(fill="both", expand=True)
            self._inbox_viewer_trees.append((None, self._inbox_viewer_make_tree(holder)))
            self._inbox_viewer_built_labels = []
            return
        labels = list(pane_labels) if pane_labels else self._inbox_viewer_pane_labels()
        if not labels:
            labels = ["Inbox"]
        paned = tk.PanedWindow(area, orient="vertical", sashwidth=6, bg=_BORDER,
                               bd=0, sashrelief="flat", opaqueresize=True)
        paned.pack(fill="both", expand=True)
        for label in labels:
            pane = tk.Frame(paned, bg=_BG)
            header_var = tk.StringVar(value=label)
            tk.Label(pane, textvariable=header_var, font=(_FONT, _FONT_SIZE, "bold"),
                     fg=_ACCENT, bg=_BG2, anchor="w", padx=8).pack(fill="x")
            holder = tk.Frame(pane, bg=_BG)
            holder.pack(fill="both", expand=True)
            self._inbox_viewer_pane_headers[label] = header_var
            self._inbox_viewer_trees.append((label, self._inbox_viewer_make_tree(holder)))
            paned.add(pane, minsize=90)
        self._inbox_viewer_built_labels = labels

    def _inbox_viewer_toggle_split(self):
        split = bool(getattr(self, "_inbox_viewer_split_var", None) and self._inbox_viewer_split_var.get())
        self._save_inbox_viewer_config({"split_panes": split})
        ops_log("inbox_viewer", "split_panes_toggled", on=split)
        self._build_inbox_viewer_body()
        self._render_inbox_viewer_rows()

    def _inbox_viewer_row_is_unclaimed(self, row, my_cat, neutral):
        """v4.2.39 Unclaimed rule (Steve's spec): keep rows that are the user's
        (their category present), uncategorized, or tagged with ONLY neutral
        categories (default: Canals). Anything claimed by a colleague drops."""
        cats = {p.strip().casefold()
                for p in re.split(r"[;,]", str(row.get("categories", "") or ""))
                if p.strip()}
        if not cats:
            return True
        if my_cat and my_cat.strip().casefold() in cats:
            return True
        return cats <= neutral

    def _inbox_viewer_toggle_unclaimed(self):
        on = bool(getattr(self, "_inbox_viewer_unclaimed_var", None) and self._inbox_viewer_unclaimed_var.get())
        self._save_inbox_viewer_config({"unclaimed_only": on})
        ops_log("inbox_viewer", "unclaimed_toggled", on=on)
        self._render_inbox_viewer_rows()

    def _inbox_viewer_toggle_category(self, rows, category):
        """Right-click -> Categories -> <cat>: flip that Outlook category on the
        selected rows (write + Save on a worker -- same precedent as the Sales
        uncategorized queue's category apply). Each row toggles its own state."""
        jobs = [dict(r) for r in (rows or []) if isinstance(r, dict) and r.get("entry_id")]
        cat = str(category or "").strip()
        if not jobs or not cat:
            return

        def work(outlook, namespace):
            out = []
            for row in jobs:
                try:
                    if row.get("store_id"):
                        msg = namespace.GetItemFromID(row["entry_id"], row["store_id"])
                    else:
                        msg = namespace.GetItemFromID(row["entry_id"])
                    parts = [p.strip() for p in re.split(r"[;,]", str(msg.Categories or "")) if p.strip()]
                    if any(p.casefold() == cat.casefold() for p in parts):
                        parts = [p for p in parts if p.casefold() != cat.casefold()]
                    else:
                        parts.append(cat)
                    msg.Categories = ", ".join(parts)
                    msg.Save()
                    out.append((row["entry_id"], ", ".join(parts)))
                except Exception:
                    continue
            return out

        def done(result):
            by_eid = dict(result or [])
            changed = 0
            for r in (getattr(self, "_inbox_viewer_rows", None) or []):
                if r.get("entry_id") in by_eid:
                    r["categories"] = by_eid[r["entry_id"]]
                    changed += 1
            if changed:
                self._render_inbox_viewer_rows()
            try:
                self._inbox_viewer_status_var.set(f"Category '{cat}' toggled on {len(by_eid)} email(s).")
            except Exception:
                pass
            ops_log("inbox_viewer", "category_toggled", category=cat,
                    count=len(by_eid), asked=len(jobs))
            # v4.2.41 auto-ingest on claim (decision locked 2026-08-18): an
            # email the user just tagged with their own category enters the
            # real import pipeline immediately -- no waiting for a refresh.
            my = str(getattr(self, "selected_sales_category", "") or "")
            claimed = []
            if my:
                for eid, cats in by_eid.items():
                    if self.email_has_outlook_category(cats, my) and self.get_email_by_id(eid) is None:
                        row = next((r for r in jobs if r.get("entry_id") == eid), None)
                        if row:
                            claimed.append(row)
            if claimed:
                self._inbox_viewer_ingest_rows(claimed, triage=True, reason="claimed")

        def error(exc):
            try:
                self._inbox_viewer_status_var.set(f"Category change failed: {exc}")
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-category")

    def _inbox_viewer_ingest_rows(self, rows, triage=False, reason="", on_finish=None):
        """v4.2.41: pull viewer rows through the REAL import chokepoint
        (build_email_data on a worker -> upsert_email), optionally queueing AI
        triage. Used by auto-ingest-on-claim; junk/app_deleted gates apply."""
        jobs = [dict(r) for r in (rows or []) if isinstance(r, dict) and r.get("entry_id")]
        if not jobs:
            return

        def work(outlook, namespace):
            fetched = []
            for row in jobs:
                try:
                    if row.get("store_id"):
                        msg = namespace.GetItemFromID(row["entry_id"], row["store_id"])
                    else:
                        msg = namespace.GetItemFromID(row["entry_id"])
                    source = str(row.get("folder") or "") or "My Inbox"
                    data = self.build_email_data(msg, source)
                    if isinstance(data, dict) and data.get("entry_id"):
                        fetched.append(data)
                except Exception:
                    continue
            return fetched

        def done(fetched):
            imported = []
            for data in fetched or []:
                try:
                    self.upsert_email(data)
                    rec = self.get_email_by_id(data.get("entry_id", ""))
                    if rec is not None:
                        imported.append(rec)
                except Exception:
                    continue
            if imported:
                try:
                    self.sort_emails_for_display()
                    self.render_email_rows()
                except Exception:
                    pass
                self._render_inbox_viewer_rows()  # Group/Status columns link up now
                if triage:
                    try:
                        self.start_ai_triage_for_emails(
                            imported, task_name=f"Triaging {len(imported)} claimed email(s)",
                            allow_group_prompt=False)
                    except Exception:
                        pass
            ops_log("inbox_viewer", "rows_ingested", count=len(imported),
                    asked=len(jobs), reason=reason, triage=bool(triage))
            if on_finish:
                try:
                    on_finish(imported)
                except Exception:
                    pass

        def error(exc):
            try:
                self._inbox_viewer_status_var.set(f"Import failed: {exc}")
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-ingest")

    def _inbox_viewer_rfq_urgency(self, rec, row=None):
        """v4.2.46 urgency rule for Send to RFQ (Steve's spec): floor is Normal
        (so the email shows on Show All), urgency words bump High, emergency
        words bump Critical, and an already-higher urgency is never lowered.
        Returns (urgency, matched_word)."""
        rank = {"Low": 0, "": 0, "Normal": 1, "High": 2, "Critical": 3}
        text = " ".join(str(x or "") for x in (
            rec.get("subject", ""), rec.get("body", ""),
            (row or {}).get("subject", ""), (row or {}).get("body_preview", ""))).lower()
        matched = ""
        want = "Normal"
        for word in ("emergency", "critical"):
            if word in text:
                want, matched = "Critical", word
                break
        if want != "Critical":
            for word in ("urgent", "important", "asap", "a.s.a.p", "rush",
                         "immediately", "time sensitive", "expedite", "priority"):
                if word in text:
                    want, matched = "High", word
                    break
        current = str(rec.get("urgency", "") or "")
        if rank.get(current, 0) >= rank.get(want, 1):
            return current, matched
        return want, matched

    def _inbox_viewer_send_to_rfq(self):
        """Right-click -> Send to RFQ: ingest the email if MaINbox doesn't have
        it yet, raise urgency per the keyword rule, make sure it shows on Show
        All (never Completed / Low), lock it from AI re-triage (journaled), and
        open the existing single-email Quote RFQ flow."""
        trees = [t for _l, t in getattr(self, "_inbox_viewer_trees", None) or []]
        active = getattr(self, "_inbox_viewer_active_tree", None)
        if active in trees:
            trees = [active] + [t for t in trees if t is not active]
        rows = []
        for tree in trees:
            rows = self._inbox_viewer_rows_for_tree_selection(tree)
            if rows:
                break
        if not rows:
            return
        row = rows[0]
        if len(rows) > 1:
            try:
                self._inbox_viewer_status_var.set("Send to RFQ uses the first selected email.")
            except Exception:
                pass

        def _finish(rec):
            if rec is None:
                try:
                    self._inbox_viewer_status_var.set("Send to RFQ: email could not be imported.")
                except Exception:
                    pass
                return
            # v4.2.48: Send to RFQ on a previously CLOSED email is an explicit
            # reopen -- record it as such and clear the closed-email guard, or
            # the guard re-applies the old Completed at the next startup and
            # the RFQ status silently snaps back (bit Steve live on the wire
            # quote: Completed 14:01 -> RFQ'd High 14:38 -> boot re-completed).
            _eid = str(rec.get("entry_id", "") or "")
            _was_closed = (self.workflow_record_is_closed(rec)
                           or self.workflow_record_is_closed(self.status_data.get(_eid, {}))
                           or bool(self._find_closed_email_guard(rec, self.status_data.get(_eid, {}))))
            urgency, matched = self._inbox_viewer_rfq_urgency(rec, row)
            rec["urgency"] = urgency
            if str(rec.get("status", "") or "") in ("", "Completed"):
                rec["status"] = "Needs Reply"
            if not str(rec.get("category", "") or ""):
                rec["category"] = "Quote / Estimate"
            rec["is_new_import"] = False
            rec["ai_user_locked"] = True  # explicit user decision; journaled by save_record
            rec["ai_triage_pending"] = False
            rec["ai_triaged_at"] = rec.get("ai_triaged_at") or datetime.now().isoformat()
            if _was_closed and not self.workflow_record_is_closed(rec):
                rec["explicit_reopened_at"] = datetime.now().isoformat()
                rec["workflow_closed_at"] = ""
                try:
                    if self.clear_closed_email_guard(rec, save=False):
                        self._save_closed_email_guard()
                except Exception:
                    pass
            self.save_record(rec)
            self.flush_status_data()
            try:
                self.sort_emails_for_display()
                self.render_email_rows()
            except Exception:
                pass
            self._render_inbox_viewer_rows()
            ops_log("inbox_viewer", "send_to_rfq", urgency=urgency,
                    matched_word=matched, subject=str(rec.get("subject", ""))[:80])
            try:
                self._inbox_viewer_status_var.set(
                    f"Sent to RFQ as {urgency}" + (f" (matched '{matched}')" if matched else "") + ".")
            except Exception:
                pass
            self.open_quote_intelligence_for_selected_email(email=rec)

        rec = self.get_email_by_id(row.get("entry_id", ""))
        if rec is not None:
            _finish(rec)
            return
        try:
            self._inbox_viewer_status_var.set("Importing email for RFQ...")
        except Exception:
            pass
        self._inbox_viewer_ingest_rows(
            [row], triage=False, reason="send_to_rfq",
            on_finish=lambda imported: _finish(imported[0] if imported else None))

    def _inbox_viewer_sync_sweep(self, rows):
        """v4.2.41 reconciliation sweep (decisions locked 2026-08-18): the
        viewer scan is ground truth for the real inbox, so every refresh
        (1) auto-updates MaINbox rows whose Outlook categories changed, and
        (2) finds app emails that vanished from a scanned window, verifies
        them on a worker, and mirrors CONFIRMED Outlook deletes (item sitting
        in Deleted Items) through the existing app-delete path -- Deleted
        History snapshot, tracker clears, guard stamp. Unverifiable rows
        (older than the scan window, moved to other folders) are left alone."""
        rows = [r for r in (rows or []) if isinstance(r, dict)]
        if not rows:
            return
        msgid_index = {}
        for e in getattr(self, "emails", None) or []:
            mid = str(e.get("internet_message_id", "") or "")
            if mid:
                msgid_index[mid] = e
        cat_changed = 0
        scanned_eids, scanned_mids = set(), set()
        folder_oldest, folder_counts = {}, {}
        for row in rows:
            eid = row.get("entry_id", "")
            mid = str(row.get("message_id", "") or "")
            if eid:
                scanned_eids.add(eid)
            if mid:
                scanned_mids.add(mid)
            lbl = str(row.get("folder", "") or "")
            ts = float(row.get("received_ts", 0.0) or 0.0)
            folder_counts[lbl] = folder_counts.get(lbl, 0) + 1
            if ts > 0:
                folder_oldest[lbl] = min(ts, folder_oldest.get(lbl, ts))
            rec = self.get_email_by_id(eid) or (msgid_index.get(mid) if mid else None)
            if rec is not None:
                new_cats = str(row.get("categories", "") or "")
                if str(rec.get("outlook_categories", "") or "") != new_cats:
                    rec["outlook_categories"] = new_cats
                    cat_changed += 1
        if cat_changed:
            try:
                self.render_email_rows()
            except Exception:
                pass
            ops_log("inbox_viewer", "sweep_categories_updated", count=cat_changed)

        try:
            limit = int(self._load_inbox_viewer_config().get("scan_limit", 200))
        except Exception:
            limit = 200
        candidates = []
        for e in getattr(self, "emails", None) or []:
            try:
                if e.get("is_sent_waiting_placeholder"):
                    continue
                src = str(e.get("source", "") or "")
                if src not in folder_counts:
                    continue  # that mailbox was not part of this scan
                ts = float(e.get("received_timestamp", 0.0) or 0.0)
                if folder_counts.get(src, 0) >= limit and (not ts or ts < folder_oldest.get(src, 0.0)):
                    continue  # older than the scanned window -> unknown, skip
                if e.get("entry_id", "") in scanned_eids:
                    continue
                mid = str(e.get("internet_message_id", "") or "")
                if mid and mid in scanned_mids:
                    continue
                candidates.append({"entry_id": e.get("entry_id", ""),
                                   "store_id": e.get("store_id", ""),
                                   "message_id": mid, "source": src})
            except Exception:
                continue
        candidates = candidates[:50]
        if not candidates:
            return

        def work(outlook, namespace):
            confirmed = []
            for cand in candidates:
                try:
                    in_deleted = False
                    msg = None
                    try:
                        if cand.get("store_id"):
                            msg = namespace.GetItemFromID(cand["entry_id"], cand["store_id"])
                        else:
                            msg = namespace.GetItemFromID(cand["entry_id"])
                    except Exception:
                        msg = None
                    if msg is not None:
                        # Item still exists -- deleted only if its parent IS the
                        # store's Deleted Items (EntryID compare, name fallback).
                        try:
                            parent = msg.Parent
                            deleted_folder = parent.Store.GetDefaultFolder(3)
                            try:
                                in_deleted = str(parent.EntryID) == str(deleted_folder.EntryID)
                            except Exception:
                                in_deleted = (str(parent.Name or "").strip().lower()
                                              == str(deleted_folder.Name or "").strip().lower())
                        except Exception:
                            in_deleted = False
                    else:
                        # EntryID dead (hard churn) -- look for the Message-ID in
                        # that store's Deleted Items.
                        dfold = self._inbox_viewer_locate_deleted_items(namespace, cand.get("store_id", ""))
                        found = self._inbox_viewer_find_by_message_id(dfold, cand.get("message_id", ""))
                        in_deleted = found is not None
                    if in_deleted:
                        confirmed.append(cand["entry_id"])
                except Exception:
                    continue
            return confirmed

        def done(confirmed):
            confirmed = set(confirmed or [])
            if not confirmed:
                return
            emails = [e for e in (getattr(self, "emails", None) or [])
                      if e.get("entry_id") in confirmed]
            if not emails:
                return
            try:
                removed, _kept, cancelled = self.perform_app_delete(emails, "cancel")
            except Exception as exc:
                ops_log("inbox_viewer", "sweep_mirror_delete_failed", err=str(exc)[:200])
                return
            ops_log("inbox_viewer", "sweep_mirrored_deletes", count=removed,
                    trackers_cancelled=cancelled)
            try:
                self.set_status(f"Sync: mirrored {removed} Outlook delete(s) into MaINbox Deleted History.")
            except Exception:
                pass

        def error(exc):
            # Busy worker just means the next 2-minute sweep catches it.
            pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-sweep")

    # ------------------------------------------------------------------
    # v4.2.42: optional reading pane (right side, resizable, never auto-marks
    # read -- shared-mailbox read state is a team signal) + right-click Mark
    # as Read / Unread. Unread bold has existed since v4.2.34; marking
    # re-renders so boldness updates instantly.
    # ------------------------------------------------------------------

    def _build_inbox_viewer_layout(self):
        """(Re)build the viewer's content area: the tree area alone, or a
        horizontal PanedWindow of [trees | reading pane] when the toggle is on.
        _build_inbox_viewer_body() then fills the tree area as usual."""
        holder = getattr(self, "_inbox_viewer_layout_holder", None)
        try:
            if holder is None or not holder.winfo_exists():
                return
        except Exception:
            return
        for ch in holder.winfo_children():
            ch.destroy()
        self._inbox_viewer_preview_text = None
        self._inbox_viewer_preview_header = None
        if not bool(self._load_inbox_viewer_config().get("reading_pane", False)):
            area = tk.Frame(holder, bg=_BG)
            area.pack(fill="both", expand=True)
            self._inbox_viewer_pane_area = area
            return
        hp = tk.PanedWindow(holder, orient="horizontal", sashwidth=6, bg=_BORDER,
                            bd=0, sashrelief="flat", opaqueresize=True)
        hp.pack(fill="both", expand=True)
        area = tk.Frame(hp, bg=_BG)
        hp.add(area, minsize=420)
        right = tk.Frame(hp, bg=_BG2)
        header_var = tk.StringVar(value="Select an email to preview it")
        tk.Label(right, textvariable=header_var, bg=_BG2, fg=_ACCENT, anchor="w",
                 justify="left", wraplength=420, font=(_FONT, _FONT_SIZE, "bold"),
                 padx=8, pady=6).pack(fill="x")
        # v4.2.43: clickable attachment links live between header and body.
        attach_frame = tk.Frame(right, bg=_BG2)
        attach_frame.pack(fill="x")
        self._inbox_viewer_attach_frame = attach_frame
        body_holder = tk.Frame(right, bg=_BG2)
        body_holder.pack(fill="both", expand=True)
        txt = tk.Text(body_holder, bg=_BG3, fg=_FG, wrap="word", relief="flat",
                      font=(_FONT, _FONT_SIZE), state="disabled", padx=8, pady=6)
        sb = ttk.Scrollbar(body_holder, orient="vertical", command=txt.yview)
        txt.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y")
        txt.pack(side="left", fill="both", expand=True)
        hp.add(right, minsize=260)
        self._inbox_viewer_pane_area = area
        self._inbox_viewer_preview_text = txt
        self._inbox_viewer_preview_header = header_var

    def _inbox_viewer_toggle_reading_pane(self):
        on = bool(getattr(self, "_inbox_viewer_reading_var", None) and self._inbox_viewer_reading_var.get())
        self._save_inbox_viewer_config({"reading_pane": on})
        ops_log("inbox_viewer", "reading_pane_toggled", on=on)
        self._build_inbox_viewer_layout()
        self._build_inbox_viewer_body()
        self._render_inbox_viewer_rows()
        if on:
            self._inbox_viewer_load_preview()

    def _inbox_viewer_set_preview(self, header, body, attachments=None, row=None):
        txt = getattr(self, "_inbox_viewer_preview_text", None)
        try:
            if txt is None or not txt.winfo_exists():
                return
        except Exception:
            return
        hdr = getattr(self, "_inbox_viewer_preview_header", None)
        if hdr is not None:
            hdr.set(header)
        # v4.2.43: rebuild the attachment links (cleared while loading / when none).
        frame = getattr(self, "_inbox_viewer_attach_frame", None)
        try:
            if frame is not None and frame.winfo_exists():
                for ch in frame.winfo_children():
                    ch.destroy()
                for att in (attachments or []):
                    size_kb = int((att.get("size", 0) or 0) / 1024)
                    size_note = f" ({size_kb} KB)" if size_kb else ""
                    link = tk.Label(frame, text=f"\U0001F4CE {att.get('name', '?')}{size_note}",
                                    bg=_BG2, fg=_ACCENT, cursor="hand2", anchor="w", padx=8,
                                    font=(_FONT, _FONT_SIZE, "underline"))
                    link.pack(fill="x", pady=1)
                    link.bind("<Button-1>",
                              lambda e, a=dict(att), r=dict(row or {}): self._inbox_viewer_open_attachment(r, a))
        except Exception:
            pass
        try:
            txt.configure(state="normal")
            txt.delete("1.0", tk.END)
            txt.insert(tk.END, body or "")
            txt.configure(state="disabled")
        except Exception:
            pass

    def _inbox_viewer_on_select_preview(self, event=None):
        if getattr(self, "_inbox_viewer_preview_text", None) is None:
            return
        win = getattr(self, "_inbox_viewer_win", None)
        try:
            pending = getattr(self, "_iv_preview_after", None)
            if pending:
                win.after_cancel(pending)
            self._iv_preview_after = win.after(250, self._inbox_viewer_load_preview)
        except Exception:
            self._inbox_viewer_load_preview()

    def _inbox_viewer_load_preview(self):
        """Show the selected email in the reading pane; the body loads once per
        row on a worker and is cached on the row dict. Viewing never touches
        the message's read state."""
        self._iv_preview_after = None
        if getattr(self, "_inbox_viewer_preview_text", None) is None:
            return
        row = self._inbox_viewer_selected_row()
        if not row:
            return
        header = f"{row.get('subject', '') or '(no subject)'}\n" \
                 f"{row.get('sender', '')} <{row.get('sender_email', '')}>   |   {row.get('received', '')}"
        if row.get("body_preview") is not None:
            self._inbox_viewer_set_preview(header, row.get("body_preview"),
                                           attachments=row.get("attachments_preview"), row=row)
            return
        self._inbox_viewer_set_preview(header, "Loading...")
        job = dict(row)

        def work(outlook, namespace):
            try:
                if job.get("store_id"):
                    msg = namespace.GetItemFromID(job["entry_id"], job["store_id"])
                else:
                    msg = namespace.GetItemFromID(job["entry_id"])
                atts = []
                try:
                    count = int(msg.Attachments.Count)
                    for i in range(1, count + 1):
                        try:
                            att = msg.Attachments.Item(i)
                            name = str(att.FileName or "").strip()
                            if not name:
                                continue
                            try:
                                if outlook_attachment_is_inline(att):
                                    continue
                            except Exception:
                                pass
                            atts.append({"index": i, "name": name,
                                         "size": int(getattr(att, "Size", 0) or 0)})
                        except Exception:
                            continue
                except Exception:
                    pass
                return {"entry_id": job.get("entry_id", ""),
                        "body": str(msg.Body or "")[:100000], "attachments": atts}
            except Exception as exc:
                return {"entry_id": job.get("entry_id", ""),
                        "body": f"(Could not load body: {exc})", "attachments": []}

        def done(res):
            res = res or {}
            eid = res.get("entry_id", "")
            for r in getattr(self, "_inbox_viewer_rows", None) or []:
                if r.get("entry_id") == eid:
                    r["body_preview"] = res.get("body", "")
                    r["attachments_preview"] = res.get("attachments", [])
            cur = self._inbox_viewer_selected_row()
            if cur is not None and cur.get("entry_id") == eid:
                self._inbox_viewer_set_preview(header, res.get("body", ""),
                                               attachments=res.get("attachments", []), row=cur)

        def error(exc):
            if "already busy" in str(exc):
                self._inbox_viewer_set_preview(header, "Outlook worker busy -- click the email again in a moment.")
            else:
                self._inbox_viewer_set_preview(header, f"(Could not load body: {exc})")

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-preview")

    def _inbox_viewer_open_attachment(self, row, att):
        """v4.2.43: click an attachment link in the reading pane -> save it to a
        per-message temp folder on a worker (att.SaveAsFile, same idiom as the
        coverage scanners) and open it with the default app (os.startfile)."""
        if not row.get("entry_id") or not att.get("name"):
            return
        try:
            self._inbox_viewer_status_var.set(f"Opening attachment: {att.get('name')}...")
        except Exception:
            pass
        job_row, job_att = dict(row), dict(att)

        def work(outlook, namespace):
            if job_row.get("store_id"):
                msg = namespace.GetItemFromID(job_row["entry_id"], job_row["store_id"])
            else:
                msg = namespace.GetItemFromID(job_row["entry_id"])
            atts = msg.Attachments
            target = None
            try:
                cand = atts.Item(int(job_att.get("index", 0)))
                if str(cand.FileName or "").strip().casefold() == str(job_att["name"]).casefold():
                    target = cand
            except Exception:
                target = None
            if target is None:
                for i in range(1, int(atts.Count) + 1):
                    try:
                        cand = atts.Item(i)
                        if str(cand.FileName or "").strip().casefold() == str(job_att["name"]).casefold():
                            target = cand
                            break
                    except Exception:
                        continue
            if target is None:
                raise RuntimeError(f"attachment '{job_att['name']}' not found on the message")
            safe_name = re.sub(r"[^A-Za-z0-9._-]", "_", str(job_att["name"])) or "attachment"
            sub = re.sub(r"[^A-Za-z0-9]", "", str(job_row.get("entry_id", "")))[-12:] or "msg"
            tdir = os.path.join(tempfile.gettempdir(), "mainbox_viewer_attachments", sub)
            os.makedirs(tdir, exist_ok=True)
            path = os.path.join(tdir, safe_name)
            target.SaveAsFile(path)
            return path

        def done(path):
            if not path:
                return
            try:
                os.startfile(path)
                try:
                    self._inbox_viewer_status_var.set(f"Opened attachment: {att.get('name')}")
                except Exception:
                    pass
                ops_log("inbox_viewer", "attachment_opened", name=str(att.get("name", ""))[:80])
            except Exception as exc:
                try:
                    messagebox.showerror("Attachment", f"Saved but could not open:\n{path}\n\n{exc}",
                                         parent=getattr(self, "_inbox_viewer_win", None) or self.root)
                except Exception:
                    pass

        def error(exc):
            note = "Outlook worker busy -- try the link again in a moment." \
                if "already busy" in str(exc) else f"Could not open attachment: {exc}"
            try:
                self._inbox_viewer_status_var.set(note)
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-attachment")

    def _inbox_viewer_mark_read(self, read=True):
        """Right-click -> Mark as Read/Unread on the selected rows (real
        Outlook UnRead flip + Save on a worker). Bold updates on re-render."""
        trees = [t for _l, t in getattr(self, "_inbox_viewer_trees", None) or []]
        active = getattr(self, "_inbox_viewer_active_tree", None)
        if active in trees:
            trees = [active] + [t for t in trees if t is not active]
        rows = []
        for tree in trees:
            rows = self._inbox_viewer_rows_for_tree_selection(tree)
            if rows:
                break
        jobs = [dict(r) for r in rows if r.get("entry_id")]
        if not jobs:
            return

        def work(outlook, namespace):
            changed = []
            for row in jobs:
                try:
                    if row.get("store_id"):
                        msg = namespace.GetItemFromID(row["entry_id"], row["store_id"])
                    else:
                        msg = namespace.GetItemFromID(row["entry_id"])
                    msg.UnRead = (not read)
                    msg.Save()
                    changed.append(row["entry_id"])
                except Exception:
                    continue
            return changed

        def done(changed):
            changed = set(changed or [])
            if changed:
                for r in getattr(self, "_inbox_viewer_rows", None) or []:
                    if r.get("entry_id") in changed:
                        r["unread"] = (not read)
                self._render_inbox_viewer_rows()
            try:
                self._inbox_viewer_status_var.set(
                    f"Marked {len(changed)} email(s) as {'read' if read else 'unread'}.")
            except Exception:
                pass
            ops_log("inbox_viewer", "mark_read", read=read, count=len(changed), asked=len(jobs))

        def error(exc):
            try:
                self._inbox_viewer_status_var.set(f"Mark {'read' if read else 'unread'} failed: {exc}")
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-markread")

