    parser_mode = str(merged.get("rfq_parser_mode", RFQ_PARSER_MODE) or "auto").strip().lower()
    if parser_mode not in ["ai_only", "auto", "docling", "liteparse", "custom", "off", "none", "0", "false", "no"]:
        parser_mode = "ai_only"
    merged["rfq_parser_mode"] = parser_mode
    raw_order = merged.get("rfq_ocr_order", "docling,liteparse")
