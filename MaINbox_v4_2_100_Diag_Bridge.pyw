    def set_selected_status_from_menu(self, status):
        if status not in STATUSES:
            return
        selected_emails = self.get_selected_emails(show_warning=False)
        if not selected_emails:
            return

        tracking_keys_to_cancel = set()
        followups_cancelled = 0
        if status == "Completed":
            tracking_keys_to_cancel = self.review_tracking_items_before_complete(selected_emails)
            if tracking_keys_to_cancel is None:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, "Mark Complete skipped. No email status or follow-ups were changed.")
                return

        self.save_undo_state(f"set status to {status}")
        _guard_changed = False
        with self._bulk_write():
            for email in selected_emails:
                # v4.1.16: the right-click status menu can reopen a closed email (e.g.
                # Completed -> New). Detect the close -> open transition and record the
                # explicit reopen, or the closed guard re-completes it at next startup.
                _was_closed = self._email_was_closed_before_edit(email)
                email["status"] = status
                email["is_new_import"] = False
                if _was_closed and not self.workflow_record_is_closed(email):
                    if self._record_explicit_reopen_for_email(email, save=False):
                        _guard_changed = True
                self.save_record(email)
                # Status corrections still teach the normal workflow memory.
                self.learn_from_user_correction(
                    email,
                    email.get("category", "General"),
                    email.get("urgency", "Normal"),
                    status,
                )
            if _guard_changed:
                self._save_closed_email_guard()

        if status == "Completed" and tracking_keys_to_cancel:
            followups_cancelled = self.cancel_selected_tracking_items(
                tracking_keys_to_cancel,
                "Cancelled from completion review: email marked Completed",
            )
            for email in selected_emails:
                eid = email.get("entry_id", "")
                if eid and not self.get_active_followup_for_email(eid):
                    email["followup_time"] = ""

        self.flush_status_data()
        self.sort_emails_for_display()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        self.save_cached_state()
        self.preview_text.delete("1.0", tk.END)
        cancelled_note = f" Cancelled {followups_cancelled} active follow-up(s)." if followups_cancelled else ""
        self.preview_text.insert(tk.END, f"Status changed to {status} for {len(selected_emails)} selected email(s).{cancelled_note}")
        # v3.9.81: marking the last email Completed may finish a quote group -> if the
        # Quote Completion option is on, archive it now and schedule the chase follow-up.
        if status == "Completed":
            try:
                _arch = self._run_quote_completion_autocleanup()
                if _arch:
                    self.preview_text.insert(
                        tk.END,
                        f"\n\nQuote completion: archived {_arch} finished group(s) and scheduled a follow-up.")
            except Exception:
                pass


    def _group_member_entry_id_from_iid(self, iid):
        if not iid or not str(iid).startswith("member:"):
            return ""
        parts = str(iid).split(":", 2)
        return parts[2] if len(parts) == 3 else ""

    def open_group_member_in_outlook(self, entry_id=None):
        entry_id = entry_id or self._group_member_entry_id_from_iid((self.groups_tree.selection() or [""])[0])
        if not entry_id:
            return
        email = self.get_email_by_id(entry_id)
        if not email:
            messagebox.showerror("Open Error", "Could not find this email in the current MaINbox list.")
            return
        try:
            if self.tree.exists(entry_id):
                self.tree.selection_set(entry_id)
                self.tree.focus(entry_id)
                self.tree.see(entry_id)
        except Exception:
            pass
        self.open_selected_email()

    def on_group_tree_double_click(self, event=None):
        try:
            iid = self.groups_tree.identify_row(event.y) if event else ""
        except Exception:
            iid = ""
        entry_id = self._group_member_entry_id_from_iid(iid)
        if entry_id:
            self.open_group_member_in_outlook(entry_id)
            return "break"
        return None

    def choose_group_for_move(self, current_group_id=""):
        groups = [g for g in self.groups_data.get("groups", []) if not g.get("archived") and g.get("id") != current_group_id]
        if not groups:
            messagebox.showwarning("No Groups", "There are no other active groups to move this email into.")
            return ""
        win = tk.Toplevel(self.root)
        win.title("Move to Group")
        remember_window_geometry(win, "Move to Group", "520x420")
        win.transient(self.root)
        self.safe_grab_set(win)
        tk.Label(win, text="Select the group to move this email into:", font=("Segoe UI", 10, "bold")).pack(anchor="w", padx=10, pady=(10, 4))
        listbox = tk.Listbox(win, height=14)
        listbox.pack(fill="both", expand=True, padx=10, pady=6)
        for g in groups:
            listbox.insert(tk.END, f"{g.get('name','')}  [{g.get('urgency','Normal')}]")
        result = {"group_id": ""}
        def do_move():
            sel = listbox.curselection()
            if not sel:
                return
            result["group_id"] = groups[sel[0]].get("id", "")
            win.destroy()
        def cancel():
            win.destroy()
        listbox.bind("<Double-1>", lambda e: do_move())
        btns = tk.Frame(win)
        btns.pack(fill="x", padx=10, pady=(0, 10))
        tk.Button(btns, text="Move", command=do_move, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Cancel", command=cancel, width=12).pack(side="right", padx=4)
        try:
            listbox.selection_set(0)
            listbox.focus_set()
        except Exception:
            pass
        win.wait_window()
        return result["group_id"]

    def move_group_member_to_another_group(self, entry_id=None):
        entry_id = entry_id or self._group_member_entry_id_from_iid((self.groups_tree.selection() or [""])[0])
        if not entry_id:
            return
        email = self.get_email_by_id(entry_id)
        if not email:
            return
        current_group_id = self.get_group_id_for_email(entry_id)
        target_group_id = self.choose_group_for_move(current_group_id=current_group_id)
        if not target_group_id:
            return
        self.assign_emails_to_group([email], target_group_id)

    def remove_group_member_by_entry_id(self, entry_id=None):
        entry_id = entry_id or self._group_member_entry_id_from_iid((self.groups_tree.selection() or [""])[0])
        if not entry_id:
            return
        if entry_id in self.groups_data.get("memberships", {}):
            self.save_undo_state("remove email from group")
            self.groups_data["memberships"].pop(entry_id, None)
            self.save_groups()
            self.render_group_rows()
            self.render_email_rows()
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, "Removed 1 email from its group. Outlook was not changed.")

