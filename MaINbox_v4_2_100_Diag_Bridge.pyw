            "normalized_subject": normalize_subject_for_match(email.get("subject", existing.get("subject", "")) or ""),
            "received": email.get("received", existing.get("received", "")),
            "received_timestamp": email.get("received_timestamp", existing.get("received_timestamp", 0)),
            "source": email.get("source", existing.get("source", "")),
            "store_id": email.get("store_id", existing.get("store_id", "")),
            "conversation_id": email.get("conversation_id", existing.get("conversation_id", "")),
