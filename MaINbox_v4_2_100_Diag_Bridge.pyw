    merged["reply_needed_business_only"] = bool(merged.get("reply_needed_business_only", True))
    # v3.9.81 Quote Completion auto-cleanup
    merged["quote_completion_autocleanup_enabled"] = bool(merged.get("quote_completion_autocleanup_enabled", False))
    try:
