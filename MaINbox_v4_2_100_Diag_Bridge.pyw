def parse_followup_time(raw):
    """Parse either a clock time or a relative follow-up delay.

    Supported examples:
    - 3:00 PM, 3 PM, 14:30
    - in 1 minute, 1 min, 15 minutes, 2 hours
    - for quick testing only, a bare number 1-5 means minutes
    """
    raw = (raw or "").strip()
    if not raw:
        return None

    now = datetime.now()
    lowered = raw.lower().strip()

    # Relative delays: "in 1 minute", "1 min", "15 minutes", "2 hours".
    m = re.match(r"^(?:in\s+)?(\d+)\s*(m|min|mins|minute|minutes|h|hr|hrs|hour|hours)$", lowered)
    if m:
        qty = int(m.group(1))
        unit = m.group(2)
        if unit.startswith("h"):
            return now + timedelta(hours=qty)
        return now + timedelta(minutes=qty)

    # Friendly dropdown values: "Tomorrow 9 AM" / "Tomorrow 3:00 PM".
    tm = re.match(r"^tomorrow\s+(.+)$", lowered)
    if tm:
        inner = tm.group(1).strip()
        for fmt in ["%I:%M %p", "%I %p", "%H:%M", "%H"]:
            try:
                parsed_time = datetime.strptime(inner.upper(), fmt).time()
                return datetime.combine(now.date() + timedelta(days=1), parsed_time)
            except Exception:
                pass

    # Convenience: if the user types only a number, treat it as minutes.
    # This makes quick tests like "1" = 1 minute work reliably.
    if lowered.isdigit():
        qty = int(lowered)
        if qty > 0:
            return now + timedelta(minutes=qty)

    for fmt in ["%I:%M %p", "%I %p", "%H:%M", "%H"]:
        try:
            parsed_time = datetime.strptime(raw.upper(), fmt).time()
            target = datetime.combine(now.date(), parsed_time)
            if target <= now:
                target += timedelta(days=1)
            return target
        except Exception:
            pass
    return None


