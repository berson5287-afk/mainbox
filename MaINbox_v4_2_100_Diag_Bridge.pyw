    def _age_bootstrap(self):
        """v4.1.35: MAIN THREAD, once at startup. Creates all queues, starts the single
        engine worker, and starts the permanent poll that is the only bridge between
        background threads and Tk."""
        self.__dict__.setdefault("_age_request_queue", queue.Queue())
        # v4.1.35: idempotent -- a second call must NEVER replace queues the live
        # worker is blocked on (it would strand the worker on the old object forever).
        if getattr(self, "_age_task_queue", None) is None:
            self._age_task_queue = queue.Queue()
        if getattr(self, "_age_result_queue", None) is None:
            self._age_result_queue = queue.Queue()
        if getattr(self, "_age_pending_ids", None) is None:
            self._age_pending_ids = set()
        if getattr(self, "_age_render_scheduled", None) is None:
            self._age_render_scheduled = False
        t = getattr(self, "_age_worker_thread", None)
        if t is None or not t.is_alive():
            t = threading.Thread(target=self._auto_group_worker_loop,
                                 name="AutoGroupEngineWorker", daemon=True)
            self._age_worker_thread = t
            t.start()
        if not getattr(self, "_age_poll_started", False):
            self._age_poll_started = True
            self.root.after(150, self._age_poll)

    def _age_poll(self):
        """v4.1.35: permanent main-thread poll. Drains grouping REQUESTS (snapshot +
        pending bookkeeping + hand to worker) and engine RESULTS (apply on Tk thread).
        Cheap when idle: two queue emptiness checks every 150 ms."""
        try:
            req_q = getattr(self, "_age_request_queue", None)
            drained = []
            if req_q is not None:
                while True:
                    try:
                        drained.append(req_q.get_nowait())
                    except queue.Empty:
                        break
            if drained and self._auto_group_engine_active():
                snapshot = self._age_build_snapshot()
                for email in drained:
                    if not isinstance(email, dict):
                        continue
                    eid = str(email.get("entry_id", "") or "")
                    if not eid or eid in self._age_pending_ids or self.get_group_id_for_email(eid):
                        continue
                    self._age_pending_ids.add(eid)
                    email["auto_group_engine_action"] = "pending"
                    # the worker reads a copy; only the poll/apply touch the live dict
                    self._age_task_queue.put(("decide", email, dict(email), snapshot))
            res_q = getattr(self, "_age_result_queue", None)
            if res_q is not None:
                while True:
                    try:
                        live_email, decision = res_q.get_nowait()
                    except queue.Empty:
                        break
                    try:
                        self._apply_plugin_group_decision(live_email, decision)
                    except Exception:
                        try:
                            self._age_pending_ids.discard(str((live_email or {}).get("entry_id", "") or ""))
                        except Exception:
                            pass
        except Exception:
            pass  # the poll must always reschedule
        try:
            self.root.after(150, self._age_poll)
        except Exception:
            self._age_poll_started = False

    def _age_build_snapshot(self):
        """v4.1.35: MAIN THREAD ONLY. Shallow snapshot of the collections the engine
        iterates; element dicts stay shared and are read-only on the worker."""
        try:
            qc = getattr(self, "quote_coverage", {}) or {}
            cov = {"updated_at": qc.get("updated_at", ""), "threads": dict(qc.get("threads", {}) or {})}
        except Exception:
            cov = {}
        return (
            list(self.emails),
            {"groups": list(self.groups_data.get("groups", []) or []),
             "memberships": dict(self.groups_data.get("memberships", {}) or {})},
            cov,
            {"group_rules": dict((getattr(self, "learning_data", {}) or {}).get("group_rules", {}) or {})},
        )

    def _auto_group_worker_loop(self):
        """v4.1.35: sole owner of AutoGroupEngine calls. Consumes tasks, produces plain
        result tuples on the result queue. NEVER touches Tk, COM, or live collections;
        must never die."""
        while True:
            try:
                task = self._age_task_queue.get()
            except Exception:
                return
            try:
                kind = task[0]
                engine = self._get_auto_group_engine()
                if kind == "feedback":
                    _k, em_copy, target_gid, prev_gid, reason = task
                    if engine is not None:
                        try:
                            engine.record_feedback(em_copy, target_gid, previous_group_id=prev_gid, reason=reason)
                        except Exception:
                            pass
                    continue
                _k, live_email, em_copy, snapshot = task
                decision = None
                if engine is not None and snapshot:
                    emails_s, groups_s, cov_s, learn_s = snapshot
                    try:
                        decision = engine.decide(email=em_copy, groups_data=groups_s, emails=emails_s,
                                                 quote_coverage=cov_s, learning_data=learn_s)
                    except Exception as exc:
                        decision = {"action": "none", "group_id": "", "confidence": 0.0,
                                    "reason": "", "evidence_families": [],
                                    "error": f"{type(exc).__name__}: {exc}"[:240]}
                self._age_result_queue.put((live_email, decision))
            except Exception:
                pass  # never let the worker thread die

    def auto_group_same_subject_pair(self, email):
        """v4.2.32: create a group from two or more UNGROUPED emails sharing an exact
        normalized subject inside SAME_SUBJECT_AUTO_GROUP_WINDOW_HOURS.

        Reported: Danny's 10:45 and 11:35 "1597-022" never grouped. They could not have:
        auto_assign_same_thread_group, auto_assign_same_subject_group, the business-key,
        learned and PA-template paths ALL only ASSIGN an email to a group that already
        exists ("if exact normalized subject matches an existing GROUPED email"), and
        groups are only CREATED by the RFQ flow or by hand. Two loose emails were a blind
        spot.

        Guardrails, same shape as _maybe_create_solo_rfq_group: the shared subject must be
        non-generic AND carry a distinctive job/PO/part token, so "Quote Request" x2 or
        "P&A" x2 never trigger it. Returns the new group id, or "".
        """
        if not email:
            return ""
        eid = str(email.get("entry_id", "") or "")
        if not eid or self.get_group_id_for_email(eid):
            return ""
        subject = str(email.get("subject", "") or "")
        target = normalize_subject_for_match(subject)
        if not target:
            return ""
        tokens = extract_group_match_tokens(target)
        if is_generic_group_subject(target) or not tokens:
            return ""
        try:
            ts = float(email.get("received_timestamp", 0) or 0)
        except Exception:
            ts = 0.0
        if not ts:
            return ""
        window = SAME_SUBJECT_AUTO_GROUP_WINDOW_HOURS * 3600.0
        peers = []
        for other in (self.emails or []):
            oid = str(other.get("entry_id", "") or "")
            if not oid or oid == eid or self.get_group_id_for_email(oid):
                continue
            if normalize_subject_for_match(other.get("subject", "") or "") != target:
                continue
            try:
                ots = float(other.get("received_timestamp", 0) or 0)
            except Exception:
                continue
            if ots and abs(ots - ts) <= window:
                peers.append(other)
        if not peers:
            return ""
        name = re.sub(r"\s+", " ", subject.strip())[:80] or target[:80]
        gid = self._unique_group_id()
        try:
            self.groups_data.setdefault("groups", []).append({
                "id": gid, "name": name,
                "urgency": email.get("urgency", "Normal") or "Normal",
                "collapsed": False, "has_new": True,
                "created_at": datetime.now().isoformat(), "notes": "", "archived": False,
            })
            mem = self.groups_data.setdefault("memberships", {})
            mem[eid] = gid
            for other in peers:
                mem[str(other.get("entry_id", "") or "")] = gid
                other["same_subject_group_rule"] = "same_subject_window"
            email["same_subject_group_rule"] = "same_subject_window"
            self.save_groups()
        except Exception:
            return ""
        try:
            ops_log("group", "same_subject_pair_group_created", gid=gid, gname=name,
                    eid=eid[-16:], members=len(peers) + 1,
                    hours=SAME_SUBJECT_AUTO_GROUP_WINDOW_HOURS,
                    tokens=",".join(sorted(tokens))[:80], subj=subject[:60])
        except Exception:
            pass
        try:
            self._assistant_log_autogroup(
                email, gid,
                reason=("%d emails share the exact subject \"%s\" within %g hours and none was "
                        "grouped yet." % (len(peers) + 1, subject.strip()[:60],
                                          SAME_SUBJECT_AUTO_GROUP_WINDOW_HOURS)),
                rule="same_subject_window")
        except Exception:
            pass
        return gid

    # v4.2.32: a saved customer's short answer on a quote/order thread. Steve's workflow:
    # "he either tells me ok or noted to look over -- ok means process which he sent me".
    # Deliberately anchored to a WHOLE LINE so "ok" inside a sentence ("ok so the price
    # went up", "that's ok but...") can never close a thread.
    _PROCESS_OK_RE = re.compile(
        r"(?im)^\s*[\$\*\-\u2022>]*\s*(?:ok(?:ay)?|o\.\s?k\.?)\s*"
        r"(?:to\s+(?:go|process|order|proceed)|process|proceed|go\s*ahead|by\s+me)?"
        r"\s*[.!,\-]*\s*$")
    _ACK_NOTED_RE = re.compile(
        r"(?im)^\s*[\$\*\-\u2022>]*\s*noted\b[^\n]{0,45}$")

    @staticmethod
    def _top_of_message(text, max_lines=8):
        """The user's OWN words: stop at the quoted history so an 'ok' buried in a
        forwarded chain can never be read as this sender's answer."""
        out = []
        for raw in str(text or "").replace("\r", "").split("\n"):
            line = raw.strip()
            if re.match(r"^-{2,}\s*original message|^from:\s|^sent:\s|^on .{0,60}wrote:$",
                        line, flags=re.I):
                break
            if line.startswith(">"):
                break
            if line:
                out.append(line)
            if len(out) >= max_lines:
                break
        return "\n".join(out)

    def detect_process_or_ack_reply(self, email, body=""):
        """v4.2.32: does this email say "OK" (process it) or "noted" (acknowledged)?

        BODY FIRST, then the PDF/attachment only when the body is empty -- Steve's rule
        verbatim: "Body first then pdf if empty". Danny writes the OK on the PDF he sends
        back, so a blank body with an attachment is the normal case, not an edge case.

        Only ever applied to a saved CUSTOMER (durable type C): a vendor writing "ok" must
        not close a quote thread. Returns "process", "ack", or "".
        """
        try:
            if not isinstance(email, dict):
                return ""
            if self._durable_email_type_for_email(email) != "C":
                return ""
            top = self._top_of_message(body or email.get("body", "") or "")
            if top:
                if self._PROCESS_OK_RE.search(top):
                    return "process"
                if self._ACK_NOTED_RE.search(top):
                    return "ack"
                return ""
            # Body empty -> read the attachment, but only then.
            if not email.get("has_attachments"):
                return ""
            try:
                att_text, _details = self.extract_attachment_text_for_email(
                    email, skip_inline_images=True)
            except Exception:
                return ""
            att_top = self._top_of_message(att_text, max_lines=40)
            if not att_top:
                return ""
            if self._PROCESS_OK_RE.search(att_top):
                try:
                    ops_log("triage", "process_ok_found_in_attachment",
                            eid=str(email.get("entry_id", "") or "")[-16:],
                            subj=str(email.get("subject", "") or "")[:60])
                except Exception:
                    pass
                return "process"
            if self._ACK_NOTED_RE.search(att_top):
                return "ack"
            return ""
        except Exception:
            return ""

    def _create_process_reminder_followup(self, email, minutes=None):
        """v4.2.32: ONE manual-lane follow-up so a customer's "OK" (process what I sent)
        is not forgotten after the thread is closed and its group archived. The manual lane
        is used deliberately -- scenario reminders are auto-cancelled once their email is
        Completed, which is exactly what this row now is."""
        try:
            if not email:
                return False
            mins = PROCESS_ACK_FOLLOWUP_MINUTES if minutes is None else int(minutes)
            eid = str(email.get("entry_id", "") or "")
            for it in (self.followups or []):
                if it.get("completed") or it.get("cancelled"):
                    continue
                if str(it.get("entry_id", "")) == eid and it.get("source_reason") == "customer_ok_process":
                    return False
            due_at = datetime.now() + timedelta(minutes=max(1, mins))
            self.followups.append({
                "entry_id": eid,
                "store_id": email.get("store_id", ""),
                "conversation_id": email.get("conversation_id", ""),
                "group_id": self.get_group_id_for_email(eid),
                "subject": email.get("subject", ""),
                "source": email.get("source", ""),
                "category": email.get("category", "General"),
                "due_at": due_at.isoformat(), "message": "", "use_ai": False,
                "note": "Customer said OK -- process what they sent.",
                "source_reason": "customer_ok_process",
                "completed": False, "cancelled": False,
                "created_at": datetime.now().isoformat(),
            })
            self._followup_dedup_needed = True
            try:
                email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
            except Exception:
                pass
            self.save_followups()
            return True
        except Exception:
            return False

    def apply_process_or_ack_decision(self, email, verdict):
        """v4.2.32: close the thread on a customer's OK/noted. "OK" also archives the group
        and sets the PROCESS_ACK_FOLLOWUP_MINUTES processing reminder; "noted" is a bare
        acknowledgement, so it closes quietly with nothing to chase."""
        if not email or verdict not in ("process", "ack"):
            return False
        email["status"] = "Completed"
        email["ai_user_locked"] = False
        email["ai_triage_reason"] = (
            ("Customer answered OK: closing the thread and reminding you in %d minutes to "
             "process what they sent." % PROCESS_ACK_FOLLOWUP_MINUTES) if verdict == "process"
            else "Customer acknowledged (\"noted\") -- nothing owed either way, so the thread "
                 "is closed with no follow-up.")
        gid = self.get_group_id_for_email(str(email.get("entry_id", "") or ""))
        if verdict == "process":
            self._create_process_reminder_followup(email)
            if gid:
                def _arch(_gid=gid):
                    try:
                        self._archive_group_by_id(_gid)
                        self.render_group_rows()
                        self.render_email_rows()
                    except Exception:
                        pass
                try:
                    self.root.after(0, _arch)   # groups_data + UI belong to the main thread
                except Exception:
                    _arch()
        try:
            ops_log("triage", "process_or_ack_applied",
                    eid=str(email.get("entry_id", "") or "")[-16:], verdict=verdict,
                    gid=str(gid or ""), subj=str(email.get("subject", "") or "")[:60])
        except Exception:
            pass
        return True

    def _maybe_create_solo_rfq_group(self, email):
        """v4.1.67: create a single-RFQ group for a genuine customer price/availability
        request that no existing group claimed, so every real RFQ is a grouped quote
        unit (reported: a standalone 'RFQ TEST 9001' / bare 'P&A' never grouped, so the
        reply-driven auto-archive had nothing to act on). Guardrail per the user's rule:
        SUBJECT scan first, then a quick BODY scan, and only group when there is ENOUGH
        identifying info -- a distinctive job/PO/part token via extract_group_match_tokens.
        A contentless request (bare 'P&A' with no items/codes) stays UNGROUPED. Returns
        the new group id, or '' if nothing was created. MAIN thread only (mutates
        groups_data + save_groups); called from _apply_plugin_group_decision."""
        if not email:
            return ""
        eid = str(email.get("entry_id", "") or "")
        if not eid or self.get_group_id_for_email(eid):
            return ""
        # Customers only -- this is about customer RFQs, not vendor mail.
        if str(email.get("email_type", "")).upper() != "C":
            return ""
        try:
            if self.workflow_record_is_closed(email) or email.get("closed_guard_applied"):
                return ""
        except Exception:
            pass
        subject = str(email.get("subject", "") or "")
        body = str(email.get("body", "") or email.get("body_preview", "") or "")
        blob = (subject + "\n" + body[:1500]).lower()
        # Must READ like a price/availability request (inbound RFQ), not just any customer
        # note that happens to carry a code (e.g. a PO or a shipping question).
        looks_rfq = (
            any(p in blob for p in COVERAGE_OUTGOING_REQUEST_PHRASES)
            or is_generic_group_subject(subject)  # bare 'P&A'/'Quote'/'RFQ'/'Pricing' subject
        )
        if not looks_rfq:
            return ""
        # SUBJECT scan first, then a quick BODY scan. "Enough info" == a distinctive
        # job/PO/part identifier; no distinctive token anywhere -> do not group.
        subj_tokens = extract_group_match_tokens(subject)
        body_tokens = extract_group_match_tokens(body[:1500]) if body else set()
        if subj_tokens:
            name = subject.strip()
        elif body_tokens:
            best = max(body_tokens, key=len)
            name = (subject.strip() or "P&A") + " - " + best
        else:
            return ""  # not enough identifying info: leave it ungrouped
        name = re.sub(r"\s+", " ", name).strip()[:80] or "RFQ"
        gid = self._unique_group_id()
        try:
            self.groups_data.setdefault("groups", []).append({
                "id": gid, "name": name,
                "urgency": email.get("urgency", "Normal") or "Normal",
                "collapsed": False, "has_new": True,
                "created_at": datetime.now().isoformat(), "notes": "", "archived": False,
            })
            self.groups_data.setdefault("memberships", {})[eid] = gid
            email["auto_group_engine_rule"] = "solo_rfq"
            self.save_groups()
        except Exception:
            return ""
        try:
            ops_log("group", "solo_rfq_group_created", gid=gid, gname=name,
                    eid=eid[-16:], via=("subject" if subj_tokens else "body"), subj=subject)
        except Exception:
            pass
        try:
            self._assistant_log_autogroup(
                email, gid,
                reason=("New single-RFQ group: a customer price/availability request with a "
                        "distinctive identifier that matched no existing group."),
                rule="solo_rfq")
        except Exception:
            pass
        return gid

    def _apply_plugin_group_decision(self, email, decision):
        """v4.1.35: MAIN THREAD (called only by _age_poll). Records the decision and
        applies an AUTO grouping with fresh re-checks; on engine None, replays a stored
        AI group suggestion that was deferred while the decision was pending."""
        eid = str((email or {}).get("entry_id", "") or "")
        try:
            self._age_pending_ids.discard(eid)
        except Exception:
            pass
        if not email:
            return
        if not isinstance(decision, dict):
            email["auto_group_engine_action"] = "none"
            self._age_replay_deferred_suggestion(email)
            return
        if decision.get("error"):
            email["auto_group_engine_error"] = str(decision.get("error", ""))[:240]
            email["auto_group_engine_action"] = "none"
            self._age_replay_deferred_suggestion(email)
            return
        email["auto_group_engine_decision"] = decision
        email["auto_group_engine_action"] = str(decision.get("action", "none") or "none")
        email["auto_group_engine_group_id"] = str(decision.get("group_id", "") or "")
        email["auto_group_engine_confidence"] = float(decision.get("confidence", 0) or 0)
        email["auto_group_engine_reason"] = str(decision.get("reason", "") or "")[:1500]
        email["auto_group_engine_families"] = list(decision.get("evidence_families", []) or [])
        # v4.1.60 ops log: every engine verdict, before any action is taken.
        ops_log("group", "engine_decision",
                eid=str(eid or "")[-16:], action=str(decision.get("action", "none") or "none"),
                gid=str(decision.get("group_id", "") or ""), gname=str(decision.get("group_name", "") or ""),
                conf=float(decision.get("confidence", 0) or 0),
                fam=list(decision.get("evidence_families", []) or []),
                subj=str(email.get("subject", "") or ""), etype=str(email.get("email_type", "") or ""),
                reason=str(decision.get("reason", "") or ""))
        action = decision.get("action")
        if action == "none":
            # v4.1.67: the engine found no EXISTING group. For a genuine customer RFQ that
            # carries enough identifying info (a distinctive job/PO/part token in its
            # subject or body), create a fresh SOLO group so the RFQ is tracked as its own
            # quote unit and the reply-driven auto-archive can later act on it.
            try:
                if self._maybe_create_solo_rfq_group(email):
                    return
            except Exception:
                pass
            self._age_replay_deferred_suggestion(email)
            return
        if action != "auto":
            email.pop("pending_group_suggestion", None)  # the engine's own suggestion outranks the AI's
            return
        email.pop("pending_group_suggestion", None)
        gid = str(decision.get("group_id", "") or "")
        if not gid or not eid or not self.get_group_by_id(gid):
            return
        if self.get_group_id_for_email(eid):
            return  # something else grouped it while the decision was pending
        try:
            if self.workflow_record_is_closed(email) or email.get("closed_guard_applied"):
                return
        except Exception:
            pass
        self.groups_data.setdefault("memberships", {})[eid] = gid
        email["auto_group_engine_rule"] = "unified_scorer"
        self.mark_group_has_new(gid, save=False)  # v4.1.35: save_groups() below is the single write
        self.save_groups()
        try:
            self._assistant_log_autogroup(
                email, gid,
                reason=(f"Auto-Group Engine {decision.get('confidence', 0):.0%}: "
                        f"{decision.get('reason', '')}"),
                rule="auto_group_engine")
        except Exception:
            pass
        try:
            group = self.get_group_by_id(gid)
            if group:
                self.ai_status_var.set(f"Group: related email added to {group.get('name', '')}")
        except Exception:
            pass
        self._age_schedule_render()

    def _age_replay_deferred_suggestion(self, email):
        """v4.1.35: the engine said None (or errored) -- an AI suggestion stored while
        the decision was pending may now proceed through its ORIGINAL path."""
        try:
            sug = email.pop("pending_group_suggestion", None)
            if not isinstance(sug, dict):
                return
            eid = str(email.get("entry_id", "") or "")
            gid = str(sug.get("group_id", "") or "")
            if not eid or not gid or self.get_group_id_for_email(eid) or not self.get_group_by_id(gid):
                return
            if sug.get("mode") == "direct":
                # AutoPilot no-prompt context applied directly before v4.1.35.
                self.groups_data.setdefault("memberships", {})[eid] = gid
                self.mark_group_has_new(gid, save=False)
                self.save_groups()
                self._age_schedule_render()
            else:
                self._offer_ai_group_suggestion(
                    email, gid,
                    float(sug.get("confidence", 0) or 0),
                    str(sug.get("reason", "") or ""),
                    bool(sug.get("allow_group_prompt", True)))
        except Exception:
            pass

    def _age_schedule_render(self):
        """v4.1.35: one debounced groups/emails re-render per burst of async decisions."""
        if getattr(self, "_age_render_scheduled", False):
            return
        self._age_render_scheduled = True
        def _do():
            self._age_render_scheduled = False
            try:
                self.render_group_rows()
            except Exception:
                pass
            try:
                self.render_email_rows()
            except Exception:
                pass
        try:
            self.root.after(500, _do)
        except Exception:
            self._age_render_scheduled = False

    def _apply_plugin_suggestion_to_ai_result(self, email, result):
        """Feed a conservative SUGGEST decision into the existing Assistant prompt path."""
        try:
            dec = email.get("auto_group_engine_decision", {}) if isinstance(email, dict) else {}
            if not isinstance(dec, dict) or dec.get("action") != "suggest":
                return result
            gid = str(dec.get("group_id", "") or "")
            if not gid or not self.get_group_by_id(gid):
                return result
            result = dict(result or {})
            result["suggested_group_id"] = gid
            result["group_confidence"] = float(dec.get("confidence", 0) or 0)
            result["reason"] = "Auto-Group Engine suggestion: " + str(dec.get("reason", "") or "")
            return result
        except Exception:
            return result

    def save_groups(self):
        # v4.1.19: every membership mutation path ends here -- drop the conversation->group
        # routing cache so coverage can never route a vendor reply via a stale membership.
        # (The cache signature also fingerprints membership contents; this is belt-and-braces.)
        try:
            self._conv_group_idx = None
        except Exception:
            pass
        try:
            _age = getattr(self, "_auto_group_engine_instance", None)
            if _age is not None:
                _age.invalidate()
        except Exception:
            pass
        save_json(GROUPS_FILE, self.groups_data)

    def _unique_group_id(self):
        """v4.1.10: a guaranteed-unique group id. The raw microsecond timestamp could repeat
        (two creations in the same tick) or collide with an id already on disk; a duplicate id
        makes memberships ambiguous and used to crash the groups tree at startup. Suffix with
        a counter until the id is unused."""
        try:
            existing = {str((g or {}).get("id", "")) for g in self.groups_data.get("groups", [])}
        except Exception:
            existing = set()
        base = f"grp_{datetime.now().strftime('%Y%m%d%H%M%S%f')}"
        gid = base
        n = 0
        while gid in existing:
            n += 1
            gid = f"{base}_{n}"
        return gid

    def get_group_by_id(self, group_id):
        # v2.9.8: direct single-email RFQ support. These temporary RFQ groups
        # are not shown in the Groups/Quote Jobs list, but let the existing
        # Quote RFQ extractor/window reuse the same safe code path.
        try:
            temp_groups = getattr(self, "_single_email_rfq_groups", {}) or {}
            if group_id in temp_groups:
                return temp_groups[group_id].get("group")
        except Exception:
            pass
        for group in self.groups_data.get("groups", []):
            if group.get("id") == group_id:
                return group
        return None

    def get_group_id_for_email(self, entry_id):
        return self.groups_data.get("memberships", {}).get(entry_id, "")

    def get_group_name_for_email(self, entry_id):
        group_id = self.get_group_id_for_email(entry_id)
        group = self.get_group_by_id(group_id)
        return group.get("name", "") if group else ""

    def mark_group_has_new(self, group_id, save=True):
        # v4.1.35: save= lets callers that immediately save_groups() themselves skip
        # the internal write -- the engine-decision apply was double-writing the store.
        group = self.get_group_by_id(group_id)
        if group:
            group["has_new"] = True
            if save:
                self.save_groups()

    def mark_group_seen(self, group_id):
        group = self.get_group_by_id(group_id)
        if group and group.get("has_new"):
            group["has_new"] = False
            self.save_groups()
            self.render_group_rows()
            self.render_email_rows()

    def _normalized_thread_subject(self, subject):
        """Normalize Outlook thread subjects so RE:/FW: replies stay grouped together."""
        value = str(subject or "").strip().lower()
        changed = True
        while changed:
            old_value = value
            value = re.sub(r"^\s*(re|fw|fwd)\s*:\s*", "", value, flags=re.I).strip()
            changed = value != old_value
        value = re.sub(r"\s+", " ", value)
        return value

    def find_group_id_for_conversation(self, conversation_id, skip_entry_id=""):
        """Find an existing group by Outlook conversation id first."""
        if not conversation_id:
            return ""
        # v4.2.91: an EXPLICIT claim outranks anything inferred. When the user
        # assigns a sent message to a job in the Sent Queue, that conversation is
        # claimed -- so the vendor's reply lands on the job the user chose rather
        # than on whatever the subject text happens to resemble. This is the arm
        # that finally covers outgoing RFQs, whose sent copy never enters
        # self.emails and therefore can never be matched by the walk below.
        claimed = self.group_id_for_claimed_conversation(conversation_id)
        if claimed:
            return claimed
        memberships = self.groups_data.get("memberships", {})
        for existing in self.emails:
            if skip_entry_id and existing.get("entry_id") == skip_entry_id:
                continue
            if existing.get("conversation_id") == conversation_id:
                group_id = memberships.get(existing.get("entry_id", ""), "")
                if group_id and self.get_group_by_id(group_id):
                    return group_id
        return ""

    def find_group_id_for_thread(self, email, skip_entry_id=""):
        """Highest priority grouping rule: keep an existing thread/conversation in its group.

        Priority:
        1. Outlook conversation_id match
        2. Normalized subject match among already-grouped emails

        This prevents replies/back-and-forth messages from being reassigned to the wrong group
        by sender/keyword/AI guesses.
        """
        if not email:
            return ""

        memberships = self.groups_data.get("memberships", {})
        conversation_id = email.get("conversation_id", "")

        group_id = self.find_group_id_for_conversation(conversation_id, skip_entry_id=skip_entry_id)
        if group_id:
            return group_id

        subject_key = self._normalized_thread_subject(email.get("subject", ""))
        if not subject_key:
            return ""

        # v4.1.66: a GENERIC subject ("P&A", "Quote", "RFQ", "Pricing", ...) normalizes
        # identically across unrelated senders/threads, so the subject-only fallback
        # below silently merged every "P&A" email into one group (reported: a gmail
        # "P&A" test RFQ joined 'C&D- 26 1251 LUT'). Mirror the v4.1.13 guard already on
        # find_existing_email_for_sent_message: a generic subject may join a group ONLY
        # through the conversation-id match above (priority 1), never by subject alone.
        # Distinctive subjects (job/PO/project codes, real names) still subject-match.
        if is_generic_group_subject(email.get("subject", "")):
            return ""

        # v4.2.89: reference time for the staleness window below. A row being
        # grouped normally carries received_timestamp; fall back to "now" so a
        # timestamp-less row is measured against the present rather than 1970
        # (which would silently fail every window check and disable subject
        # matching for it).
        try:
            new_ts = float(email.get("received_timestamp", 0) or 0)
        except Exception:
            new_ts = 0.0
        if new_ts <= 0:
            new_ts = datetime.now().timestamp()
        # v4.2.90: user-tunable (Settings -> Functionality). Read here rather than
        # cached on self, so editing it takes effect on the next grouped email
        # instead of needing a restart. Clamped again at read time because settings
        # can also be written by the cloud-bridge restore path.
        try:
            _merge_days = int(self.settings.get("group_subject_merge_max_age_days",
                                                GROUP_SUBJECT_MERGE_MAX_AGE_DAYS)
                              or GROUP_SUBJECT_MERGE_MAX_AGE_DAYS)
        except Exception:
            _merge_days = GROUP_SUBJECT_MERGE_MAX_AGE_DAYS
        _merge_days = max(1, min(365, _merge_days))
        max_gap = _merge_days * 86400.0

        best_group_id = ""
        best_ts = 0.0
        stale_blocked = ""

        for existing in self.emails:
            existing_id = existing.get("entry_id", "")
            if skip_entry_id and existing_id == skip_entry_id:
                continue

            existing_group_id = memberships.get(existing_id, "")
            if not existing_group_id or not self.get_group_by_id(existing_group_id):
                continue

            existing_subject_key = self._normalized_thread_subject(existing.get("subject", ""))
            if not existing_subject_key or existing_subject_key != subject_key:
                continue

            # v4.2.89 guard: STALENESS. A group stops accepting NEW conversations by
            # subject alone once it has been quiet for GROUP_SUBJECT_MERGE_MAX_AGE_DAYS.
            # Absolute distance, so back-filled older mail lands on its own era rather
            # than on whichever group happens to be newest.
            #
            # Deliberately NOT also gated on group["archived"], though that was the
            # first instinct -- worth recording why it was dropped. Measured against the
            # real corpus, an archived gate refused 30+ merges whose MEDIAN distance from
            # the group was THREE DAYS (25 of them inside a single day). The reason: a
            # group here is auto-archived the moment a quote goes out
            # (replied_rfq_auto_archive), so "archived" routinely means "quoted an hour
            # ago", not "finished job". Those same-day cases are vendor replies to our
            # own outgoing RFQ -- and our sent RFQ is NOT in self.emails, so the reply has
            # no same-conversation sibling to match and this subject arm is the ONLY thing
            # that can tie it to the job. Gating on archived would orphan them. Time alone
            # is sufficient for the reported defects anyway: Capone- MNPW Wiremold is
            # 47.1d and PJS- 312E Marcy Houses 66.0d, both well past the window. Telling a
            # NEW request apart from a LATE vendor reply INSIDE the window is not decidable
            # from subject text -- that is what the explicit send-time group picker
            # (steps 3-4 of this rework) is for.
            try:
                existing_ts = float(existing.get("received_timestamp", 0) or 0)
            except Exception:
                existing_ts = 0.0
            if existing_ts > 0 and abs(new_ts - existing_ts) > max_gap:
                stale_blocked = existing_group_id
                continue

            # v4.2.89: the documented "most recent group wins" tie-break was DEAD --
            # it ranked on received_time / sent_time / date, and none of those three
            # fields exists on any email record (verified: 0 of 649 carry them, all
            # 649 carry received / received_timestamp). Every candidate scored ""
            # and `"" > ""` is False, so the FIRST match in self.emails order won,
            # arbitrarily. Ranking on received_timestamp makes the rule real.
            if not best_group_id or existing_ts > best_ts:
                best_group_id = existing_group_id
                best_ts = existing_ts

        if not best_group_id and stale_blocked:
            self._log_subject_merge_blocked_once(email, stale_blocked, subject_key)

        return best_group_id

    def _group_tokens_for_email(self, email):
        if not email:
            return set()
        return extract_group_match_tokens(" ".join([
            str(email.get("subject", "") or ""),
            str(email.get("body", "") or "")[:1200],
        ]))

    def _group_tokens_for_group(self, group_id):
        group = self.get_group_by_id(group_id)
        if not group:
            return set(), set()
        name_tokens = extract_group_match_tokens(group.get("name", ""))
        member_tokens = set()
        count = 0
        memberships = self.groups_data.get("memberships", {})
        for item in sorted(self.emails, key=lambda e: e.get("received_timestamp", 0), reverse=True):
            if memberships.get(item.get("entry_id", ""), "") != group_id:
                continue
            member_tokens.update(extract_group_match_tokens(item.get("subject", "")))
            count += 1
            if count >= 12:
                break
        return name_tokens, member_tokens

    def find_group_id_by_business_key(self, email):
        """Find the safest existing group using job/PO/project identifiers.

        This intentionally avoids fuzzy generic subjects and domain-only rules.
        It only returns a group when one clear winner has matching business keys.
        """
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if entry_id and self.get_group_id_for_email(entry_id):
            return ""
        email_tokens = self._group_tokens_for_email(email)
        if not email_tokens:
            return ""

        ranked = []
        for group in self.groups_data.get("groups", []) or []:
            group_id = group.get("id", "")
            if not group_id or group.get("archived"):
                continue
            name_tokens, member_tokens = self._group_tokens_for_group(group_id)
            name_hits = email_tokens & name_tokens
            member_hits = email_tokens & member_tokens
            if not name_hits and not member_hits:
                continue
            score = 0
            score += sum(60 + min(len(t), 12) for t in name_hits)
            score += sum(25 + min(len(t), 12) for t in member_hits)
            # Prefer active/non-completed groups when scores tie.
            group_emails = self.get_emails_for_group(group_id)
            active_count = sum(1 for e in group_emails if e.get("status") != "Completed" and e.get("urgency") != "Low")
            score += min(active_count, 5)
            ranked.append((score, group_id, group.get("name", ""), sorted(name_hits | member_hits),
                           len(name_hits | member_hits), bool(member_hits)))

        if not ranked:
            return ""
        ranked.sort(reverse=True, key=lambda row: row[0])
        best = ranked[0]
        # Require a clear score and avoid ties between multiple possible groups.
        if best[0] < 60:
            return ""
        if len(ranked) > 1 and ranked[1][0] >= best[0] - 10:
            return ""
        # Don't auto-file on a single coincidental token: require either >=2 distinct shared
        # tokens, or at least one member-subject hit (a lone group-name hit is too weak).
        if best[4] < 2 and not best[5]:
            return ""
        email["business_group_rule"] = ",".join(best[3])
        return best[1]

    def auto_assign_business_key_group(self, email):
        """Auto-group using strong job/PO/project tokens before weaker rules."""
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if not entry_id or self.get_group_id_for_email(entry_id):
            return ""
        group_id = self.find_group_id_by_business_key(email)
        if group_id:
            self.groups_data.setdefault("memberships", {})[entry_id] = group_id
            self.mark_group_has_new(group_id)
            self.save_groups()
            return group_id
        return ""

    def _parse_pa_template_target(self, subject):
        """If a subject is the RFQ extractor's OWN template --
        'Price and Availability Request - <X>' (under any stack of Re:/Fw:/Fwd:
        prefixes) -- return <X>, the group name/job the RFQ was sent for. Else ''.
        The extractor builds outbound subjects this way (see the RFQ window), so a
        reply naming <X> is an explicit, app-authored reference to its group."""
        s = str(subject or "").strip()
        s = re.sub(r"^(?:\s*(?:re|fw|fwd)\s*:\s*)+", "", s, flags=re.I)
        m = re.match(r"price\s+and\s+availability\s+request\s*[-:\u2013\u2014]\s*(.+)$", s, flags=re.I)
        if not m:
            return ""
        return m.group(1).strip()

    def _group_match_codes(self, group_id):
        """Match codes for the high-confidence RFQ-template grouping: a group's
        normal job tokens PLUS loose 4+ digit runs from its name and recent member
        subjects. The looser runs let a reply that quotes only the bare job number
        (e.g. 'Price and Availability Request - 240950 - (Q# 11658689)') still match a
        group named 'EJ- 240950 - Cable', which the conservative tokenizer compounds
        into '240950cable' and would otherwise miss."""
        group = self.get_group_by_id(group_id)
        if not group:
            return set()
        codes = set(extract_group_match_tokens(group.get("name", "")))
        codes |= set(re.findall(r"\d{4,}", group.get("name", "")))
        memberships = self.groups_data.get("memberships", {})
        count = 0
        for item in sorted(self.emails, key=lambda e: e.get("received_timestamp", 0), reverse=True):
            if memberships.get(item.get("entry_id", ""), "") != group_id:
                continue
            subj = item.get("subject", "")
            codes |= set(extract_group_match_tokens(subj))
            codes |= set(re.findall(r"\d{4,}", subj))
            count += 1
            if count >= 12:
                break
        return codes

    def find_group_id_by_pa_template(self, email):
        """Deterministic grouping for the app's own RFQ template. Because the
        extractor writes 'Price and Availability Request - <group name>', a reply
        'Re: Price and Availability Request - <X>' names its group explicitly. We
        match <X> to a live group by job token first (so 'TEST 1586-170' still
        catches a reply that says only '1586-170'), then by exact/contained name --
        no fuzzy gating, since this template is authored by MaINbox itself. A single
        clear winner is required; if two groups match, we defer to weaker rules."""
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if entry_id and self.get_group_id_for_email(entry_id):
            return ""
        target = self._parse_pa_template_target(email.get("subject", ""))
        if not target:
            return ""
        target_tokens = extract_group_match_tokens(target)
        target_codes = set(target_tokens) | set(re.findall(r"\d{4,}", target))
        norm_target = normalize_subject_for_match(target)
        # A bare generic tail ("Quote Request") with no job code is not a reference.
        if not target_codes and is_generic_group_subject(target):
            return ""
        token_matches, name_matches = [], []
        for group in self.groups_data.get("groups", []) or []:
            gid = group.get("id", "")
            if not gid or group.get("archived"):
                continue
            if target_codes and (target_codes & self._group_match_codes(gid)):
                token_matches.append(gid)
                continue
            gnorm = normalize_subject_for_match(group.get("name", ""))
            if norm_target and gnorm and (
                    norm_target == gnorm
                    or (len(norm_target) >= 6 and (norm_target in gnorm or gnorm in norm_target))):
                name_matches.append(gid)
        picks = token_matches or name_matches
        if len(picks) == 1:
            email["pa_template_rule"] = target
            return picks[0]
        return ""

    def auto_assign_pa_template_group(self, email):
        """Auto-group an RFQ-template reply onto its group before any weaker rule."""
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if not entry_id or self.get_group_id_for_email(entry_id):
            return ""
        gid = self.find_group_id_by_pa_template(email)
        if gid:
            self.groups_data.setdefault("memberships", {})[entry_id] = gid
            self.mark_group_has_new(gid)
            self.save_groups()
            return gid
        return ""

    def retroactively_group_pa_template_replies(self):
        """Re-apply the deterministic 'Price and Availability Request - <X>' grouping to any
        still-ungrouped email. The pa_template matcher improves over time (e.g. bare job numbers
        in v3.9.74), but nothing re-evaluates an email already imported under an older matcher --
        it would otherwise stay ungrouped forever even after the matcher is fixed. Cheap: a
        non-template subject exits at the first check, so only real RFQ-template replies do any
        group matching. Returns the count newly grouped."""
        changed = 0
        try:
            for email in list(self.emails):
                eid = email.get("entry_id", "")
                if not eid or self.get_group_id_for_email(eid):
                    continue
                if not self._parse_pa_template_target(email.get("subject", "")):
                    continue
                gid = self.auto_assign_pa_template_group(email)
                if gid:
                    changed += 1
                    try:
                        self._assistant_log_autogroup(
                            email, gid,
                            reason="Retroactive match to the RFQ 'Price and Availability Request - <name>' template.",
                            rule="pa_template_retro")
                    except Exception:
                        pass
        except Exception:
            pass
        return changed

    def rescue_wrongly_buried_active_thread_emails(self):
        """Heal (and permanently guard against) emails forced to Low + hidden and then
        skipped by the import-time grouping pass -- the failure the v4.1.8 suppression
        fix stops at the source. The wrongful Low is persisted to disk (the hidden flag
        is not), so the code fix alone cannot un-bury mail already hidden in an earlier
        session; this sweep does, and also catches any future case where an important
        message ends up Low + ungrouped for any reason.

        Deliberately conservative. It only touches a *Low* email that is NOT user-locked
        and NOT Completed, that has NO genuine Sales duplicate (so correct de-dup is left
        alone -- only wrongly-hidden mail with no real twin qualifies), that clearly
        belongs to an *active* (non-archived) group by one of the STRONG deterministic
        rules already trusted for auto-grouping -- an exact thread/subject match or a
        clear job/PO business key -- and that reads as real work (is_meaningful_
        reactivation_reply), never a bare thanks / FYI / auto-reply. For such an email it
        restores Normal urgency so it is visible again, files it into its group if it was
        left ungrouped, and logs the action to the assistant activity log so it is
        visible and undoable. Genuine junk marked Low never matches an active RFQ group
        by these rules, so it stays buried. Bounded so it stays cheap on large mailboxes.
        Returns the count rescued."""
        rescued = 0
        try:
            memberships = self.groups_data.get("memberships", {})
            # Prebuilt indexes so the per-email checks stay O(1): normalized subjects that
            # already live in a group (for the exact-thread test), and Sales emails keyed
            # by normalized subject (for the genuine-duplicate test).
            grouped_subjects = set()
            sales_by_subj = {}
            for e in self.emails:
                if memberships.get(e.get("entry_id", ""), ""):
                    ks = self._normalized_thread_subject(e.get("subject", ""))
                    if ks:
                        grouped_subjects.add(ks)
                if e.get("source") == "Sales":
                    sk = normalize_subject_for_match(e.get("subject", "") or "")
                    if sk:
                        sales_by_subj.setdefault(sk, []).append(e)
            attempts = 0
            _now_ts = datetime.now().timestamp()
            for email in list(self.emails):
                if attempts >= 60:
                    break
                if email.get("urgency") != "Low" or email.get("ai_user_locked"):
                    continue
                if email.get("status") == "Completed":
                    continue
                eid = email.get("entry_id", "")
                if not eid:
                    continue
                _saved = self.status_data.get(eid, {}) if isinstance(self.status_data, dict) else {}
                if not isinstance(_saved, dict):
                    _saved = {}
                # v4.1.37 (1): a persisted duplicate marker means this Low is CORRECT
                # de-dup -- twin cached or not. The old test only saw twins still in the
                # bounded in-memory list, so old duplicates whose Sales copy aged out
                # were "rescued" back to Normal on every refresh.
                if email.get("sales_inbox_duplicate_hidden") or _saved.get("sales_inbox_duplicate_hidden"):
                    continue
                # v4.1.37 (2): the v4.1.8 burial happens AT IMPORT -- only recent mail can
                # be its victim. Months-old mail flipping back to Normal is exactly the
                # resurfacing complaint, never the bug this sweep exists to heal.
                try:
                    if float(email.get("received_timestamp", 0) or 0) < _now_ts - 21 * 86400:
                        continue
                except Exception:
                    pass
                # v4.1.37 (3): one-shot. rescued_at set + Low again = the email was
                # re-buried ON PURPOSE after a rescue (user re-Low, or a later decision).
                # Rescuing it again would loop forever against the user.
                if email.get("rescued_at") or _saved.get("rescued_at"):
                    continue
                # v4.1.37 (4): an explicit user-locked closure in the machine ledger always wins.
                try:
                    _grec = self._find_closed_email_guard(email, saved_record=_saved)
                    if _grec and _grec.get("ai_user_locked"):
                        continue
                except Exception:
                    pass
                subj = email.get("subject", "")
                subj_key = self._normalized_thread_subject(subj)
                has_token = bool(extract_group_match_tokens(subj))
                # Cheap gate: only real thread/job replies are worth checking -- the bulk of
                # low-value mail shares no grouped subject and carries no job/PO code.
                if not has_token and subj_key not in grouped_subjects:
                    continue
                attempts += 1
                # Never un-bury a My Inbox copy that is a GENUINE duplicate of a Sales email:
                # that Low is correct de-dup, not the bug. Only wrongly-hidden mail (no real
                # twin) qualifies for rescue.
                if email.get("source") == "My Inbox":
                    twin_subj = normalize_subject_for_match(subj or "")
                    if any(self.emails_look_like_same_sales_inbox_duplicate(email, o)
                           for o in sales_by_subj.get(twin_subj, [])):
                        continue
                already_gid = self.get_group_id_for_email(eid)
                gid = already_gid
                rule = "existing"
                if not gid and subj_key in grouped_subjects:
                    gid = self.find_group_id_for_thread(email, skip_entry_id=eid)
                    rule = "thread"
                if not gid and has_token:
                    gid = self.find_group_id_by_business_key(email)
                    rule = "business_key"
                if not gid:
                    continue
                group = self.get_group_by_id(gid)
                if not group or group.get("archived"):
                    continue
                # Only rescue a message that actually represents work (a price/quote reply, a
                # request, a PO), never a passive thanks / FYI / auto-reply.
                if not self.is_meaningful_reactivation_reply(email, body=email.get("body", "")):
                    continue
                newly_grouped = False
                if not already_gid:
                    self.groups_data.setdefault("memberships", {})[eid] = gid
                    email["business_group_rule" if rule == "business_key" else "thread_group_rule"] = (
                        email.get("business_group_rule", "") or "rescued")
                    self.mark_group_has_new(gid)
                    newly_grouped = True
                # Un-bury: restore a visible urgency and clear the stale duplicate-hidden flag.
                email["urgency"] = "Normal"
                email.pop("sales_inbox_duplicate_hidden", None)
                email.pop("sales_inbox_duplicate_hidden_at", None)
                email["rescued_at"] = datetime.now().isoformat()  # v4.1.37: one rescue per email, ever
                try:
                    if isinstance(self.status_data.get(eid), dict):
                        self.status_data[eid].pop("sales_inbox_duplicate_hidden", None)
                        self.status_data[eid].pop("sales_inbox_duplicate_hidden_at", None)
                except Exception:
                    pass
                self.save_record(email)
                self.save_groups()
                rescued += 1
                try:
                    if newly_grouped:
                        detail = "(exact subject match)" if rule == "thread" else "(job/PO key match)"
                        why = ("Restored from a wrongful Low urgency and grouped into its active thread "
                               + detail + "; it reads as real work and should not have been hidden.")
                    else:
                        why = ("Restored from a wrongful Low urgency; it belongs to this active group and "
                               "reads as real work, so it should not have been hidden.")
                    self._assistant_log_autogroup(email, gid, reason=why, rule="rescue_" + rule)
                except Exception:
                    pass
            if rescued:
                try:
                    self.flush_status_data()
                except Exception:
                    pass
        except Exception:
            pass
        return rescued


    def auto_assign_same_thread_group(self, email):
        """If an email belongs to an already-grouped thread, auto-add it before AI rules.
        v3.9.10: domain guard -- refuse auto-group when both sides have a resolved
        SMTP domain and the new email's domain is absent from the existing group."""
        if not email:
            return ""
        entry_id = email.get("entry_id", "")
        if not entry_id or self.get_group_id_for_email(entry_id):
            return ""

        group_id = self.find_group_id_for_thread(email, skip_entry_id=entry_id)
        if group_id:
            new_domain = get_email_domain(email.get("resolved_sender_smtp", ""))
            if new_domain:
                group_emails = self.get_emails_for_group(group_id)
                group_domains = {get_email_domain(e.get("resolved_sender_smtp", ""))
                                 for e in group_emails}
                group_domains.discard("")
                if group_domains and new_domain not in group_domains:
                    return ""
            self.groups_data.setdefault("memberships", {})[entry_id] = group_id
            email["thread_group_rule"] = "conversation_or_subject"
            self.mark_group_has_new(group_id)
            self.save_groups()
            return group_id

        return ""

    def is_meaningful_reactivation_reply(self, email, body=""):
        """Return True when a new inbound reply should wake up a dormant low/completed thread.

        This is intentionally conservative: short thanks/FYI/auto replies do not revive work,
        but requests to revise, add, change, quote, price, order, approve, or answer do.
        """
        text = f"{email.get('subject', '')}\n{body or email.get('body', '')}\n{email.get('sender_intent', '')}".lower()
        text = re.sub(r"\s+", " ", text).strip()

        if not text:
            return False

        passive_phrases = [
            "thank you", "thanks", "received", "got it", "sounds good", "ok", "okay",
            "fyi", "for your records", "auto reply", "automatic reply", "out of office",
            "unsubscribe", "delivery status notification", "read receipt"
        ]
        if len(text) < 90 and any(p in text for p in passive_phrases):
            return False

        active_phrases = [
            "add", "change", "revise", "revision", "update", "updated", "modify",
            "another", "also need", "can you", "could you", "please", "quote",
            "pricing", "price", "availability", "lead time", "eta", "order",
            "po", "purchase order", "approval", "approve", "send over",
            "need", "needed", "request", "rfq", "attached", "see attached",
            "submittal", "drawing", "spec", "replace", "substitute"
        ]
        if any(p in text for p in active_phrases):
            return True

        try:
            quick = quick_sender_intent_analysis(
                email.get("subject", ""),
                email.get("sender_email") or email.get("sender", ""),
                body or email.get("body", ""),
                related_count=int(email.get("same_subject_related_count", 0) or 0),
                source=email.get("source", "")
            )
            if quick.get("workflow_category") in ("Quote / Estimate", "Customer Issue", "Vendor / Supplier"):
                if quick.get("status") == "Needs Reply" or float(quick.get("business_relevance", 0) or 0) >= 0.65:
                    return True
        except Exception:
            pass

        return False

    def find_dormant_thread_context(self, email):
        """Find prior low/completed records in this email's thread/group."""
        if not email:
            return None

        entry_id = email.get("entry_id", "")
        conversation_id = email.get("conversation_id", "")
        subject_key = self._normalized_thread_subject(email.get("subject", ""))
        memberships = self.groups_data.get("memberships", {})
        current_group_id = self.find_group_id_for_thread(email, skip_entry_id=entry_id)

        best = None
        for existing in self.emails:
            existing_id = existing.get("entry_id", "")
            if not existing_id or existing_id == entry_id:
                continue

            same_thread = False
            if conversation_id and existing.get("conversation_id") == conversation_id:
                same_thread = True
            elif subject_key and self._normalized_thread_subject(existing.get("subject", "")) == subject_key:
                same_thread = True
            elif current_group_id and memberships.get(existing_id, "") == current_group_id:
                same_thread = True

            if not same_thread:
                continue

            saved = self.status_data.get(existing_id, {}) or {}
            existing_urgency = saved.get("urgency") or existing.get("urgency", "")
            existing_status = saved.get("status") or existing.get("status", "")
            existing_deleted = bool(saved.get("app_deleted", False))
            existing_group_id = memberships.get(existing_id, "") or current_group_id
            group = self.get_group_by_id(existing_group_id) if existing_group_id else None
            group_low = bool(group and group.get("urgency") == "Low")
            group_archived = bool(group and group.get("archived", False))

            if existing_deleted or existing_urgency == "Low" or existing_status == "Completed" or group_low or group_archived:
                seen = existing.get("received_timestamp", 0) or existing.get("sent_timestamp", 0) or 0
                if best is None or seen > best.get("seen", 0):
                    best = {
                        "entry_id": existing_id,
                        "group_id": existing_group_id,
                        "group": group,
                        "urgency": existing_urgency,
                        "status": existing_status,
                        "app_deleted": existing_deleted,
                        "archived": group_archived,
                        "seen": seen,
                    }
        return best

    def reactivate_dormant_thread_if_needed(self, email, body=""):
        """Wake up a low/completed thread when a meaningful new inbound email arrives.

        New inbound work should not stay buried just because the old thread was completed/low.
        """
        # v3.9.79: a user-locked email is the user's explicit workflow decision. Never auto-reactivate
        # (re-prioritize) it -- only a close trigger may change a locked email's workflow. Without this,
        # a re-imported / EntryID-drifted locked email could have its urgency bumped back up here.
        if isinstance(email, dict) and email.get("ai_user_locked"):
            return False
        try:
            dormant = self.find_dormant_thread_context(email)
            if not dormant:
                return False
            if not self.is_meaningful_reactivation_reply(email, body=body):
                return False
            # v4.2.28: a thread the USER buried needs an EXPLICIT revive, not merely a
            # business-sounding reply. is_meaningful_reactivation_reply passes on any of
            # ~35 active phrases including "please", "quote", "price", "order", "po",
            # "need" and "attached" -- which nearly every real email contains, so a buried
            # thread came back on the next message every time. The narrow _REVIVE_RE is
            # required instead when the burial was deliberate.
            try:
                _dorm_row = self.status_data.get(str(dormant.get("entry_id", "") or ""), {}) \
                    if isinstance(getattr(self, "status_data", None), dict) else {}
                if isinstance(_dorm_row, dict) and _dorm_row.get("user_buried_at"):
                    _txt = "%s\n%s" % (email.get("subject", ""), body or email.get("body", ""))
                    if not self._REVIVE_RE.search(_txt or ""):
                        try:
                            ops_log("triage", "reactivation_blocked_user_buried",
                                    eid=str(email.get("entry_id", "") or "")[-16:],
                                    dormant=str(dormant.get("entry_id", "") or "")[-16:],
                                    subj=str(email.get("subject", "") or "")[:50])
                        except Exception:
                            pass
                        return False
            except Exception:
                pass

            changed = False
            text = f"{email.get('subject', '')}\n{body or email.get('body', '')}".lower()
            high_markers = [
                "urgent", "asap", "rush", "today", "immediately", "emergency",
                "revise", "revision", "change", "add", "quote", "rfq", "attached",
                "price", "pricing", "availability", "lead time"
            ]
            new_urgency = "High" if any(m in text for m in high_markers) else "Normal"

            if email.get("urgency") == "Low" or not email.get("urgency"):
                email["urgency"] = new_urgency
                changed = True
            elif email.get("urgency") not in ("High", "Critical") and new_urgency == "High":
                email["urgency"] = "High"
                changed = True

            if email.get("status") in ("Completed", "Waiting on Customer", "Waiting on Vendor", "New", ""):
                email["status"] = "Needs Reply"
                changed = True

            if not email.get("category") or email.get("category") == "Junk / Ignore":
                email["category"] = "Quote / Estimate"
                changed = True

            email["dormant_thread_reactivated"] = True
            email["reactivation_reason"] = "Meaningful new inbound reply woke a low/completed/archived thread."
            email["ai_triage_pending"] = True

            group_id = dormant.get("group_id") or self.find_group_id_for_thread(email, skip_entry_id=email.get("entry_id", ""))
            if group_id:
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = group_id
                group = self.get_group_by_id(group_id)
                if group:
                    group["has_new"] = True
                    # v2.10.8: Archived groups are dormant, not forgotten.
                    # Meaningful new inbound activity should automatically wake the group back up.
                    if group.get("archived", False):
                        group["archived"] = False
                        group["reactivated_at"] = datetime.now().isoformat()
                        group["reactivation_reason"] = "Meaningful new inbound email arrived for archived group."
                        group.pop("archived_at", None)
                    if group.get("urgency") == "Low":
                        group["urgency"] = new_urgency
                self.save_groups()
                try:
                    self.render_group_rows()
                except Exception:
                    pass

            if changed:
                self.save_record(email)
                self.flush_status_data()

            return True
        except Exception:
            return False

    def save_learning_data(self):
        # v4.1.52: during a bulk operation, defer the write (json.dump of up to 1500
        # rules/bucket + SQLite mirror); _bulk_write flushes it once on exit. The
        # in-memory self.learning_data is already updated by the caller.
        if int(getattr(self, "_bulk_write_depth", 0)) > 0:
            self._bulk_learning_dirty = True
            return
        # v4.1.58: this file was in the 2026-07-20 freeze stack (up to 1500 rules per
        # bucket + fsync + SQLite mirror, on the UI thread). Serialized here
        # (consistent snapshot), disk + mirror on the background writer.
        save_json_async(LEARNING_FILE, self.learning_data)

    def save_learning_rules(self):
        """Backward-compatible alias used by undo/import-export code."""
        self.save_learning_data()

    def _trim_learning_bucket(self, bucket_name):
        bucket = self.learning_data.setdefault(bucket_name, {})
        if len(bucket) <= LEARNING_MAX_RULES_PER_BUCKET:
            return

        def _score(kv):
            rec = kv[1] if isinstance(kv[1], dict) else {}
            try:
                confidence = float(rec.get("confidence", 0.0) or 0.0)
            except Exception:
                confidence = 0.0
            try:
                times = int(rec.get("times", rec.get("count", rec.get("uses", 0))) or 0)
            except Exception:
                times = 0
            protected = 1 if confidence >= 0.85 else 0
            # Preserve high-confidence and frequently corrected rules even when
            # they have not been touched recently. updated_at remains the final
            # tie-breaker to keep recent low-confidence noise from evicting
            # important vendor/customer patterns.
            return (protected, round(confidence, 4), times, str(rec.get("updated_at", "")))

        items = sorted(bucket.items(), key=_score, reverse=True)
        self.learning_data[bucket_name] = dict(items[:LEARNING_MAX_RULES_PER_BUCKET])

    # v4.2.28: phrases that genuinely BRING A BURIED THREAD BACK. Steve's rule, verbatim:
    # "THE ONLY instance where the customer says 'please still quote' or something to bring
    # it back to life then it should come back". Deliberately narrow -- an explicit ask to
    # resume, not merely business vocabulary.
    _REVIVE_RE = re.compile(
        r"(?i)\b(?:still\s+(?:quote|quoting|need|needs|needed|interested|want|wants|"
        r"looking|require|requires)"
        r"|(?:can|could|would)\s+you\s+still\b"
        r"|please\s+(?:still|go\s+ahead|proceed|resume|re-?open|re-?quote)"
        r"|go\s+ahead\s+(?:and|with)\b"
        r"|(?:re-?quote|re-?open|reopen|revive|resurrect)\b"
        r"|back\s+on\b|un-?cancel|dis-?regard\s+(?:my|the)\s+cancel"
        r"|we\s+(?:do\s+)?still\b)")

    def learn_from_user_correction(self, email, category, urgency, status):
        """Record user corrections so future triage honors sender/domain/subject patterns."""
        if not email:
            return
        # v4.2.28: mark a DELIBERATE burial. Reported: "there are some emails that I am
        # manually setting to low urgency and the app keeps bringing them back". Nothing
        # in the store recorded that the USER (rather than automation) set Low/Completed,
        # so reactivate_dormant_thread_if_needed could not tell an intentional burial from
        # an automation guess and revived both on any business-sounding reply.
        try:
            _new_urg = str(urgency or "")
            _new_stat = str(status or "")
            if _new_urg == "Low" or _new_stat == "Completed":
                email["user_buried_at"] = datetime.now().isoformat()
                email["user_buried_urgency"] = _new_urg
            elif _new_urg and _new_urg != "Low" and _new_stat not in ("Completed", ""):
                # the user is deliberately un-burying it -- clear the mark
                email.pop("user_buried_at", None)
                email.pop("user_buried_urgency", None)
        except Exception:
            pass
        # v4.1.60 ops log: the gold signal -- what the USER changed after automation.
        ops_log("triage", "user_correction",
                eid=str(email.get("entry_id", "") or "")[-16:],
                sender=str(email.get("sender_email") or email.get("sender") or ""),
                subj=str(email.get("subject", "") or ""),
                cat=[str(email.get("category", "") or ""), str(category or "")],
                urg=[str(email.get("urgency", "") or ""), str(urgency or "")],
                stat=[str(email.get("status", "") or ""), str(status or "")],
                etype=str(email.get("email_type", "") or ""),
                ai_src=str(email.get("ai_triage_source", "") or ""))
        # v4.1.51 AGGRESSIVE LEARNING -- AUTO-TYPE FROM CATEGORY. Changing a category
        # used to teach the workflow but leave the sender UNTYPED, so the Sticky-Type
        # and Low-Floor protections (customers never auto-junked, vendors only buried
        # by a genuine marketing scan) never armed for that contact and the AI kept
        # guessing. When the user's correction assigns a category that unambiguously
        # implies a relationship, durably type the EXACT sender now, silently:
        #     Customer Issue                          -> C  (Customer)
        #     Vendor / Supplier                       -> V  (Vendor)
        #     Junk / Ignore from an automated address -> M  (Marketing/Automated)
        # Ambiguous categories (General, Quote / Estimate, Invoice / Payment,
        # Scheduling -- either side can send those) never auto-type, Junk from a
        # HUMAN-looking address never auto-types (protects real contacts having an
        # off day), and an EXISTING durable type is never overridden -- the user's
        # own Type dropdown remains the only way to change a typed sender. Gated by
        # the ai_auto_type_from_category setting (on by default; the Aggressive
        # preset keeps it on).
        try:
            if bool(self.settings.get("ai_auto_type_from_category", True)):
                _existing_type = (self._durable_email_type_for_email(email)
                                  or normalize_email_type_code(email.get("email_type", "")))
                if not _existing_type:
                    _cat = str(category or "").strip()
                    _auto_type = ""
                    if _cat == "Customer Issue":
                        _auto_type = "C"
                    elif _cat == "Vendor / Supplier":
                        _auto_type = "V"
                    elif _cat == "Junk / Ignore" and sender_looks_automated(
                            email.get("sender_email") or email.get("sender", "")):
                        _auto_type = "M"
                    if _auto_type:
                        email["email_type"] = _auto_type
                        email["sender_type"] = EMAIL_TYPE_TO_SENDER_TYPE.get(
                            _auto_type, email.get("sender_type", "unknown"))
        except Exception:
            pass
        # v3.9.47: this is the common chokepoint for every manual workflow correction (workflow
        # panel, Teach editor, context-menu status, AI Triage Center). Lock the email so the
        # auto-triage drip / 12h re-scan can never overwrite the user's explicit choice, mark it
        # AI-settled, and persist immediately so the lock survives a Refresh. Without this, the
        # drip re-triaged the email right after the edit and snapped urgency/category/status back.
        try:
            email["ai_user_locked"] = True
            email["ai_triaged_at"] = email.get("ai_triaged_at") or datetime.now().isoformat()
            email["ai_triage_pending"] = False
            self.save_record(email)
        except Exception:
            pass
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        learned = {
            "category": category,
            "urgency": urgency,
            "status": status,
            "email_type": normalize_email_type_code(email.get("email_type", "")),
            "sender": sender_email,
            "domain": domain,
            "subject": subject_key,
            "sample_subject": email.get("subject", ""),
            "sample_sender": email.get("sender", ""),
            "updated_at": datetime.now().isoformat(),
            "times": 1,
            "is_junk": bool(category == "Junk / Ignore" or urgency == "Low"),
            "learning_mode": "adaptive_editable",
        }

        def upsert(bucket_name, key):
            if not key:
                return
            bucket = self.learning_data.setdefault(bucket_name, {})
            existing = bucket.get(key, {}) if isinstance(bucket.get(key, {}), dict) else {}
            old_signature = (
                existing.get("category"),
                existing.get("urgency"),
                existing.get("status"),
                normalize_email_type_code(existing.get("email_type", "")),
            )
            new_signature = (
                category,
                urgency,
                status,
                learned.get("email_type", ""),
            )
            try:
                old_conf = float(existing.get("confidence", 0.0) or 0.0)
            except Exception:
                old_conf = 0.0
            try:
                old_times = int(existing.get("times", 0) or 0)
            except Exception:
                old_times = 0
            try:
                changed_times = int(existing.get("changed_times", 0) or 0)
            except Exception:
                changed_times = 0

            same_rule = old_signature == new_signature
            if not existing:
                # Exact sender corrections should learn quickly; broad domain/subject rules
                # still start softer so one-off projects do not over-triage unrelated email.
                new_conf = 0.72 if bucket_name == "senders" else 0.45
                new_times = 1
            elif same_rule:
                new_conf = min(0.96, max(old_conf, 0.45) + (0.18 if bucket_name == "senders" else 0.14))
                new_times = old_times + 1
            else:
                # If the user changes their mind later, replace the rule but make it editable/soft again.
                new_conf = 0.68 if bucket_name == "senders" else 0.40
                new_times = 1
                changed_times += 1

            merged = dict(existing)
            merged.update(learned)
            merged["times"] = new_times
            merged["changed_times"] = changed_times
            merged["confidence"] = round(new_conf, 3)
            if existing and not same_rule:
                merged["previous_category"] = existing.get("category", "")
                merged["previous_urgency"] = existing.get("urgency", "")
                merged["previous_status"] = existing.get("status", "")
                merged["previous_email_type"] = normalize_email_type_code(existing.get("email_type", ""))
            bucket[key] = merged
            self._trim_learning_bucket(bucket_name)

        # Safer junk learning:
        # Do NOT blindly learn Junk/Low by sender/domain because real vendors often send
        # both marketing emails and legitimate quotes from the same address. Junk/Low
        # corrections are learned by subject/pattern only, unless the sender itself
        # clearly looks automated/marketing.
        is_junkish = bool(category == "Junk / Ignore" or urgency == "Low")
        allow_sender_junk = bool(is_junkish and sender_looks_automated(sender_value))
        if not is_junkish or allow_sender_junk:
            if allow_sender_junk:
                learned["allow_sender_junk"] = True
            upsert("senders", sender_email)
        # Only learn domain-level rules for non-junk/trusted corrections.
        # v4.1.84: NEVER learn a domain rule for a PUBLIC EMAIL PROVIDER. A domain rule
        # generalizes one correction to every sender at that domain -- correct for
        # verdeelectric.com, catastrophic for gmail.com, where customers AND vendors AND
        # strangers all share the domain. Found live: a single correction on one
        # berson5287@gmail.com thread ("33233 quote request") wrote gmail.com -> type C,
        # after which _sent_recipient_is_known_customer treated EVERY gmail recipient as
        # a customer and silently vetoed vendor-RFQ coverage for them (auto_create
        # ok=false in 32ms, before extraction ever ran). Sender- and subject-level rules
        # are unaffected -- only the domain generalization is refused.
        if domain and not is_junkish and str(domain).lower() not in FREEMAIL_DOMAINS:
            upsert("domains", domain)
        upsert("subjects", subject_key)
        self.save_learning_data()

        # v2.7: corrections also teach the follow-up engine.
        # If the user marks something Waiting on Vendor/Customer, future similar messages can inherit that follow-up behavior.
        # If the user marks Completed/Junk/Low, future similar messages should avoid follow-ups.
        if status == "Waiting on Vendor":
            self.learn_followup_behavior(email, "wait_for_vendor", VENDOR_NO_RESPONSE_MINUTES, "Learned from user correction: waiting on vendor.")
        elif status == "Waiting on Customer":
            self.learn_followup_behavior(email, "wait_for_customer", CUSTOMER_PO_FOLLOWUP_MINUTES, "Learned from user correction: waiting on customer.")
        elif status == "Completed" or category == "Junk / Ignore" or urgency == "Low":
            self.learn_followup_behavior(email, "no_followup", None, "Learned from user correction: no follow-up needed.")

    def get_learning_hint_for_email(self, email):
        if not email:
            return None, ""
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        checks = [
            ("sender", self.learning_data.get("senders", {}).get(sender_email)),
            ("subject", self.learning_data.get("subjects", {}).get(subject_key)),
            ("domain", self.learning_data.get("domains", {}).get(domain)),
        ]
        for source, rule in checks:
            if not isinstance(rule, dict):
                continue
            # v4.1.84: defensive twin of the writer gate -- ignore any EXISTING
            # domain rule on a public email provider. The writer now refuses to
            # create these, but blobs already on disk (and restored backups) still
            # carry them, so the read side must not honor them either.
            if source == "domain" and str(domain or "").lower() in FREEMAIL_DOMAINS:
                continue
            category = rule.get("category")
            urgency = rule.get("urgency")
            status = rule.get("status")
            if category in CATEGORIES and urgency in URGENCY_LEVELS and status in STATUSES:
                # Older versions could learn Junk/Low by sender. Ignore those unsafe
                # sender/domain junk rules unless they were explicitly saved as allowed
                # automated-sender junk rules. Subject-level junk rules still apply.
                if source in ["sender", "domain"] and bool(rule.get("is_junk")) and not bool(rule.get("allow_sender_junk")):
                    continue
                return rule, source
        return None, ""



    def _group_learning_keys_for_email(self, email):
        """Return stable keys used to remember manual group corrections."""
        if not email:
            return []
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        keys = []
        if sender_email:
            keys.append(f"sender:{sender_email}")
        if subject_key:
            keys.append(f"subject:{subject_key}")
        # v3 Group Sorting Upgrade: do not learn/apply broad domain-only group
        # rules. One company/domain can have many unrelated jobs, so domain-only
        # grouping caused repeated wrong group assignments.
        return keys

    def learn_group_from_user_move(self, email, target_group_id, previous_group_id=""):
        """When the user manually moves an email to a group, remember that correction.

        This does not retrain the AI model. It creates lightweight business rules
        that run before AI grouping so repeated customers/projects go to the right
        group automatically next time.
        """
        if not email or not target_group_id:
            return
        target_group = self.get_group_by_id(target_group_id)
        if not target_group:
            return
        bucket = self.learning_data.setdefault("group_rules", {})
        now = datetime.now().isoformat()
        sender_value = email.get("sender_email") or email.get("sender", "")
        rule = {
            "group_id": target_group_id,
            "group_name": target_group.get("name", ""),
            "previous_group_id": previous_group_id or "",
            "sender": extract_email_address(sender_value),
            "domain": get_email_domain(sender_value),
            "subject": learning_subject_key(email.get("subject", "")),
            "business_tokens": sorted(self._group_tokens_for_email(email)),
            "sample_subject": email.get("subject", ""),
            "sample_sender": email.get("sender", ""),
            "updated_at": now,
        }
        for key in self._group_learning_keys_for_email(email):
            existing = bucket.get(key, {}) if isinstance(bucket.get(key, {}), dict) else {}
            merged = dict(existing)
            merged.update(rule)
            merged["times"] = int(existing.get("times", 0) or 0) + 1
            bucket[key] = merged
        self._trim_learning_bucket("group_rules")
        self.save_learning_data()
        try:
            # v4.1.35: feedback runs on the engine worker so every engine call stays
            # on one thread and the state-file write leaves the Tk main thread. The
            # worker receives a COPY of the email (five-tuple: kind, email copy,
            # target, previous, reason) and the task queue is created at bootstrap.
            if self._auto_group_engine_active():
                q = getattr(self, "_age_task_queue", None)
                if q is not None:
                    q.put(("feedback", dict(email), target_group_id,
                           previous_group_id, "manual group move"))
        except Exception:
            pass

    def _group_rule_has_business_token_match(self, email, rule, group_id):
        """Require a real job/PO/project token before applying broad group rules.

        Sender-only corrections are useful as hints, but the same sender/company can
        email about many unrelated jobs.  This helper makes learned sender rules safe
        by requiring a shared business token from the current email, the saved rule,
        or the target group before auto-grouping silently.
        """
        try:
            email_tokens = self._group_tokens_for_email(email)
            if not email_tokens:
                return False
            rule_tokens = set(rule.get("business_tokens") or [])
            rule_tokens.update(extract_group_match_tokens(rule.get("sample_subject", "")))
            rule_tokens.update(extract_group_match_tokens(rule.get("subject", "")))
            group_name_tokens, group_member_tokens = self._group_tokens_for_group(group_id)
            safe_tokens = rule_tokens | group_name_tokens | group_member_tokens
            return bool(email_tokens & safe_tokens)
        except Exception:
            return False

    def get_group_learning_hint_for_email(self, email):
        """Return a remembered group rule for this email, if one still points to a real group."""
        bucket = self.learning_data.setdefault("group_rules", {})
        best = None
        best_key = ""
        best_score = -1
        for key in self._group_learning_keys_for_email(email):
            if key.startswith("domain:"):
                continue
            rule = bucket.get(key)
            if not isinstance(rule, dict):
                continue
            group_id = rule.get("group_id", "")
            group = self.get_group_by_id(group_id)
            if not group or group.get("archived"):
                continue
            has_business_match = self._group_rule_has_business_token_match(email, rule, group_id)
            # Sender-only learned grouping must not auto-apply unless the new email
            # shares a job/PO/project key with the learned rule/group.
            if key.startswith("sender:") and not has_business_match:
                continue
            # Generic subjects such as Quote Request/RFQ/P&A are only safe when a
            # business key also matches.
            if key.startswith("subject:") and is_generic_group_subject(email.get("subject", "")) and not has_business_match:
                continue
            times = int(rule.get("times", 1) or 1)
            priority = 3 if key.startswith("subject:") else 2 if key.startswith("sender:") else 1
            score = priority * 1000 + times
            if has_business_match:
                score += 250
            if score > best_score:
                best = rule
                best_key = key
                best_score = score
        return best, best_key

    def auto_assign_learned_group(self, email):
        """Auto-group using user correction memory before asking AI."""
        if not email or self.get_group_id_for_email(email.get("entry_id", "")):
            return ""
        rule, key = self.get_group_learning_hint_for_email(email)
        if not rule:
            return ""
        group_id = rule.get("group_id", "")
        group = self.get_group_by_id(group_id)
        if not group:
            return ""
        self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = group_id
        email["learned_group_rule"] = key
        self.mark_group_has_new(group_id)
        self.save_groups()
        # v4.2.51: visibility for the other silent auto-assign lane.
        ops_log("group", "learned_rule_assigned",
                eid=str(email.get("entry_id", ""))[-16:], gid=group_id, key=str(key)[:60])
        return group_id

    def _followup_learning_keys_for_email(self, email):
        """Return ordered follow-up learning keys from most specific to broadest."""
        if not email:
            return []
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        keys = []
        if sender_email:
            keys.append(f"sender:{sender_email}")
        if subject_key:
            keys.append(f"subject:{subject_key}")
        if domain:
            keys.append(f"domain:{domain}")
        return keys

    def get_followup_learning_hint_for_email(self, email, min_confidence=None):
        """Return learned follow-up behavior only when confidence is strong enough.

        v2.7.5: a single correction is stored as a weak hint. The app only auto-applies
        learned follow-up behavior after repeated confirmation or after the rule reaches
        FOLLOWUP_LEARNING_APPLY_CONFIDENCE. This prevents one experiment from becoming a
        permanent hard rule.
        """
        if min_confidence is None:
            min_confidence = FOLLOWUP_LEARNING_APPLY_CONFIDENCE
        bucket = self.learning_data.setdefault("followups", {})
        best_rule = None
        best_key = ""
        best_score = -1.0
        for key in self._followup_learning_keys_for_email(email):
            rule = bucket.get(key)
            if not isinstance(rule, dict) or not rule.get("behavior"):
                continue
            try:
                confidence = float(rule.get("confidence", 0.0) or 0.0)
            except Exception:
                confidence = 0.0
            # Backward compatibility for older rules without confidence.
            if confidence <= 0:
                try:
                    times = int(rule.get("times", 1) or 1)
                except Exception:
                    times = 1
                confidence = min(0.95, 0.35 + max(0, times - 1) * 0.20)
                rule["confidence"] = confidence
            if key.startswith("domain:"):
                # Domain-wide rules are intentionally weak.  A company can send
                # unrelated jobs, quote requests, invoices, and FYIs from the same
                # domain, so only repeated/high-confidence domain rules auto-apply.
                try:
                    times = int(rule.get("times", 1) or 1)
                except Exception:
                    times = 1
                if confidence < max(float(min_confidence or 0), 0.90) or times < 3:
                    continue
            if confidence >= min_confidence and confidence > best_score:
                best_rule = rule
                best_key = key
                best_score = confidence
        return best_rule, best_key

    def get_weak_followup_learning_hint_for_email(self, email):
        """Return the best follow-up hint even if confidence is low, for display/debug context only."""
        bucket = self.learning_data.setdefault("followups", {})
        best_rule = None
        best_key = ""
        best_score = -1.0
        for key in self._followup_learning_keys_for_email(email):
            rule = bucket.get(key)
            if not isinstance(rule, dict) or not rule.get("behavior"):
                continue
            try:
                confidence = float(rule.get("confidence", 0.0) or 0.0)
            except Exception:
                confidence = 0.0
            if confidence <= 0:
                try:
                    times = int(rule.get("times", 1) or 1)
                except Exception:
                    times = 1
                confidence = min(0.95, 0.35 + max(0, times - 1) * 0.20)
                rule["confidence"] = confidence
            if confidence > best_score:
                best_rule = rule
                best_key = key
                best_score = confidence
        return best_rule, best_key

    def learn_followup_behavior(self, email, behavior, minutes=None, reason=""):
        """Learn follow-up behavior from AI decisions or user corrections.

        v2.7.5 adaptive learning:
        - First correction creates a weak rule (confidence ~0.35).
        - Repeating the same behavior strengthens confidence.
        - Changing the behavior weakens/replaces the old behavior instead of making a permanent hard rule.
        - Future auto-triage only applies rules once confidence reaches FOLLOWUP_LEARNING_APPLY_CONFIDENCE.
        """
        if not email or not behavior:
            return
        valid = {"no_followup", "wait_for_vendor", "wait_for_customer", "followup_review"}
        if behavior not in valid:
            return
        try:
            minutes_val = int(minutes) if minutes is not None and str(minutes).strip() else None
        except Exception:
            minutes_val = None
        bucket = self.learning_data.setdefault("followups", {})
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        domain = get_email_domain(sender_value)
        subject_key = learning_subject_key(email.get("subject", ""))
        now = datetime.now().isoformat()

        for key in self._followup_learning_keys_for_email(email):
            existing = bucket.get(key, {}) if isinstance(bucket.get(key), dict) else {}
            old_behavior = existing.get("behavior")
            old_minutes = existing.get("minutes")
            try:
                old_conf = float(existing.get("confidence", 0.0) or 0.0)
            except Exception:
                old_conf = 0.0
            try:
                old_times = int(existing.get("times", 0) or 0)
            except Exception:
                old_times = 0
            try:
                changed_times = int(existing.get("changed_times", 0) or 0)
            except Exception:
                changed_times = 0

            same_behavior = (old_behavior == behavior)
            same_minutes = (old_minutes == minutes_val) or (old_minutes is None and minutes_val is None)

            if not existing:
                new_conf = 0.35
                new_times = 1
                changed_times = 0
                replaced_behavior = ""
            elif same_behavior and same_minutes:
                # repeated confirmation: confidence rises faster after repeated confirmations
                new_conf = min(0.95, max(old_conf, 0.35) + 0.18)
                new_times = old_times + 1
                replaced_behavior = ""
            elif same_behavior and not same_minutes:
                # same follow-up type, different timing: adapt timing but only modestly strengthen
                new_conf = min(0.90, max(old_conf, 0.35) + 0.08)
                new_times = old_times + 1
                changed_times += 1
                replaced_behavior = old_behavior or ""
            else:
                # contradictory behavior: do not stubbornly keep the old rule; replace it as a weak rule.
                new_conf = max(0.30, min(0.55, (old_conf * 0.45) + 0.20))
                new_times = 1
                changed_times += 1
                replaced_behavior = old_behavior or ""

            rule = {
                "behavior": behavior,
                "minutes": minutes_val,
                "sender": sender_email,
                "domain": domain,
                "subject": subject_key,
                "sample_subject": email.get("subject", ""),
                "sample_sender": email.get("sender", ""),
                "reason": reason or "Learned follow-up behavior.",
                "updated_at": now,
                "created_at": existing.get("created_at", now),
                "times": new_times,
                "changed_times": changed_times,
                "confidence": round(new_conf, 3),
                "previous_behavior": replaced_behavior,
                "learning_mode": "adaptive_confidence",
            }
            bucket[key] = rule
        self._trim_learning_bucket("followups")
        self.save_learning_data()

    def is_trusted_contact_sender(self, email):
        sender_value = email.get("sender_email") or email.get("sender", "")
        sender_email = extract_email_address(sender_value)
        if not sender_email:
            return False
        if sender_email in self.trusted_contact_emails:
            return True
        # Also treat manually corrected non-junk senders as trusted.
        rule = self.learning_data.get("senders", {}).get(sender_email, {})
        if isinstance(rule, dict) and not rule.get("is_junk") and rule.get("category") in CATEGORIES:
            return True
        return False

    def _load_contacts_work(self, namespace):
        """WORKER-THREAD ONLY. Walk Outlook Contacts and return the addresses as a
        plain set -- no COM object and no shared app state crosses back.

        The walk itself is byte-for-byte the v4.2.94 loop; only its inputs and
        outputs changed. It deliberately does NOT seed from self.trusted_contact_emails
        the way the old in-line version did: reading that set here would touch main-
        thread state from a worker. The merge happens on the main thread in on_done,
        which is both safer and equivalent."""
        found = set()
        contacts_folder = namespace.GetDefaultFolder(10)  # olFolderContacts
        items = contacts_folder.Items
        count = 0
        for item in items:
            if count >= 2500:
                break
            count += 1
            for attr in ["Email1Address", "Email2Address", "Email3Address"]:
                try:
                    addr = getattr(item, attr, "") or ""
                except Exception:
                    addr = ""
                addr = extract_email_address(addr)
                if "@" in addr:
                    found.add(addr)
        return found

    def load_outlook_contacts_trusted_senders(self, _retries=0):
        """Load Outlook contacts once and use them as a trusted-sender safety net.

        v4.2.95 (main-thread audit): this used to do the whole thing INLINE on the Tk
        main thread, and it is scheduled from __init__ by root.after(1800, ...) -- so
        every startup silently walked up to 2500 contacts x 3 property reads (~7500 COM
        calls) on the UI thread with nothing on screen to say so. Nobody reported it as
        a freeze because it hides inside startup, which is exactly what made it worth
        finding: it is automatic, repeats every launch, and needs no user action.

        Now: the walk runs on an Outlook worker and only a plain set of addresses comes
        back; every state write and the status label happen in on_done on the main
        thread. Contacts remain an enhancement only -- any failure is swallowed and the
        app carries on, same as before."""
        def work(outlook, namespace):
            return self._load_contacts_work(namespace)

        def done(found):
            try:
                if not isinstance(found, set):
                    return
                merged = set(self.trusted_contact_emails or set()) | found
                self.trusted_contact_emails = merged
                self.contacts_cache = {"contacts": sorted(merged),
                                       "cached_at": datetime.now().isoformat()}
                save_json(CONTACTS_CACHE_FILE, self.contacts_cache)
                try:
                    self.ai_status_var.set(f"AI: loaded {len(merged)} trusted contact(s)")
                except Exception:
                    pass
                ops_log("scan", "contacts_loaded", n=len(merged), new=len(found))
            except Exception:
                pass

        def error(exc):
            # The startup refresh usually owns the single Outlook worker at this moment,
            # so a busy skip here is the NORMAL case, not a failure. Retry a couple of
            # times, widely spaced, then give up quietly -- contacts are a safety net,
            # never worth nagging about.
            try:
                if "already busy" in str(exc) and _retries < 3:
                    self.root.after(45000,
                                    lambda: self.load_outlook_contacts_trusted_senders(_retries + 1))
                    return
                ops_log("scan", "contacts_load_failed", err=str(exc)[:80], tries=_retries)
            except Exception:
                pass

        try:
            self.run_outlook_worker(work, on_done=done, on_error=error, label="load-contacts")
        except Exception:
            pass

    def add_selected_to_selected_group_hotkey(self, event=None):
        """Ctrl+A or Alt+A while a group is selected adds currently selected emails to that group."""
        try:
            focus = self.root.focus_get()
            if focus in [getattr(self, "preview_text", None), getattr(self, "group_notes_text", None)]:
                return None
        except Exception:
            pass
        group_id = self.selected_group_id_from_groups_tree()
        if not group_id:
            messagebox.showwarning("No Group Selected", "Please select group from below")
            return "break"
        selected_emails = self.get_selected_emails(show_warning=False)
        if not selected_emails:
            return None
        self.assign_emails_to_group(selected_emails, group_id)
        return "break"

    def get_related_same_subject_emails(self, email, max_items=8):
        """Quick local scan: exact normalized subject match means high likelihood emails are related."""
        if not email:
            return []
        # v3 efficiency: cache normalized subject on the email dict so the
        # regex stripping loop only runs once per email across the whole session.
        if "_normalized_subject" not in email:
            email["_normalized_subject"] = normalize_subject_for_match(email.get("subject", ""))
        target = email["_normalized_subject"]
        if not target:
            return []
        # v3 Group Sorting Upgrade: do not treat generic subjects such as
        # "Quote Request" or "P&A" as proof that emails belong together.
        if is_generic_group_subject(target) and not extract_group_match_tokens(target):
            return []
        matches = []
        entry_id = email.get("entry_id", "")
        for other in self.emails:
            if other.get("entry_id") == entry_id:
                continue
            if "_normalized_subject" not in other:
                other["_normalized_subject"] = normalize_subject_for_match(other.get("subject", ""))
            if other["_normalized_subject"] == target:
                matches.append(other)
        matches.sort(key=lambda e: e.get("received_timestamp", 0), reverse=True)
        return matches[:max_items]

    def build_related_subject_context(self, email):
        related = self.get_related_same_subject_emails(email)
        lines = []
        for item in related:
            group_name = self.get_group_name_for_email(item.get("entry_id", ""))
            lines.append(
                f"{item.get('received','')} | {item.get('sender','')} | "
                f"category={item.get('category','')} | status={item.get('status','')} | "
                f"group={group_name or 'none'} | subject={item.get('subject','')}"
            )
        return related, lines

    def get_best_same_subject_workflow_hint(self, email):
        """v2.3.2: if exact subject matches prior real work, use it as a protection hint.

        Uniform project/RFQ subjects are common in this workflow. A same-subject match
        should make the app MORE confident the email is related, not less.
        """
        for other in self.get_related_same_subject_emails(email, max_items=12):
            category = other.get("category", "General")
            urgency = other.get("urgency", "Normal")
            status = other.get("status", "New")
            if category == "Junk / Ignore" or urgency == "Low":
                continue
            return {
                "category": category if category in CATEGORIES else "General",
                "urgency": urgency if urgency in URGENCY_LEVELS and urgency != "Low" else "Normal",
                "status": status if status in STATUSES else "Needs Reply",
                "sender": other.get("sender", ""),
                "received": other.get("received", ""),
                "subject": other.get("subject", ""),
                "group": self.get_group_name_for_email(other.get("entry_id", "")),
            }
        return None

    def auto_assign_same_subject_group(self, email):
        """If exact normalized subject matches an existing grouped email, auto-add after quick local scan."""
        if not email or self.get_group_id_for_email(email.get("entry_id", "")):
            return ""
        # v4.2.51: generic subjects ("Quote Request", "P&A", "RFQ"...) match half
        # the mailbox. Reproduced live 2026-08-20: Lucy's Welsbach PO ("FW: Quote
        # Request") silently joined an unrelated Burndy group on this exact
        # matcher and died in that group's scope-all delete. The learned-rule and
        # same-subject-PAIR matchers already guard via is_generic_group_subject;
        # this matcher predates that lesson. Generic subjects now never
        # subject-match into a group -- the business-key/thread/engine matchers
        # (which need real evidence) still apply.
        if is_generic_group_subject(email.get("subject", "")):
            return ""
        for other in self.get_related_same_subject_emails(email, max_items=10):
            group_id = self.get_group_id_for_email(other.get("entry_id", ""))
            if group_id and self.get_group_by_id(group_id):
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = group_id
                email["same_subject_group_rule"] = normalize_subject_for_match(email.get("subject", ""))
                self.mark_group_has_new(group_id)
                self.save_groups()
                # v4.2.51: this path assigned silently -- the Lucy mis-file was
                # only reconstructible from timestamps. Log every assignment.
                ops_log("group", "same_subject_assigned",
                        eid=str(email.get("entry_id", ""))[-16:], gid=group_id,
                        subj=str(email.get("subject", ""))[:80])
                return group_id
        return ""

    def _load_contact_types(self):
        """v4.1.55: durable per-SENDER relationship registry.

        The sticky-type clamp (v4.1.17) protects only PER-EMAIL types (the status
        record keyed by entry_id), so every NEW email from a known contact was
        re-inferred from scratch and the AI could type a saved customer as Vendor
        again (the reported Danny case). This registry is the per-sender truth:
        {"contacts": {addr: {"code": C/V/E/M, ...}}, "asked": {addr: iso}} --
        "asked" remembers senders the user declined to save, so the first-time
        offer never repeats."""
        cache = getattr(self, "_contact_types_cache", None)
        if isinstance(cache, dict):
            return cache
        data = load_json(CONTACT_TYPES_FILE, {}) if os.path.exists(CONTACT_TYPES_FILE) else {}
        if not isinstance(data, dict):
            data = {}
        data.setdefault("version", 1)
        if not isinstance(data.get("contacts"), dict):
            data["contacts"] = {}
        if not isinstance(data.get("asked"), dict):
            data["asked"] = {}
        self._contact_types_cache = data
        return data

    def _save_contact_types(self):
        try:
            data = self._load_contact_types()
            save_json(CONTACT_TYPES_FILE, data)
            return True
        except Exception:
            return False

    def _pipeline_saved_senders(self, kind):
        """v4.1.55: fail-soft, cached view of the quote-pipeline saved lists (the
        'Saved Customers / Saved Vendors' window). These lists were only consulted
        by Quote Scan; typing now honors them too, so an existing saved customer
        like danny@ is a Customer everywhere without re-entering anything."""
        cache = getattr(self, "_pipeline_senders_cache", None)
        if isinstance(cache, dict) and kind in cache:
            return cache[kind]
        addrs = set()
        try:
            from mainbox_quote_pipeline_entry import load_saved_senders
            for e in (load_saved_senders(kind) or []):
                a = extract_email_address(str(e or "")).lower()
                if a and "@" in a:
                    addrs.add(a)
        except Exception:
            pass
        if not isinstance(cache, dict):
            cache = {}
            self._pipeline_senders_cache = cache
        cache[kind] = addrs
        return addrs

    def _invalidate_contact_type_caches(self):
        self._contact_types_cache = None
        self._pipeline_senders_cache = None

    def get_saved_contact_type(self, sender_value):
        """v4.1.55: durable relationship code (C/V/E/M) for a sender address, or "".
        Priority: the app registry (user-confirmed), then the quote-pipeline saved
        customer/vendor lists."""
        try:
            addr = extract_email_address(str(sender_value or "")).lower()
            if not addr or "@" not in addr:
                return ""
            contacts = self._load_contact_types().get("contacts", {})
            rec = contacts.get(addr)
            code = normalize_email_type_code((rec or {}).get("code")) if isinstance(rec, dict) else ""
            if code:
                return code
            # v4.2.20: DOMAIN ENTRIES. The Saved Senders window only validates that the
            # input contains "@", so "@americanpoweresc.com" has always been accepted and
            # stored -- but the lookup above is exact-address, so no domain entry has ever
            # matched anything. Reported live: Jeremy's mail stayed untyped after
            # "@americanpoweresc.com" was added as an Employee. Four such entries existed
            # in the store, all inert. Checked AFTER the exact address so a specific
            # person still overrides their own domain.
            try:
                _dom = addr.split("@", 1)[1]
            except Exception:
                _dom = ""
            if _dom:
                drec = contacts.get("@" + _dom)
                dcode = normalize_email_type_code((drec or {}).get("code")) if isinstance(drec, dict) else ""
                if dcode:
                    return dcode
            if addr in self._pipeline_saved_senders("customer"):
                return "C"
            if addr in self._pipeline_saved_senders("vendor"):
                return "V"
            return ""
        except Exception:
            return ""

    def set_saved_contact_type(self, sender_value, code, source="user"):
        """v4.1.55: record a durable per-sender type. Returns the normalized address
        on success. Also mirrors C/V into the quote-pipeline saved lists (fail-soft)
        so the sender appears in the existing Saved Senders window."""
        try:
            addr = extract_email_address(str(sender_value or "")).lower()
            ncode = normalize_email_type_code(code)
            if not addr or "@" not in addr or ncode not in ("C", "V", "E", "M"):
                return ""
            data = self._load_contact_types()
            data["contacts"][addr] = {"code": ncode, "at": datetime.now().isoformat(), "source": str(source or "user")}
            data["asked"].pop(addr, None)
            self._save_contact_types()
            if ncode in ("C", "V"):
                try:
                    from mainbox_quote_pipeline_entry import add_saved_sender
                    add_saved_sender("customer" if ncode == "C" else "vendor", addr)
                except Exception:
                    pass
            self._invalidate_contact_type_caches()
            return addr
        except Exception:
            return ""

    def remove_saved_contact_type(self, sender_value):
        """v4.1.55: forget a sender's durable type (registry side only)."""
        try:
            addr = extract_email_address(str(sender_value or "")).lower()
            if not addr:
                return False
            data = self._load_contact_types()
            existed = bool(data["contacts"].pop(addr, None))
            if existed:
                self._save_contact_types()
                self._invalidate_contact_type_caches()
            return existed
        except Exception:
            return False

    @staticmethod
    def _junk_record_is_user_set(rec):
        """v4.1.75: a junk entry only auto-deletes when a HUMAN set it. M is also reachable
        by AUTOMATION (the marketing scan's V -> M retype when a vendor sends advertising),
        and auto-deleting on an automation-set M would silently junk a real vendor after one
        promotional blast."""
        return (isinstance(rec, dict)
                and normalize_email_type_code(rec.get("code")) == "M"
                and str(rec.get("source", "") or "") in USER_SET_CONTACT_TYPE_SOURCES)

    def normalize_junk_entry(self, value):
        """v4.1.76: parse a junk-list entry into (kind, key).

        Accepts an exact address ("ereply@bc.1000bulbs.com" -> ("address", addr)) OR a whole
        domain in either the "@1000bulbs.com" or bare "1000bulbs.com" form -> ("domain",
        "@1000bulbs.com"). Domain keys are stored with a leading "@" so they can live in the
        SAME contacts map as addresses without ever colliding with one: every other reader of
        that map does an exact-address lookup, and "@domain" is not a valid address, so a
        domain entry is invisible to them and interpreted only here. Returns ("", "") for
        anything unusable -- including a bare TLD, which would otherwise junk the internet."""
        raw = str(value or "").strip().lower()
        if not raw or " " in raw:
            return ("", "")
        if raw.startswith("@"):
            dom = raw[1:]
        elif "@" in raw:
            addr = extract_email_address(raw).lower()
            return ("address", addr) if (addr and "@" in addr) else ("", "")
        else:
            dom = raw
        labels = [l for l in dom.strip().strip(".").split(".") if l]
        if len(labels) < 2:
            return ("", "")  # bare TLD ("com") or empty -- never a valid entry
        return ("domain", "@" + ".".join(labels))

    def sender_is_user_junked(self, sender_value):
        """v4.1.75/76: True when the sender is on the USER-MAINTAINED junk/marketing list,
        by exact address OR by a domain entry covering it (v4.1.76).

        Storage is the existing contact-type registry under code M -- no new file, no new
        type code. Cost is a handful of dict lookups per message (exact address, then one
        per domain suffix), NOT a scan of the contacts map, so it stays cheap on the import
        hot path where this runs for every inbound email.

        SAFETY: an explicit per-address business type always beats a domain-wide junk entry.
        Junking "@hubbell.com" must not silently delete the mail of a saved Vendor at that
        domain -- the specific decision the user made about one person outranks the blanket
        one about their employer."""
        try:
            addr = extract_email_address(str(sender_value or "")).lower()
            if not addr or "@" not in addr:
                return False
            contacts = self._load_contact_types().get("contacts", {})
            if self._junk_record_is_user_set(contacts.get(addr)):
                return True  # exact address entry: most specific, always wins
            rec = contacts.get(addr)
            if isinstance(rec, dict) and normalize_email_type_code(rec.get("code")) in ("C", "V", "E"):
                return False
            if (addr in self._pipeline_saved_senders("customer")
                    or addr in self._pipeline_saved_senders("vendor")):
                return False
            labels = addr.split("@", 1)[1].split(".")
            for i in range(len(labels) - 1):
                if self._junk_record_is_user_set(contacts.get("@" + ".".join(labels[i:]))):
                    return True
            return False
        except Exception:
            return False

    def set_junk_entry(self, key, remove=False):
        """v4.1.76: write/remove a junk entry directly in the contacts map.

        Domain keys ("@x.com") cannot go through set_saved_contact_type /
        remove_saved_contact_type -- both run the value through extract_email_address, which
        rightly rejects anything without a local part. Address entries still go through the
        normal setter so the existing first-time-offer bookkeeping ("asked") is respected."""
        try:
            if not key:
                return False
            data = self._load_contact_types()
            if remove:
                existed = bool(data["contacts"].pop(key, None))
                if existed:
                    self._save_contact_types()
                    self._invalidate_contact_type_caches()
                return existed
            data["contacts"][key] = {"code": "M", "at": datetime.now().isoformat(), "source": "junk_window"}
            data.get("asked", {}).pop(key, None)
            self._save_contact_types()
            self._invalidate_contact_type_caches()
            return True
        except Exception:
            return False

    def _auto_junk_email(self, email):
        """v4.1.75: route one incoming email from a user-junked sender straight to the
        Deleted section instead of the inbox list. Deliberately NOT perform_app_delete:
        that is the interactive path (undo checkpoint, tracking-item prompts, re-render)
        and running it per-message inside an import loop would both freeze the UI and
        bury the user's real undo history under automated deletions.

        Nothing is destroyed -- the row is snapshotted to Deleted History and marked
        app_deleted, exactly like a manual app-only delete, so Restore brings it back.
        Outlook is never touched. Returns True when the email was junked."""
        entry_id = email.get("entry_id", "")
        if not entry_id:
            return False
        deleted_at = datetime.now().isoformat()
        try:
            if not any(r.get("entry_id") == entry_id for r in self.deleted_history if isinstance(r, dict)):
                snap = dict(email)
                snap.pop("message", None)
                snap["deleted_from_app_at"] = deleted_at
                snap["auto_junked"] = True
                self.deleted_history.insert(0, snap)
        except Exception:
            pass
        existing = self.status_data.get(entry_id, {}) if isinstance(self.status_data, dict) else {}
        existing["app_deleted"] = True
        existing["deleted_from_app_at"] = deleted_at
        existing["prevent_future_followups"] = True
        existing["auto_junked"] = True
        # Same identity fields perform_app_delete persists: under Cached Exchange Mode a
        # re-sync can hand the same message a NEW EntryID, and without these the deleted
        # row is not recognized on the next refresh and reappears as "new".
        for key in ["sender", "sender_email", "subject", "normalized_subject", "conversation_id",
                    "received", "received_timestamp", "source", "store_id",
                    "internet_message_id", "conversation_index",
                    "outlook_categories", "category", "urgency", "status"]:
            val = email.get(key, existing.get(key, ""))
            if val not in [None, ""]:
                existing[key] = val
        self.status_data[entry_id] = existing
        try:
            ops_log("triage", "auto_junked",
                    eid=str(entry_id)[-16:], sender=str(email.get("sender_email", "") or ""),
                    subj=str(email.get("subject", "") or "")[:80])
        except Exception:
            pass
        self._schedule_auto_junk_history_flush()
        return True

    def _schedule_auto_junk_history_flush(self):
        """v4.1.75: coalesce an import burst into ONE Deleted History write.

        save_deleted_history() is a SYNC ~10 MB write; calling it per message inside an
        import loop would block the Tk main thread for seconds. Debouncing through
        root.after keeps the write on the main thread (required -- it touches app state)
        while collapsing a whole burst into a single save. Falls back to an immediate
        save if root.after is unavailable, so history is never left only in memory."""
        try:
            if getattr(self, "_auto_junk_flush_scheduled", False):
                return
            self._auto_junk_flush_scheduled = True
            self.root.after(1500, self._flush_auto_junk_history)
        except Exception:
            self._auto_junk_flush_scheduled = False
            try:
                self.save_deleted_history()
                self.flush_status_data()
            except Exception:
                pass

    def _flush_auto_junk_history(self):
        """v4.1.75: debounced tail of _schedule_auto_junk_history_flush."""
        self._auto_junk_flush_scheduled = False
        try:
            self.save_deleted_history()
            self.flush_status_data()
        except Exception:
            pass

    def _trim_deleted_history(self):
        """v4.1.75: budget-aware Deleted History trim.

        The old flat [:1000] meant a busy marketing week could evict the user's real
        deletions off the end of the buffer. Auto-junked rows now get their OWN budget,
        so overflow of automated junk can only ever evict automated junk. Newest-first
        order within each class is preserved, and the merged list stays in the original
        relative order so the Deleted History window is unchanged visually."""
        try:
            manual_kept, junk_kept, out = 0, 0, []
            for rec in self.deleted_history:
                if not isinstance(rec, dict):
                    continue
                if rec.get("auto_junked"):
                    if junk_kept < DELETED_HISTORY_AUTO_JUNK_MAX:
                        junk_kept += 1
                        out.append(rec)
                elif manual_kept < DELETED_HISTORY_MANUAL_MAX:
                    manual_kept += 1
                    out.append(rec)
            self.deleted_history = out
        except Exception:
            self.deleted_history = self.deleted_history[:DELETED_HISTORY_MANUAL_MAX]

    def _offer_save_contact_type(self, selected_emails, new_code, parent=None):
        """v4.1.55: FIRST-TIME OFFER. When the user manually types email(s) C/V/E/M,
        offer -- once per sender, one dialog per operation -- to remember that type
        for the sender permanently. Yes: saved to the registry (and, for C/V, the
        quote-pipeline saved list so it shows in the Saved Senders window). No:
        remembered in 'asked' so the question never repeats for that sender. A
        sender already saved under a DIFFERENT code re-asks only because the fact
        changed (deliberate retype); same-code senders never prompt.

        v4.2.3: M (Marketing/Automated) added, at the user's request, with its real
        consequence spelled out in the dialog. M is NOT cosmetic like C/V/E: saving
        here uses source="first_time_offer", which is in USER_SET_CONTACT_TYPE_SOURCES,
        so _junk_record_is_user_set() becomes true and upsert_email() routes that
        sender's future mail through _auto_junk_email() on arrival. That is the
        intended behaviour -- but the C/V/E wording ("will be typed M automatically")
        would have understated it badly, so the M dialog states plainly that the mail
        is auto-deleted, and that nothing is destroyed: _auto_junk_email snapshots to
        Deleted History and NEVER touches Outlook, so the message is still in the
        mailbox and Restore brings the row back."""
        try:
            code = normalize_email_type_code(new_code)
            if code not in ("C", "V", "E", "M"):
                return
            data = self._load_contact_types()
            contacts = data.get("contacts", {})
            asked = data.get("asked", {})
            pending = {}
            for email in (selected_emails or []):
                if not isinstance(email, dict):
                    continue
                addr = extract_email_address(str(email.get("sender_email") or email.get("sender") or "")).lower()
                if not addr or "@" not in addr:
                    continue
                saved_code = ""
                rec = contacts.get(addr)
                if isinstance(rec, dict):
                    saved_code = normalize_email_type_code(rec.get("code"))
                if not saved_code:
                    # Pipeline lists count as saved too (Danny is a saved customer).
                    if addr in self._pipeline_saved_senders("customer"):
                        saved_code = "C"
                    elif addr in self._pipeline_saved_senders("vendor"):
                        saved_code = "V"
                if saved_code == code:
                    continue
                if not saved_code and addr in asked:
                    continue
                pending[addr] = saved_code
            if not pending:
                return
            label = EMAIL_TYPE_LABELS.get(code, code)
            addrs = sorted(pending)
            shown = "\n".join(f"  \u2022 {a}" for a in addrs[:6])
            if len(addrs) > 6:
                shown += f"\n  \u2026 and {len(addrs) - 6} more"
            changes = [a for a in addrs if pending[a]]
            note = ""
            if changes:
                note = ("\n\nNote: " + ", ".join(f"{a} is currently saved as "
                        f"{EMAIL_TYPE_LABELS.get(pending[a], pending[a])}" for a in changes[:3])
                        + ". Answering Yes updates the saved type.")
            extra = ""
            if code == "C":
                extra = "\n\nSaved Customers are also auto-recognized by Quote Scan (RFQs auto-draft an ack)."
            elif code == "V":
                extra = "\n\nSaved Vendors are also treated as suppliers by Quote Scan."
            elif code == "M":
                # v4.2.3: M is the JUNK rule, not just a label -- say so, because the
                # generic wording above ("will be typed M automatically") does not.
                extra = ("\n\nIMPORTANT: Marketing/Automated is also the junk rule. Future mail "
                         "from them goes STRAIGHT TO DELETED on arrival instead of your list.\n"
                         "Nothing is destroyed: the message stays in Outlook untouched, and the "
                         "row can be brought back any time from Deleted (Restore).")
            msg = (f"Always treat {'this sender' if len(addrs) == 1 else 'these senders'} as {label}?\n\n{shown}\n\n"
                   f"New email from them will be typed {code} automatically, and automation can never re-type them."
                   f"{extra}{note}\n\nYou can edit saved senders anytime in Settings \u2192 Manage Saved Contacts."
                   f"\n\n(Answering No will not ask again for {'this sender' if len(addrs) == 1 else 'these senders'}.)")
            try:
                yes = messagebox.askyesno(f"Save as {label}?", msg, parent=parent or self.root)
            except Exception:
                return
            ops_log("contact", "save_type_offer", code=code, n=len(addrs),
                    addrs=addrs[:6], accepted=bool(yes),
                    conflicts=len([_a for _a in addrs if pending[_a]]))
            if yes:
                for a in addrs:
                    self.set_saved_contact_type(a, code, source="first_time_offer")
            else:
                now = datetime.now().isoformat()
                for a in addrs:
                    asked[a] = now
                self._save_contact_types()
        except Exception:
            pass

    def _durable_email_type_for_email(self, email):
        """v4.1.17: resolve the durable relationship type (C/V/E/M) for this email.

        v4.1.55: the per-SENDER registry (Saved Senders + first-time offers) now
        outranks the per-email record -- a saved customer is a Customer on every
        email, including brand-new ones the AI has never seen. Per-email user
        exceptions still stand: user edits set ai_user_locked, so automation (the
        only consumer of this clamp) never touches those rows.

        Priority: per-sender registry, then the saved status record's email_type
        (survives refresh/restart and is set by user edits / save_record), then the
        in-memory row's own email_type."""
        try:
            if not isinstance(email, dict):
                return ""
            sender_code = self.get_saved_contact_type(email.get("sender_email") or email.get("sender") or "")
            if sender_code:
                return sender_code
            eid = str(email.get("entry_id", "") or "")
            saved = self.status_data.get(eid, {}) if (eid and isinstance(self.status_data, dict)) else {}
            saved_type = normalize_email_type_code((saved or {}).get("email_type")) if isinstance(saved, dict) else ""
            return saved_type or normalize_email_type_code(email.get("email_type"))
        except Exception:
            return ""

    # v4.2.20: urgency wording that escalates INTERNAL (type E) mail to High. Word-bounded
    # so "asap" inside a part number or "rush" in "Rushmore" cannot trip it, and phrased
    # loosely enough to catch how people actually write ("need this right away", "ASAP",
    # "first thing", "top priority"). Only ever RAISES urgency.
    _INTERNAL_URGENT_RE = re.compile(
        r"(?i)\b(?:urgent(?:ly)?|asap|a\.s\.a\.p\.?|right\s+away|immediately|emergency"
        r"|top\s+priority|high\s+priority|first\s+thing|need(?:s|ed)?\s+(?:this\s+)?(?:today|now)"
        r"|by\s+end\s+of\s+day|eod\s+today|time\s+sensitive|rush(?:ed|\s+order)?)\b")

    def _enforce_relationship_triage_rules(self, email, proposal, body="", durable_type="",
                                           marketing_scan=False, learned_junk=False):
        """v4.1.17 STICKY RELATIONSHIP TYPES + LOW FLOOR. Central clamp every automation
        path (pre-AI quick filter, learned hard rules, both Ollama triage appliers) runs
        its proposed workflow through BEFORE touching the email.

        proposal is a plain dict with canonical keys -- category, urgency, status,
        email_type, sender_type -- mutated in place. Returns a list of note strings for
        the triage reason/history so every clamp is visible in the AI Triage log.

        Rules (user-specified):
          1. STICKY TYPES. A customer is always a customer; an employee is always an
             employee. Automation may never retype a durable C or E sender. A durable
             V sender may change ONLY to M, and only when the message was genuinely
             scanned as marketing/advertising (marketing_scan). sender_type is forced
             to match so save_record's inference can never flip the type either.
          2. LOW FLOOR. Mail from a known Customer or Vendor is Normal at minimum:
             automation may not set Low urgency, Junk / Ignore category, or bury it
             auto-Completed -- unless the message was scanned as marketing
             (marketing_scan), the user explicitly taught junk for it (learned_junk),
             or it is a pure courtesy closer ('thanks', 'don't worry about it', ...),
             which may still go Low/Completed as previously programmed but is never
             CATEGORIZED as Junk (keeps sender/subject learning clean).

        User edits never pass through here -- this gates automation only.
        """
        notes = []
        try:
            if not isinstance(proposal, dict):
                return notes
            # v4.2.24: NEVER clamp a SENT-WAITING PLACEHOLDER. It is OUR OWN outgoing
            # message, held open while we wait for THEM -- but it stores the RECIPIENT's
            # address in sender_email, so the recipient's learned C/V rule matches and every
            # rule below then treats our own note as inbound mail from them. Rule 2 forces
            # status to "Needs Reply", which is precisely backwards: we just replied.
            #
            # Reported on "RE: RFP - Yorktown CSD Mohansic ES" (dgaribaldi@, 7/31 12:42 PM),
            # where the sent reply was "I'm sorry we don't have any of this in stock" and the
            # tracker still read Needs Reply. Measured across the live store: 18 of 250 live
            # sent-waiting rows sat at Needs Reply, every one carrying a "Low floor" reason,
            # and 45 disagreed with the placeholder store about their own email_type.
            #
            # Same root shape as v4.2.13 (a placeholder anchoring a group close) and v4.2.20
            # (X.500 senders): a placeholder mistaken for real inbound mail because it holds
            # the other party's address. email_needs_my_reply already guards this exact case
            # -- "this is OUR sent item awaiting THEIR reply, not our move" -- and this clamp
            # simply never got the same guard.
            if isinstance(email, dict) and (
                    email.get("is_sent_waiting_placeholder")
                    or str(email.get("entry_id", "") or "").startswith("sentwait:")
                    or str(email.get("source", "") or "").strip().lower().startswith("sent /")):
                notes.append("Sent-waiting placeholder: relationship clamp skipped -- this is our "
                             "own outgoing message, not inbound mail from the recipient.")
                return notes
            durable = normalize_email_type_code(durable_type) or self._durable_email_type_for_email(email)
            proposed_type = normalize_email_type_code(proposal.get("email_type"))

            # ---- Rule 1: sticky relationship types ----
            if durable in ("C", "E"):
                # v4.2.26: STICKY CATEGORY, not only sticky type. Reported: danny@
                # campbellanddawes is registry-typed C, yet his rows showed workflow
                # category "Vendor / Supplier" -- a learned sender rule (conf 0.86,
                # flipped 9 times) kept applying it. A known Customer or Employee is
                # never categorized as a vendor by automation; the user still can.
                if str(proposal.get("category", "")) == "Vendor / Supplier":
                    _cur = str((email or {}).get("category", "") or "")
                    proposal["category"] = _cur if (_cur and _cur != "Vendor / Supplier") else "General"
                    notes.append(
                        f"Sticky category: known {EMAIL_TYPE_LABELS.get(durable, durable)} is never "
                        f"categorized Vendor / Supplier by automation (kept {proposal['category']}).")
                if proposed_type and proposed_type != durable:
                    proposal["email_type"] = durable
                    notes.append(
                        f"Sticky type: sender is a known {EMAIL_TYPE_LABELS.get(durable, durable)}; "
                        f"automation kept type {durable} (proposed {proposed_type}).")
                proposal["sender_type"] = EMAIL_TYPE_TO_SENDER_TYPE.get(durable, proposal.get("sender_type", "unknown"))
            elif durable == "V":
                if marketing_scan:
                    # The one allowed automated type change: vendor sent advertising.
                    if proposed_type != "M":
                        proposal["email_type"] = "M"
                        notes.append("Vendor sent scanned advertising: type V -> M (the only allowed automated retype).")
                    proposal["sender_type"] = EMAIL_TYPE_TO_SENDER_TYPE["M"]
                else:
                    if proposed_type and proposed_type != "V":
                        proposal["email_type"] = "V"
                        notes.append(
                            f"Sticky type: sender is a known Vendor; automation kept type V "
                            f"(proposed {proposed_type}; V may only become M on a marketing scan).")
                    proposal["sender_type"] = EMAIL_TYPE_TO_SENDER_TYPE["V"]
            elif durable == "M":
                # A durable Marketing sender stays M for automation purposes; only the
                # user can promote it back to a business type.
                if proposed_type and proposed_type not in ("M",):
                    proposal["email_type"] = "M"
                    notes.append("Sticky type: sender was marked Marketing/Automated; automation cannot promote it.")

            # ---- Rule 2: Low floor for known customers/vendors ----
            # v4.2.29: a burial the USER performed outranks the Low floor. Rule 2 exists to
            # stop AUTOMATION dumping known Customer/Vendor mail into Low/Junk/Completed --
            # it was never meant to overrule a human. Without this, every row Steve set to
            # Low was floored straight back to Normal on the next triage pass, with the row's
            # own reason recording it: "Low floor: known Vendor mail floors at Normal urgency".
            if isinstance(email, dict) and email.get("user_buried_at"):
                notes.append("User-buried row: Low floor skipped -- the user set this urgency "
                             "deliberately.")
                return notes
            effective = normalize_email_type_code(proposal.get("email_type")) or durable
            # v4.2.20: E JOINS THE LOW FLOOR. Rule 2 above named Customer and Vendor only,
            # so an EMPLOYEE's mail could still be auto-junked and buried. Reported live:
            # Jeremy forwarded a customer quote to Sales and it showed as
            # "Junk / Ignore" + Low + Completed until AI triage landed minutes later and
            # corrected it to General / Normal / New. The final answer was right; the
            # window before it was not, and a forwarded quote must never look like junk.
            if effective in ("C", "V", "E") and not marketing_scan and not learned_junk:
                proposed_junk_style = (
                    str(proposal.get("category", "")) == "Junk / Ignore"
                    or str(proposal.get("urgency", "")) == "Low"
                )
                if str(proposal.get("category", "")) == "Junk / Ignore":
                    current_category = str((email or {}).get("category", "") or "")
                    if current_category and current_category != "Junk / Ignore":
                        proposal["category"] = current_category
                    else:
                        proposal["category"] = "Vendor / Supplier" if effective == "V" else "General"
                    notes.append(
                        f"Low floor: known {EMAIL_TYPE_LABELS.get(effective, effective)} mail is never auto-junked "
                        f"(category kept {proposal['category']}).")
                if proposed_junk_style or str(proposal.get("status", "")) == "Completed":
                    courtesy = email_is_courtesy_closer(
                        (email or {}).get("subject", ""), body or (email or {}).get("body", ""))
                else:
                    courtesy = False
                if not courtesy:
                    if str(proposal.get("urgency", "")) == "Low":
                        proposal["urgency"] = "Normal"
                        notes.append(
                            f"Low floor: known {EMAIL_TYPE_LABELS.get(effective, effective)} mail floors at Normal urgency "
                            f"(not a courtesy closer / not scanned as marketing).")
                    if proposed_junk_style and str(proposal.get("status", "")) == "Completed":
                        # v4.2.20: an EMPLOYEE's mail lands as NEW, not Needs Reply. A
                        # colleague forwarding a quote is work to pick up, not a message
                        # we owe them an answer to -- and parking it in the reply queue
                        # is what the whole v4.2.11-v4.2.18 line of fixes was undoing.
                        proposal["status"] = "New" if effective == "E" else "Needs Reply"
                        notes.append("Low floor: junk-style auto-complete blocked; status set to "
                                     "%s for review." % proposal["status"])
                    # v4.2.20: explicit escalation, per Steve -- internal mail is Normal at
                    # minimum, but High when it actually says so. Checked on the subject and
                    # the body, and it only ever RAISES urgency (Critical is never lowered).
                    if effective == "E" and str(proposal.get("urgency", "")) not in ("High", "Critical"):
                        _txt = "%s\n%s" % ((email or {}).get("subject", ""),
                                           body or (email or {}).get("body", ""))
                        if self._INTERNAL_URGENT_RE.search(_txt or ""):
                            proposal["urgency"] = "High"
                            notes.append("Internal mail flagged High: urgency wording found in the "
                                         "subject/body.")
                elif proposed_junk_style or str(proposal.get("status", "")) == "Completed":
                    notes.append("Courtesy closer detected ('thanks' / 'don't worry about it' style): Low/Completed allowed as previously programmed.")

            # ---- Rule 3 (v4.1.77): QUOTE-CONTENT FLOOR, user-specified rule: an email whose
            # body/subject carries actual price & availability content must never be tagged
            # junk / buried by automation. Rule 2 only protects SAVED C/V senders -- the
            # reported failure was a NEW vendor (not saved yet) whose P&A reply was junked by
            # a subject-learned rule (learned_junk=True bypassed Rule 2's floor entirely).
            # Two tiers:
            #   Tier A (thread evidence): the email is on a thread we recently SENT a
            #     request on (sent/waiting tracker match). We asked; the answer can never be
            #     junk. Beats learned_junk AND marketing_scan -- a subject-learned junk rule
            #     hitting the reply to our own P&A request is precisely the reported bug.
            #   Tier B (no thread evidence): same gates as Rule 2 (not marketing_scan, not
            #     learned_junk) so a marketing blast full of "$19.99" from an automated
            #     sender can still be junked, but an unsolicited genuine vendor quote from
            #     an unsaved sender is protected.
            proposed_buried = (
                str(proposal.get("category", "")) == "Junk / Ignore"
                or str(proposal.get("urgency", "")) == "Low"
                or str(proposal.get("status", "")) == "Completed"
            )
            if proposed_buried and self._reply_has_quote_content(
                    (email or {}).get("subject", ""), body or (email or {}).get("body", "")):
                _on_sent_thread = self._email_matches_recent_sent_thread(email)
                if _on_sent_thread or (not marketing_scan and not learned_junk):
                    _blocked = []
                    if str(proposal.get("category", "")) == "Junk / Ignore":
                        _cur_cat = str((email or {}).get("category", "") or "")
                        if _cur_cat and _cur_cat != "Junk / Ignore":
                            proposal["category"] = _cur_cat
                        else:
                            _eff3 = normalize_email_type_code(proposal.get("email_type")) or durable
                            proposal["category"] = "Vendor / Supplier" if _eff3 == "V" else "General"
                        _blocked.append("junk-category")
                    if str(proposal.get("urgency", "")) == "Low":
                        proposal["urgency"] = "Normal"
                        _blocked.append("low-urgency")
                    if str(proposal.get("status", "")) == "Completed":
                        proposal["status"] = "Needs Reply"
                        _blocked.append("auto-complete")
                    if _blocked:
                        notes.append(
                            "Quote floor: message carries price/availability content"
                            + (" on a thread we sent a request on" if _on_sent_thread else "")
                            + "; blocked " + ", ".join(_blocked) + " -- a P&A answer is never junk.")
                        try:
                            ops_log("triage", "quote_floor_block",
                                    eid=str((email or {}).get("entry_id", "") or "")[-16:],
                                    sender=str((email or {}).get("sender_email", "") or "")[:60],
                                    blocked=",".join(_blocked), sent_thread=_on_sent_thread,
                                    learned_junk=bool(learned_junk), marketing=bool(marketing_scan))
                        except Exception:
                            pass
        except Exception:
            pass
        return notes

    # v4.2.4: explicit do-not-reply tokens ONLY. Deliberately NOT AUTOMATED_SENDER_HINTS,
    # which also carries "notification"/"updates"/"alerts"/"marketing"/"events" -- far too
    # broad to hard-block a workflow status on, and real vendors send from those. Flexible
    # separators, but \b at BOTH ends so "Reno Reply" cannot match the way a bare compacted
    # substring test would.
    _DO_NOT_REPLY_RE = re.compile(r"\b(?:no[\s._-]*reply|do[\s._-]*not[\s._-]*reply)\b", re.I)

    @classmethod
    def _sender_is_do_not_reply(cls, email):
        """v4.2.4: True when the sender announces itself as unattended -- in the DISPLAY
        NAME, the address local part, or the domain.

        Reported live: 'Do Not Reply (Selecta Products, Inc.)' <spmail@selectainc.com>,
        subject "QUOTE", was set to **Needs Reply**. The address is perfectly clean, so every
        existing check missed it -- the three sender_looks_automated() call sites all read
        `email.get("sender_email") or email.get("sender", "")`, an OR that only falls back to
        the display name when the address is EMPTY. Contrast noreply@nvent.com and
        DONOTREPLY@HubbellEnterprise.com, which WERE caught, because their ADDRESSES match.

        Checks the display name AND the full address (local part and domain both), so any one
        of the three carrying the token is enough.

        Deliberately SEPARATE from sender_looks_automated rather than widening it: that
        function feeds marketing/spam scoring, where it both triggers burial AND guards typed
        C/V mail from being buried, so broadening its inputs would bury more real vendor mail
        -- the opposite of what this fix is for.
        """
        try:
            for part in (str((email or {}).get("sender", "") or ""),
                         str((email or {}).get("sender_email", "") or ""),
                         str((email or {}).get("resolved_sender_smtp", "") or "")):
                if part and cls._DO_NOT_REPLY_RE.search(part):
                    return True
        except Exception:
            return False
        return False

    _WE_ORIGINATED_RE_PREFIX = re.compile(r"^\s*(?:re|fw|fwd)\s*:", re.I)

    def _origination_convs(self):
        """v4.2.11: conversation ids of sent-waiting placeholders whose subject has NO
        Re:/Fw: prefix -- i.e. threads WE STARTED with our own outbound message.

        Rebuilt only when the placeholder list changes length, so the per-email triage
        cost is a set lookup rather than a scan of ~600 placeholders.
        """
        try:
            ph = getattr(self, "sent_waiting_placeholders", None) or []
            cached = getattr(self, "_origination_convs_cache", None)
            # v4.2.26: key on (count, last entry) -- a count-only key went stale when one
            # placeholder was appended while another was purged in the same tick.
            _ck = (len(ph), str((ph[-1] or {}).get("created_at", "")) if ph else "")
            if cached is not None and cached[0] == _ck:
                return cached[1]
            convs = set()
            for p in ph:
                if not isinstance(p, dict):
                    continue
                cid = str(p.get("conversation_id", "") or "")
                if not cid:
                    continue
                if not self._WE_ORIGINATED_RE_PREFIX.match(str(p.get("subject", "") or "")):
                    convs.add(cid)
            self._origination_convs_cache = (_ck, convs)
            return convs
        except Exception:
            return set()

    def _reply_is_on_our_sent_rfq_thread(self, email):
        """True when this inbound email is someone answering something WE sent first.

        v4.2.9 keyed this on thread_group_rule == "sent_waiting_tracker_group" and that
        was WRONG -- caught by the v4.2.10 /why endpoint within an hour of shipping.
        That field is set in one place (~43176) but is OVERWRITTEN with
        "conversation_or_subject" by later grouping passes (24502 / 26455 / 27715), and
        it does not survive into the working set: measured on the live store, 60 SAVED
        rows carried the marker while only 4 LIVE rows did. So the clamp was very nearly
        inert. The harness missed it because it fed rows straight from status.json,
        where the marker IS present -- it tested the logic and not the input assumption.

        The durable fact is THREAD ORIGINATION. A sent-waiting placeholder whose subject
        carries no Re:/Fw: prefix is a thread WE started; anything inbound sharing that
        conversation is answering us. Verified against the live store: it catches the
        reported vendor quote ("Re: 1598 PT P&A") and correctly EXCLUDES both the
        customer's own request and a customer's follow-up on a thread THEY started
        ("RE: 1582 WAGO" from danny@, where we were replying into their thread and may
        well owe another reply). 230 placeholders are we-originated vs 394 reply-into,
        so the split is real and not a rounding artefact.

        Deliberately independent of sender typing: the reported row was mistyped as a
        Customer at the time, and this still identifies it correctly.
        """
        try:
            if not isinstance(email, dict):
                return False
            # fast path: the marker, when it happens to be present and intact
            if str(email.get("thread_group_rule", "") or "") == "sent_waiting_tracker_group":
                return True
            if email.get("sent_waiting_tracker_group_id"):
                return True
            cid = str(email.get("conversation_id", "") or "")
            if not cid:
                return False
            # our own outbound rows are not "replies to us"
            if str(email.get("source", "") or "").strip().lower().startswith("sent"):
                return False
            if email.get("is_sent_waiting_placeholder"):
                return False
            if cid in self._origination_convs():
                return True
            # v4.2.26: SUBJECT fallback. Two live misses shared one shape: the inbound
            # reply did not share a conversation with any placeholder -- jamesl@brazill
            # replies from Gmail (re-threaded), and his outbound RFQ never got a
            # placeholder at all. The SUBJECT of a thread we started is ours by
            # construction; match the reply's normalized subject against we-originated
            # placeholder subjects, distinctiveness-gated ("1582 l14-30 ig p&a" yes,
            # a bare "p&a" or "quote" never).
            subj = normalize_subject_for_match(str(email.get("subject", "") or ""))
            if len(subj) >= 10 and any(ch.isdigit() for ch in subj):
                return subj in self._origination_subjects()
            return False
        except Exception:
            return False

    def _origination_subjects(self):
        """v4.2.26: normalized subjects of threads WE started (companion to
        _origination_convs, same cache discipline)."""
        try:
            ph = getattr(self, "sent_waiting_placeholders", None) or []
            cached = getattr(self, "_origination_subjects_cache", None)
            _ck = (len(ph), str((ph[-1] or {}).get("created_at", "")) if ph else "")
            if cached is not None and cached[0] == _ck:
                return cached[1]
            subs = set()
            for p in ph:
                if not isinstance(p, dict):
                    continue
                if self._WE_ORIGINATED_RE_PREFIX.match(str(p.get("subject", "") or "")):
                    continue
                ns = normalize_subject_for_match(str(p.get("subject", "") or ""))
                if len(ns) >= 10 and any(ch.isdigit() for ch in ns):
                    subs.add(ns)
            self._origination_subjects_cache = (_ck, subs)
            return subs
        except Exception:
            return set()

    def _clamp_status_for_sent_rfq_reply(self, email, status, where=""):
        """v4.2.9: a vendor answering OUR OWN RFQ is not a message we owe a reply to.

        Reported live on group "1598 PT": James Larkin sent the pricing we had asked
        for, and MaINbox filed it "Needs Reply". Two things had to line up. (a) His
        address had no sender rule, so typing fell back to the learned DOMAIN rule for
        brazill.com, which is CORRECT (email_type "V", status "Completed") but carries
        confidence 0.4 after 12 flip-flops -- too weak to override the model, which
        guessed sender_type "customer_or_prospect". (b) Incoming CUSTOMER mail defaults
        to "Needs Reply". So a vendor quote we solicited was typed as customer mail and
        parked in the reply queue.

        The durable signal is the THREAD, not the sender: this row already carried
        thread_group_rule="sent_waiting_tracker_group", i.e. MaINbox had already matched
        it into the group of our own sent RFQ. Context beats identity here -- whatever we
        think of the sender globally, on THIS thread they are answering us.

        Measured over the live store: 42 rows are replies on our own sent-RFQ threads,
        typed across V/C/E/blank and split over Completed/New/Needs Reply -- 6 still sat
        open. Sender typing is demonstrably not converging on its own, which is why this
        keys on the thread instead.

        Downgraded to "New", NOT "Completed": the quote still has to be read and turned
        into the customer's price, so burying it would hide real work. It only leaves the
        reply queue. Every other status passes through untouched, and any user-set status
        is left alone because this only ever rewrites "Needs Reply".
        """
        try:
            if str(status or "") != "Needs Reply":
                return status
            if not self._reply_is_on_our_sent_rfq_thread(email):
                return status
            try:
                ops_log("triage", "sent_rfq_reply_status_clamp",
                        eid=str((email or {}).get("entry_id", "") or "")[-16:],
                        sender=str((email or {}).get("sender_email", "") or "")[:50],
                        etype=str((email or {}).get("email_type", "") or ""),
                        grp=str((email or {}).get("sent_waiting_tracker_group_name", "") or "")[:40],
                        subj=str((email or {}).get("subject", "") or "")[:50], where=str(where)[:24])
            except Exception:
                pass
            return "New"
        except Exception:
            return status

    def _clamp_status_for_do_not_reply(self, email, status, where=""):
        """v4.2.4: an unattended sender can never owe us a reply, so "Needs Reply" on one is a
        status the user can never clear -- it just sits in the reply queue forever.

        Downgraded to "New", NOT Completed: the reported message was a real vendor QUOTE and
        burying it would lose actual work. New keeps it visible and triageable and only takes
        it out of the reply queue. Every other status passes through untouched.
        """
        try:
            if str(status or "") != "Needs Reply":
                return status
            if not self._sender_is_do_not_reply(email):
                return status
            try:
                ops_log("triage", "do_not_reply_status_clamp",
                        eid=str((email or {}).get("entry_id", "") or "")[-16:],
                        sender=str((email or {}).get("sender", "") or "")[:60],
                        addr=str((email or {}).get("sender_email", "") or "")[:60],
                        subj=str((email or {}).get("subject", "") or "")[:60], where=str(where)[:24])
            except Exception:
                pass
            return "New"
        except Exception:
            return status

    def apply_quick_sender_intent(self, email, body="", _related=None):
        """Apply learning/contact/sender rules before AI and return signal context for Ollama.

        _related: optional pre-built list from build_related_subject_context.
        When provided the O(n) subject scan is skipped (v3 efficiency fix).
        """
        if _related is None:
            related, _lines = self.build_related_subject_context(email)
        else:
            related = _related
        quick = quick_sender_intent_analysis(
            subject=email.get("subject", ""),
            sender=email.get("sender_email") or email.get("sender", ""),
            body=body or email.get("body", ""),
            related_count=len(related),
            source=email.get("source", ""),
            attachment_names=email.get("attachment_names", "")
        )

        learning_hint, learning_source = self.get_learning_hint_for_email(email)
        trusted_contact = self.is_trusted_contact_sender(email)

        if trusted_contact:
            quick["trusted_sender"] = True
            quick["business_relevance"] = max(float(quick.get("business_relevance", 0) or 0), TRUSTED_SENDER_BUSINESS_FLOOR)
            quick["spam_likelihood"] = min(float(quick.get("spam_likelihood", 0) or 0), TRUSTED_SENDER_SPAM_CAP)
            if quick.get("workflow_category") == "Junk / Ignore":
                quick["workflow_category"] = "General"
                quick["urgency"] = "Normal"
                quick["status"] = "Needs Reply"
                quick["hard_decision"] = False
            quick["reason"] = (quick.get("reason", "") + " Trusted sender/contact protection applied.").strip()

        if learning_hint:
            # v4.2.31: a learned rule must NEVER contradict the relationship the USER saved.
            # Reported: "Danny from campbellanddawes is saved under customer ... but why is
            # the workflow category coming up vendor / supplier?" -- he IS saved (Saved
            # Customers, and get_saved_contact_type resolves him to C through the
            # quote-pipeline fallback), but the learned SENDER rule below carried
            # category="Vendor / Supplier" and applied it as a hard_decision, overriding the
            # saved type on every email. That rule's own record shows changed_times=9: the
            # user corrected it nine times and it never moved. A learned rule is a guess
            # about workflow; the Saved Senders list is a statement of fact about the
            # relationship, so the saved type wins and the contradicting category is dropped.
            try:
                _durable = self._durable_email_type_for_email(email)
                _learned_cat = learning_hint.get("category", "")
                _conflicts = (
                    (_durable == "C" and _learned_cat == "Vendor / Supplier")
                    or (_durable == "V" and _learned_cat == "Customer Issue")
                    or (_durable in ("C", "V", "E") and _learned_cat == "Junk / Ignore"))
                if _conflicts:
                    learning_hint = dict(learning_hint)
                    learning_hint.pop("category", None)
                    quick["learned_category_dropped"] = str(_learned_cat)
                    try:
                        ops_log("triage", "learned_rule_conflicts_saved_type",
                                eid=str(email.get("entry_id", "") or "")[-16:],
                                sender=str(email.get("sender_email", "") or ""),
                                durable=_durable, learned_cat=str(_learned_cat),
                                changed_times=learning_hint.get("changed_times", 0))
                    except Exception:
                        pass
            except Exception:
                pass
            # User corrections are stronger than AI guesses. They protect known customers/vendors/projects.
            quick["learned_rule_source"] = learning_source
            quick["learned_rule_times"] = learning_hint.get("times", 1)
            quick["workflow_category"] = learning_hint.get("category", quick.get("workflow_category", "General"))
            quick["urgency"] = learning_hint.get("urgency", quick.get("urgency", "Normal"))
            quick["status"] = learning_hint.get("status", quick.get("status", "Needs Reply"))
            learned_email_type = normalize_email_type_code(learning_hint.get("email_type", ""))
            if learned_email_type:
                quick["email_type"] = learned_email_type
            quick["business_relevance"] = 0.90 if not learning_hint.get("is_junk") else 0.10
            quick["spam_likelihood"] = 0.08 if not learning_hint.get("is_junk") else 0.90
            try:
                learned_confidence = float(learning_hint.get("confidence", 0.0) or 0.0)
            except Exception:
                learned_confidence = 0.0
            try:
                learned_times = int(learning_hint.get("times", 1) or 1)
            except Exception:
                learned_times = 1
            # Learn exact contacts faster: one explicit sender correction is enough to
            # protect future emails from the same sender. Broader subject/domain rules
            # still need repeat confirmation or stronger confidence.
            # v4.1.51: "Require confirmation before applying newly learned behavior"
            # is now WIRED (it was saved but never consumed). When on, learned rules
            # still fill the proposed fields as advisory context, but hard_decision
            # stays False so triage/AI review happens before the rule is enforced.
            _confirm_first = bool(self.settings.get("ai_learning_confirm_before_apply", False))
            # v4.2.31: a rule the user has re-corrected many times has demonstrably not
            # converged -- Danny's carried changed_times=9 while still asserting the wrong
            # category. Such a rule may still ADVISE (it fills the proposed fields above)
            # but it may not short-circuit triage as a hard decision.
            try:
                _churn = int(learning_hint.get("changed_times", 0) or 0)
            except Exception:
                _churn = 0
            _unstable = _churn >= LEARNED_RULE_CHURN_LIMIT
            if _unstable:
                quick["learned_rule_unstable"] = _churn
            quick["hard_decision"] = bool(
                not _confirm_first and not _unstable and (
                    (learning_source == "sender" and learned_confidence >= 0.65)
                    or learned_times >= 2
                    or learned_confidence >= 0.80
                )
            )
            if _confirm_first:
                quick["reason"] = (quick.get("reason", "") +
                                   " Confirm-before-apply is ON: learned rule shown as advisory only.").strip()
            quick["reason"] = (quick.get("reason", "") + f" Learned user correction matched by {learning_source}; applying remembered workflow.").strip()
            # v4.1.17: expose the learned-junk fact so downstream AI appliers can honor
            # the user's own junk teaching as a sanctioned Low-floor exception.
            quick["learned_is_junk"] = bool(learning_hint.get("is_junk"))

        followup_hint, followup_hint_key = self.get_followup_learning_hint_for_email(email)
        if followup_hint:
            quick["learned_followup_key"] = followup_hint_key
            quick["learned_followup_behavior"] = followup_hint.get("behavior", "")
            quick["learned_followup_minutes"] = followup_hint.get("minutes")
            quick["learned_followup_reason"] = followup_hint.get("reason", "")
            if followup_hint.get("behavior") == "no_followup":
                quick["needs_followup"] = False
                quick["followup_reason"] = "Learned rule says no follow-up for this sender/subject/domain."
            else:
                quick["needs_followup"] = True
                quick["followup_reason"] = followup_hint.get("reason", "Learned follow-up behavior matched.")
            quick["reason"] = (quick.get("reason", "") + f" Learned follow-up rule matched: {followup_hint.get('behavior','')} ({followup_hint_key}, confidence {float(followup_hint.get('confidence', 0) or 0):.0%}).").strip()

        # v4.1.17 STICKY TYPES + LOW FLOOR: clamp the pre-AI decision BEFORE it is
        # stamped onto the email or handed to Ollama as signal context. A durable
        # Customer/Employee type can never be changed by automation; a durable Vendor
        # may only become Marketing when the message was genuinely scanned as
        # advertising; and known C/V mail floors at Normal urgency / non-Junk category
        # unless scanned as marketing, taught junk by the user, or a courtesy closer.
        _durable_type = self._durable_email_type_for_email(email)
        if not _durable_type and learning_hint and learning_source == "sender":
            # Sender-level learned type = the user's own teaching about this contact.
            _durable_type = normalize_email_type_code(learning_hint.get("email_type", ""))
        _marketing_scan = (
            str(quick.get("sender_type", "")) == "automated_or_marketing"
            and str(quick.get("workflow_category", "")) == "Junk / Ignore"
        )
        # v4.1.18 audit: a KNOWN customer/vendor writing from a HUMAN address is never
        # "scanned as marketing" on phrases alone -- quoted chains and forwarded content
        # legitimately carry 'unsubscribe'/'click here'. Real advertising comes from
        # automated addresses (noreply/newsletter/marketing@...), so require that
        # sender shape before the marketing exemption can bury typed C/V mail.
        if _marketing_scan and _durable_type in ("C", "V") and not sender_looks_automated(
                email.get("sender_email") or email.get("sender", "")):
            _marketing_scan = False
        _proposal = {
            "category": quick.get("workflow_category", "General"),
            "urgency": quick.get("urgency", "Normal"),
            "status": quick.get("status", "Needs Reply"),
            "email_type": quick.get("email_type", ""),
            "sender_type": quick.get("sender_type", "unknown"),
        }
        _notes = self._enforce_relationship_triage_rules(
            email, _proposal, body=body or email.get("body", ""),
            durable_type=_durable_type, marketing_scan=_marketing_scan,
            learned_junk=bool(quick.get("learned_is_junk", False)),
        )
        quick["workflow_category"] = _proposal["category"]
        quick["urgency"] = _proposal["urgency"]
        quick["status"] = _proposal["status"]
        quick["sender_type"] = _proposal["sender_type"]
        if _proposal.get("email_type"):
            quick["email_type"] = _proposal["email_type"]
        if _durable_type:
            quick["durable_email_type"] = _durable_type
        if _notes:
            quick["reason"] = (quick.get("reason", "") + " " + " ".join(_notes)).strip()
            # A floored decision is no longer a safe pre-AI hard decision to bury the
            # email -- let AI (or the user) look at it instead of auto-hiding it.
            if any("Low floor" in n for n in _notes):
                quick["hard_decision"] = False
                quick["business_relevance"] = max(float(quick.get("business_relevance", 0) or 0), 0.70)
                quick["spam_likelihood"] = min(float(quick.get("spam_likelihood", 0) or 0), 0.35)

        email["sender_type"] = quick.get("sender_type", "unknown")
        email["sender_intent"] = quick.get("sender_intent", "")
        email["business_relevance"] = quick.get("business_relevance", 0)
        email["spam_likelihood"] = quick.get("spam_likelihood", 0)
        email["same_subject_related_count"] = quick.get("same_subject_related_count", 0)
        email["trusted_sender"] = bool(quick.get("trusted_sender", False))
        email["learned_rule_source"] = quick.get("learned_rule_source", "")

        # v2.3.2: protect uniform/exact subject work from being buried as Low/Junk.
        workflow_hint = self.get_best_same_subject_workflow_hint(email)
        if workflow_hint and not (learning_hint and learning_hint.get("is_junk")):
            quick["workflow_category"] = workflow_hint.get("category", quick.get("workflow_category", "General"))
            quick["urgency"] = workflow_hint.get("urgency", quick.get("urgency", "Normal"))
            # v4.1.17: a NEW message from a known Customer/Vendor floors at Normal even when
            # the same-subject hint inherits Low from an older row the user had buried --
            # new inbound C/V mail is new work, not a continuation of the burial.
            # v4.2.20: E included -- an employee's new mail is new work too.
            if _durable_type in ("C", "V", "E") and str(quick.get("urgency", "")) == "Low":
                quick["urgency"] = "Normal"
            quick["status"] = "Needs Reply"
            quick["business_relevance"] = max(float(quick.get("business_relevance", 0) or 0), 0.82)
            quick["spam_likelihood"] = min(float(quick.get("spam_likelihood", 0) or 0), 0.25)
            quick["hard_decision"] = False
            quick["reason"] = (quick.get("reason", "") + " Same-subject protection: inherited workflow from prior non-junk related email "
                               f"({workflow_hint.get('category','General')} / {workflow_hint.get('urgency','Normal')}).").strip()
            email["sender_intent"] = (email.get("sender_intent", "") + " Same-subject match to existing work.").strip()
            email["business_relevance"] = quick["business_relevance"]
            email["spam_likelihood"] = quick["spam_likelihood"]

        changed = False
        # Hard decisions are safe to apply before Ollama. This keeps true junk from becoming followups.
        # v3.9.79: but never let a pre-AI hard decision (junk filter or learned-rule match) overwrite the
        # category/urgency/status on an email the user explicitly set. ai_user_locked is the user's
        # decision; only a close trigger may override it. Without this gate a re-imported / EntryID-drifted
        # locked email gets snapped back to a learned-rule workflow on the next refresh -- the recurring
        # "my urgency won't stick" bug, via the one automation path the v3.9.46/47 lock did not cover.
        # v4.2.4: last word on the quick-triage status. `quick` is both applied below (on a
        # hard decision) and RETURNED to the caller, so clamping here covers every consumer.
        try:
            quick["status"] = self._clamp_status_for_do_not_reply(
                email, quick.get("status"), where="quick_intent")
            # v4.2.9: and a reply on our OWN sent-RFQ thread is not ours to answer.
            quick["status"] = self._clamp_status_for_sent_rfq_reply(
                email, quick.get("status"), where="quick_intent")
        except Exception:
            pass
        if quick.get("hard_decision") and not email.get("ai_user_locked"):
            for key, qkey in [("category", "workflow_category"), ("urgency", "urgency"), ("status", "status"), ("email_type", "email_type")]:
                val = quick.get(qkey)
                if val and val != email.get(key):
                    email[key] = val
                    changed = True
            email["ai_triage_pending"] = False
            email["ai_triaged_at"] = datetime.now().isoformat()
            email["ai_triage_reason"] = quick.get("reason", "Pre-AI hard filter")
            self.save_record(email)
        if quick:
            # v4.1.62: the key is sender_intent (all 38 production records logged
            # empty intents because of this); also record category/urgency verdicts.
            ops_log("triage", "quick_intent",
                    eid=str(email.get("entry_id", "") or "")[-16:],
                    intent=str(quick.get("sender_intent", "") or ""), hard=bool(quick.get("hard_decision")),
                    applied=bool(changed), sender=str(email.get("sender_email") or ""),
                    wcat=str(quick.get("workflow_category", "") or ""), urg=str(quick.get("urgency", "") or ""),
                    reason=str(quick.get("reason", "") or ""))
        return quick, changed

    def apply_ai_triage_to_email(self, email, allow_group_prompt=True):
        """Use pre-AI sender/phrase signals plus Ollama to improve category/urgency/status/grouping."""
        if not AI_TRIAGE_ENABLED or not email:
            return False
        try:
            body = self.load_body_if_needed(email)
        except Exception:
            body = email.get("body", "") or ""
        # v4.2.31: did this pass actually SEE the message? load_body_if_needed gives up
        # after an 8s wait when another Outlook worker holds the lock and returns "",
        # leaving body_loaded False -- triage then decides on subject+sender alone and
        # stamps the verdict as final, so it is never revisited. Measured live: 33 of 593
        # cached rows were triaged with no body. Reported symptom: Danny's short replies
        # ("ok" / "noted to look over") landing on the default "Incoming message defaults
        # to Needs Reply", and "RE: 1598 DEWALT" typed Vendor with sender_intent "unclear"
        # while carrying body_load_skipped_reason verbatim.
        _blind = bool(not email.get("body_loaded") and not str(body or "").strip())

        # v4.2.32: a saved customer's "OK" / "noted" is decided BEFORE anything else --
        # it is an explicit answer from the customer, so no AI guess should overwrite it.
        # Skipped on a blind pass: the requeue will run it once the body is readable.
        if not _blind:
            try:
                _verdict = self.detect_process_or_ack_reply(email, body=body)
            except Exception:
                _verdict = ""
            if _verdict and self.apply_process_or_ack_decision(email, _verdict):
                email["ai_triage_pending"] = False
                email["ai_triaged_at"] = datetime.now().isoformat()
                self.save_record(email)
                self.flush_status_data()
                return True

        # v2.10.6: once the body is available, re-check dormant thread reactivation with full content.
        try:
            if self.reactivate_dormant_thread_if_needed(email, body=body):
                self.save_cached_state()
        except Exception:
            pass

        quick_result = self.apply_quick_sender_intent(email, body=body)
        if isinstance(quick_result, tuple):
            quick, quick_changed = quick_result
        else:
            quick, quick_changed = quick_result, False
        if quick.get("hard_decision"):
            return quick_changed

        related, related_lines = self.build_related_subject_context(email)
        try:
            result = ask_ollama_for_triage(
                subject=email.get("subject", ""),
                sender=email.get("sender_email") or email.get("sender", ""),
                body=body,
                groups=self.groups_data.get("groups", []),
                signal_context=quick,
                related_subjects=related_lines,
            )
        except Exception:
            result = None
        if not result:
            return quick_changed

        changed = quick_changed
        suggested_category = str(result.get("workflow_category", quick.get("workflow_category", ""))).strip()
        suggested_urgency = str(result.get("urgency", quick.get("urgency", ""))).strip()
        suggested_status = str(result.get("status", quick.get("status", ""))).strip()

        # Safety: spam-ish or low-relevance AI result cannot create actionable workflow.
        try:
            business_relevance = float(result.get("business_relevance", quick.get("business_relevance", 0)) or 0)
        except Exception:
            business_relevance = 0
        try:
            spam_likelihood = float(result.get("spam_likelihood", quick.get("spam_likelihood", 0)) or 0)
        except Exception:
            spam_likelihood = 0
        protected_by_same_subject = bool(related) and bool(self.get_best_same_subject_workflow_hint(email))
        if (spam_likelihood >= 0.70 or business_relevance <= 0.25) and not protected_by_same_subject:
            suggested_category = "Junk / Ignore"
            suggested_urgency = "Low"
            suggested_status = "Completed"
        elif protected_by_same_subject and suggested_category == "Junk / Ignore":
            # Exact subject matches prior real work, so do not let the small model bury it as junk.
            workflow_hint = self.get_best_same_subject_workflow_hint(email) or {}
            suggested_category = workflow_hint.get("category", "General")
            suggested_urgency = workflow_hint.get("urgency", "Normal")
            suggested_status = "Needs Reply"
            business_relevance = max(business_relevance, 0.82)
            spam_likelihood = min(spam_likelihood, 0.25)

        # Bias correction: incoming business emails default to Needs Reply unless there is strong customer-waiting evidence.
        if suggested_status == "Waiting on Customer":
            sender_intent = f"{result.get('sender_intent','')} {quick.get('sender_intent','')} {result.get('reason','')}".lower()
            if "po" not in sender_intent and "approval" not in sender_intent and "send" not in sender_intent and "later" not in sender_intent and quick.get("status") != "Waiting on Customer":
                suggested_status = "Needs Reply"

        # v4.1.17 STICKY TYPES + LOW FLOOR: clamp the AI's suggestion before applying.
        _resolved_sender_type = str(result.get("sender_type", quick.get("sender_type", "unknown"))).strip() or "unknown"
        _marketing_scan = bool(
            spam_likelihood >= 0.70 and (
                _resolved_sender_type == "automated_or_marketing"
                or sender_looks_automated(email.get("sender_email") or email.get("sender", ""))
                or contains_any_phrase(f"{email.get('subject', '')}\n{body}".lower(), SPAM_OR_MARKETING_PHRASES)
            )
        )
        # v4.1.18 audit: typed C/V mail from a human address is never buried on
        # phrase/model spam signals alone -- advertising comes from automated senders.
        _dt_for_mkt = str(quick.get("durable_email_type", "") or "") or self._durable_email_type_for_email(email)
        if _marketing_scan and _dt_for_mkt in ("C", "V") and not sender_looks_automated(
                email.get("sender_email") or email.get("sender", "")):
            _marketing_scan = False
        _proposal = {
            "category": suggested_category, "urgency": suggested_urgency, "status": suggested_status,
            "email_type": email.get("email_type", ""), "sender_type": _resolved_sender_type,
        }
        _floor_notes = self._enforce_relationship_triage_rules(
            email, _proposal, body=body,
            durable_type=str(quick.get("durable_email_type", "") or ""),
            marketing_scan=_marketing_scan,
            learned_junk=bool(quick.get("learned_is_junk", False)),
        )
        suggested_category = _proposal["category"]
        suggested_urgency = _proposal["urgency"]
        suggested_status = _proposal["status"]
        # v4.2.4: the AI path reaches "Needs Reply" by several routes (model output, the
        # Waiting-on-Customer bias correction, same-subject protection). This is where the
        # final value settles, so the do-not-reply clamp goes here, not on each producer.
        suggested_status = self._clamp_status_for_do_not_reply(
            email, suggested_status, where="ai_triage")
        # v4.2.9: this is the path that actually mis-filed the reported row -- the AI
        # typed the sender customer_or_prospect and the customer default put it in the
        # reply queue at 03:00, overwriting what the tracker clear had left.
        suggested_status = self._clamp_status_for_sent_rfq_reply(
            email, suggested_status, where="ai_triage")

        if suggested_category in CATEGORIES and suggested_category != email.get("category"):
            email["category"] = suggested_category
            changed = True
        if suggested_urgency in URGENCY_LEVELS and suggested_urgency != email.get("urgency"):
            email["urgency"] = suggested_urgency
            changed = True
        if suggested_status in STATUSES and suggested_status != email.get("status"):
            if email.get("status") != "Completed" or suggested_status == "Completed":
                email["status"] = suggested_status
                changed = True
        _clamped_email_type = normalize_email_type_code(_proposal.get("email_type"))
        if _clamped_email_type and _clamped_email_type != normalize_email_type_code(email.get("email_type")):
            email["email_type"] = _clamped_email_type  # v4.1.17: e.g. vendor advertising -> M
            changed = True

        email["sender_type"] = _proposal["sender_type"]
        email["sender_intent"] = str(result.get("sender_intent", quick.get("sender_intent", ""))).strip()
        email["business_relevance"] = business_relevance
        email["spam_likelihood"] = spam_likelihood
        email["needs_followup_ai"] = bool(result.get("needs_followup", quick.get("needs_followup", False)))
        email["followup_reason_ai"] = str(result.get("followup_reason", quick.get("followup_reason", ""))).strip()
        email["same_subject_related_count"] = len(related)
        email["ai_triaged_at"] = datetime.now().isoformat()
        email["ai_triage_reason"] = (str(result.get("reason", quick.get("reason", ""))).strip()
                                     + ((" " + " ".join(_floor_notes)) if _floor_notes else "")).strip()
        # v4.2.31: keep a body-less pass QUEUED so it is re-decided once Outlook is free.
        # The row still gets a provisional verdict (better than nothing on screen), but it
        # stays in the triage queue instead of being frozen on a subject-only guess.
        if _blind:
            email["ai_triage_pending"] = True
            email["ai_triage_blind_at"] = datetime.now().isoformat()
            email["ai_triage_reason"] = (email["ai_triage_reason"]
                                         + " PROVISIONAL: the message body was not readable on this"
                                           " pass (Outlook busy); this will be re-triaged.").strip()
            try:
                ops_log("triage", "blind_pass_requeued",
                        eid=str(email.get("entry_id", "") or "")[-16:],
                        subj=str(email.get("subject", "") or "")[:60],
                        status=str(email.get("status", "") or ""))
            except Exception:
                pass
        else:
            email["ai_triage_pending"] = False
            email.pop("ai_triage_blind_at", None)

        if changed:
            self.save_record(email)
            self.flush_status_data()
        self.record_ai_triage_history(email, before={}, after={"category": email.get("category", ""), "urgency": email.get("urgency", ""), "status": email.get("status", ""), "group": self.get_group_id_for_email(email.get("entry_id", ""))}, reason=email.get("ai_triage_reason", ""), source="AI")

        thread_group_id = self.find_group_id_for_thread(email, skip_entry_id=email.get("entry_id", ""))
        if thread_group_id and not self.get_group_id_for_email(email.get("entry_id", "")):
            self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = thread_group_id
            email["thread_group_rule"] = "conversation_or_subject"
            self.mark_group_has_new(thread_group_id)
            self.save_groups()
            self._assistant_log_autogroup(email, thread_group_id,
                reason="Same conversation/subject as an existing grouped email.",
                rule="thread")
            changed = True
            return changed

        pa_group_id = self.auto_assign_pa_template_group(email)
        if pa_group_id:
            self._assistant_log_autogroup(email, pa_group_id,
                reason="Matched the RFQ 'Price and Availability Request - <name>' template for this group.",
                rule="pa_template")
            changed = True
            return changed

        _plugin_active = self._auto_group_engine_active()
        if _plugin_active:
            _plugin_gid = self.auto_assign_plugin_group(email)
            if _plugin_gid:
                changed = True
                return changed
            result = self._apply_plugin_suggestion_to_ai_result(email, result)

        business_group_id = "" if _plugin_active else self.auto_assign_business_key_group(email)
        if business_group_id:
            self._assistant_log_autogroup(email, business_group_id,
                reason="Matched a business key (PO / quote reference) for this group.",
                rule="business_key")
            changed = True
            return changed

        learned_group_rule, learned_group_key = (None, "") if _plugin_active else self.get_group_learning_hint_for_email(email)
        if learned_group_rule and not self.get_group_id_for_email(email.get("entry_id", "")):
            learned_group_id = learned_group_rule.get("group_id", "")
            if self.get_group_by_id(learned_group_id):
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = learned_group_id
                email["learned_group_rule"] = learned_group_key
                self.mark_group_has_new(learned_group_id)
                self.save_groups()
                self._assistant_log_autogroup(email, learned_group_id,
                    reason=f"Learned grouping rule matched ({learned_group_key}).",
                    rule="learned")
                changed = True
                return changed

        # v4.2.32: last RULE before falling back to the AI's guess -- two loose emails
        # sharing an exact job-coded subject inside the window become their own group.
        pair_group_id = self.auto_group_same_subject_pair(email)
        if pair_group_id:
            changed = True
            return changed

        suggested_group_id = str(result.get("suggested_group_id", "")).strip()
        confidence = 0.0
        try:
            confidence = float(result.get("group_confidence", 0) or 0)
        except Exception:
            confidence = 0.0
        group = self.get_group_by_id(suggested_group_id)
        already_grouped = bool(self.get_group_id_for_email(email.get("entry_id", "")))
        # v4.1.35: while an Auto-Group Engine decision is PENDING, the AI suggestion is
        # STORED, never applied -- the deterministic engine must not lose a race to the
        # weaker signal. It replays through this same path if the engine says None.
        if group and not already_grouped and email.get("auto_group_engine_action") == "pending":
            email["pending_group_suggestion"] = {
                "group_id": suggested_group_id, "confidence": confidence,
                "reason": str(result.get("reason", "")).strip(),
                "mode": "assistant", "allow_group_prompt": bool(allow_group_prompt),
            }
            return changed
        assistant = getattr(self, "assistant", None)
        if group and not already_grouped and assistant and assistant.config.enabled:
            # Route grouping through the assistant: it auto-groups when confident
            # and surfaces (asks) when not — replacing the interrupting Yes/No popup.
            rec = assistant.handle(
                kind="Group", stakes=LOW,
                # v4.2.30: an uncorroborated guess collapses to 0.0 -> ASK, not AUTO.
                confidence=self._ai_group_suggestion_confidence(
                    email, suggested_group_id, confidence_from_group(result)),
                subject=email.get("subject", ""),
                sender=email.get("sender", ""),
                summary=f"Add to group '{group.get('name','')}'",
                before={"group": ""},
                after={"group": group.get("name", "")},
                reason=str(result.get("reason", "")).strip(),
                payload={"entry_id": email.get("entry_id", ""), "group_id": suggested_group_id},
                dedup_key=f"group:{email.get('entry_id','')}",
            )
            if rec.get("decision") in (AUTO, REVIEW):
                changed = True
        elif (allow_group_prompt and group and not already_grouped
              and self._ai_group_suggestion_confidence(email, suggested_group_id, confidence)
              >= AI_TRIAGE_GROUP_MIN_CONFIDENCE):
            # Legacy behavior when the assistant is off or unavailable.
            reason = str(result.get("reason", "")).strip()
            prompt = (
                f"AI thinks this email may belong in this group:\n\n"
                f"Group: {group.get('name', '')}\n"
                f"Confidence: {confidence:.0%}\n\n"
                f"Email: {email.get('subject', '')}\n"
                f"Reason: {reason}\n\n"
                f"Add this email to the group?"
            )
            if messagebox.askyesno("AI Group Suggestion", prompt):
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = suggested_group_id
                self.mark_group_has_new(suggested_group_id)
                self.save_groups()
                changed = True
        return changed

    # v4.2.30: how far apart an email and a group's latest activity may be before the
    # material/sender corroboration route stops applying. A job goes quiet; a reply landing
    # a month after everything else on it is not evidence of belonging.
    _AI_GROUP_TIME_WINDOW_DAYS = 30

    def _ai_group_material_signature(self, email):
        """The MATERIAL an email actually names: wire gauges (#12, 12 AWG), conductor sizes
        (350 MCM), trade sizes (3/4"), hyphenated part codes (L14-30, 12/3MC) and material
        nouns from the RFQ vocabulary already used by the extractor's letterhead filter.

        v4.2.30, per Steve: grouping should read subject, time, sender and MATERIAL IN THE
        BODY the way a person does. Only the top of the body is scanned so quoted history
        from an unrelated thread cannot manufacture a match."""
        sig = set()
        try:
            low = ("%s\n%s" % (email.get("subject", "") or "",
                               str(email.get("body", "") or "")[:1500])).lower()
            for m in re.finditer(r"#\s*(\d+(?:/\d+)?)\b", low):
                sig.add("ga#" + m.group(1))
            for m in re.finditer(r"\b(\d+)\s*(?:awg|ga|gauge)\b", low):
                sig.add("ga#" + m.group(1))
            for m in re.finditer(r"\b(\d+)\s*(?:mcm|kcmil)\b", low):
                sig.add("mcm" + m.group(1))
            for m in re.finditer(r"\b(\d+(?:[-/]\d+(?:/\d+)?)?)\s*(?:\"|''|in\b|inch(?:es)?\b)", low):
                sig.add("sz" + m.group(1))
            for w in self._CONTACT_FILTER_MATERIAL_WORDS:
                if re.search(r"\b" + re.escape(w) + r"\b", low):
                    sig.add("m:" + w)
            for m in re.finditer(r"\b(?=[a-z0-9/-]*\d)(?=[a-z0-9/-]*[a-z])"
                                 r"([a-z0-9]+(?:[-/][a-z0-9]+)+)\b", low):
                t = m.group(1)
                if 4 <= len(t) <= 20:
                    sig.add("p:" + t)
        except Exception:
            return set()
        return sig

    def _ai_group_suggestion_is_corroborated(self, email, group_id):
        """Is there DETERMINISTIC evidence that an AI-suggested group is the right one?

        v4.2.30. Every rule-based grouping path demands hard evidence -- exact
        conversation/subject (auto_assign_same_thread_group, which also vetoes on an
        unknown sender domain), a job/PO token (find_group_id_by_business_key), a learned
        rule, or the RFQ template. The AI suggestion path, the WEAKEST signal, demanded
        none: it took the model's self-reported group_confidence at face value and
        auto-filed at >= assistant_low_auto_at (0.75).

        Measured against the real triage host (qwen2.5:14b-instruct-q8_0), asking it to
        place a purchase-order reply: 9 of 9 trials returned a group, 0 of 9 returned the
        empty string the schema allows, every confidence was 0.8-1.0, and every answer was
        wrong -- including with only the 10 active groups listed (nothing truncated) and an
        explicit instruction to leave the field empty when nothing matches. The model will
        not decline, so the caller must.

        Steve's rule, verbatim: "subject / Time / user / material in body just how a human
        assesses and if it can't figure it out then it should not group it." So:

          A. SUBJECT identity is decisive on its own -- same conversation, same normalized
             subject, or a shared job/PO/quote code.
          B. Otherwise MATERIAL, SENDER and TIME must ALL agree: >=2 shared material tokens
             of which at least one is SPECIFIC (a gauge, size or part code -- two emails
             both saying "wire" and "box" is not a match), the sender already writes in
             this group, and the group has been active within _AI_GROUP_TIME_WINDOW_DAYS.
          C. Anything else is "can't figure it out" -> do not group.

        Sender is never proof on its own: a vendor we buy from constantly would otherwise
        match every one of their jobs.

        Returns (ok, why).
        """
        try:
            group = self.get_group_by_id(group_id)
            if not email or not group:
                return False, "no such group"
            if group.get("archived"):
                return False, "group is archived"
            members = [m for m in (self.get_emails_for_group(group_id) or [])
                       if m.get("entry_id", "") != email.get("entry_id", "")]
            if not members:
                return False, "group has no other members to corroborate against"

            # --- A. subject-level identity -------------------------------------------
            conv = str(email.get("conversation_id", "") or "").strip()
            if conv and any(str(m.get("conversation_id", "") or "").strip() == conv for m in members):
                return True, "same conversation as a group member"
            subj = normalize_subject_for_match(email.get("subject", "") or "")
            if subj and any(normalize_subject_for_match(m.get("subject", "") or "") == subj
                            for m in members):
                return True, "same normalized subject as a group member"
            # NOTE: tokens are taken from `members` (which excludes this email), not from
            # _group_tokens_for_group -- that helper reads memberships, so on the replay
            # path an email ALREADY filed into the group would corroborate itself. The
            # harness caught exactly that: Arif's row matched its own PO code p000020934
            # back out of the group it had been wrongly filed into.
            _name_tokens = extract_group_match_tokens(group.get("name", ""))
            _member_tokens = set()
            for _m in members[:12]:
                _member_tokens |= extract_group_match_tokens(_m.get("subject", ""))
            shared_codes = self._group_tokens_for_email(email) & (_name_tokens | _member_tokens)
            if shared_codes:
                return True, "shared job/PO code " + ",".join(sorted(shared_codes))

            # --- B. material + sender + time, all three -------------------------------
            sig = self._ai_group_material_signature(email)
            gsig = set()
            for m in members:
                gsig |= self._ai_group_material_signature(m)
            shared = sig & gsig
            specific = {t for t in shared if not t.startswith("m:")}
            if not (len(shared) >= 2 and specific):
                return False, ("no shared conversation, subject or job code; material overlap "
                               "too weak (%d shared, %d specific)" % (len(shared), len(specific)))
            _dom = get_email_domain(email.get("resolved_sender_smtp", "")
                                    or email.get("sender_email", ""))
            _addr = str(email.get("sender_email", "") or "").strip().lower()
            sender_known = bool(
                (_addr and any(str(m.get("sender_email", "") or "").strip().lower() == _addr
                               for m in members))
                or (_dom and any(_dom == get_email_domain(m.get("resolved_sender_smtp", "")
                                                          or m.get("sender_email", ""))
                                 for m in members)))
            if not sender_known:
                return False, "material overlaps but this sender does not write in this group"
            try:
                _ts = float(email.get("received_timestamp", 0) or 0)
                _newest = max(float(m.get("received_timestamp", 0) or 0) for m in members)
                _recent = bool(_ts and _newest
                               and abs(_ts - _newest) <= self._AI_GROUP_TIME_WINDOW_DAYS * 86400)
            except Exception:
                _recent = False
            if not _recent:
                return False, "material and sender agree but the group has gone quiet"
            return True, ("material %s + known sender + recent activity"
                          % ",".join(sorted(specific)[:4]))
        except Exception:
            return False, "corroboration check failed"

    def _ai_group_suggestion_confidence(self, email, group_id, confidence):
        """v4.2.30: the confidence an AI group suggestion is allowed to carry. Uncorroborated
        suggestions collapse to 0.0 so the assistant classifies them ASK -- surfaced for one
        click, never applied silently. The user approving one still applies normally."""
        ok, why = self._ai_group_suggestion_is_corroborated(email, group_id)
        if ok:
            return confidence
        try:
            ops_log("group", "ai_suggestion_uncorroborated",
                    eid=str((email or {}).get("entry_id", "") or "")[-16:],
                    gid=str(group_id or ""), conf=float(confidence or 0), why=why,
                    subj=str((email or {}).get("subject", "") or "")[:60])
        except Exception:
            pass
        return 0.0

    def _offer_ai_group_suggestion(self, email, suggested_group_id, confidence, reason, allow_group_prompt):
        """v4.1.35: the assistant-group offer, callable from the deferred-replay path.
        Mirrors the inline block in apply_ai_triage_to_email exactly."""
        group = self.get_group_by_id(suggested_group_id)
        if not group or self.get_group_id_for_email(email.get("entry_id", "")):
            return False
        assistant = getattr(self, "assistant", None)
        if assistant and assistant.config.enabled:
            rec = assistant.handle(
                kind="Group", stakes=LOW,
                # v4.2.30: same gate on the deferred-replay path.
                confidence=self._ai_group_suggestion_confidence(email, suggested_group_id, confidence),
                subject=email.get("subject", ""),
                sender=email.get("sender", ""),
                summary=f"Add to group '{group.get('name','')}'",
                before={"group": ""},
                after={"group": group.get("name", "")},
                reason=reason,
                payload={"entry_id": email.get("entry_id", ""), "group_id": suggested_group_id},
                dedup_key=f"group:{email.get('entry_id','')}",
            )
            return rec.get("decision") in (AUTO, REVIEW)
        if (allow_group_prompt
                and self._ai_group_suggestion_confidence(email, suggested_group_id, confidence)
                >= AI_TRIAGE_GROUP_MIN_CONFIDENCE):
            prompt = (
                f"AI thinks this email may belong in this group:\n\n"
                f"Group: {group.get('name', '')}\n"
                f"Confidence: {confidence:.0%}\n\n"
                f"Email: {email.get('subject', '')}\n"
                f"Reason: {reason}\n\n"
                f"Add this email to the group?"
            )
            _ans = messagebox.askyesno("AI Group Suggestion", prompt)
            ops_log("group", "suggestion_answer",
                    eid=str(email.get("entry_id", "") or "")[-16:], gid=str(suggested_group_id or ""),
                    conf=float(confidence or 0), accepted=bool(_ans),
                    subj=str(email.get("subject", "") or ""))
            if _ans:
                self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = suggested_group_id
                self.mark_group_has_new(suggested_group_id)
                self.save_groups()
                return True
        return False

    def handle_new_email_after_import(self, email, silent=False):
        """Run new-email automation without blocking import/refresh.

        v2.2: exact thread grouping first, then same-subject grouping, then spam/sender-intent prefilter,
        then queued AI triage only for messages that still need interpretation.
        """
        if not email:
            return
        if self.workflow_record_is_closed(email) or email.get("closed_guard_applied"):
            email["is_new_import"] = False
            return
        auto_group_id = self.auto_assign_same_thread_group(email)

        # v2.10.6: If this is a meaningful new inbound reply on a thread/group that was
        # previously Low or Completed, wake it back up so it appears as active work again.
        try:
            if self.reactivate_dormant_thread_if_needed(email, body=""):
                auto_group_id = self.get_group_id_for_email(email.get("entry_id", "")) or auto_group_id
        except Exception:
            pass

        if not auto_group_id:
            auto_group_id = self.auto_assign_pa_template_group(email)
        _plugin_active = self._auto_group_engine_active()
        if not auto_group_id and _plugin_active:
            auto_group_id = self.auto_assign_plugin_group(email)
        if not auto_group_id and not _plugin_active:
            auto_group_id = self.auto_assign_business_key_group(email)
        if not auto_group_id and not _plugin_active:
            auto_group_id = self.auto_assign_learned_group(email)
        if not auto_group_id and not _plugin_active:
            auto_group_id = self.auto_assign_same_subject_group(email)
        if auto_group_id:
            group = self.get_group_by_id(auto_group_id)
            if group:
                self.ai_status_var.set(f"Group: related email added to {group.get('name', '')}")

        # Very fast subject/sender-only prefilter so newsletters/system emails do not become follow-ups.
        try:
            quick_result = self.apply_quick_sender_intent(email, body="")
            if isinstance(quick_result, tuple):
                quick, quick_changed = quick_result
            else:
                quick, quick_changed = quick_result, False
            if quick_changed:
                if getattr(self, "_commitment_batch", 0):
                    # Bulk import in progress: defer the heavy writes + renders to the
                    # single flush/render the refresh orchestrator does at the end.
                    self._commitment_batch_cache_dirty = True
                    self._commitment_batch_status_dirty = True
                else:
                    self.flush_status_data()
                    self.save_cached_state()
                    self.render_email_rows()
                    self.render_group_rows()
            if quick.get("hard_decision"):
                return
        except Exception:
            pass

        # Quick subject-only scenario check must pass follow-up gates.
        try:
            quick = quick_sender_intent_analysis(
                email.get("subject", ""),
                email.get("sender_email") or email.get("sender", ""),
                "",
                related_count=int(email.get("same_subject_related_count", 0) or 0),
                source=email.get("source", "")
            )
            allowed, _why = should_allow_followup_decision(email, quick_result=quick)
            if allowed and text_mentions_po_or_order(email.get("subject", "")):
                if self.schedule_po_order_followup_if_needed(email, triage_result=quick, quick_result=quick):
                    self.followup_status_var.set(f"Follow-ups: PO/order draft scheduled for {CUSTOMER_PO_FOLLOWUP_MINUTES} min")
        except Exception:
            pass

        # v3.9.79: never re-triage (or even re-queue) an email the user already locked. The drip's
        # candidate gate already skips locked rows, but this direct new-import triage call bypasses
        # that gate, so a re-imported locked email could be AI-reclassified here. A close trigger is
        # the only sanctioned override of a user-set workflow.
        if AI_TRIAGE_ENABLED and not email.get("ai_user_locked"):
            email["ai_triage_pending"] = True
            if not silent:
                self.start_ai_triage_for_emails([email], task_name="triaging new email", allow_group_prompt=not bool(auto_group_id))

    def group_filter_allows_email(self, email):
        entry_id = email.get("entry_id", "")
        group_id = self.get_group_id_for_email(entry_id)

        # Archived groups should stay out of the main email window.
        # Their emails remain saved in MaINbox and can be viewed/restored from Archived Groups.
        if group_id:
            group = self.get_group_by_id(group_id)
            if group and group.get("archived", False):
                return False

        if self.active_group_filter == "all":
            return True
        if self.active_group_filter == "ungrouped":
            return not group_id
        return group_id == self.active_group_filter

    def render_group_rows(self):
        if not hasattr(self, "groups_tree"):
            return
        selected = self.groups_tree.selection()
        selected_iid = selected[0] if selected else ""
        self.groups_tree.delete(*self.groups_tree.get_children())

        total_grouped = len([eid for eid, gid in self.groups_data.get("memberships", {}).items() if self.get_group_by_id(gid)])
        all_iid = "filter:all"
        ungrouped_iid = "filter:ungrouped"
        ungrouped_count = len([email for email in self.emails if not self.get_group_id_for_email(email.get("entry_id", ""))])
        self.groups_tree.insert("", "end", iid=all_iid, text="All Emails", values=("", len(self.emails)), open=True)
        self.groups_tree.insert("", "end", iid=ungrouped_iid, text="Ungrouped", values=("", ungrouped_count), open=True)

        urgency_order = {"Critical": 0, "High": 1, "Normal": 2, "Low": 3}
        visible_groups = [g for g in self.groups_data.get("groups", []) if not g.get("archived", False)]
        sorted_groups = sorted(
            visible_groups,
            key=lambda g: (urgency_order.get(g.get("urgency", "Normal"), 2), str(g.get("name", "")).lower())
        )
        _seen_group_iids = set()
        # v4.1.10 efficiency: build group_id -> members ONCE (same idiom as
        # render_email_rows) instead of re-scanning every email for every group.
        _members_by_gid = {}
        for _email in self.emails:
            try:
                _gid = self.get_group_id_for_email(_email.get("entry_id", ""))
                if _gid:
                    _members_by_gid.setdefault(_gid, []).append(_email)
            except Exception:
                pass
        for group in sorted_groups:
            group_id = group.get("id", "")
            if not group_id:
                continue
            iid = f"group:{group_id}"
            # v4.1.10: never let a duplicate group id abort the whole startup render. A
            # collision here used to raise TclError('... already exists') mid-way through
            # load_cached_state, leaving the window half-built and the splash hung forever.
            if iid in _seen_group_iids or self.groups_tree.exists(iid):
                continue
            _seen_group_iids.add(iid)
            members = _members_by_gid.get(group_id, [])
            is_open = not bool(group.get("collapsed", False))
            urgency = group.get("urgency", "Normal")
            tags = ("group_new",) if group.get("has_new") else ()
            label = group.get("name", "Untitled Group")
            if group.get("has_new"):
                label = f"● {label}"
            self.groups_tree.insert("", "end", iid=iid, text=label, values=(urgency, len(members)), open=is_open, tags=tags)
            for email in members:
                child_iid = f"member:{group_id}:{email.get('entry_id', '')}"
                if self.groups_tree.exists(child_iid):
                    continue
                label = f"{email.get('sender', '')} — {email.get('subject', '')}"
                self.groups_tree.insert(iid, "end", iid=child_iid, text=label[:120], values=("", email.get("received", "")))

        if selected_iid and self.groups_tree.exists(selected_iid):
            self.groups_tree.selection_set(selected_iid)

    def selected_group_id_from_groups_tree(self):
        selected = self.groups_tree.selection() if hasattr(self, "groups_tree") else []
        if not selected:
            return ""
        iid = selected[0]
        if iid.startswith("group:"):
            return iid.split(":", 1)[1]
        if iid.startswith("member:"):
            parts = iid.split(":", 2)
            return parts[1] if len(parts) > 1 else ""
        return ""

    def choose_group_urgency(self, title="Group Urgency", initial="Normal"):
        win = tk.Toplevel(self.root)
        win.title(title)
        remember_window_geometry(win, title, "360x190")
        win.resizable(False, False)
        win.transient(self.root)
        self.safe_grab_set(win)
        tk.Label(win, text="Select group urgency", font=("Segoe UI", 13, "bold")).pack(pady=12)
        urgency_var = tk.StringVar(value=initial if initial in URGENCY_LEVELS else "Normal")
        box = ttk.Combobox(win, textvariable=urgency_var, values=URGENCY_LEVELS, state="readonly", width=18)
        box.pack(pady=8)
        result = {"value": None}
        def save():
            result["value"] = urgency_var.get() or "Normal"
            win.destroy()
        def cancel():
            win.destroy()
        btns = tk.Frame(win)
        btns.pack(pady=12)
        tk.Button(btns, text="Save", command=save, width=12).pack(side="left", padx=6)
        tk.Button(btns, text="Cancel", command=cancel, width=12).pack(side="left", padx=6)
        win.wait_window()
        return result["value"]

    def offer_group_for_single_email_rfq(self, group_id, emails):
        """v3.9.22: After an RFQ is sent from the right-click (single-email) path, the email
        has only a transient 'single_email_rfq:<entry_id>' id and no real group. Offer to
        create a real group (with the original request email in it) so vendor replies stay
        organized. No-ops for real groups so an RFQ that already has one is never duplicated.
        Fully guarded; never raises."""
        try:
            gid = str(group_id or "")
            if not gid.startswith("single_email_rfq:"):
                return  # real group already exists -- do not create a duplicate
            source_entry_id = gid.split("single_email_rfq:", 1)[1].strip()
            if not source_entry_id:
                return
            if not messagebox.askyesno(
                "Organize RFQ",
                "Create a group for this RFQ so the original request and the vendor replies stay together?"
            ):
                return
            default_name = ""
            try:
                src = next((e for e in (emails or []) if e.get("entry_id") == source_entry_id), None)
                if src:
                    default_name = (src.get("subject") or "").strip()[:80]
            except Exception:
                default_name = ""
            name = simpledialog.askstring("New Group", "Group name / quote job name:",
                                          initialvalue=default_name, parent=self.root)
            if not name or not name.strip():
                return
            name = name.strip()
            urgency = self.choose_group_urgency("New Group Urgency", initial="Normal")
            if not urgency:
                return
            new_group_id = self._unique_group_id()  # v4.1.10: collision-proof
            self.groups_data.setdefault("groups", []).append({
                "id": new_group_id, "name": name, "urgency": urgency, "collapsed": False,
                "has_new": False, "created_at": datetime.now().isoformat(), "notes": "", "archived": False})
            self.groups_data.setdefault("memberships", {})[source_entry_id] = new_group_id
            self.save_groups()
            try:
                self.active_group_filter = "all"
                self.render_group_rows()
                self.sort_emails_for_display()
                self.render_email_rows()
            except Exception:
                pass
            try:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, f"Created {urgency} group: {name}\n\nThe original quote email is now in this group. Vendor replies on this RFQ will group here.")
            except Exception:
                pass
        except Exception:
            pass

    def create_group(self):
        name = simpledialog.askstring("New Group", "Group name / quote job name:", parent=self.root)
        if not name:
            return
        name = name.strip()
        if not name:
            return
        urgency = self.choose_group_urgency("New Group Urgency", initial="Normal")
        if not urgency:
            return
        group_id = self._unique_group_id()  # v4.1.10: collision-proof
        self.groups_data.setdefault("groups", []).append({"id": group_id, "name": name, "urgency": urgency, "collapsed": False, "has_new": False, "created_at": datetime.now().isoformat(), "notes": "", "archived": False})
        self.save_groups()
        self.active_group_filter = "all"
        self.render_group_rows()
        if self.groups_tree.exists(f"group:{group_id}"):
            self.groups_tree.selection_set(f"group:{group_id}")
        self.sort_emails_for_display()
        self.render_email_rows()
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Created {urgency} group: {name}\n\nThis group now appears at the top of its urgency section. Drag emails into it or select emails and click Add Selected.")

    def rename_selected_group(self):
        group_id = self.selected_group_id_from_groups_tree()
        group = self.get_group_by_id(group_id)
        if not group:
            messagebox.showwarning("No Group Selected", "Select a group first.")
            return
        new_name = simpledialog.askstring("Rename Group", "New group name:", initialvalue=group.get("name", ""), parent=self.root)
        if not new_name:
            return
        group["name"] = new_name.strip()
        self.save_groups()
        self.render_group_rows()
        self.render_email_rows()

    def set_selected_group_urgency(self):
        group_id = self.selected_group_id_from_groups_tree()
        group = self.get_group_by_id(group_id)
        if not group:
            messagebox.showwarning("No Group Selected", "Select a group first.")
            return
        urgency = self.choose_group_urgency("Set Group Urgency", initial=group.get("urgency", "Normal"))
        if not urgency:
            return
        group["urgency"] = urgency
        self.save_groups()
        self.render_group_rows()
        self.render_email_rows()
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Group urgency updated to {urgency}: {group.get('name', '')}")

    def _collect_group_trackers(self, emails):
        """v4.2.16: the sent-waiting placeholders belonging to a group's threads.

        perform_app_delete already clears a placeholder whose OWN entry_id is being
        deleted, but a tracker for a group thread is a separate row keyed 'sentwait:...'
        -- it matches on conversation, not on the email's entry_id. Without this, deleting
        a group's mail leaves its trackers behind: reported live, where 5 MBTEST trackers
        survived a bulk delete and kept inflating the active count (13 shown, 8 real)."""
        convs = {str(e.get("conversation_id", "") or "") for e in emails if isinstance(e, dict)}
        convs.discard("")
        eids = {str(e.get("entry_id", "") or "") for e in emails if isinstance(e, dict)}
        eids.discard("")
        out = []
        for ph in (getattr(self, "sent_waiting_placeholders", []) or []):
            if not isinstance(ph, dict) or ph.get("cleared"):
                continue
            if (str(ph.get("conversation_id", "") or "") in convs
                    or str(ph.get("tracked_entry_id", "") or "") in eids
                    or str(ph.get("entry_id", "") or "") in eids):
                out.append(ph)
        return out

    def _ask_delete_group_scope(self, group_name, n_emails, n_trackers, members=None):
        """Three-way choice. Returns 'all', 'group' or 'cancel'.
        v4.2.51 (Steve): the confirmation now LISTS the member emails, not just a
        count -- a mis-filed email (Lucy's Welsbach PO died inside a Burndy
        group's scope-all delete) must jump out BEFORE the delete. Enter picks
        the safe default (Just the group), Escape cancels."""
        result = {"choice": "cancel"}
        try:
            dialog = tk.Toplevel(self.root)
            dialog.title("Delete Group")
            dialog.transient(self.root)
            dialog.resizable(False, False)
            tk.Label(dialog, text=f"Delete group '{group_name}'?",
                     font=("Segoe UI", 11, "bold"), justify="left").pack(
                         anchor="w", padx=14, pady=(14, 4))
            tk.Label(dialog,
                     text=("This group holds %d email(s) and %d active tracker(s).\n\n"
                           "Outlook is never touched. Deleted emails go to Deleted History\n"
                           "and can be restored, and Ctrl+Z undoes the whole action."
                           % (n_emails, n_trackers)),
                     justify="left").pack(anchor="w", padx=14, pady=(0, 6))
            rows = [m for m in (members or []) if isinstance(m, dict)]
            if rows:
                tk.Label(dialog, text="Emails in this group ('all' deletes every one of these):",
                         font=("Segoe UI", 9, "bold"), justify="left").pack(anchor="w", padx=14)
                lst_frame = tk.Frame(dialog)
                lst_frame.pack(fill="both", expand=True, padx=14, pady=(2, 8))
                lst = tk.Listbox(lst_frame, width=92, height=min(10, max(3, len(rows))),
                                 activestyle="none")
                sb = ttk.Scrollbar(lst_frame, orient="vertical", command=lst.yview)
                lst.configure(yscrollcommand=sb.set)
                sb.pack(side="right", fill="y")
                lst.pack(side="left", fill="both", expand=True)
                for m in rows[:300]:
                    sender = str(m.get("sender", "") or m.get("sender_email", "") or "?")[:28]
                    lst.insert(tk.END, f"{str(m.get('received', '') or ''):<18} {sender:<28} {str(m.get('subject', '') or '')[:60]}")
                if len(rows) > 300:
                    lst.insert(tk.END, f"... and {len(rows) - 300} more")

            def choose(v):
                result["choice"] = v
                dialog.destroy()

            btns = tk.Frame(dialog)
            btns.pack(fill="x", padx=12, pady=(0, 12))
            tk.Button(btns, text="Delete group + all emails and trackers",
                      command=lambda: choose("all"), width=34).pack(side="left", padx=4)
            just_btn = tk.Button(btns, text="Just the group",
                                 command=lambda: choose("group"), width=16)
            just_btn.pack(side="left", padx=4)
            tk.Button(btns, text="Cancel",
                      command=lambda: choose("cancel"), width=10).pack(side="right", padx=4)
            dialog.protocol("WM_DELETE_WINDOW", lambda: choose("cancel"))
            dialog.bind("<Return>", lambda e: choose("group"))
            dialog.bind("<Escape>", lambda e: choose("cancel"))
            try:
                just_btn.focus_set()
            except Exception:
                pass
            self.safe_grab_set(dialog)
            self.root.wait_window(dialog)
        except Exception:
            return "cancel"
        return result.get("choice", "cancel")

    def delete_selected_group(self):
        group_id = self.selected_group_id_from_groups_tree()
        group = self.get_group_by_id(group_id)
        if not group:
            messagebox.showwarning("No Group Selected", "Select a group first.")
            return
        gname = group.get("name", "")
        members = [e for e in (self.get_emails_for_group(group_id) or []) if isinstance(e, dict)]
        trackers = self._collect_group_trackers(members)
        # v4.2.16: deleting a group used to only drop the memberships, so its mail fell
        # back into the ungrouped pile and had to be hunted down and deleted by hand.
        # The three-way choice keeps the old behaviour available, because auto-grouping
        # sometimes builds a WRONG group and there the mail must survive.
        choice = self._ask_delete_group_scope(gname, len(members), len(trackers), members=members)
        if choice == "cancel":
            return
        removed = cleared = 0
        if choice == "all":
            # perform_app_delete takes its own undo snapshot FIRST, so that one snapshot
            # predates every mutation here and a single Ctrl+Z restores mail, trackers,
            # memberships and the group together.
            if members:
                try:
                    removed, _kept, _cancelled = self.perform_app_delete(members, "cancel")
                except Exception:
                    removed = 0
            else:
                self.save_undo_state("delete group")
            _now = datetime.now().isoformat()
            for ph in trackers:
                ph["cleared"] = True
                ph["cleared_at"] = _now
                ph["cleared_reason"] = "group_deleted"
                cleared += 1
            if cleared:
                try:
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
        else:
            # v4.2.16: this path never took an undo snapshot at all -- unlike
            # archive_selected_group and assign_emails_to_group, which both do.
            self.save_undo_state("delete group")
        self.groups_data["groups"] = [g for g in self.groups_data.get("groups", []) if g.get("id") != group_id]
        self.groups_data["memberships"] = {eid: gid for eid, gid in self.groups_data.get("memberships", {}).items() if gid != group_id}
        if self.active_group_filter == group_id:
            self.active_group_filter = "all"
        self.save_groups()
        self.render_group_rows()
        self.render_email_rows()
        try:
            ops_log("group", "group_deleted", gname=str(gname)[:40], scope=choice,
                    members=len(members), emails_deleted=removed, trackers_cleared=cleared)
        except Exception:
            pass
        if choice == "all":
            messagebox.showinfo(
                "Group Deleted",
                "Deleted group '%s'.\n\n%d email(s) moved to Deleted History.\n"
                "%d tracker(s) cleared.\n\nOutlook was not touched. Ctrl+Z undoes this."
                % (gname, removed, cleared))

    def assign_emails_to_group(self, emails, group_id):
        group = self.get_group_by_id(group_id)
        if not group or not emails:
            return 0
        self.save_undo_state("add email(s) to group")
        count = 0
        memberships = self.groups_data.setdefault("memberships", {})
        for email in emails:
            entry_id = email.get("entry_id", "")
            if entry_id:
                previous_group_id = memberships.get(entry_id, "")
                memberships[entry_id] = group_id
                count += 1
                if previous_group_id != group_id:
                    self.learn_group_from_user_move(email, group_id, previous_group_id)
        self.save_groups()
        self.render_group_rows()
        self.render_email_rows()
        self.preview_text.delete("1.0", tk.END)
        quote_like = any((e.get("category") == "Quote / Estimate" or contains_any_phrase((e.get("subject", "") + "\n" + e.get("body", "")), CUSTOMER_REQUEST_PHRASES)) for e in emails)
        msg = f"Added {count} email(s) to {group.get('urgency', 'Normal')} group: {group.get('name', '')}"
        if quote_like:
            msg += "\n\nQuote Intelligence is available for this group. Select the group and click Quote RFQ to scan materials/attachments and build vendor request drafts."
        self.preview_text.insert(tk.END, msg)
        return count

    def add_selected_emails_to_selected_group(self):
        group_id = self.selected_group_id_from_groups_tree()
        if not group_id:
            messagebox.showwarning("No Group Selected", "Please select group from below")
            return
        emails = self.get_selected_emails()
        self.assign_emails_to_group(emails, group_id)


    def get_emails_for_group(self, group_id):
        # v2.9.8: direct single-email RFQ support. Return the selected email for
        # temporary RFQ groups without creating a visible/saved group.
        try:
            temp_groups = getattr(self, "_single_email_rfq_groups", {}) or {}
            if group_id in temp_groups:
                email = temp_groups[group_id].get("email")
                return [email] if email else []
        except Exception:
            pass
        return [
            email for email in self.emails
            if self.get_group_id_for_email(email.get("entry_id", "")) == group_id
        ]

    def _collect_thread_emails(self, anchor_eid, group_id=""):
        """Collect EVERY loaded email in one thread -- not just the ones already
        filed into a group. Cleanup used to walk group membership only, so an
        untriaged/ungrouped sibling (status still "New", sitting in the Sales/drip
        queue) was skipped: e.g. the original "Square d panel..." request while its
        two "RE:" replies were grouped and handled (only 2 of 3 of the thread got
        touched). This is the union of three nets, deduped by entry_id:
          1. current group members (if grouped),
          2. same Outlook conversation_id as the anchor (exact thread identity),
          3. same normalized subject AND same sender as the anchor -- catches an
             ungrouped sibling whose conversation_id differs/is missing. The sender
             gate (SMTP or display name) keeps a coincidental same-subject email
             from another party out, and a blank/too-generic subject is skipped.
        """
        out = {}
        anchor = self.get_email_by_id(anchor_eid) if anchor_eid else None
        if anchor and anchor.get("entry_id"):
            out[anchor.get("entry_id", "")] = anchor
        if group_id and self.get_group_by_id(group_id):
            for e in self.get_emails_for_group(group_id):
                if e and e.get("entry_id"):
                    out[e.get("entry_id", "")] = e
        a_conv = str((anchor or {}).get("conversation_id", "") or "").strip()
        a_subj = normalize_subject_for_match((anchor or {}).get("subject", "") or "")
        a_se = str((anchor or {}).get("sender_email", "") or "").strip().lower()
        a_sn = str((anchor or {}).get("sender", "") or "").strip().lower()
        subj_ok = len(a_subj) >= 6
        for e in self.emails:
            if not isinstance(e, dict):
                continue
            eid = e.get("entry_id", "")
            if not eid or eid in out:
                continue
            if a_conv and str(e.get("conversation_id", "") or "").strip() == a_conv:
                out[eid] = e
                continue
            if subj_ok and normalize_subject_for_match(e.get("subject", "") or "") == a_subj:
                e_se = str(e.get("sender_email", "") or "").strip().lower()
                e_sn = str(e.get("sender", "") or "").strip().lower()
                if (a_se and e_se and a_se == e_se) or (a_sn and e_sn and a_sn == e_sn):
                    out[eid] = e
        return [e for e in out.values() if e]

    def build_basic_group_summary(self, group, emails):
        waiting_vendor = len([e for e in emails if e.get("status") == "Waiting on Vendor"])
        waiting_customer = len([e for e in emails if e.get("status") == "Waiting on Customer"])
        needs_reply = len([e for e in emails if e.get("status") == "Needs Reply"])
        high_count = len([e for e in emails if e.get("urgency") in ["High", "Critical"]])
        latest = sorted(emails, key=lambda e: e.get("received_timestamp", 0), reverse=True)[:5]
        recent_lines = []
        for e in latest:
            recent_lines.append(f"- {e.get('received', '')} | {e.get('sender', '')} | {e.get('subject', '')}")
        return (
            f"PROJECT SUMMARY\n"
            f"Group: {group.get('name', '')}\n"
            f"Urgency: {group.get('urgency', 'Normal')}\n"
            f"Emails in group: {len(emails)}\n\n"
            f"CURRENT STATUS\n"
            f"Needs Reply: {needs_reply}\n"
            f"Waiting on Vendor: {waiting_vendor}\n"
            f"Waiting on Customer: {waiting_customer}\n"
            f"High/Critical Emails: {high_count}\n\n"
            f"RECENT ACTIVITY\n" + ("\n".join(recent_lines) if recent_lines else "No recent emails found.") + "\n\n"
            f"RECOMMENDED NEXT ACTIONS\n"
            f"Review the newest emails above, update statuses, and follow up on anything marked Needs Reply or Waiting on Vendor."
        )

    def generate_selected_group_summary(self):
        group_id = self.selected_group_id_from_groups_tree()
        group = self.get_group_by_id(group_id)
        if not group:
            messagebox.showwarning("No Group Selected", "Select a quote/job group first.")
            return
        emails = self.get_emails_for_group(group_id)
        if not emails:
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, f"Group has no emails yet: {group.get('name', '')}")
            return

        group_snapshot = dict(group)
        sorted_emails = sorted(emails, key=lambda e: e.get("received_timestamp", 0), reverse=True)

        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(
            tk.END,
            f"Generating AI project summary for: {group.get('name', '')}\n\n"
            "Loading grouped email bodies into local cache, then summarizing in the background..."
        )

        # Load bodies first from the UI button path, then send the cached data to the worker.
        for email in sorted_emails[:AI_GROUP_SUMMARY_MAX_EMAILS]:
            try:
                self.load_body_if_needed(email)
            except Exception:
                pass
        self.save_cached_state()

        def worker(cancel_event):
            if cancel_event.is_set():
                return {"cancelled": True}
            summary = ask_ollama_for_group_summary(
                group_name=group_snapshot.get("name", ""),
                group_urgency=group_snapshot.get("urgency", "Normal"),
                emails=sorted_emails
            )
            source = "Ollama"
            if not summary:
                summary = self.build_basic_group_summary(group_snapshot, sorted_emails)
                source = "fallback"
            return {"cancelled": False, "summary": summary, "source": source}

        def success(result):
            if result.get("cancelled"):
                self.ai_status_var.set("AI: summary cancelled")
                return
            summary = result.get("summary") or self.build_basic_group_summary(group_snapshot, sorted_emails)
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(
                tk.END,
                f"AI PROJECT SUMMARY — {group_snapshot.get('name', '')}\n"
                f"Urgency: {group_snapshot.get('urgency', 'Normal')} | Emails: {len(emails)}\n"
                f"Generated: {datetime.now().strftime('%m/%d/%Y %I:%M %p')}\n"
                f"Source: {result.get('source', 'fallback')}\n\n"
                f"{summary}"
            )
            self.ai_status_var.set("AI: group summary ready" if result.get("source") == "Ollama" else "AI: summary fallback")

        def error(exc, tb):
            summary = self.build_basic_group_summary(group_snapshot, sorted_emails)
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(
                tk.END,
                f"PROJECT SUMMARY — {group_snapshot.get('name', '')}\n"
                f"Generated with fallback because AI failed.\n\n{summary}\n\nError:\n{exc}"
            )
            self.ai_status_var.set("AI: summary fallback after error")

        self.start_ai_task("summarizing group", worker, success, error)

    def remove_selected_emails_from_group(self):
        selected_emails = self.get_selected_emails(show_warning=False)
        removed = 0
        if selected_emails:
            for email in selected_emails:
                entry_id = email.get("entry_id", "")
                if entry_id in self.groups_data.get("memberships", {}):
                    self.groups_data["memberships"].pop(entry_id, None)
                    removed += 1
        else:
            selected = self.groups_tree.selection() if hasattr(self, "groups_tree") else []
            if selected and selected[0].startswith("member:"):
                entry_id = selected[0].split(":", 2)[2]
                if entry_id in self.groups_data.get("memberships", {}):
                    self.groups_data["memberships"].pop(entry_id, None)
                    removed += 1
        self.save_groups()
        self.render_group_rows()
        self.render_email_rows()
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Removed {removed} email(s) from groups.")

