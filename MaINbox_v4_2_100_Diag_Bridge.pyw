    merged["rfq_use_smartscan"] = bool(merged.get("rfq_use_smartscan", RFQ_USE_SMARTSCAN_FOR_RFQ))
    profile = str(merged.get("ai_learning_profile", "balanced") or "balanced").strip().lower()
