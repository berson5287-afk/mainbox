        return "break"

    def followup_minutes_from_choice(self, choice):
        raw = (choice or "").strip().lower()
        if not raw or raw in ["default", "use default", "use status/ai"]:
            return None
        mapping = {
            "1 minute": 1, "5 minutes": 5, "15 minutes": 15, "30 minutes": 30,
            "1 hour": 60, "2 hours": 120, "4 hours": 240,
            "tomorrow": 24 * 60, "3 days": 3 * 24 * 60, "1 week": 7 * 24 * 60,
        }
        if raw in mapping:
            return mapping[raw]
        m = re.match(r"^(\d+)\s*(m|min|mins|minute|minutes)$", raw)
        if m:
            return int(m.group(1))
        m = re.match(r"^(\d+)\s*(h|hr|hrs|hour|hours)$", raw)
        if m:
            return int(m.group(1)) * 60
        if raw.isdigit():
            return int(raw)
        return None

