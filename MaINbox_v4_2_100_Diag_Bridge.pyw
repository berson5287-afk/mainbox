    return None


def _rfq_clean_ai_material_rows(obj, source_name="", source_prefix="vision"):
    if not isinstance(obj, dict) or not isinstance(obj.get("materials"), list):
        return []
    cleaned = []
    seen = set()
    for item in obj.get("materials", [])[:260]:
        if not isinstance(item, dict):
            continue
        part = str(item.get("part_number", "") or "").strip().upper()
        desc = re.sub(r"\s+", " ", str(item.get("description", "") or "").strip())
        qty = str(item.get("qty", "") or item.get("quantity", "") or "").strip()
        unit = str(item.get("unit", "") or "").strip()
        if not part and not desc:
            continue
        if desc.lower() in ["emt", "pvc", "wire", "conduit"] and not qty and not part:
            continue
        key = normalize_material_key(part, desc)
        if key in seen:
            continue
        seen.add(key)
        # v2.10.50: keep source-linking fields from vision/parser output so the RFQ
        # review pane can highlight the original document location for each extracted row.
        source_text = str(item.get("source_text", "") or item.get("raw_line", "") or item.get("line_text", "") or "").strip()
        bbox = item.get("source_bbox_pct", item.get("bbox_pct", item.get("bbox", item.get("box", ""))))
        cleaned.append({
            "qty": qty,
            "unit": unit,
            "part_number": part,
            "description": desc,
            "manufacturer": str(item.get("manufacturer", "") or "").strip(),
            "notes": str(item.get("notes", "") or "").strip(),
            "source": f"{source_prefix}:{source_name}",
            "source_page": str(item.get("source_page", "") or item.get("page", "") or "").strip(),
            "source_text": source_text,
            "source_bbox_pct": bbox,
        })
    return normalize_material_items(cleaned)


def _safe_debug_name(text):
    return safe_filename_piece(str(text or "debug"), "debug")[:80]

def _rfq_debug_write(filename, data, binary=False):
    if not RFQ_DEBUG_ATTACHMENTS:
        return ""
    try:
        os.makedirs(RFQ_DEBUG_DIR, exist_ok=True)
        path = os.path.join(RFQ_DEBUG_DIR, _safe_debug_name(filename))
        mode = "wb" if binary else "w"
        kwargs = {} if binary else {"encoding": "utf-8", "errors": "ignore"}
        with open(path, mode, **kwargs) as f:
            f.write(data)
        return path
    except Exception:
        return ""



def _rfq_render_pdf_first_page_to_png(pdf_path, out_name):
    """Render the first page of a PDF to a PNG in the RFQ debug folder."""
    try:
        import fitz
        doc = fitz.open(pdf_path)
        if len(doc) < 1:
            try:
                doc.close()
            except Exception:
                pass
            return ""
        page = doc.load_page(0)
        pix = page.get_pixmap(matrix=fitz.Matrix(2.0, 2.0), alpha=False)
        img_bytes = pix.tobytes("png")
        try:
            doc.close()
        except Exception:
            pass
        return _rfq_debug_write(out_name, img_bytes, binary=True)
    except Exception:
        return ""


def create_rfq_spreadsheet_preview_image(path, source_name=""):
    """Create a screenshot-style PNG preview of the first spreadsheet page/sheet.

    Preferred route on Windows is Excel's own PDF export so the preview matches what the
    user sees in Excel.  Fallback route draws the first rows/cells into a simple image so
    Scan Output still shows the original source rows instead of duplicating extracted rows.
    """
    source_name = source_name or os.path.basename(str(path or "spreadsheet"))
    base = _safe_debug_name(f"spreadsheet_preview_{os.path.splitext(source_name)[0]}")[:120]
    ext = os.path.splitext(str(path or ""))[1].lower()

    # Route 1: Excel COM export -> PDF -> PNG. This preserves merged cells, fonts, and layout.
    try:
        if ext in [".xls", ".xlsx", ".xlsm", ".xlsb"] and win32com is not None:
            excel = None
            wb = None
            try:
                excel = win32com.client.DispatchEx("Excel.Application")
                excel.Visible = False
                excel.DisplayAlerts = False
                # v4.1.19 AUDIT FIX (finding #6): these are UNTRUSTED inbound email
                # attachments -- force-disable macros/events/link updates before opening.
                try:
                    excel.AutomationSecurity = 3  # msoAutomationSecurityForceDisable
                except Exception:
                    pass
                try:
                    excel.EnableEvents = False
                    excel.AskToUpdateLinks = False
                except Exception:
                    pass
                wb = excel.Workbooks.Open(os.path.abspath(path), ReadOnly=True, UpdateLinks=0)
                ws = wb.Worksheets(1)
                try:
                    ws.PageSetup.Zoom = False
                    ws.PageSetup.FitToPagesWide = 1
                    ws.PageSetup.FitToPagesTall = False
                except Exception:
                    pass
                pdf_path = os.path.join(RFQ_DEBUG_DIR, base + ".pdf")
                ws.ExportAsFixedFormat(0, pdf_path)
                try:
                    wb.Close(False)
                except Exception:
                    pass
                try:
                    excel.Quit()
                except Exception:
                    pass
                png_path = _rfq_render_pdf_first_page_to_png(pdf_path, base + ".png")
                if png_path:
                    return png_path
            except Exception:
                try:
                    if wb is not None:
                        wb.Close(False)
                except Exception:
                    pass
                try:
                    if excel is not None:
                        excel.Quit()
                except Exception:
                    pass
    except Exception:
        pass

    # Route 2: draw a quick screenshot-style table preview from CSV/XLSX data.
    try:
        from PIL import Image, ImageDraw, ImageFont
        rows = []
        if ext == ".csv":
            import csv
            with open(path, "r", encoding="utf-8", errors="ignore", newline="") as f:
                for row in csv.reader(f):
                    rows.append([str(c or "") for c in row[:12]])
                    if len(rows) >= 80:
                        break
        elif ext in [".xlsx", ".xlsm"]:
            try:
                import openpyxl
                wb = openpyxl.load_workbook(path, data_only=True, read_only=True)
                ws = wb.active
                for row in ws.iter_rows(max_row=80, max_col=12, values_only=True):
                    rows.append([str(c or "") if c is not None else "" for c in row])
                try:
                    wb.close()
                except Exception:
                    pass
            except Exception:
                rows = []
        if not rows:
            return ""
        font = ImageFont.load_default()
        col_w = []
        col_count = max(len(r) for r in rows) if rows else 1
        for c in range(col_count):
            max_len = max([len(r[c]) if c < len(r) else 0 for r in rows] + [4])
            col_w.append(max(70, min(260, max_len * 7 + 18)))
        row_h = 24
        w = max(500, min(2200, sum(col_w) + 30))
        h = max(320, min(2400, row_h * len(rows) + 40))
        img = Image.new("RGB", (w, h), "white")
        draw = ImageDraw.Draw(img)
        y = 20
        for r_i, row in enumerate(rows):
            x = 10
            fill = "#f2f2f2" if r_i == 0 else "white"
            for c_i in range(col_count):
                cw = col_w[c_i]
                draw.rectangle([x, y, x + cw, y + row_h], outline="#999999", fill=fill)
                val = row[c_i] if c_i < len(row) else ""
                draw.text((x + 4, y + 6), str(val)[:45], fill="black", font=font)
                x += cw
                if x > w:
                    break
            y += row_h
            if y > h - 20:
                break
        out_path = os.path.join(RFQ_DEBUG_DIR, base + ".png")
        img.save(out_path)
        return out_path
    except Exception:
        return ""

def _ollama_extract_materials_from_image_b64(image_b64, source_name="", page_label=""):
    """Send one PDF-rendered page/image directly to a vision-capable Ollama model."""
    if not OLLAMA_ENABLED:
        return None, "vision skipped: Ollama disabled"
    prompt = f"""
You are reading an RFQ / bill of material / construction material list from an attachment image.
Extract ALL line items visible on this page.
Return ONLY valid JSON. No markdown. No explanation.

Very important:
- Include quantity and description for every visible item row.
- Preserve exact sizes/specs: 1/2\", 3/4\", 2\", #12, 500 kcmil, schedule 40, EMT, PVC, rigid, etc.
- Do NOT reduce rows to only EMT or only PVC.
- If a row has a quantity column, copy it exactly.
- If quantity is missing, leave qty blank.
- Ignore prices, totals, tax, terms, signatures, and boilerplate.
- For each extracted item, also return source_text as the exact visible row text you used.
- For each extracted item, also return source_bbox_pct as [x1,y1,x2,y2] percentages from 0-100 around the visible row, if you can estimate it. This is for highlighting only; approximate is okay.

Recent user corrections to learn from:
{recent_rfq_extraction_learning_prompt()}

Source file: {source_name}
Page/image: {page_label}

JSON format:
{{
  "materials": [
    {{"qty": "", "unit": "", "part_number": "", "description": "", "manufacturer": "", "notes": "", "source_page": "{page_label}", "source_text": "exact visible row text", "source_bbox_pct": [0, 0, 0, 0]}}
  ]
}}
""".strip()
    payload = {
        "model": ai_model_for_task("vision", RFQ_VISION_MODEL),
        "prompt": prompt,
        "images": [image_b64],
        "stream": False,
        "keep_alive": AI_KEEP_ALIVE,
        "options": {"temperature": 0.01, "num_predict": int(os.environ.get("MAINBOX_RFQ_VISION_NUM_PREDICT", "8000")), "num_ctx": int(os.environ.get("MAINBOX_RFQ_VISION_NUM_CTX", "16384")), "top_k": 40, "top_p": 0.90},
    }
    try:
        data = json.dumps(payload).encode("utf-8")
        with ollama_open(data, task="vision", timeout=int(os.environ.get("MAINBOX_RFQ_VISION_TIMEOUT", str(max(OLLAMA_TIMEOUT_SECONDS, 120))))) as response:
            raw = response.read().decode("utf-8")
            result = json.loads(raw)
        try:
            _rfq_debug_write(f"vision_response_{source_name}_{page_label}.txt", result.get("response") or raw)
        except Exception:
            pass
        obj = extract_json_object(result.get("response") or "")
        rows = _rfq_clean_ai_material_rows(obj, source_name=source_name, source_prefix="vision-ai")
        if rows:
            for row in rows:
                if not row.get("source_page"):
                    row["source_page"] = page_label
            return rows, f"{source_name} {page_label}: vision AI ({RFQ_VISION_MODEL}) found {len(rows)} row(s)"
        return None, f"{source_name} {page_label}: vision AI ({RFQ_VISION_MODEL}) returned no useful rows"
    except Exception as exc:
        return None, f"{source_name} {page_label}: vision AI failed ({exc})"



def _rfq_expected_item_count_from_text(text):
    """Return expected RFQ item count when the email/PDF text says things like '31 Items'."""
    try:
        blob = str(text or "")
    except Exception:
        return None
    patterns = [
        r"\b(\d{1,4})\s+(?:line\s+)?items?\b",
        r"\bitems?\s*[:#\-]?\s*(\d{1,4})\b",
        r"\b(\d{1,4})\s+(?:material|materials|requested)\s+items?\b",
    ]
    best = None
    for pat in patterns:
        for m in re.finditer(pat, blob, flags=re.IGNORECASE):
            try:
                n = int(m.group(1))
            except Exception:
                continue
            # Ignore tiny/common numbers and unrealistic counts.
            if 2 <= n <= 500:
                if best is None or n > best:
                    best = n
    return best


def _rfq_split_markdown_row(line):
    """Split a markdown table row into cells while preserving simple content."""
    raw = str(line or "").strip()
    if not raw.startswith("|"):
        return []
    raw = raw.strip("|")
    return [re.sub(r"\s+", " ", c.replace("&amp;", "&").strip()) for c in raw.split("|")]


def _rfq_is_markdown_separator_row(cells):
    if not cells:
        return False
    return all(re.fullmatch(r"\s*:?-{2,}:?\s*", str(c or "")) for c in cells)


def _rfq_clean_docling_description(desc):
    desc = str(desc or "").strip()
    # Docling often uses brackets for detected product names; keep the text but remove markdown-ish wrappers.
    desc = re.sub(r"\[([^\]]+)\]", r"\1", desc)
    desc = desc.replace("&quot;", '"').replace("&#34;", '"').replace("&amp;", "&")
    desc = desc.replace("Thread- ed", "Threaded").replace("Set- Screw", "Set-Screw")
    # Strip trailing price/total/extension values that Docling sometimes appends to description cells.
    desc = re.sub(r"\s+\$[\d,]+(?:\.\d{2})?\s*$", "", desc)
    desc = re.sub(r"\s+\d{1,3}(?:,\d{3})*(?:\.\d{2})?\s*$", "", desc)
    return re.sub(r"\s+", " ", desc).strip()


def parse_rfq_materials_from_markdown_tables(text, source_name="", expected_item_count=None):
    """Parse clean Docling/LiteParse markdown RFQ tables directly.

    This is intentionally run BEFORE Llama. If Docling already produced a table like:
    | # | QTY | UOM | UPC | MPN | DESCRIPTION | ... |
    there is no reason to ask a local LLM to re-extract it and risk dropped rows.
    """
    if not RFQ_DIRECT_TABLE_PARSE:
        return []
    lines = str(text or "").splitlines()
    rows = []
    current_header = None
    current_map = None

    def header_map(cells):
        normalized = [re.sub(r"[^a-z0-9#]+", "", str(c or "").lower()) for c in cells]
        # Must look like a material line-item table.
        has_qty = any(c in ["qty", "quantity", "quant", "qnty", "count", "amount", "ordered", "orderqty", "req", "required"] for c in normalized)
        has_desc = any(c in ["description", "desc", "itemdescription", "material", "materials", "product", "productname", "name", "spec", "specification", "itemdetail", "details"] for c in normalized)
        has_part = any(c in ["part", "partnumber", "partno", "mpn", "model", "catalog", "cat", "sku", "itemnumber", "code"] for c in normalized)
        has_num = any(c in ["#", "no", "item", "line", "linenumber", "seq", "num"] for c in normalized)
        # Accept if qty+desc, or part+desc (BOM-style sheets)
        if not (has_qty or has_part) or not has_desc:
            return None
        out = {}
        for idx, key in enumerate(normalized):
            if key in ["#", "no", "line", "linenumber", "seq", "seqno", "num", "number"]:
                out.setdefault("line", idx)
            elif key in ["qty", "quantity", "quant", "qnty", "count", "amount", "ordered", "orderqty", "req", "required"]:
                out.setdefault("qty", idx)
            elif key in ["uom", "unit", "units", "um", "measure"]:
                out.setdefault("unit", idx)
            elif key in ["upc", "barcode", "ean"]:
                out.setdefault("upc", idx)
            elif key in ["mpn", "part", "partnumber", "partno", "model", "catalog", "cat", "sku", "itemnumber", "code"]:
                out.setdefault("part", idx)
            elif key in ["description", "desc", "itemdescription", "material", "materials", "product", "productname", "name", "spec", "specification", "itemdetail", "details"]:
                out.setdefault("desc", idx)
            elif key in ["manufacturer", "mfr", "brand", "make", "mfgr"]:
                out.setdefault("manufacturer", idx)
            elif key in ["notes", "note", "remarks", "comment", "comments", "memo"]:
                out.setdefault("notes", idx)
        return out

    for line in lines:
        if not str(line or "").lstrip().startswith("|"):
            continue
        cells = _rfq_split_markdown_row(line)
        if not cells:
            continue
        hm = header_map(cells)
        if hm:
            current_header = cells
            current_map = hm
            continue
        if _rfq_is_markdown_separator_row(cells):
            continue
        if not current_map:
            continue
        # Skip totals and summary tables.
        blob = " ".join(cells).lower()
        if any(x in blob for x in ["subtotal", "sales tax", "shipping", "discount", " total "]):
            continue
        try:
            qty = cells[current_map.get("qty", -1)].strip() if current_map.get("qty", -1) < len(cells) else ""
            unit = cells[current_map.get("unit", -1)].strip() if current_map.get("unit", -1) < len(cells) else ""
            desc = cells[current_map.get("desc", -1)].strip() if current_map.get("desc", -1) < len(cells) else ""
            part = cells[current_map.get("part", -1)].strip() if current_map.get("part", -1) < len(cells) else ""
            upc = cells[current_map.get("upc", -1)].strip() if current_map.get("upc", -1) < len(cells) else ""
            mfr = cells[current_map.get("manufacturer", -1)].strip() if current_map.get("manufacturer", -1) < len(cells) else ""
            line_no = cells[current_map.get("line", -1)].strip() if current_map.get("line", -1) < len(cells) else ""
        except Exception:
            continue
        desc = _rfq_clean_docling_description(desc)
        part = "" if part in ["-", "—", "--"] else part
        upc = "" if upc in ["-", "—", "--"] else upc
        if not desc:
            continue
        # A real line row should have a quantity or a numeric line number.
        if not qty and not re.fullmatch(r"\d{1,4}", str(line_no or "")):
            continue
        notes = ""
        if upc:
            notes = f"UPC: {upc}"
        rows.append({
            "qty": qty,
            "unit": unit,
            "part_number": part,
            "description": desc,
            "manufacturer": mfr,
            "notes": notes,
            "source": f"docling-table:{source_name}" if source_name else "docling-table",
            "source_page": f"line {line_no}" if line_no else ""
        })
    return normalize_material_items(rows)




def _rfq_norm_header_cell(value):
    return re.sub(r"[^a-z0-9#]+", "", str(value or "").strip().lower())


def _rfq_spreadsheet_header_map(row_values):
    """Return a header map for common RFQ/BOM spreadsheet columns."""
    norm = [_rfq_norm_header_cell(v) for v in row_values]
    out = {}
    for idx, key in enumerate(norm):
        if not key:
            continue
        if key in ["#", "no", "item", "itemno", "line", "linenumber", "line#", "lineitem", "lineno", "seq", "seqno", "sequence", "num", "number"]:
            out.setdefault("line", idx)
        elif key in ["qty", "quantity", "quant", "qnty", "count", "amount", "ordered", "orderqty", "orderedqty", "requestedqty", "requestedquantity", "req", "required", "reqd", "totalqty", "totalquantity"]:
            out.setdefault("qty", idx)
        elif key in ["uom", "unit", "units", "um", "unitofmeasure", "uofm", "measure", "each"]:
            out.setdefault("unit", idx)
        elif key in ["description", "desc", "itemdescription", "material", "materials", "product", "itemname", "name", "materialdescription", "productdescription", "productname", "longdesc", "longdescription", "spec", "specification", "item", "itemdetail", "details", "summary"]:
            out.setdefault("desc", idx)
        elif key in ["part", "partnumber", "partno", "mpn", "model", "catalog", "catalognumber", "cat", "catno", "sku", "itemnumber", "itemno", "code", "productcode", "partcode", "vendorpart", "supplierpart", "mfgpart", "manufacturerpart"]:
            out.setdefault("part", idx)
        elif key in ["manufacturer", "mfr", "brand", "make", "mfgr", "vendor", "supplier"]:
            out.setdefault("manufacturer", idx)
        elif key in ["upc", "barcode", "ean", "gtin"]:
            out.setdefault("upc", idx)
        elif key in ["notes", "note", "remarks", "remark", "comment", "comments", "memo", "annotation"]:
            out.setdefault("notes", idx)
    # Accept table if it has qty+desc OR part+desc (some BOM sheets use part numbers instead of qty)
    if "qty" in out and "desc" in out:
        return out
    if "part" in out and "desc" in out:
        return out
    return None


def _rfq_cell_text(v):
    if v is None:
        return ""
    try:
        # Convert simple numbers without trailing .0 so quantities look natural.
        if isinstance(v, float) and v.is_integer():
            return str(int(v))
    except Exception:
        pass
    return re.sub(r"\s+", " ", str(v).strip())


def parse_rfq_materials_from_spreadsheet_file(path, source_name="", expected_item_count=None):
    """Parse XLSX/XLSM/CSV rows directly before Llama.

    This mirrors the Docling-table fix for PDFs: if a spreadsheet already contains rows/cells,
    do not ask the LLM to rediscover them from flattened text. Find qty + description columns
    and build material rows deterministically.
    """
    ext = os.path.splitext(str(path or ""))[1].lower()
    source_name = source_name or os.path.basename(str(path or "spreadsheet"))
    all_rows = []

    def maybe_add_from_matrix(matrix, sheet_name=""):
        rows = []
        active_map = None
        header_row_idx = None
        blank_run = 0
        for r_idx, row in enumerate(matrix):
            vals = [_rfq_cell_text(v) for v in row]
            if not any(vals):
                if active_map:
                    blank_run += 1
                    if blank_run >= 8:
                        active_map = None
                continue
            blank_run = 0
            hm = _rfq_spreadsheet_header_map(vals)
            if hm:
                active_map = hm
                header_row_idx = r_idx
                continue
            if not active_map:
                # Fallback for very simple sheets with no obvious header: look for rows that begin with qty.
                nonempty = [x for x in vals if x]
                if len(nonempty) >= 2 and re.fullmatch(r"\d+(?:\.\d+)?", nonempty[0]):
                    qty = nonempty[0]
                    unit = ""
                    desc_parts = nonempty[1:]
                    if len(nonempty) >= 3 and re.fullmatch(r"[A-Za-z]{1,8}", nonempty[1]):
                        unit = nonempty[1]
                        desc_parts = nonempty[2:]
                    desc = _rfq_clean_docling_description(" ".join(desc_parts))
                    if desc and not any(x in desc.lower() for x in ["subtotal", "sales tax", "shipping", "total"]):
                        rows.append({"qty": qty, "unit": unit, "description": desc, "part_number": "", "manufacturer": "", "notes": "", "source": f"spreadsheet:{source_name}:{sheet_name}", "source_page": f"row {r_idx+1}", "source_text": " | ".join(nonempty)})
                continue
            def get(col):
                try:
                    return vals[col].strip() if col is not None and col < len(vals) else ""
                except Exception:
                    return ""
            qty = get(active_map.get("qty"))
            desc = _rfq_clean_docling_description(get(active_map.get("desc")))
            unit = get(active_map.get("unit"))
            part = get(active_map.get("part"))
            mfr = get(active_map.get("manufacturer"))
            upc = get(active_map.get("upc"))
            notes = get(active_map.get("notes"))
            line_no = get(active_map.get("line"))
            blob = " ".join([qty, unit, desc, part, mfr, upc, notes]).lower()
            if not desc:
                continue
            if any(x in blob for x in ["subtotal", "sales tax", "shipping", "discount", "grand total", "terms and conditions"]):
                continue
            # Skip accidental repeated header rows.
            if _rfq_spreadsheet_header_map(vals):
                continue
            if not qty and not line_no and not part:
                # Most RFQ line items have either qty, line number, or part number.
                # Only drop rows that have none of these identifiers.
                continue
            if upc and upc not in notes:
                notes = (notes + ("; " if notes else "") + f"UPC: {upc}").strip()
            rows.append({"qty": qty, "unit": unit, "description": desc, "part_number": part if part not in ["-", "—", "--"] else "", "manufacturer": mfr, "notes": notes, "source": f"spreadsheet:{source_name}:{sheet_name}", "source_page": f"row {r_idx+1}" if not line_no else f"line {line_no}", "source_text": " | ".join([v for v in vals if v])})
        return rows

    try:
        if ext in [".xlsx", ".xlsm"]:
            import openpyxl
            # v4.2.0: see read_text_from_file_best_effort -- read_only workbooks hold the
            # zip handle through reference cycles and lock the file until a cyclic GC,
            # defeating the callers' rmtree. Close deterministically.
            wb = None
            try:
                wb = openpyxl.load_workbook(path, data_only=True, read_only=True)
                for ws in wb.worksheets[:12]:
                    matrix = []
                    for row in ws.iter_rows(max_row=1500, max_col=60, values_only=True):
                        matrix.append(list(row))
                    all_rows.extend(maybe_add_from_matrix(matrix, ws.title))
            finally:
                if wb is not None:
                    try:
                        wb.close()
                    except Exception:
                        pass
        elif ext == ".csv":
            import csv
            with open(path, "r", encoding="utf-8", errors="ignore", newline="") as f:
                matrix = list(csv.reader(f))
            all_rows.extend(maybe_add_from_matrix(matrix, "CSV"))
        elif ext in [".tsv", ".txt"]:
            try:
                import csv
                with open(path, "r", encoding="utf-8", errors="ignore", newline="") as f:
                    sample = f.read(4096)
                    f.seek(0)
                    try:
                        dialect = csv.Sniffer().sniff(sample, delimiters="\t,|")
                        matrix = list(csv.reader(f, dialect))
                    except Exception:
                        matrix = [line.rstrip("\n").split("\t") for line in f.readlines()[:1500]]
                all_rows.extend(maybe_add_from_matrix(matrix, "TSV"))
            except Exception:
                return []
        elif ext in [".xls", ".xlsb", ".ods"]:
            try:
                import pandas as pd
                sheets = pd.read_excel(path, sheet_name=None, header=None, nrows=1500)
                for sheet_name, df in list(sheets.items())[:12]:
                    matrix = df.fillna("").values.tolist()
                    all_rows.extend(maybe_add_from_matrix(matrix, str(sheet_name)))
            except Exception:
                return []
    except Exception:
        try:
            _rfq_debug_write(f"spreadsheet_direct_exception_{source_name}.txt", traceback.format_exc())
        except Exception:
            pass
        return []

    return normalize_material_items(all_rows)



def parse_rfq_materials_from_flat_price_text(text, source_name="", expected_item_count=None):
    """Parse clean selectable-text PDF PO/RFQ price-table rows flattened into lines.

    Example:
        300.00 1/2 threaded rod 0.92475 277.43 W21390,MISC,030 - MATERIA

    This is a deterministic pre-AI parser for PDF text only. It does not affect the
    direct spreadsheet parser, which already works from structured cells.
    """
    rows = []
    seen = set()
    price_num = r"\d{1,3}(?:,\d{3})*(?:\.\d{2,5})|\d+(?:\.\d{2,5})"
    qty_num = r"\d{1,6}(?:,\d{3})*(?:\.\d+)?"
    skip_re = re.compile(r"\b(?:subtotal|sales\s*tax|tax|total|grand\s+total|shipping|freight|authorized\s+signature|thank\s+you)\b", re.I)
    unit_words = r"ea|each|pc|pcs|piece|pieces|ft|lf|foot|feet|set|sets|box|boxes|roll|rolls|bag|bags|case|cases|kit|kits|lot|lots"

    for idx, raw in enumerate(str(text or "").splitlines()):
        line = re.sub(r"\s+", " ", str(raw or "").strip())
        if not line or line.startswith("---"):
            continue
        m = re.match(
            rf"^\s*(?P<qty>{qty_num})\s+(?P<body>.+?)\s+"
            rf"(?P<unit_price>{price_num})\s+(?P<amount>{price_num})"
            rf"(?:\s+(?P<job>[A-Za-z0-9][A-Za-z0-9,._/\- ]{{2,}}))?\s*$",
            line,
            re.I,
        )
        if not m:
            continue
        qty = (m.group("qty") or "").replace(",", "").strip()
        body = re.sub(r"\s+", " ", (m.group("body") or "").strip(" -:;"))
        if not qty or not body or skip_re.search(body):
            continue
        unit = ""
        desc = body
        mu = re.match(rf"^(?P<unit>{unit_words})\b\s+(?P<desc>.+)$", body, re.I)
        if mu:
            unit = (mu.group("unit") or "").strip()
            desc = (mu.group("desc") or "").strip()
        desc = re.sub(r"\s+-\s*MATERIA[L]?\s*$", "", desc, flags=re.I).strip()
        if not desc:
            continue

        notes = []
        up = (m.group("unit_price") or "").strip()
        amount = (m.group("amount") or "").strip()
        job = (m.group("job") or "").strip()
        if up:
            notes.append(f"Unit price: {up}")
        if amount:
            notes.append(f"Total: {amount}")
        if job:
            notes.append(f"Job: {job}")

        key = re.sub(r"\s+", " ", f"{qty}|{unit}|{desc}".lower()).strip()
        if key in seen:
            continue
        seen.add(key)
        rows.append({
            "qty": qty,
            "unit": unit,
            "part_number": "",
            "description": desc,
            "manufacturer": "",
            "notes": "; ".join(notes),
            "source": f"pdf-flat-price-table:{source_name}" if source_name else "pdf-flat-price-table",
            "source_page": f"line {idx + 1}",
            "source_text": line,
            "selected": True,
        })
    return normalize_material_items(rows)

def vision_first_extract_materials_from_saved_attachment(path, filename="", target_count=None, page_callback=None):
    """Try the true AI-file-style path first: saved Outlook attachment -> rendered page image -> vision AI.

    For PDFs, each page is rendered as an image and sent to Ollama's images field. For PNG/JPG
    attachments, the image bytes are sent directly. If the configured model is text-only, this
    safely fails and the caller falls back to text/table/regex extractors.
    """
    source_name = filename or os.path.basename(str(path or ""))
    ext = os.path.splitext(str(path or ""))[1].lower()
    rows = []
    details = []

    if ext in [".png", ".jpg", ".jpeg", ".webp", ".bmp"]:
        try:
            with open(path, "rb") as f:
                b64 = base64.b64encode(f.read()).decode("ascii")
            page_rows, msg = _ollama_extract_materials_from_image_b64(b64, source_name, "image")
            details.append(msg)
            if page_rows:
                rows.extend(page_rows)
        except Exception as exc:
            details.append(f"{source_name}: vision image read failed ({exc})")
        return normalize_material_items(rows), details

    if ext != ".pdf":
        return [], [f"{source_name}: vision AI skipped; not PDF/image"]

    try:
        import fitz  # PyMuPDF
    except Exception as exc:
        return [], [f"{source_name}: vision AI skipped; PyMuPDF not installed/importable ({exc})"]

    try:
        doc = fitz.open(path)
        page_count = min(len(doc), max(1, RFQ_VISION_MAX_PAGES))
        details.append(f"{source_name}: VISION PROOF using model {RFQ_VISION_MODEL}; PDF has {len(doc)} page(s), sending {page_count} page(s) as images")
        for idx in range(page_count):
            try:
                page = doc.load_page(idx)
                pix = page.get_pixmap(matrix=fitz.Matrix(3.0, 3.0), alpha=False)
                img_bytes = pix.tobytes("png")
                try:
                    saved_png = _rfq_debug_write(f"rendered_{source_name}_{idx + 1}.png", img_bytes, binary=True)
                    if saved_png:
                        details.append(f"{source_name} page {idx + 1}: rendered PDF page image saved for debug: {saved_png}")
                except Exception:
                    pass
                b64 = base64.b64encode(img_bytes).decode("ascii")
                page_label = f"page {idx + 1}"
                page_rows, msg = _ollama_extract_materials_from_image_b64(b64, source_name, page_label)
                details.append(msg)
                if page_rows:
                    clean_page_rows = normalize_material_items(page_rows)
                    rows.extend(clean_page_rows)
                    if page_callback:
                        try:
                            page_callback(source_name, idx + 1, clean_page_rows, saved_png if 'saved_png' in locals() else "")
                        except Exception:
                            pass
            except Exception as page_exc:
                details.append(f"{source_name} page {idx + 1}: vision render/extract failed ({page_exc})")
        if len(doc) > page_count:
            details.append(f"{source_name}: vision AI limited to first {page_count} page(s); set MAINBOX_RFQ_VISION_MAX_PAGES to increase")
        try:
            doc.close()
        except Exception:
            pass
    except Exception as exc:
        details.append(f"{source_name}: vision AI PDF open failed ({exc})")

    return normalize_material_items(rows), details


def ai_first_extract_materials_from_saved_attachment(path, filename="", subject="", sender="", expected_item_count=None):
    """AI-first RFQ extraction for one saved attachment.

    This is intentionally tried BEFORE the older structured/table/regex path. It mirrors the
    successful manual workflow: give the model the attachment's readable content and ask for a
    complete quantity + description list in strict JSON. If the model returns a useful list, the
    caller can trust this result first and keep the old extractor as fallback.
    """
    if not OLLAMA_ENABLED:
        return None, "AI-first skipped: Ollama disabled"
    source_name = filename or os.path.basename(str(path or ""))

    # v2.8.4Q: Spreadsheet direct table parser. Do this before flattening sheet text
    # and before Llama, because Excel already contains clean rows/cells.
    try:
        ext_lower = os.path.splitext(str(path or ""))[1].lower()
        if ext_lower in [".xlsx", ".xlsm", ".xls", ".xlsb", ".ods", ".csv"]:
            direct_sheet_rows = parse_rfq_materials_from_spreadsheet_file(path, source_name=source_name, expected_item_count=expected_item_count)
            if direct_sheet_rows:
                try:
                    _rfq_debug_write(f"direct_spreadsheet_rows_{source_name}.json", json.dumps(direct_sheet_rows, indent=2))
                except Exception:
                    pass
                msg = f"{source_name}: direct spreadsheet parser found {len(direct_sheet_rows)} material row(s); skipped Llama text extraction"
                try:
                    if expected_item_count and len(direct_sheet_rows) >= int(expected_item_count):
                        msg += f" and reached expected count {expected_item_count}"
                except Exception:
                    pass
                return direct_sheet_rows, msg
    except Exception as sheet_exc:
        try:
            _rfq_debug_write(f"direct_spreadsheet_precheck_exception_{source_name}.txt", traceback.format_exc())
        except Exception:
            pass

    try:
        text = read_text_from_file_best_effort(path)
    except Exception as exc:
        return None, f"{source_name}: text AI ({RFQ_TEXT_MODEL}) could not read attachment text ({exc})"
    clean = (text or "").strip()
    if len(clean) < 25:
        return None, f"{source_name}: text AI ({RFQ_TEXT_MODEL}) skipped; no readable text/OCR"

    # v2.8.4P: If Docling/LiteParse already gave us a clean markdown material table,
    # parse it deterministically and skip Llama entirely. This is faster and prevents
    # local LLM JSON responses from dropping rows.
    direct_rows = parse_rfq_materials_from_markdown_tables(clean, source_name=source_name, expected_item_count=expected_item_count)
    if direct_rows:
        try:
            _rfq_debug_write(f"direct_table_rows_{source_name}.json", json.dumps(direct_rows, indent=2))
        except Exception:
            pass
        msg = f"{source_name}: Docling/LiteParse direct table parser found {len(direct_rows)} material row(s); skipped Llama text extraction"
        try:
            if expected_item_count and len(direct_rows) >= int(expected_item_count):
                msg += f" and reached expected count {expected_item_count}"
        except Exception:
            pass
        return direct_rows, msg

    # Native/selectable-text PDFs can flatten Qty/Description/Unit Price/Amount/Job tables
    # into one readable line per material row. Parse those deterministically before Llama
    # so clean PDF text does not get reduced to one AI row.
    try:
        ext_lower = os.path.splitext(str(path or ""))[1].lower()
        if ext_lower == ".pdf":
            flat_rows = parse_rfq_materials_from_flat_price_text(clean, source_name=source_name, expected_item_count=expected_item_count)
            if flat_rows:
                try:
                    _rfq_debug_write(f"direct_flat_pdf_price_rows_{source_name}.json", json.dumps(flat_rows, indent=2))
                except Exception:
                    pass
                msg = f"{source_name}: direct flat PDF price-table parser found {len(flat_rows)} material row(s); skipped Llama text extraction"
                return flat_rows, msg
    except Exception:
        pass

    max_chars = int(os.environ.get("MAINBOX_RFQ_TEXT_MAX_CHARS", "60000"))
    if len(clean) > max_chars:
        clean = clean[:max_chars]

    prompt = f"""
You are an expert electrical/construction RFQ material takeoff assistant.
The user needs a COMPLETE list of requested line items from the attached RFQ/BOM/spec document.

Return ONLY valid JSON. No markdown. No explanation.

Rules:
- Extract every item row you can find, especially quantities and descriptions.
- If an expected item count is provided, keep extracting until your JSON contains that many separate material rows.
- Preserve sizes exactly: 1/2\", 3/4\", 2\", 4\", #12, 500 kcmil, etc.
- Preserve material words: EMT, PVC, RMC, rigid, wire, cable, fittings, couplings, boxes, panels, breakers, devices, supports, hardware, accessories.
- Do NOT collapse a detailed row into only "EMT" or only "PVC".
- Do NOT invent missing quantities, part numbers, manufacturers, or brands.
- If quantity is missing, leave qty blank.
- If unit is missing, leave unit blank.
- If the document has tables, treat each row as a separate material item.
- Ignore pricing, tax, totals, terms, signatures, disclaimers, and email headers.

Recent user corrections to learn from:
{recent_rfq_extraction_learning_prompt()}

Email subject: {subject}
Sender: {sender}
Source file: {source_name}
Expected item count if known: {expected_item_count or "unknown"}

Attachment text/OCR:
{clean}

JSON format:
{{
  "materials": [
    {{"qty": "", "unit": "", "part_number": "", "description": "", "manufacturer": "", "notes": "", "source_page": ""}}
  ]
}}
""".strip()

    payload = {
        "model": ai_model_for_task("purchase", RFQ_TEXT_MODEL),
        "prompt": prompt,
        "stream": False,
        "keep_alive": AI_KEEP_ALIVE,
        "options": {
            "temperature": 0.01,
            "num_predict": int(os.environ.get("MAINBOX_RFQ_TEXT_NUM_PREDICT", "5000")),
            "num_ctx": int(os.environ.get("MAINBOX_RFQ_TEXT_NUM_CTX", "16384")),
            "top_k": 8,
            "top_p": 0.55
        }
    }
    try:
        data = json.dumps(payload).encode("utf-8")
        with ollama_open(data, task="quote", timeout=int(os.environ.get("MAINBOX_RFQ_TEXT_TIMEOUT", str(max(OLLAMA_TIMEOUT_SECONDS, 90))))) as response:
            raw = response.read().decode("utf-8")
            result = json.loads(raw)
        try:
            _rfq_debug_write(f"text_model_response_{source_name}.txt", result.get("response") or raw)
        except Exception:
            pass
        obj = extract_json_object(result.get("response") or "")
        if not isinstance(obj, dict) or not isinstance(obj.get("materials"), list):
            return None, f"{source_name}: text AI ({RFQ_TEXT_MODEL}) returned no valid materials JSON"

        cleaned = []
        seen = set()
        for item in obj.get("materials", [])[:220]:
            if not isinstance(item, dict):
                continue
            part = str(item.get("part_number", "") or "").strip().upper()
            desc = re.sub(r"\s+", " ", str(item.get("description", "") or "").strip())
            qty = str(item.get("qty", "") or "").strip()
            unit = str(item.get("unit", "") or "").strip()
            if not part and not desc:
                continue
            if desc.lower() in ["emt", "pvc", "wire", "conduit"] and not qty and not part:
                continue
            key = normalize_material_key(part, desc)
            if key in seen:
                continue
            seen.add(key)
            cleaned.append({
                "qty": qty,
                "unit": unit,
                "part_number": part,
                "description": desc,
                "manufacturer": str(item.get("manufacturer", "") or "").strip(),
                "notes": str(item.get("notes", "") or "").strip(),
                "source": f"ai-first:{source_name}",
                "source_page": str(item.get("source_page", "") or "").strip()
            })
        cleaned = normalize_material_items(cleaned)
        if cleaned:
            return cleaned, f"{source_name}: AI-first found {len(cleaned)} material row(s)"
        return None, f"{source_name}: AI-first found no useful rows"
    except Exception as exc:
        return None, f"{source_name}: text AI ({RFQ_TEXT_MODEL}) failed ({exc})"


def _rfq_external_parser_should_try(ext):
    """Return True for formats where Docling/LiteParse may preserve layout better than basic extraction."""
    return ext in [".pdf", ".docx", ".doc", ".pptx", ".xlsx", ".xlsm", ".xls", ".csv", ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp", ".webp"]


def _rfq_trim_parser_text(text):
    text = str(text or "").strip()
    if RFQ_PARSER_MAX_CHARS and len(text) > RFQ_PARSER_MAX_CHARS:
        text = text[:RFQ_PARSER_MAX_CHARS] + "\n\n[TRUNCATED BY MAINBOX_RFQ_PARSER_MAX_CHARS]"
    return text


# v3.9.87: ONE shared Docling converter, built lazily and reused for every
# attachment. Docling loads heavy torch models (TableFormer table-structure + OCR)
# on first convert(); the previous code built a FRESH DocumentConverter() per priced
# attachment, reloading those models every call. That churn fragmented native memory
# until a model load (safetensors -> torch storage) hit a Windows access violation
# (0xC0000005) / std::bad_alloc and took the whole process down. A single shared
# instance loads the models once per session. Sequential reuse is supported, and the
# inbox quote scan is already serialized by _outlook_worker_lock; the lock below only
# guards the one-time construction in case two paths first-touch it simultaneously.
_DOCLING_CONVERTER = None
_DOCLING_CONVERTER_LOCK = threading.Lock()


def _get_docling_converter():
    global _DOCLING_CONVERTER
    if _DOCLING_CONVERTER is not None:
        return _DOCLING_CONVERTER
    with _DOCLING_CONVERTER_LOCK:
        if _DOCLING_CONVERTER is None:
            from docling.document_converter import DocumentConverter
            _DOCLING_CONVERTER = DocumentConverter()
    return _DOCLING_CONVERTER


def extract_text_with_docling(path, source_name=""):
    """Optional Docling parser route. Returns (text, detail_message)."""
    try:
        converter = _get_docling_converter()  # v3.9.87: shared singleton; was DocumentConverter() per call
    except Exception as exc:
        return "", f"{source_name}: Docling not available ({exc}). Install with: py -m pip install docling"
    try:
        result = converter.convert(path)
        doc = getattr(result, "document", None)
        text = ""
        if doc is not None:
            try:
                text = doc.export_to_markdown()
            except Exception:
                try:
                    text = doc.export_to_text()
                except Exception:
                    text = str(doc)
        text = _rfq_trim_parser_text(text)
        if text and len(text) > 40:
            try:
                _rfq_debug_write(f"docling_text_{source_name}.md", text)
            except Exception:
                pass
            return text, f"{source_name}: Docling parsed {len(text)} chars of layout/table-aware text"
        return "", f"{source_name}: Docling ran but returned little/no text"
    except Exception as exc:
        try:
            _rfq_debug_write(f"docling_exception_{source_name}.txt", traceback.format_exc())
        except Exception:
            pass
        return "", f"{source_name}: Docling failed ({exc})"


def extract_text_with_liteparse(path, source_name=""):
    """Optional LiteParse CLI route. Requires npm install -g @llamaindex/liteparse."""
    try:
        cmd = ["lit", "parse", str(path)]
        completed = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="ignore", timeout=int(os.environ.get("MAINBOX_RFQ_LITEPARSE_TIMEOUT", "120")))
        out = (completed.stdout or "").strip()
        err = (completed.stderr or "").strip()
        if completed.returncode != 0 and not out:
            return "", f"{source_name}: LiteParse failed/was not found ({err or 'non-zero exit'}). Install with: npm i -g @llamaindex/liteparse"
        text = _rfq_trim_parser_text(out)
        if text and len(text) > 40:
            try:
                _rfq_debug_write(f"liteparse_text_{source_name}.txt", text)
            except Exception:
                pass
            return text, f"{source_name}: LiteParse parsed {len(text)} chars of spatial text"
        return "", f"{source_name}: LiteParse ran but returned little/no text ({err[:200]})"
    except FileNotFoundError:
        return "", f"{source_name}: LiteParse CLI not found. Install with: npm i -g @llamaindex/liteparse"
    except Exception as exc:
        try:
            _rfq_debug_write(f"liteparse_exception_{source_name}.txt", traceback.format_exc())
        except Exception:
            pass
        return "", f"{source_name}: LiteParse failed ({exc})"


def extract_text_with_parser_first(path, filename=""):
    """Docling/LiteParse parser-first route. Keeps everything local and avoids slow vision calls."""
    ext = os.path.splitext(str(path or ""))[1].lower()
    source_name = filename or os.path.basename(str(path or "attachment"))
    # v3.9.80: "ai_only" must skip Docling/LiteParse here too. It was missing from this list even
    # though lines ~14636/14999 already treat "ai_only" as a no-heavy-parser mode. In the default
    # ai_only mode this function fell through to the docling/liteparse default and instantiated a
    # fresh Docling DocumentConverter for EVERY priced PDF attachment during the inbox Quote Coverage
    # scan (scan_recent_inbox_for_quotes -> _attachment_quote_text_from_msg -> read_text_from_file_best_effort).
    # That model load is ~2 s/attachment and ~2.3 GB resident, and it holds the GIL during init, so the
    # Tk UI froze even though the scan runs on a worker. Honoring ai_only here removes the per-attachment
    # parser entirely; coverage falls back to the cheap PyMuPDF/pdfplumber/pypdf text path.
    if RFQ_PARSER_MODE in ["ai_only", "0", "false", "no", "off", "none"] or not _rfq_external_parser_should_try(ext):
        return "", f"{source_name}: parser-first skipped (mode={RFQ_PARSER_MODE}, ext={ext or 'none'})"
    details = []
    modes = []
    if RFQ_PARSER_MODE == "docling":
        modes = ["docling"]
    elif RFQ_PARSER_MODE == "liteparse":
        modes = ["liteparse"]
    elif RFQ_PARSER_MODE == "custom":
        modes = list(RFQ_OCR_PROGRAM_ORDER or ["docling", "liteparse"])
    else:
        # Docling is Python-native and best for table-aware markdown; LiteParse is a fast local CLI fallback.
        modes = list(RFQ_OCR_PROGRAM_ORDER or ["docling", "liteparse"])
    for mode in modes:
        if mode == "docling":
            text, msg = extract_text_with_docling(path, source_name)
        else:
            text, msg = extract_text_with_liteparse(path, source_name)
        details.append(msg)
        if text and len(text.strip()) > 40:
            return text, " | ".join(details)
    return "", " | ".join(details)



def _mainbox_resolve_tesseract_cmd() -> str:
    """Find tesseract.exe for MaINbox's built-in fallback OCR without relying only on PATH."""
    candidates = []
    env_cmd = (os.environ.get("TESSERACT_CMD") or "").strip().strip('"')
    if env_cmd:
        candidates.append(env_cmd)
    try:
        which_cmd = shutil.which("tesseract") or shutil.which("tesseract.exe")
        if which_cmd:
            candidates.append(which_cmd)
    except Exception:
        pass
    for base in [
        os.environ.get("ProgramFiles", r"C:\Program Files"),
        os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)"),
        os.environ.get("LocalAppData", ""),
    ]:
        if not base:
            continue
        candidates.extend([
            os.path.join(base, "Tesseract-OCR", "tesseract.exe"),
            os.path.join(base, "Programs", "Tesseract-OCR", "tesseract.exe"),
        ])
    try:
        app_dir = os.path.dirname(os.path.abspath(__file__))
        candidates.extend([
            os.path.join(app_dir, "Tesseract-OCR", "tesseract.exe"),
            os.path.join(app_dir, "tesseract.exe"),
        ])
    except Exception:
        pass
    seen = set()
    for cand in candidates:
        if not cand or cand in seen:
            continue
        seen.add(cand)
        try:
            if os.path.isfile(cand):
                return cand
        except Exception:
            continue
    return ""


def _mainbox_configure_pytesseract(pytesseract_module) -> str:
    """Configure pytesseract to use a directly discovered tesseract.exe path."""
    cmd = _mainbox_resolve_tesseract_cmd()
    if cmd:
        try:
            pytesseract_module.pytesseract.tesseract_cmd = cmd
        except Exception:
            pass
    return cmd

def read_text_from_file_best_effort(path):
    """Extract text from common quote/BOM attachments.

    v2.8.3: broader attachment support:
    - XLSX/XLSM via openpyxl
    - XLS/XLSB/ODS fallback through pandas when installed
    - legacy XLS/DOC through local Microsoft Office COM when available
    - PDF through PyMuPDF, pdfplumber, pypdf, then OCR fallback
    - images through Tesseract OCR
    """
    ext = os.path.splitext(path)[1].lower()
    pieces = []

    # v2.8.4O: try Docling/LiteParse before older raw extraction. This is the new default
    # for RFQ PDFs because it preserves table/layout text and prevents long vision lockups.
    try:
        parser_text, parser_msg = extract_text_with_parser_first(path, os.path.basename(str(path or "attachment")))
        if parser_text and len(parser_text.strip()) > 40:
            try:
                _rfq_debug_write(f"parser_first_used_{os.path.basename(str(path or 'attachment'))}.txt", parser_msg + "\n\n" + parser_text[:12000])
            except Exception:
                pass
            return parser_text
    except Exception:
        pass

    def clean_join(rows):
        return "\n".join([str(r).strip() for r in rows if str(r).strip()])

    try:
        if ext in [".txt", ".csv", ".log", ".tsv"]:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                return f.read()

        if ext in [".xlsx", ".xlsm"]:
            # Native modern Excel reader.
            # v4.2.0: wb is bound before the try so the finally can always close it.
            wb = None
            try:
                import openpyxl
                wb = openpyxl.load_workbook(path, data_only=True, read_only=True)
                for ws in wb.worksheets[:12]:
                    pieces.append(f"--- Sheet: {ws.title} ---")
                    for row in ws.iter_rows(max_row=1000, max_col=30, values_only=True):
                        vals = [str(v).strip() for v in row if v not in [None, ""]]
                        if vals:
                            pieces.append(" | ".join(vals))
                text = "\n".join(pieces).strip()
                if text:
                    return text
            except Exception:
                pass
            finally:
                # v4.2.0: openpyxl read_only workbooks sit in REFERENCE CYCLES, so the
                # underlying zip handle is NOT released when this function returns -- it
                # waits for a cyclic GC pass that may be a long way off. On Windows the
                # .xlsx stays LOCKED for that whole window, which is what silently
                # defeats every caller's `finally: shutil.rmtree(..., ignore_errors=True)`
                # and orphans the scratch dir (v4.1.97: 1,238 dirs / 782 MB). The janitor
                # v4.1.97 added cleans those up 6h later; this stops them being created.
                # Note the finally also runs on the `return text` path above.
                if wb is not None:
                    try:
                        wb.close()
                    except Exception:
                        pass

        if ext in [".xls", ".xlsb", ".ods"]:
            # Optional pandas support catches many older spreadsheets.
            try:
                import pandas as pd
                sheets = pd.read_excel(path, sheet_name=None, header=None, nrows=1000)
                for sheet_name, df in list(sheets.items())[:12]:
                    pieces.append(f"--- Sheet: {sheet_name} ---")
                    for _, row in df.fillna("").iterrows():
                        vals = [str(v).strip() for v in row.tolist() if str(v).strip()]
                        if vals:
                            pieces.append(" | ".join(vals))
                text = "\n".join(pieces).strip()
                if text:
                    return text
            except Exception:
                pass

            # Windows + Excel installed fallback for legacy .xls/.xlsb.
            # v4.1.19 AUDIT FIX (finding #6): untrusted inbound attachments -- macros,
            # events, and link updates are force-disabled before opening, and cleanup is
            # independent per resource (a failed Close can no longer skip Quit/CoUninit,
            # and a failed Open can no longer leak an orphaned EXCEL.EXE).
            try:
                import win32com.client
                import pythoncom as _pythoncom
                _pythoncom.CoInitialize()
                excel = None
                wb = None
                try:
                    excel = win32com.client.DispatchEx("Excel.Application")
                    excel.Visible = False
                    excel.DisplayAlerts = False
                    try:
                        excel.AutomationSecurity = 3  # msoAutomationSecurityForceDisable
                    except Exception:
                        pass
                    try:
                        excel.EnableEvents = False
                        excel.AskToUpdateLinks = False
                    except Exception:
                        pass
                    wb = excel.Workbooks.Open(os.path.abspath(path), ReadOnly=True, UpdateLinks=0)
                    for ws in wb.Worksheets:
                        pieces.append(f"--- Sheet: {ws.Name} ---")
                        used = ws.UsedRange
                        rows = min(int(used.Rows.Count), 1000)
                        cols = min(int(used.Columns.Count), 30)
                        for r in range(1, rows + 1):
                            vals = []
                            for c in range(1, cols + 1):
                                val = used.Cells(r, c).Text
                                if str(val).strip():
                                    vals.append(str(val).strip())
                            if vals:
                                pieces.append(" | ".join(vals))
                finally:
                    try:
                        if wb is not None:
                            wb.Close(False)
                    except Exception:
                        pass
                    try:
                        if excel is not None:
                            excel.Quit()
                    except Exception:
                        pass
                    try:
                        _pythoncom.CoUninitialize()
                    except Exception:
                        pass
                text = "\n".join(pieces).strip()
                if text:
                    return text
            except Exception:
                pass

        if ext == ".docx":
            try:
                import docx
                doc = docx.Document(path)
                rows = []
                rows.extend([p.text for p in doc.paragraphs if p.text.strip()])
                for table in doc.tables:
                    for row in table.rows:
                        vals = [cell.text.strip() for cell in row.cells if cell.text.strip()]
                        if vals:
                            rows.append(" | ".join(vals))
                return clean_join(rows)
            except Exception:
                pass

        if ext in [".doc", ".rtf"]:
            # Local Microsoft Word fallback for legacy docs/RTF.
            # v4.1.19 AUDIT FIX (finding #6): same hardening as the Excel path -- macros
            # force-disabled, no link updates, independent per-resource cleanup so a
            # failure can never leak an orphaned WINWORD.EXE.
            try:
                import win32com.client
                import pythoncom as _pythoncom
                _pythoncom.CoInitialize()
                word = None
                doc = None
                text = ""
                try:
                    word = win32com.client.DispatchEx("Word.Application")
                    word.Visible = False
                    try:
                        word.AutomationSecurity = 3  # msoAutomationSecurityForceDisable
                    except Exception:
                        pass
                    try:
                        word.DisplayAlerts = 0
                        word.Options.UpdateLinksAtOpen = False
                    except Exception:
                        pass
                    doc = word.Documents.Open(os.path.abspath(path), ReadOnly=True,
                                              AddToRecentFiles=False, Visible=False)
                    text = doc.Content.Text or ""
                finally:
                    try:
                        if doc is not None:
                            doc.Close(False)
                    except Exception:
                        pass
                    try:
                        if word is not None:
                            word.Quit()
                    except Exception:
                        pass
                    try:
                        _pythoncom.CoUninitialize()
                    except Exception:
                        pass
                if text.strip():
                    return text
            except Exception:
                pass
            if ext == ".rtf":
                try:
                    with open(path, "r", encoding="utf-8", errors="ignore") as f:
                        raw = f.read()
                    raw = re.sub(r"\\'[0-9a-fA-F]{2}", " ", raw)
                    raw = re.sub(r"\\[a-zA-Z]+-?\d* ?", " ", raw)
                    raw = raw.replace("{", " ").replace("}", " ")
                    return re.sub(r"\s+", " ", raw)
                except Exception:
                    pass

        if ext == ".pdf":
            if RFQ_PDF_TEXT_EXTRACTION_ENABLED:
                # 1) PyMuPDF — use "blocks" mode which preserves spatial table layout better than "text".
                try:
                    import fitz
                    doc = fitz.open(path)
                    fitz_pieces = []
                    for page in doc[:15]:
                        # "blocks" returns [(x0,y0,x1,y1,text,block_no,block_type),...] sorted top-to-bottom
                        blocks = page.get_text("blocks") or []
                        for block in sorted(blocks, key=lambda b: (b[1], b[0])):
                            bt = str(block[4]).strip() if len(block) > 4 else ""
                            if bt:
                                fitz_pieces.append(bt)
                    text = "\n".join(fitz_pieces).strip()
                    if len(text) > 40:
                        pieces.extend(fitz_pieces)
                        return text
                except Exception:
                    pass

                # 2) pdfplumber — better for tables; use explicit table settings for construction RFQs.
                try:
                    import pdfplumber
                    table_settings = {
                        "vertical_strategy": "lines_strict",
                        "horizontal_strategy": "lines_strict",
                        "snap_tolerance": 3,
                        "join_tolerance": 3,
                        "edge_min_length": 3,
                        "min_words_vertical": 3,
                        "min_words_horizontal": 1,
                        "intersection_tolerance": 3,
                    }
                    with pdfplumber.open(path) as pdf:
                        for page in pdf.pages[:15]:
                            pt = page.extract_text(x_tolerance=2, y_tolerance=3) or ""
                            if pt.strip():
                                pieces.append(pt)
                            # Try explicit line-based table extraction first, fall back to text-based.
                            tables_found = False
                            try:
                                for table in (page.extract_tables(table_settings) or [])[:8]:
                                    for row in table:
                                        vals = [str(v).strip() for v in row if v not in [None, ""]]
                                        if vals:
                                            pieces.append(" | ".join(vals))
                                            tables_found = True
                            except Exception:
                                pass
                            if not tables_found:
                                try:
                                    for table in (page.extract_tables() or [])[:8]:
                                        for row in table:
                                            vals = [str(v).strip() for v in row if v not in [None, ""]]
                                            if vals:
                                                pieces.append(" | ".join(vals))
                                except Exception:
                                    pass
                    text = "\n".join(pieces).strip()
                    if len(text) > 40:
                        return text
                except Exception:
                    pass

                # 3) pypdf fallback.
                try:
                    import pypdf
                    reader = pypdf.PdfReader(path)
                    for page in reader.pages[:15]:
                        pieces.append(page.extract_text() or "")
                    text = "\n".join(pieces).strip()
                    if len(text) > 40:
                        return text
                except Exception:
                    pass

            # 4) OCR scanned PDFs — Tesseract with dual PSM for best table coverage.
            if RFQ_TESSERACT_OCR_ENABLED:
                try:
                    import fitz
                    from PIL import Image
                    import pytesseract
                    _mainbox_configure_pytesseract(pytesseract)
                    doc = fitz.open(path)
                    ocr_pieces = []
                    for page in doc[:10]:
                        pix = page.get_pixmap(matrix=fitz.Matrix(3.0, 3.0), alpha=False)
                        img = Image.frombytes("RGB", [pix.width, pix.height], pix.samples)
                        # PSM 6 = uniform block of text; PSM 4 = single column which handles tables better.
                        text_psm6 = pytesseract.image_to_string(img, config="--psm 6 --oem 3") or ""
                        text_psm4 = pytesseract.image_to_string(img, config="--psm 4 --oem 3") or ""
                        # Use whichever mode produces more content.
                        ocr_pieces.append(text_psm6 if len(text_psm6) >= len(text_psm4) else text_psm4)
                    return "\n".join(ocr_pieces)
                except Exception:
                    return ""
            return ""

        if ext in [".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp", ".webp"]:
            if not RFQ_IMAGE_OCR_ENABLED:
                return ""
            try:
                from PIL import Image
                import pytesseract
                _mainbox_configure_pytesseract(pytesseract)
                img = Image.open(path)
                return pytesseract.image_to_string(img, config="--psm 6") or ""
            except Exception:
                return ""

        # Last-resort text sniffing for odd exported files.
        try:
            with open(path, "rb") as f:
                raw = f.read(2_000_000)
            return raw.decode("utf-8", errors="ignore")
        except Exception:
            return ""
    except Exception:
        return ""
    return ""



def extract_structured_materials_from_saved_attachment(path, filename="", keep_duplicates=False):
    """Extract RFQ line items directly from the saved attachment file.

    This intentionally reuses the file that Outlook already saved in
    extract_attachment_text_for_email(). It does not talk to Outlook, does not create another
    temp attachment copy, and returns normalized item dictionaries that can be merged with
    AI/heuristic extraction.
    """
    ext = os.path.splitext(str(path or ""))[1].lower()
    source_name = filename or os.path.basename(str(path or ""))
    rows = []

    def add_row(cells):
        vals = [re.sub(r"\s+", " ", str(c or "").strip()) for c in cells]
        vals = [v for v in vals if v]
        if vals:
            rows.append(vals)

    try:
        if ext in [".xlsx", ".xlsm"]:
            # v4.2.0: see read_text_from_file_best_effort -- close the read_only workbook
            # deterministically so the .xlsx does not stay locked and defeat rmtree.
            wb = None
            try:
                import openpyxl
                wb = openpyxl.load_workbook(path, data_only=True, read_only=True)
                for ws in wb.worksheets[:12]:
                    for row in ws.iter_rows(max_row=1200, max_col=40, values_only=True):
                        add_row(row)
            except Exception:
                pass
            finally:
                if wb is not None:
                    try:
                        wb.close()
                    except Exception:
                        pass
        elif ext in [".xls", ".xlsb", ".ods"]:
            try:
                import pandas as pd
                sheets = pd.read_excel(path, sheet_name=None, header=None, nrows=1200)
                for _, df in list(sheets.items())[:12]:
                    for _, row in df.fillna("").iterrows():
                        add_row(row.tolist())
            except Exception:
                pass
        elif ext in [".csv", ".tsv", ".txt"]:
            try:
                sep = "\t" if ext == ".tsv" else None
                with open(path, "r", encoding="utf-8", errors="ignore") as f:
                    for line in f.readlines()[:1500]:
                        if sep:
                            add_row(line.split(sep))
                        elif "," in line:
                            add_row(line.split(","))
                        else:
                            add_row([line])
            except Exception:
                pass
    except Exception:
        rows = []

    # Fallback: use the app's existing best-effort text extraction and parse lines/tables from it.
    if not rows:
        txt = read_text_from_file_best_effort(path)
        # Native/selectable-text PDFs can flatten price tables into clean one-line rows.
        # Return them directly here instead of forcing them through the generic cell parser.
        try:
            if ext == ".pdf":
                flat_rows = parse_rfq_materials_from_flat_price_text(txt, source_name=source_name)
                if flat_rows:
                    return flat_rows
        except Exception:
            pass
        for line in (txt or "").splitlines()[:1800]:
            line = line.strip()
            if not line:
                continue
            if "|" in line:
                add_row(line.split("|"))
            else:
                add_row([line])

    header_map = {}
    items = []
    seen = set()

    def col_kind(value):
        v = str(value or "").strip().lower()
        if v in ["qty", "quantity", "quan", "count"]:
            return "qty"
        if v in ["uom", "unit", "units", "um"]:
            return "unit"
        if any(x in v for x in ["part", "catalog", "cat #", "cat#", "item #", "item#", "model", "mfr #", "sku"]):
            return "part_number"
        if any(x in v for x in ["description", "material", "item description", "product", "name"]):
            return "description"
        if any(x in v for x in ["manufacturer", "mfg", "brand"]):
            return "manufacturer"
        return ""

    def looks_like_non_item(line):
        low = line.lower()
        bad = ["unsubscribe", "confidential", "terms and conditions", "page ", "quote request", "ship to", "bill to", "subtotal", "total", "tax", "extension", "price", "unit price"]
        return any(x in low for x in bad)

    def add_item(qty="", unit="", part="", desc="", mfr="", notes=""):
        desc = re.sub(r"\s+", " ", str(desc or "").strip(" -:;"))
        part = str(part or "").strip().upper()
        qty = str(qty or "").strip()
        unit = str(unit or "").strip()
        mfr = str(mfr or "").strip()
        if desc and (not qty or not unit):
            q2, u2, d2 = split_qty_unit_description(desc)
            # v3.9.104: same guard as normalize_material_items -- only take the
            # stripped description when its leading number/unit was consumed into
            # qty/unit, so a description like "22.5 deg" or "3/4\" EMT" never
            # silently loses its leading number when qty is already filled.
            if not qty and q2:
                qty = q2
                if not unit and u2:
                    unit = u2
                if d2:
                    desc = d2
            elif not unit and u2 and not q2:
                unit = u2
                if d2:
                    desc = d2
        if not desc and part:
            desc = part
        if not desc or len(desc) < 2 or looks_like_non_item(desc):
            return
        # Avoid returning a lonely generic material type when the full line has useful specs.
        if desc.lower() in ["emt", "pvc", "wire", "conduit"] and not qty and not part:
            return
        key = re.sub(r"\s+", " ", f"{qty}|{unit}|{part}|{desc}|{mfr}".lower()).strip()
        if key in seen and not keep_duplicates:
            return
        seen.add(key)
        items.append({"qty": qty, "unit": unit, "part_number": part, "description": desc, "manufacturer": mfr, "notes": notes, "source": f"structured:{source_name}"})

    for cells in rows:
        joined = " | ".join(cells).strip()
        if not joined or len(joined) < 2:
            continue
        kinds = [col_kind(c) for c in cells]
        if any(kinds):
            header_map = {kind: idx for idx, kind in enumerate(kinds) if kind}
            continue
        if header_map and len(cells) >= 2:
            def get(kind):
                idx = header_map.get(kind)
                return cells[idx] if idx is not None and idx < len(cells) else ""
            add_item(get("qty"), get("unit"), get("part_number"), get("description") or joined, get("manufacturer"))
            continue

        # No reliable header: infer from cells/line.
        qty = unit = part = mfr = ""
        desc_cells = []
        for c in cells:
            c_str = str(c).strip()
            if not c_str:
                continue
            if not qty:
                q2, u2, d2 = split_qty_unit_description(c_str)
                if q2 and d2 and d2 != c_str:
                    qty, unit = q2, u2
                    desc_cells.append(d2)
                    continue
            if not qty and re.fullmatch(r"\d{1,3}(?:,\d{3})+|\d+(?:\.\d+)?", c_str):
                qty = c_str
                continue
            if qty and not unit and re.fullmatch(r"ft|feet|foot|in|inch|ea|each|pc|pcs|box|roll|set|lot|m|c", c_str, flags=re.I):
                unit = c_str
                continue
            if not part and re.search(r"[A-Za-z]", c_str) and re.search(r"\d", c_str) and len(c_str) <= 35 and not re.search(r"\s{2,}|\b(the|and|with|for)\b", c_str, re.I):
                part = c_str
                continue
            desc_cells.append(c_str)
        desc = " ".join(desc_cells).strip() if len(cells) > 1 else joined
        add_item(qty, unit, part, desc, mfr)
        if len(items) >= 160:
            break

    return normalize_material_items(items, keep_duplicates=keep_duplicates)

def format_materials_for_email(materials):
    """Format RFQ line items for vendor emails.

    Keep explicit units visible. In particular, EA/each must display as "ea"
    instead of being converted to "x" in the drafted RFQ email.
    """
    lines = []
    for item in normalize_material_items(materials or []):
        qty = str(item.get("qty", "") or "").strip()
        unit = str(item.get("unit", "") or "").strip()
        part = str(item.get("part_number", "") or "").strip()
        desc = str(item.get("description", "") or "").strip()
        mfr = str(item.get("manufacturer", "") or "").strip()
        left = ""
        if qty:
            unit_l = unit.lower()
            if unit_l in ["ea", "each"]:
                left = f"{qty} ea"
            elif unit_l == "x" or not unit_l:
                left = f"{qty}x"
            else:
                left = f"{qty} {unit}"
        bits = []
        if part:
            bits.append(part)
        if desc:
            bits.append(desc)
        main = " - ".join(bits).strip(" -")
        line = (left + " - " + main).strip(" -") if left else main
        if mfr:
            line += f" ({mfr})"
        if line:
            lines.append("- " + line)
    return "\n".join(lines).strip()


def split_qty_unit_description(line):
    """Parse trade RFQ lines such as:
    100ft- 3/4" emt
    25- 632s
    1,000ft 4" PVC
    """
    raw = re.sub(r"^[\-•*\s]+", "", str(line or "")).strip()
    raw = raw.replace("\u2013", "-").replace("\u2014", "-")
    raw = re.sub(r"\s+", " ", raw)
    qty = ""
    unit = ""
    desc = raw

    # Supports qty stuck to unit, with or without a dash:
    # 100ft- 3/4 emt, 1,000ft 4" PVC, 25- 632s, 12 ea HBL5362
    m = re.match(
        r"^(\d{1,3}(?:,\d{3})+|\d+(?:\.\d+)?)\s*"
        # v4.2.71 (Roger Ezri: "100' - 1-5/8\" 316 stainless steel Strut"): a FOOT MARK
        # glued to the leading quantity is footage. Only ' / ′ -- the inch mark is
        # deliberately excluded: '2" x 4" box' is a size-first line, and treating its
        # leading 2" as qty-2-inches would mangle every such line.
        r"(x|ea\.?|each|pcs?\.?|pc\.?|ft\.?|feet|foot|in\.?|inch(?:es)?|lbs?\.?|rolls?|sets?|bags?|boxes?|box|lengths?|lot|m|mm|c|cy|sf|lf|sy|'|′)?"
        r"\s*(?:[-:])?\s+(.+)$",
        raw,
        flags=re.I,
    )
    if m:
        qty = m.group(1).replace(",", "").strip()
        unit = re.sub(r"\.$", "", (m.group(2) or "").strip())
        desc = (m.group(3) or "").strip()
        # v4.2.61 (Steve's live test: '1 box1/4 x 1-1/4" screws'): a unit glued
        # straight to the SIZE falls through the unit alternation (needs \s or
        # dash after) and lands in desc as 'box1/4...'. When no unit was parsed
        # and desc STARTS with unit-word+digit, split it back out.
        if not unit:
            gm = re.match(r"^(box(?:es)?|bags?|pcs?|pc|ea|each|rolls?|sets?|lengths?)(?=\d)(.+)$",
                          desc, flags=re.I)
            if gm:
                unit = gm.group(1)
                desc = gm.group(2).strip()
    else:
        # Also supports 100ft-3/4" EMT with no space after the unit/dash.
        m = re.match(
            r"^(\d{1,3}(?:,\d{3})+|\d+(?:\.\d+)?)"
            r"(ft\.?|feet|foot|in\.?|inch(?:es)?|ea\.?|each|pcs?\.?|pc\.?|lbs?\.?|rolls?|sets?|bags?)\b"
            r"\s*[-:]?\s*(.+)$",
            raw,
            flags=re.I,
        )
        if m:
            qty = m.group(1).replace(",", "").strip()
            unit = re.sub(r"\.$", "", (m.group(2) or "").strip())
            desc = (m.group(3) or "").strip()

    unit_map = {
        "feet": "ft", "foot": "ft",
        "'": "ft", "′": "ft",   # v4.2.71: foot mark on a leading qty ("100' - ...")
        "inch": "in", "inches": "in",
        "each": "ea",
        "pc": "pc", "pcs": "pc",
        "boxes": "box",
        "bags": "bag",
        "rolls": "roll",
        "lengths": "length",
        "sets": "set",
        "lbs": "lb",
    }
    unit = unit_map.get(unit.lower(), unit.lower() if unit else "")
    desc = desc.strip(" -:;")
    return qty, unit, desc


def extract_materials_from_quote_text(text, max_items=120, keep_duplicates=False):
    """Deterministic fallback for plain email-body RFQs.

    This is intentionally line-based so customer emails like:
        100ft- 3/4" emt
        25- 632s
        1,000ft 4" PVC
    open the Quote RFQ window with real rows even when Ollama is off/busy.
    """
    text = text or ""
    # v4.1.13: Outlook and vendor emails routinely carry UNICODE vulgar fractions and curly
    # quotes ('\u00be\u201d EMT' for 3/4" EMT). The size/qty regexes below are ASCII, so a line like
    # '25ea \u00be\u201d connectors' had no recognizable digits and was dropped. Normalize them first.
    try:
        for _u, _a in ((u"\u00bc", "1/4"), (u"\u00bd", "1/2"), (u"\u00be", "3/4"),
                       (u"\u2153", "1/3"), (u"\u2154", "2/3"), (u"\u215b", "1/8"),
                       (u"\u215c", "3/8"), (u"\u215d", "5/8"), (u"\u215e", "7/8"),
                       (u"\u201c", '"'), (u"\u201d", '"'), (u"\u2018", "'"), (u"\u2019", "'"),
                       (u"\u2033", '"'), (u"\u2032", "'")):
            if _u in text:
                text = text.replace(_u, _a)
    except Exception:
        pass
    # v4.1.98: SPELLED-OUT QUANTITIES. Reported live on CM31026, where 'Send to RFQ'
    # returned two rows -- both STREET ADDRESSES -- and dropped all seven real items. Every
    # item was written the way this customer always writes them:
    #     One (1) box 1/4" nuts
    #     One (1) case Decora 20A outlets white
    #     One (1) roll 12/2 MC
    # The parser needs a LEADING NUMERAL, so every one of those lines was invisible, while
    # '10 East 40th Street' and '160 21ST STREET' parsed perfectly as qty 10 and qty 160.
    # Rewrite the word+parenthetical form to the numeral the parser already understands, so
    # 'One (1) box 1/4" nuts' becomes '1 box 1/4" nuts'. Text-level and additive: a line that
    # already starts with a digit is untouched, and the parenthetical numeral is the
    # customer's OWN quantity, so nothing is inferred.
    try:
        text = re.sub(
            r"(?im)^([ \t]*)(?:one|two|three|four|five|six|seven|eight|nine|ten|eleven|"
            r"twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty)?"
            r"[ \t]*\((\d{1,4})\)[ \t]+",
            lambda m: "%s%s " % (m.group(1), m.group(2)), text)
    except Exception:
        pass
    # v4.2.5: PURCHASE-ORDER LINE ITEMS -- the quantity was the LINE NUMBER.
    # Reported live on "PO: CPCJ384" (REZRI@EJ1899.COM). The attachment is a fixed-width PO:
    #
    #   TX LN ITEM CODE       DESCRIPTION                  QTY ORD    PRICE/UM        EXT
    #   *   1 CUSTOM1         WLK RFBAS1                         6   819.50/1C      49.17
    #   *   2 CUSTOM2         WLK RFBADP                        50   819.50/1C     409.75
    #   *   3 78358523623     HBL2810 LKG RCPT-NMA L21-30R       6 2,978.00/1C     178.68
    #
    # The parser takes the FIRST number on a line as the quantity, so it read the LN column
    # and produced qty 1/2/3 instead of 6/50/6, leaving the real QTY ORD plus the PRICE/UM
    # and EXT columns glued onto the description ("CUSTOM1 WLK RFBAS1 6 819.50/1C 49.17").
    # Reproduced exactly against the real attachment before this was written.
    #
    # Rewrite such a row to "<QTY ORD> <ITEM CODE> <DESCRIPTION>" so the existing parser sees
    # the right quantity and a clean description. Text-level and additive, matching the
    # v4.1.13 / v4.1.82 / v4.1.98 pre-normalisation passes above.
    #
    # TWO GATES keep this off ordinary RFQ text: the document must contain a PO table HEADER
    # (LN + ITEM CODE + QTY + PRICE), and each row must end in the PRICE/UM + EXT shape --
    # a decimal price with a unit-of-measure suffix followed by a decimal extension. A plain
    # customer line like "6 819.50" can never satisfy that, and SUBTOTAL/TOTAL rows carry no
    # leading line number so they are untouched.
    try:
        if re.search(r"(?im)^.*\bLN\b.*\bITEM\s+CODE\b.*\bQTY\b.*\bPRICE\b.*$", text):
            _po_row = re.compile(
                r"(?im)^[ \t]*\*?[ \t]*(\d{1,4})[ \t]+(\S+)[ \t]+(.+?)[ \t]+"
                r"(\d[\d,]*(?:\.\d+)?)[ \t]+([\d,]+\.\d{2})/(\w+)[ \t]+([\d,]+\.\d{2})[ \t]*$")

            def _po_fix(m):
                _qty = m.group(4).replace(",", "")
                _code = m.group(2).strip()
                _desc = m.group(3).strip()
                return "%s %s %s" % (_qty, _code, _desc)

            text = _po_row.sub(_po_fix, text)
    except Exception:
        pass

    rows = []
    seen = set()

    skip_bits = [
        "unsubscribe", "confidential", "from:", "sent:", "to:", "subject:",
        "regards", "thank you", "thanks", "external email", "caution:",
        "original message", "forwarded message", "www.", "http://", "https://",
    ]
    # v4.1.82: PLURALS. 'boxes' failed \bbox\b, so the real production line
    # '30 - Grand slam boxes' was dropped (qty parsed fine; the keep-gate found no
    # material word). Additive only: every singular still matches exactly as before,
    # and the gate still requires a leading qty, so prose lines are unaffected.
    material_words = re.compile(
        # v4.1.98: vocabulary gap found on CM31026 -- 'One (1) case Decora 20A outlets white'
        # was dropped because 'outlets' was absent (receptacles was there, outlets was not),
        # 'Decora' carries no digits so it is not a catalog token, and '20A' is too short to
        # be one. Added the everyday synonyms an electrical customer actually writes.
        r"\b(emt|pvc|rigid|imc|conduits?|wires?|cables?|breakers?|disconnects?|receptacles?|"
        r"outlets?|devices?|dimmers?|decora|plates?|covers?|nuts?|bolts?|screws?|anchors?|"
        r"shields?|nipples?|bushings?|lugs?|hangers?|clamps?|whips?|mc|bx|thhn|romex|"
        r"switch(?:es)?|box(?:es)?|connectors?|couplings?|straps?|struts?|pipes?|elbows?|"
        r"bends?|fittings?)\b",
        re.I,
    )

    # v4.1.82: TWO-LINE ITEMS. Real RFQ bodies split one item across two lines:
    #     30 - Grand slam boxes
    #     hubbell gs12124snk
    # The part line alone has no qty and was always dropped. Join a qty-dash line
    # with the FOLLOWING short line when that line has no qty of its own, carries a
    # catalog-style token (letters+digits fused, len>=5), and shows no price -- so a
    # vendor quote's '$5.00 each' continuation can never be absorbed into an item.
    try:
        _tl_lines = text.splitlines()
        _tl_out = []
        _tl_i = 0
        while _tl_i < len(_tl_lines):
            _cur = _tl_lines[_tl_i]
            _nxt_idx = _tl_i + 1
            while _nxt_idx < len(_tl_lines) and not str(_tl_lines[_nxt_idx]).strip():
                _nxt_idx += 1
            if (_nxt_idx < len(_tl_lines)
                    and re.match(r"^\s*(?:\d+[\.\)]\s+)?\d[\d,]*\s*[-:]\s+\S", _cur)):
                _nxt = str(_tl_lines[_nxt_idx]).strip()
                if (len(_nxt) <= 40 and "$" not in _nxt
                        and not re.match(r"^(?:\d+[\.\)]\s+)?\d[\d,]*\s*[-:]", _nxt)
                        and any(len(_t) >= 5 and any(c.isdigit() for c in _t) and any(c.isalpha() for c in _t)
                                for _t in re.split(r"[^A-Za-z0-9]+", _nxt))):
                    _tl_out.append(_cur.rstrip() + " " + _nxt)
                    _tl_i = _nxt_idx + 1
                    continue
            _tl_out.append(_cur)
            _tl_i += 1
        text = "\n".join(_tl_out)
    except Exception:
        pass

    for raw in text.splitlines():
        line = str(raw or "").strip()
        if not line:
            continue

        # Strip email wrapper labels while keeping actual short material lines.
        if line.startswith("---") and line.endswith("---"):
            continue
        low = line.lower()
        if any(bit in low for bit in skip_bits):
            continue

        # Remove bullets / numbering.
        line = re.sub(r"^[\s>*•\-]+", "", line).strip()
        line = re.sub(r"^\(?\d+\)?[\).]\s+", "", line).strip()

        qty, unit, desc = split_qty_unit_description(line)

        # If the line did not parse as qty + item, still allow known material words
        # or compact part-number-only lines that begin with a quantity.
        if not desc or desc == line:
            m = re.match(r"^(\d[\d,]*(?:\.\d+)?)\s*[-:]\s*(.+)$", line, flags=re.I)
            if m:
                qty = m.group(1).replace(",", "")
                desc = m.group(2).strip()
        # v4.1.82: FOOTAGE-LEAD wire specs. Real production lines like
        #   145' of each conductor x 4-conductor parallel of #3 AWG THHN stranded copper
        # start with apostrophe-footage and prose -- split_qty_unit_description returns
        # no qty and the line was dropped. Recognize a leading footage as the quantity;
        # the normal keep-gate below still applies (the AWG/size evidence keeps it, a
        # prose line like "2 ft away from the panel" still dies for lack of evidence).
        if not qty and (not desc or desc == line):
            m = re.match(r"^(\d[\d,]*)\s*(?:'|ft\b|feet\b)\s*(?:of\s+)?(.{3,})$", line, flags=re.I)
            if m:
                qty = m.group(1).replace(",", "")
                unit = "ft"
                desc = m.group(2).strip()

        desc = (desc or "").strip(" -:;")
        if not desc or len(desc) < 2:
            continue

        # Avoid conversational sentences unless they contain very clear item structure.
        has_qty = bool(qty)
        has_material_word = bool(material_words.search(desc))
        compact_part = bool(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/#\-]{1,30}", desc))
        has_size = bool(re.search(r'\b\d+(?:/\d+)?\s*(?:"|in|inch|ft|mm|awg)?\b', desc, re.I))
        # v4.1.11: a catalog-style token (letters+digits fused, like 5751WH or BIBS3504DB) is
        # item evidence just as strong as a material word or a standalone size. Without it,
        # an RFQ line like '400 - 5751WH Single gang extension' was dropped: the only digits
        # are fused inside the part code, 'extension' is not in material_words, and the desc
        # is not a bare part. Computed here (hoisted from the priced-line rescue below, which
        # now reuses it) and REQUIRING a leading qty, so prose lines are unaffected.
        _has_catalog_tok = any(
            len(_t) >= 4 and any(c.isdigit() for c in _t) and any(c.isalpha() for c in _t)
            for _t in re.split(r"[^A-Za-z0-9]+", desc)
        )
        # v4.1.98: a STREET ADDRESS is never a material line. On CM31026 the only two rows
        # that survived were '10 East 40th Street' (qty 10) and '160 21ST STREET' (qty 160):
        # the house number satisfies has_qty and '40th' / '21ST' read as catalog tokens
        # (letters+digits fused), so the gate passed. Requires the line to carry NO material
        # word, so a genuine '100 ft #6 THHN to 37 Ramland Rd' is unaffected.
        # NOTE: by this point the leading house number has ALREADY been split off as the
        # quantity, so the test is on what REMAINS -- 'East 40th Street', '21ST STREET' --
        # which is why it keys on the street-type suffix rather than a leading number.
        _desc_s = str(desc or "").strip()
        _looks_addr = bool(
            not has_material_word and len(_desc_s) <= 60
            and re.search(r"\b(?:st|street|ave|avenue|rd|road|blvd|boulevard|ln|lane|dr|drive|"
                          r"way|pkwy|parkway|hwy|highway|ct|court|pl|place|ter|terrace)\b\.?\s*$",
                          _desc_s, re.I))
        keep_line = bool(has_qty and not _looks_addr
                         and (has_material_word or compact_part or has_size or _has_catalog_tok))
        if not keep_line:
            # v3.9.59: rescue a vendor QUOTE line that has a price + product but NO leading
            # quantity. Vendor pricing replies read "<product> ... $<price>/MFT" (e.g.
            #   "#4AWG RHW-USE Insulated Copper Wire GREEN - 6 reels, 1000' each - $762.14/MFT")
            # where the line STARTS with the gauge "#4AWG", not a number, so split_qty_unit_
            # description() returns qty="" and the whole line was dropped here. With zero priced
            # lines parsed, update_coverage_quoted_from_sent() had nothing to match and every
            # requested item stayed "Waiting" even after the vendor quoted it. This is the
            # quoted-side twin of the v3.9.58 requested-side fix. Gated on a real price so plain
            # RFQ bodies (no prices) are completely unaffected; also requires a product
            # word / compact part / catalog-style token so bare price notes like "$33/Stripe"
            # or "+freight to job" are NOT turned into phantom quoted items.
            _has_money = bool(re.search(r"\$\s*\d|\b\d+\.\d{2}\b", line))
            # v4.1.11: _has_catalog_tok is now computed once above the main gate.
            if _has_money and (has_material_word or compact_part or _has_catalog_tok):
                keep_line = True
        if not keep_line:
            continue

        part = ""
        if compact_part and not has_material_word and not has_size:
            part = desc.upper()

        item = {
            "qty": qty,
            "unit": unit,
            "part_number": part,
            "description": desc,
            "manufacturer": "",
            "notes": "",
            "source": "email-body-simple",
            "selected": True,
        }
        key = re.sub(r"\s+", " ", f"{qty}|{unit}|{part}|{desc}".lower()).strip()
        if key in seen and not keep_duplicates:
            continue
        seen.add(key)
        rows.append(item)
        if len(rows) >= max_items:
            break

    return normalize_material_items(rows, keep_duplicates=keep_duplicates)


def material_display_text(item):
    qty = str(item.get("qty", "") or "").strip()
    unit = str(item.get("unit", "") or "").strip()
    desc = str(item.get("description", "") or "").strip()
    part = str(item.get("part_number", "") or "").strip()
    if part and part.lower() not in desc.lower():
        desc = (part + " - " + desc).strip(" -")
    left = " ".join([x for x in [qty, unit] if x]).strip()
    return (left + " - " + desc).strip(" -") if left else desc


def normalize_material_items(materials, keep_duplicates=False):
    # v4.1.25 (external audit round 7, blocker #2): keep_duplicates=True preserves
    # genuinely repeated identical rows (two '10 EA 632S' lines in one BOM are two
    # separate requirements) for the coverage path; default behavior is unchanged
    # for every other caller.
    cleaned = []
    seen = set()
    for item in materials or []:
        if isinstance(item, str):
            item = {"description": item}
        if not isinstance(item, dict):
            continue
        desc = str(item.get("description", "") or "").strip()
        part = str(item.get("part_number", "") or "").strip()
        qty = str(item.get("qty", "") or "").strip()
        unit = str(item.get("unit", "") or "").strip()
        if desc and (not qty or not unit):
            q2, u2, d2 = split_qty_unit_description(desc)
            # v3.9.104: only rewrite the description when the number/unit the split
            # pulled OFF the front is actually CONSUMED into the qty/unit fields.
            # Previously, a row that already had a qty but no unit still took the
            # stripped remainder (d2) -- so "22.5 deg" became "deg" and "45 deg"
            # became "deg": the split extracted 22.5/45 as a would-be quantity,
            # threw it away (qty was already set), and the description silently
            # lost its leading number. That is why multi-word descriptions showed
            # only their last word in the RFQ grid and the vendor email body.
            if not qty and q2:
                qty = q2
                if not unit and u2:
                    unit = u2
                if d2:
                    desc = d2
            elif not unit and u2 and not q2:
                unit = u2
                if d2:
                    desc = d2
        if not desc and part:
            desc = part
        if not desc:
            continue
        key = re.sub(r"\s+", " ", f"{qty}|{unit}|{part}|{desc}".lower()).strip()
        if key in seen and not keep_duplicates:
            continue
        seen.add(key)
        rec = dict(item)
        rec["qty"] = qty
        rec["unit"] = unit
        rec["description"] = desc
        rec["part_number"] = part
        rec.setdefault("notes", "")
        rec.setdefault("selected", True)
        cleaned.append(rec)
    return cleaned


_NUMBERED_QTY_LINE_RE = re.compile(
    r"^\s*\d{1,3}\s*[.)]\s*\(\s*(?P<qty>[^)]{1,24}?)\s*\)\s*[-–—]?\s*(?P<rest>\S.*)$")
_NUMBERED_QTY_SPLIT_RE = re.compile(
    r"^(?P<n>[\d,]+)\s*(?P<unit>['’′]|ft\.?|feet|lf|ea\.?|pcs?\.?|pk|"
    r"x\s*\d+\s*pk|sets?|rolls?|boxes|bx)?\s*$", re.I)
_NUMBERED_KNOWN_MFR = (
    "thomas and betts", "thomas & betts", "hubbell", "raco", "bell", "unistrut",
    "burndy", "steel city", "panduit", "appleton", "crouse", "wago", "caddy",
    "arlington", "bridgeport", "cantex", "carlon", "eaton", "square d", "t&b")
# A BARE 5-digit number is NOT a zip code. 54212 / 54211 / 54136 / 54210 / 54209 are real
# Thomas & Betts part numbers, and a bare-\d{5} address guard silently dropped 7 of the 35
# items on the reported "hubbell raco" RFQ. Require a real address word, or STATE + zip.
_NUMBERED_ADDRESSY_RE = re.compile(
    r"(?i)(?:\b(?:street|avenue|road|blvd|suite|floor)\b"
    r"|\b(?:st|ave|rd|fl)\.\s"
    r"|\b[A-Z]{2}\s+\d{5}(?:-\d{4})?\b)")


def extract_numbered_qty_list_from_body(text):
    """v4.2.21: parse a NUMBERED material list typed into an email body, where the
    quantity is in parentheses:

        1.  (20) 4/0 - Thomas and Betts 54212 Compression Lug
        8.  (100) Raco Mfr #1402 - IMC Bushing, 1/2 in
        10. (40') Unistrut P1000T-10PG - 13/16" Unistrut, Shallow
        12. (5 x 10pk) Channel Toggle Anchor: Mfr. Model U63266.037.0001

    Reported live on "hubbell raco" from Jeff Wilson: 35 items in this exact shape.
    extract_typed_list_materials_from_body returned ONE row for that body -- and it was
    "North 63rd Street" off the signature -- while extract_materials_from_quote_text
    returned zero. With no deterministic rows the body fell through to llama3.2:3b, which
    took minutes and produced a single row, "391-3602", that came from a DIFFERENT email
    in the thread and was a phone number.

    Deliberately conservative: the parenthesised quantity is REQUIRED, so prose and
    signature lines cannot match, and "(TBD)" is rejected because it is not a number.
    "(5 x 10pk)" keeps qty=5 with the raw text in notes rather than silently multiplying
    to 50 -- guessing there is how a quote ends up ten times oversized.
    """
    rows = []
    for raw in str(text or "").splitlines():
        m = _NUMBERED_QTY_LINE_RE.match(raw)
        if not m:
            continue
        qty_txt = (m.group("qty") or "").strip()
        rest = (m.group("rest") or "").strip()
        if len(rest) < 3 or _NUMBERED_ADDRESSY_RE.search(rest):
            continue
        qm = _NUMBERED_QTY_SPLIT_RE.match(qty_txt)
        if not qm:
            continue
        qty = (qm.group("n") or "").replace(",", "")
        unit = (qm.group("unit") or "").strip()
        if unit in ("'", "’", "′"):
            unit = "ft"
        low = rest.lower()
        mfr = ""
        for known in _NUMBERED_KNOWN_MFR:
            if known in low:
                i = low.index(known)
                mfr = rest[i:i + len(known)]
                break
        part = ""
        head = re.split(r"\s+[-–—]\s+", rest)[0]
        pm = re.search(r"\b([A-Z0-9][A-Z0-9\-/\.]{3,}[A-Z0-9])\b", head)
        if pm and not pm.group(1).isdigit():
            part = pm.group(1)
        rows.append({
            "qty": qty, "unit": unit, "part_number": part, "manufacturer": mfr,
            "description": rest,
            "notes": ("raw qty: %s" % qty_txt) if "x" in qty_txt.lower() else "",
            "source": "email-body-numbered-list",
        })
    return rows


# v4.2.47: typed list where the QUANTITY comes LAST with a footage marker:
#     #4/0 AWG GREEN - 2,000'
# (the "Wire Quote - JFK New Terminal One" shape: 24 such lines forwarded by an
# employee from Outlook iOS; every existing body parser expects qty FIRST, so
# the extractor returned zero items on a body that plainly listed all 24).
_QTY_LAST_LINE_RE = re.compile(
    r"^\s*(?:[-*•]\s*)?"
    r"(?P<rest>#?\S.*?\S)"
    r"\s*[-–—]\s*"
    r"(?P<qtyword>qty\.?\s*[:#]?\s*)?"
    r"(?P<n>\d{1,3}(?:,\d{3})+|\d+)"
    r"\s*(?P<unit>['’′]|ft\.?|feet|lf|ln\s*ft|ea\.?|each|pcs?\.?|pieces?|box(?:es)?|sets?|rolls?|bags?|lengths?)?\s*\.?\s*$",
    re.IGNORECASE)


_REQ_SENTENCE_ITEM_RE = re.compile(
    r"(?:price\s+and\s+availability|pricing\s+and\s+availability|quote|pricing|price"
    r"|(?:also\s+)?need|and)\s+"
    r"(?:(?:for|on)\s+)?"
    r"(?P<n>\d[\d,]*)\s*"
    r"(?P<unit>ft\.?|feet|foot|pcs?\.?|pc\.?|ea\.?|each|box(?:es)?|bags?|rolls?|sets?|lengths?|lf)?\s*"
    r"(?:of\s+)?(?:the\s+)?"
    # v4.2.78: LAZY description that stops at the next continuation ("and 500ft",
    # "also need 10") or sentence end -- greedy matching swallowed every following
    # item into the first item's description.
    r"(?P<desc>[^.;?\r\n]{3,80}?)"
    r"(?=\s+(?:and|also|plus)\s+\d|\s*[.;?!\r\n]|\s*$)",
    re.IGNORECASE)


def extract_request_sentence_items(text):
    """v4.2.63 (Steve's live test: 'please provide me with price and availability
    for 100ft of 1-5/8\" strut.'): pull an item out of the REQUEST SENTENCE
    itself -- '<request phrase> for/on <qty><unit> of <desc>'. The line parsers
    cannot see prose, and a mid-sentence single item is a real customer shape.
    Conservative: anchored to an explicit request phrase, and the item must
    carry a UNIT or a size-ish character (digit/quote/fraction) in its
    description -- 'for 5 minutes' / 'for 3 jobs' cannot match.

    v4.2.78 (Steve): 'for/on' is now optional ('can you quote 25 EMT connectors'),
    and 'and <qty> ...' / 'also need <qty> ...' continuations are anchors too, so a
    multi-item request sentence yields every item, not just the first. The
    unit-or-size-ish guard below is unchanged and still rejects 'and 3 others'."""
    rows = []
    for m in _REQ_SENTENCE_ITEM_RE.finditer(str(text or "")):
        qty = (m.group("n") or "").replace(",", "")
        unit = re.sub(r"\.$", "", (m.group("unit") or "").strip().lower())
        desc = (m.group("desc") or "").strip().rstrip(",?!").strip()
        if not qty or len(desc) < 3 or not re.search(r"[A-Za-z]", desc):
            continue
        if not unit and not re.search(r"[\d\"'/]", desc):
            continue  # no unit AND no size-ish char -> too weak ('for 3 jobs')
        if unit in ("feet", "foot"):
            unit = "ft"
        elif unit in ("each",):
            unit = "ea"
        elif unit in ("pcs", "pc"):
            unit = "pc"
        elif unit in ("boxes",):
            unit = "box"
        rows.append({"qty": qty, "unit": unit, "part_number": "", "manufacturer": "",
                     "description": desc, "notes": "",
                     "source": "email-body-request-sentence"})
    return rows


def extract_qty_last_list_from_body(text):
    """Parse `<item> - <qty>` lines where the QUANTITY comes last. Deliberately
    conservative: requires the dash separator AND either an explicit unit at the
    line end (' / ft / feet / lf, and since v4.2.78 also ea / pcs / boxes / sets /
    rolls / bags / lengths) OR an explicit "qty" keyword ("<item> - qty 25"), so
    prose like \"1,000' reels max.\" (no dash before the number), phone numbers,
    bare trailing numbers and signature lines cannot match; the description must
    contain a letter and survives the same address guard as the numbered
    parser. Callers additionally require >= 2 matching lines."""
    rows = []
    for raw in str(text or "").splitlines():
        m = _QTY_LAST_LINE_RE.match(raw)
        if not m:
            continue
        # v4.2.78: a bare trailing number ("Building 4 - 10") is still rejected --
        # accept only an explicit unit or an explicit "qty" marker.
        if not (m.group("unit") or m.group("qtyword")):
            continue
        rest = (m.group("rest") or "").strip()
        if len(rest) < 3 or not re.search(r"[A-Za-z]", rest):
            continue
        if _NUMBERED_ADDRESSY_RE.search(rest):
            continue
        qty = (m.group("n") or "").replace(",", "")
        unit = re.sub(r"\.$", "", (m.group("unit") or "").strip().lower())
        if unit in ("'", "’", "′", "ft", "feet", "lf") or unit.startswith("ln"):
            unit = "ft"
        elif unit == "each":
            unit = "ea"
        elif unit in ("pcs", "pc", "pieces", "piece"):
            unit = "pc"
        elif unit == "boxes":
            unit = "box"
        rows.append({
            "qty": qty, "unit": unit, "part_number": "", "manufacturer": "",
            "description": rest, "notes": "",
            "source": "email-body-qty-last-list",
        })
    return rows


def _material_merge_key(item):
    """Cross-source identity: normalized part number when there is one, else the
    normalized description. Deliberately NOT normalize_material_items' key, which
    includes the FULL description -- the same part written two ways ("HUBBELL - HBL2320
    - NEMA L6-20R" vs "HBL2320 Receptacle") would survive as two rows."""
    part = re.sub(r"[^a-z0-9]", "", str((item or {}).get("part_number", "") or "").lower())
    if part:
        return "p:" + part
    desc = re.sub(r"[^a-z0-9]", " ", str((item or {}).get("description", "") or "").lower())
    return "d:" + re.sub(r"\s+", " ", desc).strip()[:60]


def merge_material_sources(attachment_rows, body_rows):
    """v4.2.21: merge body-typed rows into attachment-derived rows.

    Reported: "what if the customer puts some info in the body and an attachment?" --
    they did not both get read. The body pass was gated on
    (saved_count == 0 or existing_count == 0), so ONE row from an attachment silenced the
    body entirely and any items typed there were lost with nothing in the log to say so.

    Rules, per Steve:
      * same part AND same qty  -> one row (a genuine duplicate across sources)
      * same part, DIFFERENT qty -> KEEP BOTH and flag; that is far more likely a revision
        than a duplicate, and silently picking one is how material goes missing
      * anything only one source saw -> kept

    Only rows the DETERMINISTIC body parser produced are passed in here. That matters:
    the CPCJ384 incident happened because the email-body fallback was handed `quote_text`,
    which by then also contained every attachment's extracted text, so the body parser
    re-parsed the attachments. These rows never see attachment text at all.

    Returns (merged_rows, duplicates_skipped, qty_conflicts).
    """
    merged = list(attachment_rows or [])
    have = {}
    for r in merged:
        have.setdefault(_material_merge_key(r), []).append(str(r.get("qty", "") or "").strip())
    dupes = 0
    conflicts = 0
    for r in (body_rows or []):
        key = _material_merge_key(r)
        qty = str(r.get("qty", "") or "").strip()
        if key in have:
            if qty in have[key]:
                dupes += 1
                continue
            conflicts += 1
            r = dict(r)
            r["notes"] = (str(r.get("notes", "") or "") +
                          " [qty differs from the attachment (%s vs %s) - both kept, please "
                          "confirm]" % (qty or "?", ", ".join(x or "?" for x in have[key]))).strip()
        merged.append(r)
        have.setdefault(key, []).append(qty)
    return merged, dupes, conflicts


def extract_typed_list_materials_from_body(text):
    """v3.9.52: parse a plain typed material list pasted directly into an email body --
    one item per line, e.g.:
        - 500 mcm - CU black
        - 50 ft - 750 AL BRBW X 4 SETS
    -- line-by-line via split_qty_unit_description.

    This exists because such bodies must NOT be routed through SmartScan's attachment/table
    parser. That parser is built for document tables/columns and corrupts a plain typed list:
    it turns the "X N SETS" multiplier into its own phantom row (so "50 ft - 750 AL BRBW X 4
    SETS" leaks an extra "4 ft - 750 AL BRBW" line) and drops real footages. A line-based parse
    keeps each line as exactly one item.

    Greetings, the "please provide price and availability" boilerplate, "this is for ...",
    and signatures are skipped. A wire-gauge token the unit list does not carry (mcm/kcmil/awg)
    is recognized so "500 mcm - CU black" stays clean instead of becoming "500 - mcm - CU black".
    Returns normalized material dicts.
    """
    rows = []
    seen = set()
    skip_bits = (
        "unsubscribe", "confidential", "from:", "sent:", "to:", "subject:", "cc:",
        "regards", "thank you", "thanks", "external email", "caution:", "original message",
        "forwarded message", "www.", "http://", "https://", "please provide", "can you provide",
        "price and availability", "this is for", "p&a",
    )
    for raw in (text or "").splitlines():
        line = re.sub(r"^[\s>*\u2022\u2013\-]+", "", str(raw or "")).strip()
        if len(line) < 3:
            continue
        low = line.lower()
        if any(b in low for b in skip_bits):
            continue
        # v3.9.58: recover the real quantity for lines whose number is NOT at the start.
        # A wire RFQ line pasted from a quote/sheet reads like:
        #   "#4AWG ... BROWN - 6 reels, 1000' each TRUE COLOR PREFERRED - STRIPED ACCEPTABLE    6000'"
        # The authoritative TOTAL (6000') sits in a right-aligned trailing column (tab or a
        # run of 2+ spaces); the mid-line "6 reels, 1000' each" is just the packaging
        # breakdown. Because the line starts with "#", split_qty_unit_description() returns
        # qty="" and the line was being DROPPED below (the "not qty" guard) -- so the body
        # never qualified as a clean typed list and was handed to BOTH SmartScan and the AI
        # fallback, each of which split the same line differently. That is what produced the
        # 3-4 duplicate, mangled Quote Coverage rows per real item.
        #   Preferred source: the trailing total column (what the sender typed as the qty).
        #   Fallback: if the body was flattened and that column is gone, compute reels x
        #   feet-each from the inline breakdown. Foot marks may be straight ('), curly
        #   (\u2019) or prime (\u2032).
        _forced_qty = ""
        _forced_unit = ""
        _mtrail = re.search(r"(?:\t| {2,})\s*(\d[\d,]*)\s*(?:['\u2019\u2032]|ft|feet)?\s*$", line)
        if _mtrail:
            _forced_qty = _mtrail.group(1).replace(",", "")
            _forced_unit = "ft"
            line = line[:_mtrail.start()].rstrip()
        if not _forced_qty:
            _mreels = re.search(
                r"(\d[\d,]*)\s*(?:reels?|rolls?|coils?|spools?|sets?)\b[^0-9]*?"
                r"(\d[\d,]*)\s*(?:['\u2019\u2032]|ft|feet)\s*(?:ea|each)\b",
                line, flags=re.I)
            if _mreels:
                try:
                    _forced_qty = str(int(_mreels.group(1).replace(",", "")) *
                                      int(_mreels.group(2).replace(",", "")))
                    _forced_unit = "ft"
                except Exception:
                    _forced_qty = ""
        qty, unit, desc = split_qty_unit_description(line)
        desc = (desc or "").strip(" -:;")
        if unit == "x":
            # v3.9.53: a trailing "x" on the quantity ("163x") is a count marker meaning
            # "163 of these", not a unit of measure. Drop it so the line displays as "163 - ..."
            # instead of "163 x - ...".
            unit = ""
        if not unit:
            _wg = re.match(r"^(mcm|kcmil|awg)\b\s*[-:]?\s*(.+)$", desc, flags=re.I)
            if _wg:
                unit = _wg.group(1).lower()
                desc = _wg.group(2).strip(" -:;")
        # v3.9.58: apply the trailing-column / computed total only when the line itself
        # carried no leading quantity, so the row is KEPT (with the real total) instead of
        # dropped for an empty qty. A genuine leading qty still wins.
        if not qty and _forced_qty:
            qty = _forced_qty
            if not unit:
                unit = _forced_unit or "ft"
        if not qty or not desc or len(desc) < 2:
            continue
        key = re.sub(r"\s+", " ", f"{qty}|{unit}|{desc}".lower()).strip()
        if key in seen:
            continue
        seen.add(key)
        rows.append({
            "qty": qty,
            "unit": unit,
            "part_number": "",
            "description": desc,
            "manufacturer": "",
            "notes": "",
            "source": "email-body-typed-list",
            "selected": True,
        })
    return normalize_material_items(rows)


def materials_to_email_lines(materials):
    return "\n".join(["- " + material_display_text(m) for m in normalize_material_items(materials) if material_display_text(m)]).strip()



