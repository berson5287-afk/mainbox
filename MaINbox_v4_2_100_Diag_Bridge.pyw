        return _coverage_compact_part_tokens_uncached(item)
    hit = _cov_memo_get(_COV_COMPACT_CACHE, ks)
    if hit is not None:
        return set(hit)
    out = _coverage_compact_part_tokens_uncached(item)
    _cov_memo_put(_COV_COMPACT_CACHE, ks, frozenset(out))
    return out


def _coverage_compact_part_tokens_uncached(item):
    """Distinctive catalog/part codes with internal separators removed, so a difference in
    formatting cannot block a match: '40A-SW-82-P', '40A.SW.82.P', '40A/SW/82/P' and the
    bare '40ASW82P' all collapse to '40ASW82P'. A token is either a run of alphanumerics
    joined by '-', '.', or '/', or an already-joined run of 6+ chars; after compacting it
    must be >= 6 chars and carry BOTH a letter and a digit -- long and mixed enough to
    identify a specific product rather than a bare size, quantity, or spec ('070in', '22').
    Read from part_number AND description so a code in either field matches the other side.
    This is what let the Champion quote go unmatched: the vendor's PDF quotes '40ASW82P'
    while the request was written '40A-SW-82-P', and every existing key either kept the
    hyphens or split on them, so the two never lined up."""
    try:
        if isinstance(item, str):
            item = {"description": item}
        if not isinstance(item, dict):
            return set()
        txt = (str(item.get("part_number", "") or "") + " " +
               str(item.get("description", "") or "")).upper()
        out = set()
        for m in re.finditer(r"[A-Z0-9]+(?:[\-./][A-Z0-9]+)+|[A-Z0-9]{6,}", txt):
            compact = re.sub(r"[^A-Z0-9]", "", m.group(0))
            if len(compact) < 6 or not any(c.isdigit() for c in compact) or not any(c.isalpha() for c in compact):
                continue
            # Skip a bare quantity/dimension: digits followed only by a unit word ('1000FT',
            # '500MCM', '250KCMIL'). Those are packaging/spec, not product identity, and two
            # different wires both sold in '1000ft' reels must not match on it. A real part
            # (letters embedded, e.g. '40ASW82P', or a trailing revision like '12345A') is kept.
            if re.fullmatch(r"\d+(?:FT|IN|LB|LBS|PC|PCS|MM|CM|AWG|MCM|KCMIL|OZ|YD|SF|LF|CY|SY|GA|KG|HP|KW|KVA|EA)", compact):
                continue
            out.add(compact)
        return out
    except Exception:
        return set()


