        tk.Label(win, text="Update Options", font=("Segoe UI", 16, "bold")).pack(pady=12)
        tk.Label(win, text="Enter a date to update emails received on or after that date.", font=("Segoe UI", 10)).pack(pady=4)
        date_frame = tk.Frame(win)
        date_frame.pack(pady=10)
