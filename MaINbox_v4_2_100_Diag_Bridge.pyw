        def progress_callback(message):
            if isinstance(message, dict) and message.get("type") == "rfq_page_result":
                def handle_page_event(evt=message):
                    try:
                        rows = normalize_material_items(evt.get("rows", []) or [])
                        # v4.2.0 (FINDING E): page-ready rows reach the RFQ window WITHOUT
                        # going through extract_materials_for_group, so they need the same
                        # letterhead pass or the live-scan path stays unprotected.
                        try:
                            self._deselect_letterhead_rows(rows, where="rfq_page_result")
                        except Exception:
                            pass
                        src_name = evt.get("source_name", "attachment")
                        page_no = evt.get("page_number", "")
                        add_progress_line(f"{src_name} page {page_no} is ready - added {len(rows)} row(s) to the RFQ window.")
                        updater = None
                        try:
                            updater = getattr(self, "_rfq_live_windows", {}).get(group_id)
                        except Exception:
                            updater = None
                        if updater:
                            updater(rows, src_name, page_no, evt.get("preview_path", ""))
                        elif rows:
                            # Open a partial RFQ window as soon as page 1 finishes so the user can review
                            # while later pages continue extracting in the background.
                            customer_hint_now = self.get_customer_hint_for_group(group, emails)
                            vendors_now = self.suggest_vendors_for_materials(rows, customer_hint_now)
                            self.open_quote_intelligence_window(group_id, rows, vendors_now, [f"{src_name} page {page_no}: page-ready result"], True)
                            updater = getattr(self, "_rfq_live_windows", {}).get(group_id)
                            if updater and evt.get("preview_path"):
                                updater([], src_name, page_no, evt.get("preview_path", ""))
                    except Exception as ev_exc:
                        add_progress_line(f"Page-ready UI update failed: {ev_exc}")
                self.root.after(0, handle_page_event)
            else:
                self.root.after(0, lambda m=message: add_progress_line(m))

        def worker():
            try:
                materials, quote_text, ocr_details, used_ai = self.extract_materials_for_group(group_id, progress_callback=progress_callback)
                customer_hint = self.get_customer_hint_for_group(group, emails)
                vendors = self.suggest_vendors_for_materials(materials, customer_hint)
                self.record_rfq_cache(group_id, materials=materials, vendors=vendors, ocr_details=ocr_details,
                                      used_ai=used_ai, quote_text=quote_text, group=group, emails=emails,
                                      customer_hint=customer_hint)
                def finish_and_open_or_update():
                    try:
                        updater = getattr(self, "_rfq_live_windows", {}).get(group_id)
                    except Exception:
                        updater = None
                    if updater:
                        updater(materials, "Final RFQ", "", "")
                        finish_progress(f"Finished. Extracted {len(materials)} material row(s). RFQ window is already open and updated.")
                    else:
                        finish_progress(f"Finished. Extracted {len(materials)} material row(s). Opening RFQ window...")
                        self.open_quote_intelligence_window(group_id, materials, vendors, ocr_details, used_ai)
                self.root.after(0, finish_and_open_or_update)
            except Exception as exc:
                err = str(exc)
                self.root.after(0, lambda e=err: finish_progress(f"RFQ extraction failed: {e}", success=False))
                self.root.after(0, lambda e=err: messagebox.showerror("Quote Intelligence Error", f"Could not scan this group.\n\n{e}"))
        threading.Thread(target=worker, daemon=True).start()

    def open_quote_intelligence_for_selected_email(self, email=None):
        """Open Quote RFQ directly from one selected email, no visible group required."""
        if email is None:
            emails = self.get_selected_emails()
            if not emails:
                 return
            email = emails[0]
        entry_id = str(email.get("entry_id", "") or "")
        if not entry_id:
            messagebox.showwarning("No Email Selected", "Select the customer quote request email first.")
            return

        # v4.1.9: anchor this job to a REAL group immediately. Use the email's existing group
        # when it has one; otherwise auto-create one containing the original request email.
        # The transient 'single_email_rfq:<entry_id>' id this path used before was never in
        # Groups, so the coverage ledger bound itself to a group that didn't exist: vendor
        # replies couldn't route back through the group, the sent RFQ trackers had no group to
        # file under, and reply-linking fell through to the loose cross-job fallback (which is
        # how another job's quote got attached to this one). With a real group: the original
        # email is a member now, the sent vendor-RFQ trackers file under it when they are
        # created, replies on those conversations route straight to this job's ledger, and the
        # Associated-emails view shows the group's own emails.
