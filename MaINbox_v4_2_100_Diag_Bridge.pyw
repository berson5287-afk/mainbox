    def _bridge_followup_id(self, lane, item, stamp=True):
        """v4.2.99: stable id for a follow-up record so the phone can address it.
        Records never carried an id (queue_ids are positional and recomputed on
        every render), so derive one from fields that never change after creation
        and stamp it on the record; it persists with the lane's next save."""
        fid = item.get("id")
        if isinstance(fid, str) and fid.startswith("fu_"):
            return fid
        raw = "|".join([
            str(lane), str(item.get("created_at") or ""), str(item.get("entry_id") or ""),
            str(item.get("conversation_id") or ""), str(item.get("subject") or ""),
            str(item.get("type") or ""), str(item.get("target_date") or ""),
        ])
        fid = "fu_" + hashlib.sha1(raw.encode("utf-8", "ignore")).hexdigest()[:14]
        if stamp:
            item["id"] = fid
        return fid

    def _bridge_followup_lanes(self):
        return (
            ("manual", self.followups or []),
            ("scenario", self.scenario_reminders or []),
            ("commitment", getattr(self, "commitment_reminders", None) or []),
        )

    def _bridge_active_followups(self):
        """Active (not completed / not cancelled) follow-ups from all three queue
        lanes, mapped to the bridge item schema the phone renders. v4.2.99: was
        manual-only with a positional id; now carries a stable id, the lane, the
        kind label, vendor + group, note and entry_id so the phone can show and
        address every row the desktop's Follow-Up Queue shows."""
        items = []
        for lane, coll in self._bridge_followup_lanes():
            for it in coll:
                if not isinstance(it, dict):
                    continue
                if it.get("completed") or it.get("cancelled"):
                    continue
                email = None
                try:
                    email = self.find_email_for_followup_item(it)
                except Exception:
                    email = None
                if lane != "manual" and isinstance(email, dict):
                    try:
                        if self.email_is_completed(email):
                            continue
                    except Exception:
                        pass
                vendor = ""
                group = ""
                if isinstance(email, dict):
                    vendor = email.get("sender", "") or email.get("sender_email", "")
                    try:
                        group = self.get_group_name_for_email(email.get("entry_id", "")) or ""
                    except Exception:
                        group = ""
                due_at = it.get("due_at", "")
                due_ts = None
                if due_at:
                    try:
                        due_ts = datetime.fromisoformat(due_at).timestamp()
                    except Exception:
                        due_ts = None
                if lane == "manual":
                    kind = "Manual follow-up"
                    note = it.get("message") or it.get("note") or ""
                elif lane == "scenario":
                    scenario_type = it.get("type", "scenario")
                    if scenario_type == "vendor_no_response":
                        kind = "Vendor no-response"
                    elif scenario_type == "customer_po_order_followup":
                        kind = "PO/order follow-up"
                    else:
                        kind = str(scenario_type).replace("_", " ").title()
                    note = it.get("note") or it.get("reason") or it.get("description") or ""
                else:
                    kind = it.get("kind_label", "Promised date")
                    note = it.get("note") or ""
                items.append({
                    "id": self._bridge_followup_id(lane, it),
                    "lane": lane,
                    "kind": kind,
                    "vendor": vendor,
                    "group": group,
                    "subject": it.get("subject", "") or (email.get("subject", "") if isinstance(email, dict) else ""),
                    "due": due_at,
                    "due_ts": due_ts,
                    "status": "open",
                    "note": note,
                    "category": it.get("category", ""),
                    "group_id": it.get("group_id", ""),
                    "entry_id": it.get("entry_id", "") or "",
                    "source": it.get("source", "") or "",
                    "snooze_label": it.get("snooze_label", "") or "",
                })
        items.sort(key=lambda i: i.get("due") or "9999")
        return items

    def _bridge_followups_signature(self, items):
        """Cheap change key so the snapshot is only re-published when it actually
        changes (avoids a disk write on every 4s tick)."""
        return tuple(sorted(
            (i.get("id", ""), i.get("due", ""), i.get("status", ""),
             i.get("subject", ""), i.get("vendor", ""),
             # v4.2.99: note edits and kind/entry changes must republish too
             i.get("note", ""), i.get("kind", ""), i.get("entry_id", ""))
            for i in items
        ))

    def _bridge_publish_followups(self, force=False):
        """Publish the active follow-up snapshot to Brain. Skips the write when
        nothing changed since the last publish unless force=True."""
        if not getattr(self, "bridge", None):
            return
        try:
            items = self._bridge_active_followups()
            sig = self._bridge_followups_signature(items)
            if not force and sig == getattr(self, "_bridge_followups_sig", None):
                return
            self.bridge.publish_followups(items)
            self._bridge_followups_sig = sig
        except Exception as _bridge_err:
            try:
                self.log(f"Bridge: publish error ({_bridge_err})")
            except Exception:
                pass

    def _bridge_tick(self):
        # Heartbeat, answer Brain's commands, and refresh the follow-up snapshot
        # when it has changed. Reschedules every 4s. Guarded so bridge or Tcl
        # errors never reach the UI; when the window is destroyed the pending
        # after() is cancelled and this loop ends on its own.
        if not getattr(self, "bridge", None):
            return
        try:
            self.bridge.heartbeat(app_version=mainbox_version_number())
            self.bridge.poll_commands(handlers={
                # Brain explicitly asked for the latest -> force a publish.
                "refresh_followups": lambda args: self._bridge_publish_followups(force=True),
                # v4.2.99: the phone's follow-up edits, applied HERE on the Tk
                # main thread with the app's own semantics (never by the phone
                # touching the JSON lanes, which are rewritten wholesale).
                "create_followup": self._bridge_cmd_create_followup,
                "snooze_followup": self._bridge_cmd_snooze_followup,
                "cancel_followup": self._bridge_cmd_cancel_followup,
                "complete_followup": self._bridge_cmd_complete_followup,
                "update_followup_note": self._bridge_cmd_update_followup_note,
            })
            # Push the snapshot automatically whenever it has changed.
            self._bridge_publish_followups()
        except Exception as _bridge_err:
            try:
                self.log(f"Bridge: tick error ({_bridge_err})")
            except Exception:
                pass
        finally:
            try:
                self.root.after(4000, self._bridge_tick)
            except Exception:
                pass  # root destroyed during shutdown; stop quietly

    # ── v4.2.99: phone follow-up commands (bridge) ──────────────────────────
    def _bridge_find_followup(self, fid):
        fid = str(fid or "")
        if not fid:
            return None, None
        for lane, coll in self._bridge_followup_lanes():
            for it in coll:
                if not isinstance(it, dict):
                    continue
                if it.get("id") == fid or self._bridge_followup_id(lane, it, stamp=False) == fid:
                    return lane, it
        return None, None

    def _bridge_after_followup_change(self, what, **data):
        """Persist all three lanes, refresh the UI, log, and republish -- the
        same tail every desktop follow-up mutation already performs."""
        for saver in ("save_followups", "save_scenario_reminders", "save_commitment_reminders"):
            fn = getattr(self, saver, None)
            if callable(fn):
                try:
                    fn()
                except Exception:
                    pass
        try:
            self.save_cached_state()
        except Exception:
            pass
        for renderer in ("render_email_rows", "render_group_rows", "render_followup_preview_queue"):
            fn = getattr(self, renderer, None)
            if callable(fn):
                try:
                    fn()
                except Exception:
                    pass
        try:
            ops_log("followup", what, source="phone", **data)
        except Exception:
            pass
        try:
            self._bridge_publish_followups(force=True)
        except Exception:
            pass

    def _bridge_parse_due(self, raw):
        due = datetime.fromisoformat(str(raw or "").strip())
        return due.replace(second=0, microsecond=0)

    def _bridge_cmd_create_followup(self, args):
        args = args or {}
        note = str(args.get("note") or "").strip()
        subject_hint = str(args.get("subject") or "").strip()
        if not note and not subject_hint:
            return {"ok": False, "error": "note required"}
        try:
            due = self._bridge_parse_due(args.get("due_at"))
        except Exception:
            return {"ok": False, "error": "bad due_at (ISO expected)"}
        now_iso = datetime.now().isoformat()
        entry_id = str(args.get("entry_id") or "")
        email = self.get_email_by_id(entry_id) if entry_id else None
        cancelled_prior = 0
        if isinstance(email, dict):
            # same rule as open_followup_window: one active manual row per email
            for item in self.followups:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Replaced by follow-up created from phone"
                    cancelled_prior += 1
            item = {
                "entry_id": email.get("entry_id", ""), "store_id": email.get("store_id", ""),
                "conversation_id": email.get("conversation_id", ""),
                "group_id": self.get_group_id_for_email(email.get("entry_id", "")),
                "subject": email.get("subject", "") or subject_hint or note,
                "source": email.get("source", ""), "category": email.get("category", "General"),
                "due_at": due.isoformat(), "message": note, "use_ai": True,
                "completed": False, "cancelled": False, "created_at": now_iso,
            }
            email["followup_time"] = due.strftime("%m/%d %I:%M %p")
        else:
            # free-standing (no email loaded here): shows in the queue + Upcoming
            # pane; its due alert is raised on the phone.
            item = {
                "entry_id": entry_id, "store_id": "", "conversation_id": "", "group_id": "",
                "subject": (subject_hint or note)[:200], "source": "phone", "category": "General",
                "due_at": due.isoformat(), "message": note, "use_ai": False,
                "completed": False, "cancelled": False, "created_at": now_iso,
            }
        item["created_via"] = "phone"
        self.followups.append(item)
        self._followup_dedup_needed = True
        fid = self._bridge_followup_id("manual", item)
        self._bridge_after_followup_change("phone_create", id=fid,
                                           linked=bool(isinstance(email, dict)),
                                           replaced=cancelled_prior)
        return {"ok": True, "id": fid, "due": item["due_at"],
                "linked_email": bool(isinstance(email, dict)),
                "message": f"Follow-up set for {due.strftime('%m/%d %I:%M %p')}"
                           + (f" (replaced {cancelled_prior} earlier)" if cancelled_prior else "")}

    def _bridge_cmd_snooze_followup(self, args):
        args = args or {}
        lane, item = self._bridge_find_followup(args.get("id"))
        if item is None:
            return {"ok": False, "error": "follow-up not found (already completed or cancelled?)"}
        if item.get("completed") or item.get("cancelled"):
            return {"ok": False, "error": "that follow-up is no longer active"}
        try:
            due = self._bridge_parse_due(args.get("due_at"))
        except Exception:
            return {"ok": False, "error": "bad due_at (ISO expected)"}
        item["due_at"] = due.isoformat()
        item["snoozed_at"] = datetime.now().isoformat()
        item["snooze_label"] = str(args.get("label") or "phone")[:60]
        email = self.find_email_for_followup_item(item)
        if isinstance(email, dict) and not email.get("is_deleted_app_snapshot"):
            email["followup_time"] = due.strftime("%m/%d %I:%M %p")
        fid = self._bridge_followup_id(lane, item)
        self._bridge_after_followup_change("phone_snooze", id=fid, lane=lane,
                                           label=item["snooze_label"][:32])
        return {"ok": True, "id": fid, "due": item["due_at"],
                "message": f"Snoozed to {due.strftime('%m/%d %I:%M %p')}"}

    def _bridge_cmd_cancel_followup(self, args):
        args = args or {}
        lane, item = self._bridge_find_followup(args.get("id"))
        if item is None:
            return {"ok": False, "error": "follow-up not found (already completed or cancelled?)"}
        if item.get("completed") or item.get("cancelled"):
            return {"ok": False, "error": "that follow-up is no longer active"}
        now_iso = datetime.now().isoformat()
        item["cancelled"] = True
        item["cancelled_at"] = now_iso
        item["cancel_reason"] = str(args.get("reason") or "Cancelled from phone")[:120]
        try:
            self._enqueue_outlook_reminder_cancel(item)
        except Exception:
            pass
        email = self.find_email_for_followup_item(item)
        if isinstance(email, dict) and not email.get("is_deleted_app_snapshot"):
            # user-initiated: the same durable stamp as the popup / assistant-log
            # cancels, so the 30s sweep cannot rebuild the row (v4.2.17/18)
            try:
                _eid = str(email.get("entry_id", "") or "")
                if _eid:
                    self.status_data.setdefault(_eid, {})["reply_needed_dismissed_at"] = now_iso
                    self.flush_status_data()
            except Exception:
                pass
            still_active = False
            for _lane, coll in self._bridge_followup_lanes():
                for other in coll:
                    if other is item or not isinstance(other, dict):
                        continue
                    if self._followup_item_matches_email(other, email) and not other.get("completed") and not other.get("cancelled"):
                        still_active = True
                        break
                if still_active:
                    break
            if not still_active:
                email["followup_time"] = ""
        fid = self._bridge_followup_id(lane, item)
        self._bridge_after_followup_change("phone_cancel", id=fid, lane=lane)
        return {"ok": True, "id": fid, "message": "Follow-up cancelled"}

    def _bridge_cmd_complete_followup(self, args):
        args = args or {}
        lane, item = self._bridge_find_followup(args.get("id"))
        if item is None:
            return {"ok": False, "error": "follow-up not found (already completed or cancelled?)"}
        if item.get("completed") or item.get("cancelled"):
            return {"ok": False, "error": "that follow-up is no longer active"}
        item["completed"] = True
        item["completed_at"] = datetime.now().isoformat()
        item["completed_via"] = "phone"
        email = self.find_email_for_followup_item(item)
        if isinstance(email, dict) and not email.get("is_deleted_app_snapshot"):
            email["followup_time"] = "Completed"
        fid = self._bridge_followup_id(lane, item)
        self._bridge_after_followup_change("phone_complete", id=fid, lane=lane)
        return {"ok": True, "id": fid, "message": "Marked complete"}

    def _bridge_cmd_update_followup_note(self, args):
        args = args or {}
        lane, item = self._bridge_find_followup(args.get("id"))
        if item is None:
            return {"ok": False, "error": "follow-up not found"}
        note = str(args.get("note") or "").strip()[:1000]
        if lane == "manual":
            item["message"] = note
        else:
            item["note"] = note
        fid = self._bridge_followup_id(lane, item)
        self._bridge_after_followup_change("phone_note", id=fid, lane=lane)
        return {"ok": True, "id": fid, "message": "Note updated"}

    # ── AI Assistant adapters ──────────────────────────────────────────────────
    # These translate an engine decision record into primitives MaINbox already
    # has. The high-stakes "deploy a draft" path is only ever reached through a
    # user-initiated Approve in the log (never on the periodic timer), so it does
    # not reintroduce the v41 follow-up-timer freeze.
    def _assistant_theme(self):
        return {"bg": _BG, "bg2": _BG2, "bg3": _BG3, "fg": _FG,
                "fg_dim": _FG_DIM, "accent": _ACCENT}

    def _open_assistant_log(self):
        if not getattr(self, "assistant", None):
            try:
                msg = ("The AI Assistant engine isn't loaded.\n\n"
                       "Keep 'mainbox_assistant.py' in the same folder as this app, then restart.")
                if _ASSISTANT_IMPORT_ERROR:
                    msg += f"\n\nWhy it failed to load:\n{_ASSISTANT_IMPORT_ERROR}"
                messagebox.showinfo("AI Assistant", msg)
            except Exception:
                pass
            return
        try:
            open_assistant_log_window(self.root, self.assistant, theme=self._assistant_theme())
        except Exception:
            pass

    def _assistant_apply(self, rec):
        """Execute an action the assistant decided to AUTO/REVIEW (or that the
        user approved). Returns True on success."""
        try:
            p = rec.get("payload", {}) or {}
            email = self.get_email_by_id(p.get("entry_id", "")) or p.get("email")
            after = rec.get("after", {}) or {}
            kind = rec.get("kind", "")
            if kind in ("Category", "Status", "Urgency"):
                if not email:
                    return False
                # v4.1.16: an assistant action the user approved (or AUTO applied) can
                # reopen a closed email; record the explicit reopen so the closed guard
                # cannot re-close it at the next startup.
                _was_closed = self._email_was_closed_before_edit(email)
                if "category" in after:
                    email["category"] = after["category"]
                if "urgency" in after:
                    email["urgency"] = after["urgency"]
                if "status" in after:
                    email["status"] = after["status"]
                if _was_closed and not self.workflow_record_is_closed(email):
                    self._record_explicit_reopen_for_email(email, save=True)
                self.save_record(email)
                self.flush_status_data()
                self.render_email_rows()
            elif kind == "Group":
                if not email:
                    return False
                # Rule-based groupings are logged AFTER the email is already in the
                # group (visibility only) -- don't redundantly re-apply / re-render.
                if p.get("already_grouped"):
                    return True
                gid = p.get("group_id", "")
                if gid and self.get_group_by_id(gid):
                    self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = gid
                    self.mark_group_has_new(gid)
                    self.save_groups()
                    self.render_group_rows()
                else:
                    return False
            elif kind in ("Follow-up", "Reply draft"):
                row = p.get("due_row")
                if row:
                    # User-approved deployment of a due follow-up draft.
                    self.deploy_due_followup_row(row)
                elif p.get("schedule") and email:
                    # Skip if we're re-entering from inside schedule_ai_followup_if_needed
                    # (the caller's fall-through schedules it); the Approve button has
                    # the guard off, so it schedules here.
                    if not getattr(self, "_assistant_suppress_schedule", False):
                        self.schedule_ai_followup_if_needed(
                            email, triage_result=p.get("triage"), quick_result=p.get("quick")
                        )
                else:
                    return False
            elif kind == "Cleanup":
                # Quote thread is DONE. Two outcomes, two actions:
                #   * Won order / PO placed -> KEEP it: mark the whole thread
                #     Completed and archive the group (emails stay linked, reversible
                #     via unarchive). A placed order may need referencing later, so it
                #     is never deleted.
                #   * Dead / lost (cancellation, no-quote, customer declined / walked
                #     away) -> remove the whole thread from the grid via the app-only
                #     delete: snapshot to Deleted History, mark app_deleted (sync/scan
                #     honor it so it stays gone), cancel follow-ups. Outlook is NEVER
                #     touched and it is restorable from Deleted History.
                # v3.9.77: both paths now act on the ENTIRE thread, not just current
                # group members -- an untriaged/ungrouped sibling ("New", still in the
                # Sales/drip queue) used to be skipped, so only part of a thread got
                # handled (2 of 3).
                # Quote-Completion auto-cleanup logs its archive AFTER performing it
                # (visibility + Undo only, like a rule-based grouping) -- so never
                # re-archive/re-delete a thread from the log for one of those rows.
                if p.get("already_archived"):
                    return True
                eid = p.get("entry_id", "")
                gid = p.get("group_id", "") or self.get_group_id_for_email(eid)
                _closed_kind = p.get("closed_kind", "")
                _won = _closed_kind in ("won", "llm_won")
                _why = "Order placed / quote won" if _won else "Request cancelled / no-quote / declined"
                emails = self._collect_thread_emails(eid, gid)
                if not emails:
                    em = self.get_email_by_id(eid)
                    emails = [em] if em else []
                if _won:
                    for em in emails:
                        try:
                            self._cancel_active_followups_for_email(em, reason=_why)
                        except Exception:
                            pass
                        try:
                            em["status"] = "Completed"
                            self.save_record(em)
                        except Exception:
                            pass
                    try:
                        self.flush_status_data()
                    except Exception:
                        pass
                    if gid:
                        self._archive_group_by_id(gid)
                    else:
                        self.render_email_rows()
                else:
                    # Dead/lost: delete the whole thread to Deleted History (follow-ups
                    # cancelled). perform_app_delete handles the snapshot, app_deleted
                    # flags, index rebuild, save, and re-render.
                    self.perform_app_delete(emails, "cancel")
                    # If the group is now empty (its only thread was this one), archive
                    # the shell so it does not linger; a multi-thread project group with
                    # other live threads is left active.
                    if gid and self.get_group_by_id(gid) and not self.get_emails_for_group(gid):
                        self._archive_group_by_id(gid)
                return True
            # Mirror into the existing AI Triage Center history / learning trail.
            if email:
                try:
                    self.record_ai_triage_history(
                        email, before=rec.get("before", {}), after=after,
                        reason=rec.get("reason", ""), source="Assistant"
                    )
                except Exception:
                    pass
            return True
        except Exception:
            return False

    def _assistant_ask(self, rec):
        """Surface an uncertain item. In silent mode, bring the log up once so the
        user still sees it. Safe to call from the background triage thread: all Tk
        work is marshalled to the main thread."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or assistant.config.show_log:
                return

            def _open_if_needed():
                existing = getattr(assistant, "_log_win", None)
                try:
                    if existing and existing.winfo_exists():
                        return  # already visible; the new pending row will just appear
                except Exception:
                    pass
                open_assistant_log_window(self.root, assistant, theme=self._assistant_theme())

            self.root.after(0, _open_if_needed)
        except Exception:
            pass

    def _assistant_on_activity(self, rec):
        """Fires for every NEW assistant row. When 'Show this log' is CHECKED, pop
        the window for any new activity. (The UNCHECKED case -- open only when
        something needs attention -- is handled by _assistant_ask above, so the two
        are complementary and never double-open.) Thread-safe: opens on the main
        thread."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or not assistant.config.show_log:
                return

            def _open_if_needed():
                existing = getattr(assistant, "_log_win", None)
                try:
                    if existing and existing.winfo_exists():
                        return  # already visible; the new row appears via refresh
                except Exception:
                    pass
                open_assistant_log_window(self.root, assistant, theme=self._assistant_theme())

            self.root.after(0, _open_if_needed)
        except Exception:
            pass

    def _assistant_undo(self, rec):
        """Restore the pre-action category/urgency/status/group."""
        try:
            p = rec.get("payload", {}) or {}
            # Quote-Completion auto-cleanup archives a whole group (no single email to
            # restore), so its Undo un-archives that group and brings it back.
            if p.get("already_archived") and p.get("group_id"):
                g = self.get_group_by_id(p.get("group_id"))
                if g:
                    g["archived"] = False
                    g.pop("archived_at", None)
                    self.save_groups()
                    self.render_group_rows()
                    self.render_email_rows()
                return True
            email = self.get_email_by_id(p.get("entry_id", ""))
            if not email:
                return False
            before = rec.get("before", {}) or {}
            for f in ("category", "urgency", "status"):
                if f in before:
                    email[f] = before[f]
            if "group" in before:
                eid = email.get("entry_id", "")
                if before["group"]:
                    self.groups_data.setdefault("memberships", {})[eid] = before["group"]
                else:
                    self.groups_data.get("memberships", {}).pop(eid, None)
                self.save_groups()
                self.render_group_rows()
            self.save_record(email)
            self.flush_status_data()
            self.render_email_rows()
            return True
        except Exception:
            return False

    def _assistant_log_autogroup(self, email, group_id, reason="", rule=""):
        """Surface a RULE-based grouping (thread / business-key / learned) in the
        assistant log so the user can SEE it and re-group if it's wrong. These
        paths short-circuit before the AI-suggestion path, so without this they
        were invisible -- the user couldn't correct them. The email is already in
        the group, so this only records/visualizes it (payload already_grouped
        stops _assistant_apply from redundantly re-applying). dedup_key collapses
        repeats from re-scans onto one row."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or not assistant.config.enabled:
                return
            group = self.get_group_by_id(group_id)
            if not group:
                return
            eid = email.get("entry_id", "")
            assistant.handle(
                kind="Group", stakes=LOW, confidence=0.99,
                subject=email.get("subject", ""), sender=email.get("sender", ""),
                summary=f"Grouped into '{group.get('name','')}'",
                before={"group": ""}, after={"group": group.get("name", "")},
                reason=(reason or f"Auto-grouped by {rule or 'rule'} match."),
                payload={"entry_id": eid, "group_id": group_id, "already_grouped": True,
                         "group_rule": rule},
                dedup_key=f"group:{eid}",
            )
        except Exception:
            pass

    def _email_request_is_closed(self, email):
        """Heuristic: is this quote/request DONE, so its group can be archived?
        Returns (closed, phrase, kind) where kind is one of:
          - "cancelled": customer cancelled/disregarded ("no longer needed")
          - "no_quote" : a no-quote / no-bid decision ("we won't quote", "no bid")
          - "won"      : order placed / PO provided (via detect_won_order, whose
                         strong signals override a mis-tagged email_type)
        Kept tight to avoid false positives that would wrongly suppress a real
        follow-up. Only the top of the body (before quoted history) is scanned."""
        if not email:
            return False, "", ""
        try:
            subj = str(email.get("subject", "") or "")
            body = str(email.get("body", "") or "")
            email_type = str(email.get("email_type", "") or "").upper()
            head = re.split(r"\n\s*(?:from:|sent:|on .+ wrote:|-{3,}\s*original message)",
                            body, maxsplit=1, flags=re.I)[0]
            text = f"{subj}\n{head}".lower()
            cancelled_pats = [
                r"please\s+disregard",
                r"disregard\s+(?:this|that|these|the\s+(?:below|above|previous|prior|last))",
                r"no\s+longer\s+(?:requested|required|needed|necessary|valid|interested|moving\s+forward)",
                r"please\s+(?:cancel|void)\b",
                r"\bcancel\s+(?:this|that|the|my|our)\s+(?:order|quote|request|rfq|po|inquiry|job)",
                r"\bnever\s*mind\b",
                r"\bnevermind\b",
                r"\bwithdraw\s+(?:this|the|our|my)\b",
                r"please\s+ignore\s+(?:this|that|the|my|our|previous)",
                r"\bvoid\s+(?:this|the|our|my)\b",
                r"\bscratch\s+that\b",
            ]
            no_quote_pats = [
                r"\bno\s+quote\b",
                r"\bno[\s-]?bid\b",
                r"\b(?:we|i)(?:'?re|\s+are|\s+am)?\s+(?:not|won'?t|will\s+not)\s+(?:going\s+to\s+)?(?:quote|bid|quoting|bidding)\b",
                r"\b(?:not|won'?t|will\s+not)\s+(?:be\s+)?(?:quoting|bidding|quote|bid)\b",
                r"\b(?:we|i)(?:'?ll|\s+will)?\s+pass\s+on\s+(?:this|that|it)\b",
                r"\bdeclin(?:e|ing)\s+to\s+(?:quote|bid)\b",
            ]
            for pat in cancelled_pats:
                m = re.search(pat, text)
                if m:
                    return True, m.group(0).strip(), "cancelled"
            for pat in no_quote_pats:
                m = re.search(pat, text)
                if m:
                    return True, m.group(0).strip(), "no_quote"
            # v3.9.103: an email that is ALSO actively asking us for something -- a price,
            # availability, a lead time, a status/update, a confirmation, or any direct request --
            # is a LIVE inquiry, NOT a closed deal. The two fuzzy heuristics below were auto-
            # completing such threads: a customer politely following up ("please send pricing,
            # thanks for checking") tripped detect_lost_deal's "thanks for checking/your time", and
            # a future "looking to place the order soon" tripped detect_won_order's "place the
            # order". Suppress ONLY those inferred closes when the customer is clearly still engaged.
            # The EXPLICIT closes above (disregard/cancel/void, no-bid) are untouched, and a real
            # walk-away ("went with another") or real order ("here is the PO, go ahead") carries no
            # active-request language, so it still closes.
            active_inquiry = bool(re.search(
                r"\b(?:"
                r"any\s+update|any\s+word|status\s+(?:on|of|update|please)|update\s+(?:on|please|when|for)|"
                r"following\s+up|follow(?:ing)?\s*up|checking\s+in|where\s+(?:do\s+)?we\s+stand|"
                r"please\s+(?:advise|send|quote|confirm|provide|price)|please\s+let\s+(?:me|us)\s+know|"
                r"can\s+(?:you|we)\s+(?:quote|confirm|provide|send|get|check|advise|help)|"
                r"could\s+(?:you|we)\s+(?:quote|confirm|provide|send|please|check)|"
                r"would\s+you\s+(?:be\s+able|mind|please)|"
                r"do\s+you\s+have|are\s+(?:these|they|you)\s+(?:available|able)|"
                r"is\s+(?:this|it|that)\s+(?:still\s+)?available|still\s+available|"
                r"lead\s*time|when\s+(?:can|will|do|would|should)|how\s+(?:soon|long|much)\b|"
                r"need\s+(?:a\s+quote|pricing|price|availability|the\s+price|this|these|it)|"
                r"price\s+and\s+availability|pricing\s+and\s+availability|p\s*&\s*a\b|p\s+and\s+a\b|"
                r"send\s+(?:me|us|over)\s+(?:pricing|a\s+quote|the\s+price|price)|"
                r"still\s+(?:need|needed|looking|interested|waiting|require)|"
                r"waiting\s+(?:on|for)\s+(?:your|the|a|this)\b|"
                r"get\s+(?:me|us)\s+(?:a\s+)?(?:quote|price|pricing)"
                r")\b", text))
            # Won order -- shared detector; its strong signals (release/deliver, PO
            # provided) are type-agnostic, so a customer mis-tagged 'V' still closes.
            won, won_phrase = detect_won_order(text, email_type)
            if won and not active_inquiry:
                return True, won_phrase, "won"
            # Customer declined / walked away (lost deal). High-confidence walk-aways
            # archive like a cancellation; soft brush-offs are flagged for review only.
            lost, lost_phrase, lost_level = detect_lost_deal(text)
            if lost and not active_inquiry:
                return True, lost_phrase, ("declined" if lost_level == "high" else "declined_soft")
        except Exception:
            pass
        return False, "", ""

    def _sweep_invoice_completed_threads(self, lookback_days=7, max_closes=6):
        """v4.2.86 (Steve, Danny/campbellanddawes 8/24): the deal often finishes
        OUTSIDE email -- quoted in the ERP, PO taken, order entered -- so no sent
        reply ever exists and the customer's rows sit Needs Reply / Waiting on
        Customer forever, breeding follow-up noise. The one reliable in-app signal
        that the job is DONE is the ERP's own internal invoice copy ("Invoice
        S100101798.001  PO# 1590-085" from our own domain). This sweep finds those
        invoices and runs open customer rows carrying the same PO token through the
        NORMAL won-order close (the exact 3-step sequence the closed-thread pass
        above uses: status Completed, follow-ups cancelled, assistant Cleanup
        proposed -- logged, undoable, honors Auto-Archive).

        Conservative by construction: internal senders only; the PO token needs
        >= 5 chars including a digit; only Needs Reply / Waiting on Customer rows
        from EXTERNAL senders qualify; user-locked rows are never touched; at most
        max_closes threads per pass; each invoice is examined once per session and
        the status change itself makes re-runs no-ops. Runs on the MAIN thread from
        _refresh_finalize_pass."""
        try:
            _own = set()
            try:
                _own = set(self._own_mailbox_domains(getattr(self, "namespace", None)) or ())
            except Exception:
                _own = set()
            cutoff = datetime.now().timestamp() - lookback_days * 86400
            handled = getattr(self, "_invoice_sweep_handled", None)
            if handled is None:
                handled = self._invoice_sweep_handled = set()
            closes = 0
            for inv in list(getattr(self, "emails", []) or []):
                if closes >= max_closes:
                    break
                if not isinstance(inv, dict):
                    continue
                subj = str(inv.get("subject", "") or "")
                if "invoice" not in subj.lower():
                    continue
                m = re.search(r"\bpo\s*#?\s*:?\s*([A-Za-z0-9][\w.\-]{3,})", subj, flags=re.I)
                if not m:
                    continue
                token = m.group(1).strip().rstrip(".")
                if len(token) < 5 or not re.search(r"\d", token):
                    continue
                try:
                    if float(inv.get("received_timestamp", 0) or 0) < cutoff:
                        continue
                except Exception:
                    pass
                _sdom = str(get_email_domain(str(inv.get("resolved_sender_smtp") or inv.get("sender_email") or "")) or "").lower()
                if not _sdom or (_own and _sdom not in _own):
                    continue          # only our own ERP/office invoice copies count
                inv_eid = str(inv.get("entry_id", "") or "")
                if inv_eid in handled:
                    continue
                tok_low = token.lower()
                seen_threads = set()
                for row in list(getattr(self, "emails", []) or []):
                    if closes >= max_closes:
                        break
                    if not isinstance(row, dict) or row is inv:
                        continue
                    if str(row.get("status", "") or "") not in ("Needs Reply", "Waiting on Customer"):
                        continue
                    if row.get("ai_user_locked"):
                        continue
                    _rdom = str(get_email_domain(str(row.get("resolved_sender_smtp") or row.get("sender_email") or "")) or "").lower()
                    if _own and _rdom and _rdom in _own:
                        continue      # the customer's rows, not our own copies
                    if tok_low not in str(row.get("subject", "") or "").lower():
                        continue
                    _tkey = str(row.get("conversation_id", "") or row.get("entry_id", "") or "")
                    if _tkey in seen_threads:
                        continue
                    seen_threads.add(_tkey)
                    # v4.2.87: 3-step close extracted to _complete_row_as_won (now
                    # shared with the returned-bid PO flow); behavior unchanged.
                    self._complete_row_as_won(row, cancel_reason=f"Invoiced (PO {token})",
                                              cleanup_reason=f"invoiced — {subj[:60]}")
                    try:
                        ops_log("workflow", "invoice_closed_thread", po=str(token)[:30],
                                row_subj=str(row.get("subject", ""))[:40], inv=inv_eid[-16:])
                    except Exception:
                        pass
                    closes += 1
                handled.add(inv_eid)
        except Exception:
            pass

    def _complete_row_as_won(self, row, cancel_reason="", cleanup_reason=""):
        """v4.2.87: the 3-step won-order close used by the invoice sweep and the
        returned-bid PO flow -- exactly the sequence the closed-thread pass in
        _refresh_finalize_pass established: status Completed (row + saved record),
        active follow-ups cancelled, assistant 'won' Cleanup proposed (logged,
        undoable, honors Auto-Archive). MAIN thread only."""
        try:
            row["status"] = "Completed"
            try:
                _srow = self.status_data.get(str(row.get("entry_id", "") or "")) if isinstance(self.status_data, dict) else None
                if isinstance(_srow, dict):
                    _srow["status"] = "Completed"
            except Exception:
                pass
            try:
                self._cancel_active_followups_for_email(row, reason=cancel_reason)
            except Exception:
                pass
            self._assistant_propose_cleanup(row, cleanup_reason, "won")
        except Exception:
            pass

    def _queue_po_congrats(self, entry_id, subject, sender, sender_email, filename):
        """v4.2.87: worker-side queue for a detected returned-bid PO ('$OK' on our
        own PDF). No UI here -- drained on the main thread by
        _process_pending_po_congrats() after the scan repaints."""
        try:
            q = getattr(self, "_pending_po_congrats", None)
            if not isinstance(q, list):
                q = []
                self._pending_po_congrats = q
            if any(isinstance(p, dict) and p.get("entry_id") == entry_id for p in q):
                return
            q.append({"entry_id": str(entry_id or ""), "subject": str(subject or ""),
                      "sender": str(sender or ""), "sender_email": str(sender_email or ""),
                      "filename": str(filename or ""), "at": datetime.now().isoformat()})
        except Exception:
            pass

    def _schedule_process_po_reminder(self, email_snapshot, minutes=60):
        """v4.2.87: 'remind me to process this PO'. Appends the scenario item
        directly instead of via schedule_scenario_reminder, ON PURPOSE: that
        scheduler refuses Completed emails, and this thread was just completed BY
        the PO close -- which is exactly why the user wants an external nudge. The
        fire path (check_due_scenario_reminders) has no completed-row gate."""
        try:
            email = email_snapshot or {}
            entry_id = str(email.get("entry_id", "") or "")
            if not entry_id or self.scenario_reminder_exists("process_po", entry_id):
                return False
            due_at = datetime.now() + timedelta(minutes=minutes)
            self.scenario_reminders.append({
                "type": "process_po",
                "entry_id": entry_id,
                "store_id": email.get("store_id", ""),
                "conversation_id": email.get("conversation_id", ""),
                "group_id": self.get_group_id_for_email(entry_id),
                "subject": email.get("subject", ""),
                "sender": email.get("sender", ""),
                "created_at": datetime.now().isoformat(),
                "due_at": due_at.isoformat(),
                "baseline_received_timestamp": email.get("received_timestamp", 0),
                "note": "Process the PO (returned bid: %s)" % str(email.get("_po_filename", "") or ""),
                "completed": False,
                "cancelled": False,
            })
            self.save_scenario_reminders()
            ops_log("workflow", "process_po_reminder_set", subj=str(email.get("subject", ""))[:40],
                    minutes=minutes)
            return True
        except Exception:
            return False

    def _process_pending_po_congrats(self):
        """v4.2.87 (Steve): MAIN-thread drain for detected returned-bid POs. For each:
        close the job's open rows as WON (same-token rows included, like the invoice
        sweep -- Danny's request row and his '$OK' row share the job number), then a
        congrats popup: 'Processing it now' (default, Enter) just closes; 'Remind me
        in 1 hour' schedules a process_po reminder. Escape = processing now. The
        close happens on DETECTION regardless of the popup answer -- the popup only
        decides the reminder."""
        item = None
        try:
            q = getattr(self, "_pending_po_congrats", None)
            if not isinstance(q, list) or not q:
                return
            item = q.pop(0)
            eid = str(item.get("entry_id", "") or "")
            subj = str(item.get("subject", "") or "")
            sender = str(item.get("sender", "") or item.get("sender_email", "") or "customer")
            fname = str(item.get("filename", "") or "")
            trigger = self.get_email_by_id(eid) or {}
            snapshot = dict(trigger) if isinstance(trigger, dict) else {}
            snapshot.setdefault("entry_id", eid)
            snapshot.setdefault("subject", subj)
            snapshot["_po_filename"] = fname
            # Close every open row carrying the job token (the subject usually IS
            # the customer's PO/job number, e.g. '1582-324'), same rules as the
            # invoice sweep: external senders only, not user-locked.
            _own = set()
            try:
                _own = set(self._own_mailbox_domains(getattr(self, "namespace", None)) or ())
            except Exception:
                _own = set()
            m = re.search(r"\b[A-Za-z]?\d{3,6}[-.]\d{2,4}\b", subj)
            token = (m.group(0).lower() if m else "")
            closed = 0
            for row in list(getattr(self, "emails", []) or []):
                if not isinstance(row, dict):
                    continue
                if str(row.get("status", "") or "") not in ("Needs Reply", "Waiting on Customer"):
                    continue
                if row.get("ai_user_locked"):
                    continue
                _rdom = str(get_email_domain(str(row.get("resolved_sender_smtp") or row.get("sender_email") or "")) or "").lower()
                if _own and _rdom and _rdom in _own:
                    continue
                _rsub = str(row.get("subject", "") or "").lower()
                if str(row.get("entry_id", "")) != eid and (not token or token not in _rsub):
                    continue
                self._complete_row_as_won(row, cancel_reason=f"PO received ({fname})",
                                          cleanup_reason=f"customer returned our bid {fname} — PO/go-ahead")
                ops_log("workflow", "returned_bid_closed_thread", token=token[:30],
                        row_subj=str(row.get("subject", ""))[:40], doc=fname[:40])
                closed += 1
            try:
                self.render_email_rows()
                self.render_group_rows()
            except Exception:
                pass
            # ---- congrats popup ----
            # v4.2.94: the popup body moved to the shared _po_congrats_popup so every
            # PO path shows the SAME dialog. Wording and the queue-drain follow-on are
            # unchanged; the row selection above (token-based, this flow's own rule)
            # is deliberately untouched.
            self._po_congrats_popup(
                subj,
                (f"{sender} sent back your bid ({fname}) \u2014 that's the go-ahead on:\n\n"
                 f"{subj[:80]}\n\n"
                 f"{closed} row(s) marked complete. Are you processing it now,\n"
                 "or would you like a reminder?"),
                snapshot, doc=fname, closed=closed,
                on_closed=self._process_pending_po_congrats)
        except Exception as _exc:
            _cov_debug(f"PO-CONGRATS drain failed: {_exc!r}")
            try:
                if isinstance(item, dict):
                    item["_retries"] = int(item.get("_retries", 0) or 0) + 1
                    if item["_retries"] <= 3 and isinstance(getattr(self, "_pending_po_congrats", None), list):
                        self._pending_po_congrats.append(item)
            except Exception:
                pass

    # ── v4.2.94 shared PO-won finish (Steve: "no matter how a PO gets awarded a PO
    # is awarded and should be handled in the same matter -- archive and notify") ──
    # Before this there were THREE PO arrival paths with three behaviors: the v4.2.87
    # returned-bid detector did the full won-close + congrats; the auto-popup prompt
    # offered archive as an opt-in CHECKBOX and never closed rows; and PO Review's
    # "Apply to matched job" recorded the award and did nothing else -- reported live
    # (Allan Briteway PO 510880, 2026-08-26: award landed on the right job at 10:17:59,
    # yet three rows stayed open and the group stayed unarchived).

    def _po_congrats_popup(self, subject, body_text, snapshot, doc="", closed=0,
                           on_closed=None):
        """The single 'you got a PO' popup, shared by every PO path.

        Lifted verbatim from the v4.2.87 returned-bid flow so its behavior is
        unchanged where it already worked: 'Processing it now' is the default
        (Enter, Escape and the window X all take it), 'Remind me in 1 hour'
        schedules the process_po reminder, the default button takes focus. Only the
        wording and the follow-on callback are parameterised. MAIN thread only."""
        win = tk.Toplevel(self.root)
        win.title("You got a PO!")
        win.configure(bg=_BG)
        win.transient(self.root)
        tk.Label(win, text="\U0001F389  Congrats — you got a PO!", font=(_FONT, 14, "bold"),
                 fg=_ACCENT, bg=_BG).pack(anchor="w", padx=16, pady=(12, 4))
        tk.Label(win, text=body_text, bg=_BG, fg=_FG, justify="left").pack(
            anchor="w", padx=16, pady=(0, 8))
        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=16, pady=(4, 12))

        def _done(event=None):
            try:
                win.destroy()
            except Exception:
                pass
            if on_closed:
                try:
                    self.root.after(200, on_closed)
                except Exception:
                    pass

        def _remind(event=None):
            try:
                self._schedule_process_po_reminder(snapshot, minutes=60)
            except Exception:
                pass
            _done()

        _b_now = tk.Button(btns, text="Processing it now", command=_done,
                           bg="#2f6feb", fg="white", padx=14, pady=4)
        _b_now.pack(side="right", padx=4)
        tk.Button(btns, text="Remind me in 1 hour", command=_remind,
                  bg=_BTN_BG, fg=_FG, padx=10, pady=4).pack(side="right", padx=4)
        win.protocol("WM_DELETE_WINDOW", _done)
        win.bind("<Return>", _done)
        win.bind("<Escape>", _done)
        try:
            win.lift()
            win.focus_force()
            _b_now.focus_set()
        except Exception:
            pass
        try:
            ops_log("workflow", "po_congrats_shown", subj=str(subject)[:40],
                    doc=str(doc)[:40], closed=closed)
        except Exception:
            pass
        return win

    # Statuses that mean "still open work" on a job. Steve's call for the PO close is
    # EVERY open row in the job, vendor rows included -- once the customer has PO'd,
    # the quoting conversation is over on both sides. A row the user deliberately
    # locked (ai_user_locked) is still never touched: that flag exists precisely to
    # mean "leave my decision alone", and honouring it costs one row, not the sweep.
    _PO_OPEN_STATUSES = ("New", "Needs Reply", "Waiting on Customer", "Waiting on Vendor")

    def _close_job_rows_as_won(self, group_id, reason_doc=""):
        """Mark every open row in a job Completed via the standard 3-step won-close
        (_complete_row_as_won: Completed + cancel follow-ups + assistant 'won'
        Cleanup, which is what honours Auto-Archive). Returns the count closed.
        MAIN thread only."""
        closed = 0
        gid = str(group_id or "")
        if not gid:
            return 0
        try:
            memberships = self.groups_data.get("memberships", {}) or {}
            for row in list(getattr(self, "emails", None) or []):
                if not isinstance(row, dict):
                    continue
                if memberships.get(str(row.get("entry_id", "") or "")) != gid:
                    continue
                if str(row.get("status", "") or "") not in self._PO_OPEN_STATUSES:
                    continue
                if row.get("ai_user_locked"):
                    continue
                self._complete_row_as_won(
                    row,
                    cancel_reason=("PO received %s" % reason_doc).strip(),
                    cleanup_reason=("customer PO received %s" % reason_doc).strip())
                ops_log("workflow", "po_closed_job_row", gid=gid[:32],
                        row_subj=str(row.get("subject", ""))[:40],
                        was=str(row.get("status", ""))[:20], doc=str(reason_doc)[:30])
                closed += 1
        except Exception:
            pass
        return closed

    def _finish_po_award(self, group_id, anchor=None, po_numbers=None, source=""):
        """Everything that should happen once a PO is awarded, whatever surfaced it.

        Closes the job's open rows as won (which archives through the assistant's
        'won' Cleanup when Auto-Archive is on) and shows the shared congrats popup.
        Safe to call twice: a second call finds no open rows and reports 0 closed.
        MAIN thread only."""
        gid = str(group_id or "")
        group = self.get_group_by_id(gid) if gid else None
        if not group:
            return False
        pos = [str(p) for p in (po_numbers or []) if str(p or "").strip()]
        po_text = ", ".join(pos[:4])
        closed = self._close_job_rows_as_won(gid, reason_doc=("PO " + po_text) if po_text else "")
        try:
            self.render_email_rows()
            self.render_group_rows()
        except Exception:
            pass
        snapshot = dict(anchor) if isinstance(anchor, dict) else {}
        snapshot.setdefault("subject", str(group.get("name", "") or ""))
        job_name = str(group.get("name", "") or "")
        body = ("%s recorded on:\n\n%s\n\n%d row(s) marked complete. Are you processing "
                "it now,\nor would you like a reminder?"
                % (("PO " + po_text) if po_text else "A PO", job_name[:80], closed))
        try:
            self._po_congrats_popup(job_name, body, snapshot,
                                    doc=po_text, closed=closed)
        except Exception:
            pass
        ops_log("workflow", "po_award_finished", gid=gid[:32], closed=closed,
                pos=po_text[:40], src=str(source)[:24])
        return True

    def _assistant_propose_cleanup(self, email, reason="", kind="cancelled"):
        """When a quote/request is DONE -- a won order/PO, a cancellation, or a
        customer declining -- either auto-apply (if Auto-Archive is ON) or stage a
        'Cleanup' for the user's one-click Approve. Acts on the WHOLE thread, not
        just current group members. Outcome decides the action:
          * won/llm_won -> KEEP: mark the thread Completed and archive the group
            (emails stay linked, reversible via unarchive -- a placed order may
            need referencing).
          * cancelled/no_quote/declined/declined_soft/llm_lost -> DELETE the whole
            thread to Deleted History (app-only: Outlook untouched, restorable from
            Deleted History; follow-ups cancelled).

        `kind`: 'won' | 'cancelled' | 'no_quote' | 'declined' | 'declined_soft' |
        'llm_won' | 'llm_lost'. Soft ('declined_soft') and LLM-detected hits are
        ALWAYS held for review (never auto-applied), since they are heuristic --
        only the confident pattern hits ride the Auto-Archive setting."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or not assistant.config.enabled:
                return
            tags = {
                "won": "order placed", "llm_won": "order placed (review)",
                "cancelled": "request cancelled", "no_quote": "no quote / no bid",
                "declined": "customer declined", "declined_soft": "customer may have declined (review)",
                "llm_lost": "customer declined (review)",
            }
            tag = tags.get(kind, "request closed")
            won = kind in ("won", "llm_won")
            # heuristic hits are surfaced but never silently auto-archived
            force_review = kind in ("declined_soft", "llm_won", "llm_lost")
            auto = bool(getattr(assistant.config, "autoarchive_enabled", False)) and not force_review
            eid = email.get("entry_id", "")
            gid = self.get_group_id_for_email(eid)
            group = self.get_group_by_id(gid) if gid else None
            # v3.9.77: count + wording reflect the WHOLE thread (Cleanup now acts on
            # every loaded email in the thread, including an ungrouped/"New" sibling)
            # and the actual action -- a won order is KEPT (archive + mark complete),
            # while a dead/lost thread is DELETED to Deleted History (restorable,
            # Outlook untouched).
            _thread = self._collect_thread_emails(eid, gid or "")
            n = len(_thread) if _thread else (1 if self.get_email_by_id(eid) else 0)
            gname = group.get("name", "") if group else ""
            if won:
                if group:
                    verb = "Auto-archiving" if auto else "Archive"
                    summary = f"{verb} '{gname}' ({n} email(s), kept) \u2014 {tag}"
                    after = {"action": f"archive group; mark complete; keep {n} email(s) linked"}
                else:
                    summary = f"Mark complete ({n} email(s)) \u2014 {tag}"
                    after = {"action": "mark complete; stop follow-up"}
            else:
                verb = "Auto-deleting" if auto else "Delete"
                where = f" from '{gname}'" if group else ""
                summary = f"{verb} {n} thread email(s){where} to Deleted History \u2014 {tag}"
                after = {"action": f"delete {n} thread email(s) to Deleted History (restorable); cancel follow-ups"}
            if won:
                rsn = (f"Order placed / quote won (\u201c{reason}\u201d) \u2014 the quote is complete."
                       if reason else "Order placed / quote won \u2014 the quote is complete.")
            elif kind in ("declined", "declined_soft", "llm_lost"):
                rsn = (f"Customer declined / walked away (\u201c{reason}\u201d) \u2014 quote lost."
                       if reason else "Customer declined / walked away \u2014 quote lost.")
            else:
                rsn = (f"Request is dead (\u201c{reason}\u201d)." if reason
                       else "Request is cancelled.")
            assistant.handle(
                kind="Cleanup", stakes=HIGH, confidence=0.9,
                subject=email.get("subject", ""), sender=email.get("sender", ""),
                summary=summary, before={}, after=after, reason=rsn,
                payload={"entry_id": eid, "group_id": gid or "", "closed_kind": kind},
                dedup_key=f"cleanup:{eid}",
                hold_for_user=not auto, force_auto=auto,
            )
        except Exception:
            pass

    def _cancel_group_member_followups(self, group_id, reason="Group archived"):
        """v4.2.13: silence reminders for EVERY member of a group being archived.

        Archiving used to complete only the ONE row the close anchored on, so every
        other member stayed open and kept generating reminders -- schedule_scenario_
        reminder gates on email_is_completed() and never looks at the group. Measured
        live: 22 active commitment_reply_needed reminders plus 1 pending reply check
        were firing on rows inside already-archived groups, all past due.

        Deliberately NOT _cancel_active_followups_for_email: that helper also calls
        learn_followup_behavior(..., "no_followup"), so applying it per member would
        train a permanent no-follow-up rule for every sender in the group. This cancels
        the live items only and teaches nothing.

        Status is left ALONE on purpose. 54 of 162 archived groups still hold open rows
        (45 at Needs Reply), but several are genuinely live work -- two open invoices in
        "1597-006", 16 open rows in "WELSBACH- NYCDEP HUGE RFQ" -- so completing them
        would bury real obligations. Cancelling the nag while leaving the row visible is
        reversible: reactivate_dormant_thread_if_needed un-archives and re-arms the
        thread if the customer comes back.
        """
        cancelled = 0
        try:
            emails = [e for e in self.get_emails_for_group(group_id) if isinstance(e, dict)]
            if not emails:
                return 0
            now_iso = datetime.now().isoformat()
            for coll_name in ("followups", "scenario_reminders", "pending_reply_checks",
                              "commitment_reminders"):
                for item in (getattr(self, coll_name, None) or []):
                    try:
                        if item.get("completed") or item.get("cancelled"):
                            continue
                        if not any(self._followup_item_matches_email(item, e) for e in emails):
                            continue
                        item["cancelled"] = True
                        item["cancelled_at"] = now_iso
                        item["cancel_reason"] = reason
                        # v4.2.19: remove the Outlook calendar twin too.
                        self._enqueue_outlook_reminder_cancel(item)
                        cancelled += 1
                    except Exception:
                        continue
            if cancelled:
                for saver in ("save_followups", "save_scenario_reminders",
                              "save_pending_reply_checks", "save_commitment_reminders"):
                    fn = getattr(self, saver, None)
                    if callable(fn):
                        try:
                            fn()
                        except Exception:
                            pass
                try:
                    ops_log("group", "archive_cancelled_followups",
                            gid=str(group_id)[-24:], members=len(emails),
                            cancelled=cancelled, reason=str(reason)[:40])
                except Exception:
                    pass
        except Exception:
            pass
        return cancelled

    def _archive_group_by_id(self, group_id):
        """Archive a group by id (same effect as the Archive Group button, but with
        no tree selection needed). Emails stay in MaINbox; the group moves to
        archived. Returns True if it archived, False if already archived/missing."""
        try:
            group = self.get_group_by_id(group_id)
            if not group or group.get("archived"):
                return False
            # v4.2.13: cancel BEFORE flipping the flag, and before any caller creates a
            # deliberate post-archive chase (_create_quote_completion_followup runs after
            # this returns), so the one intended reminder survives and the stragglers do not.
            try:
                self._cancel_group_member_followups(group_id, reason="Group archived")
            except Exception:
                pass
            group["archived"] = True
            group["archived_at"] = datetime.now().isoformat()
            if getattr(self, "active_group_filter", "all") == group_id:
                self.active_group_filter = "all"
            self.save_groups()
            self.render_group_rows()
            self.render_email_rows()
            return True
        except Exception:
            return False

    def _create_quote_completion_followup(self, group_id, anchor_email):
        """Drop ONE follow-up on the MANUAL lane (self.followups) for a finished
        quote group, so the pending PO/decision still gets chased after the group
        is archived. The manual lane is used on purpose: scenario reminders are
        auto-cancelled once their email is Completed (see get_followup_queue_items),
        but manual follow-ups survive a Completed/archived thread and still fire.
        Due time is settings-driven (default: +1 day at 07:00 -- the next morning).
        No-op if the group already has an active manual follow-up. Returns True if a
        follow-up was created."""
        try:
            if not anchor_email:
                return False
            s = getattr(self, "settings", {}) or {}
            days = int(s.get("quote_completion_followup_days", 1) or 0)
            hour = int(s.get("quote_completion_followup_hour", 7) or 0)
            minute = int(s.get("quote_completion_followup_minute", 0) or 0)
            due_at = (datetime.now() + timedelta(days=max(0, days))).replace(
                hour=max(0, min(23, hour)), minute=max(0, min(59, minute)),
                second=0, microsecond=0)
            # Don't stack a second reminder if this group already has an active one.
            for it in self.followups:
                if it.get("completed") or it.get("cancelled"):
                    continue
                if group_id and it.get("group_id") == group_id:
                    return False
            item = {
                "entry_id": anchor_email.get("entry_id", ""),
                "store_id": anchor_email.get("store_id", ""),
                "conversation_id": anchor_email.get("conversation_id", ""),
                "group_id": group_id,
                "subject": anchor_email.get("subject", ""),
                "source": anchor_email.get("source", ""),
                "category": anchor_email.get("category", "General"),
                "due_at": due_at.isoformat(), "message": "", "use_ai": True,
                "note": "Auto follow-up after quote completion",
                "source_reason": "quote_completion_autocleanup",
                "completed": False, "cancelled": False,
                "created_at": datetime.now().isoformat(),
            }
            self.followups.append(item)
            self._followup_dedup_needed = True
            try:
                anchor_email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
            except Exception:
                pass
            self.save_followups()
            return True
        except Exception:
            return False

    def _collect_replied_customer_rfq_archive_candidates(self):
        """v4.1.65/68: MAIN-thread, no-COM candidate scan for reply-driven group
        archive. Returns one candidate per ACTIVE group that holds an OPEN (not
        Completed/Low/Junk) CUSTOMER (type-C) RFQ. v4.1.68: does NOT gate on the
        stored user_replied flag (stale -- read only at import, never refreshed on a
        later reply); the Outlook worker is the authority and confirms a SUBSTANTIVE
        sent reply actually exists in the thread before the group is archived. A group
        already handled this session is skipped; the durable guard is the email itself
        becoming Completed, so a restart never re-fires on an already-handled thread."""
        out = []
        try:
            processed = getattr(self, "_replied_rfq_archive_processed", None)
            if not isinstance(processed, set):
                processed = self._replied_rfq_archive_processed = set()
            for g in list(self.groups_data.get("groups", []) or []):
                if not isinstance(g, dict) or g.get("archived"):
                    continue
                gid = g.get("id", "")
                if not gid or gid in processed:
                    continue
                # v4.2.12: emit EVERY member, not the first type-C one. The old loop took
                # the first C-typed open row and broke, so which member represented the
                # group depended on its position in self.emails -- a list that re-sorts on
                # any save. Reported live: "55 Water GFI 77994 BULK ORDER" was protected
                # for 3 days only because a MISTYPED vendor row (jonathans@theaenterprises
                # .com, typed C) happened to sit first and its thread carried our outbound
                # RFQ, so the v4.1.94 guard skipped it 118 times. The moment the pick moved
                # to the real customer the group archived off a clarifying QUESTION ("I just
                # wanted to confirm if equals were okay"). Selecting the originator is now
                # the WORKER's job, because only it can see who each message was addressed
                # to. email_type is deliberately NOT a filter here: mistyping is the failure
                # mode (James Larkin, Jonathan Smith both typed C while being vendors), so
                # gating on it would drop the very rows the originator test needs.
                members, has_open = [], False
                for e in self.get_emails_for_group(gid):
                    if not isinstance(e, dict):
                        continue
                    # v4.1.68: intentionally NOT gating on e["user_replied"] -- that flag is
                    # read only from PR_LAST_VERB_EXECUTED at import and never refreshes when
                    # the user replies to an already-imported RFQ, so it is stale (False)
                    # exactly when we need it. The worker's sent-reply check is the authority.
                    if not self.email_is_completed(e):
                        has_open = True
                    cid = e.get("conversation_id", "")
                    if not cid:
                        continue
                    try:
                        _rts = float(e.get("received_timestamp", 0) or 0)
                    except Exception:
                        _rts = 0.0
                    members.append({
                        "gid": gid,
                        "gname": g.get("name", ""),
                        "entry_id": e.get("entry_id", ""),
                        "conversation_id": cid,
                        "internet_message_id": e.get("internet_message_id", ""),
                        "subject": e.get("subject", ""),
                        "sender_email": str(e.get("sender_email", "") or "").strip().lower(),
                        "completed": bool(self.email_is_completed(e)),
                        # v4.2.13: a sent-waiting placeholder is OUR OWN outgoing message,
                        # but it stores the RECIPIENT's address in sender_email -- so it
                        # reads exactly like a customer row. Reported live: group
                        # "RE: Eastchester SER" archived off eid 'sentwait:2EEEB351...'.
                        # Six live groups currently have a placeholder as their earliest
                        # member, i.e. six that v4.2.12 would anchor on our own send.
                        "is_placeholder": bool(
                            e.get("is_sent_waiting_placeholder")
                            or str(e.get("entry_id", "") or "").startswith("sentwait:")
                            or str(e.get("source", "") or "").strip().lower().startswith("sent")),
                        "received_ts": _rts,
                    })
                if has_open and members:
                    out.extend(members)
        except Exception:
            pass
        return out

    # ---- v4.2.12 close-rule detectors -------------------------------------------
    # Steve's rule, in his words: "whoever sent the initial request, me responding
    # saying a price and availability or attached is your quote -- that sequence
    # closes it." Measured over 3,297 sent messages / 110 groups before shipping.

    # Outlook composes with a Unicode right single quote, so every pattern written
    # with an ASCII apostrophe silently never fires. This cost two measurement runs:
    # "we don't have these in stock" went on reading as a delivered quote because
    # don't != don't. Normalise first, always.
    _SMART_QUOTES = ("’", "‘", "ʼ", "´")

    # Most quotes go out as "attached is your quote" plus a lead time. The shipped
    # _reply_has_quote_content misses every one: the phrase is not in its keyword list
    # and "7-10 days" / "in a day" / "Thursday" / "2-4 weeks ARO" match none of its
    # "days out" / "weeks out" / "lead time" patterns. Five real jobs measured as
    # false holds without this: Welsbach JFK RHW, EJ Cantex Spacers, Kleinknecht MET
    # Tang Wing, WELSBACH NYCDEP, Raychem GelPorts.
    _QUOTE_DELIVERED_RE = re.compile(
        r"(?i)\b(?:attached\s+(?:is|are|please\s+find)\s+(?:your|the|our)\s+"
        r"(?:revised\s+|updated\s+|final\s+)?quotes?"
        r"|(?:here|below)\s+is\s+(?:your|the|our)\s+(?:revised\s+)?quotes?"
        r"|your\s+(?:revised\s+)?quotes?\s+(?:is|are)\s+attached"
        r"|(?:please\s+)?see\s+attached\s+(?:revised\s+)?quotes?"
        r"|attached\s+(?:is|are)\s+(?:your|the)\s+(?:pricing|prices))\b")

    # Per Steve: a definitive "we can't bid this" IS a complete answer and closes the
    # job. The shapes he actually writes: "everyone keeps no quoting me on it. Sorry I
    # tried." / "I think I am going to pass" / a bare "N/S".
    _DECLINED_RE = re.compile(
        r"(?i)(?:\b(?:can(?:'|no)?t\s+(?:quote|bid|help|supply)"
        r"|will\s+not\s+be\s+(?:quoting|bidding)"
        r"|no\s+(?:quote|bid|quoting)\b"
        r"|(?:i|we)(?:'m|'re| am| are)?\s+(?:going\s+to|gonna|have\s+to|will)\s+pass\b"
        r"|unable\s+to\s+(?:quote|bid|supply))"
        r"|sorry\s+i\s+tried\b)")
    _NS_ONLY_RE = re.compile(r"(?i)^\W*n\s*/\s*s\W*$")

    # _reply_has_quote_content substring-matches "in stock", so "we don't have these
    # in stock" reads to it as a quote. Measured on Tom Wynohradnyk (USIS, a real
    # customer): that sentence closed his job. A negated stock line is never a quote;
    # on its own it is a decline, but followed by an offer to keep looking it is an
    # open question and the customer still owes us a decision.
    _NEG_STOCK_RE = re.compile(
        r"(?i)(?:\bno\s+stock\b|\bout\s+of\s+stock\b|\bnot\s+in\s+stock\b"
        r"|\b(?:do\s?n'?t|does\s?n'?t|do\s+not|cannot|can'?t)\s+(?:currently\s+)?"
        r"(?:have|carry|stock|get)\b[^.!?]{0,40}?(?:\bstock\b|\bavailab)"
        r"|\bnothing\s+(?:in|available)\b)")
    # Suppresses the DECLINE reading only -- never the quote reading, so "Attached is
    # your quote... please let me know if I can help with anything else" still closes.
    # The promise-to-report-back arm exists because _sent_reply_is_deferral does not
    # cover "let me find out on your backorders and I'll let you know", which measured
    # as a false close: a no-stock line plus an undertaking is not a final answer.
    _OPEN_QUESTION_RE = re.compile(
        r"(?i)(?:\b(?:do\s+you\s+want\s+me\s+to|would\s+you\s+like\s+me(?:\s+to)?"
        r"|should\s+i\b|let\s+me\s+know\s+if\s+you(?:'d| would)\s+like"
        r"|please\s+advise|do\s+you\s+need"
        r"|let\s+me\s+(?:find\s+out|see|check)"
        r"|(?:i|we)'?(?:ll| will)\s+let\s+you\s+know)\b)")

    _ATTACH_HIDDEN_PROP = "http://schemas.microsoft.com/mapi/proptag/0x7FFE000B"
    _QUOTE_DOC_EXT = (".pdf", ".xls", ".xlsx", ".xlsm", ".doc", ".docx", ".csv")

    @classmethod
    def _normalize_quotes(cls, text):
        out = str(text or "")
        for ch in cls._SMART_QUOTES:
            out = out.replace(ch, "'")
        return out

    def _describe_sent_reply(self, sent_msg):
        """OUTLOOK WORKER ONLY. Reduce one sent message to the facts the close rule
        needs, so the decision itself stays pure and testable off-COM."""
        rec = {"to": [], "own": "", "quote": False, "decline": False,
               "deferral": False, "outbound_rfq": False, "docs": []}
        try:
            # Recipient SMTP resolution, same approach as the v4.1.77 sent-tracker path:
            # .To is Outlook's DISPLAY string and useless for comparing against a row's
            # sender_email. This is the whole point of the rule -- our outbound RFQ and
            # our answer to the customer read identically ("price and availability"), and
            # only the addressee tells them apart.
            for _rcp in sent_msg.Recipients:
                try:
                    try:
                        if int(getattr(_rcp, "Type", 1) or 1) != 1:  # olTo only
                            continue
                    except Exception:
                        pass
                    _addr = ""
                    try:
                        _addr = str(_rcp.PropertyAccessor.GetProperty(
                            "http://schemas.microsoft.com/mapi/proptag/0x39FE001F") or "")
                    except Exception:
                        _addr = ""
                    if "@" not in _addr:
                        try:
                            _raw = str(getattr(_rcp, "Address", "") or "")
                            if "@" in _raw and not _raw.lower().startswith("/o="):
                                _addr = _raw
                        except Exception:
                            pass
                    _addr = extract_email_address(_addr).lower()
                    if _addr and "@" in _addr and _addr not in rec["to"]:
                        rec["to"].append(_addr)
                except Exception:
                    continue
        except Exception:
            pass
        try:
            own = self._normalize_quotes(
                self._own_reply_text(getattr(sent_msg, "Body", "") or ""))
        except Exception:
            own = ""
        rec["own"] = own
        try:
            rec["outbound_rfq"] = bool(
                self._sent_reply_is_outbound_rfq(self._strip_signature_block(own)))
        except Exception:
            rec["outbound_rfq"] = False
        # v4.2.49: the request often lives ONLY in the SUBJECT ("... P&A") while
        # the body is a greeting + pasted material list -- no request phrase for
        # the body test to find. A request-shaped subject with no price evidence
        # in our own words is still us ASKING. (Trade-off, documented: a real
        # quote answered on a customer's "P&A" subject with prices only in an
        # attached PDF now stays OPEN instead of auto-archiving -- a benign
        # false-open the user closes via the normal completion prompt, versus
        # the destructive false-archive this fixes.)
        if not rec["outbound_rfq"]:
            try:
                _subj = str(getattr(sent_msg, "Subject", "") or "").lower()
                if (re.search(r"\bp\s*&\s*a\b|\brfq\b|quote\s+request|please\s+quote", _subj)
                        and not re.search(r"\$\s*\d", own)
                        and not re.search(r"\b\d+(?:\.\d+)?\s*(?:/\s*)?(?:ea|each|pcs?|per\s+(?:ea|foot|ft))\b\s*(?:@|=|\$)", own)):
                    rec["outbound_rfq"] = True
            except Exception:
                pass
        try:
            rec["deferral"] = bool(self._sent_reply_is_deferral(own))
        except Exception:
            rec["deferral"] = False
        neg = bool(self._NEG_STOCK_RE.search(own))
        openq = bool(self._OPEN_QUESTION_RE.search(own))
        try:
            base = bool(self._reply_has_quote_content("", own))
        except Exception:
            base = False
        # An explicit "attached is your quote" still counts even when the same message
        # also reports something out of stock ("Attached is your quote. Stock in PA.").
        rec["quote"] = bool(self._QUOTE_DELIVERED_RE.search(own)) or (base and not neg)
        # "N/S" is a whole-message answer, so it has to be tested on SIGNATURE-STRIPPED
        # words -- _own_reply_text removes the quoted chain but leaves the signature, and
        # every send carries ~450 chars of it. Same basis v4.1.87 had to adopt for the
        # deferral test, for exactly the same reason.
        try:
            bare = str(self._strip_signature_block(own) or "").strip()
        except Exception:
            bare = own.strip()
        rec["decline"] = bool(
            (self._DECLINED_RE.search(own) or neg or self._NS_ONLY_RE.match(bare))
            and not openq)
        # Real document attachments only. PR_ATTACHMENT_HIDDEN separates a genuine
        # attachment from an inline signature image: measured across 238 sent messages,
        # 1161 parts were inline signature art and only 85 were documents, and the flag
        # classified all 1161 correctly where scanning the HTMLBody for cid: references
        # misclassified 16. Recorded for telemetry; the close decision rides on the body,
        # because Steve confirmed he always writes the price/availability in the text.
        try:
            for i in range(int(sent_msg.Attachments.Count)):
                try:
                    att = sent_msg.Attachments.Item(i + 1)
                    try:
                        if bool(att.PropertyAccessor.GetProperty(self._ATTACH_HIDDEN_PROP)):
                            continue
                    except Exception:
                        pass
                    fn = str(att.FileName or "")
                    if fn.lower().endswith(self._QUOTE_DOC_EXT):
                        rec["docs"].append(fn)
                except Exception:
                    continue
        except Exception:
            pass
        return rec

    def _decide_replied_rfq_archive(self, members, matched):
        """MAIN-THREAD-SAFE, NO COM: given one group's members and the sent replies
        found on their threads, decide whether the group is finished.

        The originator is the earliest member who is NOT a vendor leg, where a vendor
        leg is a member we sent an outbound RFQ to ON THEIR OWN THREAD. That test is
        deliberately per-conversation: a global "anyone we ever sent an RFQ to" needs a
        full Sent sweep, and v4.2.11's _origination_convs was measured and REJECTED here
        because it only covers threads whose subject carried no Re:/Fw:, so replying
        into a vendor's existing thread left the vendor eligible to anchor the group
        (t.ferrante@cableandconnections anchored two).

        Returns the candidate dict to archive on, or None to leave the group open.
        """
        if not members:
            return None
        legs = []
        for m in members:
            addr = str(m.get("sender_email", "") or "").strip().lower()
            if "@" not in addr:
                continue
            # v4.2.13: never anchor on one of our own sends. A placeholder carries the
            # recipient's address, so without this it is indistinguishable from the
            # customer's request and can win the earliest-member test outright.
            # Re-derived here rather than trusting the caller's flag: this method is the
            # pure, testable unit and must not depend on the collector having tagged the
            # row correctly -- the harness caught exactly that dependency.
            if (m.get("is_placeholder")
                    or str(m.get("entry_id", "") or "").startswith("sentwait:")
                    or str(m.get("source", "") or "").strip().lower().startswith("sent")):
                continue
            vendor = False
            for rec in matched.get(str(m.get("entry_id", "") or ""), []):
                if rec.get("outbound_rfq") and addr in (rec.get("to") or []):
                    vendor = True
                    break
            if not vendor:
                legs.append(m)
        if not legs:
            return None  # RFQ-seeded group with no customer request in it
        originator = min(legs, key=lambda m: float(m.get("received_ts", 0) or 0))
        addr = str(originator.get("sender_email", "") or "").strip().lower()
        gname = str(originator.get("gname", "") or "")[:40]
        # v4.2.26: aggregate replies across EVERY member sharing the originator's
        # conversation or sender -- not only the originator row. The worker maps each
        # sent message to ONE candidate via by_conv (FIRST candidate in list order);
        # with two rows on one conversation the replies could attach to the sibling
        # row and the originator then looked unanswered. Reported live: "1582 L14-30
        # IG" stayed open although the quote ("$41.96...") went to danny@ at 17:14.
        _ocid = str(originator.get("conversation_id", "") or "")
        replies = []
        for m2 in members:
            if not isinstance(m2, dict):
                continue
            if (str(m2.get("conversation_id", "") or "") != _ocid
                    and str(m2.get("sender_email", "") or "").strip().lower() != addr):
                continue
            for r in matched.get(str(m2.get("entry_id", "") or ""), []):
                if addr in (r.get("to") or []):
                    replies.append(r)
        if not replies:
            return None  # we never answered the person who asked
        replies.sort(key=lambda r: float(r.get("sent_ts", 0) or 0))
        for rec in replies:
            # v4.2.49: OUR OWN OUTBOUND RFQ can never close the job. The flag has
            # existed since v4.1.94 and already excludes vendor LEGS above -- but
            # this selection loop never consulted it, so a P&A send whose body is
            # a greeting + material list classified as quote-content and archived
            # the group (reproduced live twice on 2026-08-19: the JFK wire job at
            # 16:22 and 'Welsbach Quote Request P&A' at 16:55).
            if rec.get("outbound_rfq"):
                continue
            if rec.get("decline"):
                why = "declined"
            elif rec.get("quote"):
                why = "quote"
            elif rec.get("deferral"):
                continue
            else:
                continue
            picked = dict(originator)
            picked["sent_ts"] = rec.get("sent_ts") or datetime.now().timestamp()
            picked["close_reason"] = why
            try:
                ops_log("group", "replied_rfq_close_match", gname=gname, why=why,
                        to=addr[:40], docs=len(rec.get("docs") or []),
                        own=str(rec.get("own", "") or "").strip()[:80])
            except Exception:
                pass
            return picked
        try:
            ops_log("group", "replied_rfq_no_answer_yet", gname=gname, to=addr[:40],
                    replies=len(replies),
                    own=str((replies[-1].get("own") or ""))[:80])
        except Exception:
            pass
        return None

    def _check_replied_rfq_archives_async(self, _retry=0):
        """v4.1.65: reply-driven group auto-archive. When the user replies to a
        customer RFQ DIRECTLY in Outlook (so no in-app pending-reply-check was ever
        armed), the RFQ used to sit 'New' forever and its group never archived.
        Mirrors _check_pending_sent_replies_async: candidates gathered on the MAIN
        thread (cheap, no COM), the sent reply confirmed SUBSTANTIVE on an Outlook
        WORKER, then completion + archive + the follow-up prompt applied back on the
        MAIN thread. Per the user's rule: a substantive reply to ANY customer RFQ in
        a group archives the whole group."""
        try:
            candidates = self._collect_replied_customer_rfq_archive_candidates()
        except Exception:
            candidates = []
        if not candidates:
            return

        def collect(outlook, namespace):
            # v4.1.68/70: ONE newest-first walk over BOTH the user's Sent AND the shared
            # Sales Sent (a reply may go out from either). Match each candidate's reply by
            # ConversationID OR by Internet Message-ID -- the reply's In-Reply-To/References
            # carries the RFQ's Message-ID, which is drift-proof when an external client
            # (Gmail/Yahoo) threads under a different ConversationID (per CLAUDE.md: match on
            # Internet Message-ID, never EntryID). Only replies sent AFTER the RFQ arrived
            # count; SUBSTANTIVE (not thank-you/ack) is confirmed for matched threads only.
            by_conv = {}
            by_msgid = {}
            oldest_recv = None
            for c in candidates:
                cid = c.get("conversation_id", "")
                if cid and cid not in by_conv:
                    by_conv[cid] = c
                mid = str(c.get("internet_message_id", "") or "").strip()
                if mid and mid not in by_msgid:
                    by_msgid[mid] = c
                try:
                    _ts = float(c.get("received_ts", 0) or 0)
                    if _ts > 0:
                        oldest_recv = _ts if oldest_recv is None else min(oldest_recv, _ts)
                except Exception:
                    pass
            if not by_conv and not by_msgid:
                return []
            try:
                cutoff = (datetime.fromtimestamp(oldest_recv) - timedelta(minutes=1)
                          if oldest_recv else datetime.now() - timedelta(days=30))
            except Exception:
                cutoff = datetime.now() - timedelta(days=30)

            folders = []
            try:
                _own = namespace.GetDefaultFolder(5)  # olFolderSentMail
                if _own is not None:
                    folders.append(_own)
            except Exception:
                pass
            try:
                _sales = self._find_sales_sent_folder_in(namespace)
                if _sales is not None:
                    _dup = False
                    try:
                        _sid = str(getattr(_sales, "EntryID", "") or "")
                        _dup = any(_sid and _sid == str(getattr(_f, "EntryID", "") or "")
                                   for _f in folders)
                    except Exception:
                        _dup = False
                    if not _dup:
                        folders.append(_sales)
            except Exception:
                pass

            def _match_candidate(cur):
                # ConversationID first (cheap), then Internet Message-ID header fallback.
                try:
                    _cid = cur.ConversationID or ""
                except Exception:
                    _cid = ""
                if _cid and _cid in by_conv:
                    return by_conv[_cid]
                if by_msgid:
                    refs = ""
                    try:
                        pa = cur.PropertyAccessor
                        try:
                            refs = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1042001F") or "")
                        except Exception:
                            refs = ""
                        if not refs:
                            try:
                                refs = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1039001F") or "")
                            except Exception:
                                refs = ""
                    except Exception:
                        refs = ""
                    if refs:
                        for _mid, _c in by_msgid.items():
                            if _mid and _mid in refs:
                                return _c
                return None

            # v4.2.12: keep EVERY matching send per candidate, not just the newest one.
            # The decision now needs the whole picture of a thread -- our outbound RFQ to
            # a vendor AND our answer to the customer can both live on group threads, and
            # which one we happened to keep decided the group's fate.
            matched = {}  # candidate entry_id -> [sent reply descriptor, ...]
            for sent_folder in folders:
                try:
                    items = sent_folder.Items
                    items.Sort("[SentOn]", True)
                    msg = items.GetFirst()
                except Exception:
                    continue
                checked = 0
                while msg is not None and checked < 300:
                    cur = msg
                    try:
                        msg = items.GetNext()
                    except Exception:
                        msg = None
                    checked += 1
                    try:
                        sent_on = cur.SentOn
                        sdt = sent_on.replace(tzinfo=None) if sent_on else None
                        if sdt and sdt < cutoff:
                            break
                        c = _match_candidate(cur)
                        if c is None:
                            continue
                        eid = c.get("entry_id", "")
                        if not eid:
                            continue
                        try:
                            _recv = float(c.get("received_ts", 0) or 0)
                        except Exception:
                            _recv = 0
                        if _recv and sdt and sdt.timestamp() < _recv:
                            continue  # a send that predates the RFQ is not its reply
                        rec = self._describe_sent_reply(cur)
                        try:
                            rec["sent_ts"] = (sdt or datetime.now()).timestamp()
                        except Exception:
                            rec["sent_ts"] = datetime.now().timestamp()
                        matched.setdefault(eid, []).append(rec)
                    except Exception:
                        continue

            by_group = {}
            for c in candidates:
                by_group.setdefault(str(c.get("gid", "") or ""), []).append(c)
            out = []
            for gid, members in by_group.items():
                try:
                    picked = self._decide_replied_rfq_archive(members, matched)
                except Exception:
                    picked = None
                if picked:
                    out.append(picked)
            # v4.1.69/70: telemetry so this scan is never invisible again.
            try:
                ops_log("group", "replied_rfq_scan", candidates=len(candidates),
                        groups=len(by_group), convs=len(by_conv), msgids=len(by_msgid),
                        folders=len(folders), matched=len(out))
            except Exception:
                pass
            return out

        def apply(results):
            try:
                self._apply_replied_customer_rfq_archives(results)
            except Exception:
                pass

        def on_busy(_e):
            # v4.1.69: the shared Outlook worker lock was busy -- the pending-reply worker
            # dispatched just before this in the same tick usually wins the non-blocking
            # race, which silently starved this scan EVERY cycle (there are always active
            # pending checks). Re-arm a bounded, delayed retry; by then that worker has
            # released the lock. Bounded so a genuinely stuck worker can't loop forever.
            if _retry < 4:
                try:
                    self.root.after(9000, lambda: self._check_replied_rfq_archives_async(_retry + 1))
                except Exception:
                    pass

        self.run_outlook_worker(collect, on_done=apply, on_error=on_busy,
                                label="replied-rfq-archive-scan")

    def _apply_replied_customer_rfq_archives(self, results):
        """v4.1.65: MAIN thread. Complete each replied customer RFQ, archive its
        group (visible + Undo-able via the existing quote-completion assistant log),
        and queue the optional follow-up prompt. Idempotent: an already-archived
        group or already-Completed email is skipped, and the group is remembered so
        it is not re-processed this session."""
        if not results:
            return
        processed = getattr(self, "_replied_rfq_archive_processed", None)
        if not isinstance(processed, set):
            processed = self._replied_rfq_archive_processed = set()
        did = False
        for r in results:
            try:
                gid = r.get("gid", "")
                if not gid:
                    continue
                g = self.get_group_by_id(gid)
                if not g or g.get("archived"):
                    processed.add(gid)
                    continue
                eid = r.get("entry_id", "")
                email = self.get_email_by_id(eid) if eid else None
                if email and not self.email_is_completed(email):
                    email["status"] = "Completed"
                    email["followup_time"] = ""
                    email["is_new_import"] = False
                    email["sent_waiting_tracker_active"] = False
                    try:
                        _sd = self.status_data.get(eid) if isinstance(self.status_data, dict) else None
                        if isinstance(_sd, dict):
                            _sd["status"] = "Completed"
                    except Exception:
                        pass
                    try:
                        self._cancel_active_followups_for_email(email, reason="Quote delivered (P&A reply)")
                    except Exception:
                        pass
                    try:
                        self.save_record(email)
                    except Exception:
                        pass
                archived = self._archive_group_by_id(gid)
                processed.add(gid)
                if not archived:
                    continue
                did = True
                try:
                    ops_log("group", "replied_rfq_auto_archive", gid=gid,
                            gname=g.get("name", ""), eid=eid, subject=r.get("subject", ""))
                except Exception:
                    pass
                # Visible + Undo-able, reusing the existing quote-completion log path
                # (dedup qccleanup:<gid>, already_archived stops re-archiving, Undo
                # un-archives). No auto follow-up here -- the user chooses via prompt.
                try:
                    _n = len([e for e in self.get_emails_for_group(gid) if e])
                    self._assistant_log_quote_completion(g, email, _n, followup_made=False)
                except Exception:
                    pass
                try:
                    self._queue_followup_prompt_after_auto_archive(gid, g.get("name", ""), email)
                except Exception:
                    pass
            except Exception:
                continue
        if did:
            try:
                self.flush_status_data()
            except Exception:
                pass
            try:
                self.sort_emails_for_display()
                self.render_email_rows()
                self.render_group_rows()
            except Exception:
                pass

    def _queue_followup_prompt_after_auto_archive(self, group_id, group_name, anchor_email):
        """v4.1.65: enqueue a follow-up prompt and show them ONE AT A TIME so a tick
        that archives several groups never stacks modal dialogs."""
        q = getattr(self, "_followup_prompt_queue", None)
        if not isinstance(q, list):
            q = self._followup_prompt_queue = []
        q.append({"group_id": group_id, "group_name": group_name,
                  "anchor_email": anchor_email or {}})
        if not getattr(self, "_followup_prompt_active", False):
            self._show_next_followup_prompt_after_auto_archive()

    def _ensure_dialog_reachable(self, win):
        """v4.2.33: make a modal REACHABLE before it takes the grab.

        Reported repeatedly, and finally caught in the act: MaINbox minimized, its
        'Schedule a follow-up?' dialog holding the Tk grab while parked at (0,0) behind
        everything, and the main window minimized off-screen at -32000. Windows still let
        the user drag windows around (the window manager does that), but Tk routes every
        event to the grab holder, so no click anywhere did anything. The app was never
        hung -- SendMessageTimeout came back in 0-1ms on all four windows.
        """
        try:
            root = getattr(self, "root", None)
            if root is not None and str(root.state()) == "iconic":
                # A modal owned by a MINIMIZED master is unreachable by definition.
                root.deiconify()
            win.update_idletasks()
            sw, sh = win.winfo_screenwidth(), win.winfo_screenheight()
            ww = max(1, win.winfo_width())
            wh = max(1, win.winfo_height())
            x, y = win.winfo_rootx(), win.winfo_rooty()
            # Off-screen, or so close to an edge that the buttons are unreachable.
            if x < 0 or y < 0 or x + 60 > sw or y + 60 > sh or ww > sw or wh > sh:
                nx = max(0, int((sw - min(ww, sw)) / 2))
                ny = max(0, int((sh - min(wh, sh)) / 3))
                win.geometry("+%d+%d" % (nx, ny))
            win.deiconify()
            win.lift()
        except Exception:
            pass

    def _register_grab_release(self, win):
        """v4.2.33: guarantee the release. The audit that started this: 12 grab_set calls
        against 4 grab_release -- eight modals could exit without ever giving the grab
        back. Bound with add="+" so no dialog's own <Destroy> handler is displaced."""
        try:
            def _release(event=None, _w=win):
                try:
                    if event is not None and getattr(event, "widget", None) is not _w:
                        return  # <Destroy> bubbles from child widgets; only the toplevel counts
                except Exception:
                    pass
                try:
                    if _w.grab_current() is _w:
                        _w.grab_release()
                except Exception:
                    pass
            win.bind("<Destroy>", _release, add="+")
        except Exception:
            pass

    def safe_grab_set(self, win):
        """v4.2.33: the ONLY way this app takes a modal grab. Pulls the dialog somewhere
        the user can actually reach it, takes the grab, and arms the release."""
        try:
            self._ensure_dialog_reachable(win)
        except Exception:
            pass
        try:
            win.grab_set()
        except Exception:
            return False
        try:
            self._register_grab_release(win)
            self._arm_grab_watchdog()
        except Exception:
            pass
        return True

    def _arm_grab_watchdog(self):
        if getattr(self, "_grab_watchdog_armed", False):
            return
        self._grab_watchdog_armed = True
        self._grab_stale_strikes = 0
        try:
            self.root.after(GRAB_WATCHDOG_SECONDS * 1000, self._grab_watchdog_tick)
        except Exception:
            self._grab_watchdog_armed = False

    def _grab_watchdog_tick(self):
        """v4.2.33: the safety net. If a grab is held by a window that is not actually on
        screen for GRAB_WATCHDOG_STRIKES consecutive checks, release it -- otherwise the
        whole UI stays dead with no way back except killing the app. Only ever releases a
        grab held by an UNREACHABLE window; a normal visible modal is untouched."""
        try:
            cur = None
            try:
                cur = self.root.grab_current()
            except Exception:
                cur = None
            if cur is None:
                self._grab_stale_strikes = 0
            else:
                reachable = False
                try:
                    top = cur.winfo_toplevel()
                    reachable = bool(
                        cur.winfo_exists() and top.winfo_ismapped() and top.winfo_viewable()
                        and str(top.state()) not in ("iconic", "withdrawn"))
                except Exception:
                    reachable = False
                if reachable:
                    self._grab_stale_strikes = 0
                else:
                    self._grab_stale_strikes = int(getattr(self, "_grab_stale_strikes", 0)) + 1
                    if self._grab_stale_strikes >= GRAB_WATCHDOG_STRIKES:
                        self._grab_stale_strikes = 0
                        try:
                            cur.grab_release()
                        except Exception:
                            pass
                        try:
                            ops_log("ui", "stale_grab_released",
                                    widget=str(cur)[:80], strikes=GRAB_WATCHDOG_STRIKES,
                                    every=GRAB_WATCHDOG_SECONDS)
                        except Exception:
                            pass
        except Exception:
            pass
        finally:
            try:
                self.root.after(GRAB_WATCHDOG_SECONDS * 1000, self._grab_watchdog_tick)
            except Exception:
                self._grab_watchdog_armed = False

    def _show_next_followup_prompt_after_auto_archive(self):
        """v4.1.65: MAIN thread. Pop one 'Schedule a follow-up?' dialog for a group
        archived by the reply-driven auto-archive. Schedule creates a manual-lane
        follow-up at the chosen time; No thanks does nothing. Chains to the next
        queued prompt on close."""
        q = getattr(self, "_followup_prompt_queue", None)
        if not isinstance(q, list) or not q:
            self._followup_prompt_active = False
            return
        item = q.pop(0)
        self._followup_prompt_active = True
        gid = item.get("group_id", "")
        gname = item.get("group_name", "")
        anchor = item.get("anchor_email", {}) or {}

        def _finish():
            self._followup_prompt_active = False
            try:
                self.root.after(50, self._show_next_followup_prompt_after_auto_archive)
            except Exception:
                pass

        try:
            win = tk.Toplevel(self.root)
            win.title("Schedule a follow-up?")
            win.transient(self.root)
            try:
                win.configure(bg=_BG)
            except Exception:
                pass
            try:
                win.resizable(False, False)
            except Exception:
                pass
            tk.Label(win, text="Group archived after your reply",
                     font=("Segoe UI", 14, "bold"), bg=_BG, fg=_FG).pack(padx=16, pady=(14, 4))
            tk.Label(win, text=f"'{gname}' was auto-archived because you replied to the customer.\n"
                               "Schedule a follow-up reminder to chase it?",
                     font=("Segoe UI", 10), bg=_BG, fg=_FG, justify="left").pack(padx=16, pady=4)
            row = tk.Frame(win, bg=_BG)
            row.pack(padx=16, pady=10)
            tk.Label(row, text="Follow-up:", bg=_BG, fg=_FG).pack(side="left", padx=4)
            time_var = tk.StringVar(value="Tomorrow 9 AM")
            choices = ["1 hour", "2 hours", "4 hours", "Tomorrow 9 AM",
                       "Tomorrow 7 AM", "2 days", "1 week", "3:00 PM"]
            ttk.Combobox(row, textvariable=time_var, values=choices, state="readonly",
                         width=16).pack(side="left", padx=4)
            btns = tk.Frame(win, bg=_BG)
            btns.pack(padx=16, pady=(6, 14))

            def _schedule():
                try:
                    target_dt = parse_followup_time(time_var.get().strip())
                except Exception:
                    target_dt = None
                if not target_dt:
                    try:
                        messagebox.showerror("Invalid Time",
                                             "Choose one of the preset follow-up times.", parent=win)
                    except Exception:
                        pass
                    return
                try:
                    self._create_followup_at(gid, anchor, target_dt)
                except Exception:
                    pass
                try:
                    win.destroy()
                except Exception:
                    pass
                _finish()

            def _no():
                try:
                    win.destroy()
                except Exception:
                    pass
                _finish()

            tk.Button(btns, text="Schedule follow-up", command=_schedule, width=20).pack(side="left", padx=6)
            tk.Button(btns, text="No thanks", command=_no, width=12).pack(side="left", padx=6)
            win.protocol("WM_DELETE_WINDOW", _no)
            try:
                self.safe_grab_set(win)
            except Exception:
                pass
        except Exception:
            _finish()

    def _create_followup_at(self, group_id, anchor_email, due_dt):
        """v4.1.65: create ONE manual-lane follow-up for an archived group at the
        user-chosen time. Mirrors _create_quote_completion_followup's item shape but
        with an explicit due time and no dedup no-op (the user explicitly asked for
        this reminder). Returns True if created."""
        try:
            if not due_dt:
                return False
            anchor = anchor_email or {}
            item = {
                "entry_id": anchor.get("entry_id", ""),
                "store_id": anchor.get("store_id", ""),
                "conversation_id": anchor.get("conversation_id", ""),
                "group_id": group_id,
                "subject": anchor.get("subject", ""),
                "source": anchor.get("source", ""),
                "category": anchor.get("category", "General"),
                "due_at": due_dt.isoformat(), "message": "", "use_ai": True,
                "note": "Follow-up after reply-driven auto-archive",
                "source_reason": "replied_rfq_autoarchive_followup",
                "completed": False, "cancelled": False,
                "created_at": datetime.now().isoformat(),
            }
            self.followups.append(item)
            self._followup_dedup_needed = True
            try:
                anchor["followup_time"] = due_dt.strftime("%m/%d %I:%M %p")
            except Exception:
                pass
            self.save_followups()
            try:
                self.render_followup_preview_queue()
            except Exception:
                pass
            return True
        except Exception:
            return False

    def _run_quote_completion_autocleanup(self):
        """Quote Completion auto-cleanup (opt-in; off by default). For each ACTIVE
        (non-archived) group where every email is closed (Completed/Low/Junk) AND at
        least one is genuinely Completed -- i.e. the quote is finished, not just a
        buried junk pile -- archive the group and schedule the chase follow-up.
        Returns the number of groups archived. Main-thread only (archives + renders).

        Re-fire safety: an archived group is skipped here, and reactivation only
        un-archives on a NEW inbound (which is not Completed), so the group can't
        immediately re-qualify; the follow-up dedup blocks a duplicate reminder."""
        archived = 0
        try:
            if not bool(getattr(self, "settings", {}).get("quote_completion_autocleanup_enabled", False)):
                return 0
            made_followup = False
            for _g in list(self.groups_data.get("groups", []) or []):
                if not isinstance(_g, dict) or _g.get("archived"):
                    continue
                _gid = _g.get("id", "")
                if not _gid:
                    continue
                _ge = [e for e in self.get_emails_for_group(_gid) if e]
                if not _ge:
                    continue
                if all(self.email_is_completed(e) for e in _ge) and any(e.get("status") == "Completed" for e in _ge):
                    _anchor = max(_ge, key=lambda e: e.get("received_timestamp", 0))
                    _made_fu = self._create_quote_completion_followup(_gid, _anchor)
                    if _made_fu:
                        made_followup = True
                    if self._archive_group_by_id(_gid):
                        archived += 1
                        # Surface this auto-cleanup in the assistant activity log so the
                        # user is AWARE it happened and can Undo (un-archive) it if it was
                        # wrong -- matching the visible one-click Cleanup on the detected-
                        # close path. Logged as an already-done action (no re-archiving).
                        self._assistant_log_quote_completion(_g, _anchor, len(_ge), _made_fu)
            if made_followup:
                try:
                    self.render_followup_preview_queue()
                except Exception:
                    pass
        except Exception:
            pass
        return archived

    def _assistant_log_quote_completion(self, group, anchor_email, email_count, followup_made=False):
        """Record a Quote-Completion auto-cleanup (group archived + optional chase
        follow-up) in the assistant activity log so it is VISIBLE and reversible --
        exactly like the detected-close Cleanup, so the user is aware and can Undo
        it. The archive has ALREADY happened, so this is logged as a done action:
        payload already_archived stops _assistant_apply from re-archiving, and the
        log's Undo un-archives via _assistant_undo. dedup_key collapses repeat scans
        of the same group onto one row. No-op if the assistant is off/absent."""
        try:
            assistant = getattr(self, "assistant", None)
            if not assistant or not assistant.config.enabled:
                return
            if not isinstance(group, dict):
                return
            gid = group.get("id", "")
            if not gid:
                return
            gname = group.get("name", "")
            anchor = anchor_email or {}
            _n = int(email_count or 0)
            _fu = " + scheduled a chase follow-up" if followup_made else ""
            assistant.handle(
                kind="Cleanup", stakes=HIGH, confidence=0.9,
                subject=anchor.get("subject", ""), sender=anchor.get("sender", ""),
                summary=f"Auto-archived '{gname}' ({_n} email(s), kept){_fu} \u2014 quote completed",
                before={}, after={"action": f"archive group; keep {_n} email(s) linked{_fu}"},
                reason=("Quote Completion auto-cleanup: every email in this group is closed "
                        "and at least one is Completed, so the finished quote group was "
                        "archived (emails kept and hidden; Undo to bring it back)."),
                payload={"entry_id": anchor.get("entry_id", ""), "group_id": gid,
                         "already_archived": True},
                dedup_key=f"qccleanup:{gid}",
                force_auto=True,
            )
        except Exception:
            pass

    def _assistant_correction_options(self, rec):
        """Build the dropdown choices shown when the user clicks 'Correct…' on an
        assistant log row. Returns {field,title,prompt,choices,current} or None."""
        try:
            kind = (rec or {}).get("kind", "")
            p = rec.get("payload", {}) or {}
            eid = p.get("entry_id", "")
            if kind in ("Follow-up", "Reply draft"):
                return {
                    "field": "action",
                    "title": "Correct follow-up",
                    "prompt": "What should happen with this follow-up?",
                    "choices": [
                        ("keep",   "Keep it (approve the reminder)"),
                        ("cancel", "Cancel this follow-up"),
                        ("never",  "Never follow up on this email/thread"),
                    ],
                    "current": "keep",
                }
            if kind == "Group":
                active = [g for g in self.groups_data.get("groups", []) if not g.get("archived")]
                cur = self.get_group_id_for_email(eid) or p.get("group_id", "")
                choices = [("", "— Ungroup (remove from group) —")]
                choices += [(g.get("id", ""), g.get("name", "(unnamed)")) for g in active]
                return {
                    "field": "group",
                    "title": "Move to the right group",
                    "prompt": "Which group does this email belong in?",
                    "choices": choices,
                    "current": cur,
                }
            email = self.get_email_by_id(eid) or {}
            if kind == "Category":
                return {"field": "category", "title": "Correct category",
                        "prompt": "Pick the correct category:",
                        "choices": [(c, c) for c in CATEGORIES],
                        "current": email.get("category", "")}
            if kind == "Status":
                return {"field": "status", "title": "Correct status",
                        "prompt": "Pick the correct status:",
                        "choices": [(s, s) for s in STATUSES],
                        "current": email.get("status", "")}
            if kind == "Urgency":
                return {"field": "urgency", "title": "Correct urgency",
                        "prompt": "Pick the correct urgency:",
                        "choices": [(u, u) for u in URGENCY_LEVELS],
                        "current": email.get("urgency", "")}
            return None
        except Exception:
            return None

    def _assistant_apply_correction(self, rec, field, value, display=""):
        """Apply a dropdown correction chosen in the assistant log AND teach
        MaINbox so it groups / follows up better next time. Returns True on
        success. Called once per selected row by the log window (so the two-step
        bulk flow just calls this repeatedly with the same chosen value)."""
        try:
            p = rec.get("payload", {}) or {}
            eid = p.get("entry_id", "")
            email = self.get_email_by_id(eid) or p.get("email")
            kind = rec.get("kind", "")

            # ---- Follow-up / Reply draft: keep / cancel / never ----
            if kind in ("Follow-up", "Reply draft") and field == "action":
                if value == "keep":
                    # User approval overrides the confidence gate: schedule directly.
                    if email:
                        self.schedule_ai_followup_if_needed(
                            email, triage_result=p.get("triage"),
                            quick_result=p.get("quick"), force=True)
                    # Flip the row to handled without re-running the gate.
                    self._assistant_suppress_schedule = True
                    try:
                        if rec.get("state") == "pending":
                            self.assistant.approve(rec.get("id", ""))
                    except Exception:
                        pass
                    finally:
                        self._assistant_suppress_schedule = False
                    return True
                if value in ("cancel", "never"):
                    if email:
                        self._cancel_active_followups_for_email(
                            email,
                            reason=("User: never follow up on this thread" if value == "never"
                                    else "User cancelled from assistant log"))
                        if value == "never" and eid:
                            existing = self.status_data.get(eid, {})
                            existing["prevent_future_followups"] = True
                            self.status_data[eid] = existing
                            try:
                                self.flush_status_data()
                            except Exception:
                                pass
                    try:
                        self.assistant.mark_undone(rec.get("id", ""))
                    except Exception:
                        pass
                    return True
                return False

            # ---- Group: move to a different group (or ungroup) + learn ----
            if kind == "Group" and field == "group":
                if not email:
                    return False
                prev_gid = self.get_group_id_for_email(eid) or p.get("group_id", "")
                if value == prev_gid:
                    return True  # nothing to change
                mems = self.groups_data.setdefault("memberships", {})
                if value:
                    if not self.get_group_by_id(value):
                        return False
                    mems[eid] = value
                    self.mark_group_has_new(value)
                else:
                    mems.pop(eid, None)
                self.save_groups()
                try:
                    self.learn_group_from_user_move(email, value, previous_group_id=prev_gid)
                except Exception:
                    pass
                p["group_id"] = value  # keep the row payload consistent for any re-apply
                gname = (self.get_group_by_id(value) or {}).get("name", "") if value else ""
                self.render_group_rows()
                self.render_email_rows()
                try:
                    self.assistant.mark_corrected(rec.get("id", ""),
                                                  {"group": gname or "(ungrouped)"})
                except Exception:
                    pass
                return True

            # ---- Category / Status / Urgency ----
            if kind in ("Category", "Status", "Urgency") and field in ("category", "status", "urgency"):
                if not email:
                    return False
                email[field] = value
                self.save_record(email)
                self.flush_status_data()
                self.render_email_rows()
                try:
                    self.assistant.mark_corrected(rec.get("id", ""), {field: value})
                except Exception:
                    pass
                return True

            return False
        except Exception:
            return False

    def _assistant_edit_record(self, rec):
        """Double-click handler from the Assistant log. Email-type rows open the
        full triage / teach editor (with a group control); follow-up rows open the
        follow-up actions dialog (cancel / reschedule / Outlook reminder)."""
        try:
            p = rec.get("payload", {}) or {}
            email = self.get_email_by_id(p.get("entry_id", "")) or p.get("email")
            parent = getattr(self.assistant, "_log_win", None) or self.root
            if rec.get("kind", "") in ("Follow-up", "Reply draft"):
                self._assistant_followup_actions(email, rec, parent=parent)
                return
            if not email:
                try:
                    messagebox.showinfo("Edit", "This email isn't in the active cache anymore, so it can't be edited from here.", parent=parent)
                except Exception:
                    pass
                return

            def _after_saved():
                try:
                    if hasattr(self.assistant, "_notify"):
                        self.assistant._notify()
                except Exception:
                    pass

            self.open_triage_teach_editor(email, rec=rec, parent=parent, on_saved=_after_saved, show_group=True)
        except Exception:
            pass

    def open_triage_teach_editor(self, email, rec=None, parent=None, on_saved=None, show_group=True):
        """Reusable 'Correct this triage' editor: category / urgency / status,
        follow-up learning + timing, and (optionally) a group selector to assign
        the email to a group or ungroup it. Mirrors the AI Triage Center editor so
        the learning behavior stays identical, and adds grouping."""
        if not email:
            return
        parent = parent or self.root
        rec = rec or {}
        entry_id = email.get("entry_id", "")
        edit = tk.Toplevel(parent)
        edit.title("Edit Triage / Teach MaINbox")
        remember_window_geometry(edit, "Edit Triage Teach MaINbox", "540x430")
        edit.transient(parent)
        try:
            self.safe_grab_set(edit)
        except Exception:
            pass
        apply_theme(edit)
        tk.Label(edit, text="Correct this triage", font=("Segoe UI", 13, "bold"), bg=_BG, fg=_ACCENT).pack(anchor="w", padx=12, pady=(12, 4))
        subj = (email.get("subject", "") or rec.get("subject", "") or "No subject")
        tk.Label(edit, text=subj[:100], wraplength=480, bg=_BG, fg=_FG).pack(anchor="w", padx=12, pady=(0, 10))
        cat = tk.StringVar(value=email.get("category", "General"))
        urg = tk.StringVar(value=email.get("urgency", "Normal"))
        stat = tk.StringVar(value=email.get("status", "Needs Reply"))
        for label, var, vals in [("Workflow Category", cat, CATEGORIES), ("Urgency", urg, URGENCY_LEVELS), ("Status", stat, STATUSES)]:
            row = tk.Frame(edit, bg=_BG); row.pack(fill="x", padx=12, pady=5)
            tk.Label(row, text=label, width=18, anchor="w", bg=_BG, fg=_FG).pack(side="left")
            ttk.Combobox(row, textvariable=var, values=vals, state="readonly", width=28).pack(side="left")

        active_groups = [g for g in self.groups_data.get("groups", []) if not g.get("archived")]
        group_names = ["(Ungrouped)"] + [g.get("name", "(unnamed)") for g in active_groups]
        try:
            current_gid = self.get_group_id_for_email(entry_id) or ""
        except Exception:
            current_gid = ""
        current_group_name = next((g.get("name", "(unnamed)") for g in active_groups if g.get("id") == current_gid), "(Ungrouped)")
        group_var = tk.StringVar(value=current_group_name)
        if show_group:
            row = tk.Frame(edit, bg=_BG); row.pack(fill="x", padx=12, pady=5)
            tk.Label(row, text="Group", width=18, anchor="w", bg=_BG, fg=_FG).pack(side="left")
            ttk.Combobox(row, textvariable=group_var, values=group_names, state="readonly", width=28).pack(side="left")

        followup_behavior = tk.StringVar(value="Use Status/AI")
        followup_minutes = tk.StringVar(value="Use Default")
        row = tk.Frame(edit, bg=_BG); row.pack(fill="x", padx=12, pady=5)
        tk.Label(row, text="Follow-Up Learning", width=18, anchor="w", bg=_BG, fg=_FG).pack(side="left")
        ttk.Combobox(row, textvariable=followup_behavior, values=["Use Status/AI", "No Follow-Up", "Wait for Vendor", "Wait for Customer", "General Follow-Up Review"], state="readonly", width=28).pack(side="left")
        row = tk.Frame(edit, bg=_BG); row.pack(fill="x", padx=12, pady=5)
        tk.Label(row, text="Follow-Up Timing", width=18, anchor="w", bg=_BG, fg=_FG).pack(side="left")
        ttk.Combobox(row, textvariable=followup_minutes, values=["Use Default", "1 minute", "5 minutes", "15 minutes", "30 minutes", "1 hour", "2 hours", "4 hours", "Tomorrow", "3 days", "1 week"], state="readonly", width=28).pack(side="left")

        def save_edit():
            try:
                before = {"category": email.get("category", ""), "urgency": email.get("urgency", ""), "status": email.get("status", ""), "group": current_gid}
                # v4.1.16: the Teach editor can reopen a closed email; record the
                # explicit reopen so the closed guard cannot re-close it at startup.
                _was_closed = self._email_was_closed_before_edit(email)
                email["category"] = cat.get()
                email["urgency"] = urg.get()
                email["status"] = stat.get()
                email["is_new_import"] = False
                if _was_closed and not self.workflow_record_is_closed(email):
                    self._record_explicit_reopen_for_email(email, save=True)
                self.save_record(email)
                self.flush_status_data()
                try:
                    self.save_cached_state()
                except Exception:
                    pass
                try:
                    self.learn_from_user_correction(email, cat.get(), urg.get(), stat.get())
                except Exception:
                    pass

                new_gid = current_gid
                if show_group:
                    chosen = group_var.get()
                    if chosen == "(Ungrouped)":
                        self.groups_data.get("memberships", {}).pop(entry_id, None)
                        new_gid = ""
                    else:
                        gid = next((g.get("id") for g in active_groups if g.get("name", "(unnamed)") == chosen), "")
                        if gid:
                            self.groups_data.setdefault("memberships", {})[entry_id] = gid
                            try:
                                self.mark_group_has_new(gid)
                            except Exception:
                                pass
                            new_gid = gid
                    try:
                        self.save_groups()
                    except Exception:
                        pass

                fb = followup_behavior.get()
                minutes_choice = followup_minutes.get()
                minutes_val = self.followup_minutes_from_choice(minutes_choice)
                fb_map = {"No Follow-Up": "no_followup", "Wait for Vendor": "wait_for_vendor", "Wait for Customer": "wait_for_customer", "General Follow-Up Review": "followup_review"}
                learned_behavior = fb_map.get(fb, "")
                followup_note = ""
                if learned_behavior:
                    try:
                        self.learn_followup_behavior(email, learned_behavior, minutes_val, f"User taught follow-up behavior from Assistant editor: {fb}")
                    except Exception:
                        pass
                if learned_behavior == "no_followup":
                    cancelled = self._cancel_active_followups_for_email(email, "User taught No Follow-Up from Assistant editor", user_dismissed=True)
                    followup_note = f" No-follow-up applied; cancelled {cancelled} active item(s)."
                elif learned_behavior or minutes_val is not None:
                    behavior_for_now = learned_behavior or "followup_review"
                    if minutes_val is None:
                        if behavior_for_now == "wait_for_vendor":
                            minutes_val = VENDOR_NO_RESPONSE_MINUTES
                        elif behavior_for_now == "wait_for_customer":
                            minutes_val = CUSTOMER_PO_FOLLOWUP_MINUTES
                        else:
                            minutes_val = CUSTOMER_PO_FOLLOWUP_MINUTES
                    scenario_type = "ai_followup_review"
                    if behavior_for_now == "wait_for_vendor":
                        scenario_type = "ai_vendor_followup_review"
                    elif behavior_for_now == "wait_for_customer":
                        scenario_type = "ai_customer_followup_review"
                    try:
                        scheduled = self.schedule_scenario_reminder(scenario_type, email, int(minutes_val), f"User set follow-up from Assistant editor: {fb}; timing {minutes_choice}")
                        self.save_scenario_reminders()
                        followup_note = (f" Follow-up review scheduled in {int(minutes_val)} minute(s)." if scheduled
                                         else " Follow-up not scheduled (a matching reminder may already exist).")
                    except Exception:
                        pass

                try:
                    self.record_ai_triage_history(
                        email, before=before,
                        after={"category": cat.get(), "urgency": urg.get(), "status": stat.get(),
                               "group": new_gid, "followup_behavior": fb, "followup_minutes": minutes_val},
                        reason="User corrected from Assistant log." + followup_note, source="User Edit")
                except Exception:
                    pass
                try:
                    self.sort_emails_for_display(); self.render_email_rows(); self.render_group_rows(); self.render_followup_preview_queue()
                except Exception:
                    pass
                edit.destroy()
                if callable(on_saved):
                    try:
                        on_saved()
                    except Exception:
                        pass
            except Exception as exc:
                try:
                    messagebox.showerror("Edit Triage", f"Could not save the correction.\n\n{exc}", parent=edit)
                except Exception:
                    pass

        btns = tk.Frame(edit, bg=_BG); btns.pack(fill="x", padx=12, pady=15)
        tk.Button(btns, text="Save Correction", command=save_edit, width=18).pack(side="left", padx=5)
        tk.Button(btns, text="Cancel", command=edit.destroy, width=12).pack(side="left", padx=5)

    def _cancel_active_followups_for_email(self, email, reason="Cancelled by user",
                                           user_dismissed=False):
        """Mark every active follow-up / tracking item for one email cancelled
        across all collections, persist, and teach 'no follow-up'. Returns count.

        v4.2.18: user_dismissed records the same durable row stamp v4.2.17 added to the
        due-follow-up popup. It is an explicit opt-in, NOT the default, because four of
        this method's six callers are automatic ("Quote delivered (P&A reply)",
        "Quote closed", thread cleanup) -- stamping there would silence a row that later
        legitimately returns to Needs Reply. Only the two Assistant-log paths, where the
        user personally cancelled, pass True."""
        cancelled = 0
        now_iso = datetime.now().isoformat()
        try:
            for coll_name in ("followups", "scenario_reminders", "pending_reply_checks", "commitment_reminders"):
                coll = getattr(self, coll_name, None) or []
                for item in coll:
                    try:
                        if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                            item["cancelled"] = True
                            item["cancelled_at"] = now_iso
                            item["cancel_reason"] = reason
                            # v4.2.19: remove the Outlook calendar twin too.
                            self._enqueue_outlook_reminder_cancel(item)
                            cancelled += 1
                    except Exception:
                        continue
            # v4.2.18: same durable row stamp as the popup path, so the 30s sweep cannot
            # rebuild what the user just cancelled from the Assistant log. Written BEFORE
            # flush_status_data so it persists with the rest of the row.
            if user_dismissed:
                try:
                    _eid = str((email or {}).get("entry_id", "") or "")
                    if _eid:
                        self.status_data.setdefault(_eid, {})["reply_needed_dismissed_at"] = now_iso
                        try:
                            ops_log("followup", "reply_needed_dismissed", n=cancelled,
                                    reason=str(reason)[:48])
                        except Exception:
                            pass
                except Exception:
                    pass
            for saver in ("save_followups", "save_scenario_reminders", "save_commitment_reminders"):
                fn = getattr(self, saver, None)
                if callable(fn):
                    try:
                        fn()
                    except Exception:
                        pass
            try:
                self.flush_status_data()
            except Exception:
                pass
            try:
                self.learn_followup_behavior(email, "no_followup", None, reason)
            except Exception:
                pass
        except Exception:
            pass
        return cancelled

    def _assistant_followup_actions(self, email, rec, parent=None):
        """Manage the follow-up behind a log row: cancel it, change its date/time,
        or add / cancel a matching Outlook calendar reminder."""
        parent = parent or getattr(self.assistant, "_log_win", None) or self.root
        entry_id = (email or {}).get("entry_id", "") or ((rec.get("payload", {}) or {}).get("entry_id", ""))
        try:
            item = self.get_active_followup_for_email(entry_id)
        except Exception:
            item = None

        dlg = tk.Toplevel(parent)
        dlg.title("Follow-Up Actions")
        remember_window_geometry(dlg, "Assistant Follow-Up Actions", "460x300")
        dlg.transient(parent)
        try:
            self.safe_grab_set(dlg)
        except Exception:
            pass
        apply_theme(dlg)
        title = (email or {}).get("subject", "") or rec.get("subject", "") or "this follow-up"
        tk.Label(dlg, text="Follow-Up Actions", font=("Segoe UI", 13, "bold"), bg=_BG, fg=_ACCENT).pack(anchor="w", padx=12, pady=(12, 4))
        tk.Label(dlg, text=str(title)[:90], wraplength=420, bg=_BG, fg=_FG).pack(anchor="w", padx=12, pady=(0, 8))

        status_var = tk.StringVar()

        def _set_status():
            if not item:
                status_var.set("No active follow-up found for this email (it may already be done or cancelled).")
            elif item.get("outlook_appt_entry_id"):
                status_var.set("An Outlook reminder is attached to this follow-up.")
            else:
                status_var.set("No Outlook reminder attached yet.")
        _set_status()

        def _refresh_log():
            try:
                if hasattr(self.assistant, "_notify"):
                    self.assistant._notify()
            except Exception:
                pass

        def do_cancel():
            if not email:
                return
            n = self._cancel_active_followups_for_email(email, "Cancelled from Assistant log", user_dismissed=True)
            if item and item.get("outlook_appt_entry_id"):
                try:
                    self.cancel_outlook_reminder_for_item(item)
                except Exception:
                    pass
            try:
                self.sort_emails_for_display(); self.render_email_rows(); self.render_group_rows(); self.render_followup_preview_queue()
            except Exception:
                pass
            try:
                if rec.get("id") and hasattr(self.assistant, "mark_undone"):
                    self.assistant.mark_undone(rec.get("id"))
            except Exception:
                pass
            _refresh_log()
            try:
                messagebox.showinfo("Follow-Up Cancelled", f"Cancelled {n} active follow-up/tracking item(s) for this email.", parent=parent)
            except Exception:
                pass
            dlg.destroy()

        def do_change_date():
            dlg.destroy()
            try:
                if self.goto_email_in_app(entry_id):
                    self.open_followup_window()
                else:
                    messagebox.showinfo("Change Date", "Could not select this email in the list to reschedule.", parent=parent)
            except Exception:
                pass

        def do_set_reminder():
            if not item:
                try:
                    messagebox.showinfo("Set Reminder", "No active follow-up to attach a reminder to. Set a follow-up first via Change Date/Time.", parent=dlg)
                except Exception:
                    pass
                return
            ok = False
            try:
                ok = bool(self.create_or_update_outlook_commitment_reminder(item))
                if ok:
                    try:
                        self.save_followups()
                    except Exception:
                        pass
            except Exception:
                ok = False
            _set_status()
            try:
                messagebox.showinfo("Outlook Reminder",
                                    "Outlook reminder set for this follow-up." if ok else
                                    "Could not set the Outlook reminder. Make sure Outlook is open and the follow-up has a due time.",
                                    parent=dlg)
            except Exception:
                pass

        def do_cancel_reminder():
            if not (item and item.get("outlook_appt_entry_id")):
                try:
                    messagebox.showinfo("Cancel Reminder", "There's no Outlook reminder attached to this follow-up.", parent=dlg)
                except Exception:
                    pass
                return
            ok = self.cancel_outlook_reminder_for_item(item)
            _set_status()
            try:
                messagebox.showinfo("Outlook Reminder", "Outlook reminder cancelled." if ok else "Could not cancel the Outlook reminder.", parent=dlg)
            except Exception:
                pass

        bf = tk.Frame(dlg, bg=_BG); bf.pack(fill="x", padx=12, pady=8)
        tk.Button(bf, text="Cancel Follow-up", command=do_cancel, width=20).grid(row=0, column=0, padx=4, pady=4, sticky="w")
        tk.Button(bf, text="Change Date/Time", command=do_change_date, width=20).grid(row=0, column=1, padx=4, pady=4, sticky="w")
        tk.Button(bf, text="Set Outlook Reminder", command=do_set_reminder, width=20).grid(row=1, column=0, padx=4, pady=4, sticky="w")
        tk.Button(bf, text="Cancel Outlook Reminder", command=do_cancel_reminder, width=20).grid(row=1, column=1, padx=4, pady=4, sticky="w")
        tk.Label(dlg, textvariable=status_var, bg=_BG, fg=_FG_DIM, wraplength=420, justify="left").pack(anchor="w", padx=12, pady=(8, 4))
        tk.Button(dlg, text="Close", command=dlg.destroy, width=12).pack(anchor="e", padx=12, pady=(4, 12))

    def cancel_outlook_reminder_for_item(self, item):
        """Delete the Outlook calendar reminder previously created for a follow-up
        item (by stored EntryID) and clear the reference. Guarded + thread-safe."""
        if not isinstance(item, dict):
            return False
        appt_id = item.get("outlook_appt_entry_id", "")
        if not appt_id:
            return False
        did_init = outlook_thread_init()
        ok = False
        try:
            outlook, namespace = self.fresh_outlook()
            if outlook and namespace:
                try:
                    appt = namespace.GetItemFromID(appt_id)
                    if appt is not None:
                        appt.Delete()
                        ok = True
                except Exception:
                    ok = False
        finally:
            try:
                outlook_thread_uninit(did_init)
            except Exception:
                pass
        item["outlook_appt_entry_id"] = ""
        for saver in ("save_followups", "save_scenario_reminders", "save_commitment_reminders"):
            fn = getattr(self, saver, None)
            if callable(fn):
                try:
                    fn()
                except Exception:
                    pass
        try:
            self.log(f"Outlook reminder cancelled for follow-up: {(item.get('subject','') or '')[:60]}")
        except Exception:
            pass
        return ok

    def make_safe_email_snapshot(self, email):
        safe = dict(email or {})
        safe.pop("message", None)
        return safe

    def save_undo_state(self, label="last action"):
        """Store a small local snapshot so Ctrl+Z can undo the last user action."""
        try:
            snapshot = {
                "label": label,
                "saved_at": datetime.now().isoformat(),
                "emails": [self.make_safe_email_snapshot(e) for e in self.emails],
                "status_data": self.status_data,
                "followups": self.followups,
                "scenario_reminders": self.scenario_reminders,
                "commitment_reminders": getattr(self, "commitment_reminders", []),
                "pending_reply_checks": self.pending_reply_checks,
                "sent_waiting_placeholders": self.sent_waiting_placeholders,
                "sent_waiting_processed_sent_ids": getattr(self, "sent_waiting_processed_sent_ids", []),
                "commitment_processed_message_ids": getattr(self, "commitment_processed_message_ids", []),
                "groups_data": self.groups_data,
                "learning_data": self.learning_data,
                "triage_history": self.triage_history,
                "deleted_history": self.deleted_history,
                "active_filter": self.active_filter,
                "active_group_filter": self.active_group_filter,
            }
            snapshot = json.loads(json.dumps(snapshot, default=str))
            self.undo_stack.append(snapshot)
            if len(self.undo_stack) > getattr(self, "undo_limit", 10):
                self.undo_stack = self.undo_stack[-self.undo_limit:]
        except Exception:
            pass

    def undo_last_action(self, event=None):
        if not getattr(self, "undo_stack", None):
            try:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, "Nothing to undo.")
            except Exception:
                pass
            return "break"
        snap = self.undo_stack.pop()
        try:
            _t0 = time.perf_counter()
            self.emails = snap.get("emails", [])
            for email in self.emails:
                email["message"] = None
                email["followup_time"] = self.get_followup_display_for_email(email.get("entry_id", ""))
            self._rebuild_email_index()  # keep O(1) index consistent after undo.
            self.status_data = snap.get("status_data", {})
            self.followups = snap.get("followups", [])
            self.scenario_reminders = snap.get("scenario_reminders", [])
            self.commitment_reminders = snap.get("commitment_reminders", getattr(self, "commitment_reminders", []))
            self.pending_reply_checks = snap.get("pending_reply_checks", [])
            # v3 efficiency: restored snapshot data must be re-deduped on the next save.
            self._followup_dedup_needed = True
            self.sent_waiting_placeholders = snap.get("sent_waiting_placeholders", [])
            self.sent_waiting_processed_sent_ids = snap.get("sent_waiting_processed_sent_ids", getattr(self, "sent_waiting_processed_sent_ids", []))
            self.commitment_processed_message_ids = snap.get("commitment_processed_message_ids", getattr(self, "commitment_processed_message_ids", []))
            self.groups_data = snap.get("groups_data", {"groups": [], "memberships": {}})
            self.learning_data = snap.get("learning_data", {"senders": {}, "domains": {}, "subjects": {}, "followups": {}, "group_rules": {}})
            self.triage_history = snap.get("triage_history", [])
            self.deleted_history = snap.get("deleted_history", [])
            self.active_filter = snap.get("active_filter", self.active_filter)
            self.active_group_filter = snap.get("active_group_filter", self.active_group_filter)

            # v4.1.16: undo restored a whole status_data snapshot -- reconcile the
            # machine-local closed ledger with it (in BOTH directions) so the guard
            # cannot silently re-apply an undone close/delete at the next startup,
            # and so an undone reopen re-closes durably.
            self._reconcile_closed_email_guard_after_undo()

            # v4.2.35 Ctrl+Z freeze fix: render FIRST, persist AFTERWARDS in
            # staggered event-loop ticks. The old order ran eleven save helpers
            # inline before repainting; mainbox_status.json (16MB) and the
            # closed-email guard (32MB) serialize on the calling thread even on
            # their async paths, and nine more files save fully sync with SQLite
            # mirrors -- the ops log caught each press costing multiple seconds
            # of UI freeze (guard+status slow_save pairs at every Ctrl+Z). The
            # helpers themselves are untouched; only WHEN they run changed.
            _t1 = time.perf_counter()
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, f"Undid: {snap.get('label', 'last action')}")
            _t2 = time.perf_counter()
            self._schedule_undo_persistence()
            try:
                ops_log("ui", "undo_applied", label=str(snap.get("label", ""))[:80],
                        restore_ms=int((_t1 - _t0) * 1000), render_ms=int((_t2 - _t1) * 1000))
            except Exception:
                pass
        except Exception as exc:
            try:
                messagebox.showerror("Undo Failed", f"Could not undo the last action.\n\n{exc}")
            except Exception:
                pass
        return "break"

    def _schedule_undo_persistence(self):
        """v4.2.35: run undo's eleven save helpers one per 60ms event-loop tick
        so input events process between them (no multi-second UI lock). The
        helpers persist CURRENT in-memory state, so a second Ctrl+Z mid-chain
        just replaces the pending list -- one pass over the latest state is
        always sufficient, and every mutation path still triggers its own save
        exactly as before. Crash exposure is unchanged in kind (the old inline
        sequence could also die between files); on_close still saves everything."""
        self._undo_save_steps = [
            ("flush_status_data", self.flush_status_data),
            ("save_followups", self.save_followups),
            ("save_scenario_reminders", self.save_scenario_reminders),
            ("save_commitment_reminders", self.save_commitment_reminders),
            ("save_pending_reply_checks", self.save_pending_reply_checks),
            ("save_sent_waiting_placeholders", self.save_sent_waiting_placeholders),
            ("save_groups", self.save_groups),
            ("save_learning_rules", self.save_learning_rules),
            ("save_triage_history", self.save_triage_history),
            ("save_deleted_history", self.save_deleted_history),
            ("save_cached_state", self.save_cached_state),
        ]
        if getattr(self, "_undo_save_pump_armed", False):
            return
        self._undo_save_pump_armed = True

        def _pump():
            steps = getattr(self, "_undo_save_steps", None)
            if not steps:
                self._undo_save_pump_armed = False
                try:
                    ops_log("ui", "undo_saves_done")
                except Exception:
                    pass
                return
            name, fn = steps.pop(0)
            _t0 = time.perf_counter()
            try:
                fn()
            except Exception as exc:
                try:
                    ops_log("ui", "undo_save_step_failed", step=name, err=str(exc)[:200])
                except Exception:
                    pass
            _ms = int((time.perf_counter() - _t0) * 1000)
            if _ms >= 100:
                try:
                    ops_log("perf", "undo_save_step", step=name, ms=_ms)
                except Exception:
                    pass
            try:
                self.root.after(60, _pump)
            except Exception:
                self._undo_save_pump_armed = False

        try:
            self.root.after(60, _pump)
        except Exception:
            # No event loop (shutdown race): fall back to the old inline behavior.
            self._undo_save_pump_armed = False
            for _name, _fn in list(getattr(self, "_undo_save_steps", []) or []):
                try:
                    _fn()
                except Exception:
                    pass
            self._undo_save_steps = []

    def refresh_hotkey(self, event=None):
