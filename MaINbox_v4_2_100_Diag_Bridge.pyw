def should_allow_followup_decision(email, triage_result=None, quick_result=None):
    """Final safety gate so spam/general/FYI emails do not get automatic follow-ups."""
    triage_result = triage_result or {}
    quick_result = quick_result or {}
    category = (email or {}).get("category") or triage_result.get("workflow_category") or quick_result.get("workflow_category") or "General"
    if category in NO_FOLLOWUP_CATEGORIES or category not in FOLLOWUP_ALLOWED_CATEGORIES:
        return False, f"Blocked follow-up: category {category} is not eligible."
    try:
        business_relevance = float(triage_result.get("business_relevance", quick_result.get("business_relevance", 0.0)) or 0.0)
    except Exception:
        business_relevance = 0.0
    try:
        spam_likelihood = float(triage_result.get("spam_likelihood", quick_result.get("spam_likelihood", 1.0)) or 1.0)
    except Exception:
        spam_likelihood = 1.0
    wants_followup = bool(triage_result.get("needs_followup", quick_result.get("needs_followup", False)))
    if not wants_followup:
        return False, "Blocked follow-up: triage did not mark it follow-up-worthy."
    if business_relevance < MIN_BUSINESS_RELEVANCE_FOR_FOLLOWUP:
        return False, f"Blocked follow-up: business relevance {business_relevance:.2f} is too low."
    if spam_likelihood > MAX_SPAM_LIKELIHOOD_FOR_FOLLOWUP:
        return False, f"Blocked follow-up: spam likelihood {spam_likelihood:.2f} is too high."
    return True, "Follow-up allowed by business relevance gate."



MAINBOX_LOCAL_DEVICE_ID_FILE = data_path("mainbox_local_device_id.txt")


def get_machine_fingerprint():
    """v4.1.2: a stable identifier of THIS Windows install. Primary source is the
    registry MachineGuid (HKLM\\SOFTWARE\\Microsoft\\Cryptography), which is minted
    once per Windows installation and never travels in any MaINbox backup. Falls
    back to MAC + hostname when the registry is unavailable."""
    try:
        import winreg
        with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Microsoft\Cryptography",
                            0, winreg.KEY_READ | getattr(winreg, "KEY_WOW64_64KEY", 0)) as k:
            val, _ = winreg.QueryValueEx(k, "MachineGuid")
            val = str(val or "").strip()
            if val:
                return "machineguid::" + val.lower()
    except Exception:
        pass
    try:
        import socket
        return f"nodemac::{uuid.getnode():012x}::{(socket.gethostname() or '').strip().lower()}"
    except Exception:
        return f"nodemac::{uuid.getnode():012x}"


def get_mainbox_device_id():
    """Stable, MACHINE-DERIVED device id for the MaINbox Cloud Bridge.

    v4.1.2 CRITICAL FIX: the id is now computed FROM the machine fingerprint
    (uuid5 of the Windows MachineGuid), so two PCs mathematically cannot share
    one -- no matter what a restore carried over and with no manual cleanup.
    History: the id originally lived in mainbox_data.db, which restores copy
    between PCs (both PCs became one cloud device and auto-sync never prompted);
    v4.1.1 moved it to a local file but its migration ADOPTED the legacy db_meta
    value on first run -- re-importing the contaminated id from the restored DB.
    Now nothing is ever adopted: the id is a pure function of this machine. The
    local file is kept as a readable record and for the rare non-Windows/registry
    fallback; a file whose fingerprint doesn't match this machine (copied
    AppData) is ignored and rewritten."""
    fingerprint = get_machine_fingerprint()
    derived = str(uuid.uuid5(uuid.NAMESPACE_DNS, "mainbox-cloud-device::" + fingerprint))
    try:
        rec = {}
        if os.path.exists(MAINBOX_LOCAL_DEVICE_ID_FILE):
            with open(MAINBOX_LOCAL_DEVICE_ID_FILE, "r", encoding="utf-8") as f:
                raw = f.read().strip()
            try:
                rec = json.loads(raw)
                if not isinstance(rec, dict):
                    rec = {}
            except Exception:
                rec = {}
        if rec.get("device_id") == derived and rec.get("fingerprint") == fingerprint:
            return derived
        import socket as _socket
        with open(MAINBOX_LOCAL_DEVICE_ID_FILE, "w", encoding="utf-8") as f:
            json.dump({
                "device_id": derived,
                "fingerprint": fingerprint,
                "hostname": (_socket.gethostname() or ""),
                "created_at": datetime.now().isoformat(),
                "note": "Machine-derived; safe to delete (re-mints identically on this PC).",
            }, f, indent=2)
    except Exception:
        pass
    return derived


def reconcile_device_identity_after_restore():
    """v4.1.1: a restore overwrites db_meta's cloud_device_id with the SOURCE PC's id.
    Re-assert this machine's own local id into the freshly restored DB so uploads and
    the "is this another PC's backup?" check keep using THIS PC's identity. The local
    id file is never restored, so it remains the correct machine identity; this only
    repairs the DB mirror. Also rewrites the bridge config's device_id to match."""
    local_id = get_mainbox_device_id()
    try:
        init_mainbox_db()
        with sqlite3.connect(MAINBOX_DB_FILE) as conn:
            conn.execute(
                "INSERT OR REPLACE INTO db_meta(meta_key, meta_value, updated_at) VALUES (?, ?, ?)",
                ("cloud_device_id", local_id, datetime.now().isoformat()),
            )
            conn.commit()
    except Exception:
        pass
    try:
        cfg = load_cloud_bridge_config()
        if isinstance(cfg, dict) and str(cfg.get("device_id") or "") != local_id:
            save_cloud_bridge_config_updates(device_id=local_id)
    except Exception:
        pass
    return local_id


def default_cloud_bridge_config():
    """Default local-first config consumed by mainbox_cloud_bridge.py.

    Phase 2 keeps MaINbox local-first, uploads timestamped backups, and also
    publishes a read-only latest JSON mirror for future dashboards/cloud viewers.
    Blank credentials intentionally disable cloud upload.
    """
    return {
        "enabled": False,
        "phase": "phase_2_5_backup_mirror_restore",
        "app_name": APP_NAME,
        "app_version": APP_VERSION,
        "device_id": get_mainbox_device_id(),
        "app_data_dir": APP_DATA_DIR,
        "main_db_file": MAINBOX_DB_FILE,
        "snapshot_dir": MAINBOX_CLOUD_SNAPSHOT_DIR,
        "restore_dir": MAINBOX_CLOUD_RESTORE_DIR,
        "request_file": MAINBOX_CLOUD_REQUEST_FILE,
        "status_file": MAINBOX_CLOUD_STATUS_FILE,
        "bridge_script_path": "",
        "bridge_python_executable": sys.executable or "python",
        "auto_run_bridge_on_request": True,
        "supabase_url": "",
        "supabase_service_role_key": "",
        "supabase_bucket": "mainbox-backups",
        "cloud_prefix": "mainbox",
        "auto_backup_minutes": 30,
        "retention_local_snapshots": 12,
        "include_json_exports": True,
        "create_bucket_if_missing": True,
        "upload_latest_json_mirror": True,
        "latest_mirror_prefix": "latest",
        "allow_cloud_restore": True,
        "notes": "Fill in supabase_url and supabase_service_role_key in this file, then run mainbox_cloud_bridge_v4_3.py. Phase 2.5 uploads timestamped backups plus a read-only latest JSON mirror and can safely download/restore the latest cloud backup on request."
    }


def ensure_cloud_bridge_config():
    """Create the optional cloud bridge config once, without changing existing settings."""
    try:
        os.makedirs(APP_DATA_DIR, exist_ok=True)
        os.makedirs(MAINBOX_CLOUD_SNAPSHOT_DIR, exist_ok=True)
        os.makedirs(MAINBOX_CLOUD_RESTORE_DIR, exist_ok=True)
        if not os.path.exists(MAINBOX_CLOUD_CONFIG_FILE):
            with open(MAINBOX_CLOUD_CONFIG_FILE, "w", encoding="utf-8") as f:
                json.dump(default_cloud_bridge_config(), f, indent=2, default=str)
        else:
            # Preserve user credentials/settings; only backfill newly added safe keys.
            with open(MAINBOX_CLOUD_CONFIG_FILE, "r", encoding="utf-8") as f:
                cfg = json.load(f)
            if not isinstance(cfg, dict):
                cfg = {}
            defaults = default_cloud_bridge_config()
            changed = False
            for key, value in defaults.items():
                if key not in cfg:
                    cfg[key] = value
                    changed = True
            # Always refresh local paths/version in case AppData path or version changed.
            for key, value in {
                "app_version": APP_VERSION,
                "phase": "phase_2_5_backup_mirror_restore",
                "upload_latest_json_mirror": True,
                "allow_cloud_restore": True,
                "app_data_dir": APP_DATA_DIR,
                "main_db_file": MAINBOX_DB_FILE,
                "snapshot_dir": MAINBOX_CLOUD_SNAPSHOT_DIR,
                "restore_dir": MAINBOX_CLOUD_RESTORE_DIR,
                "request_file": MAINBOX_CLOUD_REQUEST_FILE,
                "status_file": MAINBOX_CLOUD_STATUS_FILE,
                "bridge_python_executable": cfg.get("bridge_python_executable") or (sys.executable or "python"),
            }.items():
                if cfg.get(key) != value:
                    cfg[key] = value
                    changed = True
            if changed:
                with open(MAINBOX_CLOUD_CONFIG_FILE, "w", encoding="utf-8") as f:
                    json.dump(cfg, f, indent=2, default=str)
        return MAINBOX_CLOUD_CONFIG_FILE
    except Exception:
        traceback.print_exc()
        return MAINBOX_CLOUD_CONFIG_FILE


def request_cloud_bridge_backup(reason="manual"):
    """Ask the separate bridge process for a non-blocking Phase 2 backup/mirror run."""
    try:
        # v4.1.58: the bridge backs up the SQLite DB and JSON files -- make sure any
        # queued background writes (cache/status) are on disk before the bridge reads.
        try:
            flush_pending_async_saves(timeout_seconds=10.0)
        except Exception:
            pass
        ensure_cloud_bridge_config()
        request = {
            "request_id": str(uuid.uuid4()),
            "requested_at": datetime.now().isoformat(),
            "reason": reason,
            "app_version": APP_VERSION,
            "device_id": get_mainbox_device_id(),
            "main_db_file": MAINBOX_DB_FILE,
        }
        with open(MAINBOX_CLOUD_REQUEST_FILE, "w", encoding="utf-8") as f:
            json.dump(request, f, indent=2, default=str)
        return request
    except Exception:
        traceback.print_exc()
        return None


def read_cloud_bridge_status():
    try:
        if os.path.exists(MAINBOX_CLOUD_STATUS_FILE):
            with open(MAINBOX_CLOUD_STATUS_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
    except Exception:
        pass
    return {}


def load_cloud_bridge_config():
    try:
        ensure_cloud_bridge_config()
        if os.path.exists(MAINBOX_CLOUD_CONFIG_FILE):
            with open(MAINBOX_CLOUD_CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
    except Exception:
        pass
    return default_cloud_bridge_config()


def save_cloud_bridge_config_updates(**updates):
    try:
        cfg = load_cloud_bridge_config()
        cfg.update(updates)
        with open(MAINBOX_CLOUD_CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2, default=str)
        return cfg
    except Exception:
        traceback.print_exc()
        return None


def _looks_like_python_exe(p):
    """v3.8.33: True if a path looks like a Python interpreter rather than, say, the
    frozen MaINbox executable."""
    try:
        base = os.path.basename(str(p)).lower()
    except Exception:
        return False
    return base in (
        "python", "python.exe", "pythonw", "pythonw.exe",
        "python3", "python3.exe", "py", "py.exe",
    ) or base.startswith("python")


def _resolve_bridge_python(cfg):
    """v3.8.33: pick a Python interpreter to run the bridge .py with.

    When MaINbox runs as a .pyw/.py, sys.executable is python(w).exe and is correct, so
    this returns it unchanged (no behavior change for the normal case). When MaINbox is
    packaged into a frozen .exe (PyInstaller/cx_Freeze), sys.executable points at the
    MaINbox executable, which cannot run the bridge script. In that case we ignore the
    non-Python value, then look for a python/py launcher on PATH. We never return a
    configured value that is clearly not Python (e.g. the frozen app exe).
    """
    cand = str(cfg.get("bridge_python_executable") or "").strip().strip('"')
    if cand and _looks_like_python_exe(cand):
        return cand
    # Not frozen: sys.executable IS the Python interpreter currently running MaINbox, so
    # trust it regardless of its name. (This is the normal .pyw case and is unchanged.)
    if not getattr(sys, "frozen", False) and sys.executable:
        return sys.executable
    # Frozen .exe: sys.executable is the MaINbox app, not Python -> find a python/py on PATH.
    for name in ("py", "python", "python3", "pythonw"):
        try:
            found = shutil.which(name)
        except Exception:
            found = None
        if found:
            return found
    return "python"


def launch_cloud_bridge_command(extra_args=None):
    """Launch the optional cloud bridge command without blocking MaINbox."""
    try:
        cfg = load_cloud_bridge_config()
        bridge_path = str(cfg.get("bridge_script_path") or "").strip().strip('"')
        if not bridge_path:
            return False, "No bridge file is selected yet."
        if not os.path.exists(bridge_path):
            return False, f"Bridge file not found:\n{bridge_path}"
        # v3.8.33: resolve a real Python interpreter. sys.executable is correct when
        # running the .pyw through Python, but is the MaINbox exe in a frozen build.
        python_exe = _resolve_bridge_python(cfg)
        cmd = [python_exe, bridge_path]
        cmd.extend(list(extra_args or []))
        cmd.extend(["--config", MAINBOX_CLOUD_CONFIG_FILE])
        startupinfo = None
        creationflags = 0
        if os.name == "nt":
            creationflags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
            try:
                startupinfo = subprocess.STARTUPINFO()
                startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW
            except Exception:
                startupinfo = None
        subprocess.Popen(
            cmd,
            cwd=os.path.dirname(bridge_path) or None,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            startupinfo=startupinfo,
            creationflags=creationflags,
        )
        return True, "Cloud bridge command launched."
    except Exception as exc:
        traceback.print_exc()
        return False, str(exc)


def launch_cloud_bridge_once():
    """Launch the optional cloud bridge one-shot backup without blocking MaINbox."""
    launched, msg = launch_cloud_bridge_command(["--once"])
    if launched:
        return True, "Cloud bridge launched for one backup run."
    return launched, msg


def launch_cloud_bridge_download_latest():
    """Download the latest cloud backup into the local restore folder without changing MaINbox data."""
    launched, msg = launch_cloud_bridge_command(["--download-latest"])
    if launched:
        return True, "Cloud bridge launched to download the latest cloud backup."
    return launched, msg


def launch_cloud_bridge_restore_latest():
    """Launch a delayed restore with the bridge restore popup.

    MaINbox saves the current app path into the bridge config, launches the bridge,
    then closes so the bridge can safely replace mainbox_data.db. The bridge shows
    restore progress and offers to relaunch MaINbox when finished.
    """
    try:
        try:
            mainbox_app_path = os.path.abspath(sys.argv[0]) if sys.argv and sys.argv[0] else ""
        except Exception:
            mainbox_app_path = ""
        save_cloud_bridge_config_updates(mainbox_app_path=mainbox_app_path)
    except Exception:
        pass
    launched, msg = launch_cloud_bridge_command(["--restore-latest", "--restore-ui", "--delay", "12"])
    if launched:
        # v3.9.106: ask the next launch (this PC or, via a restored AppData, the
        # destination PC) to update Outlook FIRST so restored records line up
        # with a synced mailbox.
        request_post_restore_outlook_sync("cloud restore launched from MaINbox")
        return True, "Cloud bridge launched to restore the latest cloud backup after MaINbox closes."
    return launched, msg


def open_cloud_restore_folder():
    try:
        os.makedirs(MAINBOX_CLOUD_RESTORE_DIR, exist_ok=True)
        if os.name == "nt":
            os.startfile(MAINBOX_CLOUD_RESTORE_DIR)
        elif sys.platform == "darwin":
            subprocess.Popen(["open", MAINBOX_CLOUD_RESTORE_DIR])
        else:
            subprocess.Popen(["xdg-open", MAINBOX_CLOUD_RESTORE_DIR])
        return True, MAINBOX_CLOUD_RESTORE_DIR
    except Exception as exc:
        traceback.print_exc()
        return False, str(exc)

def format_cloud_bridge_status_text(status):
    if not status:
        return "No bridge status has been written yet."
    lines = [
        f"Status: {status.get('status', 'unknown')}",
        f"Message: {status.get('message', '')}",
        f"Last run: {status.get('last_run_at', '')}",
        f"Last local snapshot: {status.get('last_snapshot_zip', '')}",
        f"Last Supabase upload: {status.get('last_upload_path', '')}",
        f"Latest mirror manifest: {status.get('last_mirror_manifest_path', '')}",
        f"Mirror app_state count: {status.get('mirror_app_state_count', '')}",
        f"Last downloaded cloud backup: {status.get('last_downloaded_backup_zip', '')}",
        f"Last restore safety backup: {status.get('last_restore_safety_backup', '')}",
        f"Last restored from: {status.get('last_restored_from_zip', '')}",
    ]
    if status.get("error"):
        lines.extend(["", "Error:", str(status.get("error"))[:2000]])
    return "\n".join(lines)


# v3 efficiency: the full DB setup (table creation + version stamping) only needs to
# run once per process. Previously init_mainbox_db() ran on EVERY load_json_from_db /
# save_json_to_db call, which re-stamped db_meta on every access and turned even reads
# into writes. The guard below makes repeat calls cheap no-ops, while still re-running
# automatically if the first attempt failed (the flag is only set on success).
_DB_INITIALIZED = False


def init_mainbox_db(force=False):
    """Create the local SQLite database used for durable business records.

    Heavy setup runs once per process; later calls are cheap no-ops. Pass force=True
    to re-run the setup on demand (e.g. after the database file has been replaced).
    """
    global _DB_INITIALIZED
    if _DB_INITIALIZED and not force:
        return
    try:
        os.makedirs(os.path.dirname(MAINBOX_DB_FILE), exist_ok=True)
        with sqlite3.connect(MAINBOX_DB_FILE) as conn:
            conn.execute("PRAGMA journal_mode=WAL")
            conn.execute("PRAGMA synchronous=NORMAL")
            # Wait (rather than immediately failing) if another thread/process holds a
            # write lock; helps concurrent saves and the optional cloud bridge process.
            conn.execute("PRAGMA busy_timeout=5000")
            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS app_state (
                    state_key TEXT PRIMARY KEY,
                    json_value TEXT NOT NULL,
                    updated_at TEXT NOT NULL
                )
                """
            )
            conn.execute(
                """
                CREATE TABLE IF NOT EXISTS db_meta (
                    meta_key TEXT PRIMARY KEY,
                    meta_value TEXT NOT NULL,
                    updated_at TEXT NOT NULL
                )
                """
            )
            conn.execute(
                "INSERT OR REPLACE INTO db_meta(meta_key, meta_value, updated_at) VALUES (?, ?, ?)",
                ("schema_version", "3", datetime.now().isoformat()),
            )
            conn.execute(
                "INSERT OR REPLACE INTO db_meta(meta_key, meta_value, updated_at) VALUES (?, ?, ?)",
                ("app_version", APP_VERSION, datetime.now().isoformat()),
            )
            conn.commit()
        _DB_INITIALIZED = True
    except Exception:
        traceback.print_exc()


def load_json_from_db(state_key, fallback=None):
    try:
        init_mainbox_db()
        with sqlite3.connect(MAINBOX_DB_FILE) as conn:
            row = conn.execute(
                "SELECT json_value FROM app_state WHERE state_key=?",
                (state_key,),
            ).fetchone()
        if not row:
            return fallback
        return json.loads(row[0])
    except Exception:
        return fallback


def save_json_to_db(state_key, data, payload_str=None):
    """v4.1.22 (external audit round 4, finding #12): the DB mirror write now REPORTS its
    outcome instead of silently swallowing failures -- a locked database could previously
    make restore_db_from_json_files() report success while nothing was written. Returns
    True on success, False on failure; transient 'locked'/'busy' errors get one retry.

    v4.1.58: optional payload_str lets the async persistence writer reuse the JSON string
    it already serialized on the caller thread (identical bytes, no double serialize)."""
    payload = payload_str
    for _attempt in (1, 2):
        try:
            init_mainbox_db()
            if payload is None:
                payload = json.dumps(data, indent=2, default=str)
            with sqlite3.connect(MAINBOX_DB_FILE, timeout=5.0) as conn:
                conn.execute(
                    """
                    INSERT OR REPLACE INTO app_state(state_key, json_value, updated_at)
                    VALUES (?, ?, ?)
                    """,
                    (state_key, payload, datetime.now().isoformat()),
                )
                conn.commit()
            return True
        except sqlite3.OperationalError as exc:
            if _attempt == 1 and re.search(r"locked|busy", str(exc), flags=re.I):
                try:
                    time.sleep(0.25)
                except Exception:
                    pass
                continue
            traceback.print_exc()
            _log_db_mirror_failure(state_key, exc)
            return False
        except Exception as exc:
            traceback.print_exc()
            _log_db_mirror_failure(state_key, exc)
            return False
    return False


def _log_db_mirror_failure(state_key, exc):
    """v4.1.22: durable, bounded record of DB-mirror failures (a .pyw has no console, so
    the traceback alone is invisible). The startup JSON<->DB self-heal reconciles the
    actual data; this log makes the failure OBSERVABLE."""
    try:
        path = data_path("mainbox_db_mirror_failures.log")
        try:
            if os.path.exists(path) and os.path.getsize(path) > 512 * 1024:
                os.remove(path)
        except Exception:
            pass
        with open(path, "a", encoding="utf-8") as f:
            f.write(f"{datetime.now().isoformat()}  state_key={state_key!r}  {type(exc).__name__}: {exc}\n")
    except Exception:
        pass

def _db_state_updated_at(state_key):
    """v3.8.32: POSIX timestamp of a specific app_state row's updated_at, or None if
    there is no such row yet. Used for per-row JSON<->DB freshness so one unrelated DB
    write cannot make every JSON file look stale.
    """
    try:
        with sqlite3.connect(MAINBOX_DB_FILE) as conn:
            row = conn.execute(
                "SELECT updated_at FROM app_state WHERE state_key=?", (state_key,)
            ).fetchone()
        if row and row[0]:
            return datetime.fromisoformat(row[0]).timestamp()
    except Exception:
        pass
    return None


def _json_file_is_newer_than_db(path):
    """v3.8.32: True if the on-disk JSON file was modified more recently than its own
    app_state row's updated_at in the SQLite mirror.

    The app treats the DB as the authoritative runtime source and mirrors JSON<->DB.
    Earlier this compared the JSON file against the WHOLE mainbox_data.db file mtime,
    which meant one unrelated DB write could make a specific JSON file look stale, and a
    manual single-file restore could be clobbered after some other key was saved. This
    now compares per row, so each synced file is judged against only its own DB copy.

    Cloud-bridge restores stay correct because the bridge re-stamps every restored
    app_state row's updated_at to "now" after replacing the database
    (stamp_restored_db_freshness), so restored rows are unambiguously the newest copy and
    a stale local JSON cannot undo a restore. A manual restore of one JSON file wins
    because that file's mtime is newer than its (unchanged) DB row. The small tolerance
    keeps normal saves DB-authoritative, since save_json() writes the JSON file and then
    the DB mirror a moment later (so the row's updated_at is >= the file mtime).
    """
    try:
        if not path or not os.path.exists(path):
            return False
        # v4.1.23 (finding #13): a pending-mirror mark means the last DB write for this
        # file FAILED -- the JSON is unconditionally the newest truth, regardless of the
        # timestamp tolerance below.
        if _db_mirror_pending_has(path):
            return True
        db_key = DB_SYNC_FILES.get(path)
        if not db_key:
            return False  # not a DB-synced file; nothing to compare against
        row_ts = _db_state_updated_at(db_key)
        if row_ts is None:
            return True  # no DB row yet -> the JSON file is the only source
        return os.path.getmtime(path) > (row_ts + 2.0)
    except Exception:
        return False


def load_json(path, fallback):
    # v2.10: for durable business records, prefer the SQLite DB copy when present.
    db_key = DB_SYNC_FILES.get(path)
    if db_key:
        # v3.8.30: honor a JSON file that is genuinely newer than the DB mirror (e.g. a
        # manual restore or hand-edit). Without this the DB copy always won and the next
        # save_json() rewrote the newer file with stale DB data. Cloud-bridge restores
        # replace mainbox_data.db itself, so the DB stays authoritative for those.
        if _json_file_is_newer_than_db(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                # v4.1.24 (round 6, blocker #9): a CONFIRMED successful absorption clears
                # the pending-mirror marker -- otherwise the file stayed JSON-authoritative
                # forever and a later-corrupted JSON could override a healthy DB.
                if save_json_to_db(db_key, data):
                    _db_mirror_pending_update(path, False)
                return data
            except Exception:
                pass  # fall back to the DB copy / fallback below
        db_value = load_json_from_db(db_key, None)
        if db_value is not None:
            return db_value

    # v33 stores user data in LOCALAPPDATA\MaINbox. If the new AppData file does not
    # exist yet, migrate the matching old same-folder JSON file when available.
    if not os.path.exists(path):
        legacy_name = LEGACY_DATA_FILES.get(path)
        if legacy_name:
            legacy_path = os.path.join(os.getcwd(), legacy_name)
            if os.path.exists(legacy_path):
                try:
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    with open(legacy_path, "r", encoding="utf-8") as f:
                        migrated = json.load(f)
                    save_json(path, migrated)
                    return migrated
                except Exception:
                    pass
        if db_key and path in DB_SYNC_REQUIRED_DEFAULTS:
            return _ensure_required_sync_file(path, fallback)
        return fallback
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        if db_key:
            save_json_to_db(db_key, data)
        return data
    except Exception:
        return fallback


# v4.1.23 (external audit round 5, finding #13): durable PENDING-MIRROR ledger. When a
# JSON save succeeds but its SQLite mirror write fails, the JSON is the newest truth --
# without this marker, the startup DB->JSON reconciliation (inside the 2-second
# freshness tolerance) overwrote the newer JSON with stale DB state: a confirmed
# data-loss path. A pending-marked file is treated as JSON-authoritative everywhere
# until a mirror write for it succeeds.
DB_MIRROR_PENDING_FILE = data_path("mainbox_db_mirror_pending.json")


def _db_mirror_pending_load():
    try:
        if os.path.exists(DB_MIRROR_PENDING_FILE):
            with open(DB_MIRROR_PENDING_FILE, "r", encoding="utf-8") as f:
                d = json.load(f)
            return d if isinstance(d, dict) else {}
    except Exception:
        pass
    return {}


def _db_mirror_pending_key(path):
    """v4.1.25 (external audit round 7, blocker #4): PORTABLE pending identity -- the
    state key (e.g. 'email_statuses'), never an absolute source-PC path. A snapshot
    created on another machine resolves to the same state on this one."""
    try:
        k = DB_SYNC_FILES.get(path)
        if k:
            return "state:" + str(k)
    except Exception:
        pass
    try:
        return "file:" + os.path.basename(str(path))
    except Exception:
        return str(path)


def _db_mirror_pending_has(path):
    try:
        d = _db_mirror_pending_load()
        return (_db_mirror_pending_key(path) in d) or (str(path) in d)  # legacy abs-path entries honored
    except Exception:
        return False


_DB_MIRROR_PENDING_LOCK = threading.Lock()  # v4.1.59 (audit finding #4): the ledger update is a read-modify-write now reached from BOTH the async persistence writer and main-thread sync saves; unlocked, a concurrent pair could drop a pending mark and weaken the v4.1.23 stale-DB-overwrite protection.


def _db_mirror_pending_update(path, pending):
    with _DB_MIRROR_PENDING_LOCK:
        return _db_mirror_pending_update_locked(path, pending)


def _db_mirror_pending_update_locked(path, pending):
    try:
        d = _db_mirror_pending_load()
        key = _db_mirror_pending_key(path)
        _legacy = str(path)
        if pending:
            d[key] = {"file": os.path.basename(str(path)), "at": datetime.now().isoformat()}
            d.pop(_legacy, None)
        elif key in d or _legacy in d:
            d.pop(key, None)
            d.pop(_legacy, None)
        else:
            return
        # v4.1.24 (round 6, blocker #9): ATOMIC write -- the pending ledger is itself a
        # durability record and must never be half-written by a crash.
        _tmp = None
        try:
            fd, _tmp = tempfile.mkstemp(prefix=".mainbox_pend_", suffix=".json",
                                        dir=os.path.dirname(DB_MIRROR_PENDING_FILE) or ".")
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(d, f, indent=2)
                f.flush()
                try:
                    os.fsync(f.fileno())
                except Exception:
                    pass
            os.replace(_tmp, DB_MIRROR_PENDING_FILE)
        finally:
            if _tmp and os.path.exists(_tmp):
                try:
                    os.remove(_tmp)
                except Exception:
                    pass
    except Exception:
        pass


def save_json(path, data):
    folder = os.path.dirname(path)
    if folder:
        os.makedirs(folder, exist_ok=True)

    # Write JSON atomically so cache/learning/follow-up files are not left
    # half-written if Windows, antivirus, or the app interrupts a save.
    tmp_path = None
    try:
        tmp_dir = folder or os.getcwd()
        fd, tmp_path = tempfile.mkstemp(prefix=".mainbox_tmp_", suffix=".json", dir=tmp_dir)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, default=str)
            f.flush()
            try:
                os.fsync(f.fileno())
            except Exception:
                pass
        os.replace(tmp_path, path)
    finally:
        if tmp_path and os.path.exists(tmp_path):
            try:
                os.remove(tmp_path)
            except Exception:
                pass

    # v2.10: mirror durable business records into the local SQLite DB.
    # v4.1.23 (finding #13): the mirror result is CHECKED. A failed mirror marks this
    # file pending-JSON-authoritative so startup reconciliation can never overwrite the
    # newer JSON with stale DB state; the next successful mirror clears the mark.
    db_key = DB_SYNC_FILES.get(path)
    if db_key:
        if save_json_to_db(db_key, data):
            _db_mirror_pending_update(path, False)
        else:
            _db_mirror_pending_update(path, True)


# =============================================================================
# v4.1.58 ASYNC PERSISTENCE WRITER -- keep the Tk MAIN thread off the disk.
#
# The 2026-07-20 crash log proved the recurring UI freezes were the main thread
# stuck in os.fsync / sqlite conn.commit: every save_cached_state (a full dump of
# EVERY email row INCLUDING cached bodies -- tens of MB) and flush_status_data
# (the full status record set, DB-mirrored) ran synchronously on the Tk thread
# after AutoPilot applies, refreshes, bulk edits, and deletes. On a OneDrive-
# synced path with antivirus each fsync'd atomic replace (+ SQLite commit) can
# take seconds -- felt as the whole computer "freezing up".
#
# Split chosen deliberately: the JSON string is serialized ON THE CALLER thread
# (a bounded, CPU-only cost of ~0.1-0.5s worst case for the big cache), so the
# written bytes are a perfectly consistent snapshot no matter how the live
# dicts mutate afterwards. Only the SLOW, UNBOUNDED parts -- tmp write, fsync,
# atomic replace, antivirus/OneDrive stalls, SQLite mirror commit -- move to a
# single daemon writer thread. Per-path LAST-WRITE-WINS coalescing means a
# burst of saves (an AutoPilot apply triggering cache+status+cache) costs ONE
# disk write per file. Single-writer discipline: after startup, CACHE_FILE and
# STATUS_FILE are written only through the two converted methods, so the writer
# thread is the only thing touching those files.
#
# Durability contract: flush_pending_async_saves() blocks until the queue AND
# the in-flight write are done; it runs at app close (before root.destroy) and
# before a cloud-bridge backup request, so nothing rides only in memory when it
# matters. A writer-thread failure falls back to the synchronous save_json.
# =============================================================================
_ASYNC_SAVE_LOCK = threading.Lock()
_ASYNC_SAVE_LATEST = {}          # path -> {"payload": str, "extra_db": [(state_key, payload_str)]}
_ASYNC_SAVE_WAKE = threading.Event()
_ASYNC_SAVE_THREAD = None
_ASYNC_SAVE_INFLIGHT = 0         # guarded by _ASYNC_SAVE_LOCK


def _async_save_write_one(path, job):
    """Writer-thread side: byte-identical to save_json's disk + mirror behavior,
    fed a pre-serialized payload."""
    try:
        folder = os.path.dirname(path)
        if folder:
            os.makedirs(folder, exist_ok=True)
        tmp_path = None
        try:
            tmp_dir = folder or os.getcwd()
            fd, tmp_path = tempfile.mkstemp(prefix=".mainbox_tmp_", suffix=".json", dir=tmp_dir)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(job.get("payload") or "")
                f.flush()
                try:
                    os.fsync(f.fileno())
                except Exception:
                    pass
            os.replace(tmp_path, path)
        finally:
            if tmp_path and os.path.exists(tmp_path):
                try:
                    os.remove(tmp_path)
                except Exception:
                    pass
        db_key = DB_SYNC_FILES.get(path)
        if db_key:
            if save_json_to_db(db_key, None, payload_str=job.get("payload")):
                _db_mirror_pending_update(path, False)
            else:
                _db_mirror_pending_update(path, True)
        for _state_key, _payload in (job.get("extra_db") or []):
            try:
                save_json_to_db(_state_key, None, payload_str=_payload)
            except Exception:
                pass
    except Exception:
        traceback.print_exc()


def _async_save_loop():
    global _ASYNC_SAVE_INFLIGHT
    while True:
        _ASYNC_SAVE_WAKE.wait(timeout=0.5)
        _ASYNC_SAVE_WAKE.clear()
        while True:
            with _ASYNC_SAVE_LOCK:
                if not _ASYNC_SAVE_LATEST:
                    break
                path = next(iter(_ASYNC_SAVE_LATEST))
                job = _ASYNC_SAVE_LATEST.pop(path)
                _ASYNC_SAVE_INFLIGHT += 1
            _t0 = time.time()
            try:
                _async_save_write_one(path, job)
            finally:
                _ms = int((time.time() - _t0) * 1000)
                if _ms > 250:
                    try:
                        ops_log("perf", "slow_save", file=os.path.basename(str(path)),
                                ms=_ms, kb=len(job.get("payload") or "") // 1024)
                    except Exception:
                        pass
                with _ASYNC_SAVE_LOCK:
                    _ASYNC_SAVE_INFLIGHT = max(0, _ASYNC_SAVE_INFLIGHT - 1)


def _ensure_async_saver():
    global _ASYNC_SAVE_THREAD
    t = _ASYNC_SAVE_THREAD
    if t is not None and t.is_alive():
        return True
    try:
        t = threading.Thread(target=_async_save_loop, name="mainbox-async-saver", daemon=True)
        t.start()
        _ASYNC_SAVE_THREAD = t
        return True
    except Exception:
        return False


def save_json_async(path, data, extra_db=None):
    """Snapshot-serialize NOW on the caller thread; hand disk + SQLite mirror to
    the background writer. extra_db: optional [(state_key, data)] mirrored after
    the file write (used by the cache's scanner-id persistence). Falls back to a
    fully synchronous save_json if serialization or the writer thread fails."""
    try:
        # v4.1.62 (ops-log finding: status=13.7MB x 52 writes, guard=26MB x 23 in
        # one hour): compact separators cut the hot files ~30% -- less caller-thread
        # serialize time, less disk, less OneDrive churn. Loaders are agnostic.
        payload = json.dumps(data, separators=(",", ":"), default=str)
    except Exception:
        return save_json(path, data)
    extra = []
    for _state_key, _extra_data in (extra_db or []):
        try:
            extra.append((_state_key, json.dumps(_extra_data, separators=(",", ":"), default=str)))
        except Exception:
            pass
    if not _ensure_async_saver():
        save_json(path, data)
        for _state_key, _extra_data in (extra_db or []):
            try:
                save_json_to_db(_state_key, _extra_data)
            except Exception:
                pass
        return
    with _ASYNC_SAVE_LOCK:
        _ASYNC_SAVE_LATEST[path] = {"payload": payload, "extra_db": extra}
    _ASYNC_SAVE_WAKE.set()


def flush_pending_async_saves(timeout_seconds=15.0):
    """Block until every queued background save AND the in-flight write are on
    disk (bounded by timeout). Called at app close and before a cloud-bridge
    backup request. Returns True when fully drained."""
    deadline = time.time() + max(0.5, float(timeout_seconds))
    while time.time() < deadline:
        with _ASYNC_SAVE_LOCK:
            drained = (not _ASYNC_SAVE_LATEST) and _ASYNC_SAVE_INFLIGHT == 0
        if drained:
            return True
        _ASYNC_SAVE_WAKE.set()
        time.sleep(0.05)
    return False


# =============================================================================
# v4.1.60 OPERATIONS LOG -- production telemetry for tightening MaINbox.
#
# Purpose: capture every meaningful DECISION the app makes (triage proposals and
# clamps, user corrections, auto-group engine verdicts and the user's answers to
# suggestions, quote-coverage creation/skip reasons, PO ledger outcomes,
# attachment-review reasons, sent-tracker scan outcomes, contact-type offers,
# bulk-operation sizes/durations, slow persistence writes) so real usage data --
# especially the gap between what automation did and what the user corrected --
# can drive the next round of tuning.
#
# Format: JSONL (one compact JSON object per line). Append-only, so a crash can
# at worst truncate the final line; every other line stays parseable. Fields:
# t (timestamp), c (category), e (event), s (session id), + event data. String
# values are truncated to 200 chars; bodies are never logged.
#
# Performance: ops_log() only appends to an in-memory deque under a lock
# (microseconds, any thread). A daemon flusher drains it to disk every ~2s with
# a single append write, NO fsync (telemetry is loss-tolerant by design; the
# main thread never touches this file). Size cap: 30 MB active + one 30 MB
# rotation (mainbox_ops_log.jsonl.1) ~= several weeks of data at a busy shop's
# volume; the cap check is one getsize per flush.
# =============================================================================
OPS_LOG_FILE = data_path("mainbox_ops_log.jsonl")
OPS_LOG_MAX_BYTES = 30 * 1024 * 1024
_OPS_LOG_LOCK = threading.Lock()
_OPS_LOG_BUF = []
_OPS_LOG_THREAD = None
_OPS_LOG_DISABLED = False
_OPS_LOG_SESSION = datetime.now().strftime("%Y%m%d%H%M%S")


def _ops_log_flush_once():
    global _OPS_LOG_DISABLED
    with _OPS_LOG_LOCK:
        if not _OPS_LOG_BUF:
            return
        lines = _OPS_LOG_BUF[:]
        del _OPS_LOG_BUF[:]
    try:
        try:
            if os.path.getsize(OPS_LOG_FILE) > OPS_LOG_MAX_BYTES:
                os.replace(OPS_LOG_FILE, OPS_LOG_FILE + ".1")  # rotate; previous .1 replaced
        except OSError:
            pass  # file absent yet
        with open(OPS_LOG_FILE, "a", encoding="utf-8") as f:
            f.write("".join(lines))
        try:
            # Post-write check too, so a large burst can never leave the active
            # file over the cap until the next flush.
            if os.path.getsize(OPS_LOG_FILE) > OPS_LOG_MAX_BYTES:
                os.replace(OPS_LOG_FILE, OPS_LOG_FILE + ".1")
        except OSError:
            pass
    except Exception:
        # Unwritable location: drop silently and stop accumulating memory.
        _OPS_LOG_DISABLED = True


def _ops_log_loop():
    while True:
        time.sleep(2.0)
        try:
            _ops_log_flush_once()
        except Exception:
            pass


def _ops_log_trim(v):
    if isinstance(v, str):
        return v if len(v) <= 200 else v[:200] + "\u2026"
    if isinstance(v, float):
        return round(v, 4)
    if isinstance(v, (list, tuple)):
        return [_ops_log_trim(x) for x in list(v)[:20]]
    if isinstance(v, dict):
        return {str(k)[:60]: _ops_log_trim(x) for k, x in list(v.items())[:20]}
    return v


def ops_log(_cat, _ev, **data):
    """Record one operational event. Never raises; near-zero caller cost.
    Positional names are underscored so event data can freely use keys like
    'cat' or 'ev' without colliding with the signature (a collision would be a
    TypeError at the CALL SITE, outside this function's try -- caught by the
    v4.1.60 harness)."""
    global _OPS_LOG_THREAD
    if _OPS_LOG_DISABLED:
        return
    try:
        rec = {"t": datetime.now().isoformat(timespec="seconds"),
               "c": str(_cat), "e": str(_ev), "s": _OPS_LOG_SESSION}
        for k, v in data.items():
            rec[k] = _ops_log_trim(v)
        line = json.dumps(rec, default=str, separators=(",", ":")) + "\n"
        with _OPS_LOG_LOCK:
            _OPS_LOG_BUF.append(line)
            if len(_OPS_LOG_BUF) > 5000:  # runaway guard
                del _OPS_LOG_BUF[:2500]
        t = _OPS_LOG_THREAD
        if t is None or not t.is_alive():
            t = threading.Thread(target=_ops_log_loop, name="mainbox-ops-log", daemon=True)
            t.start()
            _OPS_LOG_THREAD = t
    except Exception:
        pass


def restore_db_from_json_files():
    """Maintenance tool: force the SQLite mirror to match the current JSON files."""
    restored = []
    skipped = []
    errors = []
    for path, state_key in DB_SYNC_FILES.items():
        try:
            if not os.path.exists(path):
                if path in DB_SYNC_REQUIRED_DEFAULTS:
                    data = _ensure_required_sync_file(path)
                    if save_json_to_db(state_key, data):
                        restored.append(os.path.basename(path) + " (created empty)")
                    else:
                        errors.append(f"{os.path.basename(path)}: DB write failed (see mainbox_db_mirror_failures.log)")
                else:
                    skipped.append(os.path.basename(path))
                continue
            with open(path, "r", encoding="utf-8") as f:
                data = json.load(f)
            # v4.1.22 (finding #12): report the DB write's ACTUAL outcome -- a locked
            # database previously still landed this file in 'restored'.
            if save_json_to_db(state_key, data):
                restored.append(os.path.basename(path))
            else:
                errors.append(f"{os.path.basename(path)}: DB write failed (see mainbox_db_mirror_failures.log)")
        except Exception as exc:
            errors.append(f"{os.path.basename(path)}: {exc}")
    return {"restored": restored, "skipped": skipped, "errors": errors}


def backup_db_to_json_files(backup_folder=None):
    """Maintenance tool: export the SQLite mirror back out to JSON files."""
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    if not backup_folder:
        backup_folder = os.path.join(APP_DATA_DIR, f"json_backup_{timestamp}")
    os.makedirs(backup_folder, exist_ok=True)
    exported = []
    skipped = []
    errors = []
    for path, state_key in DB_SYNC_FILES.items():
        try:
            data = load_json_from_db(state_key, None)
            if data is None:
                if path in DB_SYNC_REQUIRED_DEFAULTS:
                    data = _ensure_required_sync_file(path)
                    save_json_to_db(state_key, data)
                else:
                    skipped.append(state_key)
                    continue
            out_path = os.path.join(backup_folder, os.path.basename(path))
            with open(out_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2, default=str)
            exported.append(out_path)
        except Exception as exc:
            errors.append(f"{state_key}: {exc}")
    return {"backup_folder": backup_folder, "exported": exported, "skipped": skipped, "errors": errors}


def verify_sync_health():
    """Maintenance tool: compare JSON files against their SQLite mirror copies."""
    report = []
    ok_count = 0
    warning_count = 0
    error_count = 0
    for path, state_key in DB_SYNC_FILES.items():
        item = {
            "file": os.path.basename(path),
            "state_key": state_key,
            "json_exists": os.path.exists(path),
            "db_exists": False,
            "matches": False,
            "status": "unknown",
            "error": "",
        }
        try:
            json_data = None
            if os.path.exists(path):
                with open(path, "r", encoding="utf-8") as f:
                    json_data = json.load(f)
            db_data = load_json_from_db(state_key, None)
            item["db_exists"] = db_data is not None
            if json_data is None and db_data is None:
                if path in DB_SYNC_REQUIRED_DEFAULTS:
                    default_data = _ensure_required_sync_file(path)
                    save_json_to_db(state_key, default_data)
                    item["json_exists"] = True
                    item["db_exists"] = True
                    item["matches"] = True
                    item["status"] = "ok (created empty)"
                    ok_count += 1
                else:
                    item["status"] = "missing both"
                    warning_count += 1
            elif json_data == db_data:
                item["matches"] = True
                item["status"] = "ok"
                ok_count += 1
            elif json_data is None:
                item["status"] = "json missing; db has data"
                warning_count += 1
            elif db_data is None:
                item["status"] = "db missing; json has data"
                warning_count += 1
            else:
                item["status"] = "different"
                warning_count += 1
        except Exception as exc:
            item["status"] = "error"
            item["error"] = str(exc)
            error_count += 1
        report.append(item)
    return {
        "ok": ok_count,
        "warnings": warning_count,
        "errors": error_count,
        "items": report,
    }


def reconcile_sync_files_db_to_json():
    """Startup self-heal for the JSON<->SQLite mirror.

    The app reads the SQLite copy preferentially, so the DB is the authoritative
    runtime source. If a synced file's on-disk JSON drifted away from the DB copy
    (for example, an interrupted save, or a mirror write that briefly lost a lock),
    rewrite the JSON from the DB so they match again. This only re-aligns the backup
    mirror; it never changes what the app actually uses, and it leaves files alone
    when the DB has no row yet (so load_json can still mirror JSON->DB on first read).
    Comparison is done on normalized serialized form to avoid spurious mismatches.
    Returns the list of basenames that were healed.
    """
    healed = []
    for path, state_key in DB_SYNC_FILES.items():
        try:
            # v3.8.30: if the on-disk JSON is newer than the DB mirror (a manual restore
            # or hand-edit), absorb it INTO the DB instead of overwriting it. This startup
            # self-heal previously always pushed DB->JSON, so a freshly restored JSON file
            # was destroyed before the app ever read it. Cloud-bridge restores replace the
            # .db file itself, so the DB stays newest/authoritative for those.
            if _json_file_is_newer_than_db(path):
                try:
                    with open(path, "r", encoding="utf-8") as f:
                        file_data = json.load(f)
                    # v4.1.23 (finding #13): a successful absorb clears the pending-mirror
                    # mark; a FAILED one keeps the file JSON-authoritative and skips the
                    # DB->JSON alignment below (which would restore stale data).
                    if save_json_to_db(state_key, file_data):
                        _db_mirror_pending_update(path, False)
                        healed.append(os.path.basename(path) + " (json->db: file newer)")
                    else:
                        _db_mirror_pending_update(path, True)
                    continue
                except Exception:
                    continue  # never fall through to DB->JSON for a JSON-authoritative file
            db_data = load_json_from_db(state_key, None)
            if db_data is None:
                continue  # nothing authoritative yet; let normal load mirror JSON->DB
            json_data = None
            json_exists = os.path.exists(path)
            if json_exists:
                try:
                    with open(path, "r", encoding="utf-8") as f:
                        json_data = json.load(f)
                except Exception:
                    json_data = None
            same = False
            if json_exists and json_data is not None:
                try:
                    same = (
                        json.dumps(json_data, sort_keys=True, default=str)
                        == json.dumps(db_data, sort_keys=True, default=str)
                    )
                except Exception:
                    same = (json_data == db_data)
            if not same:
                # save_json writes the JSON file atomically and re-mirrors the same
                # content to the DB, so afterwards the two copies are identical.
                save_json(path, db_data)
                healed.append(os.path.basename(path))
        except Exception:
            traceback.print_exc()
    return healed


