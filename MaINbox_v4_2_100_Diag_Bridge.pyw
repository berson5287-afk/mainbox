    merged["commitment_reminders_enabled"] = bool(merged.get("commitment_reminders_enabled", True))
    mode = str(merged.get("commitment_reminder_mode", "prompt") or "prompt").strip().lower()
    if not merged["commitment_reminders_enabled"]:
        mode = "disabled"
