def ask_ollama_extract_purchase_history_from_email(subject, sender_name, sender_email, body):
    """Use the local text model to find purchased/quoted material history in one old email.

    This is used by the purchase-history teaching tool. It is intentionally review-first:
    rows are returned to the scanner grid and are not written to memory until the user saves them.
    """
    if not OLLAMA_ENABLED:
        return None
    clean = (body or "").strip()
    if not clean:
        return None
    # Keep old-email teaching bounded while allowing enough context for quoted material lines.
    clean = clean[:PURCHASE_AI_BODY_LIMIT]
    prompt = f"""
You are MaINbox Procurement Memory. Read this old Outlook email and extract only real material purchase/quote history.
Return ONLY valid JSON. No markdown, no commentary.

Goal: learn which vendor supplied or quoted which material, with qty and price when present.
Use the sender as the default vendor unless the email clearly names a different vendor.
Do not invent prices, quantities, vendors, manufacturers, or items.
Ignore signatures, disclaimers, legal text, freight terms, and unrelated email headers.
If the email only discusses logistics and has no material lines, return an empty items array.

Email subject: {subject}
Sender name: {sender_name}
Sender email: {sender_email}

Email body:
{clean}

JSON format:
{{
  "items": [
    {{
      "vendor_name": "",
      "vendor_email": "",
      "qty": "",
      "unit": "",
      "part_number": "",
      "manufacturer": "",
      "description": "",
      "unit_price": null,
      "total_price": null,
      "job": "",
      "confidence": "high|medium|low",
      "notes": ""
    }}
  ]
}}
""".strip()
    payload = {
        "model": ai_model_for_task("purchase", RFQ_TEXT_MODEL or OLLAMA_MODEL),
        "prompt": prompt,
        "stream": False,
        "keep_alive": AI_KEEP_ALIVE,
        "options": {"temperature": 0.01, "num_predict": 1100, "num_ctx": 8192, "top_k": 10, "top_p": 0.55}
    }
    try:
        data = json.dumps(payload).encode("utf-8")
        with ollama_open(data, task="purchase", timeout=PURCHASE_AI_TIMEOUT_SECONDS) as response:
            raw = response.read().decode("utf-8")
            result = json.loads(raw)
            obj = extract_json_object(result.get("response") or "")
            if not isinstance(obj, dict) or not isinstance(obj.get("items"), list):
                return []
            cleaned = []
            seen = set()
            default_vendor_name = str(sender_name or sender_email or "").strip()
            default_vendor_email = extract_email_address(str(sender_email or sender_name or ""))
            for item in obj.get("items", [])[:60]:
                if not isinstance(item, dict):
                    continue
                desc = re.sub(r"\s+", " ", str(item.get("description", "") or "").strip())
                part = str(item.get("part_number", "") or "").strip().upper()
                if not desc and not part:
                    continue
                vendor_name = str(item.get("vendor_name", "") or default_vendor_name).strip()
                vendor_email = extract_email_address(str(item.get("vendor_email", "") or default_vendor_email or vendor_name))
                if not vendor_email:
                    vendor_email = default_vendor_email
                if not vendor_email:
                    continue
                unit_price = money_to_float(item.get("unit_price"))
                total_price = money_to_float(item.get("total_price"))
                row = {
                    "qty": str(item.get("qty", "") or "").strip(),
                    "unit": str(item.get("unit", "") or "").strip().lower(),
                    "part_number": part,
                    "manufacturer": str(item.get("manufacturer", "") or "").strip(),
                    "description": desc,
                    "vendor_name": vendor_name,
                    "vendor_email": vendor_email,
                    "unit_price": unit_price,
                    "total_price": total_price,
                    "job": str(item.get("job", "") or "").strip(),
                    "confidence": str(item.get("confidence", "") or "").strip(),
                    "notes": str(item.get("notes", "") or "").strip(),
                    "raw_line": desc,
                    "source": "ollama_purchase_teacher"
                }
                if row["unit"] == "each":
                    row["unit"] = "ea"
                if row["unit"] == "feet":
                    row["unit"] = "ft"
                key = (vendor_email.lower(), canonical_material_key(row), row.get("qty", ""), str(row.get("unit_price", "")))
                if not key[1] or key in seen:
                    continue
                seen.add(key)
                cleaned.append(row)
            return cleaned
    except Exception:
