    # v2.5 Triage Center / learning import-export / group archive / deleted restore
    # =========================
    def _dedupe_triage_history(self):
        """Keep the AI Triage Center queue clean: one visible row per Outlook email.

        Older builds treated the AI Triage Center as a raw history log. If the same
        email was triaged again by a refresh/rescan, another row was appended to
        mainbox_triage_history.json. That made the center look like it had
        duplicate emails. Keep the newest row for each entry_id and preserve rows
        without an entry_id by their own id.
        """
        try:
            cleaned = []
            seen_entry_ids = set()
            seen_row_ids = set()
            for rec in self.triage_history or []:
                if not isinstance(rec, dict):
                    continue
                entry_id = str(rec.get("entry_id", "") or "").strip()
                row_id = str(rec.get("id", "") or "").strip()
                if entry_id:
                    if entry_id in seen_entry_ids:
                        continue
                    seen_entry_ids.add(entry_id)
                elif row_id:
                    if row_id in seen_row_ids:
                        continue
                    seen_row_ids.add(row_id)
                cleaned.append(rec)
            self.triage_history = cleaned
        except Exception:
            pass

    def save_triage_history(self):
        self._dedupe_triage_history()
        self.triage_history = self.triage_history[:1500]
        save_json(TRIAGE_HISTORY_FILE, self.triage_history)

    def save_deleted_history(self):
        self._trim_deleted_history()  # v4.1.75: separate manual / auto-junk budgets
        save_json(DELETED_HISTORY_FILE, self.deleted_history)

    def record_ai_triage_history(self, row_or_email, before=None, after=None, reason="", source="AI"):
        try:
            if isinstance(row_or_email, dict) and "entry_id" in row_or_email and "before" in row_or_email:
                row = row_or_email
                entry_id = row.get("entry_id", "")
                email = self.get_email_by_id(entry_id) or {}
                before = row.get("before", before or {})
                after = row.get("after", after or {})
                reason = row.get("reason", reason or "")
                source = row.get("source", source or "AI")
                applied = row.get("applied", {})
            else:
                email = row_or_email or {}
                entry_id = email.get("entry_id", "")
                before = before or {}
                after = after or {"category": email.get("category", ""), "urgency": email.get("urgency", ""), "status": email.get("status", ""), "group": self.get_group_id_for_email(entry_id)}
                applied = {}
            rec = {
                "id": f"triage_{datetime.now().strftime('%Y%m%d%H%M%S%f')}",
                "triaged_at": datetime.now().isoformat(),
                "entry_id": entry_id,
                "sender": email.get("sender", row_or_email.get("sender", "") if isinstance(row_or_email, dict) else ""),
                "sender_email": email.get("sender_email", ""),
                "subject": email.get("subject", row_or_email.get("subject", "") if isinstance(row_or_email, dict) else ""),
                "before": before or {},
                "after": after or {},
                "category": (after or {}).get("category", email.get("category", "")),
                "urgency": (after or {}).get("urgency", email.get("urgency", "")),
                "status": (after or {}).get("status", email.get("status", "")),
                "reason": reason or email.get("ai_triage_reason", ""),
                "source": source,
                "applied": applied,
            }
            # Prevent duplicate-looking AI Triage Center rows for the same email.
            # Rescans/retries can triage the same Outlook EntryID again; replace the
            # older visible row instead of appending a second copy.
            if entry_id:
                self.triage_history = [
                    r for r in self.triage_history
                    if not (isinstance(r, dict) and str(r.get("entry_id", "") or "").strip() == entry_id)
                ]
            self.triage_history.insert(0, rec)
            self.save_triage_history()
        except Exception:
            pass

    def open_live_triage_queue_window(self):
        """v3.9.43: AI Triage queue. Every email waiting to be triaged is listed here with a
        checkbox. Tick the ones you want (or Select All), then send them to the local AI in your
        own batches, triage by hand, or skip. Checkbox selections persist while the list
        auto-refreshes, so a highlight never drops out from under you. Skipping an email surfaces
        any Sent/Waiting trackers tied to it so you can decide how to handle them."""
        win = tk.Toplevel(self.root)
        win.title("AI Triage \u2014 Queue")
        remember_window_geometry(win, "AI Triage Queue", "1120x620")
        win.transient(self.root)
        apply_theme(win)

        tk.Label(win, text="AI Triage Queue", font=("Segoe UI", 15, "bold"), bg=_BG, fg=_ACCENT).pack(anchor="w", padx=10, pady=(10, 2))
        tk.Label(win, text=("Emails waiting to be triaged. Tick the checkboxes (or Select All), then send them to the local AI "
                            "in your own batches, triage by hand, or skip. Selections stay put while the list refreshes."),
                 fg=_FG_DIM, bg=_BG, wraplength=1080, justify="left").pack(anchor="w", padx=10, pady=(0, 6))

        status_var = tk.StringVar(value="")
        tk.Label(win, textvariable=status_var, fg=_ACCENT, bg=_BG, anchor="w").pack(fill="x", padx=10, pady=(0, 6))

        CHECK_ON = "\u2611"   # checked box
        CHECK_OFF = "\u2610"  # empty box

        tree = ttk.Treeview(win, columns=("check", "time", "sender", "subject", "category", "urgency", "status"),
                            show="headings", selectmode="none")
        for col, label, width in [("check", "\u2713", 34), ("time", "Received", 120), ("sender", "Sender", 185),
                                  ("subject", "Subject", 320), ("category", "Category", 130), ("urgency", "Urgency", 78),
                                  ("status", "Status", 110)]:
            tree.heading(col, text=label)
            tree.column(col, width=width, anchor=("center" if col == "check" else "w"), stretch=(col == "subject"))
        tree.pack(fill="both", expand=True, padx=10, pady=5)

        row_meta = {}            # iid -> entry_id
        checked_eids = set()     # entry_ids ticked by the user (survive auto-refresh)
        displayed_eids = []      # current display order, for change-detection

        def fmt_time(em):
            ts = em.get("received_timestamp")
            if ts:
                try:
                    return datetime.fromtimestamp(ts).strftime("%m/%d %I:%M %p")
                except Exception:
                    pass
            return em.get("received", "") or em.get("received_time", "") or ""

        def set_status(n):
            busy = " \u2014 AI is triaging..." if getattr(self, "ai_task_running", False) else ""
            status_var.set((f"{n} email(s) waiting." if n else "Nothing waiting to be triaged right now.") + busy)

        def build_rows(pending):
            for iid in tree.get_children():
                tree.delete(iid)
            row_meta.clear()
            del displayed_eids[:]
            for em in pending:
                eid = em.get("entry_id", "")
                mark = CHECK_ON if eid in checked_eids else CHECK_OFF
                try:
                    iid = tree.insert("", "end", values=(
                        mark, fmt_time(em), (em.get("sender", "") or "")[:42],
                        (em.get("subject", "") or "No subject")[:90],
                        em.get("category", ""), em.get("urgency", ""), em.get("status", "")))
                    row_meta[iid] = eid
                    displayed_eids.append(eid)
                except Exception:
                    continue
            set_status(len(row_meta))

        def current_pending():
            return self._collect_triage_candidates(limit=1000)

        def refresh_queue():
            try:
                if not win.winfo_exists():
                    return
            except Exception:
                return
            build_rows(current_pending())

        def auto_poll():
            # Keep the queue live as the drip triages, but don't reshuffle the list
            # out from under the user while they have items ticked.
            try:
                if not win.winfo_exists():
                    return
            except Exception:
                return
            pending = current_pending()
            eids = [e.get("entry_id", "") for e in pending]
            has_ticked = any(eid in checked_eids for eid in displayed_eids)
            if eids != displayed_eids and not has_ticked:
                build_rows(pending)
            else:
                set_status(len(displayed_eids))
            try:
                win.after(3000, auto_poll)
            except Exception:
                pass

        def set_check(iid, on):
            eid = row_meta.get(iid, "")
            if not eid:
                return
            if on:
                checked_eids.add(eid)
            else:
                checked_eids.discard(eid)
            try:
                vals = list(tree.item(iid, "values"))
                vals[0] = CHECK_ON if on else CHECK_OFF
                tree.item(iid, values=vals)
            except Exception:
                pass

        def toggle_check(iid):
            set_check(iid, row_meta.get(iid, "") not in checked_eids)

        def on_click(event):
            if tree.identify_region(event.x, event.y) != "cell":
                return
            if tree.identify_column(event.x) != "#1":
                return
            iid = tree.identify_row(event.y)
            if iid:
                toggle_check(iid)
                return "break"

        def select_all(event=None):
            kids = tree.get_children()
            all_on = bool(kids) and all(row_meta.get(i, "") in checked_eids for i in kids)
            for i in kids:
                set_check(i, not all_on)
            return "break"

        def checked_emails():
            out, seen = [], set()
            for iid, eid in row_meta.items():
                if eid in checked_eids and eid not in seen:
                    em = self.get_email_by_id(eid)
                    if em:
                        out.append(em)
                        seen.add(eid)
            return out

        def on_progress(row):
            try:
                if not win.winfo_exists():
                    return
            except Exception:
                return
            email = row.get("email", {}) if isinstance(row, dict) else {}
            entry_id = row.get("entry_id", "") or email.get("entry_id", "")
            after = row.get("after", {}) or {}
            for iid, eid in list(row_meta.items()):
                if eid and eid == entry_id:
                    try:
                        vals = list(tree.item(iid, "values"))
                        while len(vals) < 7:
                            vals.append("")
                        vals[4] = after.get("category", vals[4])
                        vals[5] = after.get("urgency", vals[5])
                        vals[6] = "\u2713 triaged"
                        tree.item(iid, values=vals)
                    except Exception:
                        pass
                    break

        def post_ai_poll():
            try:
                if not win.winfo_exists():
                    return
            except Exception:
                return
            if getattr(self, "ai_task_running", False):
                try:
                    win.after(1000, post_ai_poll)
                except Exception:
                    pass
            else:
                refresh_queue()

        def stop_ai():
            ev = getattr(self, "ai_cancel_event", None)
            if ev is not None:
                try:
                    ev.set()
                    status_var.set("Stopping AI after the current email finishes (up to ~90s)...")
                except Exception:
                    status_var.set("Could not signal stop.")
            else:
                status_var.set("No AI task is running.")

        def _do_send(eids, attempts):
            try:
                if not win.winfo_exists():
                    return
            except Exception:
                return
            emails = [e for e in (self.get_email_by_id(x) for x in eids) if e]
            if not emails:
                status_var.set("Those items are no longer available.")
                return
            if getattr(self, "ai_task_running", False):
                if attempts < 20:   # ~30s of waiting for the engine to free
                    status_var.set("AI engine busy; your selection will go as soon as it frees...")
                    try:
                        win.after(1500, lambda: _do_send(eids, attempts + 1))
                    except Exception:
                        pass
                else:
                    status_var.set("AI still busy. Click 'Stop AI' to interrupt, then Send again.")
                return
            started = self.start_ai_triage_for_emails(
                emails, task_name=f"triaging {len(emails)} selected email(s)",
                allow_group_prompt=False, progress_cb=on_progress)
            if started:
                status_var.set(f"Sending {len(emails)} item(s) to local AI \u2014 watch the Status column.")
                post_ai_poll()
            else:
                status_var.set("Could not start \u2014 AI engine is busy or disabled.")

        def send_to_ai():
            picked = checked_emails()
            if not picked:
                messagebox.showinfo("Send to AI", "Tick one or more emails first (or use Select All).", parent=win)
                return
            if not AI_TRIAGE_ENABLED:
                messagebox.showinfo("Send to AI", "AI triage is disabled in settings.", parent=win)
                return
            # Give the user's selection priority over the background drip for a bit.
            self._auto_triage_yield_until = datetime.now() + timedelta(seconds=45)
            _do_send([em.get("entry_id", "") for em in picked], 0)

        def _manual_one(email):
            eid = email.get("entry_id", "")
            def _on_saved(*_a):
                em2 = self.get_email_by_id(eid) or email
                em2["ai_triaged_at"] = datetime.now().isoformat()
                em2["ai_triage_pending"] = False
                self.save_record(em2)
                self.flush_status_data()
                checked_eids.discard(eid)
                refresh_queue()
            self.open_triage_teach_editor(email, parent=win, on_saved=_on_saved)

        def triage_manually():
            picked = checked_emails()
            if not picked:
                messagebox.showinfo("Manual triage", "Tick an email to triage manually (or double-click a row).", parent=win)
                return
            _manual_one(picked[0])

        def on_double(event):
            iid = tree.identify_row(event.y)
            if not iid:
                return
            eid = row_meta.get(iid, "")
            em = self.get_email_by_id(eid) if eid else None
            if em:
                _manual_one(em)

        def skip_selected():
            picked = checked_emails()
            if not picked:
                messagebox.showinfo("Skip", "Tick one or more emails to skip.", parent=win)
                return
            for em in picked:
                em["ai_triage_skipped"] = True
                em["ai_triage_pending"] = False
                self.save_record(em)
                checked_eids.discard(em.get("entry_id", ""))
            self.flush_status_data()
            refresh_queue()
            status_var.set(f"Skipped {len(picked)} item(s) \u2014 they won't be AI-triaged.")
            # v3.9.39: after skipping, surface any Sent / Waiting trackers tied to these
            # emails (e.g. the skipped email is actually the reply we were waiting on) so the
            # user can selectively clear them. Opens ONLY if associated trackers exist;
            # skipping alone never clears a tracker.
            try:
                self.open_skip_tracker_review(list(picked))
            except Exception:
                pass

        btns = tk.Frame(win, bg=_BG); btns.pack(fill="x", padx=10, pady=8)
        tk.Button(btns, text="Select All", command=select_all, width=10).pack(side="left", padx=4)
        tk.Button(btns, text="Send to Local AI", command=send_to_ai, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Triage Manually", command=triage_manually, width=15).pack(side="left", padx=4)
        tk.Button(btns, text="Skip Triage", command=skip_selected, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Stop AI", command=stop_ai, width=9).pack(side="left", padx=4)
        tk.Button(btns, text="View Previously Triaged", command=self.open_ai_triage_center_window, width=20).pack(side="left", padx=4)
        tk.Button(btns, text="Close", command=win.destroy, width=9).pack(side="right", padx=4)

        tree.bind("<Button-1>", on_click)
        tree.bind("<Double-1>", on_double)
        tree.bind("<Control-a>", select_all)
        tree.bind("<Control-A>", select_all)

        refresh_queue()
        auto_poll()

    def find_trackers_for_skipped_emails(self, emails):
        """Return the Sent / Waiting trackers associated with the given (skipped) emails.

        A 'tracker' is either an active Sent / Waiting placeholder (in
        self.sent_waiting_placeholders, not cleared) or a real email row that MaINbox
        woke up as a tracker (sent_waiting_tracker_active=True). Association is matched by
        thread identity, strongest first, and every match carries a visible reason:
          1) Outlook ConversationID equality                  (strongest, reliable)
          2) ConversationIndex prefix linkage, when both carry one (a reply's index
             extends the sent message's index)               (opportunistic)
          3) Normalized thread subject equality, with the counterparty shown as
             corroboration                                    (last resort)

        Returns a de-duplicated list of dicts:
            {"tracker": <dict>, "kind": "placeholder"|"row", "reason": <str>}
        so a tracker is listed once even if several skipped emails point at it.
        """
        results = {}

        def _add(tracker, kind, reason):
            key = tracker.get("entry_id", "") or str(id(tracker))
            if key not in results:
                results[key] = {"tracker": tracker, "kind": kind, "reason": reason}

        emails = [e for e in (emails or []) if isinstance(e, dict)]
        if not emails:
            return []

        # Pre-compute the skipped-email match keys once.
        skipped = []
        for em in emails:
            conv = str(em.get("conversation_id", "") or "").strip()
            subj_key = self._normalized_thread_subject(em.get("subject", ""))
            conv_index = str(em.get("conversation_index", "") or "").strip().lower()
            sender = str(em.get("sender", "") or em.get("sender_email", "") or "").strip().lower()
            skipped.append({"conv": conv, "subj": subj_key, "index": conv_index,
                            "sender": sender, "subject_disp": em.get("subject", "")})

        def _index_linked(a_index, b_index):
            if not a_index or not b_index:
                return False
            shorter, longer = (a_index, b_index) if len(a_index) <= len(b_index) else (b_index, a_index)
            # Conversation indexes share the 44-hex-char header for the same thread.
            return len(shorter) >= 10 and longer.startswith(shorter[:44] if len(shorter) >= 44 else shorter)

        def _match(tracker_conv, tracker_index, tracker_subj_key, tracker_sender):
            for s in skipped:
                if s["conv"] and tracker_conv and s["conv"] == tracker_conv:
                    return "Same Outlook conversation as a skipped email"
                if _index_linked(s["index"], tracker_index):
                    return "Reply thread of the tracked message (conversation index)"
                if s["subj"] and tracker_subj_key and s["subj"] == tracker_subj_key:
                    who = ""
                    if s["sender"] and tracker_sender and s["sender"] == tracker_sender:
                        who = f" from {s['sender']}"
                    disp = (s["subject_disp"] or "").strip()
                    disp = (disp[:48] + "...") if len(disp) > 48 else disp
                    return f"Same subject thread{who}: \u201c{disp}\u201d"
            return ""

        # 1) Active placeholders.
        for p in getattr(self, "sent_waiting_placeholders", []) or []:
            if not isinstance(p, dict) or p.get("cleared"):
                continue
            reason = _match(
                str(p.get("conversation_id", "") or "").strip(),
                str(p.get("sent_conversation_index", "") or "").strip().lower(),
                self._normalized_thread_subject(p.get("subject", "")),
                str(p.get("sender", "") or p.get("sender_email", "") or "").strip().lower(),
            )
            if reason:
                _add(p, "placeholder", reason)

        # 2) Real email rows currently acting as trackers.
        for row in getattr(self, "emails", []) or []:
            if not isinstance(row, dict):
                continue
            if row.get("is_sent_waiting_placeholder") or not row.get("sent_waiting_tracker_active"):
                continue
            reason = _match(
                str(row.get("conversation_id", "") or "").strip(),
                str(row.get("conversation_index", "") or "").strip().lower(),
                self._normalized_thread_subject(row.get("subject", "")),
                str(row.get("sender", "") or row.get("sender_email", "") or "").strip().lower(),
            )
            if reason:
                _add(row, "row", reason)

        return list(results.values())

    def clear_single_tracker(self, tracker, kind):
        """Clear ONE tracker the user explicitly selected in the skip-review screen.

        Mirrors the field semantics of the reply-driven clears (so the resurrect guard and
        the main-list filter behave the same) but records a manual reason. Does NOT persist
        here -- the caller batches the saves via _commit_tracker_clears so several clears
        write to disk once."""
        now = datetime.now().isoformat()
        try:
            if kind == "placeholder":
                if tracker.get("cleared"):
                    return False
                tracker["cleared"] = True
                tracker["cleared_at"] = now
                tracker["cleared_by_entry_id"] = ""
                tracker["cleared_reason"] = "user_skip_review"
                return True
            else:  # real email row acting as a tracker
                if not tracker.get("sent_waiting_tracker_active"):
                    return False
                tracker["sent_waiting_tracker_active"] = False
                tracker["sent_waiting_tracker_cleared_at"] = now
                tracker["sent_waiting_tracker_cleared_by_entry_id"] = ""
                tracker["sent_waiting_tracker_cleared_reason"] = "user_skip_review"
                if tracker.get("status") in ("Waiting on Vendor", "Waiting on Customer"):
                    tracker["status"] = "Completed"
                tracker["is_new_import"] = False
                return True
        except Exception:
            return False

    def _commit_tracker_clears(self, cleared):
        """Persist a batch of manual tracker clears once and refresh the main view.

        cleared: list of (tracker, kind) that clear_single_tracker already mutated.
        """
        placeholders_changed = any(k == "placeholder" for _, k in cleared)
        rows_changed = any(k == "row" for _, k in cleared)
        try:
            if rows_changed:
                for tracker, kind in cleared:
                    if kind == "row":
                        try:
                            self.save_record(tracker)
                        except Exception:
                            pass
            if placeholders_changed:
                # Drop now-cleared placeholder rows from the active list, mirroring
                # clear_sent_waiting_placeholder_for_reply().
                active_ids = {p.get("entry_id", "") for p in getattr(self, "sent_waiting_placeholders", []) if not p.get("cleared")}
                self.emails = [e for e in self.emails
                               if not e.get("is_sent_waiting_placeholder") or e.get("entry_id") in active_ids]
            self._rebuild_email_index()
            if placeholders_changed:
                self.save_sent_waiting_placeholders()
            if rows_changed:
                self.flush_status_data()
            self.save_cached_state()
            try:
                self.render_email_rows()
                self.render_group_rows()
                self.render_followup_preview_queue()
            except Exception:
                pass
        except Exception:
            pass

    def open_tracker_in_outlook_async(self, tracker, kind, status_cb=None):
        """Open the tracker's Outlook item on a worker thread so a stale or missing EntryID
        cannot freeze the UI (the exact failure mode that froze MaINbox on the home PC).

        The worker uses its OWN thread-local COM apartment -- CoInitialize + a fresh
        Dispatch/GetNamespace -- and never touches self.namespace/self.outlook (which belong
        to the main thread). Fails soft: any problem just reports through status_cb and the
        review screen stays usable, so the clear decision never depends on the email opening.
        """
        if kind == "placeholder":
            entry_id = str(tracker.get("sent_entry_id", "") or "")
            store_id = ""
        else:
            entry_id = str(tracker.get("entry_id", "") or "")
            store_id = str(tracker.get("store_id", "") or "")

        def _say(msg):
            if status_cb:
                try:
                    self.root.after(0, lambda: status_cb(msg))
                except Exception:
                    pass

        if not entry_id:
            _say("No Outlook message is linked to this tracker, so it can't be opened.")
            return

        def worker():
            local_pythoncom = None
            try:
                import pythoncom as local_pythoncom
                import win32com.client as _w32
                try:
                    local_pythoncom.CoInitialize()
                except Exception:
                    pass
                try:
                    ol = _w32.Dispatch("Outlook.Application")
                    ns = ol.GetNamespace("MAPI")
                except Exception:
                    _say("Couldn't reach Outlook. Make sure Outlook desktop is open.")
                    return
                item = None
                try:
                    item = ns.GetItemFromID(entry_id, store_id) if store_id else ns.GetItemFromID(entry_id)
                except Exception:
                    item = None
                if item is None:
                    _say("Couldn't open this in Outlook \u2014 the message may have moved, or this tracker came from a different machine.")
                    return
                try:
                    item.Display()
                    _say("Opened in Outlook.")
                except Exception:
                    _say("Found the message but Outlook wouldn't display it.")
            except Exception:
                _say("Couldn't open this in Outlook.")
            finally:
                if local_pythoncom is not None:
                    try:
                        local_pythoncom.CoUninitialize()
                    except Exception:
                        pass

        try:
            threading.Thread(target=worker, daemon=True).start()
        except Exception:
            _say("Couldn't start the Outlook lookup.")

    def open_skip_tracker_review(self, skipped_emails):
        """After the user skips triage items, show any Sent / Waiting trackers tied to those
        emails so they can decide which (if any) to clear -- e.g. a skipped email is actually
        the reply we were waiting on. Nothing is pre-selected; clearing is opt-in per row.
        If no trackers are associated, this shows nothing (skip is a high-frequency action)."""
        associations = self.find_trackers_for_skipped_emails(skipped_emails)
        if not associations:
            return  # no empty dialog on a routine skip

        win = tk.Toplevel(self.root)
        win.title("Skipped \u2014 Related Trackers")
        remember_window_geometry(win, "Skip Tracker Review", "940x470")
        win.transient(self.root)
        apply_theme(win)

        tk.Label(win, text="Trackers related to the emails you skipped",
                 font=("Segoe UI", 14, "bold"), bg=_BG, fg=_ACCENT).pack(anchor="w", padx=10, pady=(10, 2))
        tk.Label(win, text=("Skipping an email does not change these waiting trackers on its own. If a skipped email is "
                            "actually the reply you were waiting on, tick its tracker and clear it. Nothing is selected by "
                            "default. Double-click a row to open it in Outlook."),
                 fg=_FG_DIM, bg=_BG, wraplength=900, justify="left").pack(anchor="w", padx=10, pady=(0, 6))

        status_var = tk.StringVar(value=f"{len(associations)} related tracker(s). Tick the ones to clear \u2014 or close and change nothing.")
        tk.Label(win, textvariable=status_var, fg=_ACCENT, bg=_BG, anchor="w").pack(fill="x", padx=10, pady=(0, 6))

        CHECK_ON = "\u2611"
        CHECK_OFF = "\u2610"

        tree = ttk.Treeview(win, columns=("check", "status", "subject", "who", "reason"),
                            show="headings", selectmode="none")
        for col, label, width in [("check", "\u2713", 34), ("status", "Tracker", 130),
                                  ("subject", "Subject", 300), ("who", "Counterparty", 170),
                                  ("reason", "Why it's here", 270)]:
            tree.heading(col, text=label)
            tree.column(col, width=width, anchor=("center" if col == "check" else "w"), stretch=(col == "subject"))
        tree.pack(fill="both", expand=True, padx=10, pady=5)

        row_assoc = {}      # iid -> association dict
        checked = set()     # iids the user has ticked

        def build():
            for iid in tree.get_children():
                tree.delete(iid)
            row_assoc.clear()
            checked.clear()
            for a in associations:
                t = a["tracker"]
                try:
                    iid = tree.insert("", "end", values=(
                        CHECK_OFF,
                        t.get("status", "") or "Waiting",
                        (t.get("subject", "") or "No subject")[:80],
                        (t.get("sender", "") or t.get("sender_email", "") or "")[:36],
                        (a.get("reason", "") or "")[:64],
                    ))
                    row_assoc[iid] = a
                except Exception:
                    continue

        def set_check(iid, on):
            if on:
                checked.add(iid)
            else:
                checked.discard(iid)
            try:
                vals = list(tree.item(iid, "values"))
                vals[0] = CHECK_ON if on else CHECK_OFF
                tree.item(iid, values=vals)
            except Exception:
                pass

        def on_click(event):
            if tree.identify_region(event.x, event.y) != "cell":
                return
            if tree.identify_column(event.x) != "#1":
                return
            iid = tree.identify_row(event.y)
            if iid:
                set_check(iid, iid not in checked)
                return "break"

        def select_all(event=None):
            kids = tree.get_children()
            all_on = bool(kids) and all(i in checked for i in kids)
            for i in kids:
                set_check(i, not all_on)
            return "break"

        def open_checked_or_focused(focused_iid=None):
            target = None
            if focused_iid and focused_iid in row_assoc:
                target = row_assoc[focused_iid]
            else:
                for i in list(checked):
                    if i in row_assoc:
                        target = row_assoc[i]
                        break
            if not target:
                messagebox.showinfo("Open in Outlook", "Tick a tracker first, or double-click a row.", parent=win)
                return
            status_var.set("Opening in Outlook\u2026")
            self.open_tracker_in_outlook_async(target["tracker"], target["kind"], status_cb=status_var.set)

        def on_double(event):
            iid = tree.identify_row(event.y)
            if iid:
                open_checked_or_focused(focused_iid=iid)

        def clear_selected():
            picked = [row_assoc[i] for i in list(checked) if i in row_assoc]
            if not picked:
                messagebox.showinfo("Clear Trackers",
                                    "Tick one or more trackers to clear. Skipping an email changes nothing on its own.",
                                    parent=win)
                return
            done = []
            names = []
            for a in picked:
                if self.clear_single_tracker(a["tracker"], a["kind"]):
                    done.append((a["tracker"], a["kind"]))
                    names.append(f"\u2022 {a['tracker'].get('status','Waiting')}: "
                                 f"{(a['tracker'].get('subject','') or 'No subject')[:60]}")
            if done:
                self._commit_tracker_clears(done)
            # Drop cleared trackers from the in-memory association list and rebuild.
            remaining = [a for a in associations if not (
                (a["kind"] == "placeholder" and a["tracker"].get("cleared")) or
                (a["kind"] == "row" and not a["tracker"].get("sent_waiting_tracker_active"))
            )]
            del associations[:]
            associations.extend(remaining)
            build()
            if names:
                messagebox.showinfo("Trackers Cleared",
                                    "Cleared the following tracker(s):\n\n" + "\n".join(names) +
                                    "\n\nThey've left the active list. The skipped emails were not changed in Outlook.",
                                    parent=win)
            if associations:
                status_var.set(f"{len(associations)} related tracker(s) remaining.")
            else:
                status_var.set("All related trackers handled.")
                try:
                    win.after(500, win.destroy)
                except Exception:
                    pass

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=10, pady=8)
        tk.Button(btns, text="Select All", command=select_all, width=10).pack(side="left", padx=4)
        tk.Button(btns, text="Clear Selected Trackers", command=clear_selected, width=22).pack(side="left", padx=4)
        tk.Button(btns, text="Open in Outlook", command=lambda: open_checked_or_focused(), width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Close", command=win.destroy, width=9).pack(side="right", padx=4)

        tree.bind("<Button-1>", on_click)
        tree.bind("<Double-1>", on_double)
        tree.bind("<Control-a>", select_all)
        tree.bind("<Control-A>", select_all)

        build()

    def open_ai_triage_center_window(self):
        win = tk.Toplevel(self.root)
        win.title("AI Triage Center")
        remember_window_geometry(win, "AI Triage Center", "1050x620")
        win.transient(self.root)

        tk.Label(win, text="AI Triage History / Learning Rules", font=("Segoe UI", 15, "bold")).pack(anchor="w", padx=10, pady=(10, 3))
        tk.Label(win, text="Select a recent triage and click Edit to correct it. Corrections are saved into learning rules.", fg=_FG_DIM).pack(anchor="w", padx=10, pady=(0, 8))

        tree = ttk.Treeview(win, columns=("time", "sender", "subject", "category", "urgency", "status", "source"), show="headings", selectmode="extended")
        for col, label, width in [
            ("time", "Time", 140), ("sender", "Sender", 180), ("subject", "Subject", 330),
            ("category", "Category", 135), ("urgency", "Urgency", 75), ("status", "Status", 125), ("source", "Source", 75)
        ]:
            tree.heading(col, text=label)
            tree.column(col, width=width)
        tree.pack(fill="both", expand=True, padx=10, pady=5)

        def refresh():
            self._dedupe_triage_history()
            tree.delete(*tree.get_children())
            for rec in self.triage_history[:500]:
                rid = rec.get("id") or rec.get("entry_id") or f"row_{len(tree.get_children())}"
                t = rec.get("triaged_at", "")
                try:
                    t = datetime.fromisoformat(t).strftime("%m/%d %I:%M %p")
                except Exception:
                    pass
                tree.insert("", "end", iid=rid, values=(
                    t,
                    (rec.get("sender", "") or "")[:45],
                    (rec.get("subject", "") or "")[:95],
                    rec.get("category", ""),
                    rec.get("urgency", ""),
                    rec.get("status", ""),
                    rec.get("source", "AI"),
                ))
        def selected_records():
            ids = set(tree.selection())
            return [r for r in self.triage_history if (r.get("id") or r.get("entry_id")) in ids]

        def edit_selected():
            rows = selected_records()
            if not rows:
                messagebox.showwarning("No Triage Selected", "Select one recent triage to edit.", parent=win)
                return
            rec = rows[0]
            email = self.get_email_by_id(rec.get("entry_id", ""))
            edit = tk.Toplevel(win)
            edit.title("Edit Triage / Teach MaINbox")
            remember_window_geometry(edit, "Edit Triage Teach MaINbox", "540x355")
            edit.transient(win)
            self.safe_grab_set(edit)
            tk.Label(edit, text="Correct this triage", font=("Segoe UI", 13, "bold")).pack(anchor="w", padx=12, pady=(12, 4))
            tk.Label(edit, text=(rec.get("subject", "") or "No subject")[:100], wraplength=480).pack(anchor="w", padx=12, pady=(0, 10))
            cat = tk.StringVar(value=(email or rec).get("category", rec.get("category", "General")))
            urg = tk.StringVar(value=(email or rec).get("urgency", rec.get("urgency", "Normal")))
            stat = tk.StringVar(value=(email or rec).get("status", rec.get("status", "Needs Reply")))
            for label, var, vals in [("Workflow Category", cat, CATEGORIES), ("Urgency", urg, URGENCY_LEVELS), ("Status", stat, STATUSES)]:
                row = tk.Frame(edit)
                row.pack(fill="x", padx=12, pady=5)
                tk.Label(row, text=label, width=18, anchor="w").pack(side="left")
                ttk.Combobox(row, textvariable=var, values=vals, state="readonly", width=28).pack(side="left")
            followup_behavior = tk.StringVar(value="Use Status/AI")
            followup_minutes = tk.StringVar(value="Use Default")
            row = tk.Frame(edit); row.pack(fill="x", padx=12, pady=5)
            tk.Label(row, text="Follow-Up Learning", width=18, anchor="w").pack(side="left")
            ttk.Combobox(row, textvariable=followup_behavior, values=["Use Status/AI", "No Follow-Up", "Wait for Vendor", "Wait for Customer", "General Follow-Up Review"], state="readonly", width=28).pack(side="left")
            row = tk.Frame(edit); row.pack(fill="x", padx=12, pady=5)
            tk.Label(row, text="Follow-Up Timing", width=18, anchor="w").pack(side="left")
            ttk.Combobox(row, textvariable=followup_minutes, values=["Use Default", "1 minute", "5 minutes", "15 minutes", "30 minutes", "1 hour", "2 hours", "4 hours", "Tomorrow", "3 days", "1 week"], state="readonly", width=28).pack(side="left")
            tk.Label(row, text="saved as learning rule", fg=_FG_DIM).pack(side="left", padx=8)
            def save_edit():
                target = email
                if not target:
                    messagebox.showwarning("Email Not Loaded", "This email is not currently in the active cache. The correction will be saved as a learning rule from the triage record.", parent=edit)
                    target = {"entry_id": rec.get("entry_id", ""), "sender": rec.get("sender", ""), "sender_email": rec.get("sender_email", ""), "subject": rec.get("subject", "")}
                before = {"category": target.get("category", rec.get("category", "")), "urgency": target.get("urgency", rec.get("urgency", "")), "status": target.get("status", rec.get("status", ""))}
                target["category"] = cat.get()
                target["urgency"] = urg.get()
                target["status"] = stat.get()
                target["is_new_import"] = False
                if email:
                    self.save_record(target)
                    self.flush_status_data()
                    self.save_cached_state()
                self.learn_from_user_correction(target, cat.get(), urg.get(), stat.get())
                fb = followup_behavior.get()
                minutes_choice = followup_minutes.get()
                minutes_val = self.followup_minutes_from_choice(minutes_choice)
                fb_map = {"No Follow-Up": "no_followup", "Wait for Vendor": "wait_for_vendor", "Wait for Customer": "wait_for_customer", "General Follow-Up Review": "followup_review"}
                learned_behavior = fb_map.get(fb, "")
                if learned_behavior:
                    self.learn_followup_behavior(target, learned_behavior, minutes_val, f"User taught follow-up behavior from AI Triage Center: {fb}")

                # Apply the follow-up correction to THIS email too, not only future similar emails.
                followup_action_note = ""
                if email:
                    if learned_behavior == "no_followup":
                        cancelled = 0
                        for item in self.followups:
                            if item.get("entry_id") == target.get("entry_id") and not item.get("completed") and not item.get("cancelled"):
                                item["cancelled"] = True
                                item["cancelled_at"] = datetime.now().isoformat()
                                item["cancel_reason"] = "User taught No Follow-Up from AI Triage Center"
                                cancelled += 1
                        for item in self.scenario_reminders:
                            if item.get("entry_id") == target.get("entry_id") and not item.get("completed") and not item.get("cancelled"):
                                item["cancelled"] = True
                                item["cancelled_at"] = datetime.now().isoformat()
                                item["cancel_reason"] = "User taught No Follow-Up from AI Triage Center"
                                cancelled += 1
                        self.save_followups(); self.save_scenario_reminders()
                        target["followup_time"] = self.get_followup_display_for_email(target.get("entry_id", ""))
                        followup_action_note = f" No-follow-up applied to this email; cancelled {cancelled} active item(s)."
                    elif learned_behavior or minutes_val is not None:
                        # If a time is selected while behavior is Use Status/AI, schedule a safe review follow-up for this email.
                        behavior_for_now = learned_behavior or "followup_review"
                        if minutes_val is None:
                            if behavior_for_now == "wait_for_vendor":
                                minutes_val = VENDOR_NO_RESPONSE_MINUTES
                            elif behavior_for_now == "wait_for_customer":
                                minutes_val = CUSTOMER_PO_FOLLOWUP_MINUTES
                            else:
                                minutes_val = CUSTOMER_PO_FOLLOWUP_MINUTES
                        scenario_type = "ai_followup_review"
                        if behavior_for_now == "wait_for_vendor":
                            scenario_type = "ai_vendor_followup_review"
                        elif behavior_for_now == "wait_for_customer":
                            scenario_type = "ai_customer_followup_review"
                        scheduled = self.schedule_scenario_reminder(
                            scenario_type,
                            target,
                            int(minutes_val),
                            f"User corrected follow-up from AI Triage Center: {fb}; timing {minutes_choice}"
                        )
                        if scheduled:
                            followup_action_note = f" Follow-up review scheduled for this email in {int(minutes_val)} minute(s)."
                        else:
                            followup_action_note = " Follow-up was not scheduled because an active matching reminder may already exist."
                        self.save_scenario_reminders()
                        self.save_commitment_reminders()
                        target["followup_time"] = self.get_followup_display_for_email(target.get("entry_id", ""))

                self.record_ai_triage_history(target, before=before, after={"category": cat.get(), "urgency": urg.get(), "status": stat.get(), "group": self.get_group_id_for_email(target.get("entry_id", "")), "followup_behavior": fb, "followup_minutes": minutes_val}, reason="User corrected from AI Triage Center." + followup_action_note, source="User Edit")
                self.sort_emails_for_display(); self.render_email_rows(); self.render_group_rows(); self.render_followup_preview_queue()
                edit.destroy(); refresh()
            btns = tk.Frame(edit); btns.pack(fill="x", padx=12, pady=15)
            tk.Button(btns, text="Save Correction", command=save_edit, width=18).pack(side="left", padx=5)
            tk.Button(btns, text="Cancel", command=edit.destroy, width=12).pack(side="left", padx=5)

        def export_rules():
            path = filedialog.asksaveasfilename(parent=win, title="Export MaINbox Triage + Follow-Up Learning Rules", defaultextension=".json", filetypes=[("JSON files", "*.json")], initialfile="mainbox_triage_followup_learning_rules_export.json")
            if not path:
                return
            data = {"exported_at": datetime.now().isoformat(), "version": "MaINbox v3", "includes": ["triage_rules", "followup_rules"], "learning_rules": self.learning_data}
            save_json(path, data)
            messagebox.showinfo("Export Complete", f"Triage + follow-up learning rules exported to:\n{path}", parent=win)
        def import_rules():
            path = filedialog.askopenfilename(parent=win, title="Import MaINbox Triage + Follow-Up Learning Rules", filetypes=[("JSON files", "*.json")])
            if not path:
                return
            try:
                data = load_json(path, {})
                rules = data.get("learning_rules", data)
                if not isinstance(rules, dict):
                    raise ValueError("Invalid learning rules file")
                for bucket in ["senders", "domains", "subjects", "followups", "group_rules"]:
                    self.learning_data.setdefault(bucket, {})
                    self.learning_data[bucket].update(rules.get(bucket, {}))
                    self._trim_learning_bucket(bucket)
                self.save_learning_data()
                messagebox.showinfo("Import Complete", "Triage + follow-up learning rules imported.", parent=win)
            except Exception as e:
                messagebox.showerror("Import Failed", str(e), parent=win)

        def view_followup_rules():
            rules_win = tk.Toplevel(win)
            rules_win.title("Adaptive Follow-Up Learning Rules")
            remember_window_geometry(rules_win, "Adaptive Follow-Up Learning Rules", "980x520")
            rules_win.transient(win)
            search_frame = tk.LabelFrame(rules_win, text="Search Follow-Up Learning Rules")
            search_frame.pack(fill="x", padx=10, pady=(10, 4))
            tk.Label(search_frame, text="Search behavior / sender / subject / domain:").pack(side="left", padx=6, pady=6)
            search_var = tk.StringVar()
            search_entry = tk.Entry(search_frame, textvariable=search_var, width=55)
            search_entry.pack(side="left", padx=6, pady=6)
            count_var = tk.StringVar(value="")
            tk.Label(search_frame, textvariable=count_var, fg=_FG_DIM).pack(side="right", padx=8)
            rule_tree = ttk.Treeview(rules_win, columns=("behavior", "minutes", "confidence", "times", "sender", "subject", "updated"), show="headings", selectmode="extended")
            for col, label, width in [
                ("behavior", "Behavior", 140), ("minutes", "Minutes", 80), ("confidence", "Confidence", 90),
                ("times", "Times", 70), ("sender", "Sender / Domain", 210), ("subject", "Subject Pattern", 260), ("updated", "Updated", 155)
            ]:
                rule_tree.heading(col, text=label)
                rule_tree.column(col, width=width)
            rule_tree.pack(fill="both", expand=True, padx=10, pady=6)

            def rows():
                items = []
                for key, rule in self.learning_data.get("followups", {}).items():
                    if not isinstance(rule, dict):
                        continue
                    items.append((key, rule))
                items.sort(key=lambda kv: kv[1].get("updated_at", ""), reverse=True)
                return items

            def refresh_rules(*_):
                rule_tree.delete(*rule_tree.get_children())
                q = search_var.get().strip().lower()
                visible = []
                for key, rule in rows():
                    hay = " ".join([key, str(rule.get("behavior", "")), str(rule.get("sender", "")), str(rule.get("domain", "")), str(rule.get("subject", "")), str(rule.get("sample_subject", "")), str(rule.get("reason", ""))]).lower()
                    if q and not all(part in hay for part in q.split()):
                        continue
                    visible.append((key, rule))
                    conf = float(rule.get("confidence", 0) or 0)
                    sender_label = rule.get("sender") or rule.get("domain") or key
                    rule_tree.insert("", "end", iid=key, values=(
                        rule.get("behavior", ""),
                        "" if rule.get("minutes") is None else rule.get("minutes"),
                        f"{conf:.0%}",
                        rule.get("times", 0),
                        sender_label,
                        rule.get("sample_subject") or rule.get("subject", ""),
                        rule.get("updated_at", ""),
                    ))
                count_var.set(f"Showing {len(visible)} of {len(rows())} follow-up rule(s)")

            def delete_selected_rules():
                ids = list(rule_tree.selection())
                if not ids:
                    return
                if not messagebox.askyesno("Delete Follow-Up Rule", f"Delete {len(ids)} selected follow-up learning rule(s)?", parent=rules_win):
                    return
                for key in ids:
                    self.learning_data.get("followups", {}).pop(key, None)
                self.save_learning_data()
                refresh_rules()

            def weaken_selected_rules():
                ids = list(rule_tree.selection())
                if not ids:
                    return
                for key in ids:
                    rule = self.learning_data.get("followups", {}).get(key)
                    if isinstance(rule, dict):
                        rule["confidence"] = max(0.10, float(rule.get("confidence", 0.35) or 0.35) - 0.20)
                        rule["updated_at"] = datetime.now().isoformat()
                self.save_learning_data()
                refresh_rules()

            search_var.trace_add("write", refresh_rules)
            btn_row = tk.Frame(rules_win); btn_row.pack(fill="x", padx=10, pady=(0, 10))
            tk.Button(btn_row, text="Weaken Selected", command=weaken_selected_rules, width=16).pack(side="left", padx=4)
            tk.Button(btn_row, text="Delete Selected", command=delete_selected_rules, width=16).pack(side="left", padx=4)
            tk.Button(btn_row, text="Refresh", command=refresh_rules, width=10).pack(side="left", padx=4)
            tk.Button(btn_row, text="Close", command=rules_win.destroy, width=10).pack(side="right", padx=4)
            refresh_rules()
            search_entry.focus_set()

        def clear_selected():
            rows = selected_records()
            if not rows:
                return
            if not messagebox.askyesno("Clear Selected", f"Clear {len(rows)} selected triage history item(s)?", parent=win):
                return
            ids = {r.get("id") for r in rows}
            self.triage_history = [r for r in self.triage_history if r.get("id") not in ids]
            self.save_triage_history(); refresh()
        def clear_all():
            if not messagebox.askyesno("Clear All Triage History", "Clear ALL AI triage history?\n\nThis does not delete learning rules unless you import/clear those separately.", parent=win):
                return
            self.triage_history = []
            self.save_triage_history(); refresh()

        def apply_triage_workflow_hotkey_profile(profile_name, event=None):
            """Apply common workflow hotkey profiles from inside the AI Triage Center.

            Patch: hotkeys can fire from both the Treeview and the parent window.
            The first handler applies the change and clears the selection; the second
            handler used to see no selected row and show the noisy "No Triage Selected"
            popup.  Debounce the handler and silently ignore empty hotkey events.
            """
            if getattr(self, "_ai_triage_hotkey_busy", False):
                return "break"
            self._ai_triage_hotkey_busy = True
            try:
                win.after_idle(lambda: setattr(self, "_ai_triage_hotkey_busy", False))
            except Exception:
                self._ai_triage_hotkey_busy = False
            profiles = {
                "vendor": {
                    "label": "Vendor",
                    "category": "Vendor / Supplier",
                    "urgency": "Normal",
                    "status": "New",
                    "email_type": "V",
                },
                "customer": {
                    "label": "Customer Quote/Estimate",
                    "category": "Quote / Estimate",
                    "urgency": "Normal",
                    "status": "New",
                    "email_type": "C",
                },
                "employee": {
                    "label": "Employee",
                    "category": "General",
                    "urgency": "Normal",
                    "status": "New",
                    "email_type": "E",
                },
                "marketing": {
                    "label": "Marketing",
                    "category": "Junk / Ignore",
                    "urgency": "Low",
                    "status": "Completed",
                    "email_type": "M",
                },
                "normal": {
                    "label": "Normal/Reset",
                    "category": "General",
                    "urgency": "Normal",
                    "status": "New",
                    "email_type": "",
                },
            }
            profile = profiles.get(profile_name)
            if not profile:
                return "break"
            rows = selected_records()
            if not rows:
                # Hotkeys should never nag with a popup. This often happens after the
                # same key event bubbles from the Treeview to the window after the
                # first handler already processed and cleared the selected triage row.
                return "break"

            try:
                self.save_undo_state(f"AI Triage apply {profile['label']} workflow hotkey")
            except Exception:
                pass

            changed_count = 0
            _typed_targets = []  # v4.1.55: collected for the first-time save-sender offer
            for rec in rows:
                entry_id = rec.get("entry_id", "")
                email = self.get_email_by_id(entry_id) if entry_id else None
                target = email or {
                    "entry_id": entry_id,
                    "sender": rec.get("sender", ""),
                    "sender_email": rec.get("sender_email", ""),
                    "subject": rec.get("subject", ""),
                    "category": rec.get("category", ""),
                    "urgency": rec.get("urgency", ""),
                    "status": rec.get("status", ""),
                    "email_type": rec.get("email_type", ""),
                }
                _typed_targets.append(target)
                before = {
                    "category": target.get("category", rec.get("category", "")),
                    "urgency": target.get("urgency", rec.get("urgency", "")),
                    "status": target.get("status", rec.get("status", "")),
                    "email_type": target.get("email_type", rec.get("email_type", "")),
                }

                # v4.1.16: a Triage Center hotkey (e.g. Normal/Reset) can reopen a
                # closed email; record the explicit reopen so the closed guard
                # cannot re-close it at the next startup.
                _was_closed = self._email_was_closed_before_edit(target)

                target["category"] = profile["category"]
                target["urgency"] = profile["urgency"]
                target["status"] = profile["status"]
                target["email_type"] = profile["email_type"]
                target["is_new_import"] = False

                rec["category"] = profile["category"]
                rec["urgency"] = profile["urgency"]
                rec["status"] = profile["status"]
                rec["email_type"] = profile["email_type"]
                rec["source"] = "User Hotkey"

                if _was_closed and not self.workflow_record_is_closed(target):
                    self._record_explicit_reopen_for_email(target, save=True)
                if email:
                    self.save_record(target)
                self.learn_from_user_correction(target, profile["category"], profile["urgency"], profile["status"])
                self.record_ai_triage_history(
                    target,
                    before=before,
                    after={
                        "category": profile["category"],
                        "urgency": profile["urgency"],
                        "status": profile["status"],
                        "email_type": profile["email_type"],
                        "group": self.get_group_id_for_email(target.get("entry_id", "")),
                    },
                    reason=f"User applied {profile['label']} workflow hotkey from AI Triage Center.",
                    source="User Hotkey",
                )
                changed_count += 1

            # Clear handled triage rows immediately so keyboard triage can move quickly.
            # Also remove the just-recorded "User Hotkey" history row for the same email so it
            # does not pop back into the triage list after the correction is applied.
            try:
                current_children = list(tree.get_children())
                selected_iids = set(tree.selection())
                selected_indexes = [current_children.index(iid) for iid in selected_iids if iid in current_children]
                next_index = min(selected_indexes) if selected_indexes else 0
            except Exception:
                next_index = 0

            clear_ids = {(r.get("id") or r.get("entry_id")) for r in rows}
            clear_entry_ids = {r.get("entry_id") for r in rows if r.get("entry_id")}
            self.triage_history = [
                r for r in self.triage_history
                if (r.get("id") or r.get("entry_id")) not in clear_ids
                and (not r.get("entry_id") or r.get("entry_id") not in clear_entry_ids)
            ]

            self.flush_status_data()
            self.save_cached_state()
            self.save_triage_history()
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            refresh()

            try:
                remaining = list(tree.get_children())
