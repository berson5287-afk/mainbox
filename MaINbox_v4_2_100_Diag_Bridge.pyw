        # calling save_record) is journaled synchronously so a crash/kill in the
        # async writer's window can never lose it. AI/background saves skip this.
        if email.get("ai_user_locked"):
            self._journal_user_decision(email, "save_record")

    def flush_status_data(self):
        # v4.1.58: serialized here (consistent snapshot), written + DB-mirrored on
        # the background persistence writer -- the fsync/commit stall is off the UI.
        save_json_async(STATUS_FILE, self.status_data)

    def email_is_completed(self, email):
        """True when the user has closed/hidden this email in MaINbox.

        Follow-up automation should treat Completed, Low, and Junk/Ignore as
        closed states.  The old check only looked at Status == Completed, which
        allowed AI scenario reminders to remain/reappear for items the user had
        already buried as Low or Junk, and sometimes kept completed trackers in
        the Follow-Up Queue until they became due.
        """
        try:
            email = email or {}
            return (
                email.get("status", "") == "Completed"
                or email.get("urgency", "") == "Low"
                or email.get("category", "") == "Junk / Ignore"
            )
        except Exception:
            return False

    def _followup_item_matches_email(self, item, email):
        """Match a follow-up/reminder/check to an email using the strongest IDs available."""
        try:
            if not item or not email:
                return False
            entry_id = email.get("entry_id", "")
            conversation_id = email.get("conversation_id", "")
            subject = (email.get("subject", "") or "").strip().lower()
            group_id = self.get_group_id_for_email(entry_id) if entry_id else ""

            if entry_id and item.get("entry_id") == entry_id:
                return True
            if conversation_id and item.get("conversation_id") == conversation_id:
                return True
            if group_id and item.get("group_id") == group_id:
                return True

            # Subject is only a last-resort fallback for older saved follow-up records
            # that may not have EntryID/ConversationID populated.
            item_subject = (item.get("subject", "") or "").strip().lower()
            if subject and item_subject and subject == item_subject:
                return True
        except Exception:
            pass
        return False

    def collect_active_tracking_items_for_emails(self, emails):
        """
        Return active follow-up/tracking rows associated with the selected email(s).
        Includes manual follow-ups, automatic scenario reminders, pending reply checks,
        and commitment reminders (promised dates / reply-needed).  # v3.8.31
        """
        rows = []
        seen = set()
        email_list = [e for e in (emails or []) if isinstance(e, dict)]

        def add_row(collection_name, index, item, kind, tracking_type, email):
            if not item or item.get("completed") or item.get("cancelled"):
                return
            key = (collection_name, index)
            if key in seen:
                return
            seen.add(key)
            rows.append({
                "key": key,
                "collection": collection_name,
                "index": index,
                "item": item,
                "kind": kind,
                "tracking_type": tracking_type,
                "email": email,
                "subject": item.get("subject") or email.get("subject", "") or "(No subject)",
                "due": self.format_due_display(item.get("due_at", "")) if hasattr(self, "format_due_display") else item.get("due_at", ""),
                "note": item.get("message") or item.get("note") or item.get("reason") or item.get("description") or "",
            })

        for email in email_list:
            for index, item in enumerate(getattr(self, "followups", []) or []):
                if self._followup_item_matches_email(item, email):
                    add_row("followups", index, item, "Manual follow-up", "Manual", email)

            for index, item in enumerate(getattr(self, "scenario_reminders", []) or []):
                if self._followup_item_matches_email(item, email):
                    scenario_type = item.get("type", "scenario")
                    if scenario_type == "vendor_no_response":
                        kind = "Auto: Vendor no-response"
                    elif scenario_type == "customer_po_order_followup":
                        kind = "Auto: PO/order follow-up"
                    else:
                        kind = "Auto: " + scenario_type.replace("_", " ").title()
                    add_row("scenario_reminders", index, item, kind, "Auto", email)

            for index, item in enumerate(getattr(self, "pending_reply_checks", []) or []):
                if self._followup_item_matches_email(item, email):
                    add_row("pending_reply_checks", index, item, "Auto: Pending reply check", "Auto", email)

            # v3.8.30: commitment reminders (promised dates / reply-needed) are active
            # tracking for the email too, so they must show up in the completion review
            # and clear when the email is marked Completed. They were omitted here, so a
            # commitment reminder kept firing even after its email was completed.
            for index, item in enumerate(getattr(self, "commitment_reminders", []) or []):
                if self._followup_item_matches_email(item, email):
                    c_kind = "Auto: " + (item.get("kind_label") or "Commitment reminder")
                    add_row("commitment_reminders", index, item, c_kind, "Auto", email)

        return rows

    def review_tracking_items_before_complete(self, emails):
        """
        When marking email(s) Completed/Low/Junk, let the user decide which related
        follow-ups/tracking records to clear. Automatic items are selected by default;
        manual follow-ups are shown but left unselected unless the user chooses them.
        """
        rows = self.collect_active_tracking_items_for_emails(emails)
        if not rows:
            return set()

        win = tk.Toplevel(self.root)
        win.title("Review Follow-Ups Before Completing")
        remember_window_geometry(win, "Review Follow-Ups Before Completing", "980x460")
        win.transient(self.root)
        self.safe_grab_set(win)

        tk.Label(
            win,
            text="This email has active follow-up/tracking items.",
            font=("Segoe UI", 14, "bold")
        ).pack(anchor="w", padx=12, pady=(10, 2))
        tk.Label(
            win,
            text="Automatic items are selected by default. Manual follow-ups are shown so you can choose whether to keep or clear them.",
            font=("Segoe UI", 9)
        ).pack(anchor="w", padx=12, pady=(0, 8))

        columns = ("clear", "type", "due", "subject", "note")
        tree = ttk.Treeview(win, columns=columns, show="headings", selectmode="extended", height=12)
        tree.heading("clear", text="Clear?")
        tree.heading("type", text="Auto / Manual")
        tree.heading("due", text="Due")
        tree.heading("subject", text="Subject")
        tree.heading("note", text="Note")
        tree.column("clear", width=70, anchor="center")
        tree.column("type", width=180)
        tree.column("due", width=120)
        tree.column("subject", width=300)
        tree.column("note", width=280)
        tree.pack(fill="both", expand=True, padx=12, pady=6)

        selected_keys = set()
        row_by_iid = {}
        for idx, row in enumerate(rows):
            iid = str(idx)
            row_by_iid[iid] = row
            if row.get("tracking_type") == "Auto":
                selected_keys.add(row["key"])
            tree.insert(
                "", "end", iid=iid,
                values=(
                    "Yes" if row["key"] in selected_keys else "No",
                    row.get("kind", ""),
                    row.get("due", ""),
                    row.get("subject", ""),
                    row.get("note", ""),
                )
            )

        result = {"keys": None, "skip_complete": False}

        def refresh_marks():
            for iid, row in row_by_iid.items():
                vals = list(tree.item(iid, "values"))
                vals[0] = "Yes" if row["key"] in selected_keys else "No"
                tree.item(iid, values=vals)

        def toggle_selected(event=None):
            iids = tree.selection()
            if not iids:
                iid = tree.focus()
                iids = [iid] if iid else []
            for iid in iids:
                row = row_by_iid.get(iid)
                if not row:
                    continue
                key = row["key"]
                if key in selected_keys:
                    selected_keys.remove(key)
                else:
                    selected_keys.add(key)
            refresh_marks()

        def select_auto():
            selected_keys.clear()
            for row in rows:
                if row.get("tracking_type") == "Auto":
                    selected_keys.add(row["key"])
            refresh_marks()

        def select_all():
            selected_keys.clear()
            selected_keys.update(row["key"] for row in rows)
            refresh_marks()

        def select_none():
            selected_keys.clear()
            refresh_marks()

        def clear_selected_and_close():
            result["keys"] = set(selected_keys)
            win.destroy()

        def clear_all_and_close():
            result["keys"] = {row["key"] for row in rows}
            win.destroy()

        def keep_all_and_close():
            result["keys"] = set()
            win.destroy()

        def skip_mark_complete_and_close():
            result["skip_complete"] = True
            result["keys"] = None
            win.destroy()

        tree.bind("<Double-Button-1>", toggle_selected)
        tree.bind("<space>", toggle_selected)
        # Delete key acts as the "Clear Selected" button (commit marked rows).
        tree.bind("<Delete>", lambda e: clear_selected_and_close())

        helper = tk.Label(win, text="Tip: double-click a row or press Space to toggle Clear Yes/No.", font=("Segoe UI", 9), fg=_FG_DIM)
        helper.pack(anchor="w", padx=12, pady=(0, 6))

        btns = tk.Frame(win)
        btns.pack(fill="x", padx=12, pady=(0, 12))
        tk.Button(btns, text="Select Auto Only", command=select_auto, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Select All", command=select_all, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Select None", command=select_none, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Skip Marking Complete", command=skip_mark_complete_and_close, width=22).pack(side="right", padx=4)
        tk.Button(btns, text="Keep All", command=keep_all_and_close, width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Clear All", command=clear_all_and_close, width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Clear Selected", command=clear_selected_and_close, width=16).pack(side="right", padx=4)

        try:
            win.lift()
            win.focus_force()
        except Exception:
            pass
        self.root.wait_window(win)

        if result.get("skip_complete"):
            return None
        return result["keys"] if result["keys"] is not None else set()

    def cancel_selected_tracking_items(self, keys_to_cancel, reason="Cancelled when email marked Completed"):
        """Cancel selected follow-up/tracking records by collection/index key."""
        if not keys_to_cancel:
            return 0
        now_iso = datetime.now().isoformat()
        cancelled = 0
        collections = {
            "followups": getattr(self, "followups", []),
            "scenario_reminders": getattr(self, "scenario_reminders", []),
            # v3.8.30: was missing. collect_active_tracking_items_for_emails now emits
            # "commitment_reminders"-keyed rows, so this map must resolve that collection
            # or those rows would silently never cancel even though the dialog reported them.
            "commitment_reminders": getattr(self, "commitment_reminders", []),
            "pending_reply_checks": getattr(self, "pending_reply_checks", []),
        }
        for collection_name, index in keys_to_cancel:
            items = collections.get(collection_name) or []
            try:
                item = items[index]
            except Exception:
                continue
            if not isinstance(item, dict):
                continue
            if item.get("completed") or item.get("cancelled"):
                continue
            item["cancelled"] = True
            item["cancelled_at"] = now_iso
            item["cancel_reason"] = reason
            # v4.2.19: take the Outlook calendar twin with it. This is the shared
            # programmatic cancel -- delete, auto-archive, completion review all land here
            # -- and it was the single largest source of the 479 orphaned appointments.
            self._enqueue_outlook_reminder_cancel(item)
            cancelled += 1

        if cancelled:
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_pending_reply_checks()
        return cancelled

    def cancel_automatic_tracking_for_email(self, email, reason="Email marked Completed"):
        """
        Stop automatic tracking for a completed email without touching manual follow-ups.

        Preserved:
        - self.followups created from the Setup / Edit Follow Up window

        Cancelled:
        - scenario_reminders such as vendor no-response, customer PO, AI review reminders
        - pending_reply_checks created after MaINbox opens a draft and waits for Sent Items
        - commitment_reminders (promised dates / reply-needed)  # v3.8.31
        """
        if not email:
            return 0

        entry_id = email.get("entry_id", "")
        conversation_id = email.get("conversation_id", "")
        now_iso = datetime.now().isoformat()
        cancelled = 0

        for item in getattr(self, "scenario_reminders", []):
            if item.get("completed") or item.get("cancelled"):
                continue
            same_entry = entry_id and item.get("entry_id") == entry_id
            same_conversation = conversation_id and item.get("conversation_id") == conversation_id
            if same_entry or same_conversation:
                item["cancelled"] = True
                item["cancelled_at"] = now_iso
                item["cancel_reason"] = reason
                cancelled += 1

        for item in getattr(self, "pending_reply_checks", []):
            if item.get("completed") or item.get("cancelled"):
                continue
            same_entry = entry_id and item.get("entry_id") == entry_id
            same_conversation = conversation_id and item.get("conversation_id") == conversation_id
            if same_entry or same_conversation:
                item["cancelled"] = True
                item["cancelled_at"] = now_iso
                item["cancel_reason"] = reason
                cancelled += 1

        # v3.8.31: also cancel commitment reminders (promised dates / reply-needed) for
        # this email. This helper is currently unused, but the completion-review path now
        # handles commitment reminders, and leaving this one incomplete would be a trap if
        # any future code routes mark-complete through here.
        for item in getattr(self, "commitment_reminders", []) or []:
            if item.get("completed") or item.get("cancelled"):
                continue
            same_entry = entry_id and item.get("entry_id") == entry_id
            same_conversation = conversation_id and item.get("conversation_id") == conversation_id
            if same_entry or same_conversation:
                item["cancelled"] = True
                item["cancelled_at"] = now_iso
                item["cancel_reason"] = reason
                cancelled += 1

        # Keep user-created/manual follow-ups visible. Only clear the display if
        # there is no active manual follow-up still scheduled for this email.
        if entry_id and not self.get_active_followup_for_email(entry_id):
            email["followup_time"] = ""

        return cancelled

    def selected_workflow_values_differ(self, selected_emails, category, urgency, status, email_type):
        """True when the edit controls differ from the selected row data.

        This is used before Refresh and by dropdown auto-save so a user's manual
        urgency/status/category choice cannot be lost by re-rendering older saved
        data from Outlook/cache.
        """
        try:
            for email in selected_emails or []:
                if category and category != email.get("category", ""):
                    return True
                if urgency and urgency != email.get("urgency", ""):
                    return True
                if status and status != email.get("status", ""):
                    return True
                # v4.2.45: blank type is "no change", not a difference -- otherwise
                # the multi-select blank would trigger an auto-save on every selection.
                if email_type and email_type != normalize_email_type_code(email.get("email_type", "")):
                    return True
            return False
        except Exception:
            return False

    def auto_save_selected_workflow_change(self, event=None):
        """Immediately persist dropdown workflow edits made by the user.

        Previously the combobox could show a new urgency while the durable record
        still held the old urgency until Apply/Save was clicked. A subsequent
        Refresh then reloaded the old durable value, making it look like the
        manual urgency change was ignored.
        """
        if getattr(self, "_loading_selected_workflow_fields", False):
            return
        if getattr(self, "_auto_saving_workflow_fields", False):
            return
        try:
            selected = self.get_selected_emails(show_warning=False)
            if not selected:
                return
            new_category = self.category_var.get()
            new_urgency = self.urgency_var.get()
            new_status = self.status_var.get()
            new_email_type = normalize_email_type_code(getattr(self, "email_type_var", tk.StringVar()).get())
            if not self.selected_workflow_values_differ(selected, new_category, new_urgency, new_status, new_email_type):
                return
            self._auto_saving_workflow_fields = True
            self.save_selected_changes(autosave=True)
        finally:
            self._auto_saving_workflow_fields = False

    def save_pending_selected_workflow_edits_before_refresh(self):
        """Commit unsaved visible workflow edits before importing/re-rendering refresh data."""
        try:
            if getattr(self, "_loading_selected_workflow_fields", False):
                return False
            selected = self.get_selected_emails(show_warning=False)
            if not selected:
                return False
            new_category = self.category_var.get()
            new_urgency = self.urgency_var.get()
            new_status = self.status_var.get()
            new_email_type = normalize_email_type_code(getattr(self, "email_type_var", tk.StringVar()).get())
            if not self.selected_workflow_values_differ(selected, new_category, new_urgency, new_status, new_email_type):
                return False
            return bool(self.save_selected_changes(autosave=True))
        except Exception:
            return False

    def save_selected_changes(self, autosave=False):
        selected_emails = self.get_selected_emails(show_warning=not autosave)
        if not selected_emails:
            return False
        new_category = self.category_var.get()
        new_urgency = self.urgency_var.get()
        new_status = self.status_var.get()
        new_email_type = normalize_email_type_code(getattr(self, "email_type_var", tk.StringVar()).get())
        if autosave and not self.selected_workflow_values_differ(selected_emails, new_category, new_urgency, new_status, new_email_type):
            return False
        self.save_undo_state("save selected email changes")
        vendor_reminders_scheduled = 0
        followups_cancelled = 0
        marking_done = (
            new_status == "Completed"
            or new_urgency == "Low"
            or new_category == "Junk / Ignore"
        )
        tracking_keys_to_cancel = set()
        kept_tracking_entry_ids = set()
        if marking_done:
            # If this email has any active follow-up/tracking items, let the user
            # choose exactly what to clear. Auto items are selected by default;
            # manual follow-ups are shown but preserved unless selected.
            tracking_rows_before_review = self.collect_active_tracking_items_for_emails(selected_emails)
            tracking_keys_to_cancel = self.review_tracking_items_before_complete(selected_emails)
            if tracking_keys_to_cancel is None:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, "Mark Complete skipped. No email status or follow-ups were changed.")
                return
            for row in tracking_rows_before_review:
                if row.get("key") in tracking_keys_to_cancel:
                    continue
                tracked_email = row.get("email") or {}
                tracked_entry_id = tracked_email.get("entry_id", "")
                if tracked_entry_id:
                    kept_tracking_entry_ids.add(tracked_entry_id)
        _guard_changed = False
        with self._bulk_write():
            for email in selected_emails:
                original_urgency = email.get("urgency", "Normal")
                entry_id = email.get("entry_id", "")
                _was_closed = self.workflow_record_is_closed(email) or self.workflow_record_is_closed(self.status_data.get(entry_id, {})) or bool(self._find_closed_email_guard(email, self.status_data.get(entry_id, {})))
                email["category"] = new_category
                # If the user marks an email Completed but chooses to keep any active
                # follow-up/tracking item, preserve the current urgency so it does not
                # get pushed into Low/hidden just because completion was applied.
                # v4.2.29: only fall back to the ORIGINAL urgency when the user did not
                # actually pick one. Reported: "I have set the urgency to low multiple times
                # and tried setting it to low and complete and they keep flipping back."
                # Marking Completed while keeping a tracking item threw the user's chosen
                # urgency away and restored the previous value -- so Low + Completed
                # together could never stick, which is exactly the combination that was
                # tried repeatedly. The guard exists to stop completion PUSHING a row into
                # Low; it must not overwrite a Low the user asked for.
                if (new_status == "Completed" and entry_id in kept_tracking_entry_ids
                        and not str(new_urgency or "").strip()):
                    email["urgency"] = original_urgency
                else:
                    email["urgency"] = new_urgency
                email["status"] = new_status
                # v4.2.45: blank Type = keep this email's existing type (the
                # multi-select bulk-edit contract). Only an explicit pick applies.
                if new_email_type:
                    email["email_type"] = new_email_type
                email["is_new_import"] = False
                # v3.9.46: a manual workflow edit is the user's explicit decision. Mark the email
                # AI-settled and user-locked so the background drip / 12h re-triage can never
                # overwrite it, and so it survives a refresh (which rebuilds rows from status_data).
                email["ai_triaged_at"] = email.get("ai_triaged_at") or datetime.now().isoformat()
                email["ai_triage_pending"] = False
                email["ai_user_locked"] = True
                if _was_closed and not marking_done:
                    email["explicit_reopened_at"] = datetime.now().isoformat()
                    email["workflow_closed_at"] = ""
                    if self.clear_closed_email_guard(email, save=False):
                        _guard_changed = True
                # v4.2.29: STAMP BEFORE SAVING. learn_from_user_correction writes the
                # v4.2.28 user_buried_at mark onto the email dict, but it ran AFTER
                # save_record had already copied the row into status_data -- so the mark
                # never persisted and every row still showed user_buried_at=None. Same
                # save-before-mutate ordering bug as v4.2.23's RFQ cache.
                self.learn_from_user_correction(email, new_category, new_urgency, new_status)
                self.save_record(email)
                if new_status == "Waiting on Vendor":
                    if self.schedule_vendor_no_response_reminder(email):
                        vendor_reminders_scheduled += 1
                # Marking an email Completed/Low/Junk now opens a review popup when
                # related tracking exists. Only the rows selected in that popup are cleared.
            if marking_done and tracking_keys_to_cancel:
                cancel_reason = f"Cancelled from completion review: email marked {new_status or new_category}"
                followups_cancelled += self.cancel_selected_tracking_items(tracking_keys_to_cancel, cancel_reason)
                for email in selected_emails:
                    eid = email.get("entry_id", "")
                    if eid and not self.get_active_followup_for_email(eid):
                        email["followup_time"] = ""
            if _guard_changed:
                self._save_closed_email_guard()
        self.flush_status_data()
        self.sort_emails_for_display()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        self.save_cached_state()
        self.preview_text.delete("1.0", tk.END)
        extra = f"\n\nVendor no-response reminder scheduled for {vendor_reminders_scheduled} email(s)." if vendor_reminders_scheduled else ""
        cancelled_note = f"\nCancelled {followups_cancelled} active follow-up(s)." if followups_cancelled else ""
        self.preview_text.insert(tk.END, f"Saved changes to {len(selected_emails)} selected email(s).{extra}{cancelled_note}")
        ops_log("bulk", "save_selected", n=len(selected_emails),
                cat=str(new_category or ""), urg=str(new_urgency or ""),
                stat=str(new_status or ""), etype=str(new_email_type or ""))
        # v4.1.55: first-time offer -- remember this manually chosen type for the sender(s).
        try:
            if new_email_type:
                self._offer_save_contact_type(selected_emails, new_email_type)
        except Exception:
            pass
        return True

    def get_sender_email(self, msg):
        try:
            sender = msg.SenderEmailAddress or ""
            if sender:
                return sender
        except Exception:
            pass
        try:
            sender = msg.Sender.GetExchangeUser().PrimarySmtpAddress
            if sender:
                return sender
        except Exception:
            pass
        return ""

    def generate_reply_text(self, email, prefer_ai=True):
        fallback = get_followup_message(email.get("category", "General"))
        if not prefer_ai:
            return fallback
        body = self.load_body_if_needed(email)
        ai_result = ask_ollama_for_reply(
            subject=email.get("subject", ""), sender=email.get("sender", ""), body=body,
            category=email.get("category", "General"), urgency=email.get("urgency", "Normal"),
            status=email.get("status", "New")
        )
        if ai_result:
            text = ai_result.get("text") if isinstance(ai_result, dict) else ai_result
            total_ns = ai_result.get("total_duration") if isinstance(ai_result, dict) else None
            load_ns = ai_result.get("load_duration") if isinstance(ai_result, dict) else None
            if total_ns:
                total_s = total_ns / 1_000_000_000
                load_s = (load_ns or 0) / 1_000_000_000
                self.ai_status_var.set(f"AI: Ollama {total_s:.1f}s / load {load_s:.1f}s")
            else:
                self.ai_status_var.set("AI: used Ollama")
            return text
        self.ai_status_var.set("AI: template fallback")
        return fallback

    def force_mainbox_window_to_front(self, window=None, restore_root=True):
        """v3.9.60: reliably restore + foreground a MaINbox window (the main window or one of
        its popups), even when MaINbox is MINIMIZED.

        Tk's lift()/focus_force() alone do not reliably pull a minimized window back under
        Windows' foreground-lock rules -- which is why a reminder popup that appeared while
        MaINbox was minimized could only be recovered via Task Manager -> "Bring to front",
        not by clicking the taskbar button. This mirrors the Win32 AttachThreadInput +
        SetForegroundWindow technique already used for the Outlook inspector in
        bring_outlook_inspector_to_front(). Reminder/alert popups are transient(self.root), so
        if the main window is iconified the popup is hidden too; we restore the main window
        first, then foreground the popup. Everything is best-effort and guarded, so it is a
        no-op (falling back to lift/focus) if win32 is unavailable."""
        target = window or self.root

        def _tk_restore(w):
            # Map an iconified window back so it (and its transient children) can be shown.
            try:
                if w is self.root or str(w.wm_state()) == "iconic":
                    w.deiconify()
            except Exception:
                pass
            try:
                w.state("normal")
            except Exception:
                pass
            try:
                w.lift()
            except Exception:
                pass

        if restore_root:
            _tk_restore(self.root)
        _tk_restore(target)
        try:
            target.update_idletasks()
        except Exception:
            pass

        def _hwnd_for(w):
            if not win32gui:
                return None
            hwnd = None
            try:
                child = w.winfo_id()
                try:
                    parent = win32gui.GetParent(child)
                except Exception:
                    parent = None
                hwnd = parent or child
            except Exception:
                hwnd = None
            if not hwnd:
                try:
                    hwnd = win32gui.FindWindow(None, w.title())
                except Exception:
                    hwnd = None
            return hwnd

        def _force_front(hwnd):
            if not hwnd or not win32gui or not win32con:
                return False
            try:
                if ctypes:
                    try:
                        ctypes.windll.user32.AllowSetForegroundWindow(-1)
                    except Exception:
                        pass
                try:
                    win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
                except Exception:
                    try:
                        win32gui.ShowWindow(hwnd, win32con.SW_SHOWNORMAL)
                    except Exception:
                        pass

                # Temporarily attach input threads -- the standard workaround for Windows'
                # focus-stealing prevention so SetForegroundWindow actually takes effect.
                attached = False
                fg_thread = target_thread = current_thread = None
                if win32process and ctypes:
                    try:
                        fg_hwnd = win32gui.GetForegroundWindow()
                        fg_thread, _ = win32process.GetWindowThreadProcessId(fg_hwnd)
                        target_thread, _ = win32process.GetWindowThreadProcessId(hwnd)
                        current_thread = ctypes.windll.kernel32.GetCurrentThreadId()
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, True)
                                attached = True
                    except Exception:
                        attached = False

                try:
                    win32gui.BringWindowToTop(hwnd)
                except Exception:
                    pass
                try:
                    win32gui.SetWindowPos(hwnd, win32con.HWND_TOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                    win32gui.SetWindowPos(hwnd, win32con.HWND_NOTOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                except Exception:
                    pass
                ok = False
                try:
                    ok = bool(win32gui.SetForegroundWindow(hwnd))
                except Exception:
                    ok = False
                try:
                    win32gui.SetFocus(hwnd)
                except Exception:
                    pass

                if attached and win32process and ctypes:
                    try:
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, False)
                    except Exception:
                        pass
                return ok
            except Exception:
                return False

        # Restore the main window (its taskbar button) first, then the popup itself.
        if restore_root and target is not self.root:
            _force_front(_hwnd_for(self.root))
        _force_front(_hwnd_for(target))

        # Final Tk nudge so focus visibly lands on the popup.
        try:
            target.lift()
            target.focus_force()
        except Exception:
            pass

    def bring_outlook_inspector_to_front(self, item, attempts=10, delay_ms=160):
        """Try Outlook Activate plus Win32 foreground handling. Windows may still block true focus, so we also raise/topmost-nudge."""
        def get_inspector_and_hwnd():
            inspector = None
            hwnd = None
            try:
                inspector = item.GetInspector
            except Exception:
                inspector = None
            try:
                active = self.outlook.ActiveInspector() if self.outlook else None
                if active:
                    inspector = active
            except Exception:
                pass
            if inspector:
                try:
                    inspector.Activate()
                except Exception:
                    pass
                try:
                    hwnd = int(inspector.HWND)
                except Exception:
                    hwnd = None
            return inspector, hwnd

        def force_hwnd_front(hwnd):
            if not hwnd or not win32gui or not win32con:
                return False
            try:
                if ctypes:
                    try:
                        ctypes.windll.user32.AllowSetForegroundWindow(-1)
                    except Exception:
                        pass
                try:
                    win32gui.ShowWindow(hwnd, win32con.SW_SHOWNORMAL)
                except Exception:
                    win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)

                # Temporarily attach input threads. This is the common workaround for Windows focus rules.
                attached = False
                fg_thread = target_thread = current_thread = None
                if win32process and ctypes:
                    try:
                        fg_hwnd = win32gui.GetForegroundWindow()
                        fg_thread, _ = win32process.GetWindowThreadProcessId(fg_hwnd)
                        target_thread, _ = win32process.GetWindowThreadProcessId(hwnd)
                        current_thread = ctypes.windll.kernel32.GetCurrentThreadId()
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, True)
                                attached = True
                    except Exception:
                        attached = False

                try:
                    win32gui.BringWindowToTop(hwnd)
                except Exception:
                    pass
                try:
                    win32gui.SetWindowPos(hwnd, win32con.HWND_TOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                    win32gui.SetWindowPos(hwnd, win32con.HWND_NOTOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                except Exception:
                    pass
                ok = False
                try:
                    ok = bool(win32gui.SetForegroundWindow(hwnd))
                except Exception:
                    ok = False
                try:
                    win32gui.SetFocus(hwnd)
                except Exception:
                    pass

                if attached and win32process and ctypes:
                    try:
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, False)
                    except Exception:
                        pass
                return ok
            except Exception:
                return False

        def attempt(remaining):
            try:
                try:
                    self.root.attributes("-topmost", False)
                    self.root.lower()
                except Exception:
                    pass
                inspector, hwnd = get_inspector_and_hwnd()
                if hwnd:
                    force_hwnd_front(hwnd)
            except Exception:
                pass
            if remaining > 0:
                try:
                    self.root.after(delay_ms, lambda: attempt(remaining - 1))
                except Exception:
                    pass

        attempt(attempts)

    def display_outlook_item_foreground(self, item):
        """Display an Outlook item and strongly nudge its inspector window to the front."""
        try:
            # Make sure the monitor itself is not marked topmost over Outlook.
            try:
                self.root.attributes("-topmost", False)
            except Exception:
                pass
            item.Display()
        except Exception:
            return
        self.bring_outlook_inspector_to_front(item)

    def _regroup_existing_sent_rfq_trackers(self):
        """v3.9.97: one-time backfill. Run the (now deterministic) tracker->group resolver over
        sent-waiting trackers that are STILL ungrouped, so vendor RFQs you sent before this
        version -- the loose 'P&A -' rows -- file under their group on first launch instead of
        only newly-sent ones. Flag-gated so it runs once; additive (the resolver never moves an
        already-grouped row and only groups on a confident recipient/subject match against a
        real persisted group), so it cannot scatter rows you've filed by hand."""
        try:
            if not isinstance(getattr(self, "groups_data", None), dict):
                return
            if self.groups_data.get("rfq_tracker_regroup_done"):
                return
            memberships = self.groups_data.get("memberships", {}) or {}
            for ph in list(getattr(self, "sent_waiting_placeholders", []) or []):
                if not isinstance(ph, dict):
                    continue
                pid = ph.get("entry_id", "")
                if not pid or ph.get("cleared") or memberships.get(pid):
                    continue
                try:
                    self._link_sent_tracker_to_request_group(ph)
                except Exception:
                    pass
            self.groups_data["rfq_tracker_regroup_done"] = True
            self.save_groups()
        except Exception:
            pass

    def _group_id_from_sent_rfq_record(self, placeholder):
        """v3.9.97: file a sent vendor-RFQ tracker under the group it was sent FOR, using the
        record Quote RFQ writes at send time. When you 'Send RFQs Now', the send is appended to
        quote_requests carrying the group_id, the subject, and the vendor recipients -- so this
        matches the tracker to that send by recipient + subject and returns the group_id. That
        makes the 'P&A -' vendor RFQs group by construction (no fragile subject-token guessing),
        and because the tracker then shares the vendor reply's Outlook conversation, the v3.9.96
        group-ledger flip routes that vendor's quote to the right ledger automatically.

        Deterministic and conservative: requires a real (persisted) group AND a positive signal
        -- the recipient is one of that send's vendors, or the subject matches distinctively.
        Returns '' (leave it for the existing resolvers / manual filing) when nothing lines up.
        Most-recent send wins so a re-send to a new job takes precedence."""
        try:
            if not isinstance(placeholder, dict):
                return ""
            recip = str(placeholder.get("sender_email", "") or placeholder.get("sender", "") or "").lower().strip()
            psubj = normalize_subject_for_match(placeholder.get("subject", "") or "")
            if not recip and not psubj:
                return ""
            real_ids = {g.get("id") for g in (self.groups_data.get("groups", []) or [])
                        if isinstance(g, dict) and g.get("id")}
            for qrec in reversed(self.quote_requests or []):   # most-recent send first
                if not isinstance(qrec, dict):
                    continue
                gid = str(qrec.get("group_id", "") or "")
                if not gid or gid not in real_ids:
                    continue
                qsubj = normalize_subject_for_match(qrec.get("subject", "") or "")
                vendor_emails = {str((v or {}).get("email", "") or "").lower().strip()
                                 for v in (qrec.get("vendors", []) or []) if isinstance(v, dict)}
                vendor_emails.discard("")
                subj_ok = (not psubj) or (not qsubj) or (psubj == qsubj)
                recip_in = bool(recip and vendor_emails and recip in vendor_emails)
                subj_strong = bool(psubj and qsubj and psubj == qsubj and len(psubj) >= 8)
                if subj_ok and (recip_in or subj_strong):
                    return gid
            return ""
        except Exception:
            return ""

    def _link_sent_tracker_to_request_group(self, placeholder):
        """v3.9.89: keep a sent/waiting tracker in the same group as the request it came from, so the
        original customer request, the tracker, and (later) the vendor reply all stay together.

        Strictly additive and non-destructive: it only sets a group membership when one is missing,
        never moves an already-grouped item (including a manual choice), and leaves the tracker
        ungrouped for the user to file by hand when nothing matches confidently.

        Resolution order:
          1. the email this tracker was sent in reply to (tracked_entry_id) -- its group/thread/job key
          2. the tracker's own Outlook thread already filed in a group
          3. a confident job/PO/project key match (find_group_id_by_business_key) -- the
             'customer name + job name/#' path for sends made directly from Outlook
        If a concrete originating request EMAIL is found but neither it nor the tracker is grouped
        yet, create one group named from the request subject and put both in it.
        """
        try:
            if not isinstance(placeholder, dict):
                return
            pid = placeholder.get("entry_id", "")
            if not pid:
                return
            memberships = self.groups_data.setdefault("memberships", {})
            existing_gid = memberships.get(pid, "")
            if existing_gid and self.get_group_by_id(existing_gid):
                return  # already grouped -- never override

            target_gid = ""
            request_email = None

            # 1) MaINbox path: the email this tracker was sent in reply to.
            tracked_id = placeholder.get("tracked_entry_id", "")
            if tracked_id:
                request_email = self.get_email_by_id(tracked_id)
                target_gid = memberships.get(tracked_id, "")
                if not target_gid and request_email:
                    target_gid = (self.find_group_id_for_thread(request_email, skip_entry_id=pid)
                                  or self.find_group_id_by_business_key(request_email))

            # 1b) v3.9.97: the RFQ you actually sent. Quote RFQ records each send in
            #     quote_requests with its group_id + subject + vendor recipients, so a sent
            #     vendor-RFQ tracker (no tracked_entry_id back to the customer request, and a
            #     "P&A -" subject the token matcher won't catch) files under its group directly.
            if not target_gid:
                target_gid = self._group_id_from_sent_rfq_record(placeholder)

            # 2) The tracker's own Outlook thread already filed in a group.
            if not target_gid:
                target_gid = self.find_group_id_for_thread(placeholder, skip_entry_id=pid)

            # 3) Outlook path: a confident job/PO/# key match to an existing group.
            if not target_gid:
                target_gid = self.find_group_id_by_business_key(placeholder)

            # 3b) Outlook path with no existing group yet: locate the originating request email
            #     by shared job key so we can pair them into a fresh group below.
            if not target_gid and request_email is None:
                request_email = self._find_request_email_for_tracker(placeholder)

            # Join an existing group when we found one.
            if target_gid and self.get_group_by_id(target_gid):
                memberships[pid] = target_gid
                self.save_groups()
                return

            # No existing group, but we have a concrete originating request -> create one for the pair.
            if request_email and request_email.get("entry_id"):
                req_id = request_email.get("entry_id", "")
                req_gid = memberships.get(req_id, "")
                if req_gid and self.get_group_by_id(req_gid):
                    memberships[pid] = req_gid
                    self.save_groups()
                    return
                name = (str(request_email.get("subject", "") or "")
                        or str(placeholder.get("subject", "") or "") or "Quote Job").strip()[:80]
                new_gid = self._unique_group_id()  # v4.1.10: collision-proof
                self.groups_data.setdefault("groups", []).append({
                    "id": new_gid, "name": name, "urgency": "Normal", "collapsed": False,
                    "has_new": False, "created_at": datetime.now().isoformat(), "notes": "",
                    "archived": False, "auto_created_reason": "sent_tracker_request_pairing"})
                memberships[req_id] = new_gid
                memberships[pid] = new_gid
                self.save_groups()
        except Exception:
            pass

    # ============ v4.1.38 PO-AWARD DETECTION ============
    def _po_award_enabled(self):
        """True when PO-award detection should run: the engine is available and both
        gates are on. Fail-safe -- a missing engine simply disables the feature."""
        try:
            if not (PO_MATCH_ENGINE_AVAILABLE and _PO_MATCH_ENGINE is not None):
                return False
            if not bool(self.settings.get("po_match_engine_enabled", True)):
                return False
            if not bool(self.settings.get("auto_po_award_detection", True)):
                return False
            return True
        except Exception:
            return False

    def _build_open_jobs_for_po_match(self):
        """Assemble the list of ACTIVE, unresolved Quote Coverage jobs as OpenJob
        records the PO engine can score against. v4.1.39: excludes jobs that are
        already awarded, archived, or dismissed (they should not win a new PO or dilute
        the correct match), and STRUCTURALLY populates each job's quote/job/PO numbers
        (extracted from the group name, subject, original-request subject, and RFQ
        cache text) so the engine's strongest signal -- the seller quote number --
        matches reliably even when it is not sitting in a loose text field.

        Pure read of in-memory state; safe on the worker thread."""
        jobs = []
        try:
            threads = (getattr(self, "quote_coverage", {}) or {}).get("threads", {}) or {}
            groups_by_id = {}
            for g in (self.groups_data.get("groups", []) or []):
                if isinstance(g, dict) and g.get("id"):
                    groups_by_id[str(g["id"])] = g
            rfq_records = (getattr(self, "rfq_cache", {}) or {}).get("records", {}) or {}
            for tkey, rec in threads.items():
                if not isinstance(rec, dict):
                    continue
                # v4.1.39a: LIFECYCLE-AWARE candidacy. Excluding every job that has
                # any PO breaks change orders / partial releases / revised POs, which
                # legitimately arrive after the first PO. So:
                #   - dismissed  -> excluded (user rejected the job)
                #   - archived and never awarded -> excluded from the general pool
                #     (only reachable by an explicit quote/PO-number reference)
                #   - awarded / po_received -> KEPT as a candidate so a later PO can
                #     match, flagged prior_po so the engine applies a mild penalty and
                #     never treats it as a fresh fully-open job.
                if rec.get("dismissed"):
                    continue
                requested = rec.get("requested", []) or []
                if not requested:
                    continue  # nothing outstanding to award against
                gid = str(rec.get("group_id", "") or "")
                if not gid and str(tkey).startswith("grp:"):
                    gid = str(tkey)[4:]
                grp = groups_by_id.get(gid, {})
                _already_po = bool(rec.get("po_received") or rec.get("awarded"))
                if grp and grp.get("archived") and not _already_po:
                    continue
                # Free-text the job is known by (group name + subjects + RFQ text).
                _rfq_text = ""
                try:
                    if gid:
                        _rfq_rec = rfq_records.get("grp:" + gid, {}) or rfq_records.get(gid, {})
                        if isinstance(_rfq_rec, dict):
                            # v4.1.39a: read the fields record_rfq_cache actually stores
                            # (subject/body/quote_text) -- the prior code read
                            # quote_number/body_preview, which are never written.
                            _rfq_text = " ".join(str(_rfq_rec.get(k, "") or "")
                                                 for k in ("subject", "quote_text", "body"))[:4000]
                except Exception:
                    _rfq_text = ""
                text_parts = [
                    str(rec.get("subject", "") or ""),
                    str(grp.get("name", "") or ""),
                    str(rec.get("original_request_subject", "") or ""),
                    _rfq_text,
                ]
                job_text = "\n".join(t for t in text_parts if t)
                # Structured identifiers: any explicitly stored on the record, plus
                # everything extractable from the job's known text.
                q_nums = list(rec.get("customer_quote_numbers", []) or [])
                p_nums = list(rec.get("po_numbers", []) or [])
                j_nums = list(rec.get("job_numbers", []) or [])
                try:
                    q_nums += extract_quote_numbers(job_text)
                    p_nums += extract_po_numbers(job_text)
                    j_nums += extract_job_numbers(job_text)
                except Exception:
                    pass
                # Requested item parts/descriptions.
                parts = []
                descs = []
                for it in requested:
                    if not isinstance(it, dict):
                        continue
                    pn = str(it.get("part_number", "") or "").strip()
                    if pn:
                        parts.append(pn)
                    dd = str(it.get("description", "") or "").strip()
                    if dd:
                        descs.append(dd)
                label = str(rec.get("subject", "") or grp.get("name", "") or gid or tkey)[:90]
                jobs.append(OpenJob(
                    job_id=str(tkey),
                    label=label,
                    text=job_text,
                    customer_email=str(rec.get("customer_email", "") or ""),
                    quote_numbers=tuple(dict.fromkeys(q_nums)),
                    po_numbers=tuple(dict.fromkeys(p_nums)),
                    job_numbers=tuple(dict.fromkeys(j_nums)),
                    requested_parts=tuple(parts),
                    requested_descriptions=tuple(descs),
                    prior_po=_already_po,
                ))
        except Exception:
            return []
        return jobs

    def _detect_and_queue_customer_po(self, msg, entry_id, store_id, subject, body,
                                      fresh_text, sender_email, sender_name,
                                      durable_type, namespace, imid_key=""):
        """Worker-thread PO detection for ONE attachment-bearing customer/unknown
        message. Reads the attachment text, asks the PO-match engine to classify +
        match it to an open job, and records the result DURABLY so a confident match
        pops up and an ambiguous/unmatched PO still surfaces for review. Returns True
        when this message is a recognized PURCHASE ORDER so the caller stops treating
        it as a possible request.

        v4.1.39: the previous version queued only MATCH (in an in-memory list) and
        returned True for REVIEW too -- so a recognized-but-unmatched PO was
        checkpointed and lost. Now every recognized PO (MATCH, REVIEW, or unmatched)
        is written to a PERSISTED review queue keyed by durable source identity
        BEFORE the caller checkpoints the message. A crash/restart cannot lose it,
        and a second distinct PO for the same job is kept (dedupe is by source, not
        by job)."""
        try:
            # Read the attachment text once (best-effort; a failed read yields "").
            _att_read_failed = False
            try:
                _att_text = self._attachment_quote_text_from_msg(msg)
                if not isinstance(_att_text, str):
                    _att_text = str(_att_text[0]) if isinstance(_att_text, (list, tuple)) and _att_text else ""
            except Exception:
                _att_text = ""
                _att_read_failed = True
            # v4.1.39a: a message whose BODY explicitly says a PO is attached but whose
            # attachment produced no text is an UNREADABLE PO candidate, not a decided
            # non-PO. Signal a retry so the caller does NOT permanently checkpoint it;
            # a transient extraction/OCR failure must not lose a real PO.
            _body_low = f"{subject}\n{fresh_text}".lower()
            _po_attached_claim = bool(re.search(
                r"\b(?:po|p\.?o\.?|purchase\s+order)\s+(?:is\s+)?attach|attached\s+(?:is\s+)?(?:the\s+)?(?:po|p\.?o\.?|purchase\s+order)\b",
                _body_low))
            _has_attach = False
            try:
                _has_attach = bool(getattr(msg, "Attachments", None)) and msg.Attachments.Count > 0
            except Exception:
                _has_attach = False
            if not _att_text and _po_attached_claim and _has_attach:
                # Bound retries so a permanently-unreadable attachment is not re-tried
                # every scan forever. After a few attempts, fall through and let the
                # caller checkpoint it (an operator can open it manually).
                try:
                    retries = self.quote_coverage.setdefault("po_attach_retry", {})
                    if isinstance(retries, dict):
                        _rk = imid_key or ("eid:" + str(entry_id))
                        n = int(retries.get(_rk, 0)) + 1
                        retries[_rk] = n
                        if n <= 5:
                            _cov_debug(f"PO attachment unreadable, retry {n}/5: {subject!r}")
                            return "retry"
                        _cov_debug(f"PO attachment unreadable after {n} tries, giving up: {subject!r}")
                except Exception:
                    return "retry"
            elif _att_text:
                # v4.1.41: the attachment read succeeded -- drop any retry counter so
                # the bookkeeping dict does not grow forever.
                try:
                    retries = self.quote_coverage.get("po_attach_retry")
                    if isinstance(retries, dict):
                        retries.pop(imid_key or ("eid:" + str(entry_id)), None)
                except Exception:
                    pass
            # Cheap pre-gate: no attachment text AND no PO cue in the body -> not a PO,
            # skip the engine entirely (keeps the scan cheap on ordinary mail).
            if not _att_text and not re.search(
                    r"\bpurchase\s+order\b|\bp\.?\s*o\.?\s*(?:#|no\.?|number|attached)\b|\bhere\s+(?:is|are)\s+the\s+po\b",
                    _body_low):
                return False

            try:
                _own = self._own_mailbox_domains(namespace)
            except Exception:
                _own = set()
            # v4.1.39: pass STRUCTURED PO line items when we can parse them, so the
            # engine matches on real parts/descriptions rather than a raw token scan.
            _parts, _descs = self._po_structured_lines_from_text(_att_text)
            ctx = POContext(
                subject=str(subject or ""),
                body=str(fresh_text or body or ""),
                attachment_text=str(_att_text or ""),
                sender_email=str(sender_email or ""),
                sender_name=str(sender_name or ""),
                sender_type=str(durable_type or ""),
                internal_domains=tuple(_own) if _own else (),
                has_attachments=True,
                line_parts=tuple(_parts),
                line_descriptions=tuple(_descs),
            )
            open_jobs = self._build_open_jobs_for_po_match()
            verdict = _PO_MATCH_ENGINE.evaluate(ctx, open_jobs)
            if not getattr(verdict, "is_po", False):
                return False  # not a purchase order -- let the request gate proceed

            _dec = getattr(verdict, "decision", None)
            _dec_val = _dec.value if hasattr(_dec, "value") else str(_dec or "")
            _imid = imid_key.replace("imid:", "", 1) if imid_key else ""
            # Persist EVERY recognized PO to the durable review queue (deduped by
            # source identity). This must happen before the caller marks the message
            # processed, so nothing is ever silently consumed.
            _persisted = self._persist_po_review_entry(
                decision=_dec_val,
                job_id=str(getattr(verdict, "job_id", "") or ""),
                job_label=str(getattr(verdict, "job_label", "") or ""),
                entry_id=entry_id, store_id=store_id, imid=_imid,
                subject=str(subject or ""), sender=sender_name or sender_email,
                sender_email=str(sender_email or ""),
                confidence=float(getattr(verdict, "confidence", 0.0) or 0.0),
                reasons=list(getattr(verdict, "reasons", []) or []),
                po_numbers=list(getattr(verdict, "po_numbers", []) or []),
                quote_numbers=list(getattr(verdict, "quote_numbers", []) or []),
                customer_conflict=bool(getattr(verdict, "customer_conflict", False)),
                runner_up_label=str(getattr(verdict, "runner_up_label", "") or ""),
                po_lines={"parts": list(_parts), "descriptions": list(_descs),
                          "details": list(getattr(self, "_last_po_line_details", []) or [])},
            )
            if _persisted is False:
                # v4.1.42: the durable write failed -- do NOT let the caller
                # checkpoint this message. Signal retry; the next scan re-detects
                # and the src_id dedupe makes eventual success idempotent.
                _cov_debug(f"PO review persistence failed, will retry: {subject!r}")
                return "retry"
            # A confident, non-conflicting MATCH also goes into the immediate popup
            # queue so the user is prompted this session.
            if _dec_val == "match" and getattr(verdict, "job_id", "") \
                    and not getattr(verdict, "customer_conflict", False):
                self._queue_po_award_prompt_from_review(entry_id=entry_id, imid=_imid)
            else:
                _cov_debug(f"PO recognized ({_dec_val}, conflict={getattr(verdict,'customer_conflict',False)}): {subject!r} -> review queue")
            return True
        except Exception as _exc:
            _cov_debug(f"PO detect/queue error: {_exc!r}")
            return False

    def _po_structured_lines_from_text(self, att_text):
        """v4.1.39: best-effort structured line items from PO attachment text, using
        the existing material extractor. Returns (parts, descriptions). v4.1.39a also
        captures per-line quantity/unit into self._last_po_line_details so an award
        can record what was actually ordered (the data the future line-level partial-
        award UI needs). Returns ([],[]) on any failure -- the engine then falls back
        to its own token scan."""
        parts, descs = [], []
        self._last_po_line_details = []
        if not att_text:
            return parts, descs
        try:
            mats = extract_materials_from_quote_text(
                _coverage_reassemble_columnar_quote(att_text), keep_duplicates=True) or []
            for m in mats:
                if not isinstance(m, dict):
                    continue
                pn = str(m.get("part_number", "") or "").strip()
                dd = str(m.get("description", "") or "").strip()
                if pn:
                    parts.append(pn)
                if dd:
                    descs.append(dd)
                # Preserve quantity/unit for the award record (partial-PO groundwork).
                self._last_po_line_details.append({
                    "part_number": pn,
                    "description": dd,
                    "qty": str(m.get("qty", "") or m.get("quantity", "") or "").strip(),
                    "unit": str(m.get("unit", "") or m.get("uom", "") or "").strip(),
                })
        except Exception:
            self._last_po_line_details = []
            return [], []
        return parts, descs

    def _persist_po_review_entry(self, decision, job_id, job_label, entry_id, store_id,
                                 imid, subject, sender, sender_email, confidence, reasons,
                                 po_numbers, quote_numbers, customer_conflict,
                                 runner_up_label, po_lines):
        # v4.1.60 ops log wrapper: PO review-queue persistence outcomes (retry contract).
        _ok = False
        try:
            _ok = self._persist_po_review_entry_inner(decision=decision, job_id=job_id, job_label=job_label, entry_id=entry_id, store_id=store_id, imid=imid, subject=subject, sender=sender, sender_email=sender_email, confidence=confidence, reasons=reasons, po_numbers=po_numbers, quote_numbers=quote_numbers, customer_conflict=customer_conflict, runner_up_label=runner_up_label, po_lines=po_lines)
            return _ok
        finally:
            try:
                _dec = decision.get("verdict", "") if isinstance(decision, dict) else str(decision)
                ops_log("po", "review_persist", ok=bool(_ok), decision=str(_dec)[:40], job=str(job_id or ""))
            except Exception:
                pass

    def _persist_po_review_entry_inner(self, decision, job_id, job_label, entry_id, store_id,
                                 imid, subject, sender, sender_email, confidence, reasons,
                                 po_numbers, quote_numbers, customer_conflict,
                                 runner_up_label, po_lines):
        """v4.1.39: write ONE recognized PO into the DURABLE review queue at
        quote_coverage['po_review_pending']. Deduped by SOURCE identity (Message-ID,
        else EntryID, else PO#+sender fingerprint) so a second distinct PO for the
        same job is kept, but the same message is never duplicated. Persisted to the
        coverage store so a crash/restart cannot lose it. Skips anything already in
        the handled ledger."""
        try:
            if not isinstance(getattr(self, "quote_coverage", None), dict):
                return
            src_id = ("mid:" + imid.strip().lower()) if imid else (
                ("eid:" + str(entry_id)) if entry_id else "")
            if not src_id and po_numbers:
                src_id = "po:" + "|".join(sorted(po_numbers)) + ":" + str(sender_email or "").lower()
            if not src_id:
                return False
            # Already handled? Do not re-open (counts as persisted: True).
            handled = self.quote_coverage.get("po_awards_handled", []) or []
            if isinstance(handled, list):
                for h in handled:
                    if isinstance(h, dict) and h.get("src_id") == src_id:
                        return True
            pending = self.quote_coverage.setdefault("po_review_pending", [])
            if not isinstance(pending, list):
                pending = self.quote_coverage["po_review_pending"] = []
            for p in pending:
                if isinstance(p, dict) and p.get("src_id") == src_id:
                    return True  # same message already durably queued
            # v4.1.43 (external audit of v4.1.42, CRITICAL finding): the v4.1.42 body
            # wrapped save_quote_coverage() in try/except, but that method swallowed
            # its own exceptions and returned None -- so this method returned True on
            # a failed disk write and the caller checkpointed a PO whose review entry
            # was never stored. save_quote_coverage() now returns a real result, and
            # a failed save REMOVES the just-appended in-memory entry: otherwise the
            # next retry would see the in-memory duplicate at the src_id dedupe above
            # and return True, assuming it was already persisted (retry poisoning).
            _new_entry = {
                "src_id": src_id,
                "decision": decision,
                "job_id": job_id, "job_label": job_label,
                "entry_id": entry_id, "store_id": store_id, "imid": imid,
                "subject": subject, "sender": sender, "sender_email": sender_email,
                "confidence": confidence, "reasons": reasons,
                "po_numbers": po_numbers, "quote_numbers": quote_numbers,
                "customer_conflict": customer_conflict,
                "runner_up_label": runner_up_label,
                "po_lines": po_lines,
                "created_at": datetime.now().isoformat(),
            }
            with self._coverage_save_lock():
                # v4.1.44 (audit #5): restore the WHOLE list on failure, not just the
                # new entry. At the 500-entry cap the prune ran before the save, so a
                # failed save left memory one OLD entry short; a later successful save
                # of the shortened queue would have permanently dropped it from disk.
                _pending_before = list(pending)
                pending.append(_new_entry)
                if len(pending) > 500:
                    del pending[:len(pending) - 500]
                if not self.save_quote_coverage():
                    pending[:] = _pending_before
                    return False
            # Worker thread: refresh the toolbar count on the main thread (the
            # after()-from-worker pattern is this app's established cross-thread
            # signal; the callback body runs on the Tk main thread).
            try:
                self.root.after(0, self._refresh_po_review_button)
            except Exception:
                pass
            return True
        except Exception:
            return False

    def _queue_po_award_prompt_from_review(self, entry_id="", imid=""):
        """v4.1.39: mark that a confident MATCH in the durable review queue should be
        shown as a popup THIS session. The in-memory list only holds a pointer (the
        source id); the authoritative record is the persisted review entry, so a lost
        popup list never loses the PO."""
        try:
            src_id = ("mid:" + imid.strip().lower()) if imid else (("eid:" + str(entry_id)) if entry_id else "")
            if not src_id:
                return
            q = getattr(self, "_pending_po_award_prompts", None)
            if not isinstance(q, list):
                q = []
                self._pending_po_award_prompts = q
            if src_id not in q:
                q.append(src_id)
        except Exception:
            pass

    def _make_po_review_button(self, parent, grp):
        """Build the 'PO Review (N)' toolbar button and keep a reference so its label
        can reflect the live count of POs awaiting review."""
        try:
            n = self._po_review_pending_count()
        except Exception:
            n = 0
        label = f"PO Review ({n})" if n else "PO Review"
        btn = grp(parent, label, self._open_po_review_window)
        self._po_review_button = btn
        return btn

    def _refresh_po_review_button(self):
        """Update the PO Review button label to the current pending count. Safe to
        call from the main thread after a scan or after the review window closes."""
        try:
            btn = getattr(self, "_po_review_button", None)
            if btn is None:
                return
            n = self._po_review_pending_count()
            btn.config(text=(f"PO Review ({n})" if n else "PO Review"))
        except Exception:
            pass

    def _po_review_pending_count(self):
        """Number of PO review entries awaiting a human decision (all decisions --
        match/review/unmatched/conflict). Drives the 'PO Review (N)' button label."""
        try:
            pending = (getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or []
            return len([p for p in pending if isinstance(p, dict)])
        except Exception:
            return 0

    def _open_po_review_window(self):
        """v4.1.39a: a visible window that DRAINS the durable PO review queue --
        the piece that makes po_review_pending usable. Lists every recognized PO
        (confident match, ambiguous review, customer conflict, and unmatched),
        shows its top candidate job and why, and lets the user act per row:
        Apply to the matched job, Choose another job, Open the source email, or
        Dismiss. Confident non-conflict matches also flow through here so nothing
        is action-only via the transient popup."""
        try:
            pending = list((getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or [])
        except Exception:
            pending = []
        win = tk.Toplevel(self.root)
        win.title(f"PO Review ({len(pending)})")
        win.configure(bg=_BG)
        win.geometry("880x520")
        try:
            win.transient(self.root)
        except Exception:
            pass

        header = tk.Label(win, bg=_BG, fg=_FG, justify="left", anchor="w",
                          text=("Purchase orders detected from incoming mail. Review each and choose an "
                                "action.\nApply records the PO against the job (customer award, kept "
                                "separate from vendor coverage)."))
        header.pack(fill="x", padx=12, pady=(10, 6))

        body = tk.Frame(win, bg=_BG)
        body.pack(fill="both", expand=True, padx=12, pady=(0, 8))

        cols = ("status", "po", "customer", "job", "conf")
        tree = ttk.Treeview(body, columns=cols, show="headings", height=14)
        for c, w, txt in (("status", 90, "Status"), ("po", 130, "PO #"),
                          ("customer", 200, "From"), ("job", 300, "Matched job"),
                          ("conf", 60, "Conf")):
            tree.heading(c, text=txt)
            tree.column(c, width=w, anchor="w")
        vs = ttk.Scrollbar(body, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=vs.set)
        tree.pack(side="left", fill="both", expand=True)
        vs.pack(side="right", fill="y")

        # Map tree row -> src_id.
        row_src = {}

        def _status_label(p):
            if p.get("customer_conflict"):
                return "CONFLICT"
            d = str(p.get("decision", "") or "")
            if d == "match":
                return "Match"
            if d == "review":
                return "Review"
            return "Unmatched"

        def _refresh_tree():
            tree.delete(*tree.get_children())
            row_src.clear()
            cur = list((getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or [])
            for p in cur:
                if not isinstance(p, dict):
                    continue
                _po = ", ".join(p.get("po_numbers", []) or []) or "-"
                _conf = int(round(float(p.get("confidence", 0.0) or 0.0) * 100))
                _job = str(p.get("job_label", "") or p.get("job_id", "") or "(no match)")[:60]
                iid = tree.insert("", "end", values=(
                    _status_label(p), _po[:20],
                    str(p.get("sender", "") or p.get("sender_email", "") or "")[:30],
                    _job, f"{_conf}%"))
                row_src[iid] = p.get("src_id", "")
            win.title(f"PO Review ({len(row_src)})")
            try:
                self._refresh_po_review_button()
            except Exception:
                pass

        _refresh_tree()

        # Detail + actions area.
        detail = tk.Label(win, bg=_BG, fg="#9aa4b2", justify="left", anchor="w", wraplength=840)
        detail.pack(fill="x", padx=12, pady=(0, 4))

        def _selected_entry():
            sel = tree.selection()
            if not sel:
                return None, None
            sid = row_src.get(sel[0], "")
            return sid, self._po_review_entry_by_src(sid)

        def _on_select(_evt=None):
            sid, p = _selected_entry()
            if not isinstance(p, dict):
                detail.config(text="")
                return
            bits = []
            if p.get("customer_conflict"):
                bits.append("\u26a0 Sender company differs from the matched job's customer -- confirm before applying.")
            if p.get("reasons"):
                bits.append("Why: " + "; ".join(p.get("reasons", []) or [])[:300])
            if p.get("runner_up_label"):
                bits.append("Runner-up: " + str(p.get("runner_up_label")))
            detail.config(text="\n".join(bits))
        tree.bind("<<TreeviewSelect>>", _on_select)

        def _apply_selected():
            sid, p = _selected_entry()
            if not isinstance(p, dict):
                return
            job_id = str(p.get("job_id", "") or "")
            if not job_id:
                try:
                    import tkinter.messagebox as _mb
                    _mb.showinfo("No matched job",
                                 "This PO has no matched job. Use 'Choose another job' to pick one.",
                                 parent=win)
                except Exception:
                    pass
                return
            # v4.1.44 (audit #5, URGENT #1): award + audit event + pending removal
            # commit as ONE transaction; a failed save keeps the entry queued and
            # says so, instead of showing success over an unwritten disk.
            ok = bool(self._resolve_po_review_entry(
                p, "applied", job_id, record_award=True,
                handled_extra={"via": "po_review_window"}))
            if not ok:
                try:
                    import tkinter.messagebox as _mb
                    _mb.showerror("PO not recorded",
                                  "The PO could not be recorded durably (the job may have "
                                  "been merged, archived, or removed, or the save failed). "
                                  "The PO is kept in the queue.",
                                  parent=win)
                except Exception:
                    pass
                return
            try:
                self.render_group_rows(); self.render_email_rows()
            except Exception:
                pass
            # v4.2.94 (Steve, reported live on Allan Briteway PO 510880): applying a PO
            # here used to record the award and stop -- rows stayed open, the group
            # stayed unarchived, no popup. A PO is a PO however it arrives, so this now
            # runs the same finish as every other PO path.
            try:
                self._finish_po_award(
                    job_id,
                    anchor=self.get_email_by_id(str(p.get("entry_id", "") or "")),
                    po_numbers=p.get("po_numbers", []) or [],
                    source="po_review_window")
            except Exception:
                pass
            _refresh_tree(); detail.config(text="")

        def _choose_job():
            sid, p = _selected_entry()
            if not isinstance(p, dict):
                return
            self._po_review_choose_job(p, win, on_done=lambda: (_refresh_tree(), detail.config(text="")))

        def _open_email_selected():
            sid, p = _selected_entry()
            if isinstance(p, dict):
                self._open_po_source_email(p)

        def _dismiss_selected():
            sid, p = _selected_entry()
            if not isinstance(p, dict):
                return
            # v4.1.44 (audit #5): dismissal is also a durable state change --
            # verify persistence BEFORE the row disappears from the window.
            ok = bool(self._resolve_po_review_entry(
                p, "dismissed", str(p.get("job_id", "") or ""), record_award=False,
                handled_extra={"via": "po_review_window"}))
            if not ok:
                try:
                    import tkinter.messagebox as _mb
                    _mb.showerror("Dismiss not saved",
                                  "The dismissal could not be saved. The PO is kept in the queue.",
                                  parent=win)
                except Exception:
                    pass
                return
            _refresh_tree(); detail.config(text="")

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=12, pady=(4, 12))
        tk.Button(btns, text="Apply to matched job", command=_apply_selected,
                  bg="#2f6feb", fg="white").pack(side="left", padx=4)
        tk.Button(btns, text="Choose another job\u2026", command=_choose_job,
                  bg=_BTN_BG, fg=_FG).pack(side="left", padx=4)
        tk.Button(btns, text="Open email", command=_open_email_selected,
                  bg=_BTN_BG, fg=_FG).pack(side="left", padx=4)
        tk.Button(btns, text="Dismiss", command=_dismiss_selected,
                  bg=_BTN_BG, fg=_FG).pack(side="left", padx=4)
        tk.Button(btns, text="Close", command=lambda: (win.destroy(), self._refresh_po_review_button()),
                  bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
        try:
            win.lift(); win.focus_force()
        except Exception:
            pass

    def _resolve_po_review_entry(self, entry, disposition, job_id="",
                                 record_award=False, apply_awarded_quantities=False,
                                 handled_extra=None):
        """v4.1.44 (audit #5, URGENT #1): resolve a PO review entry as ONE
        transaction. The v4.1.43 UI paths saved the award transactionally, then
        SEPARATELY appended the handled audit event, removed the pending entry,
        and called save_quote_coverage() again with the result ignored -- so a
        failed second save showed success in the UI while disk still held the
        pending PO, which could reappear after restart and be applied twice.

        This method, under the coverage lock: snapshots the affected job record,
        the pending queue, the handled ledger, and the top-level timestamp;
        applies the award (deferred save), appends the audit event, removes the
        pending entry; saves ONCE; and restores EVERYTHING if the save fails.

        v4.1.47 (eighth audit #3): returns a tri-state, all truthy-compatible with
        the old boolean for callers that only refresh:
            "committed"        -- this call durably resolved the entry; committed-
                                  only side effects (reminder, archive) may run
            "already_resolved" -- benign no-op replay (stale window/double-fire);
                                  NO side effects may run; any stale pending
                                  duplicate was self-healed
            False              -- nothing changed (entry gone without a handled
                                  event, missing job, or failed save)"""
        with self._coverage_save_lock():
            _snap_rec = _snap_updated = None
            _event = _removed_entry = None
            _trimmed_events = []
            _removed_index = 0
            _cov_debug_race = False
            _rev_at_start = self._coverage_revision()
            qc = None
            try:
                qc = getattr(self, "quote_coverage", None)
                if not isinstance(qc, dict) or not isinstance(entry, dict):
                    return False
                threads = qc.get("threads", {}) or {}
                src_id = str(entry.get("src_id", "") or "")

                # v4.1.46 (seventh audit, URGENT #1): IDEMPOTENCY. Two UI surfaces
                # (the review window and the auto-popup) can hold the same durable
                # entry, and a double-fired callback replays it -- previously each
                # call re-recorded the award, appended a second handled event, and
                # doubled the PO history even though every save succeeded.
                # (a) If this src_id is already in the handled ledger, it was
                #     resolved (whatever the disposition): benign no-op, True.
                # (b) The award is created only after CLAIMING the still-pending
                #     entry; a stale window acting on a consumed entry gets False
                #     and its refresh shows the queue as it really is.
                if src_id:
                    _h_prior = qc.get("po_awards_handled", []) or []
                    if any(isinstance(x, dict) and str(x.get("src_id", "")) == src_id
                           for x in _h_prior):
                        # v4.1.47 (eighth audit #3/#4): "already_resolved", not a
                        # plain True -- callers must not run committed-only side
                        # effects (reminder/archive) on a stale replay. SELF-HEAL:
                        # a duplicate of this src_id still sitting in the pending
                        # queue (handled AND pending at once) would keep the PO
                        # visible in PO Review after resolution; remove it and
                        # persist the cleanup, restoring it if the save fails so
                        # memory never runs ahead of disk.
                        _p_now = qc.get("po_review_pending")
                        if isinstance(_p_now, list):
                            _stale = [x for x in _p_now
                                      if isinstance(x, dict) and str(x.get("src_id", "")) == src_id]
                            if _stale:
                                for _x in _stale:
                                    try:
                                        _p_now.remove(_x)
                                    except ValueError:
                                        pass
                                if not self.save_quote_coverage():
                                    _p_now.extend(_stale)
                        return "already_resolved"
                _pending_now = qc.get("po_review_pending", []) or []
                if not any(isinstance(x, dict) and str(x.get("src_id", "")) == src_id
                           for x in _pending_now):
                    return False

                _snap_rec = (copy.deepcopy(threads.get(job_id))
                             if job_id and isinstance(threads.get(job_id), dict) else None)
                _snap_updated = qc.get("updated_at", "")

                # 1. Award mutation, save deferred to step 4. A False here means no
                # net mutation happened (missing job, or _record_po_award restored
                # its own snapshot on an internal error).
                if record_award:
                    if not self._record_po_award(
                            job_id, po_numbers=entry.get("po_numbers", []) or [],
                            awarded_lines=None,
                            apply_awarded_quantities=bool(apply_awarded_quantities),
                            _defer_save=True):
                        return False

                # 2. Handled audit event (complete, auditable).
                h = qc.setdefault("po_awards_handled", [])
                if not isinstance(h, list):
                    h = qc["po_awards_handled"] = []
                _event = {
                    "src_id": src_id,
                    "entry_id": entry.get("entry_id", ""),
                    "imid": entry.get("imid", ""),
                    "job_id": job_id,
                    "job_label": entry.get("job_label", ""),
                    "po_numbers": entry.get("po_numbers", []),
                    "quote_numbers": entry.get("quote_numbers", []),
                    "sender": entry.get("sender", ""),
                    "sender_email": entry.get("sender_email", ""),
                    "confidence": entry.get("confidence", 0.0),
                    "reasons": entry.get("reasons", []),
                    "customer_conflict": entry.get("customer_conflict", False),
                    "disposition": disposition,
                    "at": datetime.now().isoformat(),
                }
                if isinstance(handled_extra, dict):
                    _event.update(handled_extra)
                h.append(_event)          # identity retained for surgical rollback
                if len(h) > 2000:
                    # v4.1.46 (seventh audit, #2): keep the trimmed prefix so a
                    # FAILED save can put it back -- previously a failed save at the
                    # cap restored only the new event, leaving memory one OLD audit
                    # event short, and the next successful save made the loss
                    # permanent on disk (the handled-ledger twin of the v4.1.44
                    # pending-queue cap defect).
                    _trimmed_events = h[:len(h) - 2000]
                    del h[:len(h) - 2000]

                # 3. Remove the pending review entry.
                pending = qc.get("po_review_pending", []) or []
                for _i, _p in enumerate(pending):
                    if isinstance(_p, dict) and _p.get("src_id") == src_id:
                        _removed_entry, _removed_index = _p, _i
                        break
                if not isinstance(qc.get("po_review_pending"), list):
                    qc["po_review_pending"] = []
                if _removed_entry is not None:
                    try:
                        qc["po_review_pending"].remove(_removed_entry)
                    except ValueError:
                        _removed_entry = None

                # 4. One save; restore everything on failure.
                if not self.save_quote_coverage():
                    _cov_debug_race = (self._coverage_revision() != _rev_at_start)
                    raise RuntimeError("coverage save failed")
                return "committed"      # v4.1.47: distinct from "already_resolved"
            except Exception:
                # v4.1.45 (sixth audit, finding #1): SURGICAL rollback. Replacing the
                # record and the two lists wholesale also erased anything a NON-lock-
                # aware coverage writer had changed inside this window (the auditor
                # demonstrated a concurrent vendor update disappearing). Revert only
                # this transaction's own writes: the PO-owned fields on the record,
                # the handled event this transaction appended (by identity), and the
                # pending entry it removed (re-inserted at its original position).
                # Concurrent additions to either list are preserved.
                try:
                    if isinstance(qc, dict):
                        if job_id and _snap_rec is not None:
                            _rec_now = (qc.get("threads", {}) or {}).get(job_id)
                            if isinstance(_rec_now, dict):
                                self._restore_po_fields(_rec_now, _snap_rec)
                            else:
                                qc.setdefault("threads", {})[job_id] = _snap_rec
                        if _event is not None:
                            _h_now = qc.get("po_awards_handled")
                            if isinstance(_h_now, list):
                                for _i in range(len(_h_now) - 1, -1, -1):
                                    if _h_now[_i] is _event:
                                        del _h_now[_i]
                                        break
                                # v4.1.46 (#2): reinsert the prefix the cap trim
                                # removed, preserving original order.
                                if _trimmed_events:
                                    _h_now[:0] = _trimmed_events
                        if _removed_entry is not None:
                            _p_now = qc.get("po_review_pending")
                            if not isinstance(_p_now, list):
                                _p_now = qc["po_review_pending"] = []
                            _sid = str((_removed_entry or {}).get("src_id", "") or "")
                            if not any(isinstance(x, dict) and x.get("src_id") == _sid
                                       for x in _p_now):
                                _p_now.insert(min(_removed_index, len(_p_now)), _removed_entry)
                        if _snap_updated is not None:
                            qc["updated_at"] = _snap_updated
                        if _cov_debug_race:
                            _cov_debug("PO resolution rolled back after a concurrent coverage "
                                       "write (revision advanced); only PO-owned fields reverted")
                except Exception:
                    pass
                return False

    def _po_review_choose_job(self, entry, parent, on_done=None):
        """Let the user pick a different open job for a PO (wrong-match / unmatched
        handling), then record the award against the chosen job."""
        try:
            jobs = self._build_open_jobs_for_po_match()
        except Exception:
            jobs = []
        picker = tk.Toplevel(parent)
        picker.title("Choose job for this PO")
        picker.configure(bg=_BG)
        picker.geometry("560x420")
        try:
            picker.transient(parent)
        except Exception:
            pass
        tk.Label(picker, bg=_BG, fg=_FG, anchor="w", justify="left",
                 text="Select the job this purchase order belongs to:").pack(
            fill="x", padx=12, pady=(10, 6))
        lb = tk.Listbox(picker, activestyle="none")
        lb.pack(fill="both", expand=True, padx=12, pady=(0, 8))
        _job_ids = []
        for j in jobs:
            _job_ids.append(j.job_id)
            _flag = " [has PO]" if getattr(j, "prior_po", False) else ""
            lb.insert("end", f"{j.label}{_flag}")
        if not jobs:
            lb.insert("end", "(no open jobs available)")

        def _confirm():
            sel = lb.curselection()
            if not sel or not _job_ids:
                return
            job_id = _job_ids[sel[0]]
            # v4.1.44 (audit #5, URGENT #1): one transaction for award + audit
            # event + pending removal.
            ok = bool(self._resolve_po_review_entry(
                entry, "applied", job_id, record_award=True,
                handled_extra={"via": "po_review_window"}))
            if not ok:
                try:
                    import tkinter.messagebox as _mb
                    _mb.showerror("PO not recorded",
                                  "That job could not be updated durably. The PO is kept in the queue.",
                                  parent=picker)
                except Exception:
                    pass
                return
            try:
                self.render_group_rows(); self.render_email_rows()
            except Exception:
                pass
            try:
                picker.destroy()
            except Exception:
                pass
            if callable(on_done):
                on_done()

        b = tk.Frame(picker, bg=_BG)
        b.pack(fill="x", padx=12, pady=(4, 12))
        tk.Button(b, text="Assign PO to this job", command=_confirm,
                  bg="#2f6feb", fg="white").pack(side="right", padx=4)
        tk.Button(b, text="Cancel", command=picker.destroy,
                  bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
        try:
            picker.lift(); picker.focus_force()
        except Exception:
            pass

    def _restore_po_review_popups(self):
        """v4.1.39: on startup, re-point the in-memory popup queue at any confident,
        non-conflicting MATCH still sitting in the DURABLE review queue, so a PO that
        was recognized before a crash/close is shown again. Ambiguous/conflict/
        unmatched entries stay in the durable queue for the review window but do not
        auto-pop. Idempotent."""
        try:
            pending = (getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or []
            if not isinstance(pending, list) or not pending:
                return
            q = getattr(self, "_pending_po_award_prompts", None)
            if not isinstance(q, list):
                q = []
                self._pending_po_award_prompts = q
            for p in pending:
                if not isinstance(p, dict):
                    continue
                if str(p.get("decision", "")) == "match" and p.get("job_id") \
                        and not p.get("customer_conflict"):
                    sid = p.get("src_id", "")
                    if sid and sid not in q:
                        q.append(sid)
        except Exception:
            pass

    def _open_po_source_email(self, item):
        """Open the PO's source email in Outlook so the user can confirm before acting.
        Resolves by EntryID (+ StoreID) with a Message-ID fallback across scan folders.
        """
        try:
            outlook, namespace = self.fresh_outlook()
            if not namespace:
                return False
            eid = str(item.get("entry_id", "") or "")
            sid = str(item.get("store_id", "") or "")
            msg = None
            if eid:
                try:
                    msg = namespace.GetItemFromID(eid, sid) if sid else namespace.GetItemFromID(eid)
                except Exception:
                    msg = None
            if msg is None and item.get("imid"):
                # Message-ID fallback -- durable across EntryID churn.
                try:
                    _mid = str(item.get("imid", "") or "").strip()
                    for _lbl, _fold in self.coverage_inbox_folders_for_quote_scan(namespace) or []:
                        try:
                            _found = _fold.Items.Find(
                                "@SQL=\"http://schemas.microsoft.com/mapi/proptag/0x1035001F\" = '" + _mid + "'")
                            if _found is not None:
                                msg = _found
                                break
                        except Exception:
                            continue
                except Exception:
                    msg = None
            if msg is None:
                return False
            self.display_outlook_item_foreground(msg)
            return True
        except Exception:
            return False

    def _po_review_entry_by_src(self, src_id):
        """Fetch a persisted PO review entry by its source id, or None."""
        try:
            pending = (getattr(self, "quote_coverage", {}) or {}).get("po_review_pending", []) or []
            for p in pending:
                if isinstance(p, dict) and p.get("src_id") == src_id:
                    return p
        except Exception:
            pass
        return None

    # v4.1.44: _po_review_remove was removed -- every resolution path now goes
    # through _resolve_po_review_entry, which removes the pending entry inside
    # the same transaction as the award and the handled audit event.

    def _create_po_received_followup(self, group_id, anchor_email, po_numbers=None):
        """v4.1.39: a PO-RECEIVED reminder (place vendor orders / confirm entry /
        verify delivery) -- distinct from _create_quote_completion_followup, whose
        note ('chase the PO after quote completion') is wrong once a PO is in hand."""
        try:
            if not anchor_email:
                return False
            s = getattr(self, "settings", {}) or {}
            days = int(s.get("po_received_followup_days", 1) or 0)
            hour = int(s.get("po_received_followup_hour", 7) or 0)
            minute = int(s.get("po_received_followup_minute", 0) or 0)
            due_at = (datetime.now() + timedelta(days=max(0, days))).replace(
                hour=max(0, min(23, hour)), minute=max(0, min(59, minute)),
                second=0, microsecond=0)
            for it in self.followups:
                if it.get("completed") or it.get("cancelled"):
                    continue
                if group_id and it.get("group_id") == group_id and it.get("source_reason") == "po_received":
                    return False
            _ponum = ", ".join(po_numbers or []) or ""
            item = {
                "entry_id": anchor_email.get("entry_id", ""),
                "store_id": anchor_email.get("store_id", ""),
                "conversation_id": anchor_email.get("conversation_id", ""),
                "group_id": group_id,
                "subject": anchor_email.get("subject", ""),
                "source": anchor_email.get("source", ""),
                "category": anchor_email.get("category", "General"),
                "due_at": due_at.isoformat(),
                "message": "", "use_ai": False,
                "note": ("PO received" + (f" ({_ponum})" if _ponum else "")
                         + " - place vendor orders, confirm order entry, verify delivery date."),
                "source_reason": "po_received",
                "completed": False, "cancelled": False,
                "created_at": datetime.now().isoformat(),
            }
            self.followups.append(item)
            self._followup_dedup_needed = True
            try:
                anchor_email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
            except Exception:
                pass
            self.save_followups()
            return True
        except Exception:
            return False

    def _process_pending_po_award_prompts(self):
        """MAIN-thread drain of the PO-award popup queue. The in-memory queue holds
        source-id POINTERS into the DURABLE review queue (quote_coverage
        ['po_review_pending']); the authoritative record is persisted, so a lost
        popup list never loses a PO.

        v4.1.39: records a customer PO as a PO (not vendor 'Quoted'). Default options
        follow the audit: record PO received (on); apply awarded quantities to sales
        lines (off); create an order-processing reminder (off); archive (off). A
        customer CONFLICT is surfaced prominently. 'Remind me later' snoozes;
        'Dismiss' is permanent; both are distinct choices."""
        src_id = None
        try:
            q = getattr(self, "_pending_po_award_prompts", None)
            if not isinstance(q, list) or not q:
                return
            src_id = q.pop(0)
        except Exception:
            return
        # Resolve the pointer to the durable record.
        item = self._po_review_entry_by_src(src_id) if isinstance(src_id, str) else None
        if not isinstance(item, dict):
            # Pointer went stale (already handled) -- just continue the queue.
            try:
                self.root.after(200, self._process_pending_po_award_prompts)
            except Exception:
                pass
            return
        try:
            job_id = str(item.get("job_id", "") or "")
            gid = job_id[4:] if job_id.startswith("grp:") else ""
            _conf = int(round(float(item.get("confidence", 0.0) or 0.0) * 100))
            _pos = ", ".join(item.get("po_numbers", []) or []) or "(number not detected)"
            _reasons = "; ".join(item.get("reasons", []) or [])
            _conflict = bool(item.get("customer_conflict"))

            win = tk.Toplevel(self.root)
            win.title("Purchase Order received")
            win.configure(bg=_BG)
            win.transient(self.root)
            _hdr = ("A purchase order was received.\n\n"
                    f"PO: {_pos}\n"
                    f"From: {str(item.get('sender', '') or '')[:60]}\n"
                    f"Subject: {str(item.get('subject', '') or '')[:80]}\n\n"
                    f"Matched to job ({_conf}% confidence):\n"
                    f"  {str(item.get('job_label', '') or job_id)[:80]}")
            tk.Label(win, text=_hdr, bg=_BG, fg=_FG, justify="left").pack(
                anchor="w", padx=14, pady=(12, 4))
            if _conflict:
                tk.Label(win,
                         text=("\u26a0  The PO sender's company differs from this job's "
                               "customer.\n    Confirm this is the right job before applying."),
                         bg=_BG, fg="#e6a23c", justify="left", wraplength=460).pack(
                    anchor="w", padx=14, pady=(0, 6))
            if _reasons:
                tk.Label(win, text="Why: " + _reasons[:200], bg=_BG, fg="#9aa4b2",
                         justify="left", wraplength=460).pack(anchor="w", padx=14, pady=(0, 8))

            # v4.1.39 default options per the audit -- record the PO as a PO; do NOT
            # flip vendor coverage or archive by default.
            var_record = tk.BooleanVar(value=True)
            var_apply = tk.BooleanVar(value=False)
            var_reminder = tk.BooleanVar(value=False)
            var_archive = tk.BooleanVar(value=False)
            opts = tk.Frame(win, bg=_BG)
            opts.pack(fill="x", padx=14, pady=(2, 8))
            tk.Checkbutton(opts, text="Record PO received for this job (lines unverified until reviewed)",
                           variable=var_record, bg=_BG, fg=_FG, selectcolor=_ENTRY_BG,
                           activebackground=_BG, activeforeground=_FG).pack(anchor="w")
            tk.Checkbutton(opts, text="Apply awarded quantities to matched sales lines (asserts full award, marks them Quoted)",
                           variable=var_apply, bg=_BG, fg=_FG, selectcolor=_ENTRY_BG,
                           activebackground=_BG, activeforeground=_FG).pack(anchor="w")
            tk.Checkbutton(opts, text="Create an order-processing reminder",
                           variable=var_reminder, bg=_BG, fg=_FG, selectcolor=_ENTRY_BG,
                           activebackground=_BG, activeforeground=_FG).pack(anchor="w")
            tk.Checkbutton(opts, text="Archive this group now (leave OFF to place orders first)",
                           variable=var_archive, bg=_BG, fg=_FG, selectcolor=_ENTRY_BG,
                           activebackground=_BG, activeforeground=_FG).pack(anchor="w")

            def _next():
                try:
                    win.destroy()
                except Exception:
                    pass
                self.root.after(300, self._process_pending_po_award_prompts)

            def _handled_extra():
                # v4.1.44: complete audit detail merged into the transactional
                # resolver's standard event (options, runner-up, line details).
                return {
                    "runner_up_label": item.get("runner_up_label", ""),
                    "po_lines": item.get("po_lines", {}),
                    "via": "po_award_popup",
                    "options": {
                        "record": bool(var_record.get()),
                        "apply_quantities": bool(var_apply.get()),
                        "reminder": bool(var_reminder.get()),
                        "archive": bool(var_archive.get()),
                    },
                }

            def _open_email():
                self._open_po_source_email(item)

            def _apply():
                # v4.1.44 (audit #5, URGENT #1): the award, the handled audit event,
                # and the pending-queue removal now commit as ONE transaction with a
                # single save (previously the award saved transactionally but the
                # handled/removal mutation saved separately with the result ignored,
                # so a failed second save could resurrect the PO after restart and
                # let it be applied twice). Reminder and archive side-effects run
                # only AFTER the resolution is durably on disk.
                _want_award = bool(var_record.get()) or bool(var_apply.get())
                _res = self._resolve_po_review_entry(
                    item, "applied", job_id,
                    record_award=_want_award,
                    apply_awarded_quantities=bool(var_apply.get()),
                    handled_extra=_handled_extra())
                if _res == "already_resolved":
                    # v4.1.47 (eighth audit #3): stale popup replay -- the PO was
                    # already applied or dismissed elsewhere. Run NO side effects
                    # (no reminder, no archive); just move on. The stale pending
                    # duplicate, if any, was self-healed by the resolver.
                    _next()
                    return
                ok = bool(_res)
                if not ok:
                    # v4.1.41 semantics kept: do NOT re-arm this popup (a missing job
                    # loops the same error); the entry stays in the durable review
                    # queue where 'Choose another job' is the remedy. Continue with
                    # the REST of the queue only.
                    try:
                        import tkinter.messagebox as _mb
                        _mb.showerror("PO not recorded",
                                      "The PO could not be recorded durably (the job may "
                                      "have been merged, archived, or removed, or the save "
                                      "failed).\n\nThe PO is kept in the review queue -- "
                                      "open 'PO Review' on the toolbar and use 'Choose "
                                      "another job' to assign it.",
                                      parent=win)
                    except Exception:
                        pass
                    try:
                        win.destroy()
                    except Exception:
                        pass
                    try:
                        self._refresh_po_review_button()
                    except Exception:
                        pass
                    self.root.after(300, self._process_pending_po_award_prompts)
                    return
                # Committed-only side effects below (v4.1.47): reached only when
                # _res == "committed" -- a replay returned above.
                # PO-received reminder (correct semantics), if chosen.
                try:
                    if var_reminder.get():
                        anchor = self.get_email_by_id(str(item.get("entry_id", "") or "")) or {
                            "entry_id": item.get("entry_id", ""),
                            "store_id": item.get("store_id", ""),
                            "subject": item.get("subject", ""),
                            "source": "", "category": "General",
                        }
                        self._create_po_received_followup(gid, anchor, item.get("po_numbers", []) or [])
                except Exception:
                    pass
                # Archive last (only if chosen).
                try:
                    if var_archive.get() and gid:
                        self._archive_group_by_id(gid)
                except Exception:
                    pass
                # v4.2.94: and then the SAME finish every other PO path runs -- close
                # the job's open rows as won and show the congrats popup. The archive
                # checkbox above is left in place and still honoured; it is now belt
                # and braces (_archive_group_by_id is a no-op on an already-archived
                # group), because the won-close archives through the assistant Cleanup
                # whenever Auto-Archive is on.
                try:
                    self._finish_po_award(
                        gid,
                        anchor=self.get_email_by_id(str(item.get("entry_id", "") or "")),
                        po_numbers=item.get("po_numbers", []) or [],
                        source="po_auto_popup")
                except Exception:
                    pass
                try:
                    self.render_group_rows()
                    self.render_email_rows()
                except Exception:
                    pass
                _next()

            def _snooze():
                # Leave the durable review entry in place; just stop showing it this
                # session. It will re-surface on a later scan / restart.
                _next()

            def _dismiss():
                # Permanent: record as dismissed and remove from the pending queue --
                # v4.1.44 (audit #5): as ONE transaction; a failed save keeps the
                # entry queued and says so.
                ok = bool(self._resolve_po_review_entry(
                    item, "dismissed", job_id, record_award=False,
                    handled_extra=_handled_extra()))
                if not ok:
                    try:
                        import tkinter.messagebox as _mb
                        _mb.showerror("Dismiss not saved",
                                      "The dismissal could not be saved. The PO stays in "
                                      "the review queue.",
                                      parent=win)
                    except Exception:
                        pass
                _next()

            btns = tk.Frame(win, bg=_BG)
            btns.pack(fill="x", padx=14, pady=(6, 12))
            tk.Button(btns, text="Apply", command=_apply,
                      bg="#2f6feb", fg="white").pack(side="right", padx=4)
            tk.Button(btns, text="Open email", command=_open_email,
                      bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
            tk.Button(btns, text="Remind me later", command=_snooze,
                      bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
            tk.Button(btns, text="Dismiss", command=_dismiss,
                      bg=_BTN_BG, fg=_FG).pack(side="right", padx=4)
            win.protocol("WM_DELETE_WINDOW", _snooze)   # closing = snooze, not permanent
            try:
                win.lift(); win.focus_force()
            except Exception:
                pass
        except Exception as _exc:
            try:
                _cov_debug(f"PO award popup error: {_exc!r}")
            except Exception:
                pass
            try:
                self.root.after(300, self._process_pending_po_award_prompts)
            except Exception:
                pass

    def _record_po_award(self, job_id, po_numbers=None, awarded_lines=None,
                         award_status="", apply_awarded_quantities=False,
