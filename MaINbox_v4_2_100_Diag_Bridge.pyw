                  bg=_ACCENT, fg="#ffffff", activebackground=_ACCENT2, activeforeground="#ffffff",
                  relief="flat", padx=12, cursor="hand2", font=("Segoe UI", _FONT_SIZE, "bold")).pack(side="right", padx=3)
        tk.Button(btns, text="Dismiss this request", command=lambda: dismiss_current()).pack(side="right", padx=3)

        add_frame = tk.LabelFrame(right, text="Add requested items (paste one per line)",
                                  bg=_BG2, fg=_FG_DIM, font=(_FONT, 8, "bold"))
        add_frame.pack(fill="x", padx=4, pady=(0, 6))
        add_text = tk.Text(add_frame, height=3, wrap="word", bg=_BG3, fg=_FG, insertbackground=_FG)
        add_text.pack(fill="x", padx=4, pady=4)
        tk.Button(add_frame, text="Add to selected request",
                  command=lambda: add_lines()).pack(side="left", padx=4, pady=(0, 4))

        hint = ("Requested items are captured when you run Quote RFQ on a customer email; quoted items are "
                "detected from your sent replies in the same thread. Status auto-updates: Outstanding (no reply yet) "
                "\u2192 Waiting (you sent a sourcing reply like 'I will advise') \u2192 Quoted (a priced item in your reply "
                "matches). Use the buttons to override any item (Partial / No-bid / etc.); a manual status sticks.")
        tk.Label(win, text=hint, fg=_FG_DIM, bg=_BG, font=(_FONT, 8), wraplength=1060,
                 justify="left", anchor="w").pack(fill="x", padx=12, pady=(0, 8))

        CHK_OFF, CHK_ON = "\u2610", "\u2611"  # unchecked / checked glyphs
        state = {"current": None, "item_keys": {}, "checked": set()}

        def load_items(thread_key):
            state["current"] = thread_key
            state["item_keys"] = {}
            state["checked"] = set()
            items_tree.delete(*items_tree.get_children())
            rec = self.get_coverage_record(thread_key, create=False)
            if not rec:
                return
            rows, _out = self.compute_coverage_for_record(rec)
            _check_meta = rec.get("check_meta", {}) if isinstance(rec.get("check_meta"), dict) else {}
            for idx, row in enumerate(rows):
                label, tag = _COVERAGE_STATUS_DISPLAY.get(
                    row.get("status", "outstanding"), ("OUTSTANDING", "outstanding"))
                disp = row["display"]
                if row.get("status") == "check" and _check_meta:
                    _who = str(_check_meta.get("sender", "") or "").strip()
                    _when = str(_check_meta.get("date", "") or "")[:10]
                    _hint = " \u27f5 review reply" + (f" from {_who}" if _who else "") + (f" ({_when})" if _when else "")
                    disp = disp + _hint
                iid = f"item:{idx}"
                items_tree.insert("", "end", iid=iid, values=(CHK_OFF, label, disp), tags=(tag,))
                state["item_keys"][iid] = self.coverage_item_primary_key(row["req"])

        def reload_all():
            # v4.1.34: ONE coverage pass per reload. This used to run three full-store
            # computations (status label -> summary -> local pass); the label and the
            # summary now consume this pass's result.
            threads = self.coverage_active_threads()
            try:
                self.update_coverage_status_label(precomputed_threads=threads)
            except Exception:
                pass
            cur = state.get("current")
            threads_tree.delete(*threads_tree.get_children())
            for t in threads:
                rec = t["rec"]
                label = rec.get("customer", "") or rec.get("customer_email", "") or "?"
                subj = rec.get("subject", "") or "(no subject)"
                disp = f"{label} \u2014 {subj}"[:80]
                tag = "has_out" if t["outstanding"] > 0 else "done"
                out_disp = f"{t['outstanding']} / {t['requested_count']}"
                threads_tree.insert("", "end", iid=t["thread_key"], values=(disp, out_disp), tags=(tag,))
            thread_ct, item_ct = self.coverage_outstanding_summary(threads=threads)  # v4.1.34: reuse the pass above
            if item_ct:
                summary_var.set(f"{item_ct} item(s) still need quotes across {thread_ct} customer request(s)")
            else:
                summary_var.set("All requested items have been quoted.")
            if cur and threads_tree.exists(cur):
                threads_tree.selection_set(cur)
                load_items(cur)
            else:
                state["current"] = None
                items_tree.delete(*items_tree.get_children())

        def on_thread_select(event=None):
            sel = threads_tree.selection()
            if sel:
                load_items(sel[0])

        threads_tree.bind("<<TreeviewSelect>>", on_thread_select)

        # v4.2.67 (Steve): "The user can always open the review window by opening
        # quote coverage and double clicking the completed quote." Works on any
        # request (the review window shows partial progress too, not just done jobs).
        def on_thread_double(event=None):
            iid = threads_tree.focus()
            if iid:
                self.open_quote_review_summary_window(iid)

        threads_tree.bind("<Double-1>", on_thread_double)

        def set_done(done):
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            sel = items_tree.selection()
            if not sel:
                messagebox.showinfo("Quote Coverage", "Select one or more line items first.")
                return
            for iid in sel:
                pk = state.get("item_keys", {}).get(iid, "")
                if pk:
                    self.coverage_toggle_item_done(cur, pk, done=done)
            reload_all()

        def set_item_status(status):
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            sel = target_iids()
            if not sel:
                messagebox.showinfo("Quote Coverage", "Check or select one or more line items first.")
                return
            for iid in sel:
                pk = state.get("item_keys", {}).get(iid, "")
                if pk:
                    self.coverage_set_item_status(cur, pk, status)
            reload_all()

        def add_lines():
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            txt = add_text.get("1.0", tk.END)
            n = self.coverage_add_requested_lines(cur, txt)
            add_text.delete("1.0", tk.END)
            reload_all()
            messagebox.showinfo("Quote Coverage", f"Added {n} requested item(s).")

        def dismiss_current():
            cur = state.get("current")
            if not cur:
                return
            if messagebox.askyesno("Dismiss request",
                                   "Remove this customer request from the coverage queue?"):
                self.coverage_dismiss_thread(cur, True)
                state["current"] = None
                reload_all()

        # ---- checkboxes / re-quote / double-click-to-email ----
        def toggle_check(iid):
            if iid in state["checked"]:
                state["checked"].discard(iid)
                items_tree.set(iid, "chk", CHK_OFF)
            else:
                state["checked"].add(iid)
                items_tree.set(iid, "chk", CHK_ON)

        def toggle_check_all():
            kids = items_tree.get_children()
            all_on = bool(kids) and all(i in state["checked"] for i in kids)
            for i in kids:
                if all_on:
                    state["checked"].discard(i)
                    items_tree.set(i, "chk", CHK_OFF)
                else:
                    state["checked"].add(i)
                    items_tree.set(i, "chk", CHK_ON)

        def on_items_click(event):
            if items_tree.identify_region(event.x, event.y) != "cell":
                return
            if items_tree.identify_column(event.x) == "#1":  # checkbox column
                row = items_tree.identify_row(event.y)
                if row:
                    toggle_check(row)
                    return "break"  # don't also change the row selection

        items_tree.bind("<Button-1>", on_items_click, add="+")

        def target_iids():
            # act on checked items; if none are checked, fall back to the highlighted selection
            if state["checked"]:
                return [i for i in items_tree.get_children() if i in state["checked"]]
            return list(items_tree.selection())

        def requote_selected():
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            rec = self.get_coverage_record(cur, create=False)
            if not rec:
                return
            keys = [state.get("item_keys", {}).get(i, "") for i in target_iids()]
            keys = [k for k in keys if k]
            if not keys:
                messagebox.showinfo("Quote Coverage", "Check the line items you want to re-quote first.")
                return
            keyset = set(keys)
            materials = normalize_material_items(
                [r for r in (rec.get("requested", []) or []) if self.coverage_item_primary_key(r) in keyset])
            if not materials:
                messagebox.showinfo("Quote Coverage", "Couldn't load those items to re-quote.")
                return
            # flip them to Waiting (auto, so a fresh vendor reply still auto-flips to Quoted), then refresh
            self.coverage_requote_items(cur, keys)
            reload_all()
            # open the RFQ & Materials extractor seeded with these items + suggested vendors
            group_id = rec.get("group_id", "") or ""
            try:
                group = self.get_group_by_id(group_id) if group_id else None
                emails = self.get_emails_for_group(group_id) if group_id else []
                if group or emails:
                    customer_hint = self.get_customer_hint_for_group(group, emails)
                else:
                    customer_hint = rec.get("customer", "") or ""
                vendors = self.suggest_vendors_for_materials(materials, customer_hint)
                self.open_quote_intelligence_window(
                    group_id, materials, vendors,
                    ["Re-quote from Quote Coverage \u2014 items carried over."], False,
                    requote_mode=True)  # v4.1.36: compose-only -- never mirror-replaces the ledger
            except Exception as e:
                messagebox.showwarning(
                    "Re-quote",
                    "Marked the items as Waiting, but couldn't open the RFQ extractor automatically "
                    f"(\u201c{e}\u201d). You can open it from the group's Quote RFQ button.")

        def _open_eid(eid):
            try:
                if self.goto_email_in_app(eid):
                    try:
                        self.root.lift()
                    except Exception:
                        pass
                    return True
            except Exception:
                pass
            try:
                ns = getattr(self, "namespace", None)
                if ns is None:
                    _o, ns = self.fresh_outlook()
                if ns:
                    it = ns.GetItemFromID(eid)
                    if it:
                        it.Display()
                        return True
            except Exception:
                pass
            return False

        def _eid_label(eid):
            e = self.get_email_by_id(eid)
            if e:
                subj = e.get("subject") or "(no subject)"
                who = e.get("sender") or e.get("sender_email") or ""
                when = e.get("received") or e.get("date") or ""
                return f"{subj}  \u2014  {who}  {when}".strip()
            try:
                ns = getattr(self, "namespace", None)
                if ns is None:
                    _o, ns = self.fresh_outlook()
                if ns:
                    it = ns.GetItemFromID(eid)
                    if it:
                        return f"{(getattr(it, 'Subject', '') or '(no subject)')}  \u2014  {getattr(it, 'SenderName', '')}"
            except Exception:
                pass
            return f"(email {str(eid)[:14]}\u2026)"

        def associated_entry_ids(rec):
            ids = []
            for eid in (rec.get("processed_sent_ids", []) or []):  # vendor quote replies
                if eid and eid not in ids:
                    ids.append(eid)
            gid = rec.get("group_id", "") if isinstance(rec, dict) else ""  # request-thread emails
            if gid:
                try:
                    for e in (self.get_emails_for_group(gid) or []):
                        eid = e.get("entry_id", "")
                        if eid and eid not in ids:
                            ids.append(eid)
                except Exception:
                    pass
            return ids

        def show_email_chooser(ids):
            top = tk.Toplevel(win)
            top.title("Associated emails")
            try:
                apply_theme(top)
            except Exception:
                pass
            top.configure(bg=_BG)
            tk.Label(top, text="This request is linked to more than one email. Open which one?",
                     bg=_BG, fg=_FG, font=(_FONT, 9), wraplength=560, justify="left").pack(fill="x", padx=10, pady=(10, 4))
            lb = tk.Listbox(top, width=96, height=min(12, max(3, len(ids))),
                            bg=_BG3, fg=_FG, selectbackground=_ACCENT, selectforeground="#ffffff", activestyle="none")
            lb.pack(fill="both", expand=True, padx=10, pady=6)
            for eid in ids:
                lb.insert("end", _eid_label(eid))

            def open_sel(event=None):
                s = lb.curselection()
                if not s:
                    return
                if not _open_eid(ids[s[0]]):
                    messagebox.showinfo("Quote Coverage",
                                        "That email couldn't be opened \u2014 it may have been moved, archived, or removed.")
                    return
                top.destroy()

            lb.bind("<Double-1>", open_sel)
            bf = tk.Frame(top, bg=_BG)
            bf.pack(fill="x", padx=10, pady=(0, 10))
            tk.Button(bf, text="Open", command=open_sel, bg=_ACCENT, fg="#ffffff",
                      activebackground=_ACCENT2, activeforeground="#ffffff", relief="flat",
                      padx=12, cursor="hand2").pack(side="right", padx=4)
            tk.Button(bf, text="Cancel", command=top.destroy, relief="flat", padx=12, cursor="hand2").pack(side="right", padx=4)

        def on_item_double(event=None):
            try:
                if items_tree.identify_column(event.x) == "#1":  # checkbox column toggles, doesn't navigate
                    return
            except Exception:
                pass
            cur = state.get("current")
            if not cur:
                return
            rec = self.get_coverage_record(cur, create=False)
            if not rec:
                return
            ids = associated_entry_ids(rec)
            if not ids:
                messagebox.showinfo("Quote Coverage", "No associated email is available to open for this request.")
                return
            if len(ids) == 1:
                if not _open_eid(ids[0]):
                    messagebox.showinfo("Quote Coverage",
                                        "That email couldn't be opened \u2014 it may have been moved, archived, or removed.")
                return
            show_email_chooser(ids)

        items_tree.bind("<Double-1>", on_item_double, add="+")

        reload_all()

    def _show_all_quoted_popup(self, thread_key, subject=""):
        """v4.2.67 (Steve): 'after everything is quoted have a popup notifying the user
        and two buttons one to review one to close.' Review (default; Enter per the
        standing every-popup rule) opens the new Quote Review window; Close (Escape)
        dismisses. Non-modal -- it never blocks whatever the user is doing."""
        try:
            win = tk.Toplevel(self.root)
            win.title("Everything Quoted")
            win.transient(self.root)
            win.resizable(False, False)
            try:
                apply_theme(win)
            except Exception:
                pass
            win.configure(bg=_BG)
            _job = str(subject or thread_key or "this request")[:90]
            tk.Label(win, text="Everything quoted!", font=(_FONT, 13, "bold"),
                     fg="#5bd17a", bg=_BG).pack(anchor="w", padx=18, pady=(14, 2))
            tk.Label(win, text=f"All requested items for “{_job}” now have vendor quotes.",
                     bg=_BG, fg=_FG, justify="left", wraplength=430).pack(anchor="w", padx=18, pady=(0, 12))
            btns = tk.Frame(win, bg=_BG)
            btns.pack(fill="x", padx=18, pady=(0, 14))

            def _review(event=None):
                try:
                    win.destroy()
                except Exception:
                    pass
                self.open_quote_review_summary_window(thread_key)

            def _close(event=None):
                try:
                    win.destroy()
                except Exception:
                    pass

            rb = tk.Button(btns, text="Review", command=_review, bg=_ACCENT, fg="#ffffff",
                           activebackground=_ACCENT, relief="flat", padx=20, pady=4)
            rb.pack(side="left")
            tk.Button(btns, text="Close", command=_close, bg=_BORDER, fg=_FG,
                      activebackground=_BORDER, relief="flat", padx=20, pady=4).pack(side="left", padx=(10, 0))
            win.bind("<Return>", _review)
            win.bind("<Escape>", _close)
            try:
                self.root.update_idletasks()
                win.geometry(f"+{self.root.winfo_rootx() + 340}+{self.root.winfo_rooty() + 240}")
            except Exception:
                pass
            win.lift()
            try:
                win.attributes("-topmost", True)
                win.after(1500, lambda: win.attributes("-topmost", False))
            except Exception:
                pass
            rb.focus_set()
            try:
                ops_log("coverage", "all_quoted_popup", thread=str(thread_key)[:40])
            except Exception:
                pass
        except Exception:
            pass

    def open_quote_review_summary_window(self, thread_key):
        """v4.2.67 (Steve): the Quote Review window. v4.2.75 redesign (Steve): each
        ITEM is a bigger, bold parent row; under it one detail row PER VENDOR the
        line went to, with their status / price / stock-lead info -- "who has what
        at what price" in one glance. Read-only. Opened from the everything-quoted
        popup, or by double-clicking a request in Quote Coverage."""
        rec = self.get_coverage_record(thread_key, create=False)
        if not rec or not rec.get("requested"):
            try:
                self.set_status("Quote Review: no coverage record for that request.")
            except Exception:
                pass
            return
        rows, outstanding = self.compute_coverage_for_record(rec)
        quoted = rec.get("quoted", []) if isinstance(rec.get("quoted"), list) else []
        sends = rec.get("line_vendor_sends", []) if isinstance(rec.get("line_vendor_sends"), list) else []
        replies = rec.get("vendor_replies", []) if isinstance(rec.get("vendor_replies"), list) else []
        common = _coverage_record_common_tokens(rec.get("requested", []))

        win = tk.Toplevel(self.root)
        _subj = str(rec.get("subject", "") or thread_key)
        win.title(f"Quote Review -- {_subj[:60]}")
        remember_window_geometry(win, "MaINbox Quote Review", "1000x600")
        win.transient(self.root)
        try:
            apply_theme(win)
        except Exception:
            pass
        win.configure(bg=_BG)

        _cust = str(rec.get("customer", "") or rec.get("customer_email", "") or "")
        tk.Label(win, text=f"Quote Review -- {_subj[:70]}", font=(_FONT, 14, "bold"),
                 fg=_ACCENT, bg=_BG).pack(anchor="w", padx=14, pady=(10, 0))
        _closed_ct = sum(1 for r in rows if r.get("status") in ("quoted", "no_bid"))
        _state_line = (f"Customer: {_cust or 'unknown'}   |   {_closed_ct} of {len(rows)} line(s) closed out"
                       + ("   |   EVERYTHING QUOTED" if not outstanding else ""))
        tk.Label(win, text=_state_line, bg=_BG,
                 fg=("#5bd17a" if not outstanding else _FG_DIM)).pack(anchor="w", padx=14, pady=(0, 8))

        holder = tk.Frame(win, bg=_BG)
        holder.pack(fill="both", expand=True, padx=12, pady=(0, 4))
        # v4.2.75: taller rows so the bigger item font breathes; scoped style so no
        # other Treeview in the app changes.
        try:
            _st = ttk.Style(win)
            _st.configure("QuoteReview.Treeview", rowheight=30)
            _tree_style = "QuoteReview.Treeview"
        except Exception:
            _tree_style = "Treeview"
        tree = ttk.Treeview(holder, columns=("status", "price", "avail"),
                            show="tree headings", selectmode="browse", style=_tree_style)
        tree.heading("#0", text="Requested item  /  vendor")
        # v4.2.77 (Steve): 430 + stretch=True made this column swallow ALL window
        # slack -- ttk returns freed space to the only stretchable column, so it
        # opened huge AND a drag to shrink it snapped straight back. Fixed width
        # 280 (stretch off) makes it resizable/persistable; the LAST column now
        # takes the slack instead.
        tree.column("#0", width=280, minwidth=180, anchor="w", stretch=False)
        for cid, lab, w_ in (("status", "Status", 130), ("price", "Price", 110),
                             ("avail", "Stock / Lead", 160)):
            tree.heading(cid, text=lab)
            tree.column(cid, width=w_, minwidth=60, anchor="w", stretch=(cid == "avail"))
        vsb = ttk.Scrollbar(holder, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=vsb.set)
        vsb.pack(side="right", fill="y")
        tree.pack(side="left", fill="both", expand=True)
        # item rows: bigger + bold, colored by line status (coverage-window palette)
        for _tag, _color in (("item_quoted", "#5bd17a"), ("item_outstanding", "#3ea6ff"),
                             ("item_waiting", "#e6c84a"), ("item_partial", "#e69a3e"),
                             ("item_no_bid", "#9aa0a6"), ("item_check", "#ff9933")):
            tree.tag_configure(_tag, foreground=_color, font=(_FONT, _FONT_SIZE + 2, "bold"))
        tree.tag_configure("vend_quoted", foreground=_FG)
        tree.tag_configure("vend_waiting", foreground=_FG_DIM)
        tree.tag_configure("vend_replied", foreground="#e6c84a")
        tree.tag_configure("vend_none", foreground=_FG_DIM)

        _replied_vendors = set()
        for _r in replies:
            _v = extract_email_address(str((_r or {}).get("vendor", "") or "")).lower()
            if _v:
                _replied_vendors.add(_v)
        for row in rows:
            req = row.get("req", {}) if isinstance(row.get("req"), dict) else {}
            _lid = str(req.get("line_id", "") or "")
            _st_line = str(row.get("status", "outstanding"))
            _item_tag = "item_" + (_st_line if _st_line in
                                   ("quoted", "outstanding", "waiting", "partial", "no_bid", "check")
                                   else "outstanding")
            parent = tree.insert("", "end", open=True,
                                 text=str(row.get("display", "") or ""),
                                 values=(_st_line.replace("_", " ").upper(), "", ""),
                                 tags=(_item_tag,))
            # ---- per-vendor detail rows ----
            # vendors this line was SENT to (Phase 2.2 ledger)
            _asked = []
            for _s in sends:
                if isinstance(_s, dict) and _lid and _lid in (_s.get("line_ids") or []):
                    _v = extract_email_address(str(_s.get("vendor", "") or "")) or str(_s.get("vendor", "") or "")
                    _v = _v.lower()
                    if _v and _v not in _asked:
                        _asked.append(_v)
            # newest matched quoted row PER VENDOR (a vendor may re-quote; show latest)
            _by_vendor = {}
            for _q in quoted:
                if not isinstance(_q, dict):
                    continue
                try:
                    if coverage_items_match(req, _q) and _coverage_distinctive_match_ok(req, _q, common):
                        _ve = extract_email_address(str(_q.get("vendor_email", "") or "")).lower()
                        if not _ve:
                            _ve = "(unidentified vendor)"
                        _prev = _by_vendor.get(_ve)
                        if _prev is None or str(_q.get("quoted_at", "")) >= str(_prev.get("quoted_at", "")):
                            _by_vendor[_ve] = _q
                except Exception:
                    continue
            _vends = list(_asked) + [v for v in _by_vendor if v not in _asked]
            if not _vends:
                tree.insert(parent, "end", text="    -- not sent to any vendor yet --",
                            values=("", "", ""), tags=("vend_none",))
            for _v in _vends:
                _q = _by_vendor.get(_v)
                if _q is not None:
                    _pr = str(_q.get("price", "") or "") or extract_price_fragment(
                        str(_q.get("description", "") or ""))
                    _av = str(_q.get("availability", "") or "") or extract_availability_note(
                        str(_q.get("description", "") or ""))
                    _vstat, _vtag = "Quoted", "vend_quoted"
                elif _v in _replied_vendors:
                    _pr, _av = "", ""
                    _vstat, _vtag = "Replied -- see email", "vend_replied"
                else:
                    _pr, _av = "", ""
                    _vstat, _vtag = "Waiting", "vend_waiting"
                tree.insert(parent, "end", text="    " + _v,
                            values=(_vstat, _pr, _av or ("--" if _q is not None else "")),
                            tags=(_vtag,))

        foot = tk.Frame(win, bg=_BG)
        foot.pack(fill="x", padx=14, pady=(4, 12))
        tk.Label(foot, text="Each item shows every vendor it went to -- their status, price and stock/lead info.",
                 bg=_BG, fg=_FG_DIM).pack(side="left")

        def _close(event=None):
            try:
                win.destroy()
            except Exception:
                pass

