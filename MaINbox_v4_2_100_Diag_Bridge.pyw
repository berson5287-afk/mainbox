        parent = getattr(self, "_inbox_viewer_win", None) or self.root
        win = tk.Toplevel(parent)
        win.title("Inbox Viewer -- Deleted Items History")
        remember_window_geometry(win, "MaINbox Inbox Viewer Deleted History", "760x420")
        win.transient(parent)
        apply_theme(win)
        tk.Label(win, text="Deleted Items History", font=(_FONT, 14, "bold"),
                 fg=_ACCENT, bg=_BG).pack(anchor="w", padx=14, pady=(12, 2))
        tk.Label(win, text="These emails sit in Outlook's Deleted Items and can be restored. "
                           "Enter restores the selected rows.",
                 bg=_BG, fg=_FG_DIM, wraplength=700, justify="left").pack(anchor="w", padx=14, pady=(0, 6))
        holder = tk.Frame(win, bg=_BG)
        holder.pack(fill="both", expand=True, padx=14, pady=4)
        cols = ("deleted_at", "sender", "subject", "folder")
        tree = ttk.Treeview(holder, columns=cols, show="headings", selectmode="extended")
        for cid, label, width in (("deleted_at", "Deleted", 140), ("sender", "From", 160),
                                  ("subject", "Subject", 320), ("folder", "Mailbox", 100)):
            tree.heading(cid, text=label)
            tree.column(cid, width=width, minwidth=60, anchor="w", stretch=(cid == "subject"))
        vsb = ttk.Scrollbar(holder, orient="vertical", command=tree.yview)
        tree.configure(yscrollcommand=vsb.set)
        vsb.pack(side="right", fill="y")
        tree.pack(side="left", fill="both", expand=True)

        def reload_rows():
            try:
                tree.delete(*tree.get_children())
            except Exception:
                return
            for i, rec in enumerate(self._load_inbox_viewer_deleted()):
                tree.insert("", "end", iid=f"del:{i}",
                            values=(rec.get("deleted_at", "").replace("T", " "),
                                    rec.get("sender", ""), rec.get("subject", ""),
                                    rec.get("folder", "")))
        reload_rows()

        def do_restore(event=None):
            hist = self._load_inbox_viewer_deleted()
            picked = []
            for iid in tree.selection():
                try:
                    picked.append(hist[int(str(iid).split(":", 1)[1])])
                except Exception:
                    continue
            if picked:
                self._inbox_viewer_undelete(picked, on_finish=reload_rows)

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=14, pady=10)
        restore_btn = tk.Button(btns, text="Restore Selected", command=do_restore, width=16,
                                bg=_ACCENT, fg="#ffffff", activebackground=_ACCENT2,
                                activeforeground="#ffffff", font=(_FONT, _FONT_SIZE, "bold"))
        restore_btn.pack(side="right", padx=4)
        tk.Button(btns, text="Close", command=win.destroy, width=10).pack(side="right", padx=4)
        win.bind("<Return>", do_restore)
        win.bind("<Escape>", lambda e: win.destroy())
        try:
            restore_btn.focus_set()
        except Exception:
            pass

    def _inbox_viewer_clear_deleted_history(self, parent):
        """Settings -> Clear Deleted History. PERMANENT: purges those emails
        from Outlook's Deleted Items, then empties the history."""
        hist = self._load_inbox_viewer_deleted()
        if not hist:
            messagebox.showinfo("Deleted History", "The deleted history is empty.", parent=parent)
            return
        ok = messagebox.askyesno(
            "Permanently Delete?",
            f"This will PERMANENTLY delete {len(hist)} email(s) from Outlook's Deleted "
            f"Items and empty the history.\n\nThey can NOT be restored afterwards. Continue?",
            parent=parent)
        if not ok:
            return
        jobs = [dict(r) for r in hist]

        def work(outlook, namespace):
            purged = 0
            for rec in jobs:
                try:
                    folder = self._inbox_viewer_locate_deleted_items(namespace, rec.get("store_id", ""))
                    msg = self._inbox_viewer_find_by_message_id(folder, rec.get("message_id", ""))
                    if msg is not None:
                        msg.Delete()  # deleting inside Deleted Items = permanent
                        purged += 1
                except Exception:
                    continue
            return purged

        def done(purged):
            self._save_inbox_viewer_deleted([])
            # v4.2.65 (Steve): clearing the viewer history means COMPLETELY out
            # of MaINbox too -- the emails are permanently gone from Outlook, so
            # drop their app Deleted History snapshots, status records and any
            # group memberships. Nothing can re-import them.
            try:
                _eids = {str(r.get("entry_id", "") or "") for r in jobs if r.get("entry_id")}
                _mids = {str(r.get("message_id", "") or "") for r in jobs if r.get("message_id")}
                _removed_app = 0
                _before = len(self.deleted_history)
                self.deleted_history = [
                    r for r in self.deleted_history
                    if str(r.get("entry_id", "") or "") not in _eids
                    and str(r.get("internet_message_id", "") or "") not in _mids]
                _removed_app += _before - len(self.deleted_history)
                for eid in list(self.status_data.keys()):
                    rec = self.status_data.get(eid)
                    if not isinstance(rec, dict):
                        continue
                    if eid in _eids or str(rec.get("internet_message_id", "") or "") in _mids:
                        self.status_data.pop(eid, None)
                        self.groups_data.get("memberships", {}).pop(eid, None)
                        _removed_app += 1
                if _removed_app:
                    self.save_deleted_history()
                    self.flush_status_data()
                    self.save_groups()
                    ops_log("inbox_viewer", "purge_mirrored_to_app", removed=_removed_app)
            except Exception:
                pass
            note = f"Deleted history cleared: {purged or 0} email(s) permanently removed" \
                   f"{'' if (purged or 0) == len(jobs) else f' ({len(jobs) - (purged or 0)} already gone from Outlook)'}."
            try:
                self._inbox_viewer_status_var.set(note)
            except Exception:
                pass
            ops_log("inbox_viewer", "deleted_history_cleared", purged=purged or 0, records=len(jobs))
            try:
                messagebox.showinfo("Deleted History", note, parent=parent)
            except Exception:
                pass

        def error(exc):
            try:
                messagebox.showerror("Deleted History", f"Could not clear: {exc}", parent=parent)
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-purge")


    def sync_vendor_history_to_procurement_memory(self):
        """Keep RFQ-learned vendor_history visible in the exported procurement SQLite DB.

        MaINbox has two related stores:
        - vendor_history: learned when the user manually teaches/uses RFQ vendors
        - procurement_memory: used by Import/Export SQLite and purchase-history routing

        Older builds saved some taught vendors only to vendor_history, so exporting the
        learned DB could appear unchanged after teaching more vendors.  This sync is
        non-destructive and does not double-count repeated saves.
        """
        try:
            hist = self.vendor_history if isinstance(self.vendor_history, dict) else default_vendor_history()
            mem = self.procurement_memory if isinstance(self.procurement_memory, dict) else default_procurement_memory()
            mem.setdefault("vendors", {})
            mem.setdefault("materials", {})
            mem.setdefault("routing_rules", {})

            for email, v in (hist.get("vendors", {}) or {}).items():
                email = str(email or v.get("email", "") or "").lower().strip()
                name = str((v or {}).get("name", "") or email).strip()
                if not email or is_blocked_internal_vendor(email, name):
                    continue
                times_used = int((v or {}).get("times_used", 0) or 0)
                pv = mem["vendors"].setdefault(email, {"email": email, "name": name, "request_count": 0, "award_count": 0})
                if name:
                    pv["name"] = name
                pv["request_count"] = max(int(pv.get("request_count", 0) or 0), times_used)
                if (v or {}).get("last_used_at"):
                    pv["last_used_at"] = (v or {}).get("last_used_at")

            for key, entries in (hist.get("materials", {}) or {}).items():
                key = str(key or "").strip()
                if not key:
                    continue
                mrec = mem["materials"].setdefault(key, {"key": key, "sample_description": "", "vendors": {}})
                mrec.setdefault("vendors", {})
                for rec in entries or []:
                    if not isinstance(rec, dict):
                        continue
                    email = str(rec.get("email", "") or "").lower().strip()
                    name = str(rec.get("name", "") or email).strip()
                    if not email or is_blocked_internal_vendor(email, name):
                        continue
                    stat = mrec["vendors"].setdefault(email, {"email": email, "name": name, "request_count": 0, "award_count": 0})
                    if name:
                        stat["name"] = name
                    times_used = int(rec.get("times_used", 0) or 0)
                    stat["request_count"] = max(int(stat.get("request_count", 0) or 0), times_used)
                    if rec.get("last_used_at"):
                        stat["last_requested_at"] = rec.get("last_used_at")
                    if rec.get("sample_description") and not mrec.get("sample_description"):
                        mrec["sample_description"] = rec.get("sample_description", "")
                    mem["routing_rules"].setdefault(key, [])
                    if email not in mem["routing_rules"][key]:
                        mem["routing_rules"][key].append(email)

            self.procurement_memory = mem
            return True
        except Exception:
            return False

    def save_vendor_history(self):
        purge_blocked_vendors_from_vendor_history(self.vendor_history)
        self.vendor_history["updated_at"] = datetime.now().isoformat()
        save_json(VENDOR_HISTORY_FILE, self.vendor_history)
        if self.sync_vendor_history_to_procurement_memory():
            purge_blocked_procurement_vendors_from_memory(self.procurement_memory)
            self.procurement_memory["updated_at"] = datetime.now().isoformat()
            save_json(PROCUREMENT_MEMORY_FILE, self.procurement_memory)

