        return
    try:
        with open(COVERAGE_DEBUG_FILE, "a", encoding="utf-8") as _fh:
            _fh.write(f"{datetime.now().isoformat()}  {msg}\n")
    except Exception:
        pass


def mainbox_version_number():
    """v3.9.105: numeric app version parsed from APP_TITLE (e.g. "3.9.105").

    Used for the Brain-bridge heartbeat so the reported version can never go
    stale again (it was hardcoded "3.9.42" long after that release)."""
    try:
        m = re.search(r"v(\d+(?:\.\d+)+)", APP_TITLE)
        return m.group(1) if m else "0.0.0"
    except Exception:
        return "0.0.0"


# v4.1.19 AUDIT FIX (external audit finding #9): APP_VERSION was still the literal "v3",
# so cloud-bridge config, backup manifests, DB metadata, and diagnostics identified a
# v4.1.x build as v3. Derive the ONE canonical version from APP_TITLE (same source the
# window title and heartbeat already use) so it can never drift again.
try:
    APP_VERSION = "v" + mainbox_version_number()
except Exception:
    pass


def _debug_artifact_housekeeping():
    """v3.9.105: keep diagnostic artifacts bounded so they can stay enabled.

    coverage_debug.log lives in AppData and only ever appends -- with
    COVERAGE_DEBUG on it grows forever. Rotate it once per launch: past ~5 MB,
    keep only the newest ~1 MB (a truncated head is fine for a debug tail-log).
    The RFQ attachment debug dir keeps a proof copy of every scanned attachment;
    prune copies older than 14 days. Best-effort and fully guarded: housekeeping
    must never affect startup."""
    try:
        if os.path.exists(COVERAGE_DEBUG_FILE) and os.path.getsize(COVERAGE_DEBUG_FILE) > 5 * 1024 * 1024:
            with open(COVERAGE_DEBUG_FILE, "rb") as _fh:
                _fh.seek(-1024 * 1024, os.SEEK_END)
                tail = _fh.read()
            nl = tail.find(b"\n")
            if nl >= 0:
                tail = tail[nl + 1:]
            with open(COVERAGE_DEBUG_FILE, "wb") as _fh:
                _fh.write(b"[log rotated by MaINbox housekeeping]\n" + tail)
    except Exception:
        pass
    try:
        if os.path.isdir(RFQ_DEBUG_DIR):
            cutoff = (datetime.now() - timedelta(days=14)).timestamp()
            for name in os.listdir(RFQ_DEBUG_DIR):
                p = os.path.join(RFQ_DEBUG_DIR, name)
                try:
                    if os.path.isfile(p) and os.path.getmtime(p) < cutoff:
                        os.remove(p)
                except Exception:
                    continue
    except Exception:
        pass
    # v4.1.97: reclaim ORPHANED attachment scratch directories.
    #
    # Every attachment scan makes a tempfile.mkdtemp() and every one of those sites already
    # ends in `finally: shutil.rmtree(temp_root, ignore_errors=True)` -- so this is NOT a
    # missing cleanup. It is a SILENT one: ignore_errors=True swallows the failure, and these
    # dirs hold .xlsx files that MaINbox opens through Excel COM, which routinely still holds
    # a handle when the rmtree runs. The delete fails, nothing ever retries, and the directory
    # is orphaned forever. Measured on the live machine: 1,238 dirs / 782 MB going back two
    # months, 77 of them from a single day -- on the same drive that hit 0 bytes free today
    # and silently stopped save_quote_coverage.
    #
    # Deliberately conservative: only our own prefixes, only in the temp dir, and only when
    # untouched for 6+ hours, so a scan running RIGHT NOW is never disturbed (the longest
    # observed scan is minutes, not hours). Counted and ops-logged so the reclaim is
    # measurable rather than invisible.
    try:
        _tmp = tempfile.gettempdir()
        _cut = (datetime.now() - timedelta(hours=6)).timestamp()
        _prefixes = ("mainbox_cov_", "mainbox_cov_req_", "mainbox_smartscan_pages_",
                     "mainbox_smartscan_merged_", "mainbox_qie_", "mainbox_commit_")
        _removed = 0
        _bytes = 0
        _failed = 0
        for _name in os.listdir(_tmp):
            if not _name.startswith(_prefixes):
                continue
            _p = os.path.join(_tmp, _name)
            try:
                if not os.path.isdir(_p) or os.path.getmtime(_p) >= _cut:
                    continue
                _sz = 0
                for _r, _d, _fs in os.walk(_p):
                    for _f in _fs:
                        try:
                            _sz += os.path.getsize(os.path.join(_r, _f))
                        except Exception:
                            pass
                shutil.rmtree(_p, ignore_errors=True)
                if os.path.isdir(_p):
                    _failed += 1          # still locked -- a later launch will retry
                else:
                    _removed += 1
                    _bytes += _sz
            except Exception:
                continue
        if _removed or _failed:
            try:
                ops_log("perf", "temp_scratch_reclaimed", dirs=_removed,
                        mb=round(_bytes / 1048576.0, 1), still_locked=_failed)
            except Exception:
                pass
    except Exception:
        pass
