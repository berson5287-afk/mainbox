            elif profile == "balanced":
                followup_conf_var.set(0.78)
                triage_conf_var.set(0.68)
                relevance_var.set(0.72)
                spam_var.set(0.35)
                rescan_hours_var.set(12.0)
                scan_limit_var.set(20)
                preset_hint.config(text="Balanced = current recommended behavior for daily business use.")
            elif profile == "fast":
                followup_conf_var.set(0.66)
                triage_conf_var.set(0.58)
                relevance_var.set(0.64)
                spam_var.set(0.45)
                rescan_hours_var.set(4.0)
                scan_limit_var.set(35)
                preset_hint.config(text="Fast = learns quicker and scans more, but may need more correction if it over-learns.")
            elif profile == "aggressive":
                # v4.1.51: every dial at its most aggressive allowed value, learned
                # rules apply immediately (no confirm gate), and unambiguous category
                # corrections durably type the sender. The Sticky-Type + Low-Floor
                # clamps still protect typed Customers/Vendors from auto-junking no
                # matter how aggressive these dials are.
                followup_conf_var.set(0.50)
                triage_conf_var.set(0.40)
                relevance_var.set(0.40)
                spam_var.set(0.45)
                rescan_hours_var.set(AI_ENGINE_MIN_RESCAN_HOURS_FLOOR)
