def email_is_courtesy_closer(subject="", body=""):
    """v4.1.17: True when an inbound message is ONLY a courtesy acknowledgement --
    'thanks', 'got it', 'sounds good', 'don't worry about it', 'we're all set' --
    with no request, PO, or waiting language mixed in. This is the single
    content-based exception that lets triage set a known customer/vendor email to
    Low/Completed; everything else from a typed C/V sender floors at Normal.
    Reuses analyze_reply_intent so the exact same closed-ack rules (strong
    one-line patterns, short-body phrase match, request-term override) apply."""
    try:
        intent = analyze_reply_intent(subject=subject, body=body, direction="inbound")
        return bool(intent.get("is_closed_ack")) and intent.get("intent") != "won_order"
    except Exception:
        return False


