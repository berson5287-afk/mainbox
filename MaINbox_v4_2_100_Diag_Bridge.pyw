def extract_json_object(text):
    if not text:
        return None
    text = text.strip()
    try:
        return json.loads(text)
    except Exception:
        pass
    # Prefer an object, but also tolerate models that return a bare JSON array.
    start = text.find("{")
    end = text.rfind("}")
    if start >= 0 and end > start:
        try:
            return json.loads(text[start:end + 1])
        except Exception:
            pass
    astart = text.find("[")
    aend = text.rfind("]")
    if astart >= 0 and aend > astart:
        try:
            arr = json.loads(text[astart:aend + 1])
            if isinstance(arr, list):
                return {"materials": arr}
            return arr
        except Exception:
            return None
    return None


def ask_ollama_for_triage(subject, sender, body, groups, signal_context=None, related_subjects=None):
    """Ask local Ollama to classify an email using deterministic business signals as guidance."""
    if not OLLAMA_ENABLED or not AI_TRIAGE_ENABLED:
