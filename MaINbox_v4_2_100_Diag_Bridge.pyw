        tk.Button(top, text="Settings", width=9,
                  command=self.open_inbox_viewer_settings).pack(side="right", padx=3)
        tk.Button(top, text="Refresh", width=9,
                  command=self._inbox_viewer_refresh).pack(side="right", padx=3)
        tk.Button(top, text="New Email", width=10,
                  command=self._inbox_viewer_new_email).pack(side="right", padx=3)

        holder = tk.Frame(win, bg=_BG)
        holder.pack(fill="both", expand=True, padx=10, pady=(0, 4))
        self._inbox_viewer_layout_holder = holder
        self._build_inbox_viewer_layout()
        self._build_inbox_viewer_body()

        status_var = tk.StringVar(value="Loading...")
        self._inbox_viewer_status_var = status_var
        tk.Label(win, textvariable=status_var, bg=_BG, fg=_FG_DIM, anchor="w").pack(fill="x", padx=12, pady=(0, 8))

        self._inbox_viewer_rows = []
        self._inbox_viewer_sort = ("received", True)

        def _auto_tick():
            try:
                if not win.winfo_exists():
                    return
                self._inbox_viewer_refresh(quiet=True)
                win.after(120000, _auto_tick)
            except Exception:
                pass
        try:
            win.after(120000, _auto_tick)
        except Exception:
            pass

        self._inbox_viewer_refresh()

    def _inbox_viewer_refresh(self, quiet=False, _is_retry=False):
        win = getattr(self, "_inbox_viewer_win", None)
        try:
            if win is None or not win.winfo_exists():
                return
        except Exception:
            return
        if not quiet:
            try:
                self._inbox_viewer_status_var.set("Refreshing from Outlook...")
            except Exception:
                pass
        folder_sels = self._inbox_viewer_selected_folders()
        try:
            limit = int(self._load_inbox_viewer_config().get("scan_limit", 200))
        except Exception:
            limit = 200

        def work(outlook, namespace):
            return self._inbox_viewer_collect_work(namespace, folder_sels, limit)

        def done(result):
            try:
                if not win.winfo_exists():
                    return
            except Exception:
                return
            result = result or {}
            self._inbox_viewer_rows = result.get("rows", [])
            self._render_inbox_viewer_rows()
            errors = result.get("errors") or []
            if errors:
                try:
                    self.log("Inbox Viewer: " + "; ".join(str(e) for e in errors[:3]))
                except Exception:
                    pass
            ops_log("inbox_viewer", "refresh", rows=len(self._inbox_viewer_rows),
                    folders=len(folder_sels), errors=len(errors))
            # v4.2.41: every scan doubles as a reconciliation sweep.
            try:
                self._inbox_viewer_sync_sweep(self._inbox_viewer_rows)
            except Exception:
                pass

        def error(exc):
            try:
                if not win.winfo_exists():
                    return
            except Exception:
                return
            if "already busy" in str(exc) and not _is_retry:
                try:
                    self._inbox_viewer_status_var.set("Outlook worker busy -- retrying in 10s...")
                    win.after(10000, lambda: self._inbox_viewer_refresh(quiet=quiet, _is_retry=True))
                except Exception:
                    pass
                return
            try:
                self._inbox_viewer_status_var.set(f"Refresh failed: {exc}")
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-refresh")

    def _inbox_viewer_row_tags(self, row, my_cat):
        mine = bool(my_cat) and self.email_has_outlook_category(row.get("categories", ""), my_cat)
        if mine and row.get("unread"):
            return ("mine_unread",), True
        if mine:
            return ("mine",), True
        if row.get("unread"):
            return ("unread",), False
        return (), False

    def _fill_inbox_viewer_tree(self, tree, rows, my_cat, col_ids):
        """Sort + insert rows into one tree; returns own-category count."""
        sort_col, descending = getattr(self, "_inbox_viewer_sort", ("received", True))
        rows = list(rows)
        if sort_col == "received":
            rows.sort(key=lambda r: r.get("received_ts", 0.0), reverse=descending)
        else:
            rows.sort(key=lambda r: str(r.get(sort_col, "")).casefold(), reverse=descending)
        try:
            tree.delete(*tree.get_children())
        except Exception:
            return 0
        mine_count = 0
        seen = set()
        for idx, row in enumerate(rows):
            iid = row.get("entry_id") or f"ivrow:{idx}"
            if iid in seen:
                iid = f"{iid}:{idx}"
            seen.add(iid)
            tags, mine = self._inbox_viewer_row_tags(row, my_cat)
            if mine:
                mine_count += 1
            tree.insert("", "end", iid=iid,
                        values=tuple(str(row.get(c, "")) for c in col_ids), tags=tags)
        return mine_count

    def _render_inbox_viewer_rows(self):
        trees = getattr(self, "_inbox_viewer_trees", None) or []
        try:
            trees = [(label, t) for label, t in trees if t.winfo_exists()]
        except Exception:
            return
        if not trees:
            return
        rows = list(getattr(self, "_inbox_viewer_rows", []) or [])
        my_cat = getattr(self, "selected_sales_category", "") or ""
        col_ids = [s["id"] for s in self._inbox_viewer_column_specs()]
        # v4.2.40 linking: resolve each row to its MaINbox record -- EntryID
        # first, Message-ID fallback (survives Cached-Exchange EntryID churn) --
        # and surface the group name + workflow status right in the viewer.
        try:
            msgid_index = {}
            for e in getattr(self, "emails", None) or []:
                mid = str(e.get("internet_message_id", "") or "")
                if mid:
                    msgid_index[mid] = e
            for row in rows:
                rec = self.get_email_by_id(row.get("entry_id", ""))
                if rec is None and row.get("message_id"):
                    rec = msgid_index.get(str(row.get("message_id")))
                link_eid = rec.get("entry_id") if rec else row.get("entry_id", "")
                row["group"] = self.get_group_name_for_email(link_eid) or ""
                row["status"] = str(rec.get("status", "") or "") if rec else ""
        except Exception:
            pass
        # v4.2.39 Unclaimed view: within the SALES mailbox show only the user's
        # own rows, uncategorized rows, and rows tagged with nothing but the
        # neutral categories (default: Canals). Other mailboxes are untouched.
        cfg = self._load_inbox_viewer_config()
        unclaimed = bool(cfg.get("unclaimed_only", False))
        if unclaimed:
            neutral = {str(c).strip().casefold()
                       for c in (cfg.get("neutral_categories") or ["Canals"]) if str(c).strip()}
            sales_l = SALES_MAILBOX_NAME.lower()
            rows = [r for r in rows
                    if sales_l not in str(r.get("folder", "")).lower()
                    or self._inbox_viewer_row_is_unclaimed(r, my_cat, neutral)]
        split = trees[0][0] is not None
        mine_count = 0
        if not split:
            mine_count = self._fill_inbox_viewer_tree(trees[0][1], rows, my_cat, col_ids)
        else:
            # Self-heal the pane set: if the mailboxes in the data don't match
            # the panes on screen (picker changed, folder renamed), rebuild the
            # panes from the labels actually present, in configured order.
            want = [l for l in self._inbox_viewer_pane_labels()]
            extra = [l for l in dict.fromkeys(r.get("folder", "") for r in rows)
                     if l and l not in want]
            want = want + extra
            if want and want != getattr(self, "_inbox_viewer_built_labels", None):
                self._build_inbox_viewer_body(pane_labels=want)
                trees = getattr(self, "_inbox_viewer_trees", None) or []
            by_label = {}
            for row in rows:
                by_label.setdefault(row.get("folder", ""), []).append(row)
            for label, tree in trees:
                pane_rows = by_label.get(label, [])
                pane_mine = self._fill_inbox_viewer_tree(tree, pane_rows, my_cat, col_ids)
                mine_count += pane_mine
                header = (getattr(self, "_inbox_viewer_pane_headers", None) or {}).get(label)
                if header is not None:
                    mine_note = f"  |  {pane_mine} '{my_cat}'" if my_cat else ""
                    header.set(f"{label}  --  {len(pane_rows)} emails{mine_note}")
        try:
            stamp = datetime.now().strftime("%I:%M:%S %p")
            mine_note = f" | {mine_count} tagged '{my_cat}'" if my_cat else ""
            filt_note = " | Unclaimed view (Sales)" if unclaimed else ""
            self._inbox_viewer_status_var.set(
                f"{len(rows)} emails{mine_note}{filt_note} | updated {stamp}")
        except Exception:
            pass

    def _inbox_viewer_sort_by(self, col):
        cur_col, descending = getattr(self, "_inbox_viewer_sort", ("received", True))
        self._inbox_viewer_sort = (col, not descending if col == cur_col else (col == "received"))
        self._render_inbox_viewer_rows()

    def _inbox_viewer_selected_row(self):
        base = ""
        trees = [t for _l, t in getattr(self, "_inbox_viewer_trees", None) or []]
        active = getattr(self, "_inbox_viewer_active_tree", None)
        if active in trees:
            trees = [active] + [t for t in trees if t is not active]
        for tree in trees:
            try:
                sel = tree.selection()
            except Exception:
                sel = ()
            if sel:
                base = str(sel[0])
                break
        if not base:
            return None
        for row in getattr(self, "_inbox_viewer_rows", []) or []:
            eid = row.get("entry_id") or ""
            if eid and (base == eid or base.startswith(eid + ":")):
                return row
        return None

    def _inbox_viewer_open_selected(self):
        """Open the selected viewer row in Outlook (same main-thread reopen
        path as open_selected_email: GetItemFromID with store, then without)."""
        row = self._inbox_viewer_selected_row()
        if not row or not row.get("entry_id"):
            return
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            messagebox.showerror("Open Error", "Outlook is not available right now.",
                                 parent=getattr(self, "_inbox_viewer_win", None) or self.root)
            return
        msg = None
        try:
            if row.get("store_id"):
                msg = namespace.GetItemFromID(row["entry_id"], row["store_id"])
            else:
                msg = namespace.GetItemFromID(row["entry_id"])
        except Exception:
            try:
                msg = namespace.GetItemFromID(row["entry_id"])
            except Exception:
                msg = None
        if msg is None:
            messagebox.showerror("Open Error", "Could not reopen this email from Outlook. Try Refresh.",
                                 parent=getattr(self, "_inbox_viewer_win", None) or self.root)
            return
        try:
            msg.Display()
            try:
                inspector = msg.GetInspector
                if inspector:
                    inspector.Activate()
            except Exception:
                pass
        except Exception as e:
            messagebox.showerror("Open Error", f"Could not open email.\n\n{e}",
                                 parent=getattr(self, "_inbox_viewer_win", None) or self.root)

    def _inbox_viewer_compose(self, mode):
        """v4.2.37 Phase 3, per the locked decision: open Outlook PREFILLED and
        let the user hit Send there -- signatures, formatting, attachments and
        sent-item recording all behave exactly like Outlook. MaINbox never
        auto-sends. Same main-thread GetItemFromID reopen path as open/display."""
        row = self._inbox_viewer_selected_row()
        if not row or not row.get("entry_id"):
            return
        parent = getattr(self, "_inbox_viewer_win", None) or self.root
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            messagebox.showerror("Outlook Error", "Outlook is not available right now.", parent=parent)
            return
        msg = None
        try:
            if row.get("store_id"):
                msg = namespace.GetItemFromID(row["entry_id"], row["store_id"])
            else:
                msg = namespace.GetItemFromID(row["entry_id"])
        except Exception:
            try:
                msg = namespace.GetItemFromID(row["entry_id"])
            except Exception:
                msg = None
        if msg is None:
            messagebox.showerror("Outlook Error", "Could not reopen this email from Outlook. Try Refresh.", parent=parent)
            return
        try:
            if mode == "replyall":
                item = msg.ReplyAll()
            elif mode == "forward":
                item = msg.Forward()
            else:
                item = msg.Reply()
            item.Display()
            try:
                inspector = item.GetInspector
                if inspector:
                    inspector.Activate()
            except Exception:
                pass
            ops_log("inbox_viewer", "compose_opened", mode=mode)
        except Exception as e:
            messagebox.showerror("Outlook Error", f"Could not open the {mode} window.\n\n{e}", parent=parent)

    def _inbox_viewer_new_email(self):
        parent = getattr(self, "_inbox_viewer_win", None) or self.root
        outlook, namespace = self.fresh_outlook()
        if not outlook:
            messagebox.showerror("Outlook Error", "Outlook is not available right now.", parent=parent)
            return
        try:
            item = outlook.CreateItem(0)  # olMailItem
            item.Display()
            try:
                inspector = item.GetInspector
                if inspector:
                    inspector.Activate()
            except Exception:
                pass
            ops_log("inbox_viewer", "compose_opened", mode="new")
        except Exception as e:
            messagebox.showerror("Outlook Error", f"Could not open a new email window.\n\n{e}", parent=parent)

    def _inbox_viewer_context_menu(self, event):
        tree = getattr(event, "widget", None)
        if not isinstance(tree, ttk.Treeview):
            return
        self._inbox_viewer_active_tree = tree
        try:
            iid = tree.identify_row(event.y)
            if not iid:
                return
            if iid not in tree.selection():
                tree.selection_set(iid)
        except Exception:
            return
        menu = tk.Menu(tree, tearoff=0)
        menu.add_command(label="Open in Outlook", command=self._inbox_viewer_open_selected)
        menu.add_separator()
        menu.add_command(label="Reply", command=lambda: self._inbox_viewer_compose("reply"))
        menu.add_command(label="Reply All", command=lambda: self._inbox_viewer_compose("replyall"))
        menu.add_command(label="Forward", command=lambda: self._inbox_viewer_compose("forward"))
        menu.add_separator()
        menu.add_command(label="Send to RFQ", command=self._inbox_viewer_send_to_rfq)
        menu.add_separator()
        menu.add_command(label="Mark as Read", command=lambda: self._inbox_viewer_mark_read(True))
        menu.add_command(label="Mark as Unread", command=lambda: self._inbox_viewer_mark_read(False))
        menu.add_separator()
        menu.add_command(label="Delete (to Deleted Items)", command=self._inbox_viewer_delete_selected)
        # v4.2.39: toggle Outlook categories straight from the viewer. Checked
        # entries carry the mark; clicking flips that category on the selected
        # rows (each row toggles its own state). List = imported Sales
        # categories, plus anything already on the clicked row (so an
        # unexpected tag can always be unselected).
        try:
            rows_sel = self._inbox_viewer_rows_for_tree_selection(tree)
        except Exception:
            rows_sel = []
        if rows_sel:
            current = {p.strip().casefold()
                       for p in re.split(r"[;,]", str(rows_sel[0].get("categories", "") or ""))
                       if p.strip()}
            opts = []
            try:
                opts = list(self.load_sales_category_options() or [])
            except Exception:
                opts = []
            for p in re.split(r"[;,]", str(rows_sel[0].get("categories", "") or "")):
                p = p.strip()
                if p and not any(o.casefold() == p.casefold() for o in opts):
                    opts.append(p)
            if opts:
                cats_menu = tk.Menu(menu, tearoff=0)
                for cat in opts:
                    mark = "✓ " if cat.strip().casefold() in current else "  "
                    cats_menu.add_command(
                        label=mark + cat,
                        command=lambda c=cat, rr=rows_sel: self._inbox_viewer_toggle_category(rr, c))
                menu.add_separator()
                menu.add_cascade(label="Categories", menu=cats_menu)
        try:
            menu.tk_popup(event.x_root, event.y_root)
        finally:
            try:
                menu.grab_release()
            except Exception:
                pass
        return "break"

    def open_inbox_viewer_mailbox_picker(self):
        """Tick which inboxes the viewer shows. The list is enumerated live
        from Outlook on a worker; Enter saves (per Steve: every popup must
        confirm on plain Enter), Escape cancels."""
