def load_mainbox_settings():
    settings = load_json(MAINBOX_SETTINGS_FILE, default_mainbox_settings())
    if not isinstance(settings, dict):
        settings = default_mainbox_settings()
    merged = default_mainbox_settings()
    merged.update(settings)
    try:
        merged["font_size"] = max(7, min(18, int(merged.get("font_size", 9))))
    except Exception:
        merged["font_size"] = 9
    try:
        merged["auto_refresh_seconds"] = max(10, int(merged.get("auto_refresh_seconds", AUTO_REFRESH_SECONDS)))
    except Exception:
