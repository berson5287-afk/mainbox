        def purchase_history_hidden_key_from_parts(vendor_email="", vendor_name="", subject="", date="", description="", qty="", unit="", raw_line=""):
            """Stable key used to hide one bad Purchase History material row across rescans."""
            vendor_email = extract_email_address(str(vendor_email or "")).lower().strip()
            vendor_name = normalize_sender_memory_name(vendor_name)
            subject = re.sub(r"\s+", " ", str(subject or "").strip().lower())
            date = str(date or "").strip()
            description = re.sub(r"\s+", " ", str(description or "").strip().lower())
            qty = str(qty or "").strip().lower()
            unit = str(unit or "").strip().lower()
            raw_line = re.sub(r"\s+", " ", str(raw_line or "").strip().lower())
            base = "|".join([vendor_email, vendor_name, subject, date, description, qty, unit, raw_line])
            return hashlib.sha1(base.encode("utf-8", errors="ignore")).hexdigest()

        def purchase_history_hidden_key(c):
            return purchase_history_hidden_key_from_parts(
                c.get("vendor_email", ""),
                c.get("vendor_name", ""),
                c.get("subject", ""),
                c.get("date", ""),
                c.get("description", ""),
                c.get("qty", ""),
                c.get("unit", ""),
                c.get("raw_line", ""),
            )

        def is_purchase_history_hidden(c):
            try:
                return bool(purchase_hidden_rows.get(purchase_history_hidden_key(c)))
            except Exception:
                return False

        def save_purchase_history_hidden():
            purchase_hidden_data["updated_at"] = datetime.now().isoformat()
            save_json(PURCHASE_HISTORY_HIDDEN_FILE, purchase_hidden_data)

        def candidate_matches_purchase_type_filter(c):
            if is_purchase_history_hidden(c):
                return False
            code = normalize_email_type_code(c.get("sender_type") or c.get("type") or c.get("email_type") or "")
            selected_filter = str(purchase_type_filter_var.get() or "V").strip()
            if selected_filter == "All":
                return True
            if selected_filter == "Blank":
                return code == ""
            if selected_filter == "V + Blank":
                return code in ["", "V"]
            return code == selected_filter

        def visible_purchase_candidates():
            return [(idx, c) for idx, c in enumerate(candidates) if candidate_matches_purchase_type_filter(c)]

        def redraw(*args):
            tree.delete(*tree.get_children())
            visible = visible_purchase_candidates()
            for idx, c in visible:
                up = c.get("unit_price")
                up_txt = f"${up:.4g}" if isinstance(up, (int, float)) else ""
                sender_type = normalize_email_type_code(c.get("sender_type") or c.get("type") or c.get("email_type") or "")
                tree.insert("", "end", iid=str(idx), values=("☑" if c.get("selected", True) else "☐", c.get("date", ""), sender_type, c.get("vendor_name", ""), c.get("description", ""), c.get("qty", ""), c.get("unit", ""), up_txt, c.get("job", ""), c.get("subject", "")))
            status_var.set(f"Showing {len(visible)} of {len(candidates)} possible purchase/material row(s). Type filter: {purchase_type_filter_var.get() or 'V'}.")

        def set_all(flag):
            for c in candidates:
                c["selected"] = bool(flag)
            redraw()

        def toggle_row(event=None):
            iids = list(tree.selection())
            # Keyboard Space sometimes leaves focus on a row without it being selected yet.
            if not iids:
                focus_iid = tree.focus()
                if focus_iid:
                    iids = [focus_iid]
            for iid in iids:
                try:
                    candidates[int(iid)]["selected"] = not bool(candidates[int(iid)].get("selected", True))
                except Exception:
                    pass
            redraw()
            return "break"

        def toggle_row_from_space(event=None):
            return toggle_row(event)

        def hide_selected_purchase_history_rows(event=None):
            """Hide selected bad material rows without changing the sender's C/V/E/M type."""
            iids = list(tree.selection())
            if not iids:
                focus_iid = tree.focus()
                if focus_iid:
                    iids = [focus_iid]
            if not iids:
                messagebox.showinfo("No Row Selected", "Select one or more Purchase History rows to hide.", parent=win)
                return "break"
            hidden_count = 0
            for iid in iids:
                try:
                    c = candidates[int(iid)]
                except Exception:
                    continue
                key = purchase_history_hidden_key(c)
                if not key:
                    continue
                purchase_hidden_rows[key] = {
                    "hidden_at": datetime.now().isoformat(),
                    "vendor_email": c.get("vendor_email", ""),
                    "vendor_name": c.get("vendor_name", ""),
                    "subject": c.get("subject", ""),
                    "date": c.get("date", ""),
                    "description": c.get("description", ""),
                    "qty": c.get("qty", ""),
                    "unit": c.get("unit", ""),
                    "raw_line": c.get("raw_line", ""),
                }
                c["hidden"] = True
                c["selected"] = False
                hidden_count += 1
            if hidden_count:
                save_purchase_history_hidden()
            redraw()
            status_var.set(f"Hidden {hidden_count} Purchase History row(s). They will be skipped on future scans.")
            return "break"

        def show_selected_detail(event=None):
            sel = tree.selection()
            if not sel:
                return
            try:
                c = candidates[int(sel[0])]
            except Exception:
                return
            txt = (
                f"Vendor: {c.get('vendor_name','')} <{c.get('vendor_email','')}>\n"
                f"Type: {normalize_email_type_code(c.get('sender_type') or c.get('type') or c.get('email_type') or '') or 'Blank/Unknown'}\n"
                f"Date: {c.get('date','')}    Job/Group: {c.get('job','')}\n"
                f"Subject: {c.get('subject','')}\n"
                f"Raw line: {c.get('raw_line','')}\n"
            )
            details.config(state="normal")
            details.delete("1.0", tk.END)
            details.insert("1.0", txt)
            details.config(state="disabled")

        def normalize_sender_memory_name(value):
            """Normalize a display name for sender-level C/V/E/M memory matching."""
            value = str(value or "").strip().lower()
            value = re.sub(r"<[^>]+>", " ", value)
            value = re.sub(r"\([^)]*\)", " ", value)
            value = re.sub(r"['\"]", "", value)
            value = re.sub(r"\s+", " ", value).strip(" ,;")
            return value

        def build_learned_sender_type_index():
            """Build sender-level lookup from saved user corrections.

            mainbox_status.json is keyed by Outlook EntryID, which can change between
            PCs/accounts. For the purchase-history scanner we need a sender-level map:
            sender email/name -> C/V/E/M. This lets work/home copies of the status DB
            still block known Customers, Employees, and Marketing/System senders.
            """
            index = {"email": {}, "name": {}}

            def _bump(bucket, key, code):
                key = str(key or "").strip().lower()
                code = normalize_email_type_code(code)
                if not key or code not in ["C", "V", "E", "M"]:
                    return
                slot = index[bucket].setdefault(key, {"C": 0, "V": 0, "E": 0, "M": 0})
                slot[code] += 1

            def _consider_record(rec):
                if not isinstance(rec, dict):
                    return
                code = normalize_email_type_code(rec.get("email_type") or rec.get("type_code") or rec.get("contact_type"))
                if not code:
                    code = infer_email_type_code(rec)
                if code not in ["C", "V", "E", "M"]:
                    return

                sender_display = str(rec.get("sender") or rec.get("sender_name") or rec.get("from") or "").strip()
                sender_email = extract_email_address(str(rec.get("sender_email") or rec.get("email") or sender_display or "")).lower().strip()
                sender_name = normalize_sender_memory_name(sender_display)

                if sender_email:
                    _bump("email", sender_email, code)
                if sender_name:
                    _bump("name", sender_name, code)

            try:
                for rec in (self.status_data or {}).values():
                    _consider_record(rec)
            except Exception:
                pass
            try:
                for rec in (self.emails or []):
                    _consider_record(rec)
            except Exception:
                pass
            return index

        def choose_sender_memory_code(counts):
            """Choose C/V/E/M from vote counts. Non-vendor labels are safety filters."""
            if not counts:
                return ""
            c = int(counts.get("C", 0) or 0)
            v = int(counts.get("V", 0) or 0)
            e = int(counts.get("E", 0) or 0)
            m = int(counts.get("M", 0) or 0)
            non_vendor = c + e + m
            if non_vendor and non_vendor >= v:
                if c >= e and c >= m:
                    return "C"
                if e >= m:
                    return "E"
                return "M"
            if v:
                return "V"
            return ""

        sender_type_index = build_learned_sender_type_index()

        def learned_purchase_sender_type(sender_email="", sender_name=""):
            """Return learned C/V/E/M classification for this sender, using sender-level memory."""
            target_email = extract_email_address(str(sender_email or "")).lower().strip()
            target_name = normalize_sender_memory_name(sender_name)
            if not target_email and not target_name:
                return ""

            if target_email:
                code = choose_sender_memory_code(sender_type_index.get("email", {}).get(target_email))
                if code:
                    return code

            if target_name:
                code = choose_sender_memory_code(sender_type_index.get("name", {}).get(target_name))
                if code:
                    return code

            return ""

        def is_blocked_purchase_history_sender(sender_email="", sender_name=""):
            code = learned_purchase_sender_type(sender_email, sender_name)
            # Purchase history may only import known Vendors (V) or Unknown/blank senders.
            # Explicit Customer/Employee/Marketing classifications are always excluded.
            return code not in ["", "V"]

        def scan_worker(days, max_emails, source, purchase_only, search_text, sender_search_text="", use_ai_teacher=False):
            did_init = outlook_thread_init()
            out = []
            last_publish = {"count": 0}

            def publish_partial_status(message=None, force=False):
                """Show partial AI-teacher results during long scans so the window never looks stuck."""
                if not force and len(out) == last_publish.get("count", 0):
                    if message:
                        self.root.after(0, lambda m=message: status_var.set(m))
                    return
                last_publish["count"] = len(out)
                snapshot = [dict(x) for x in out]
                def _apply():
                    candidates[:] = snapshot
                    redraw()
                    if message:
                        status_var.set(message)
                self.root.after(0, _apply)

            def backup_partial_results():
                """Write a recoverable partial file during long AI teaching runs."""
                if not use_ai_teacher or not out:
                    return
                try:
                    os.makedirs(RFQ_DEBUG_DIR, exist_ok=True)
                    with open(PURCHASE_AI_BACKUP_FILE, "w", encoding="utf-8") as f:
                        json.dump({
                            "saved_at": datetime.now().isoformat(),
                            "rows_found": len(out),
                            "rows": out,
                        }, f, indent=2)
                except Exception:
                    pass

            try:
                # v3.9.105: show_error=False -- this runs on a WORKER thread, and
                # connect_outlook's messagebox from a non-main thread can hang Tk.
                # The RuntimeError below routes the failure onto this scan's own
                # (main-thread-marshaled) error path instead.
                outlook, namespace = connect_outlook(show_error=False)
                if not namespace:
                    raise RuntimeError("Could not connect to Outlook.")
                self.outlook = self.outlook or outlook
                # Pick folder without using stale UI-thread COM objects.
                folder = None
                if source == "My Inbox":
                    folder = namespace.GetDefaultFolder(6)
                else:
                    folders = namespace.Folders
                    for i in range(1, folders.Count + 1):
                        root = folders.Item(i)
                        if SALES_MAILBOX_NAME.lower() in str(root.Name).lower():
                            try:
                                folder = root.Folders.Item("Inbox")
                            except Exception:
                                folder = root
                            break
                    if folder is None:
                        folder = namespace.GetDefaultFolder(6)
                items = folder.Items
                items.Sort("[ReceivedTime]", True)
                cutoff = datetime.now() - timedelta(days=days)
                scanned = 0
                for msg in items:
                    if scanned >= max_emails:
                        break
                    scanned += 1
                    if scanned % 25 == 0:
                        self.root.after(0, lambda n=scanned, ai=use_ai_teacher: status_var.set(("AI teaching from old emails... " if ai else "Scanning old emails... ") + f"{n} checked, {len(out)} teaching row(s) found"))
                    try:
                        received = getattr(msg, "ReceivedTime", None)
                        if received:
                            try:
                                # pywin32 returns pywintypes datetime compatible with naive compare in many setups.
                                if received.replace(tzinfo=None) < cutoff:
                                    break
                            except Exception:
                                pass
                        subject = str(getattr(msg, "Subject", "") or "")
                        sender_name = str(getattr(msg, "SenderName", "") or "")
                        sender_email = extract_email_address(str(getattr(msg, "SenderEmailAddress", "") or sender_name))
                        if not sender_email:
                            try:
                                sender_email = extract_email_address(str(msg.Sender.GetExchangeUser().PrimarySmtpAddress or ""))
                            except Exception:
                                pass
                        if is_blocked_purchase_history_sender(sender_email, sender_name):
                            # User already taught MaINbox this sender is not a vendor.
                            continue
                        body = str(getattr(msg, "Body", "") or "")
                        sender_q = (sender_search_text or "").strip().lower()
                        if sender_q:
                            sender_blob = f"{sender_email} {sender_name}".lower()
                            sender_parts = [part for part in sender_q.replace(",", " ").split() if part]
                            if sender_parts and not all(part in sender_blob for part in sender_parts):
                                continue
                        combined_l = f"{subject}\n{sender_name}\n{sender_email}\n{body}".lower()
                        q = (search_text or "").strip().lower()
                        if q:
                            # Search anywhere in the email text. Quoted phrases are matched exactly; otherwise every typed word must appear.
                            if len(q) >= 2 and q[0] == '"' and q[-1] == '"':
                                ok_search = q[1:-1] in combined_l
                            else:
                                parts = [part for part in q.replace(",", " ").split() if part]
                                ok_search = all(part in combined_l for part in parts) if parts else True
                            if not ok_search:
                                continue
                        if purchase_only and not any(x in combined_l for x in ["purchase order", " po ", "quote", "quoted", "pricing", "price", "approved", "please order", "ordered", "invoice", "material request"]):
                            continue
                        if use_ai_teacher:
                            self.root.after(0, lambda n=scanned, found=len(out), subj=subject[:80]: status_var.set(f"AI teaching email {n}/{max_emails} — {found} row(s) found so far — {subj}"))
                            rows = ask_ollama_extract_purchase_history_from_email(subject, sender_name, sender_email, body)
                            if rows is None:
                                rows = []
                        else:
                            rows = self.purchase_history_candidate_lines(body)
                        if not rows:
                            continue
                        job = self.purchase_history_extract_job_hint(subject, body)
                        date_txt = ""
                        try:
                            date_txt = received.strftime("%m/%d/%Y") if received else ""
                        except Exception:
                            date_txt = str(received or "")[:10]
                        for r in rows:
                            if not is_likely_purchase_material_row(r):
                                continue
                            row_vendor_name = str(r.get("vendor_name", "") or sender_name or sender_email)
                            row_vendor_email = str(r.get("vendor_email", "") or sender_email)
                            if is_blocked_purchase_history_sender(row_vendor_email, row_vendor_name):
                                # Do not populate vendor purchase memory with known customers/employees/system senders.
                                continue
                            cand = {
                                "selected": True,
                                "date": date_txt,
                                "subject": subject[:240],
                                "vendor_name": row_vendor_name,
                                "vendor_email": row_vendor_email,
                                "sender_type": learned_purchase_sender_type(row_vendor_email, row_vendor_name),
                                "job": str(r.get("job", "") or job),
                                "qty": str(r.get("qty", "") or ""),
                                "unit": str(r.get("unit", "") or ""),
                                "description": str(r.get("description", "") or ""),
                                "part_number": str(r.get("part_number", "") or ""),
                                "unit_price": r.get("unit_price"),
                                "total_price": r.get("total_price"),
                                "raw_line": str(r.get("raw_line", "") or r.get("notes", "") or ""),
                                "confidence": str(r.get("confidence", "") or ""),
                                "source": str(r.get("source", "") or ("ollama_purchase_teacher" if use_ai_teacher else "heuristic")),
                            }
                            if is_purchase_history_hidden(cand):
                                continue
                            out.append(cand)
                        if use_ai_teacher and (scanned % PURCHASE_AI_BATCH_SIZE == 0 or len(out) != last_publish.get("count", 0)):
                            backup_partial_results()
                            publish_partial_status(f"AI teaching in progress... {scanned} email(s) checked, {len(out)} teaching row(s) found", force=True)
                    except Exception:
                        continue
            except Exception as exc:
                self.root.after(0, lambda e=exc: messagebox.showerror("Purchase History Scan Failed", str(e), parent=win))
            finally:
                backup_partial_results()
                outlook_thread_uninit(did_init)
                def done():
                    scan_running["flag"] = False
                    scan_btn.config(state="normal")
                    ai_teach_btn.config(state="normal")
                    candidates[:] = out
                    redraw()
                    if not out:
                        status_var.set("Scan finished. No likely purchase/material rows found for that range/search.")
                self.root.after(0, done)

        def start_scan_mode(use_ai_teacher=False):
            if scan_running["flag"]:
                return
            if use_ai_teacher and not messagebox.askyesno(
                "AI Teach From Search",
                "Llama will read the filtered old-email list and create material/vendor teaching rows for review. This can take a while. v2.9 uses a longer per-email timeout and shows partial results as it goes. Continue?",
                parent=win,
            ):
                return
            try:
                days = int(range_var.get() or "90")
                max_emails = int(max_var.get() or "500")
            except Exception:
                messagebox.showwarning("Invalid Range", "Please choose valid day/max email values.", parent=win)
                return
            candidates.clear()
            redraw()
            scan_running["flag"] = True
            scan_btn.config(state="disabled")
            ai_teach_btn.config(state="disabled")
            search_text = search_var.get().strip()
            sender_search_text = sender_search_var.get().strip()
            filter_bits = []
            if search_text:
                filter_bits.append(f"text: {search_text}")
            if sender_search_text:
                filter_bits.append(f"sender: {sender_search_text}")
            filter_msg = "; ".join(filter_bits)
            if use_ai_teacher:
                status_var.set(f"Connecting to Outlook; Llama will teach from filtered emails{': ' + filter_msg if filter_msg else ''}... Timeout: {PURCHASE_AI_TIMEOUT_SECONDS}s/email")
            elif filter_msg:
                status_var.set(f"Connecting to Outlook and scanning for {filter_msg}")
            else:
                status_var.set("Connecting to Outlook and scanning old emails...")
            threading.Thread(target=scan_worker, args=(days, max_emails, source_var.get(), purchase_only_var.get(), search_text, sender_search_text, use_ai_teacher), daemon=True).start()

        def start_scan():
            start_scan_mode(False)

        def start_ai_teach():
            start_scan_mode(True)

        def save_selected():
            # Save only rows currently allowed by the Purchase History Type filter.
            # With the default Type=V, blank/unknown senders will remain visible only if
            # the user intentionally changes the filter to Blank or V + Blank.
            selected = [c for c in candidates if c.get("selected", True) and candidate_matches_purchase_type_filter(c)]
            if not selected:
                messagebox.showinfo("Nothing Selected", "No rows are selected to save.", parent=win)
                return
            if not messagebox.askyesno("Save Purchase History", f"Save {len(selected)} selected row(s) into procurement memory?", parent=win):
                return
            now = datetime.now().isoformat()
            saved = 0
            mem = self.procurement_memory
            for c in selected:
                vendor_email = str(c.get("vendor_email", "") or "").lower().strip()
                vendor_name = str(c.get("vendor_name", "") or vendor_email).strip()
                if not vendor_email:
                    continue
                if is_blocked_purchase_history_sender(vendor_email, vendor_name):
                    continue
                item = {"qty": c.get("qty", ""), "unit": c.get("unit", ""), "description": c.get("description", ""), "part_number": c.get("part_number", ""), "notes": "learned from old email scanner"}
                key = canonical_material_key(item)
                if not key:
                    continue
                vrec = mem.setdefault("vendors", {}).setdefault(vendor_email, {"email": vendor_email, "name": vendor_name, "request_count": 0, "award_count": 0})
                vrec["name"] = vendor_name or vrec.get("name", vendor_email)
                vrec["award_count"] = int(vrec.get("award_count", 0) or 0) + 1
                vrec["last_awarded_at"] = now
                if c.get("job"):
                    vrec.setdefault("jobs", {})[c.get("job")] = int(vrec.setdefault("jobs", {}).get(c.get("job"), 0) or 0) + 1
                mrec = mem.setdefault("materials", {}).setdefault(key, {"key": key, "sample_description": item.get("description", ""), "vendors": {}})
                if item.get("description"):
                    mrec["sample_description"] = item.get("description", "")
                stat = mrec.setdefault("vendors", {}).setdefault(vendor_email, {"email": vendor_email, "name": vendor_name, "request_count": 0, "award_count": 0})
                stat["name"] = vendor_name or stat.get("name", vendor_email)
                stat["award_count"] = int(stat.get("award_count", 0) or 0) + 1
                stat["preferred"] = True
                stat["last_awarded_at"] = now
                if c.get("unit_price") is not None:
                    stat["last_unit_price"] = c.get("unit_price")
                award = {"created_at": now, "source": "old_email_scanner", "vendor": {"email": vendor_email, "name": vendor_name}, "material_key": key, "material": item, "group_id": "", "group_name": c.get("job", ""), "unit_price": c.get("unit_price"), "total_price": c.get("total_price"), "notes": f"Old email scan: {c.get('subject','')}"}
                mem.setdefault("awards", []).append(award)
                mem.setdefault("price_history", []).append({"created_at": now, "source": "old_email_scanner", "vendor_email": vendor_email, "vendor_name": vendor_name, "material_key": key, "description": item.get("description", ""), "qty": item.get("qty", ""), "unit": item.get("unit", ""), "unit_price": c.get("unit_price"), "total_price": c.get("total_price"), "job": c.get("job", ""), "notes": c.get("subject", "")})
                mem.setdefault("routing_rules", {}).setdefault(key, [])
                if vendor_email not in mem["routing_rules"][key]:
                    mem["routing_rules"][key].insert(0, vendor_email)
                saved += 1
            self.save_procurement_memory()
            status_var.set(f"Saved {saved} row(s) to procurement memory. Future RFQs can use this for vendor suggestions/routing.")
            messagebox.showinfo("Saved", f"Saved {saved} purchase-history row(s) to procurement memory.", parent=win)


        def _purchase_identity_key(email="", name=""):
            email = extract_email_address(str(email or "")).lower().strip()
            if email:
                return "sender_type::email::" + email
            nm = normalize_sender_memory_name(name)
            if nm:
                return "sender_type::name::" + nm
            return ""

        def save_purchase_sender_type(email="", name="", code=""):
            """Persist a sender-level C/V/E/M correction from the Purchase History grid."""
            code = normalize_email_type_code(code)
            email = extract_email_address(str(email or "")).lower().strip()
            name = str(name or "").strip()
            key = _purchase_identity_key(email, name)
            if not key:
                return False
            if code:
                self.status_data[key] = {
                    "category": "General",
                    "urgency": "Normal",
                    "status": "New",
                    "updated_at": datetime.now().isoformat(),
                    "sender_type": EMAIL_TYPE_NAMES.get(code, code),
                    "email_type": code,
                    "sender": name,
                    "sender_email": email,
                    "subject": "Sender type learned from Purchase History scanner",
                    "received": "",
                    "received_timestamp": 0,
                    "source": "purchase_history_sender_type_hotkey",
                    "learned_rule_source": "purchase_history_type_hotkey",
                }
            else:
                # Blank means forget this Purchase History sender-level override if it was created here.
                self.status_data.pop(key, None)
            self.flush_status_data()
            try:
                if email:
                    sender_type_index.setdefault("email", {})[email] = {"C": 0, "V": 0, "E": 0, "M": 0}
                    if code:
                        sender_type_index["email"][email][code] = 1
                nm = normalize_sender_memory_name(name)
                if nm:
                    sender_type_index.setdefault("name", {})[nm] = {"C": 0, "V": 0, "E": 0, "M": 0}
                    if code:
                        sender_type_index["name"][nm][code] = 1
            except Exception:
                pass
            return True

        def apply_purchase_type_to_selected(code):
            """Correct selected Purchase History candidate type and persist it as sender-level memory."""
            code = normalize_email_type_code(code)
            iids = list(tree.selection())
            if not iids:
                focus_iid = tree.focus()
                if focus_iid:
                    iids = [focus_iid]
            if not iids:
                messagebox.showinfo("No Row Selected", "Select one or more Purchase History rows first.", parent=win)
                return "break"
            changed = 0
            touched = []
            for iid in iids:
                try:
                    c = candidates[int(iid)]
                except Exception:
                    continue
                vendor_email = str(c.get("vendor_email", "") or "").lower().strip()
                vendor_name = str(c.get("vendor_name", "") or "").strip()
                if not save_purchase_sender_type(vendor_email, vendor_name, code):
                    continue
                # Update all visible/in-memory candidate rows with the same identity so the filter reacts immediately.
                target_email = extract_email_address(vendor_email).lower().strip()
                target_name = normalize_sender_memory_name(vendor_name)
                for cc in candidates:
                    cc_email = extract_email_address(str(cc.get("vendor_email", "") or "")).lower().strip()
                    cc_name = normalize_sender_memory_name(cc.get("vendor_name", ""))
                    if (target_email and cc_email == target_email) or (target_name and cc_name == target_name):
                        cc["sender_type"] = code
                        cc["email_type"] = code
                        cc["type"] = code
                changed += 1
                touched.append(vendor_email or vendor_name)
            redraw()
            show_selected_detail()
            label = code or "Blank"
            status_var.set(f"Updated {changed} selected sender type(s) to {label}. Saved to mainbox_status.json for future Purchase History scans.")
            return "break"

        def export_purchase_history_sqlite():
            path = filedialog.asksaveasfilename(
                parent=win,
                title="Export Procurement Memory SQLite",
                defaultextension=".db",
                filetypes=[("SQLite database", "*.db"), ("All files", "*.*")],
                initialfile="purchasing_memory.db",
            )
            if not path:
                return
            try:
                mem = self.procurement_memory or default_procurement_memory()
                conn = sqlite3.connect(path)
                cur = conn.cursor()
                cur.executescript("""
                PRAGMA journal_mode=WAL;
                CREATE TABLE IF NOT EXISTS vendors (
                    vendor_email TEXT PRIMARY KEY,
                    vendor_name TEXT,
                    request_count INTEGER DEFAULT 0,
                    award_count INTEGER DEFAULT 0,
                    last_awarded_at TEXT
                );
                CREATE TABLE IF NOT EXISTS material_records (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    material_key TEXT,
                    raw_text TEXT,
                    normalized_description TEXT,
                    description TEXT,
                    qty TEXT,
                    unit TEXT,
                    manufacturer TEXT,
                    part_number TEXT,
                    sku TEXT,
                    dimensions TEXT,
                    material_type TEXT,
                    finish TEXT,
                    schedule_rating TEXT,
                    vendor_email TEXT,
                    vendor_name TEXT,
                    unit_price REAL,
                    total_price REAL,
                    job TEXT,
                    subject TEXT,
                    source TEXT,
                    email_date TEXT,
                    created_at TEXT
                );
                CREATE TABLE IF NOT EXISTS aliases (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    material_key TEXT,
                    alias TEXT,
                    canonical_description TEXT
                );
                CREATE INDEX IF NOT EXISTS idx_material_records_key ON material_records(material_key);
                CREATE INDEX IF NOT EXISTS idx_material_records_vendor ON material_records(vendor_email);
                CREATE INDEX IF NOT EXISTS idx_material_records_desc ON material_records(normalized_description, description, raw_text);
                """)
                cur.execute("DELETE FROM vendors")
                cur.execute("DELETE FROM material_records")
                cur.execute("DELETE FROM aliases")
                for email, v in (mem.get("vendors", {}) or {}).items():
                    if not isinstance(v, dict):
                        continue
                    cur.execute(
                        "INSERT OR REPLACE INTO vendors(vendor_email, vendor_name, request_count, award_count, last_awarded_at) VALUES (?, ?, ?, ?, ?)",
                        (str(email or v.get("email", "")).lower(), v.get("name", ""), int(v.get("request_count", 0) or 0), int(v.get("award_count", 0) or 0), v.get("last_awarded_at", "")),
                    )
                for rec in (mem.get("price_history", []) or []):
                    if not isinstance(rec, dict):
                        continue
                    desc = rec.get("description", "") or rec.get("normalized_description", "") or rec.get("raw_text", "")
                    key = rec.get("material_key", "") or canonical_material_key({"description": desc, "part_number": rec.get("part_number", "")})
                    cur.execute(
                        """INSERT INTO material_records(material_key, raw_text, normalized_description, description, qty, unit, part_number, vendor_email, vendor_name, unit_price, total_price, job, subject, source, email_date, created_at)
                           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                        (key, rec.get("raw_text", ""), desc, desc, rec.get("qty", ""), rec.get("unit", ""), rec.get("part_number", ""), str(rec.get("vendor_email", "") or "").lower(), rec.get("vendor_name", ""), rec.get("unit_price"), rec.get("total_price"), rec.get("job", ""), rec.get("notes", ""), rec.get("source", "mainbox_export"), rec.get("email_date", ""), rec.get("created_at", "")),
                    )
                for key, m in (mem.get("materials", {}) or {}).items():
                    if not isinstance(m, dict):
                        continue
                    sample = m.get("sample_description", "")
                    if sample:
                        cur.execute("INSERT INTO aliases(material_key, alias, canonical_description) VALUES (?, ?, ?)", (key, sample, sample))
                conn.commit()
                conn.close()
                status_var.set(f"Exported procurement memory SQLite: {os.path.basename(path)}")
                messagebox.showinfo("Export Complete", f"Exported procurement memory to:\n{path}", parent=win)
            except Exception as exc:
                try:
                    conn.close()
                except Exception:
                    pass
                messagebox.showerror("SQLite Export Failed", str(exc), parent=win)

        def import_purchase_history_sqlite():
            path = filedialog.askopenfilename(
                parent=win,
                title="Import Procurement Memory SQLite",
                filetypes=[("SQLite database", "*.db;*.sqlite;*.sqlite3"), ("All files", "*.*")],
            )
            if not path:
                return
            if not messagebox.askyesno("Import SQLite", "Import this SQLite purchasing-memory file and merge it into MaINbox procurement memory?\n\nThis will not delete existing memory.", parent=win):
                return
            imported = 0
            skipped = 0
            try:
                conn = sqlite3.connect(path)
                conn.row_factory = sqlite3.Row
                cur = conn.cursor()
                table_names = {r[0].lower(): r[0] for r in cur.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()}
                # v2.9.5: SQLite import is a REPLACE, not merge. This prevents old
                # vendors/materials from surviving after the user cleaned the DB.
                mem = default_procurement_memory()
                mem.setdefault("materials", {})
                mem.setdefault("vendors", {})
                mem.setdefault("awards", [])
                mem.setdefault("price_history", [])
                mem.setdefault("routing_rules", {})
                now = datetime.now().isoformat()

                def first_value(row, names, default=""):
                    keys = set(row.keys())
                    for name in names:
                        if name in keys and row[name] is not None:
                            return row[name]
                    return default

                vendor_names = {}
                if "vendors" in table_names:
                    for row in cur.execute(f"SELECT * FROM {table_names['vendors']}"):
                        email = str(first_value(row, ["vendor_email", "email", "sender_email"], "") or "").lower().strip()
                        name = str(first_value(row, ["vendor_name", "name", "sender_name"], "") or email).strip()
                        if email and not is_blocked_internal_vendor(email, name):
                            vendor_names[email] = name
                            vrec = mem.setdefault("vendors", {}).setdefault(email, {"email": email, "name": name, "request_count": 0, "award_count": 0})
                            if name:
                                vrec["name"] = name

                material_table = None
                for possible in ["material_records", "materials", "purchase_history", "price_history", "line_items"]:
                    if possible in table_names:
                        material_table = table_names[possible]
                        break
                if not material_table:
                    raise RuntimeError("No supported material table found. Expected one of: material_records, materials, purchase_history, price_history, line_items.")

                rows = cur.execute(f"SELECT * FROM {material_table}").fetchall()
                for row in rows:
                    desc = str(first_value(row, ["normalized_description", "description", "material", "item", "raw_text", "line_text"], "") or "").strip()
                    raw_text = str(first_value(row, ["raw_text", "line_text", "source_text", "notes"], "") or desc).strip()
                    part_number = str(first_value(row, ["part_number", "part", "sku", "manufacturer_part_number", "mpn"], "") or "").strip()
                    vendor_email = str(first_value(row, ["vendor_email", "sender_email", "email"], "") or "").lower().strip()
                    vendor_name = str(first_value(row, ["vendor_name", "vendor", "sender_name", "company"], "") or vendor_names.get(vendor_email, vendor_email)).strip()
                    if not desc and not part_number:
                        skipped += 1
                        continue
                    if not vendor_email and vendor_name:
                        vendor_email = vendor_name.lower().replace(" ", "_")
                    if not vendor_email or is_blocked_internal_vendor(vendor_email, vendor_name):
                        skipped += 1
                        continue
                    item = {
                        "qty": str(first_value(row, ["qty", "quantity"], "") or ""),
                        "unit": str(first_value(row, ["unit", "uom"], "") or ""),
                        "description": desc,
                        "part_number": part_number,
                        "notes": "imported from SQLite PST memory",
                    }
                    key = str(first_value(row, ["material_key", "canonical_key", "key"], "") or "").strip() or canonical_material_key(item)
                    if not key:
                        skipped += 1
                        continue
                    vrec = mem.setdefault("vendors", {}).setdefault(vendor_email, {"email": vendor_email, "name": vendor_name, "request_count": 0, "award_count": 0})
                    if vendor_name:
                        vrec["name"] = vendor_name
                    vrec["award_count"] = int(vrec.get("award_count", 0) or 0) + 1
                    vrec["last_awarded_at"] = now
                    mrec = mem.setdefault("materials", {}).setdefault(key, {"key": key, "sample_description": desc, "vendors": {}})
                    if desc:
                        mrec["sample_description"] = desc
                    stat = mrec.setdefault("vendors", {}).setdefault(vendor_email, {"email": vendor_email, "name": vendor_name, "request_count": 0, "award_count": 0})
                    if vendor_name:
                        stat["name"] = vendor_name
                    stat["award_count"] = int(stat.get("award_count", 0) or 0) + 1
                    stat["preferred"] = True
                    stat["last_awarded_at"] = now
                    unit_price = first_value(row, ["unit_price", "price_each", "price"], None)
                    total_price = first_value(row, ["total_price", "extended_price", "total"], None)
                    try:
                        unit_price = float(unit_price) if unit_price not in (None, "") else None
                    except Exception:
                        unit_price = None
                    try:
                        total_price = float(total_price) if total_price not in (None, "") else None
                    except Exception:
                        total_price = None
                    if unit_price is not None:
                        stat["last_unit_price"] = unit_price
                    job = str(first_value(row, ["job", "group_name", "project", "customer"], "") or "")
                    subject = str(first_value(row, ["subject", "email_subject", "notes"], "") or "")
                    email_date = str(first_value(row, ["email_date", "date", "sent_date", "received_date", "timestamp"], "") or "")
                    mem.setdefault("awards", []).append({"created_at": now, "source": "sqlite_import", "vendor": {"email": vendor_email, "name": vendor_name}, "material_key": key, "material": item, "group_id": "", "group_name": job, "unit_price": unit_price, "total_price": total_price, "notes": f"SQLite import: {subject}"})
                    mem.setdefault("price_history", []).append({"created_at": now, "source": "sqlite_import", "vendor_email": vendor_email, "vendor_name": vendor_name, "material_key": key, "description": desc, "qty": item.get("qty", ""), "unit": item.get("unit", ""), "part_number": part_number, "unit_price": unit_price, "total_price": total_price, "job": job, "email_date": email_date, "raw_text": raw_text, "notes": subject})
                    mem.setdefault("routing_rules", {}).setdefault(key, [])
                    if vendor_email not in mem["routing_rules"][key]:
                        mem["routing_rules"][key].insert(0, vendor_email)
                    imported += 1

                conn.close()
                purge_blocked_procurement_vendors_from_memory(mem)

                # Keep both learned-vendor stores aligned with the imported SQLite DB.
                # Import is intentionally a replace, not a merge, so rebuild vendor_history
                # from the imported procurement memory before saving.
                hist = default_vendor_history()
                hist.setdefault("vendors", {})
                hist.setdefault("materials", {})
                hist.setdefault("customers", {})
                hist.setdefault("jobs", {})
                hist["updated_at"] = datetime.now().isoformat()
                for email, v in (mem.get("vendors", {}) or {}).items():
                    email = str(email or v.get("email", "") or "").lower().strip()
                    name = str((v or {}).get("name", "") or email).strip()
                    if email and not is_blocked_internal_vendor(email, name):
                        hist["vendors"][email] = {
                            "email": email,
                            "name": name,
                            "times_used": int((v or {}).get("request_count", 0) or 0),
                            "last_used_at": (v or {}).get("last_used_at", "") or (v or {}).get("last_awarded_at", ""),
                        }
                for key, m in (mem.get("materials", {}) or {}).items():
                    key = str(key or "").strip()
                    if not key:
                        continue
                    entries = []
                    for email, stat in ((m or {}).get("vendors", {}) or {}).items():
                        email = str(email or "").lower().strip()
                        name = str((stat or {}).get("name", "") or email).strip()
                        if email and not is_blocked_internal_vendor(email, name):
                            entries.append({
                                "email": email,
                                "name": name,
                                "times_used": int((stat or {}).get("request_count", 0) or 0),
                                "last_used_at": (stat or {}).get("last_requested_at", "") or (stat or {}).get("last_awarded_at", ""),
                                "sample_description": (m or {}).get("sample_description", ""),
                            })
                    if entries:
                        hist["materials"][key] = entries
                self.vendor_history = hist
                save_json(VENDOR_HISTORY_FILE, self.vendor_history)

                self.procurement_memory = mem
                self.save_procurement_memory()
                status_var.set(f"Imported {imported} row(s) from SQLite. Skipped {skipped} incomplete row(s).")
                messagebox.showinfo("Import Complete", f"Imported {imported} material/history row(s).\nSkipped {skipped} incomplete row(s).", parent=win)
            except Exception as exc:
                try:
                    conn.close()
                except Exception:
                    pass
                messagebox.showerror("SQLite Import Failed", str(exc), parent=win)

