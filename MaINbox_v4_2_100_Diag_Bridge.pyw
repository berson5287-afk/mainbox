    def open_deleted_history_window(self):
        win = tk.Toplevel(self.root)
        win.title("Deleted From App History")
        remember_window_geometry(win, "Deleted From App History", "1200x660")
        win.transient(self.root)

        search_frame = tk.LabelFrame(win, text="Search Deleted Emails")
        search_frame.pack(fill="x", padx=10, pady=(10, 4))
        tk.Label(search_frame, text="Search sender / subject / received / deleted / category:").pack(side="left", padx=6, pady=6)
        search_var = tk.StringVar()
        search_entry = tk.Entry(search_frame, textvariable=search_var, width=58)
        search_entry.pack(side="left", padx=6, pady=6)
        count_var = tk.StringVar(value="")
        tk.Label(search_frame, textvariable=count_var, fg=_FG_DIM).pack(side="right", padx=8)

        tree = ttk.Treeview(
            win,
            columns=("deleted", "received", "sender", "subject", "category", "urgency", "status"),
            show="headings",
            selectmode="extended"
        )
        for col, label, width in [
            ("deleted", "Deleted", 155),
            ("received", "Received", 145),
            ("sender", "Sender", 230),
            ("subject", "Subject", 430),
            ("category", "Category", 140),
            ("urgency", "Urgency", 75),
            ("status", "Status", 125),
        ]:
            tree.heading(col, text=label)
            tree.column(col, width=width)
        tree.pack(fill="both", expand=True, padx=10, pady=6)

        def build_cache_lookup():
            lookup = {}
            try:
                for bucket in self.cache_data.values():
                    for e in bucket.get("emails", []) if isinstance(bucket, dict) else []:
                        eid = e.get("entry_id", "")
                        if eid and eid not in lookup:
                            lookup[eid] = e
            except Exception:
                pass
            for e in self.emails:
                eid = e.get("entry_id", "")
                if eid:
                    lookup[eid] = e
            return lookup

        def looks_like_entry_id(text):
            value = str(text or "").strip()
            if len(value) < 30:
                return False
            # Outlook EntryIDs are often very long hex-like strings.
            return bool(re.fullmatch(r"[A-Fa-f0-9]+", value[:80]))

        def friendly_row(raw, cache_lookup):
            eid = raw.get("entry_id", "")
            cached = cache_lookup.get(eid, {}) if eid else {}
            st = self.status_data.get(eid, {}) if eid else {}
            sender = raw.get("sender") or st.get("sender") or cached.get("sender") or "(unknown sender)"
            subject = raw.get("subject") or st.get("subject") or cached.get("subject") or ""
            if looks_like_entry_id(subject) or not subject:
                subject = "(details unavailable — restore or run Update to reload from Outlook)"
            received = raw.get("received") or st.get("received") or cached.get("received") or ""
            deleted = raw.get("deleted_from_app_at") or raw.get("deleted") or st.get("deleted_from_app_at") or ""
            return {
                "entry_id": eid,
                "deleted": deleted,
                "received": received,
                "sender": sender,
                "subject": subject,
                "category": raw.get("category") or st.get("category") or cached.get("category") or "",
                "urgency": raw.get("urgency") or st.get("urgency") or cached.get("urgency") or "",
                "status": raw.get("status") or st.get("status") or cached.get("status") or "",
            }

        def collect_deleted_rows():
            rows = []
            seen = set()
            cache_lookup = build_cache_lookup()
            for row in self.deleted_history:
                if not isinstance(row, dict):
                    continue
                eid = row.get("entry_id", "")
                if not eid or eid in seen:
                    continue
                seen.add(eid)
                rows.append(friendly_row(row, cache_lookup))
            for eid, st in self.status_data.items():
                if st.get("app_deleted") and eid not in seen:
                    raw = dict(st)
                    raw["entry_id"] = eid
                    rows.append(friendly_row(raw, cache_lookup))
                    seen.add(eid)
            return rows

        def row_matches(row, query):
            if not query:
                return True
            haystack = " ".join(str(row.get(k, "")) for k in ["deleted", "received", "sender", "subject", "category", "urgency", "status"]).lower()
            return all(part in haystack for part in query.lower().split())

        def refresh(*_):
            tree.delete(*tree.get_children())
            query = search_var.get().strip()
            rows = collect_deleted_rows()
            visible = [r for r in rows if row_matches(r, query)]
            for row in visible:
                eid = row.get("entry_id", "")
                tree.insert("", "end", iid=eid, values=(
                    row.get("deleted", ""),
                    row.get("received", ""),
                    row.get("sender", "")[:70],
                    row.get("subject", "")[:140],
                    row.get("category", ""),
                    row.get("urgency", ""),
                    row.get("status", ""),
                ))
            count_var.set(f"Showing {len(visible)} of {len(rows)} deleted item(s)")

        def clear_search():
            search_var.set("")
            refresh()
            search_entry.focus_set()

        def restore():
            ids = list(tree.selection())
            if not ids:
                return
            if not messagebox.askyesno("Restore Emails", f"Restore {len(ids)} selected email(s) to MaINbox?", parent=win):
                return
            self.save_undo_state("restore deleted email(s)")
            restored = 0
            current_ids = {e.get("entry_id", "") for e in self.emails}
            _guard_changed = False
            for eid in ids:
                st = self.status_data.get(eid, {})
                st["app_deleted"] = False
                st["explicit_reopened_at"] = datetime.now().isoformat()
                st["workflow_closed_at"] = ""
                self.status_data[eid] = st
                snap = next((r for r in self.deleted_history if r.get("entry_id") == eid), None)
                _probe = dict(snap or st)
                _probe.setdefault("entry_id", eid)
                if self.clear_closed_email_guard(_probe, save=False):
                    _guard_changed = True
                if snap and eid not in current_ids:
                    email = dict(snap)
                    email.pop("deleted_from_app_at", None)
                    email["message"] = None
                    email["is_new_import"] = False
                    email["followup_time"] = self.get_followup_display_for_email(eid)
                    self.emails.append(email)
                    restored += 1
            self.deleted_history = [r for r in self.deleted_history if r.get("entry_id") not in ids]
            self._rebuild_email_index()
            if _guard_changed:
                self._save_closed_email_guard()
            self.flush_status_data()
            self.save_deleted_history()
            self.save_cached_state()
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            refresh()
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, f"Restored {restored} email(s) from MaINbox deleted history. If an older deleted item had no readable snapshot, run Update/Refresh to re-import it from Outlook.")

        search_var.trace_add("write", refresh)
        search_entry.bind("<Return>", refresh)
        btns = tk.Frame(win)
        btns.pack(fill="x", padx=10, pady=(0, 10))
        tk.Button(btns, text="Restore Selected", command=restore, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Clear Search", command=clear_search, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Refresh", command=refresh, width=10).pack(side="left", padx=4)
        tk.Button(btns, text="Close", command=win.destroy, width=10).pack(side="right", padx=4)
        refresh()
        search_entry.focus_set()

    def goto_email_in_app(self, entry_id):
        """Reveal and select an email in the main list, widening the filters and
        expanding its group as needed so the row actually exists. Returns True on
        success, False if the email can't be shown (e.g. removed/archived)."""
        email = self.get_email_by_id(entry_id)
        if not email:
            return False
        # Grouped emails only render under an expanded group header, so expand the
        # owning group and widen the group filter before re-rendering.
        try:
            gid = self.get_group_id_for_email(entry_id) or ""
        except Exception:
            gid = ""
        if gid:
            for g in self.groups_data.get("groups", []):
                if g.get("id") == gid:
                    g["collapsed"] = False
                    break
        try:
            self.active_group_filter = "all"
        except Exception:
            pass
        # Pick a status filter that includes this email ("all" hides Low/Completed),
        # then fall back across the broad views if the first guess doesn't show it.
        if email.get("urgency") == "Low":
            target = "low"
        elif email.get("status") == "Completed":
            target = "completed"
        else:
            target = "all"
        self.set_filter(target)
        if not self.tree.exists(entry_id):
            for f in ("all", "completed", "low"):
                if f == target:
                    continue
                self.set_filter(f)
                if self.tree.exists(entry_id):
                    break
        if self.tree.exists(entry_id):
            try:
                self.tree.selection_set(entry_id)
                self.tree.focus(entry_id)
                self.tree.see(entry_id)
                self.tree.focus_set()
            except Exception:
                pass
            return True
        return False

    def open_search_window_hotkey(self, event=None):
        """v4.1.88: Ctrl+F -> global search, type, Enter. The Search window ALREADY
        focuses its Find box and binds Return to the search (open_search_window:
        q_entry.focus_set() / q_entry.bind("<Return>", do_search)), so the only piece
        that was missing is the hotkey itself.

        If a Search window is already open this raises and re-focuses THAT one -- and
        re-focuses its Find box with the previous query selected, so a second Ctrl+F
        means "search for something else", not "stack another window". Deliberately
        does not touch open_search_window: the existing window is found by title, so
        that method stays byte-identical and this cannot regress the search itself.
        Returns "break" so the keystroke does not also reach the focused widget."""
        try:
            existing = None
            for w in self.root.winfo_children():
                try:
                    if (isinstance(w, tk.Toplevel) and w.winfo_exists()
                            and str(w.title()) == "Search MaINbox"):
                        existing = w
                        break
                except Exception:
                    continue
            if existing is None:
                self.open_search_window()
                return "break"
            try:
                existing.deiconify()
            except Exception:
                pass
            existing.lift()
            existing.focus_force()

            def _first_entry(widget, depth=0):
                # the Find box is the first Entry in the window; bounded recursion so a
                # deep/odd widget tree can never spin here
                if depth > 6:
                    return None
                try:
                    kids = widget.winfo_children()
                except Exception:
                    return None
                for k in kids:
                    if isinstance(k, tk.Entry):
                        return k
                for k in kids:
                    found = _first_entry(k, depth + 1)
                    if found is not None:
                        return found
                return None

            try:
                ent = _first_entry(existing)
                if ent is not None:
                    ent.focus_set()
                    ent.select_range(0, "end")
                    ent.icursor("end")
            except Exception:
                pass
        except Exception:
            # never let a hotkey raise into the Tk callback loop
            try:
                self.open_search_window()
            except Exception:
                pass
        return "break"

    def open_search_window(self):
        """Global search across loaded emails. Double-click / 'Go to in app' jumps to
        the row in the main list; multi-select + 'Delete from MaINbox' routes through
        the shared app-only delete (Outlook untouched, restorable from Deleted History)."""
        win = tk.Toplevel(self.root)
        win.title("Search MaINbox")
        remember_window_geometry(win, "MaINbox Search", "1120x680")
        try:
            apply_theme(win)
        except Exception:
            pass
        win.transient(self.root)

        bar = tk.LabelFrame(win, text="Search your loaded emails", bg=_BG2, fg=_ACCENT, font=(_FONT, 10, "bold"))
        bar.pack(fill="x", padx=10, pady=(10, 4))
        row1 = tk.Frame(bar, bg=_BG2)
        row1.pack(fill="x", padx=8, pady=(8, 2))
        tk.Label(row1, text="Find:", bg=_BG2, fg=_FG).pack(side="left")
        q_var = tk.StringVar()
        q_entry = tk.Entry(row1, textvariable=q_var, width=46, bg=_ENTRY_BG, fg=_FG, insertbackground=_FG)
        q_entry.pack(side="left", padx=6)
        tk.Button(row1, text="Search", command=lambda: do_search(),
                  bg=_ACCENT, fg="#ffffff", activebackground=_ACCENT2, activeforeground="#ffffff",
                  font=("Segoe UI", _FONT_SIZE, "bold")).pack(side="left", padx=6)
        count_var = tk.StringVar(value="Type words to match (all words must appear), then press Enter.")
        tk.Label(row1, textvariable=count_var, bg=_BG2, fg=_FG_DIM, anchor="w").pack(side="left", padx=10)
        row2 = tk.Frame(bar, bg=_BG2)
        row2.pack(fill="x", padx=8, pady=(0, 8))
        tk.Label(row2, text="In:", bg=_BG2, fg=_FG).pack(side="left")
        f_subject = tk.BooleanVar(value=True)
        f_sender = tk.BooleanVar(value=True)
        f_body = tk.BooleanVar(value=True)
        f_meta = tk.BooleanVar(value=True)
        f_group = tk.BooleanVar(value=True)
        for _txt, _var in (("Subject", f_subject), ("Sender", f_sender), ("Body", f_body),
                           ("Category/Status/Type", f_meta), ("Group", f_group)):
            tk.Checkbutton(row2, text=_txt, variable=_var, bg=_BG2, fg=_FG,
                           selectcolor=_BG3, activebackground=_BG2).pack(side="left", padx=(0, 6))

        tree = ttk.Treeview(win, columns=("received", "sender", "type", "subject", "status", "group"),
                            show="headings", selectmode="extended")
        for col, label, width in [("received", "Received", 140), ("sender", "Sender", 190), ("type", "Type", 50),
                                  ("subject", "Subject", 380), ("status", "Status", 130), ("group", "Group", 180)]:
            tree.heading(col, text=label)
            tree.column(col, width=width, anchor="w")
        tree.pack(fill="both", expand=True, padx=10, pady=6)

        def do_search(*_):
            q = q_var.get().strip().lower()
            tree.delete(*tree.get_children())
            if not q:
                count_var.set("Type words to match, then press Enter.")
                return
            terms = [t for t in q.split() if t]
            matches = []
            for e in self.emails:
                parts = []
                if f_subject.get():
                    parts.append(str(e.get("subject", "")))
                if f_sender.get():
                    parts.append(str(e.get("sender", "")))
                if f_meta.get():
                    parts += [str(e.get("category", "")), str(e.get("status", "")),
                              str(e.get("urgency", "")), str(self.get_email_type_code(e)),
                              str(e.get("outlook_categories", ""))]
                if f_group.get():
                    try:
                        parts.append(str(self.get_group_name_for_email(e.get("entry_id", "")) or ""))
                    except Exception:
                        pass
                if f_body.get():
                    parts.append(str(e.get("body", "") or e.get("snippet", "")))
                blob = " ".join(parts).lower()
                if all(t in blob for t in terms):
                    matches.append(e)
            matches.sort(key=lambda e: -e.get("received_timestamp", 0))
            for e in matches:
                eid = e.get("entry_id", "")
                if not eid:
                    continue
                try:
                    gname = self.get_group_name_for_email(eid) or ""
                except Exception:
                    gname = ""
                tree.insert("", "end", iid=eid, values=(
                    e.get("received", ""), e.get("sender", ""), self.get_email_type_code(e),
                    e.get("subject", ""), e.get("status", ""), gname))
            count_var.set(f"{len(matches)} match(es). Double-click or 'Go to in app' to jump; select rows to delete.")

        def go_to(*_):
            sel = tree.selection()
            if not sel:
                messagebox.showinfo("Go to", "Select a result first.", parent=win)
                return
            eid = sel[0]
            if self.goto_email_in_app(eid):
                try:
                    self.root.lift()
                    self.root.focus_force()
                except Exception:
                    pass
            else:
                messagebox.showinfo("Go to", "This email is no longer in the visible list (it may have been removed or archived). Try Refresh in the main window.", parent=win)

        def select_all():
            kids = tree.get_children()
            if kids:
                tree.selection_set(kids)

        def clear_selection():
            for iid in tree.selection():
                tree.selection_remove(iid)

        def delete_selected():
            emails = [self.get_email_by_id(iid) for iid in tree.selection()]
            emails = [e for e in emails if e]
            if not emails:
                messagebox.showinfo("Delete", "Select one or more results to delete from MaINbox.", parent=win)
                return
            if not messagebox.askyesno("Delete from MaINbox Only",
                f"Remove {len(emails)} selected email(s) from MaINbox only?\n\n"
                "Outlook is NOT touched. You can restore them later from Deleted History.", parent=win):
                return
            choice = self.review_followups_before_app_delete(emails)
            if choice is None:
                return
            removed, kept, cancelled = self.perform_app_delete(emails, choice)
            note = ""
            if kept:
                note = f"  Kept {kept} follow-up(s) as final reminders."
            elif cancelled:
                note = f"  Cancelled {cancelled} related follow-up(s)."
            messagebox.showinfo("Deleted", f"Removed {removed} email(s) from MaINbox only. Outlook was not changed.{note}", parent=win)
            do_search()

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=10, pady=(2, 10))
        tk.Button(btns, text="Go to in app", command=go_to, width=14).pack(side="left", padx=3)
        tk.Button(btns, text="Select All", command=select_all, width=10).pack(side="left", padx=3)
        tk.Button(btns, text="Clear Selection", command=clear_selection, width=14).pack(side="left", padx=3)
        tk.Button(btns, text="Delete from MaINbox", command=delete_selected, width=20).pack(side="left", padx=3)
        tk.Button(btns, text="Close", command=win.destroy, width=10).pack(side="right", padx=3)

        tree.bind("<Double-1>", go_to)
        q_entry.bind("<Return>", do_search)
        try:
            win.lift()
            win.focus_force()
        except Exception:
            pass
        # v4.1.89: focus the Find box AFTER win.focus_force(). Forcing focus onto the
        # TOPLEVEL steals it back from any child, so the pre-v4.1.89 order
        # (q_entry.focus_set() then win.focus_force()) left the window focused but the
        # Find box inactive -- reported after v4.1.88 shipped Ctrl+F. This is exactly
        # why open_deleted_history_window works: its search_entry.focus_set() is the
        # LAST call in the function with nothing forcing focus afterwards.
        # The after(0, ...) re-assert covers the window-manager case where the force
        # completes asynchronously and would otherwise land last.
        try:
            q_entry.focus_set()
            win.after(0, lambda: (q_entry.winfo_exists() and q_entry.focus_set()))
        except Exception:
            pass

    # ------------------------------------------------------------------
    # v4.2.44 write-ahead decision journal. Root cause (2026-08-18): a user
    # decision (Timmerman email set Low) rode the ASYNC status writer and a
    # process kill landed in the sub-second window before it hit disk -- the
    # decision vanished and overnight AI legitimately re-triaged the email.
    # Fix: every USER decision is appended to a tiny JSONL journal with
    # flush+fsync (~ms, no UI cost) the moment it is made; startup replays any
    # journaled decision NEWER than the on-disk record, then truncates the
    # journal. A cloud restore truncates without replaying (the restore wins).
    # ------------------------------------------------------------------

    def _decision_journal_path(self):
        return data_path("mainbox_decision_journal.jsonl")

    def _journal_user_decision(self, email, action="edit", **extra):
        """Synchronously journal one user decision (fsync'd append; fail-safe)."""
        try:
            entry_id = str((email or {}).get("entry_id", "") or "")
            if not entry_id:
                return
            rec = {"t": datetime.now().isoformat(), "action": action, "entry_id": entry_id,
                   "category": (email or {}).get("category", ""),
                   "urgency": (email or {}).get("urgency", ""),
                   "status": (email or {}).get("status", ""),
                   "email_type": (email or {}).get("email_type", ""),
                   "ai_user_locked": bool((email or {}).get("ai_user_locked", False))}
            rec.update(extra or {})
            with open(self._decision_journal_path(), "a", encoding="utf-8") as f:
                f.write(json.dumps(rec, separators=(",", ":"), default=str) + "\n")
                f.flush()
                os.fsync(f.fileno())
        except Exception:
            pass

    def _truncate_decision_journal(self):
        try:
            open(self._decision_journal_path(), "w", encoding="utf-8").close()
        except Exception:
            pass

    def _replay_decision_journal(self):
        """Startup: re-apply journaled decisions newer than the on-disk record
        (ISO updated_at comparison, so replays are exact no-ops when the async
        writer DID land the state). Always truncates the journal afterwards."""
        path = self._decision_journal_path()
        try:
            if not os.path.exists(path) or os.path.getsize(path) == 0:
                return 0
        except Exception:
            return 0
        try:
            with open(path, "r", encoding="utf-8") as f:
                lines = [ln for ln in f.read().splitlines() if ln.strip()]
        except Exception:
            lines = []
        applied = 0
        for ln in lines:
            try:
                rec = json.loads(ln)
                eid = str(rec.get("entry_id", "") or "")
                t = str(rec.get("t", "") or "")
                if not eid or not t:
                    continue
                cur = self.status_data.get(eid)
                cur_t = str(cur.get("updated_at", "") or "") if isinstance(cur, dict) else ""
                if cur_t and cur_t >= t:
                    continue  # disk already holds this state or newer
                if not isinstance(cur, dict):
                    cur = {"entry_id": eid}
                for field in ("category", "urgency", "status", "email_type"):
                    val = rec.get(field)
                    if val not in (None, ""):
                        cur[field] = val
                if rec.get("ai_user_locked"):
                    cur["ai_user_locked"] = True
                    cur["ai_triage_pending"] = False
                    cur["ai_triaged_at"] = cur.get("ai_triaged_at") or t
                if rec.get("action") == "app_delete" or rec.get("app_deleted"):
                    cur["app_deleted"] = True
                    cur["deleted_from_app_at"] = cur.get("deleted_from_app_at") or t
                    cur["prevent_future_followups"] = True
                elif rec.get("action") == "undelete":
                    # v4.2.52: a crash after an un-delete must not resurrect the delete.
                    cur["app_deleted"] = False
                    cur["deleted_from_app_at"] = ""
                    cur["explicit_reopened_at"] = cur.get("explicit_reopened_at") or t
                    cur["workflow_closed_at"] = ""
                cur["entry_id"] = eid
                cur["updated_at"] = t
                self.status_data[eid] = cur
                applied += 1
            except Exception:
                continue
        self._truncate_decision_journal()
        if applied:
            try:
                ops_log("app", "decision_journal_replayed", count=applied)
            except Exception:
                pass
            try:
                self.flush_status_data()
            except Exception:
                pass
        return applied

    def save_record(self, email):
        existing = self.status_data.get(email["entry_id"], {}) if email.get("entry_id") else {}
        if not isinstance(existing, dict):
            existing = {}
        _now = datetime.now().isoformat()
        _closed = self.workflow_record_is_closed({
            "app_deleted": bool(existing.get("app_deleted", False)),
            "category": email.get("category", ""), "urgency": email.get("urgency", ""),
            "status": email.get("status", ""),
        })
        _closed_at = email.get("workflow_closed_at", existing.get("workflow_closed_at", ""))
        if _closed and not _closed_at:
            _closed_at = _now
        self.status_data[email["entry_id"]] = {
            "entry_id": email.get("entry_id", ""),
            "category": email["category"], "urgency": email["urgency"],
