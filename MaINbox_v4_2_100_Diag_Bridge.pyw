                 "make": lambda p: grp(p, "Add Selected", self.add_selected_emails_to_selected_group)},
                {"id": "remove_selected", "label": "Remove Selected", "section": "group",
                 "make": lambda p: grp(p, "Remove Selected", self.remove_selected_emails_from_group)},
                {"id": "archive_group", "label": "Archive Group", "section": "group",
                 "make": lambda p: grp(p, "Archive Group", self.archive_selected_group)},
                {"id": "view_archived", "label": "View Archived", "section": "group",
                 "make": lambda p: grp(p, "View Archived", self.open_archived_groups_window)},
                {"id": "ai_summary", "label": "AI Summary", "section": "tools",
                 "make": lambda p: grp(p, "AI Summary", self.generate_selected_group_summary)},
                {"id": "quote_rfq", "label": "Quote RFQ", "section": "tools",
                 "make": lambda p: grp(p, "Quote RFQ", self.open_quote_intelligence_for_selected_group)},
                {"id": "quote_coverage", "label": "Quote Coverage", "section": "tools",
                 "make": lambda p: grp(p, "Quote Coverage", self.open_quote_coverage_window)},
                {"id": "po_review", "label": "PO Review", "section": "tools",
                 "make": lambda p: self._make_po_review_button(p, grp)},
                {"id": "scan_old_purchases", "label": "Scan Old Purchases", "section": "tools",
                 "make": lambda p: grp(p, "Scan Old Purchases", self.open_purchase_history_scanner_window)},
                {"id": "smartscan", "label": "SmartScan", "section": "tools",
                 "make": lambda p: grp(p, "SmartScan", self.open_smartscan_window)},
            ],
            "edit": [
                {"id": "apply_save", "label": "Apply / Save to Selected", "section": "edit", "pad": 10,
                 "make": lambda p: B(p, text="Apply / Save to Selected", command=self.save_selected_changes,
                                     bg=_ACCENT, fg="#ffffff", activebackground=_ACCENT2, activeforeground="#ffffff",
                                     font=("Segoe UI", _FONT_SIZE, "bold"))},
                {"id": "setup_followup", "label": "Setup/Edit Follow Up", "section": "edit",
                 "make": lambda p: B(p, text="Setup/Edit Follow Up", command=self.open_followup_window)},
                {"id": "cancel_followup", "label": "Cancel Follow Up", "section": "edit",
                 "make": lambda p: B(p, text="Cancel Follow Up", command=self.cancel_selected_followups)},
