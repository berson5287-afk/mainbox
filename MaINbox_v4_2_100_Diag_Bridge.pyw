        tk.Button(bridge_frame, text="Open Cloud Restore Folder", command=run_open_cloud_restore_folder, width=30).pack(pady=3)

        tk.Button(win, text="Rebuild Indexes / Cache", command=run_rebuild_cache, width=30).pack(pady=4)
        tk.Button(win, text="Cancel", command=win.destroy, width=30).pack(pady=(12, 8))

    def reload_local_state_from_disk(self):
        self.status_data = load_json(STATUS_FILE, {})
        # v4.2.44: a restore/reload replaces local state wholesale -- pre-restore
        # journal entries must NOT replay on top of it. The restore wins.
        self._truncate_decision_journal()
        self.cache_data = load_json(CACHE_FILE, {})
        self.followups = load_json(FOLLOWUP_FILE, [])
        self.scenario_reminders = load_json(SCENARIO_REMINDERS_FILE, [])
        # v3.8.30: commitment reminders were NOT reloaded here. After a reload/restore
        # self.commitment_reminders kept its stale in-memory value, and the next
        # save_commitment_reminders() then overwrote the freshly restored file with that
        # old data (silent loss). Reload it from disk like the rest of the family.
        self.commitment_reminders = load_json(COMMITMENT_REMINDERS_FILE, [])
        self.pending_reply_checks = load_json(PENDING_REPLY_CHECKS_FILE, [])
        self.sent_waiting_placeholders = load_json(SENT_WAITING_PLACEHOLDERS_FILE, [])
        # v3.8.30: normalize the follow-up family to lists after loading. A synced file
        # that was corrupted or hand-edited to the wrong top-level type (e.g. a {} where a
        # [] is expected) would otherwise flow straight into the running app and break the
        # loops that assume a list. __init__ already guards these on first load; reload did not.
        for _attr in ("followups", "scenario_reminders", "commitment_reminders",
                      "pending_reply_checks", "sent_waiting_placeholders"):
            if not isinstance(getattr(self, _attr, None), list):
                setattr(self, _attr, [])
        self.learning_data = load_json(LEARNING_FILE, {})
        # v3.8.31: triage_history, deleted_history, and quote_requests are LISTS.
        # __init__ loads them with [] and guards them, and they are used with list ops
        # elsewhere (.insert / .append / slicing / row comprehensions; quote_requests'
        # required default is also []). Reload had loaded all of these with a {} fallback,
        # so a missing/corrupt file turned a list into a dict and later .append()/slicing
        # broke. vendor_history and rfq_cache ARE genuinely dicts, so they keep {}.
        self.triage_history = load_json(TRIAGE_HISTORY_FILE, [])
        if not isinstance(self.triage_history, list):
            self.triage_history = []
        self.deleted_history = load_json(DELETED_HISTORY_FILE, [])
        if not isinstance(self.deleted_history, list):
            self.deleted_history = []
        self.vendor_history = load_json(VENDOR_HISTORY_FILE, {})
        if not isinstance(self.vendor_history, dict):
            self.vendor_history = {}
        self.quote_requests = load_json(QUOTE_REQUESTS_FILE, [])
        if not isinstance(self.quote_requests, list):
            self.quote_requests = []
        self.rfq_cache = load_json(RFQ_CACHE_FILE, {})
        if not isinstance(self.rfq_cache, dict):
            self.rfq_cache = {}
        self.procurement_memory = load_json(PROCUREMENT_MEMORY_FILE, {})
        self.purchase_history_hidden = load_json(PURCHASE_HISTORY_HIDDEN_FILE, {})
        # v3 efficiency: reloaded follow-up data (e.g. after a cloud restore) may contain
        # duplicates, so force the next cleanup to dedupe rather than trust the dirty flag.
        self._followup_dedup_needed = True
        self.settings = load_mainbox_settings()
        apply_mainbox_settings(self.settings)
        try:
            self.load_cached_state()
            self.cleanup_duplicates(reason="reload_from_disk", save=False)
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
        except Exception:
            traceback.print_exc()

