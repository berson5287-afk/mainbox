        body.pack(fill="both", expand=True, padx=14, pady=4)
        loading = tk.Label(body, text="Loading mailbox list from Outlook...", bg=_BG2, fg=_FG_DIM)
        loading.pack(anchor="w", padx=8, pady=8)

        state = {"vars": []}  # [(info_dict, BooleanVar)]

        saved = self._load_inbox_viewer_config().get("folders", [])
        saved_by_id = {f.get("entry_id"): f for f in saved if isinstance(f, dict) and f.get("entry_id")}
        saved_by_store = {str(f.get("store", "")).strip().lower(): f
                         for f in saved if isinstance(f, dict)}
        had_saved = bool(saved_by_id or saved_by_store)

        def populate(found):
            try:
                if not win.winfo_exists():
                    return
            except Exception:
                return
            loading.destroy()
            if not found:
                tk.Label(body, text="No inboxes found (is Outlook running?)", bg=_BG2, fg=_FG_DIM).pack(anchor="w", padx=8, pady=8)
                return
            for info in found:
                prior = saved_by_id.get(info.get("entry_id")) \
                    or saved_by_store.get(str(info.get("store", "")).strip().lower())
                if prior is not None:
                    checked = bool(prior.get("selected", True))
                elif had_saved:
                    checked = False
                else:
                    # First run: pre-tick the stock pair (own inbox + Sales).
                    store_l = str(info.get("store", "")).lower()
                    checked = (SALES_MAILBOX_NAME.lower() in store_l) or (len(state["vars"]) == 0)
                var = tk.BooleanVar(value=checked)
                state["vars"].append((info, var))
                tk.Checkbutton(body, text=f"{info.get('store', '?')}  --  {info.get('name', 'Inbox')}",
                               variable=var, bg=_BG2, fg=_FG, selectcolor=_BG3,
                               activebackground=_BG2, anchor="w").pack(fill="x", padx=8, pady=2)

        def enum_error(exc):
            try:
                if win.winfo_exists():
                    loading.configure(text=f"Could not list mailboxes: {exc}")
            except Exception:
                pass

        self.run_outlook_worker(lambda o, ns: self._inbox_viewer_enumerate_inboxes_work(ns),
                                on_done=populate, on_error=enum_error, label="inbox-viewer-enumerate")

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=14, pady=10)

        def do_save(event=None):
            if state["vars"]:
                folders = [dict(info, selected=bool(var.get())) for info, var in state["vars"]]
                self._save_inbox_viewer_config({"folders": folders})
                ops_log("inbox_viewer", "mailboxes_saved",
                        selected=sum(1 for _i, v in state["vars"] if v.get()))
            win.destroy()
            self._inbox_viewer_refresh()

        save_btn = tk.Button(btns, text="Save", command=do_save, bg=_ACCENT, fg="#ffffff",
                             activebackground=_ACCENT2, activeforeground="#ffffff",
                             font=(_FONT, _FONT_SIZE, "bold"), width=12)
        save_btn.pack(side="right", padx=4)
        tk.Button(btns, text="Cancel", command=win.destroy, width=10).pack(side="right", padx=4)
        win.bind("<Return>", do_save)
        win.bind("<Escape>", lambda e: win.destroy())
        try:
            save_btn.focus_set()
        except Exception:
            pass

    def open_inbox_viewer_column_editor(self):
        """Show/hide and reorder Inbox Viewer columns (clone of the Edit
        Buttons dialog). Current on-screen widths are captured on Save so a
        hand-dragged width survives restarts. Enter saves, Escape cancels."""
        parent = getattr(self, "_inbox_viewer_win", None) or self.root
        win = tk.Toplevel(parent)
        win.title("Inbox Viewer -- Columns")
        remember_window_geometry(win, "MaINbox Inbox Viewer Columns", "420x430")
        win.transient(parent)
        apply_theme(win)
        tk.Label(win, text="Edit Columns", font=(_FONT, 14, "bold"), fg=_ACCENT, bg=_BG).pack(anchor="w", padx=14, pady=(12, 2))
        tk.Label(win, text="Tick to show a column, untick to hide it. Arrows reorder. Enter saves.",
                 bg=_BG, fg=_FG_DIM, wraplength=380, justify="left").pack(anchor="w", padx=14, pady=(0, 8))

        rf = tk.Frame(win, bg=_BG2)
        rf.pack(fill="both", expand=True, padx=14, pady=4)
        state = [[spec["id"], spec["label"], tk.BooleanVar(value=vis), width]
                 for spec, vis, width in self._merged_inbox_viewer_columns()]

        def render_rows():
            for ch in rf.winfo_children():
                ch.destroy()
            for idx, (cid, label, var, _w) in enumerate(state):
                row = tk.Frame(rf, bg=_BG2)
                row.pack(fill="x", pady=1)
                tk.Checkbutton(row, variable=var, bg=_BG2, fg=_FG, selectcolor=_BG3, activebackground=_BG2).pack(side="left")
                tk.Label(row, text=label, bg=_BG2, fg=_FG, anchor="w", width=22).pack(side="left", padx=(2, 6))
                tk.Button(row, text="▲", width=2, command=lambda i=idx: move(i, -1)).pack(side="left", padx=1)
                tk.Button(row, text="▼", width=2, command=lambda i=idx: move(i, 1)).pack(side="left", padx=1)

        def move(idx, delta):
            j = idx + delta
            if 0 <= j < len(state):
                state[idx], state[j] = state[j], state[idx]
                render_rows()

        render_rows()
        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=14, pady=10)

        def _live_trees():
            out = []
            for _l, t in getattr(self, "_inbox_viewer_trees", None) or []:
                try:
                    if t.winfo_exists():
                        out.append(t)
                except Exception:
                    pass
            return out

        def do_save(event=None):
            trees = _live_trees()
            layout = []
            for cid, _label, var, width in state:
                w = width
                try:
                    if trees and var.get():
                        w = int(trees[0].column(cid, "width"))
                except Exception:
                    pass
                layout.append({"id": cid, "v": bool(var.get()), "w": w})
            self._save_inbox_viewer_config({"columns": layout})
            for t in trees:
                self._apply_inbox_viewer_columns(t)
            ops_log("inbox_viewer", "columns_saved",
                    visible=sum(1 for r in layout if r["v"]))
            win.destroy()

        def do_reset():
            self._save_inbox_viewer_config({"columns": []})
            for t in _live_trees():
                self._apply_inbox_viewer_columns(t)
            win.destroy()

        save_btn = tk.Button(btns, text="Save", command=do_save, bg=_ACCENT, fg="#ffffff",
                             activebackground=_ACCENT2, activeforeground="#ffffff",
                             font=(_FONT, _FONT_SIZE, "bold"), width=12)
        save_btn.pack(side="right", padx=4)
        tk.Button(btns, text="Cancel", command=win.destroy, width=10).pack(side="right", padx=4)
        tk.Button(btns, text="Reset to defaults", command=do_reset, width=16).pack(side="left", padx=4)
        win.bind("<Return>", do_save)
        win.bind("<Escape>", lambda e: win.destroy())
        try:
            save_btn.focus_set()
        except Exception:
            pass

    # ------------------------------------------------------------------
    # v4.2.36 Inbox Viewer Phase 2: drag rows onto a group. Per the locked
    # decisions: plain drops apply instantly with an Undo toast (Ctrl+Z works
    # too); a drop whose email already lives in another group asks first
    # (Enter confirms), then that WHOLE group merges into the target and the
    # old group is deleted. Rows MaINbox never ingested are imported through
    # the real chokepoint (build_email_data on a worker -> upsert_email) so a
    # drag can organize ANY inbox email, not just the triaged slice.
    # ------------------------------------------------------------------

    def _inbox_viewer_drag_press(self, event):
        tree = event.widget
        self._iv_drag = None
        try:
            if tree.identify_region(event.x, event.y) not in ("cell", "tree"):
                return
            if not tree.identify_row(event.y):
                return
        except Exception:
            return
        self._iv_drag = {"tree": tree, "x": event.x_root, "y": event.y_root, "active": False}

    def _inbox_viewer_drag_motion(self, event):
        drag = getattr(self, "_iv_drag", None)
        if not drag:
            return
        if not drag.get("active"):
            if abs(event.x_root - drag["x"]) < 10 and abs(event.y_root - drag["y"]) < 10:
                return
            drag["active"] = True
            try:
                drag["tree"].configure(cursor="hand2")
            except Exception:
                pass
            try:
                n = max(1, len(drag["tree"].selection()))
                self._inbox_viewer_status_var.set(
                    f"Dragging {n} email(s) -- drop on a group (left group list or a group header); release anywhere else to cancel.")
            except Exception:
                pass

    def _inbox_viewer_drag_release(self, event):
        drag = getattr(self, "_iv_drag", None)
        self._iv_drag = None
        if not drag or not drag.get("active"):
            return
        try:
            drag["tree"].configure(cursor="")
        except Exception:
            pass
        rows = self._inbox_viewer_rows_for_tree_selection(drag["tree"])
        target = self._inbox_viewer_drop_target_group(event.x_root, event.y_root)
        if not rows or not target:
            self._render_inbox_viewer_rows()  # restores the status line
            return
        gid, gname = target
        self._inbox_viewer_apply_drop(rows, gid, gname)

    def _inbox_viewer_rows_for_tree_selection(self, tree):
        try:
            sel = [str(s) for s in tree.selection()]
        except Exception:
            sel = []
        out = []
        for row in getattr(self, "_inbox_viewer_rows", []) or []:
            eid = row.get("entry_id") or ""
            if eid and any(s == eid or s.startswith(eid + ":") for s in sel):
                out.append(row)
        return out

    def _inbox_viewer_drop_target_group(self, x_root, y_root):
        """Group under the pointer: a row of the main window's group list, a
        group header in the main email tree, or a grouped email row there
        (the drop lands in that row's group). None = not a drop target."""
        try:
            w = self.root.winfo_containing(x_root, y_root)
        except Exception:
            w = None
        if w is None:
            return None
        gid = ""
        try:
            if w is getattr(self, "groups_tree", None):
                iid = w.identify_row(y_root - w.winfo_rooty())
                if iid.startswith("group:"):
                    gid = iid.split(":", 1)[1]
                elif iid.startswith("member:"):
                    gid = iid.split(":", 2)[1]
            elif w is getattr(self, "tree", None):
                iid = w.identify_row(y_root - w.winfo_rooty())
                if iid.startswith("groupheader:"):
                    gid = iid.split(":", 1)[1]
                elif iid:
                    gid = self.get_group_id_for_email(iid) or ""
        except Exception:
            gid = ""
        if not gid:
            return None
        group = self.get_group_by_id(gid)
        if not group or group.get("archived"):
            return None
        return gid, group.get("name", "")

    def _undelete_app_emails(self, entry_ids, reason="viewer_drop"):
        """v4.2.52: shared un-delete core for the viewer drag-drop path -- the
        same mechanics as the Deleted History window's Restore (status flags,
        explicit reopen stamp, closed-guard clear, snapshot re-add, saves and
        re-renders), callable outside that window. Journaled so a crash cannot
        resurrect the delete. Returns the restored email dicts."""
        ids = [str(e or "") for e in (entry_ids or []) if e]
        if not ids:
            return []
        self.save_undo_state("un-delete email(s) via viewer drop")
        restored = []
        current_ids = {e.get("entry_id", "") for e in self.emails}
        _guard_changed = False
        for eid in ids:
            st = self.status_data.get(eid, {})
            if not isinstance(st, dict):
                st = {}
            st["app_deleted"] = False
            st["deleted_from_app_at"] = ""
            st["explicit_reopened_at"] = datetime.now().isoformat()
            st["workflow_closed_at"] = ""
            st.setdefault("entry_id", eid)
            self.status_data[eid] = st
            snap = next((r for r in self.deleted_history if r.get("entry_id") == eid), None)
            _probe = dict(snap or st)
            _probe.setdefault("entry_id", eid)
            if self.clear_closed_email_guard(_probe, save=False):
                _guard_changed = True
            if snap and eid not in current_ids:
                email = dict(snap)
                email.pop("deleted_from_app_at", None)
                email["message"] = None
                email["is_new_import"] = False
                email["followup_time"] = self.get_followup_display_for_email(eid)
                self.emails.append(email)
                restored.append(email)
            self._journal_user_decision(st, "undelete", app_deleted=False)
        _idset = set(ids)
        self.deleted_history = [r for r in self.deleted_history if r.get("entry_id") not in _idset]
        self._rebuild_email_index()
        if _guard_changed:
            self._save_closed_email_guard()
        self.flush_status_data()
        self.save_deleted_history()
        self.save_cached_state()
        try:
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
        except Exception:
            pass
        ops_log("inbox_viewer", "drop_undelete", restored=len(restored),
                asked=len(ids), reason=reason)
        return restored

    def _inbox_viewer_apply_drop(self, rows, group_id, group_name):
        known, missing = [], []
        for row in rows:
            rec = self.get_email_by_id(row.get("entry_id", ""))
            if rec is not None:
                known.append(rec)
            else:
                missing.append(dict(row))
        # v4.2.52 (Steve): a dropped email that was DELETED in MaINbox must ask
        # to un-delete, not silently fail the import (the app_deleted gate in
        # upsert_email refuses such rows -- exactly what would have happened
        # dragging Lucy's deleted Welsbach PO into a group). Match by EntryID
        # first, then by Message-ID against app-deleted records (EntryID churn).
        if missing:
            deleted_rows = []
            msgid_index = None
            for row in missing:
                eid = str(row.get("entry_id", "") or "")
                sd = self.status_data.get(eid) if isinstance(self.status_data, dict) else None
                if isinstance(sd, dict) and sd.get("app_deleted"):
                    row["_deleted_eid"] = eid
                    deleted_rows.append(row)
                    continue
                mid = str(row.get("message_id", "") or "")
                if mid:
                    if msgid_index is None:
                        msgid_index = {}
                        for k, v in (self.status_data or {}).items():
                            if isinstance(v, dict) and v.get("app_deleted"):
                                m2 = str(v.get("internet_message_id", "") or "")
                                if m2:
                                    msgid_index[m2] = k
                    k2 = msgid_index.get(mid, "")
                    if k2:
                        row["_deleted_eid"] = k2
                        deleted_rows.append(row)
            if deleted_rows:
                _plural = "s were" if len(deleted_rows) != 1 else " was"
                ok = messagebox.askyesno(
                    "Un-delete and Add?",
                    f"{len(deleted_rows)} of the dropped email{_plural} deleted in MaINbox.\n\n"
                    f"Un-delete and add to '{group_name}'?",
                    parent=getattr(self, "_inbox_viewer_win", None) or self.root)
                if ok:
                    restored = self._undelete_app_emails(
                        [r["_deleted_eid"] for r in deleted_rows])
                    known.extend(restored)
                    restored_ids = {str(e.get("entry_id", "")) for e in restored}
                    # Restored-from-snapshot rows leave the import list; deleted rows
                    # WITHOUT a snapshot stay and import normally now that the
                    # app_deleted gate is cleared for them.
                    missing = [r for r in missing
                               if not r.get("_deleted_eid") or r["_deleted_eid"] not in restored_ids]
                else:
                    _skip = {id(r) for r in deleted_rows}
                    missing = [r for r in missing if id(r) not in _skip]
                    try:
                        self._inbox_viewer_status_var.set(
                            f"Skipped {len(deleted_rows)} deleted email(s); the rest of the drop continues.")
                    except Exception:
                        pass
        if not missing:
            self._inbox_viewer_finish_drop(known, group_id, group_name)
            return
        try:
            self._inbox_viewer_status_var.set(f"Importing {len(missing)} email(s) from Outlook...")
        except Exception:
            pass

        def work(outlook, namespace):
            fetched = []
            for row in missing:
                try:
                    if row.get("store_id"):
                        msg = namespace.GetItemFromID(row["entry_id"], row["store_id"])
                    else:
                        msg = namespace.GetItemFromID(row["entry_id"])
                    # v4.2.41 fix: the app's canonical source labels are "My Inbox"
                    # and "Sales" (v4.2.36 stamped "Inbox", which == "My Inbox"
                    # checks elsewhere would miss).
                    source = str(row.get("folder") or "") or "My Inbox"
                    data = self.build_email_data(msg, source)
                    if isinstance(data, dict) and data.get("entry_id"):
                        fetched.append(data)
                except Exception:
                    continue
            return fetched

        def done(fetched):
            imported = []
            for data in fetched or []:
                try:
                    self.upsert_email(data)
                    rec = self.get_email_by_id(data.get("entry_id", ""))
                    if rec is not None:
                        imported.append(rec)
                except Exception:
                    continue
            skipped = len(missing) - len(imported)
            if skipped:
                try:
                    self.log(f"Inbox Viewer drop: {skipped} email(s) not imported (junked/app-deleted/unavailable)")
                except Exception:
                    pass
            self._inbox_viewer_finish_drop(known + imported, group_id, group_name, imported=len(imported))

        def error(exc):
            try:
                self._inbox_viewer_status_var.set(f"Drop failed: could not reach Outlook ({exc})")
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=error, label="inbox-viewer-drop-import")

    def _inbox_viewer_finish_drop(self, emails, group_id, group_name, imported=0):
        emails = [e for e in emails if isinstance(e, dict) and e.get("entry_id")]
        if not emails:
            try:
                self._inbox_viewer_status_var.set("Nothing to add (emails could not be imported).")
            except Exception:
                pass
            return
        # Distinct source groups other than the target -> merge decision(s) first.
        src_gids = []
        for e in emails:
            cur = self.get_group_id_for_email(e.get("entry_id", ""))
            if cur and cur != group_id and cur not in src_gids:
                src_gids.append(cur)
        depth0 = len(getattr(self, "undo_stack", []) or [])
        merged_names, moved_total = [], 0
        for src_gid in src_gids:
            src = self.get_group_by_id(src_gid) or {}
            src_name = src.get("name", "?")
            count = sum(1 for gid in (self.groups_data.get("memberships") or {}).values() if gid == src_gid)
            ok = messagebox.askyesno(
                "Merge Groups",
                f"'{src_name}' already holds {count} email(s), including one you dropped.\n\n"
                f"Merge ALL of '{src_name}' into '{group_name}' and delete '{src_name}'?",
                parent=getattr(self, "_inbox_viewer_win", None) or self.root)
            if ok:
                moved_total += self.merge_group_into(src_gid, group_id)
                merged_names.append(src_name)
        added = self.assign_emails_to_group(emails, group_id)
        # One drop = one Ctrl+Z: collapse the per-operation undo snapshots down
        # to the first one pushed (the true pre-drop state).
        try:
            if len(self.undo_stack) > depth0 + 1:
                del self.undo_stack[depth0 + 1:]
        except Exception:
            pass
        ops_log("inbox_viewer", "drag_drop", group=group_id, added=added,
                imported=imported, merged_groups=len(merged_names), merged_moved=moved_total)
        note = f"Added {added} email(s) to '{group_name}'"
        if merged_names:
            note += " -- merged in " + ", ".join(f"'{n}'" for n in merged_names)
        try:
            self._inbox_viewer_status_var.set(note + ".")
        except Exception:
            pass
        self._show_undo_toast(getattr(self, "_inbox_viewer_win", None) or self.root, note)

    def merge_group_into(self, src_gid, dst_gid):
        """Move every member of src into dst, fold src's quote-coverage records
        into dst's ledger (re-tag + standard consolidation, lossless), delete
        src. One undo snapshot; callers confirm with the user first."""
        src = self.get_group_by_id(src_gid)
        dst = self.get_group_by_id(dst_gid)
        if not src or not dst or src_gid == dst_gid:
            return 0
        self.save_undo_state(f"merge group '{src.get('name', '')}' into '{dst.get('name', '')}'")
        memberships = self.groups_data.setdefault("memberships", {})
        moved = 0
        for eid, gid in list(memberships.items()):
            if gid == src_gid:
                memberships[eid] = dst_gid
                moved += 1
        try:
            threads = (getattr(self, "quote_coverage", None) or {}).get("threads")
            if isinstance(threads, dict):
                for rec in threads.values():
                    if isinstance(rec, dict) and str(rec.get("group_id", "") or "") == str(src_gid):
                        rec["group_id"] = str(dst_gid)
                self._consolidate_group_coverage(dst_gid)
        except Exception:
            pass
        self.groups_data["groups"] = [g for g in self.groups_data.get("groups", [])
                                      if g.get("id") != src_gid]
        if getattr(self, "active_group_filter", None) == src_gid:
            self.active_group_filter = dst_gid
        self.save_groups()
        self.render_group_rows()
        self.render_email_rows()
        ops_log("group", "group_merged", src=src_gid, dst=dst_gid, moved=moved,
                src_name=str(src.get("name", ""))[:60], dst_name=str(dst.get("name", ""))[:60])
        return moved

    def _show_undo_toast(self, anchor, message, action=None):
        """Bottom-right toast with an Undo button; auto-dismisses after 6s.
        Never takes focus or a grab (the v4.2.33 stuck-modal lesson).
        v4.2.38: optional `action` callback -- the default remains the app-state
        undo; Outlook-side operations (viewer delete) pass their own restorer."""
        try:
            toast = tk.Toplevel(anchor)
            toast.overrideredirect(True)
            toast.attributes("-topmost", True)
            frame = tk.Frame(toast, bg=_BG2, highlightbackground=_ACCENT, highlightthickness=1)
            frame.pack(fill="both", expand=True)
            tk.Label(frame, text=message, bg=_BG2, fg=_FG, padx=10, pady=8,
                     wraplength=360, justify="left").pack(side="left")

            def _undo():
                try:
                    toast.destroy()
                except Exception:
                    pass
                (action or self.undo_last_action)()

            tk.Button(frame, text="Undo", command=_undo, bg=_ACCENT, fg="#ffffff",
                      activebackground=_ACCENT2, activeforeground="#ffffff", width=7).pack(side="right", padx=8, pady=6)
            toast.update_idletasks()
            try:
                ax, ay = anchor.winfo_rootx(), anchor.winfo_rooty()
                aw, ah = anchor.winfo_width(), anchor.winfo_height()
                tw, th = toast.winfo_width(), toast.winfo_height()
                toast.geometry(f"+{ax + aw - tw - 16}+{ay + ah - th - 16}")
            except Exception:
                pass
            toast.after(6000, lambda: toast.destroy() if toast.winfo_exists() else None)
        except Exception:
            pass

    # ------------------------------------------------------------------
    # v4.2.38: viewer Settings hub (mailboxes + columns moved in here), Delete
    # key -> REAL Outlook delete into that mailbox's Deleted Items with an
    # Undo toast, a Deleted Items History window to un-delete later, and a
    # guarded "clear history" that PERMANENTLY purges those emails. Restore
    # and purge locate messages by Internet Message-ID (DASL, same pattern as
    # the existing reopen fallbacks) because EntryID changes when an item
    # moves folders -- Cached Exchange Mode rule from CLAUDE.md.
    # ------------------------------------------------------------------

    def open_inbox_viewer_settings(self):
