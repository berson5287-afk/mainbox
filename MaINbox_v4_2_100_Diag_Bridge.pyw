            "sales_inbox_duplicate_hidden_at": email.get("sales_inbox_duplicate_hidden_at", existing.get("sales_inbox_duplicate_hidden_at", "")),
            "rescued_at": email.get("rescued_at", existing.get("rescued_at", "")),  # v4.1.37: one-shot rescue marker
            "internet_message_id": email.get("internet_message_id", existing.get("internet_message_id", ""))  # v3.9.82: drift-proof match key
