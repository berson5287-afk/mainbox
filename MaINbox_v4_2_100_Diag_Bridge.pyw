        def apply_preset(*args):
            profile = profile_var.get()
            if profile == "conservative":
                followup_conf_var.set(0.86)
                triage_conf_var.set(0.78)
                relevance_var.set(0.78)
                spam_var.set(0.25)
                rescan_hours_var.set(18.0)
                scan_limit_var.set(12)
