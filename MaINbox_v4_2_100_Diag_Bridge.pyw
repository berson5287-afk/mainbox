# v3.9.106: post-restore Outlook sync. When a cloud restore moves work from one PC
# to another, the second PC's Outlook may not have downloaded the newest mail yet,
# so the restored records point at emails the local mailbox has not synced. MaINbox
# drops this marker when it launches a cloud restore (and honors it even if it
# arrives inside a restored AppData folder from the source PC -- that is exactly
# the moment a sync is wanted); the next launch consumes it and runs an Outlook
# Send/Receive before the restored state is worked against.
RESTORE_OUTLOOK_SYNC_MARKER_FILE = data_path("mainbox_post_restore_outlook_sync.json")

# v4.0.1: cap for the post-restore deep mailbox walk (days). The walk goes back to the
# oldest restored record, but never further than this, so a years-old stray timestamp
# cannot turn the first post-restore update into an hours-long full-mailbox scan.
POST_RESTORE_DEEP_UPDATE_MAX_DAYS = 90


def request_post_restore_outlook_sync(reason=""):
    """Ask the NEXT MaINbox launch to update Outlook (Send/Receive) first."""
    try:
        with open(RESTORE_OUTLOOK_SYNC_MARKER_FILE, "w", encoding="utf-8") as f:
            json.dump({
                "requested_at": datetime.now().isoformat(),
                "reason": str(reason or "cloud restore"),
            }, f, indent=2)
        return True
    except Exception:
        return False


def consume_post_restore_outlook_sync_request():
    """Return a reason string when this launch follows a restore, else "".

    Primary signal: MaINbox's own marker file (deleted on consumption so one
    request runs at most one sync). Secondary, for restores done while MaINbox
    was closed (bridge run manually with --restore-latest): a cloud-bridge
    status file freshly modified AND whose content reports a completed restore.
    The status match is deliberately tight -- auto-backups rewrite that file all
    day, so a loose "restore" substring would trigger on every launch."""
    try:
        if os.path.exists(RESTORE_OUTLOOK_SYNC_MARKER_FILE):
            reason = "cloud restore"
            try:
                with open(RESTORE_OUTLOOK_SYNC_MARKER_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if isinstance(data, dict) and data.get("reason"):
                    reason = str(data.get("reason"))
            except Exception:
                pass
            try:
                os.remove(RESTORE_OUTLOOK_SYNC_MARKER_FILE)
            except Exception:
                pass
            return reason
    except Exception:
        pass
    try:
        if os.path.exists(MAINBOX_CLOUD_STATUS_FILE):
            age = datetime.now().timestamp() - os.path.getmtime(MAINBOX_CLOUD_STATUS_FILE)
            if 0 <= age <= 15 * 60:
                blob = ""
                try:
                    with open(MAINBOX_CLOUD_STATUS_FILE, "r", encoding="utf-8") as f:
                        blob = f.read().lower()
                except Exception:
                    blob = ""
                if blob and (
                    re.search(r'"(?:last_)?restore[a-z_]*"\s*:\s*"(?:19|20)\d\d', blob)
                    or re.search(r'"restore[a-z_]*"\s*:\s*"?(?:ok|success|done|complete|completed|finished|true)', blob)
                ):
                    return "cloud bridge status reports a recent restore"
    except Exception:
        pass
    return ""


