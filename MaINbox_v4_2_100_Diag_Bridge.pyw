# v4.1.21 (external audit round 3, finding #16): win32com used to be imported ~475 lines
# BEFORE crash logging existed, so a missing/broken pywin32 killed a .pyw launch with no
# trace at all. Failures now land in a bootstrap log beside the app before re-raising.
try:
    import win32com.client
except Exception:
    try:
        import os as _boot_os
        import traceback as _boot_tb
        _boot_base = _boot_os.environ.get("LOCALAPPDATA") or _boot_os.path.expanduser("~")
        with open(_boot_os.path.join(_boot_base, "mainbox_boot_error.log"), "a", encoding="utf-8") as _boot_f:
            _boot_f.write("=== MaINbox boot import failure (win32com) ===\n" + _boot_tb.format_exc() + "\n")
    except Exception:
        pass
    raise
