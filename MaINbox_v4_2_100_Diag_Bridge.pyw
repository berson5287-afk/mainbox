    else:
        order = [x.strip().lower() for x in str(raw_order or "docling,liteparse").replace(";", ",").split(",")]
    order = [x for x in order if x in ["docling", "liteparse"]]
    if not order:
        order = ["docling", "liteparse"]
    merged["rfq_ocr_order"] = ",".join(dict.fromkeys(order))
