    def archive_selected_group(self):
        group_id = self.selected_group_id_from_groups_tree()
        group = self.get_group_by_id(group_id)
        if not group:
            messagebox.showwarning("No Group Selected", "Select a group first.")
            return
        if not messagebox.askyesno("Archive Group", f"Archive group '{group.get('name', '')}'?\n\nEmails will stay in MaINbox. The group will move to archived groups."):
            return
        self.save_undo_state("archive group")
        # v4.2.13: same reminder cleanup as the programmatic path, so a group archived
        # by hand does not keep nagging on its still-open members either.
        try:
            self._cancel_group_member_followups(group_id, reason="Group archived by user")
        except Exception:
            pass
        group["archived"] = True
        group["archived_at"] = datetime.now().isoformat()
        if self.active_group_filter == group_id:
            self.active_group_filter = "all"
        self.save_groups(); self.render_group_rows(); self.render_email_rows()

