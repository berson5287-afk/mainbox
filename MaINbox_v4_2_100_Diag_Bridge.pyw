# MaINbox v3 Quote Intelligence
# -----------------------------
PART_HINT_RE = re.compile(r"\b(?:cat\.?\s*#?|part\s*#?|model\s*#?|mfr\s*#?|item\s*#?)\s*[:\-]?\s*([A-Z0-9][A-Z0-9\-_/\.]{2,})\b", re.I)
QTY_HINT_RE = re.compile(r"\b(?:qty|quantity)\s*[:\-]?\s*(\d+(?:\.\d+)?)\b", re.I)


def safe_filename_piece(text, fallback="attachment"):
    text = re.sub(r"[^A-Za-z0-9_.-]+", "_", str(text or "")).strip("._")
    return text[:80] or fallback


# v4.2.70 (John DeRosa job, "1 ¼ Rigid conduit"): customers paste Unicode vulgar
# fractions from Word/Outlook autocorrect. No normalizer recognized them, so the
# trade SIZE fell out of every matching key ('1 ¼ rigid' canonicalized to just
# 'rigid') and a vendor reply typed "1 1/4" could never match the requested line.
# Folded to ASCII at the top of the three key/normalize layers only -- displayed
# text keeps the customer's original characters.
_UNICODE_FRACTION_MAP = {
    "¼": "1/4", "½": "1/2", "¾": "3/4",
    "⅓": "1/3", "⅔": "2/3", "⅕": "1/5",
    "⅙": "1/6", "⅚": "5/6", "⅛": "1/8",
    "⅜": "3/8", "⅝": "5/8", "⅞": "7/8",
}


def fold_unicode_fractions(text):
    s = str(text or "")
    if not any(ch in s for ch in _UNICODE_FRACTION_MAP):
        return s
    out = []
    for i, ch in enumerate(s):
        rep = _UNICODE_FRACTION_MAP.get(ch)
        if rep is None:
            out.append(ch)
        elif i > 0 and s[i - 1].isdigit():
            out.append(" " + rep)   # '1¼' -> '1 1/4' (mixed number keeps its space)
        else:
            out.append(rep)
    return "".join(out)


def normalize_material_key(part_number="", description=""):
    key = (part_number or "").strip().upper()
    if not key:
        key = re.sub(r"\s+", " ", fold_unicode_fractions(description or "").strip().lower())[:80]
    return key



def heuristic_extract_materials(text, max_items=80):
    text = text or ""
    materials = []
    seen = set()

    material_keywords = [
        "emt", "rigid", "pvc", "wire", "cable", "breaker",
        "disconnect", "receptacle", "switch", "conduit",
        "fitting", "box", "strut", "coupling", "connector"
    ]

    for raw in [ln.strip() for ln in text.splitlines() if ln.strip()]:
        line = re.sub(r"\s+", " ", raw).strip()

        # Handle customer shorthand formatting:
        # 100ft- 3/4" emt
        # 25- 632s
        # 1,000ft 4" PVC
        line = re.sub(
            r"^(\d[\d,]*)(ft|feet|pcs|pc|ea)?\s*[-:]\s*",
            r"\1 ",
            line,
            flags=re.I,
        )

        line = re.sub(
            r"^(\d[\d,]*)(ft|feet)\b",
            r"\1",
            line,
            flags=re.I,
        )

        if len(line) < 3 or len(line) > 180:
            continue

        low = line.lower()

        if any(skip in low for skip in [
            "unsubscribe",
            "confidential",
            "from:",
            "sent:",
            "subject:",
            "regards",
            "thank you",
        ]):
            continue

        qty = ""
        unit = ""

        q2, u2, d2 = split_qty_unit_description(line)
        if q2 and d2:
            qty = q2
            unit = u2
            line = d2

        # Leading quantity extraction.
        if not qty:
            lead_qty = re.match(
                r"^(\d[\d,]*(?:\.\d+)?)\s+(.*)$",
                line,
                flags=re.I,
            )

            if lead_qty:
                qty = lead_qty.group(1).replace(",", "")
                remaining = lead_qty.group(2).strip()

                if len(remaining) >= 2:
                    line = remaining

        if not qty:
            q = QTY_HINT_RE.search(line)
            if q:
                qty = q.group(1).replace(",", "")

        part = ""

        ph = PART_HINT_RE.search(line)
        if ph:
            part = ph.group(1).strip().upper()
        else:
            tokens = re.findall(
                r"\b[A-Z0-9]{2,}[A-Z0-9\-_/\\\.]{1,}\b",
                line,
            )

            if tokens:
                scored = sorted(
                    tokens,
                    key=lambda t: (
                        bool(re.search(r"[A-Z]", t))
                        and bool(re.search(r"\d", t)),
                        len(t),
                    ),
                    reverse=True,
                )

                part = scored[0].strip().upper()

        if not part and not any(w in low for w in material_keywords):
            continue

        desc = line.strip(" -:")

        key = normalize_material_key(part, desc)

        if key in seen:
            continue

        seen.add(key)

        materials.append({
            "qty": qty,
            "unit": unit,
            "part_number": part,
            "description": desc,
            "source": "heuristic",
        })

        if len(materials) >= max_items:
            break

    return materials

