    merged["theme"] = "light" if str(merged.get("theme", "dark")).lower() == "light" else "dark"
    merged["font_bold"] = bool(merged.get("font_bold", False))
    merged["auto_refresh_enabled"] = bool(merged.get("auto_refresh_enabled", AUTO_REFRESH_ENABLED))
    merged["sales_uncat_enabled"] = bool(merged.get("sales_uncat_enabled", True))
    merged["ai_enabled"] = bool(merged.get("ai_enabled", OLLAMA_ENABLED))
    for key in ["ai_default_model", "ai_reply_model", "ai_triage_model", "ai_summary_model", "ai_quote_model", "ai_purchase_model", "ai_vision_model"]:
        merged[key] = str(merged.get(key, "") or "").strip()
    if not merged.get("ai_default_model"):
        merged["ai_default_model"] = OLLAMA_MODEL
    for key in ["ai_reply_model", "ai_triage_model", "ai_summary_model", "ai_quote_model"]:
