        def record_rfq_extraction_correction(row_idx, field, before, after, action="edit"):
            """Remember RFQ grid corrections so future extraction prompts learn from them."""
            try:
                before_s = str(before or "").strip()
                after_s = str(after or "").strip()
                if action == "edit" and before_s == after_s:
                    return
                m = mat_items[row_idx] if 0 <= int(row_idx) < len(mat_items) else {}
                mem = self.procurement_memory if isinstance(self.procurement_memory, dict) else default_procurement_memory()
                mem.setdefault("rfq_extraction_corrections", [])
                rec = {
                    "created_at": datetime.now().isoformat(),
                    "action": action,
                    "field": field,
                    "before": before_s,
                    "after": after_s,
                    "qty": str(m.get("qty", "") or ""),
                    "unit": str(m.get("unit", "") or ""),
                    "description": str(m.get("description", "") or ""),
                    "part_number": str(m.get("part_number", "") or ""),
                    "source": str(m.get("source", "") or ""),
                    "source_page": str(m.get("source_page", "") or ""),
                    "source_text": str(m.get("source_text", "") or ""),
                    "source_bbox_pct": m.get("source_bbox_pct", ""),
                    "group_id": group_id,
                    "group_name": group.get("name", "") if group else "",
                }
                mem["rfq_extraction_corrections"].append(rec)
                mem["rfq_extraction_corrections"] = mem["rfq_extraction_corrections"][-600:]
                self.procurement_memory = mem
                self.save_procurement_memory()
            except Exception:
                pass

        def update_cell(idx, col, value, ask_batch=True):
            if idx < 0 or idx >= len(mat_items):
                return
            selected_rows = [int(x) for x in mat_tree.selection() if str(x).isdigit()]
            apply_rows = [idx]
            if ask_batch and len(selected_rows) > 1 and idx in selected_rows and col != "req":
                if messagebox.askyesno("Apply to Selected Rows?", f"Apply this {col} value to all {len(selected_rows)} selected row(s)?"):
                    apply_rows = selected_rows
            for r in apply_rows:
                if r < 0 or r >= len(mat_items):
                    continue
                if col == "qty":
                    before = mat_items[r].get("qty", "")
                    after = str(value).strip()
                    mat_items[r]["qty"] = after
                    record_rfq_extraction_correction(r, "qty", before, after)
                elif col == "unit":
                    before = mat_items[r].get("unit", "")
                    after = str(value).strip()
                    mat_items[r]["unit"] = after
                    record_rfq_extraction_correction(r, "unit", before, after)
                elif col == "desc":
                    before = mat_items[r].get("description", "")
                    after = str(value).strip()
                    mat_items[r]["description"] = after
                    record_rfq_extraction_correction(r, "description", before, after)
                elif col == "part":
                    before = mat_items[r].get("part_number", "")
                    after = str(value).strip().upper()
                    mat_items[r]["part_number"] = after
                    record_rfq_extraction_correction(r, "part_number", before, after)
                elif col == "notes":
                    before = mat_items[r].get("notes", "")
                    after = str(value).strip()
                    mat_items[r]["notes"] = after
                    record_rfq_extraction_correction(r, "notes", before, after)
            redraw_materials([str(x) for x in apply_rows])
            _do_highlight_selected_material_source()
            save_current_rfq_cache()

        def close_cell_editor(save=False, move="none"):
            widget = cell_editor.get("widget")
            if not widget:
                return
            row = cell_editor.get("row")
            col = cell_editor.get("col")
            try:
                val = widget.get()
            except Exception:
                val = ""
            try:
                widget.destroy()
            except Exception:
                pass
            cell_editor.update({"widget": None, "row": None, "col": None})
            if save and row is not None and col:
                update_cell(int(row), col, val, ask_batch=True)
                if move == "down":
                    next_row = min(int(row) + 1, max(len(mat_items) - 1, 0))
                    win.after(80, lambda: begin_edit_cell(str(next_row), col))
                elif move == "tab":
                    order = ["qty", "unit", "desc", "part", "notes"]
                    try:
                        ni = order.index(col) + 1
                    except Exception:
                        ni = 0
                    if ni >= len(order):
                        ni = 0
                        next_row = min(int(row) + 1, max(len(mat_items) - 1, 0))
                    else:
                        next_row = int(row)
                    win.after(80, lambda: begin_edit_cell(str(next_row), order[ni]))
                elif move == "shift_tab":
                    order = ["qty", "unit", "desc", "part", "notes"]
                    try:
                        ni = order.index(col) - 1
                    except Exception:
                        ni = 0
                    if ni < 0:
                        ni = len(order) - 1
                        next_row = max(int(row) - 1, 0)
                    else:
                        next_row = int(row)
                    win.after(80, lambda: begin_edit_cell(str(next_row), order[ni]))

        def begin_edit_cell(row, col):
            if not row or not str(row).isdigit():
                return
            idx = int(row)
            if idx < 0 or idx >= len(mat_items):
                return
            if col == "req":
                mat_items[idx]["selected"] = not mat_items[idx].get("selected", True)
                redraw_materials([row])
                save_current_rfq_cache()
                return
            close_cell_editor(False)
            colnum = {"req": "#1", "qty": "#2", "unit": "#3", "desc": "#4", "part": "#5", "notes": "#6"}.get(col)
            if not colnum:
                return
            bbox = mat_tree.bbox(row, colnum)
            if not bbox:
                mat_tree.see(row)
                bbox = mat_tree.bbox(row, colnum)
                if not bbox:
                    return
            x, y, w, h = bbox
            current = ""
            if col == "qty": current = mat_items[idx].get("qty", "")
            elif col == "unit": current = mat_items[idx].get("unit", "")
            elif col == "desc": current = mat_items[idx].get("description", "")
            elif col == "part": current = mat_items[idx].get("part_number", "")
            elif col == "notes": current = mat_items[idx].get("notes", "")
            if col == "unit":
                editor = ttk.Combobox(mat_tree, values=UOM_VALUES, state="normal")
                editor.set(current)
            else:
                editor = tk.Entry(mat_tree)
                editor.insert(0, current)
            editor.place(x=x, y=y, width=w, height=h)
            editor.focus_set()
            try:
                editor.select_range(0, tk.END)
            except Exception:
                pass
            cell_editor.update({"widget": editor, "row": row, "col": col})
            last_edit_col["col"] = col
            editor.bind("<Return>", lambda e: (close_cell_editor(True, "down"), "break")[1])
            editor.bind("<Tab>", lambda e: (close_cell_editor(True, "tab"), "break")[1])
            editor.bind("<Shift-Tab>", lambda e: (close_cell_editor(True, "shift_tab"), "break")[1])
            editor.bind("<Escape>", lambda e: (close_cell_editor(False), "break")[1])
            editor.bind("<FocusOut>", lambda e: close_cell_editor(True, "none"))

        def mat_click(event):
            row = mat_tree.identify_row(event.y)
            colid = mat_tree.identify_column(event.x)
            col_map = {"#1": "req", "#2": "qty", "#3": "unit", "#4": "desc", "#5": "part", "#6": "notes"}
            col = col_map.get(colid)
            if row and col == "req":
                begin_edit_cell(row, "req")
                return "break"
            return None

        def mat_double_click(event):
            row = mat_tree.identify_row(event.y)
            colid = mat_tree.identify_column(event.x)
            col_map = {"#1": "req", "#2": "qty", "#3": "unit", "#4": "desc", "#5": "part", "#6": "notes"}
            col = col_map.get(colid)
            if row and col:
                begin_edit_cell(row, col)
                return "break"
            return None

        def mat_key(event):
            sel = mat_tree.selection()
            if not sel:
                return None
            row = sel[0]
            if event.keysym in ["Return", "F2"]:
                begin_edit_cell(row, last_edit_col.get("col", "qty"))
                return "break"
            if event.keysym == "space":
                begin_edit_cell(row, "req")
                return "break"
            return None

        def requested_click(event):
            row = requested_tree.identify_row(event.y)
            col = requested_tree.identify_column(event.x)
            if row and col == "#1":
                idx = int(row)
                requested_records[idx]["selected"] = not requested_records[idx].get("selected", False)
                redraw_requested()
                save_current_rfq_cache()
                return "break"
            return None

        def get_selected_source_lines_for_add():
            """Return highlighted source/body text lines for Add Row teaching.

            When the user highlights a missing line in the left Source Text / Scan
            Output text and clicks Add Row, MaINbox should insert that line at the
            current grid position instead of only appending a blank row.
            """
            candidates = []
            for widget in [source_text]:
                try:
                    if widget.tag_ranges(tk.SEL):
                        raw = widget.get(tk.SEL_FIRST, tk.SEL_LAST)
                        candidates.extend([ln.strip() for ln in str(raw or "").splitlines() if ln.strip()])
                        break
                except Exception:
                    pass
            cleaned = []
            for line in candidates:
                line = re.sub(r"^[\s>*•\-]+", "", str(line or "")).strip()
                line = re.sub(r"^\(?\d+\)?[\).]\s+", "", line).strip()
                if line:
                    cleaned.append(line)
            return cleaned

        def parse_manual_source_material_line(line):
            """Best-effort parser for a user-highlighted missing RFQ line."""
            raw = re.sub(r"\s+", " ", str(line or "").strip())
            raw = raw.strip(" -:;|\t")
            qty = ""
            unit = ""
            desc = raw
            if "|" in raw:
                parts = [p.strip() for p in raw.split("|") if p.strip()]
                if parts:
                    first = parts[0]
                    rest = " | ".join(parts[1:]).strip()
                    m = re.match(r"^(\d[\d,]*(?:\.\d+)?)\s*([A-Za-z]{1,12})?$", first, flags=re.I)
                    if m and rest:
                        qty = m.group(1).replace(",", "")
                        unit = (m.group(2) or "").strip().lower()
                        desc = rest
                    else:
                        qty, unit, desc2 = split_qty_unit_description(" ".join(parts))
                        desc = desc2 or rest or raw
            else:
                qty, unit, desc = split_qty_unit_description(raw)
            unit_map = {"boxes": "box", "bags": "bag", "pcs": "pc", "pieces": "pc", "each": "ea"}
            unit = unit_map.get(str(unit or "").lower(), str(unit or "").lower())
            desc = str(desc or raw).strip(" -:;|")
            part = ""
            if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/#\-]{1,30}", desc or ""):
                part = desc.upper()
            return {
                "selected": True,
                "qty": qty or "1",
                "unit": unit or "ea",
                "description": desc,
                "part_number": part,
                "manufacturer": "",
                "notes": "manual from highlighted source",
                "source": "user-highlighted-source",
            }

        def add_material():
            source_lines = get_selected_source_lines_for_add()
            selected_indexes = sorted([int(i) for i in mat_tree.selection() if str(i).isdigit()])
            insert_at = (selected_indexes[-1] + 1) if selected_indexes else len(mat_items)
            prior_text = ""
            if insert_at > 0 and insert_at - 1 < len(mat_items):
                try:
                    prior_text = material_display_text(mat_items[insert_at - 1])
                except Exception:
                    prior_text = ""

            if source_lines:
                new_rows = [parse_manual_source_material_line(line) for line in source_lines]
            else:
                new_rows = [{"selected": True, "qty": "1", "unit": "ea", "description": "", "part_number": "", "notes": "manual", "source": "manual"}]

            inserted_ids = []
            for offset, row in enumerate(new_rows):
                idx = min(max(insert_at + offset, 0), len(mat_items))
                source_line = source_lines[offset] if offset < len(source_lines) else "manual row added"
                if source_lines and not row.get("source_text"):
                    row["source_text"] = source_line
                mat_items.insert(idx, row)
                inserted_ids.append(str(idx))
                before_hint = f"inserted after: {prior_text}" if prior_text else "manual insertion"
                after_hint = source_line if source_line else material_display_text(row) or "manual row added"
                record_rfq_extraction_correction(idx, "row", before_hint, after_hint, action="add_from_source" if source_lines else "add")
                prior_text = material_display_text(row)

            redraw_materials(inserted_ids)
            save_current_rfq_cache()
            if inserted_ids:
                mat_tree.selection_set(inserted_ids[0])
                mat_tree.focus(inserted_ids[0])
                mat_tree.see(inserted_ids[0])
                _do_highlight_selected_material_source()
                begin_edit_cell(inserted_ids[0], "desc" if source_lines else "desc")

