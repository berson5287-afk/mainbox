    def open_quote_intelligence_window(self, group_id, materials, vendors, ocr_details, used_ai, requote_mode=False):
        """v2.8.4C RFQ & Materials Extractor.

        Keeps v2.8.3 as the base and upgrades only the RFQ/material editing UI:
        - spreadsheet-style material grid
        - editable cells with Enter = next row same column
        - UOM dropdown support
        - multi-row batch edit with Yes/No prompt
        - selected items move to ITEMS ALREADY REQUESTED only after Send RFQs Now
        """
        group = self.get_group_by_id(group_id)
        emails = self.get_emails_for_group(group_id)
        customer_hint = self.get_customer_hint_for_group(group, emails)

        mat_items = []
        vend_items = []
        requested_records = []
        cell_editor = {"widget": None, "row": None, "col": None}
        last_edit_col = {"col": "qty"}
        UOM_VALUES = ["", "ft", "ea", "m", "c", "in", "pc", "box", "roll", "set", "lot"]

        def save_current_rfq_cache():
            """Cache the current RFQ window state, including user edits."""
            if requote_mode:
                # v4.1.36: a Re-quote session is COMPOSE-ONLY. Its material list is a
                # deliberate SUBSET of the ledger, so it must never act as the ledger
                # mirror (record_rfq_cache -> update_coverage_requested_from_rfq with
                # replace_source would delete every other extractor-sourced requested
                # row) and must never overwrite the group's full RFQ cache.
                return
            try:
                subj = subject_var.get().strip() if "subject_var" in locals() else ""
            except Exception:
                subj = ""
            try:
                body = body_text.get("1.0", tk.END).strip() if "body_text" in locals() else ""
            except Exception:
                body = ""
            try:
                self.record_rfq_cache(group_id, materials=mat_items, vendors=vend_items, ocr_details=ocr_details,
                                      used_ai=used_ai, group=group, emails=emails, customer_hint=customer_hint,
                                      requested_records=requested_records, subject=subj, body=body)
            except Exception:
                pass

        cached_window_state = self.get_rfq_cache_record(group_id)

        def _build_left_source_text():
            """Build the source body shown on the left side of the RFQ window.

            This intentionally does not change extraction behavior; it only gives the
            user the original/cached RFQ text beside the extracted rows for easier
            line-by-line review and manual teaching/correction.
            """
            try:
                cached_quote_text = str((cached_window_state or {}).get("quote_text", "") or "").strip()
                if cached_quote_text:
                    return cached_quote_text
            except Exception:
                pass
            parts = []
            try:
                for e in emails or []:
                    subj = str(e.get("subject", "") or "").strip()
                    sender = str(e.get("sender", "") or "").strip()
                    received = str(e.get("received", "") or "").strip()
                    body = str(e.get("body", "") or "").strip()
                    block = []
                    if subj:
                        block.append(f"Subject: {subj}")
                    if sender:
                        block.append(f"From: {sender}")
                    if received:
                        block.append(f"Received: {received}")
                    if body:
                        block.append("Body:\n" + body)
                    if block:
                        parts.append("\n".join(block))
            except Exception:
                pass
            return "\n\n--- EMAIL ---\n\n".join(parts).strip() or "No cached email body/source text is available for this RFQ."

        source_body_text = _build_left_source_text()

        for rr in cached_window_state.get("requested_records", []) if isinstance(cached_window_state, dict) else []:
            if isinstance(rr, dict):
                requested_records.append(rr)

        for rec in self.quote_requests or []:
            if rec.get("group_id") == group_id:
                sent_to = ", ".join([f"{v.get('name', v.get('email',''))} <{v.get('email','')}>" for v in rec.get("vendors", [])])
                sent_on = rec.get("created_at", "")
                for m in normalize_material_items(rec.get("materials", [])):
                    requested_records.append({"selected": False, "material": m, "sent_to": sent_to, "sent_on": sent_on})

        # Avoid duplicate "already requested" rows when cached state and quote history overlap.
        try:
            deduped_requested = []
            seen_requested = set()
            for rr in requested_records:
                m = rr.get("material", {}) if isinstance(rr, dict) else {}
                key = re.sub(r"\s+", " ", f"{canonical_material_key(m)}|{rr.get('sent_to','')}|{rr.get('sent_on','')}".lower()).strip()
                if key in seen_requested:
                    continue
                seen_requested.add(key)
                deduped_requested.append(rr)
            requested_records[:] = deduped_requested
        except Exception:
            pass

        win = tk.Toplevel(self.root)
        apply_theme(win)
        win.title(f"MaINbox v{mainbox_version_number()} RFQ - {group.get('name','') if group else ''}")
        remember_window_geometry(win, "Procurement Memory RFQ", "1560x980")
        try:
            win.minsize(1420, 860)
        except Exception:
            pass
        win.transient(self.root)

        # ---------------- Header ----------------
        header = tk.Frame(win)
        header.pack(fill="x", padx=10, pady=(8, 4))
        tk.Label(header, text="MaINbox - RFQ & Materials Extractor", font=("Segoe UI", 16, "bold")).pack(side="left")
        engine_label = "AI + OCR text" if used_ai else "OCR/heuristic extraction"
        tk.Label(header, text=f"   Extraction mode: {engine_label}", fg=_FG_DIM, font=("Segoe UI", 9)).pack(side="left")

        outer = tk.PanedWindow(win, orient=tk.HORIZONTAL, sashrelief=tk.RAISED)
        outer.pack(fill="both", expand=True, padx=10, pady=4)
        left_panel = tk.Frame(outer)
        center_panel = tk.Frame(outer)
        right_panel = tk.Frame(outer)
        outer.add(left_panel, minsize=270)
        outer.add(center_panel, minsize=760)
        outer.add(right_panel, minsize=430)

        # ---------------- Left side source/body + OCR info panel ----------------
        left_view_mode = {"mode": "body"}

        left_toolbar = tk.Frame(left_panel)
        left_toolbar.pack(fill="x", padx=4, pady=(4, 2))
        left_title_var = tk.StringVar(value="Email Body / Source Text")
        left_toggle_var = tk.StringVar(value="Show Scan Output")
        tk.Label(left_toolbar, textvariable=left_title_var, font=("Segoe UI", 10, "bold"), anchor="w").pack(side="left", fill="x", expand=True)

        left_content = tk.Frame(left_panel)
        left_content.pack(fill="both", expand=True, padx=4, pady=(0, 6))

        source_frame = tk.Frame(left_content)
        source_frame.pack(fill="both", expand=True)
        source_help = tk.Label(
            source_frame,
            text="Review the customer email/source text beside the extracted rows. Use Add Row or edit the grid to teach/correct missing line items.",
            anchor="w", justify="left", wraplength=450, fg=_FG_DIM
        )
        source_help.pack(fill="x", padx=5, pady=(4, 2))
        source_text = tk.Text(source_frame, height=28, wrap="word", font=("Segoe UI", 9))
        source_scroll = ttk.Scrollbar(source_frame, orient="vertical", command=source_text.yview)
        source_text.configure(yscrollcommand=source_scroll.set)
        source_text.pack(side="left", fill="both", expand=True, padx=(5, 0), pady=5)
        source_scroll.pack(side="right", fill="y", padx=(0, 5), pady=5)
        source_text.insert("1.0", source_body_text)

        scan_frame = tk.Frame(left_content)

        # v2.10.45: Scan Output / teaching view.  This is a review aid only; it does
        # not change the extraction pipeline.  It shows the saved scan/page preview
        # when available and highlights the likely source row as the user moves
        # through extracted items.  User edits are recorded into procurement memory
        # so future RFQ prompts can learn from corrections.
        scan_preview_frame = tk.Frame(scan_frame)
        scan_preview_frame.pack(fill="both", expand=True, padx=0, pady=(0, 4))
        scan_nav = tk.Frame(scan_preview_frame)
        scan_nav.pack(fill="x", padx=5, pady=(4, 2))
        scan_hint_var = tk.StringVar(value="Select an extracted line item to highlight its likely source. Edit or add rows on the right to teach MaINbox.")
        tk.Label(scan_nav, textvariable=scan_hint_var, anchor="w", justify="left", wraplength=430).pack(side="left", fill="x", expand=True)

        scan_canvas_frame = tk.Frame(scan_preview_frame)
        scan_canvas_frame.pack(fill="both", expand=True, padx=5, pady=5)
        scan_canvas = tk.Canvas(scan_canvas_frame, bg="#ffffff", highlightthickness=1, highlightbackground="#999999")
        scan_canvas_v = ttk.Scrollbar(scan_canvas_frame, orient="vertical", command=scan_canvas.yview)
        scan_canvas_h = ttk.Scrollbar(scan_canvas_frame, orient="horizontal", command=scan_canvas.xview)
        scan_canvas.configure(yscrollcommand=scan_canvas_v.set, xscrollcommand=scan_canvas_h.set)
        scan_canvas.grid(row=0, column=0, sticky="nsew")
        scan_canvas_v.grid(row=0, column=1, sticky="ns")
        scan_canvas_h.grid(row=1, column=0, sticky="ew")
        scan_canvas_frame.grid_rowconfigure(0, weight=1)
        scan_canvas_frame.grid_columnconfigure(0, weight=1)
        scan_img_state = {"tk": None, "path": "", "scale": 1.0, "w": 0, "h": 0, "highlight": None}

        def _extract_existing_path_from_detail(detail):
            text = str(detail or "")
            # Prefer rendered PDF/image previews. Also accept saved original image files.
            patterns = [
                r"spreadsheet preview image saved for debug:\s*(.+?\.(?:png|jpg|jpeg|webp|bmp))",
                r"rendered PDF page image saved for debug:\s*(.+?\.(?:png|jpg|jpeg|webp|bmp))",
                r"DEBUG PROOF COPY:\s*(.+?\.(?:png|jpg|jpeg|webp|bmp))",
                r"saved to\s+(.+?\.(?:png|jpg|jpeg|webp|bmp))\s*\(",
            ]
            for pat in patterns:
                m = re.search(pat, text, flags=re.I)
                if not m:
                    continue
                candidate = m.group(1).strip().strip('"')
                if os.path.exists(candidate):
                    return candidate
            return ""

        def _find_scan_preview_path(material=None):
            """Find the best original preview image, preferring the selected item's page/source."""
            try:
                desired_page = None
                desired_source = ""
                if isinstance(material, dict):
                    desired_source = str(material.get("source", "") or "") + " " + str(material.get("source_page", "") or "")
                    pm = re.search(r"page\s*(\d+)", desired_source, flags=re.I)
                    if pm:
                        desired_page = int(pm.group(1))
                candidates = []
                for d in ocr_details or []:
                    path = _extract_existing_path_from_detail(d)
                    if not path:
                        continue
                    score = 0
                    text = str(d or "")
                    if desired_page is not None and re.search(rf"page\s*{desired_page}", text, flags=re.I):
                        score += 10
                    if isinstance(material, dict):
                        src = str(material.get("source", "") or "")
                        for token in re.split(r"[:\/ ]+", src):
                            token = token.strip()
                            if len(token) >= 4 and token.lower() in text.lower():
                                score += 2
                                break
                    candidates.append((score, path))
                if candidates:
                    candidates.sort(reverse=True)
                    return candidates[0][1]
            except Exception:
                pass
            return ""

        # Maps item index -> canvas Y coordinate in text-preview mode.
        # Populated by _draw_text_scan_preview() and used by the highlighter
        # so it doesn't have to recompute row positions on every selection.
        _text_preview_row_y = {}

        def _draw_text_scan_preview():
            scan_canvas.delete("all")
            _text_preview_row_y.clear()
            scan_img_state.update({"tk": None, "path": "", "scale": 1.0, "w": 0, "h": 0, "highlight": None})
            scan_canvas.create_text(10, 10, anchor="nw", text="No original document image preview was found. Showing source text rows as a review guide.", fill="#111111", font=("Segoe UI", 10, "bold"))
            y = 42
            scan_canvas.create_text(10, y, anchor="nw", text="Qty", fill="#111111", font=("Segoe UI", 9, "bold"))
            scan_canvas.create_text(80, y, anchor="nw", text="Material / Description", fill="#111111", font=("Segoe UI", 9, "bold"))
            y += 24
            total_rows = min(len(mat_items), 300)
            for i, m in enumerate(mat_items[:300]):
                row_y = y + i * 26
                _text_preview_row_y[i] = row_y          # store for fast lookup
                scan_canvas.create_line(5, row_y - 4, 900, row_y - 4, fill="#cccccc")
                scan_canvas.create_text(10, row_y, anchor="nw", text=str(m.get("qty", "")), fill="#111111", font=("Segoe UI", 10))
                scan_canvas.create_text(80, row_y, anchor="nw", text=str(m.get("source_text", "") or m.get("description", "") or m.get("part_number", "")), fill="#111111", font=("Segoe UI", 10))
            # Scrollregion height is the actual bottom of content + padding.
            canvas_h = max(420, y + total_rows * 26 + 40)
            scan_canvas.configure(scrollregion=(0, 0, 950, canvas_h))

        def _load_scan_preview_image(force=False, material=None):
            path = _find_scan_preview_path(material)
            if not path:
                # Only redraw the text preview when we are not already showing it
                # (i.e. no cached image is displayed).  This avoids a full canvas
                # redraw — and loss of the "source_highlight" rectangle — on every
                # item selection when no image is available.
                if scan_img_state.get("tk") is not None or not _text_preview_row_y:
                    _draw_text_scan_preview()
                    scan_hint_var.set("No saved original document preview was found. MaINbox will highlight source text rows instead.")
                return False
            if not force and scan_img_state.get("path") == path and scan_img_state.get("tk") is not None:
                return True
            try:
                from PIL import Image, ImageTk
                img = Image.open(path)
                max_w = 620
                scale = min(1.0, float(max_w) / max(1, img.width))
                if scale < 1.0:
                    img = img.resize((int(img.width * scale), int(img.height * scale)))
                tk_img = ImageTk.PhotoImage(img)
                scan_canvas.delete("all")
                scan_canvas.create_image(0, 0, anchor="nw", image=tk_img, tags=("scan_image",))
                scan_canvas.configure(scrollregion=(0, 0, img.width, img.height))
                scan_img_state.update({"tk": tk_img, "path": path, "scale": scale, "w": img.width, "h": img.height, "highlight": None})
                scan_hint_var.set(f"Showing saved scan preview: {os.path.basename(path)}. Select/edit items to highlight and teach MaINbox.")
                return True
            except Exception as exc:
                _draw_text_scan_preview()
                scan_hint_var.set(f"Scan preview image could not be loaded ({exc}). Showing extracted-row guide instead.")
                return False

        def _highlight_source_text_for_material(m):
            try:
                source_text.tag_remove("rfq_current_source", "1.0", tk.END)
                source_text.tag_configure("rfq_current_source", background="#5a4a22", foreground="#fff4cc")
                candidates = [str(m.get("source_text", "") or ""), str(m.get("description", "") or ""), str(m.get("part_number", "") or ""), str(m.get("qty", "") or "")]
                candidates = [c.strip() for c in candidates if len(c.strip()) >= 2]
                for cand in candidates:
                    pos = source_text.search(cand, "1.0", nocase=True, stopindex=tk.END)
                    if pos:
                        end = f"{pos}+{len(cand)}c"
                        source_text.tag_add("rfq_current_source", pos, end)
                        source_text.see(pos)
                        break
            except Exception:
                pass

        def _parse_source_bbox_pct(value):
            try:
                if isinstance(value, str):
                    value = value.strip()
                    if not value:
                        return None
                    try:
                        value = json.loads(value)
                    except Exception:
                        nums = re.findall(r"-?\d+(?:\.\d+)?", value)
                        value = [float(x) for x in nums[:4]]
                if isinstance(value, dict):
                    value = [value.get("x1"), value.get("y1"), value.get("x2"), value.get("y2")]
                if not isinstance(value, (list, tuple)) or len(value) < 4:
                    return None
                vals = [float(value[i]) for i in range(4)]
                if vals[2] <= vals[0] or vals[3] <= vals[1]:
                    return None
                # Accept either percent 0-100 or normalized 0-1.
                if max(vals) <= 1.5:
                    vals = [v * 100.0 for v in vals]
                vals = [max(0.0, min(100.0, v)) for v in vals]
                return vals
            except Exception:
                return None

        # Debounce token for highlight_selected_material_source so rapid keyboard
        # navigation doesn't queue a burst of redundant canvas updates.
        _highlight_pending = {"after_id": None}

        def _do_highlight_selected_material_source():
            """Actual highlight work; always called via after() so it can be debounced."""
            _highlight_pending["after_id"] = None
            try:
                sel = mat_tree.selection() if "mat_tree" in locals() else []
                if not sel:
                    return
                idx = int(sel[0])
                if idx < 0 or idx >= len(mat_items):
                    return
                m = mat_items[idx]
                _highlight_source_text_for_material(m)

                # ── Determine whether the image needs switching ─────────────────
                # Find the best preview path for this item *before* we draw
                # anything so we know whether the canvas needs to change.
                new_path = _find_scan_preview_path(m)
                currently_image = scan_img_state.get("tk") is not None
                current_path   = scan_img_state.get("path", "")

                image_changed = new_path and (new_path != current_path)

                if image_changed:
                    # Image switch: reload first, *then* draw the rectangle below.
                    _load_scan_preview_image(False, m)
                elif not currently_image:
                    # Already in text mode — ensure the text grid is drawn.
                    if not _text_preview_row_y:
                        _draw_text_scan_preview()
                # (If same image is already shown, skip the reload entirely.)

                # ── Remove old highlight rectangle ───────────────────────────────
                try:
                    scan_canvas.delete("source_highlight")
                except Exception:
                    pass

                # ── Parse line/row number hint from item metadata ────────────────
                line_text = str(m.get("source_page", "") or m.get("notes", "") or "")
                line_num = None
                lm = re.search(r"(?:row|line)\s*(\d+)", line_text, flags=re.I)
                if lm:
                    try:
                        line_num = int(lm.group(1))
                    except Exception:
                        line_num = None

                if scan_img_state.get("tk") is not None:
                    # ── IMAGE mode ───────────────────────────────────────────────
                    w = max(120, int(scan_img_state.get("w") or 500))
                    h = max(120, int(scan_img_state.get("h") or 500))
                    bbox = _parse_source_bbox_pct(m.get("source_bbox_pct"))

                    if bbox:
                        x1 = int((bbox[0] / 100.0) * w)
                        y1 = int((bbox[1] / 100.0) * h)
                        x2 = int((bbox[2] / 100.0) * w)
                        y2 = int((bbox[3] / 100.0) * h)
                    elif line_num:
                        # Spreadsheet/table: map explicit row number to visual row.
                        scale = float(scan_img_state.get("scale") or 1.0)
                        y1 = max(10, min(h - 45, int((18 + line_num * 24) * scale)))
                        y2 = min(h - 5, y1 + 34)
                        x1, x2 = 8, w - 8
                    else:
                        # Proportional fallback — place the band in the document
                        # body area (skipping ~10 % header / footer margin) so it
                        # doesn't always snap to the very top or bottom.
                        body_top    = int(h * 0.10)
                        body_bottom = int(h * 0.90)
                        total = max(1, len(mat_items))
                        frac  = idx / max(1, total - 1)
                        mid   = body_top + int((body_bottom - body_top) * frac)
                        band  = max(20, int((body_bottom - body_top) / max(1, total)))
                        y1 = max(body_top, mid - band // 2)
                        y2 = min(body_bottom, y1 + band)
                        x1, x2 = 8, w - 8

                    scan_canvas.create_rectangle(x1, y1, x2, y2, outline="#c99632", width=3, tags=("source_highlight",))
                    try:
                        label_text = f"Item {idx + 1}: {m.get('qty','')} {m.get('description','') or m.get('part_number','')}"
                        lx = max(8, x1)
                        ly = max(8, y1 - 18)
                        scan_canvas.create_text(lx, ly, anchor="nw", text=label_text[:80], fill="#000000", font=("Segoe UI", 9, "bold"), tags=("source_highlight",))
                    except Exception:
                        pass
                    scan_canvas.tag_raise("source_highlight")

                    # Scroll so the highlighted band sits roughly 20 % from the
                    # top of the visible area, clamped to [0, 1].
                    view_margin = int(scan_canvas.winfo_height() * 0.20) if scan_canvas.winfo_height() > 1 else 60
                    target_top  = max(0, y1 - view_margin)
                    frac_scroll = target_top / max(1, h)
                    scan_canvas.yview_moveto(min(1.0, max(0.0, frac_scroll)))

                else:
                    # ── TEXT-PREVIEW mode ────────────────────────────────────────
                    # Use the pre-computed Y positions from _draw_text_scan_preview
                    # so there's no off-by-one between what's drawn and what we scroll to.
                    row_y = _text_preview_row_y.get(idx)
                    if row_y is None:
                        # Fallback if the index is out of the rendered range.
                        row_y = 66 + idx * 26
                    scan_canvas.create_rectangle(5, row_y - 5, 900, row_y + 22,
                                                 outline="#c99632", width=2, fill="",
                                                 tags=("source_highlight",))
                    scan_canvas.tag_raise("source_highlight")

                    # Correct scroll fraction: use the actual scrollregion height.
                    sr = scan_canvas.cget("scrollregion")
                    try:
                        canvas_h = float(str(sr).split()[-1]) if sr else max(420, 66 + len(mat_items) * 26 + 40)
                    except Exception:
                        canvas_h = max(420, 66 + len(mat_items) * 26 + 40)
                    view_margin = int(scan_canvas.winfo_height() * 0.20) if scan_canvas.winfo_height() > 1 else 60
                    target_top  = max(0, row_y - view_margin)
                    frac_scroll = target_top / max(1, canvas_h)
                    scan_canvas.yview_moveto(min(1.0, max(0.0, frac_scroll)))

                scan_hint_var.set(f"Source highlight for item {idx + 1}: {m.get('qty','')} {m.get('description','') or m.get('part_number','')}")
            except Exception:
                pass

        def highlight_selected_material_source(event=None):
            """Debounced entry point — coalesces rapid <<TreeviewSelect>> events."""
            if _highlight_pending["after_id"] is not None:
                try:
                    scan_canvas.after_cancel(_highlight_pending["after_id"])
                except Exception:
                    pass
            _highlight_pending["after_id"] = scan_canvas.after(40, _do_highlight_selected_material_source)

        tk.Button(scan_nav, text="Prev Item", command=lambda: select_adjacent_material(-1)).pack(side="right", padx=2)
        tk.Button(scan_nav, text="Next Item", command=lambda: select_adjacent_material(1)).pack(side="right", padx=2)

        def select_adjacent_material(delta):
            try:
                sel = mat_tree.selection() if "mat_tree" in locals() else []
                cur = int(sel[0]) if sel else 0
                nxt = max(0, min(len(mat_items) - 1, cur + int(delta)))
                mat_tree.selection_set(str(nxt))
                mat_tree.focus(str(nxt))
                mat_tree.see(str(nxt))
                # Cancel any pending debounced highlight and run immediately so
                # Prev/Next buttons feel snappy.
                if _highlight_pending["after_id"] is not None:
                    try:
                        scan_canvas.after_cancel(_highlight_pending["after_id"])
                    except Exception:
                        pass
                    _highlight_pending["after_id"] = None
                _do_highlight_selected_material_source()
            except Exception:
                pass

        status_frame = tk.LabelFrame(scan_frame, text="OCR & Extraction Engine", font=("Segoe UI", 10, "bold"))
        status_frame.pack(fill="x", padx=0, pady=(0, 4))
        tk.Label(status_frame, text="Best Available Pipeline", anchor="w", font=("Segoe UI", 9, "bold")).pack(fill="x", padx=8, pady=(5, 2))

        def tool_available(cmd):
            try:
                import shutil as _shutil
                return bool(_shutil.which(cmd))
            except Exception:
                return False

        def _ollama_installed_models():
            """Return installed Ollama model names from /api/tags.

            Important: do not use `ollama ps` here because it only shows models currently
            loaded in memory. /api/tags shows installed models, which is what this status
            panel needs.
            """
            try:
                tags_url = OLLAMA_URL.replace("/api/generate", "/api/tags")
                req = urllib.request.Request(tags_url, method="GET")
                with urllib.request.urlopen(req, timeout=2.0) as resp:
                    data = json.loads(resp.read().decode("utf-8", errors="replace"))
                return [str(m.get("name", "") or "").strip() for m in data.get("models", []) if m.get("name")]
            except Exception:
                return []

        def _resolve_ollama_model_status(model_name):
            """Return (display_name, available_bool) for an Ollama model.

            Ollama often stores models as `name:latest` even when the app is configured
            as just `name`. Treat those as a match so installed models do not show a red
            warning incorrectly.
            """
            wanted = str(model_name or "").strip()
            if not wanted:
                return "Not configured", False
            installed = _ollama_installed_models()
            if not installed:
                return wanted, False

            wanted_base = wanted.split(":", 1)[0]
            for actual in installed:
                actual_base = actual.split(":", 1)[0]
                if actual == wanted or actual_base == wanted_base:
                    return actual, True
            return wanted, False

        rfq_text_display, rfq_text_ok = _resolve_ollama_model_status(RFQ_TEXT_MODEL)
        rfq_vision_display, rfq_vision_ok = _resolve_ollama_model_status(RFQ_VISION_MODEL)

        pipeline_rows = [
            ("PDF Text Extraction", "Available", True),
            ("Ghostscript", "Available" if (tool_available("gswin64c") or os.path.exists(r"C:\\Program Files\\gs")) else "Not detected", (tool_available("gswin64c") or os.path.exists(r"C:\\Program Files\\gs"))),
            ("Tesseract OCR", "Available" if (tool_available("tesseract") or os.path.exists(r"C:\\Program Files\\Tesseract-OCR\\tesseract.exe")) else "Not detected", (tool_available("tesseract") or os.path.exists(r"C:\\Program Files\\Tesseract-OCR\\tesseract.exe"))),
            ("AI Cleanup", "Enabled" if OLLAMA_ENABLED else "Disabled", bool(OLLAMA_ENABLED)),
            ("RFQ Text Model", rfq_text_display, rfq_text_ok),
            ("RFQ Vision Model", rfq_vision_display, rfq_vision_ok),
            ("Line Item Detection", "Enabled", True),
            ("Procurement Memory", "Enabled", True),
            ("Price / Award History", "Enabled", True),
        ]
        for name, status, ok in pipeline_rows:
            row = tk.Frame(status_frame)
            row.pack(fill="x", padx=8, pady=2)
            fg = "#38761d" if ok else "#a61c00"
            tk.Label(row, text="✓" if ok else "!", fg=fg, width=2).pack(side="left")
            tk.Label(row, text=name, anchor="w").pack(side="left", fill="x", expand=True)
            tk.Label(row, text=status, fg=fg, anchor="e").pack(side="right")

        summary_frame = tk.LabelFrame(scan_frame, text="Extraction Summary", font=("Segoe UI", 10, "bold"))
        summary_frame.pack(fill="x", padx=0, pady=6)
        summary_text = tk.Text(summary_frame, height=8, wrap="word", font=("Segoe UI", 9))
        summary_text.pack(fill="both", expand=True, padx=5, pady=5)
        summary_text.insert("1.0", "Loading extraction summary...")
        summary_text.config(state="disabled")

        raw_frame = tk.LabelFrame(scan_frame, text="Attachment / OCR Status", font=("Segoe UI", 10, "bold"))
        raw_frame.pack(fill="both", expand=True, padx=0, pady=6)
        raw_status = tk.Text(raw_frame, height=14, wrap="word", font=("Segoe UI", 9))
        raw_status.pack(fill="both", expand=True, padx=5, pady=5)

        def refresh_raw_status():
            try:
                raw_lines = ocr_details or ["No attachment/OCR details were reported."]
                raw_status.config(state="normal")
                raw_status.delete("1.0", tk.END)
                raw_status.insert("1.0", "\n".join("• " + str(x) for x in raw_lines))
                raw_status.config(state="disabled")
            except Exception:
                pass

        refresh_raw_status()

        def show_left_body():
            left_view_mode["mode"] = "body"
            scan_frame.pack_forget()
            source_frame.pack(fill="both", expand=True)
            left_title_var.set("Email Body / Source Text")
            left_toggle_var.set("Show Scan Output")

        def show_left_scan():
            left_view_mode["mode"] = "scan"
            source_frame.pack_forget()
            scan_frame.pack(fill="both", expand=True)
            left_title_var.set("Source Document Review")
            left_toggle_var.set("Show Email Body")
            _load_scan_preview_image(False)
            highlight_selected_material_source()
            refresh_raw_status()
            refresh_summary()

        def toggle_left_panel():
            if left_view_mode.get("mode") == "scan":
                show_left_body()
            else:
                show_left_scan()

        tk.Button(left_toolbar, textvariable=left_toggle_var, command=toggle_left_panel).pack(side="right", padx=(4, 0))

        def _summary_string():
            selected_count = len([m for m in mat_items if m.get("selected", True)])
            return (
                f"Line Items Found: {len(mat_items)}\n"
                f"Selected Items: {selected_count}\n"
                f"Already Requested: {len(requested_records)}\n"
                f"Suggested Vendors: {len(vend_items)}\n"
                f"Award Records: {len((self.procurement_memory or {}).get('awards', []))}\n"
                f"Price Records: {len((self.procurement_memory or {}).get('price_history', []))}\n"
                f"Group: {group.get('name','') if group else ''}\n"
                f"Customer Hint: {customer_hint or 'unknown'}\n"
            )

        def refresh_summary():
            txt = _summary_string()
            summary_text.config(state="normal")
            summary_text.delete("1.0", tk.END)
            summary_text.insert("1.0", txt)
            summary_text.config(state="disabled")

        # Keep the old OCR/status widgets available for the OCR / Extraction Info button,
        # but do not crowd the Scan Output teaching view by default.
        try:
            status_frame.pack_forget()
            summary_frame.pack_forget()
            raw_frame.pack_forget()
        except Exception:
            pass

        def show_ocr_extraction_info_popup():
            try:
                refresh_raw_status()
                refresh_summary()
            except Exception:
                pass
            pop = tk.Toplevel(win)
            pop.title("OCR / Extraction Info")
            remember_window_geometry(pop, "RFQ OCR Extraction Info", "900x720")
            top = tk.Frame(pop)
            top.pack(fill="x", padx=10, pady=(10, 4))
            tk.Label(top, text="OCR / Extraction Info", font=("Segoe UI", 13, "bold")).pack(side="left")
            txt = tk.Text(pop, wrap="word", font=("Segoe UI", 9))
            scroll = ttk.Scrollbar(pop, orient="vertical", command=txt.yview)
            txt.configure(yscrollcommand=scroll.set)
            txt.pack(side="left", fill="both", expand=True, padx=(10, 0), pady=(0, 10))
