def cloud_sync_record_applied(uploaded_at="", cloud_path="", device_id=""):
    """v4.1.0: remember which cloud backup this PC last applied/uploaded so the
    startup check only fires for genuinely NEWER backups from another PC."""
    try:
        state = _cloud_sync_read_state()
        if uploaded_at and uploaded_at >= str(state.get("uploaded_at", "")):
            state.update({"uploaded_at": uploaded_at, "cloud_path": cloud_path,
                          "device_id": device_id, "recorded_at": datetime.now().isoformat()})
            with open(CLOUD_SYNC_STATE_FILE, "w", encoding="utf-8") as f:
                json.dump(state, f, indent=2)
    except Exception:
        pass


def cloud_sync_pick_newer_remote(manifests, own_device_id, applied_uploaded_at="", own_hostname=""):
    """v4.1.0/v4.1.1/v4.1.2: decide whether a newer backup from ANOTHER PC exists.

    Returns (winning_manifest_or_None, reason_string). Floor is ONLY what this PC
    last applied or declined. v4.1.2: a manifest whose hostname matches THIS PC is
    treated as our own even when its device_id differs -- during the shared-id era
    both PCs uploaded into one cloud folder, so hostname is the only way to keep a
    PC from being offered its own old backup after the ids diverge."""
    try:
        own_host = str(own_hostname or "").strip().lower()
        best, best_ts = None, ""
        for m in manifests or []:
            if not isinstance(m, dict):
                continue
            ts = str(m.get("uploaded_at") or "")
            if not ts or not str(m.get("backup_cloud_path") or "").strip():
                continue
            if str(m.get("device_id") or "") == str(own_device_id or ""):
                continue  # never offer this PC its own backup
            m_host = str(m.get("hostname") or "").strip().lower()
            if own_host and m_host and m_host == own_host:
                continue  # our own hostname uploaded this (shared-id era) -- still ours
            if ts > best_ts:
                best, best_ts = m, ts
        if best is None:
            return None, f"no other-device backups found (own_id={str(own_device_id)[:8] or 'unset'}..., own_host={own_host or '?'})"
        floor = str(applied_uploaded_at or "")
        if best_ts > floor:
            return best, f"newer backup from {best.get('hostname') or best.get('device_id')} at {best_ts} (floor {floor or 'none'})"
        return None, f"newest other-device backup {best_ts} not newer than last applied/declined {floor}"
    except Exception as exc:
        return None, f"picker error: {exc}"


def cloud_sync_fetch_all_manifests(config):
    """v4.1.0: read every device's latest manifest from Supabase (read-only,
    small JSON files). Uses the same storage API the bridge uses."""
    supabase_url = str(config.get("supabase_url") or "").rstrip("/")
    key = str(config.get("supabase_service_role_key") or "")
    bucket = str(config.get("supabase_bucket") or "mainbox-backups").strip("/")
    prefix = str(config.get("cloud_prefix") or "mainbox").strip("/")
    latest_prefix = str(config.get("latest_mirror_prefix") or "latest").strip("/")
    if not supabase_url or not key:
        return []
    headers = {"apikey": key, "Authorization": f"Bearer {key}", "Content-Type": "application/json"}

    def _req(method, path, body=None):
        req = urllib.request.Request(supabase_url + path, data=body, headers=headers, method=method)
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.read()

    body = json.dumps({"prefix": f"{prefix}/", "limit": 200, "offset": 0,
                       "sortBy": {"column": "name", "order": "asc"}}).encode("utf-8")
    entries = json.loads(_req("POST", f"/storage/v1/object/list/{bucket}", body).decode("utf-8"))
    manifests = []
    for it in entries if isinstance(entries, list) else []:
        name = str((it or {}).get("name") or "").strip().strip("/")
        if not name or (it or {}).get("id") is not None:
            continue
        try:
            raw = _req("GET", f"/storage/v1/object/{bucket}/{prefix}/{name}/{latest_prefix}/manifest.json")
            m = json.loads(raw.decode("utf-8"))
            if isinstance(m, dict):
                manifests.append(m)
        except Exception:
            continue
    return manifests


def force_restored_db_authoritative():
    """v4.0.0: make a just-restored mainbox_data.db the single source of truth.

    The restore design relied on the EXTERNAL bridge re-stamping every restored
    app_state row's updated_at ("stamp_restored_db_freshness") so the newer-JSON
    rule in load_json() could not undo the restore. When the bridge doesn't do
    that, the failure is silent and total: the destination PC's own session
    JSONs (written minutes before clicking Restore) carry newer mtimes than the
    restored rows, so load_json() prefers them and ABSORBS the stale local
    state back into the freshly restored database -- the restore visibly
    "doesn't take" (old groups survive, memberships mix). This makes the app
    self-sufficient: on a restore-detected launch, BEFORE any state is loaded,
    (1) every app_state row is re-stamped to now, and (2) every DB-synced JSON
    file is rewritten from its restored DB row, so both clocks and contents
    agree that the restored data is newest. Best-effort per file; returns a
    summary for the log."""
    out = {"stamped": 0, "files": 0, "errors": [], "pending_replayed": 0}
    # v4.1.24 (external audit round 6, blocker #8): REPLAY pending-mirror JSON into the
    # restored DB FIRST. A cloud snapshot can be taken while a local JSON save succeeded
    # but its SQLite mirror failed (pending marker present) -- blindly rewriting every
    # JSON from the restored DB then erased that newer local state. Pending files are the
    # newest truth; push them into the restored DB before it becomes authoritative.
    try:
        _pending = _db_mirror_pending_load()
        # v4.1.25 (round 7, blocker #4): resolve every pending entry to the LOCAL file for
        # its state key -- entries written on another PC (portable 'state:' keys, or even
        # legacy absolute foreign paths matched by basename) replay correctly here.
        _by_state = {("state:" + str(v)): k for k, v in DB_SYNC_FILES.items()}
        _by_base = {os.path.basename(str(k)).lower(): k for k in DB_SYNC_FILES.keys()}
        for _pk in list(_pending.keys()):
            try:
                _ppath = _by_state.get(_pk)
                if not _ppath and _pk.startswith("file:"):
                    _ppath = _by_base.get(_pk[5:].lower())
                if not _ppath:
                    _ppath = _pk if _pk in DB_SYNC_FILES else _by_base.get(os.path.basename(str(_pk)).lower())
                _pkey = DB_SYNC_FILES.get(_ppath) if _ppath else None
                if not _pkey or not os.path.exists(_ppath):
                    _db_mirror_pending_update(_ppath or _pk, False)
                    continue
                with open(_ppath, "r", encoding="utf-8") as _pf:
                    _pdata = json.load(_pf)
                if save_json_to_db(_pkey, _pdata):
                    _db_mirror_pending_update(_ppath, False)
                    out["pending_replayed"] += 1
                else:
                    out["errors"].append(f"pending replay failed: {os.path.basename(_ppath)}")
            except Exception as _pexc:
                out["errors"].append(f"pending replay {_pk}: {_pexc}")
    except Exception as exc:
        out["errors"].append(f"pending scan: {exc}")
    try:
        init_mainbox_db()
        with sqlite3.connect(MAINBOX_DB_FILE) as conn:
            cur = conn.execute("UPDATE app_state SET updated_at=?", (datetime.now().isoformat(),))
            out["stamped"] = cur.rowcount if cur.rowcount is not None else 0
            conn.commit()
    except Exception as exc:
        out["errors"].append(f"stamp: {exc}")
    for path, state_key in DB_SYNC_FILES.items():
        try:
            if _db_mirror_pending_has(path):
                # Replay failed for this file: its JSON stays authoritative -- do NOT
                # overwrite it from the (stale for this key) restored DB.
                out["errors"].append(f"kept JSON (pending): {os.path.basename(path)}")
                continue
            data = load_json_from_db(state_key, None)
            if data is None:
                continue
            save_json(path, data)
            out["files"] += 1
        except Exception as exc:
            out["errors"].append(f"{os.path.basename(path)}: {exc}")
    return out



def _window_geometry_key(key):
    key = str(key or "window").strip()
    key = re.sub(r"[^A-Za-z0-9_. -]+", "_", key)
    key = re.sub(r"\s+", " ", key).strip()
    return key[:120] or "window"


def _load_window_geometry_map():
    try:
        if os.path.exists(WINDOW_GEOMETRY_FILE):
            with open(WINDOW_GEOMETRY_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
    except Exception:
        pass
    return {}


def _save_window_geometry_map(data):
    try:
        with open(WINDOW_GEOMETRY_FILE, "w", encoding="utf-8") as f:
            json.dump(data or {}, f, indent=2)
    except Exception:
        pass


_GEOMETRY_RE = re.compile(r"^(\d+)x(\d+)\+(-?\d+)\+(-?\d+)$")


def _virtual_screen_rect(win=None):
    """(left, top, width, height) of the whole virtual desktop, all monitors included.

    Win32 metrics first, because they are the only source that covers a MULTI-MONITOR
    layout and negative origins (a screen placed left of the primary). If ctypes is
    unavailable, ask Tk for the actual screen rather than guessing a size -- this machine
    is 3440x1440, so a hardcoded 1920x1080 would wrongly reject every window on the right
    half of the desktop."""
    try:
        g = ctypes.windll.user32.GetSystemMetrics
        left, top = g(76), g(77)          # SM_XVIRTUALSCREEN / SM_YVIRTUALSCREEN
        width, height = g(78), g(79)      # SM_CXVIRTUALSCREEN / SM_CYVIRTUALSCREEN
        if width > 0 and height > 0:
            return left, top, width, height
    except Exception:
        pass
    try:
        if win is not None:
            return 0, 0, int(win.winfo_screenwidth()), int(win.winfo_screenheight())
    except Exception:
        pass
    return 0, 0, 1920, 1080


def geometry_is_usable(geom, min_visible=160, win=None):
    """v4.2.25: True when this saved geometry would leave a usable part of the window on a
    real monitor.

    remember_window_geometry stored whatever win.geometry() returned and replayed it
    verbatim, with NO bounds check -- so once a window ended up off-screen it stayed
    off-screen for good. Reported twice as "it went right to minimize / it's stuck":
    the main window's saved geometry was 1709x950+-68+1339, which puts almost the whole
    window below the bottom of the screen, and the Due Follow-Ups popup was at
    1384x611+-35+1194. MaINbox never calls iconify() anywhere, so nothing was minimizing
    it -- it was being PLACED where it could not be seen, and restoring from the taskbar
    put it straight back there.

    Requires at least min_visible pixels of the window in BOTH axes to intersect the
    virtual desktop, and the title bar to be reachable (y not above the top edge), so the
    window can always be dragged.
    """
    m = _GEOMETRY_RE.match(str(geom or "").strip())
    if not m:
        return False
    w, h, x, y = (int(v) for v in m.groups())
    if w <= 0 or h <= 0:
        return False
    vl, vt, vw, vh = _virtual_screen_rect(win)
    vr, vb = vl + vw, vt + vh
    # Overlap between the window rect and the virtual desktop.
    ox = min(x + w, vr) - max(x, vl)
    oy = min(y + h, vb) - max(y, vt)
    # HALF the window must be on screen in each axis, not merely a sliver. A pure
    # "min_visible pixels" rule passed the reported Due Follow-Ups popup
    # (1384x611+-35+1194): 246 of its 611 rows were visible, so its title bar was
    # technically grabbable while every button along its bottom edge sat off the screen --
    # visible enough to pass a naive check, useless in practice.
    need_x = max(min(min_visible, w), w // 2)
    need_y = max(min(min_visible, h), h // 2)
    if ox < need_x or oy < need_y:
        return False
    # The title bar must be grabbable: never above the desktop top.
    if y < vt:
        return False
    return True


def remember_window_geometry(win, key, default_geometry=None):
    """Remember size/location for any Tk/Toplevel window without changing its behavior."""
    key = _window_geometry_key(key)

    try:
        data = _load_window_geometry_map()
        saved = data.get(key)
        # v4.2.25: refuse a saved position that would open the window off-screen. Size is
        # still honoured -- only the placement is dropped, and Tk then centres it.
        if saved and not geometry_is_usable(saved, win=win):
            m = _GEOMETRY_RE.match(str(saved).strip())
            saved = ("%sx%s" % (m.group(1), m.group(2))) if m else None
        if saved:
            win.geometry(saved)
        elif default_geometry:
            win.geometry(default_geometry)
    except Exception:
        try:
            if default_geometry:
                win.geometry(default_geometry)
        except Exception:
            pass

    def _store_geometry(event=None):
        try:
            if event is not None and getattr(event, "widget", None) is not win:
                return
            geom = win.geometry()
            if not geom or geom.startswith("1x1"):
                return
            w = getattr(win, "winfo_width", lambda: 0)()
            h = getattr(win, "winfo_height", lambda: 0)()
            if w < 120 or h < 80:
                return
            # v4.2.25: never RECORD an off-screen position either. Without this the bad
            # geometry is written back the moment the window is nudged while parked at
            # -32000,-32000 (minimized) or dragged off an edge, and the next launch is
            # invisible again. Guarding both ends means one good launch heals the entry.
            if not geometry_is_usable(geom, win=win):
                return
            data = _load_window_geometry_map()
            data[key] = geom
            _save_window_geometry_map(data)
        except Exception:
            pass

    try:
        win.bind("<Configure>", _store_geometry, add="+")
    except Exception:
        pass

    return win


# ---- v4.2.77 (Steve): remember user-dragged column widths on EVERY Treeview ----
# Same idea as remember_window_geometry, but installed ONCE per Tk interpreter via
# bind_class("Treeview", ...) so all ~31 Treeviews in the app get it with no
# per-window wiring. A tree is identified by its column ids + initial heading
# texts (all headings in this app are static text -- audited v4.2.77); two trees
# showing the same columns deliberately share one width entry. Saved widths are
# applied on the widget's first <Map> (columns are always configured in the same
# code block that creates the tree, so they are final by then); a save happens
# only when a <ButtonPress-1> landed on a header SEPARATOR (a deliberate resize
# drag) and its <ButtonRelease-1> arrives -- stretch-driven width changes from
# window resizing are never recorded.

def _tree_columns_key(tree):
    parts = []
    try:
        show = str(tree.cget("show") or "")
    except Exception:
        show = ""
    cols = ["#0"] if "tree" in show else []
    try:
        cols += [str(c) for c in (tree.cget("columns") or ())]
    except Exception:
        pass
    for cid in cols:
        try:
            parts.append("%s=%s" % (cid, tree.heading(cid, "text")))
        except Exception:
            parts.append(str(cid))
    key = re.sub(r"[^A-Za-z0-9_.#|= /-]+", "_", "|".join(parts))
    return key[:240] or "tree"


def _tree_columns_display_cols(tree):
    """Column ids whose widths are worth remembering, #0 included when shown."""
    try:
        show = str(tree.cget("show") or "")
    except Exception:
        show = ""
    cols = ["#0"] if "tree" in show else []
    try:
        cols += [str(c) for c in (tree.cget("columns") or ())]
    except Exception:
        pass
    return cols


def _load_tree_columns_map():
    try:
        if os.path.exists(TREE_COLUMN_WIDTHS_FILE):
            with open(TREE_COLUMN_WIDTHS_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
    except Exception:
        pass
    return {}


def _save_tree_columns_map(data):
    try:
        with open(TREE_COLUMN_WIDTHS_FILE, "w", encoding="utf-8") as f:
            json.dump(data or {}, f, indent=2)
    except Exception:
        pass


def _tree_columns_apply_saved(event):
    tree = getattr(event, "widget", None)
    try:
        if tree is None or getattr(tree, "_colmem_key", None) is not None:
            return  # already applied; notebook tab switches re-<Map> the same widget
        key = _tree_columns_key(tree)
        tree._colmem_key = key
        saved = _load_tree_columns_map().get(key)
        if not isinstance(saved, dict):
            return

        def _apply(tree=tree, saved=saved):
            try:
                for cid, w in saved.items():
                    try:
                        w = int(w)
                        if w < 20 or w > 4000:
                            continue
                        minw = int(tree.column(cid, "minwidth"))
                        tree.column(cid, width=max(w, minw))
                    except Exception:
                        continue
            except Exception:
                pass

        # Deferred past the initial layout: applying DURING <Map> lets the
        # widget's first stretch pass overwrite the restored width of any
        # stretch=True column (harness-caught on the Quote Review #0 column).
        tree.after_idle(_apply)
    except Exception:
        pass


def _tree_columns_on_press(event):
    try:
        tree = event.widget
        if tree.identify_region(event.x, event.y) == "separator":
            tree._colmem_drag = True
    except Exception:
        pass


def _tree_columns_on_release(event):
    tree = getattr(event, "widget", None)
    try:
        if tree is None or not getattr(tree, "_colmem_drag", False):
            return
        tree._colmem_drag = False
        key = getattr(tree, "_colmem_key", None) or _tree_columns_key(tree)
        widths = {}
        for cid in _tree_columns_display_cols(tree):
            try:
                widths[cid] = int(tree.column(cid, "width"))
            except Exception:
                continue
        if not widths:
            return
        data = _load_tree_columns_map()
        data[key] = widths
        _save_tree_columns_map(data)
    except Exception:
        try:
            tree._colmem_drag = False
        except Exception:
            pass


def install_tree_column_memory(root):
    """Install app-wide column-width memory on this Tk interpreter. add='+' keeps
    ttk's own class bindings (which perform the actual drag) running first."""
    try:
        root.bind_class("Treeview", "<Map>", _tree_columns_apply_saved, add="+")
        root.bind_class("Treeview", "<ButtonPress-1>", _tree_columns_on_press, add="+")
        root.bind_class("Treeview", "<ButtonRelease-1>", _tree_columns_on_release, add="+")
