_NORMALIZE_SUBJECT_CACHE = {}
_NORMALIZE_SUBJECT_CACHE_MAX = 8192


def normalize_subject_for_match(subject):
    """Normalize subjects so RE:/FW: and spacing do not prevent related-email matching.

    v3.9.27 efficiency: memoized. This runs three regex passes and is called inside
    the tracker sweep's inner matching loops, dedupe, and grouping -- the same few
    thousand subjects over and over. The cache is bounded and reset wholesale when full.
    """
    key = subject or ""
    cached = _NORMALIZE_SUBJECT_CACHE.get(key)
    if cached is not None:
        return cached
    text = key.strip().lower()
    changed = True
    while changed:
        changed = False
        for prefix in ["re:", "fw:", "fwd:", "external:"]:
            if text.startswith(prefix):
                text = text[len(prefix):].strip()
                changed = True
    text = re.sub(r"\[[^\]]{1,40}\]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    if len(_NORMALIZE_SUBJECT_CACHE) >= _NORMALIZE_SUBJECT_CACHE_MAX:
        _NORMALIZE_SUBJECT_CACHE.clear()
    _NORMALIZE_SUBJECT_CACHE[key] = text
    return text


def contains_any_phrase(text, phrases):
    text = (text or "").lower()
    return any(phrase in text for phrase in phrases)


def matched_phrases(text, phrases, max_items=5):
    text = (text or "").lower()
    return [phrase for phrase in phrases if phrase in text][:max_items]


def sender_looks_automated(sender_text):
    sender_text = (sender_text or "").lower()
    compact = sender_text.replace(" ", "").replace("_", "-")
    return any(hint in compact for hint in AUTOMATED_SENDER_HINTS)


def extract_email_address(value):
    """Best-effort email extraction from Outlook sender strings."""
    value = (value or "").strip()
    if not value:
        return ""
    match = re.search(r"[A-Z0-9._%+\-]+@[A-Z0-9.\-]+\.[A-Z]{2,}", value, flags=re.I)
    return match.group(0).lower() if match else value.lower()


def get_email_domain(value):
    email = extract_email_address(value)
    if "@" not in email:
        return ""
    return email.split("@", 1)[1].lower().strip()


