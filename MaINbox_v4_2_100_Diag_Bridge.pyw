    def email_matches_active_filter(self, email):
        if not self.group_filter_allows_email(email):
            return False
        if self.active_filter == "all":
            return email.get("urgency") != "Low" and email.get("status") != "Completed"
        if self.active_filter == "needs_reply":
            return email.get("status") == "Needs Reply"
        if self.active_filter == "waiting_customer":
            return email.get("status") == "Waiting on Customer"
        if self.active_filter == "waiting_vendor":
            return email.get("status") == "Waiting on Vendor"
        if self.active_filter == "completed":
            return email.get("status") == "Completed"
        if self.active_filter == "urgent":
            return email.get("urgency") in ["High", "Critical"] and email.get("status") != "Completed"
        if self.active_filter == "followups":
            return bool(self.get_active_followup_for_email(email.get("entry_id")))
        if self.active_filter == "low":
            return email.get("urgency") == "Low"
        return email.get("urgency") != "Low"

    def get_cache_key(self):
        return self.selected_sales_category

    # v2.10.13 duplicate guardrails
    def _safe_iso_sort_value(self, value):
        """Sortable timestamp helper for cleanup routines."""
        try:
            if not value:
                return ""
            return datetime.fromisoformat(str(value)).isoformat()
        except Exception:
            return str(value or "")

    def _merge_duplicate_email_rows(self, keeper, duplicate):
        """Merge useful local fields from a duplicate row into the keeper row."""
        try:
            if not isinstance(keeper, dict) or not isinstance(duplicate, dict):
                return keeper
            # Preserve downloaded/cached body text if either copy has it.
            if not keeper.get("body") and duplicate.get("body"):
                keeper["body"] = duplicate.get("body", "")
                keeper["body_loaded"] = bool(keeper.get("body"))
            # Preserve the more user-managed workflow fields from saved status data when present.
            eid = keeper.get("entry_id") or duplicate.get("entry_id")
            saved = self.status_data.get(eid, {}) if eid else {}
            for field in [
                "category", "urgency", "status", "sender_type", "email_type", "sender_intent",
                "reply_intent",
                "business_relevance", "spam_likelihood", "ai_triage_reason", "followup_reason_ai",
                "followup_blocked_reason", "trusted_sender", "learned_rule_source",
                "ai_triaged_at", "ai_triage_pending", "ai_user_locked", "ai_triage_skipped",
                "sent_waiting_tracker_active", "sent_waiting_tracker_sent_timestamp"
            ]:
                if saved.get(field) not in (None, ""):
                    keeper[field] = saved.get(field)
                elif keeper.get(field) in (None, "") and duplicate.get(field) not in (None, ""):
                    keeper[field] = duplicate.get(field)
            keeper["is_new_import"] = bool(keeper.get("is_new_import") or duplicate.get("is_new_import"))
            keeper["followup_time"] = self.get_followup_display_for_email(keeper.get("entry_id", ""))
        except Exception:
            pass
        return keeper

    def _row_saved_state_is_newer(self, candidate, keeper):
        """v4.1.93: True when `candidate`'s SAVED record was updated more recently than
        `keeper`'s. Used only when merging two rows that are provably the same message
        (same Internet Message-ID, same source), so the copy carrying the user's most
        recent workflow state wins instead of whichever happened to be seen first."""
        try:
            sd = getattr(self, "status_data", None)
            if not isinstance(sd, dict):
                return False
            a = str((sd.get(str(candidate.get("entry_id", "") or "")) or {}).get("updated_at", "") or "")
            b = str((sd.get(str(keeper.get("entry_id", "") or "")) or {}).get("updated_at", "") or "")
            return bool(a and a > b)
        except Exception:
            return False

    def dedupe_email_rows(self, reason=""):
        """Remove duplicate rows from the main in-memory email list.

        This is intentionally conservative:
        - exact Outlook EntryID duplicates are merged into one row;
        - exact sent/waiting placeholder IDs are merged into one row;
        - true Sales/My Inbox duplicate deliveries keep the Sales copy and remove the My Inbox copy.
        """
        try:
            original_count = len(getattr(self, "emails", []) or [])
            cleaned = []
            by_id = {}
            by_index = {}          # v4.1.93: key -> index in `cleaned`, so a later row with
            removed_ids = set()    # newer saved state can replace an earlier one in place
            for email in list(getattr(self, "emails", []) or []):
                if not isinstance(email, dict):
                    continue
                entry_id = str(email.get("entry_id", "") or "").strip()
                if entry_id and self.status_data.get(entry_id, {}).get("app_deleted"):
                    continue
                # v4.1.93: prefer the DRIFT-PROOF key. EntryID changes when a message is
                # moved/restored/re-synced under Cached Exchange Mode (CLAUDE.md), so an
                # EntryID-keyed dedupe cannot see that two rows are the same message -- the
                # audit found 38 Message-IDs stored under two entry_ids each. Scoped to the
                # SAME source on purpose: 22 of those 38 are genuine Sales + My Inbox
                # deliveries, which the deliberate cross-mailbox rule below already handles
                # (keep the Sales copy, hide the My Inbox one). Merging them here would
                # bypass that rule, so they keep separate keys and fall through to it. The
                # remaining 16 are the real drift -- same folder, same message, two ids.
                _mid = str(email.get("internet_message_id", "") or "").strip()
                key = (("mid:%s|%s" % (email.get("source", ""), _mid)) if _mid
                       else (entry_id or f"fallback:{email.get('source','')}:{email.get('conversation_id','')}:{normalize_subject_for_match(email.get('subject',''))}:{email.get('received_timestamp',0)}"))
                if key in by_id:
                    keeper = by_id[key]
                    # v4.1.93: when the same message exists twice, keep the copy whose SAVED
                    # STATE is newer. Without this the first row seen wins and the merge
                    # re-applies ITS status, so a stale copy can silently outrank the row the
                    # user actually worked (the audit found one live pair reading both
                    # 'Needs Reply' and 'Waiting on Customer').
                    if _mid and self._row_saved_state_is_newer(email, keeper):
                        _idx = by_index.get(key)
                        self._merge_duplicate_email_rows(email, keeper)
                        if _idx is not None:
                            cleaned[_idx] = email
                        by_id[key] = email
                        _k_eid = str(keeper.get("entry_id", "") or "")
                        if _k_eid:
                            removed_ids.add(_k_eid)
                    else:
                        self._merge_duplicate_email_rows(keeper, email)
                        if entry_id:
                            removed_ids.add(entry_id)
                    continue
                by_id[key] = email
                by_index[key] = len(cleaned)
                cleaned.append(email)

            # Remove the My Inbox copy only when it truly looks like the same delivered item already in Sales.
            # v3.9.27 efficiency: this pass compared every My Inbox row against every other
            # row (quadratic), and it runs inside every save_cached_state(). Bucket the
            # Sales rows by (sender, normalized subject) first so each My Inbox row only
            # checks its handful of plausible twins; the final match predicate is unchanged.
            sales_buckets = {}
            for other in cleaned:
                if other.get("source") != "Sales":
                    continue
                b_sender = (str(other.get("sender_email", "") or other.get("sender", "") or "").strip().lower())
                b_subj = normalize_subject_for_match(other.get("subject", "") or "")
                if b_sender and b_subj:
                    sales_buckets.setdefault((b_sender, b_subj), []).append(other)
            final_rows = []
            for email in cleaned:
                if email.get("source") == "My Inbox":
                    duplicate_sales = None
                    m_sender = (str(email.get("sender_email", "") or email.get("sender", "") or "").strip().lower())
                    m_subj = normalize_subject_for_match(email.get("subject", "") or "")
                    for other in sales_buckets.get((m_sender, m_subj), []):
                        if other is email:
                            continue
                        if self.emails_look_like_same_sales_inbox_duplicate(email, other):
                            duplicate_sales = other
                            break
                    if duplicate_sales:
                        eid = email.get("entry_id", "")
                        if eid:
                            # Preserve the user's local decision that this duplicate should stay hidden.
                            existing = self.status_data.get(eid, {})
                            existing.update({
                                "category": email.get("category", existing.get("category", "General")),
                                "urgency": "Low",
                                "status": email.get("status", existing.get("status", "New")),
                                "app_deleted": bool(existing.get("app_deleted", False)),
                                "sales_inbox_duplicate_hidden": True,
                                "updated_at": datetime.now().isoformat(),
                                "subject": email.get("subject", existing.get("subject", "")),
                                "sender": email.get("sender", existing.get("sender", "")),
                                "source": email.get("source", existing.get("source", "")),
                            })
                            self.status_data[eid] = existing
                        continue
                final_rows.append(email)

            self.emails = final_rows
            for email in self.emails:
                if isinstance(email, dict):
                    email["message"] = None
                    if email.get("entry_id"):
                        email["followup_time"] = self.get_followup_display_for_email(email.get("entry_id", ""))
            # v3 efficiency hardening: dedupe can replace/remove rows, so rebuild
            # the O(1) index before any later get_email_by_id lookup.
            self._rebuild_email_index()
            return max(0, original_count - len(self.emails))
        except Exception:
            return 0

    def dedupe_followup_records(self):
        """Allow only one active manual follow-up and one active scenario reminder per email/type."""
        changed = False
        try:
            def active(item):
                return not item.get("completed") and not item.get("cancelled")

            # Manual followups: one active row per entry_id/conversation/group.
            best = {}
            for item in self.followups:
                if not isinstance(item, dict) or not active(item):
                    continue
                key = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                if not key:
                    continue
                score = self._safe_iso_sort_value(item.get("created_at") or item.get("due_at"))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_active_ids = {id(v[1]) for v in best.values()}
            for item in self.followups:
                if isinstance(item, dict) and active(item):
                    key = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                    if key and id(item) not in keep_active_ids:
                        item["cancelled"] = True
                        item["cancelled_at"] = datetime.now().isoformat()
                        item["cancel_reason"] = "Cancelled by duplicate cleanup; newer active follow-up exists."
                        changed = True

            # Manual follow-ups outrank automatic reminders. If old saved data
            # already has both a manual follow-up and an automatic tracker for
            # the same item, keep the manual follow-up and cancel the automatic
            # tracker so the queue does not show duplicates.
            manual_keys = set()
            for item in self.followups:
                if not isinstance(item, dict) or not active(item):
                    continue
                for val in (item.get("entry_id"), item.get("conversation_id"), item.get("group_id"), item.get("subject")):
                    if val:
                        manual_keys.add(str(val).strip().lower())
            for item in self.scenario_reminders:
                if not isinstance(item, dict) or not active(item):
                    continue
                item_keys = {str(v).strip().lower() for v in (item.get("entry_id"), item.get("conversation_id"), item.get("group_id"), item.get("subject")) if v}
                if manual_keys.intersection(item_keys):
                    item["cancelled"] = True
                    item["cancelled_at"] = datetime.now().isoformat()
                    item["cancel_reason"] = "Cancelled by duplicate cleanup; active manual follow-up exists for this item."
                    changed = True
            for item in self.pending_reply_checks:
                if not isinstance(item, dict) or not active(item):
                    continue
                item_keys = {str(v).strip().lower() for v in (item.get("entry_id"), item.get("conversation_id"), item.get("group_id"), item.get("subject")) if v}
                if manual_keys.intersection(item_keys):
                    item["cancelled"] = True
                    item["cancelled_at"] = datetime.now().isoformat()
                    item["cancel_reason"] = "Cancelled by duplicate cleanup; active manual follow-up exists for this item."
                    changed = True

            # Scenario reminders: one active automatic reminder per email/thread total.
            # The old cleanup allowed one of each type, which could still show AI +
            # vendor/customer reminders for the same item. Keep the newest active
            # automatic tracker and cancel the rest.
            best = {}
            for item in self.scenario_reminders:
                if not isinstance(item, dict) or not active(item):
                    continue
                key = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                if not key:
                    continue
                score = self._safe_iso_sort_value(item.get("created_at") or item.get("due_at"))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_active_ids = {id(v[1]) for v in best.values()}
            for item in self.scenario_reminders:
                if isinstance(item, dict) and active(item):
                    key = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                    if key and id(item) not in keep_active_ids:
                        item["cancelled"] = True
                        item["cancelled_at"] = datetime.now().isoformat()
                        item["cancel_reason"] = "Cancelled by duplicate cleanup; newer active automatic reminder exists for this item."
                        changed = True

            # Commitment reminders (v3.8.10): a thread may legitimately have several
            # (e.g. a ship date AND a quote-expiration), so we only collapse exact
            # duplicates keyed by thread + type + target date. Distinct dates/types
            # are all kept, and these never fight the scenario/manual reminders above.
            best = {}
            for item in getattr(self, "commitment_reminders", []):
                if not isinstance(item, dict) or not active(item):
                    continue
                tkey = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                if not tkey:
                    continue
                key = (str(tkey).strip().lower(), item.get("type", ""), item.get("target_date", ""))
                score = self._safe_iso_sort_value(item.get("created_at") or item.get("due_at"))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_active_ids = {id(v[1]) for v in best.values()}
            for item in getattr(self, "commitment_reminders", []):
                if isinstance(item, dict) and active(item):
                    tkey = item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject")
                    key = (str(tkey).strip().lower(), item.get("type", ""), item.get("target_date", "")) if tkey else None
                    if key and id(item) not in keep_active_ids:
                        item["cancelled"] = True
                        item["cancelled_at"] = datetime.now().isoformat()
                        item["cancel_reason"] = "Cancelled by duplicate cleanup; newer identical commitment reminder exists."
                        changed = True

            # Pending reply checks: one active row per entry_id/conversation.
            best = {}
            for item in self.pending_reply_checks:
                if not isinstance(item, dict) or not active(item):
                    continue
                key = item.get("entry_id") or item.get("conversation_id") or item.get("subject")
                if not key:
                    continue
                score = self._safe_iso_sort_value(item.get("created_at"))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_active_ids = {id(v[1]) for v in best.values()}
            for item in self.pending_reply_checks:
                if isinstance(item, dict) and active(item):
                    key = item.get("entry_id") or item.get("conversation_id") or item.get("subject")
                    if key and id(item) not in keep_active_ids:
                        item["cancelled"] = True
                        item["cancelled_at"] = datetime.now().isoformat()
                        item["cancel_reason"] = "Cancelled by duplicate cleanup; newer pending reply check exists."
                        changed = True
        except Exception:
            pass
        # v3 efficiency: clear the dirty flag — saves immediately after this
        # call don't need to run dedup again.
        self._followup_dedup_needed = False
        return changed

    def dedupe_sent_waiting_placeholders(self):
        """Keep one active sent/waiting placeholder per conversation (else per id)."""
        try:
            best = {}
            changed = False
            for item in getattr(self, "sent_waiting_placeholders", []) or []:
                if not isinstance(item, dict) or item.get("cleared"):
                    continue
                entry_id = str(item.get("entry_id", "") or "").strip()
                conversation_id = str(item.get("conversation_id", "") or "").strip()
                sent_entry_id = str(item.get("sent_entry_id", "") or "").strip()
                # v3.9.27: conversation id FIRST. The old key used entry_id first, and a
                # placeholder's entry_id is always populated, so the conversation branch
                # was dead code -- two placeholders for the SAME thread (one keyed
                # "sentwait:{conv}", one "sentwait:{sent_entry_id}" from a scan where the
                # ConversationID read failed) both survived as duplicates.
                key = (("conv:" + conversation_id) if conversation_id else "") or entry_id or sent_entry_id
                if not key:
                    continue
                score = self._safe_iso_sort_value(item.get("created_at")) or str(item.get("received_timestamp", ""))
                if key not in best or score >= best[key][0]:
                    best[key] = (score, item)
            keep_ids = {id(v[1]) for v in best.values()}
            for item in getattr(self, "sent_waiting_placeholders", []) or []:
                if isinstance(item, dict) and not item.get("cleared") and id(item) not in keep_ids:
                    item["cleared"] = True
                    item["cleared_at"] = datetime.now().isoformat()
                    item["cleared_reason"] = "duplicate_placeholder_cleanup"
                    changed = True
            return changed
        except Exception:
            return False

    def cleanup_duplicates(self, reason="", save=False):
        """Run all duplicate cleanup passes used after load/import/save."""
        removed = self.dedupe_email_rows(reason=reason)
        # v3 efficiency: only run the (relatively heavy) follow-up/reminder dedupe when
        # something has actually added or replaced those records. The dirty flag is set
        # by every incremental add site AND by every wholesale reload/restore of the
        # follow-up lists (see _followup_dedup_needed = True after each load/undo/reload),
        # so a False flag here genuinely means "already clean and nothing new". This keeps
        # cloud-restore/undo safe — those paths mark the flag dirty so their data is still
        # deduped — while routine save_cached_state calls no longer redo the work.
        if getattr(self, "_followup_dedup_needed", True):
            followup_changed = self.dedupe_followup_records()
        else:
            followup_changed = False
        placeholder_changed = self.dedupe_sent_waiting_placeholders()
        if placeholder_changed:
            self.sync_sent_waiting_placeholders_into_email_list()
        if save:
            if removed:
                self.flush_status_data()
            if followup_changed:
                self.save_followups()
                self.save_scenario_reminders()
                self.save_commitment_reminders()
                self.save_pending_reply_checks()
            if placeholder_changed:
                self.save_sent_waiting_placeholders()
        return removed or followup_changed or placeholder_changed

    def load_cached_state(self):
        cached = self.cache_data.get(self.get_cache_key(), {})
        try:
            # v3.8.30: prefer the durable DB copy of the scanner "already processed" id
            # sets and union it with whatever is in the cache, so a cloud restore (which
            # restores the DB but not the local cache file) does not make the scanner
            # reprocess old mail and resurrect cancelled reminders. Falls back cleanly to
            # cache-only values for installs from before this was mirrored to the DB.
            _ck = str(self.get_cache_key())
            _cache_commit = cached.get("commitment_processed_message_ids", []) or []
            _cache_sent = cached.get("sent_waiting_processed_sent_ids", []) or []
            _db_commit = load_json_from_db("scanner_commitment_processed_message_ids::" + _ck, None)
            _db_sent = load_json_from_db("scanner_sent_waiting_processed_sent_ids::" + _ck, None)
            if not isinstance(_db_commit, list):
                _db_commit = []
            if not isinstance(_db_sent, list):
                _db_sent = []
            # dict.fromkeys preserves order while de-duplicating across the two sources.
            self.commitment_processed_message_ids = list(dict.fromkeys(_db_commit + list(_cache_commit)))
            self.sent_waiting_processed_sent_ids = list(dict.fromkeys(_db_sent + list(_cache_sent)))
        except Exception:
            pass
        self.emails = []
        for e in cached.get("emails", []):
            if not isinstance(e, dict):
                continue
            saved = self.find_saved_status_for_email_fields(
                entry_id=e.get("entry_id", ""), conversation_id=e.get("conversation_id", ""),
                conversation_index=e.get("conversation_index", ""), sender_email=e.get("sender_email", ""),
                sender=e.get("sender", ""), subject=e.get("subject", ""),
                received_timestamp=e.get("received_timestamp", 0), source=e.get("source", ""),
                internet_message_id=e.get("internet_message_id", ""),
            )
            if saved.get("app_deleted"):
                continue
            if saved:
                self.apply_saved_workflow_to_email(e, saved)
                eid = e.get("entry_id", "")
                if eid:
                    healed = dict(self.status_data.get(eid, {}) or {})
                    healed.update(saved)
                    healed["entry_id"] = eid
                    self.status_data[eid] = healed
            self.emails.append(e)
        self.cleanup_duplicates(reason="load_cached_state", save=True)
        for email in self.emails:
            self.apply_saved_workflow_to_email(email)
            email["message"] = None

            cached_body = email.get("body", "") or ""
            email["body"] = cached_body
            email["body_loaded"] = bool(cached_body)

            email["is_new_import"] = False
            email["followup_time"] = self.get_followup_display_for_email(email["entry_id"])
        self.sync_sent_waiting_placeholders_into_email_list()
        self._rebuild_email_index()  # v3 efficiency: build O(1) lookup index.
        self.sort_emails_for_display()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        cached_at = cached.get("cached_at", "never")
        self.preview_text.insert(
            tk.END,
            f"Opened from saved cache.\nCached at: {cached_at}\n\n"
            "MaINbox v3 AutoPilot Mode active.\n"
            "Email bodies are cached after first load.\n"
            f"Data folder: {APP_DATA_DIR}\n"
            "AI Reply and AI Scan use the background AI engine so the UI stays responsive.\n"
            "Default Ollama model: llama3.2:3b. Override with MAINBOX_OLLAMA_MODEL if needed. MaINbox v3 includes same-subject project protection so uniform job/RFQ subjects are not auto-buried as Low/Junk."
        )

    def save_cached_state(self):
        self.cleanup_duplicates(reason="save_cached_state", save=False)
        safe_emails = []
        for email in self.emails:
            safe = dict(email)
            safe.pop("message", None)

            # Keep downloaded bodies in the local cache so they only need to be pulled from Outlook once.
            cached_body = safe.get("body", "") or ""
            safe["body_loaded"] = bool(cached_body)
            safe["body"] = cached_body

            safe["is_new_import"] = False
            safe_emails.append(safe)
        self.cache_data[self.get_cache_key()] = {
            "cached_at": datetime.now().strftime("%Y-%m-%d %I:%M %p"),
            "emails": safe_emails,
            "sent_waiting_processed_sent_ids": getattr(self, "sent_waiting_processed_sent_ids", []),
            "commitment_processed_message_ids": getattr(self, "commitment_processed_message_ids", []),
        }
        # v4.1.58: this is the app's biggest write -- a full dump of every email row
        # INCLUDING cached bodies (tens of MB), fsync'd + atomically replaced, plus two
        # SQLite mirror commits -- and it ran synchronously on the Tk main thread after
        # every AutoPilot apply / refresh / bulk edit / delete: the recurring freeze.
        # Serialized here (consistent snapshot); disk + the v3.8.30 scanner-id DB
        # mirrors happen on the background persistence writer, last-write-wins.
        _ck = str(self.get_cache_key())
        save_json_async(
            CACHE_FILE, self.cache_data,
            extra_db=[
                ("scanner_commitment_processed_message_ids::" + _ck,
                 getattr(self, "commitment_processed_message_ids", [])),
                ("scanner_sent_waiting_processed_sent_ids::" + _ck,
                 getattr(self, "sent_waiting_processed_sent_ids", [])),
            ])

    def save_followups(self):
        # v3 efficiency: only run dedupe when the collections are actually dirty.
        # _followup_dedup_needed is set True by any code that adds/cancels followups.
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
            self._followup_dedup_needed = False
        save_json(FOLLOWUP_FILE, self.followups)

    def save_scenario_reminders(self):
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
            self._followup_dedup_needed = False
        save_json(SCENARIO_REMINDERS_FILE, self.scenario_reminders)

    def save_commitment_reminders(self):
        # v3.8.10 dedicated lane for promised-date follow-ups (own JSON file).
        # v3.8.23 efficiency: when a batch is open (bulk sweep/import), defer the
        # expensive atomic write + dedup to a single flush at the end of the batch.
        if getattr(self, "_commitment_batch", 0):
            self._commitment_batch_dirty = True
            return
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
            self._followup_dedup_needed = False
        save_json(COMMITMENT_REMINDERS_FILE, getattr(self, "commitment_reminders", []))

    def _begin_commitment_batch(self):
        """Open a batch so per-item save_commitment_reminders()/save_cached_state()
        calls coalesce into ONE write at flush time. Safe to nest."""
        self._commitment_batch = getattr(self, "_commitment_batch", 0) + 1

    def _flush_commitment_batch(self, touched_cache=False):
        """Close a batch and perform the single deferred write(s) if anything changed."""
        depth = getattr(self, "_commitment_batch", 0)
        if depth > 1:
            self._commitment_batch = depth - 1
            return
        self._commitment_batch = 0
        wrote_reminders = bool(getattr(self, "_commitment_batch_dirty", False))
        wrote_cache = bool(getattr(self, "_commitment_batch_cache_dirty", False)) or touched_cache
        wrote_status = bool(getattr(self, "_commitment_batch_status_dirty", False))
        self._commitment_batch_dirty = False
        self._commitment_batch_cache_dirty = False
        self._commitment_batch_status_dirty = False
        if wrote_status:
            try:
                self.flush_status_data()
            except Exception:
                pass
        if wrote_reminders:
            self.save_commitment_reminders()   # batch now closed -> real write (1x dedup)
        if wrote_cache:
            try:
                self.save_cached_state()
            except Exception:
                pass

    def save_pending_reply_checks(self):
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
            self._followup_dedup_needed = False
        save_json(PENDING_REPLY_CHECKS_FILE, self.pending_reply_checks)

    def save_sent_waiting_placeholders(self):
        # v3.8.24 efficiency: defer the write while a placeholder batch is open
        # (bulk sent-reply detection), collapsing many per-item writes into one.
        if getattr(self, "_placeholder_batch", 0):
            self._placeholder_batch_dirty = True
            return
        self.dedupe_sent_waiting_placeholders()
        save_json(SENT_WAITING_PLACEHOLDERS_FILE, self.sent_waiting_placeholders)

    def _begin_placeholder_batch(self):
        """Open a batch so per-item save_sent_waiting_placeholders()/sync calls
        coalesce into one write + one resync at flush time. Safe to nest."""
        self._placeholder_batch = getattr(self, "_placeholder_batch", 0) + 1

    def _flush_placeholder_batch(self):
        depth = getattr(self, "_placeholder_batch", 0)
        if depth > 1:
            self._placeholder_batch = depth - 1
            return
        self._placeholder_batch = 0
        wrote = bool(getattr(self, "_placeholder_batch_dirty", False))
        synced = bool(getattr(self, "_placeholder_batch_sync_dirty", False))
        self._placeholder_batch_dirty = False
        self._placeholder_batch_sync_dirty = False
        if synced:
            try:
                self.sync_sent_waiting_placeholders_into_email_list()
            except Exception:
                pass
        if wrote:
            self.save_sent_waiting_placeholders()

    def _auto_group_engine_active(self):
        return bool(AUTO_GROUP_ENGINE_AVAILABLE and self.settings.get("auto_group_engine_enabled", True))

    def _get_auto_group_engine(self):
        """Return one cached plug-in instance; update thresholds on every call."""
        if not self._auto_group_engine_active():
            return None
        try:
            engine = getattr(self, "_auto_group_engine_instance", None)
            if engine is None:
                engine = AutoGroupEngine(self.settings, AUTO_GROUP_ENGINE_STATE_FILE)
                self._auto_group_engine_instance = engine
            else:
                engine.update_settings(self.settings)
            return engine
        except Exception:
            return None

    def auto_assign_plugin_group(self, email):
        """v4.1.35: THREAD-AGNOSTIC enqueue. Any thread (the Tk thread, the AI-triage
        worker, AutoPilot) may call this; it only places the email on a plain request
        queue and returns "" immediately. ALL Tk-adjacent work -- snapshotting live
        collections, pending bookkeeping, worker startup, decision application --
        happens in the main-thread poll (_age_poll), so no background thread ever
        touches root.after()/Tk or iterates a live structure the UI is mutating."""
        if not email or not self._auto_group_engine_active():
            return ""
        eid = str(email.get("entry_id", "") or "")
        if not eid or self.get_group_id_for_email(eid):
            return ""
        try:
            # dict.setdefault is atomic under the GIL: racing threads share ONE queue.
            q = self.__dict__.setdefault("_age_request_queue", queue.Queue())
            q.put(email)
        except Exception:
            pass
        return ""

    def _check_plugin_health(self):
        """v4.1.35 (F4): plug-in presence/version health, surfaced loudly ONCE at
        startup when an ENABLED engine is unavailable, and always stamped into the
        status bar. Sourced from the import-time capture that nothing displayed."""
        problems = []
        lines = []
        if AUTO_GROUP_ENGINE_AVAILABLE:
            lines.append(f"Auto-Group Engine: Loaded v{AUTO_GROUP_ENGINE_VERSION}")
        else:
