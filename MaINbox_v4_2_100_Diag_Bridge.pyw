                left.pack(side="left", fill="both", expand=True, padx=(0, 6))
                intel_txt = tk.Text(left, wrap="word", height=18, bg=_ENTRY_BG, fg=_FG, insertbackground=_FG)
                intel_txt.pack(fill="both", expand=True, padx=6, pady=6)

                right = tk.LabelFrame(body, text="Substitute / equivalent suggestions", bg=_BG, fg=_FG, font=(_FONT, 10, "bold"))
                right.pack(side="right", fill="both", expand=True, padx=(6, 0))
                subs_tree = ttk.Treeview(right, columns=("desc", "mfg", "part", "conf", "reason"), show="headings", selectmode="browse", height=10)
                for c, l, w in [("desc", "Substitute", 230), ("mfg", "Mfg", 120), ("part", "Part #", 110), ("conf", "Conf", 55), ("reason", "Why", 230)]:
                    subs_tree.heading(c, text=l)
                    subs_tree.column(c, width=w, anchor=("center" if c == "conf" else "w"))
                subs_tree.pack(fill="both", expand=True, padx=6, pady=(6, 2))
                subs_state = {"rows": []}
                sub_status = tk.StringVar(value="")
                tk.Label(right, textvariable=sub_status, bg=_BG, fg=_FG_DIM, anchor="w", wraplength=420, justify="left").pack(fill="x", padx=6, pady=(0, 4))

                def current_item():
                    try:
                        i = options.index(sel_var.get())
                    except Exception:
                        i = 0
                    return items[i], sel_idx[i]

                def load_intel(*_):
                    m, _idx = current_item()
                    intel = build_material_sourcing_intel(m, self.procurement_memory)
                    try:
                        live = lookup_external_stock(m, self.settings)
                    except Exception:
                        live = []
                    text = summarize_sourcing_intel_text(intel, m)
                    if live:
                        text += "\n\nLIVE STOCK (external provider):\n"
                        for r in live[:15]:
                            price = ("$" + str(r.get("unit_price"))) if r.get("unit_price") not in (None, "") else ""
                            text += f"  - {r.get('vendor','')}: qty {r.get('qty_available','')}  {price}  {r.get('lead_time','')}  {r.get('location','')}\n"
                    intel_txt.config(state="normal")
                    intel_txt.delete("1.0", tk.END)
                    intel_txt.insert("1.0", text)
                    intel_txt.config(state="disabled")
                    subs_tree.delete(*subs_tree.get_children())
                    subs_state["rows"] = []
                    sub_status.set("")

                item_menu.bind("<<ComboboxSelected>>", load_intel)

                def fill_subs(rows):
                    subs_tree.delete(*subs_tree.get_children())
                    subs_state["rows"] = rows
                    for n, s in enumerate(rows):
                        subs_tree.insert("", "end", iid=str(n), values=(
                            s.get("description", ""), s.get("manufacturer", ""), s.get("part_number", ""),
                            f"{s.get('confidence', 0):.2f}", s.get("reason", "")))
                    sub_status.set(f"{len(rows)} suggestion(s). Review carefully - these are AI equivalence ideas, not confirmed stock.")

                def suggest_subs():
                    if not bool(self.settings.get("stock_subs_ai_substitutes", True)):
                        messagebox.showinfo("Substitutes", "AI substitute suggestions are turned off in settings.", parent=pop)
                        return
                    m, _idx = current_item()
                    sub_status.set("Asking the local model for equivalents...")
                    subs_tree.delete(*subs_tree.get_children())
                    try:
                        maxn = int(self.settings.get("stock_subs_max_substitutes", 4) or 4)
                    except Exception:
                        maxn = 4

                    def _subs_worker():
                        rows = ask_ollama_suggest_substitutes(m, max_items=maxn)

                        def _subs_done():
                            if not pop.winfo_exists():
                                return
                            if rows:
                                fill_subs(rows)
                            else:
                                sub_status.set("No suggestions returned (model unavailable, disabled, or nothing confident).")
                        try:
                            pop.after(0, _subs_done)
                        except Exception:
                            pass
                    threading.Thread(target=_subs_worker, daemon=True).start()

                def use_as_sub():
                    sel = subs_tree.selection()
                    if not sel:
                        messagebox.showinfo("Use Substitute", "Select a suggested substitute first.", parent=pop)
                        return
                    n = int(sel[0]) if str(sel[0]).isdigit() else -1
                    if not (0 <= n < len(subs_state["rows"])):
                        return
                    s = subs_state["rows"][n]
                    m, idx = current_item()
                    before_desc = m.get("description", "")
                    before_part = m.get("part_number", "")
                    if not messagebox.askyesno(
                        "Use Substitute",
                        f"Replace this line with:\n\n{s.get('description','')}\nMfg: {s.get('manufacturer','')}   Part: {s.get('part_number','')}\n\nThe original is kept in Notes.",
                        parent=pop):
                        return
                    new_desc = s.get("description", "") or before_desc
                    note_add = f"SUBSTITUTE for: {before_desc}".strip()
                    if before_part:
                        note_add += f" (orig part {before_part})"
                    m["description"] = new_desc
                    if s.get("part_number"):
                        m["part_number"] = s.get("part_number", "")
                    if s.get("manufacturer"):
                        m["manufacturer"] = s.get("manufacturer", "")
                    existing_notes = str(m.get("notes", "") or "").strip()
                    m["notes"] = (existing_notes + (" | " if existing_notes else "") + note_add)[:300]
                    try:
                        record_rfq_extraction_correction(idx, "description", before_desc, new_desc, action="substitute")
                    except Exception:
                        pass
                    redraw_materials()
                    try:
                        save_current_rfq_cache()
                    except Exception:
                        pass
                    messagebox.showinfo("Substitute Applied", "Line item updated. Review the grid and Notes.", parent=pop)
                    load_intel()

                def add_sourcing_note():
                    m, idx = current_item()
                    intel = build_material_sourcing_intel(m, self.procurement_memory)
                    bits = []
                    cheapest = intel.get("cheapest")
                    if cheapest and cheapest.get("last_unit_price") is not None:
                        bits.append(f"cheapest ${cheapest['last_unit_price']:.2f} ({cheapest.get('name') or cheapest.get('email')})")
                    mr = intel.get("most_recent")
                    if mr:
                        bits.append(f"last used {mr.get('name') or mr.get('email')}")
                    if intel.get("lead_time_hints"):
                        bits.append(intel["lead_time_hints"][0])
                    if not bits:
                        messagebox.showinfo("Add Note", "No sourcing history to copy for this item.", parent=pop)
                        return
                    note = "Sourcing: " + "; ".join(bits)
                    existing = str(m.get("notes", "") or "").strip()
                    m["notes"] = (existing + (" | " if existing else "") + note)[:300]
                    redraw_materials()
                    try:
                        save_current_rfq_cache()
                    except Exception:
                        pass
                    messagebox.showinfo("Copied", "Sourcing note added to the line item's Notes.", parent=pop)

                def _preferred_vendor_index(m):
                    """({email_lower: {'email','name'}}, {name_lower}) for vendors marked
                    PREFERRED for this item. Backs the 'Preferred vendors only' filter."""
                    try:
                        intel = build_material_sourcing_intel(m, self.procurement_memory)
                    except Exception:
                        intel = {}
                    by_email, names = {}, set()
                    for v in (intel.get("vendors") or []):
                        if not v.get("preferred"):
                            continue
                        em = str(v.get("email", "") or "").strip()
                        nm = str(v.get("name", "") or "").strip()
                        if em:
                            by_email[em.lower()] = {"email": em, "name": nm or em}
                        if nm:
                            names.add(nm.lower())
                    return by_email, names

                def find_vendors():
                    # v3.8.28 fix: the old version only ADDED brand-new vendors (unselected)
                    # and reported a bare count, so a strong match already in the recipient
                    # list (e.g. a preferred vendor you've awarded) produced no visible result.
                    # Now we SELECT every match - new or already-present - name them in the
                    # summary, honor 'Preferred vendors only', and keep the vendor's stored
                    # email case + proper name (the ranking engine lowercases emails).
                    m, idx = current_item()
                    pref_only = bool(pref_only_var.get())
                    pref_by_email, _pref_names = _preferred_vendor_index(m)
                    try:
                        intel = build_material_sourcing_intel(m, self.procurement_memory)
                    except Exception:
                        intel = {"vendors": []}
                    intel_by_email = {str(v.get("email", "") or "").lower(): v
                                      for v in (intel.get("vendors") or []) if v.get("email")}
                    try:
                        ranked = self.procurement_suggest_vendors_for_materials([m], limit=10)
                    except Exception:
                        ranked = []
                    if not ranked:
                        messagebox.showinfo("Find Vendors", "No vendor history matches this item yet.", parent=pop)
                        return
                    candidates, skipped_non_pref = [], 0
                    for r in ranked:
                        em_l = str(r.get("email", "") or "").lower().strip()
                        if not em_l:
                            continue
                        iv = intel_by_email.get(em_l, {})
                        is_pref = (em_l in pref_by_email) or bool(iv.get("preferred"))
                        if pref_only and not is_pref:
                            skipped_non_pref += 1
                            continue
                        disp_email = iv.get("email") or r.get("email", "")   # keep stored case
                        disp_name = iv.get("name") or r.get("name", "") or disp_email
                        candidates.append({"email": disp_email, "name": disp_name,
                                           "preferred": is_pref, "reason": r.get("reason", "") or "history"})
                    if not candidates:
                        if pref_only and skipped_non_pref:
                            messagebox.showinfo("Find Vendors",
                                f"Found {skipped_non_pref} vendor(s) for this item, but none are marked PREFERRED.\n"
                                "Untick 'Preferred vendors only' to add them.", parent=pop)
                        else:
                            messagebox.showinfo("Find Vendors", "No vendor history matches this item yet.", parent=pop)
                        return
                    existing_by_email = {str(v.get("email", "") or "").lower().strip(): v for v in vend_items}
                    added_names, selected_names = [], []
                    for c in candidates:
                        em_l = c["email"].lower().strip()
                        vi = existing_by_email.get(em_l)
                        tag = "Stock&Subs" + (" / PREFERRED" if c["preferred"] else "")
                        if vi is None:
                            new_vi = {"selected": True, "name": c["name"], "email": c["email"],
                                      "reason": tag + ": " + c["reason"]}
                            vend_items.append(new_vi)
                            existing_by_email[em_l] = new_vi
                            added_names.append(c["name"])
                        else:
                            vi["selected"] = True   # surface the match instead of skipping it silently
                            selected_names.append(c["name"])
                    try:
                        redraw_vendors()
                    except Exception:
                        pass
                    lines = []
                    if added_names:
                        lines.append(f"Added & selected {len(added_names)}: " + ", ".join(added_names))
                    if selected_names:
                        lines.append(f"Already in list, now selected {len(selected_names)}: " + ", ".join(selected_names))
                    if pref_only and skipped_non_pref:
                        lines.append(f"Skipped {skipped_non_pref} non-preferred (filter on).")
                    messagebox.showinfo("Find Vendors", "\n".join(lines) if lines else "No matching vendors to add.", parent=pop)

                def run_mail_search():
                    m, _idx = current_item()
                    folders = []
                    if search_inbox_var.get(): folders.append("my_inbox")
                    if search_sales_var.get(): folders.append("sales")
                    if search_sent_var.get(): folders.append("sent")
                    if not folders:
                        messagebox.showinfo("Search Mail", "Choose at least one folder to search (My Inbox, Sales, or Sent).", parent=pop)
                        return
                    try:
                        days = int(search_days_var.get())
                    except Exception:
                        days = 180
                    kw = search_kw_var.get()
                    scan_atts = bool(search_atts_var.get())
                    sig_only = bool(search_signal_var.get())
                    pref_only = bool(pref_only_var.get())
                    pref_by_email, pref_names = _preferred_vendor_index(m)
                    results_tree.delete(*results_tree.get_children())
                    search_state["rows"] = []
                    search_status.set("Searching your mail... this can take a moment.")

                    def _progress(text):
                        try:
                            pop.after(0, lambda: search_status.set(text))
                        except Exception:
                            pass

                    def _search_worker():
                        diag = {}
                        rows = self.search_mailboxes_for_stock_info(
                            m, days_back=days, extra_keywords=kw, folders=folders,
                            match_mode="any", require_stock_signal=sig_only,
                            scan_attachments=scan_atts, progress=_progress, diag=diag)

                        def _search_done():
                            if not pop.winfo_exists():
                                return
                            # v3.8.28: 'Preferred vendors only' hides results whose sender
                            # is not a preferred vendor for this item (sender is the SMTP
                            # address, falling back to display name).
                            shown, filtered_out = rows, 0
                            if pref_only:
                                kept = []
                                for r in rows:
                                    snd = str(r.get("sender", "") or "").lower()
                                    if snd and (any(em in snd for em in pref_by_email)
                                                or any(nm and nm in snd for nm in pref_names)):
                                        kept.append(r)
                                filtered_out = len(rows) - len(kept)
                                shown = kept
                            search_state["rows"] = shown
                            search_state["diag"] = diag
                            results_tree.delete(*results_tree.get_children())
                            for n, r in enumerate(shown):
                                results_tree.insert("", "end", iid=str(n), values=(
                                    r.get("received", ""), r.get("folder", ""), r.get("sender", ""),
                                    r.get("subject", ""), r.get("snippet", "")))
                            if shown:
                                extra = f" ({filtered_out} non-preferred hidden)" if (pref_only and filtered_out) else ""
                                search_status.set(f"Found {len(shown)} message(s){extra}. Select one and use the buttons below.")
                            elif pref_only and rows:
                                if pref_by_email or pref_names:
                                    search_status.set(f"{len(rows)} message(s) found, but none from PREFERRED vendors for this item. Untick 'Preferred vendors only' to see them.")
                                else:
                                    search_status.set("Preferred vendors only is on, but this item has no PREFERRED vendors on record yet. Untick it to see all results.")
                            else:
                                opened = ", ".join(diag.get("folders_opened", [])) or "none"
                                missing = diag.get("folders_missing", [])
                                scanned = diag.get("scanned", {})
                                scan_str = ", ".join(f"{k}:{v}" for k, v in scanned.items()) or "0"
                                term_hits = diag.get("term_hits", 0)
                                bits = [f"No results. Opened: {opened}. Scanned {scan_str}."]
                                if missing:
                                    bits.append("Could NOT open: " + ", ".join(missing) + ".")
                                if term_hits and sig_only:
                                    bits.append(f"{term_hits} had the term but were filtered by 'Only stock/price/sub' - untick it.")
                                elif term_hits:
                                    bits.append(f"{term_hits} contained the term (snippet/extract issue).")
                                else:
                                    bits.append("Term not found in scanned mail; try more days back or different keywords.")
                                if diag.get("errors"):
                                    bits.append("Note: " + "; ".join(str(e) for e in diag["errors"][:2]))
                                search_status.set(" ".join(bits))
                        try:
                            pop.after(0, _search_done)
                        except Exception:
                            pass
                    threading.Thread(target=_search_worker, daemon=True).start()

                def _selected_search_row():
                    sel = results_tree.selection()
                    if not sel:
                        return None
                    n = int(sel[0]) if str(sel[0]).isdigit() else -1
                    if 0 <= n < len(search_state["rows"]):
                        return search_state["rows"][n]
                    return None

                def add_search_result_to_notes():
                    r = _selected_search_row()
                    if not r:
                        messagebox.showinfo("Add to Notes", "Select a search result first.", parent=pop)
                        return
                    m, _idx = current_item()
                    note = f"Found ({r.get('received','')[:10]} {r.get('folder','')}, {r.get('sender','')}): {r.get('snippet','')}".strip()
                    existing = str(m.get("notes", "") or "").strip()
                    m["notes"] = (existing + (" | " if existing else "") + note)[:300]
                    redraw_materials()
                    try:
                        save_current_rfq_cache()
                    except Exception:
                        pass
                    messagebox.showinfo("Added", "Search detail added to the line item's Notes.", parent=pop)

                def open_search_result_in_outlook():
                    r = _selected_search_row()
                    if not r or not r.get("entry_id"):
                        messagebox.showinfo("Open in Outlook", "Select a search result first.", parent=pop)
                        return
                    try:
                        if not self.ensure_outlook_namespace():
                            return
                        msg = self.namespace.GetItemFromID(r["entry_id"])
                        self.display_outlook_item_foreground(msg)
                    except Exception as exc:
                        messagebox.showerror("Open in Outlook", f"Could not open this message:\n{exc}", parent=pop)

                btns = tk.Frame(pop, bg=_BG)
                btns.pack(fill="x", padx=12, pady=(4, 12))
                tk.Button(btns, text="Suggest Substitutes (AI)", command=suggest_subs, width=22).pack(side="left", padx=3)
                tk.Button(btns, text="Use as Substitute", command=use_as_sub, width=16).pack(side="left", padx=3)
                tk.Button(btns, text="Add Sourcing Note to Item", command=add_sourcing_note, width=24).pack(side="left", padx=3)
                tk.Button(btns, text="Find Vendors for Item", command=find_vendors, width=20).pack(side="left", padx=3)
                tk.Button(btns, text="Add Search Result to Notes", command=add_search_result_to_notes, width=24).pack(side="left", padx=3)
                tk.Button(btns, text="Open Result in Outlook", command=open_search_result_in_outlook, width=20).pack(side="left", padx=3)
                tk.Button(btns, text="Close", command=pop.destroy, width=10).pack(side="right", padx=3)

                load_intel()
                try:
                    pop.focus_force()
                    pop.lift()
                except Exception:
                    pass
            except Exception as exc:
                try:
                    messagebox.showerror("Stock & Subs", f"Could not open Stock & Substitutes:\n{exc}", parent=win)
                except Exception:
                    pass

        def show_price_history():
            mats = selected_materials(False)
            if not mats and mat_tree.selection():
                mats = [mat_items[int(i)] for i in mat_tree.selection() if str(i).isdigit() and int(i) < len(mat_items)]
            if not mats:
                messagebox.showinfo("Price History", "Select one or more material rows first.", parent=win)
                return
            keys = {canonical_material_key(m) for m in mats if canonical_material_key(m)}
            rows = []
            for rec in (self.procurement_memory or {}).get("price_history", []):
                if rec.get("material_key") in keys:
                    rows.append(rec)
            pop = tk.Toplevel(win)
            pop.title("MaINbox Price / Award History")
            remember_window_geometry(pop, "MaINbox Price Award History", "980x520")
            txt = tk.Text(pop, wrap="word", font=("Segoe UI", 10))
            txt.pack(fill="both", expand=True, padx=10, pady=10)
            if not rows:
                txt.insert("1.0", "No price history has been recorded for the selected material yet.\n\nUse Award Selected after choosing the winning vendor to start building history.")
            else:
                lines = []
                for r in sorted(rows, key=lambda x: x.get("created_at", ""), reverse=True)[:200]:
                    lines.append(f"{r.get('created_at','')} | {r.get('vendor_name') or r.get('vendor_email')} | {r.get('qty','')} {r.get('unit','')} | unit ${r.get('unit_price','')} | total ${r.get('total_price','')} | {r.get('description','')} | {r.get('notes','')}")
                txt.insert("1.0", "\n".join(lines))
            txt.config(state="disabled")
            tk.Button(pop, text="Close", command=pop.destroy).pack(pady=(0,10))

        def award_selected_vendor():
            vend_list = selected_vendors()
            if len(vend_list) != 1:
                messagebox.showwarning("Award Selected", "Select exactly one winning vendor first.", parent=win)
                return
            mats = selected_materials(False)
            if not mats:
                messagebox.showwarning("Award Selected", "Select the material item(s) being awarded first.", parent=win)
                return
            unit_price_txt = simpledialog.askstring("Award / Price History", "Optional unit price for selected item(s):", parent=win)
            unit_price = money_to_float(unit_price_txt)
            total_price_txt = simpledialog.askstring("Award / Price History", "Optional total price for this award:", parent=win)
            total_price = money_to_float(total_price_txt)
            notes = simpledialog.askstring("Award / Price History", "Optional notes/manufacturer/brand/lead time:", parent=win) or ""
            count = self.record_procurement_award(vend_list[0], mats, group, unit_price=unit_price, total_price=total_price, notes=notes)
            # Immediately strengthen the selected vendor as a route for these items.
            for v in vend_items:
                if str(v.get("email", "")).lower().strip() == str(vend_list[0].get("email", "")).lower().strip():
                    v["reason"] = "AWARDED / preferred: " + (v.get("reason", "") or "")
                    v["selected"] = True
            redraw_vendors()
            refresh_summary()
            save_current_rfq_cache()
            messagebox.showinfo("Award Recorded", f"Recorded award/preference for {count} item(s). Future matching items will prioritize {procurement_vendor_label(vend_list[0])}.", parent=win)

        def create_drafts(send_now=False):
            close_cell_editor(True)
            vend_list = selected_vendors()
            mats = selected_materials(False)
            if not mats:
                messagebox.showwarning("No Items Selected", "Select at least one material item to request.")
                return
            if not vend_list:
                messagebox.showwarning("No Vendors Selected", "Select at least one vendor recipient or add a vendor email.")
                return
            if send_now and not messagebox.askyesno(
                "Send RFQs Now",
                f"Send one separate RFQ email to each of {len(vend_list)} selected vendor(s) now?\n\nSelected items: {len(mats)}\n\nUse Create Drafts if you want to review first."
            ):
                return
            body = body_text.get("1.0", tk.END).strip()
            subject = subject_var.get().strip() or "Price and Availability Request"
            ok = 0
            errors = []
            for v in vend_list:
                try:
                    self.create_outlook_mail_item(v["email"], subject, body, display_only=not send_now)
                    ok += 1
                except Exception as exc:
                    errors.append(f"{v.get('email')}: {exc}")
            self.learn_vendor_history_from_rfq(vend_list, mats, group, emails)
            try:
                self.record_procurement_request(vend_list, mats, group, subject=subject)
            except Exception:
                pass
            qrec = {"created_at": datetime.now().isoformat(), "group_id": group_id, "group_name": group.get("name", "") if group else "", "vendors": vend_list, "materials": mats, "subject": subject, "sent_now": bool(send_now)}
            self.quote_requests.append(qrec)
            self.save_quote_requests()
            if send_now:
                sent_to = ", ".join([f"{v.get('name', v.get('email',''))} <{v.get('email','')}>" for v in vend_list])
                for m in mats:
                    requested_records.append({"selected": False, "material": dict(m), "sent_to": sent_to, "sent_on": qrec["created_at"]})
                # Move only selected active items to requested-tracking list.
                mat_items[:] = [m for m in mat_items if not m.get("selected", True)]
                moved_note = "Selected sent items moved to ITEMS ALREADY REQUESTED."
            else:
                moved_note = "Drafts were created for review. Items stay in the active list until Send RFQs Now."
            # v4.2.23: SAVE AFTER THE MOVE, NOT BEFORE IT. This call used to sit above the
            # `if send_now:` block, so the cache was written while requested_records was still
            # empty and mat_items still held every item that had just been sent. Send some of
            # an RFQ and close the window straight away and it reopened exactly as it was
            # BEFORE the send -- ITEMS ALREADY REQUESTED empty, the sent rows back in the
            # active list. Reported: "if the user has already requested some of the items but
            # not all ... it should save and be at the same last point when they re-open. It
            # used to do this." Intermittent, which is why it looked like a regression: any
            # later edit or checkbox calls save_current_rfq_cache() again and captures the
            # right state, so only send-then-close-immediately lost it.
            save_current_rfq_cache()
            redraw_materials(); redraw_requested(); redraw_vendors()
            msg = f"Created {'and sent ' if send_now else ''}{ok} separate vendor RFQ {'email(s)' if send_now else 'draft window(s)'} and updated vendor history.\n\n{moved_note}"
            if errors:
                msg += "\n\nErrors:\n" + "\n".join(errors[:5])
            try:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, msg)
            except Exception:
                pass
