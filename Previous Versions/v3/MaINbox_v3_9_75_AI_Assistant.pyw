                [_smartscan_python_executable(), resolved],
                cwd=os.path.dirname(resolved) or None,
                env=env,
                creationflags=(subprocess.CREATE_NO_WINDOW if hasattr(subprocess, "CREATE_NO_WINDOW") else 0),
            )
            try:
                self.set_status("SmartScan opened with MaINbox visual settings.")
            except Exception:
                pass
        except Exception as exc:
            messagebox.showerror("SmartScan", f"Could not open SmartScan.\n\n{exc}")

    def open_purchase_history_scanner_window(self):
        """Review-first scanner that learns vendor/material purchase history from old Outlook emails."""
        win = tk.Toplevel(self.root)
        win.title("Scan Old Emails for Purchase History")
        remember_window_geometry(win, "Scan Old Emails for Purchase History", "1250x760")
        try:
            win.minsize(1050, 650)
        except Exception:
            pass
        win.transient(self.root)

        candidates = []
        scan_running = {"flag": False}
        status_var = tk.StringVar(value="Choose a range, then click Scan. Results are review-first and will not be saved until you click Save Selected.")
        range_var = tk.StringVar(value="90")
