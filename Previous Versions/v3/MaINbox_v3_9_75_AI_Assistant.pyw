    def open_deleted_history_window(self):
        win = tk.Toplevel(self.root)
        win.title("Deleted From App History")
        remember_window_geometry(win, "Deleted From App History", "1200x660")
        win.transient(self.root)

        search_frame = tk.LabelFrame(win, text="Search Deleted Emails")
        search_frame.pack(fill="x", padx=10, pady=(10, 4))
        tk.Label(search_frame, text="Search sender / subject / received / deleted / category:").pack(side="left", padx=6, pady=6)
        search_var = tk.StringVar()
        search_entry = tk.Entry(search_frame, textvariable=search_var, width=58)
        search_entry.pack(side="left", padx=6, pady=6)
        count_var = tk.StringVar(value="")
        tk.Label(search_frame, textvariable=count_var, fg=_FG_DIM).pack(side="right", padx=8)

        tree = ttk.Treeview(
            win,
            columns=("deleted", "received", "sender", "subject", "category", "urgency", "status"),
            show="headings",
            selectmode="extended"
        )
        for col, label, width in [
            ("deleted", "Deleted", 155),
            ("received", "Received", 145),
            ("sender", "Sender", 230),
            ("subject", "Subject", 430),
            ("category", "Category", 140),
            ("urgency", "Urgency", 75),
            ("status", "Status", 125),
        ]:
            tree.heading(col, text=label)
            tree.column(col, width=width)
        tree.pack(fill="both", expand=True, padx=10, pady=6)

        def build_cache_lookup():
            lookup = {}
            try:
                for bucket in self.cache_data.values():
                    for e in bucket.get("emails", []) if isinstance(bucket, dict) else []:
                        eid = e.get("entry_id", "")
                        if eid and eid not in lookup:
                            lookup[eid] = e
            except Exception:
                pass
            for e in self.emails:
                eid = e.get("entry_id", "")
                if eid:
                    lookup[eid] = e
            return lookup

        def looks_like_entry_id(text):
            value = str(text or "").strip()
            if len(value) < 30:
                return False
            # Outlook EntryIDs are often very long hex-like strings.
            return bool(re.fullmatch(r"[A-Fa-f0-9]+", value[:80]))

        def friendly_row(raw, cache_lookup):
            eid = raw.get("entry_id", "")
            cached = cache_lookup.get(eid, {}) if eid else {}
            st = self.status_data.get(eid, {}) if eid else {}
            sender = raw.get("sender") or st.get("sender") or cached.get("sender") or "(unknown sender)"
            subject = raw.get("subject") or st.get("subject") or cached.get("subject") or ""
            if looks_like_entry_id(subject) or not subject:
                subject = "(details unavailable — restore or run Update to reload from Outlook)"
            received = raw.get("received") or st.get("received") or cached.get("received") or ""
            deleted = raw.get("deleted_from_app_at") or raw.get("deleted") or st.get("deleted_from_app_at") or ""
            return {
                "entry_id": eid,
                "deleted": deleted,
                "received": received,
                "sender": sender,
                "subject": subject,
                "category": raw.get("category") or st.get("category") or cached.get("category") or "",
                "urgency": raw.get("urgency") or st.get("urgency") or cached.get("urgency") or "",
                "status": raw.get("status") or st.get("status") or cached.get("status") or "",
            }

        def collect_deleted_rows():
            rows = []
            seen = set()
            cache_lookup = build_cache_lookup()
            for row in self.deleted_history:
                if not isinstance(row, dict):
                    continue
                eid = row.get("entry_id", "")
                if not eid or eid in seen:
                    continue
                seen.add(eid)
                rows.append(friendly_row(row, cache_lookup))
            for eid, st in self.status_data.items():
                if st.get("app_deleted") and eid not in seen:
                    raw = dict(st)
                    raw["entry_id"] = eid
                    rows.append(friendly_row(raw, cache_lookup))
                    seen.add(eid)
            return rows

        def row_matches(row, query):
            if not query:
                return True
            haystack = " ".join(str(row.get(k, "")) for k in ["deleted", "received", "sender", "subject", "category", "urgency", "status"]).lower()
            return all(part in haystack for part in query.lower().split())

        def refresh(*_):
            tree.delete(*tree.get_children())
            query = search_var.get().strip()
            rows = collect_deleted_rows()
            visible = [r for r in rows if row_matches(r, query)]
            for row in visible:
                eid = row.get("entry_id", "")
                tree.insert("", "end", iid=eid, values=(
                    row.get("deleted", ""),
                    row.get("received", ""),
                    row.get("sender", "")[:70],
                    row.get("subject", "")[:140],
                    row.get("category", ""),
                    row.get("urgency", ""),
                    row.get("status", ""),
                ))
            count_var.set(f"Showing {len(visible)} of {len(rows)} deleted item(s)")

        def clear_search():
            search_var.set("")
            refresh()
            search_entry.focus_set()

        def restore():
            ids = list(tree.selection())
            if not ids:
                return
            if not messagebox.askyesno("Restore Emails", f"Restore {len(ids)} selected email(s) to MaINbox?", parent=win):
                return
            self.save_undo_state("restore deleted email(s)")
            restored = 0
            current_ids = {e.get("entry_id", "") for e in self.emails}
            for eid in ids:
                st = self.status_data.get(eid, {})
                st["app_deleted"] = False
                self.status_data[eid] = st
                snap = next((r for r in self.deleted_history if r.get("entry_id") == eid), None)
                if snap and eid not in current_ids:
                    email = dict(snap)
                    email.pop("deleted_from_app_at", None)
                    email["message"] = None
                    email["is_new_import"] = False
                    email["followup_time"] = self.get_followup_display_for_email(eid)
                    self.emails.append(email)
                    restored += 1
            self.deleted_history = [r for r in self.deleted_history if r.get("entry_id") not in ids]
            self._rebuild_email_index()
            self.flush_status_data()
            self.save_deleted_history()
            self.save_cached_state()
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            refresh()
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, f"Restored {restored} email(s) from MaINbox deleted history. If an older deleted item had no readable snapshot, run Update/Refresh to re-import it from Outlook.")

        search_var.trace_add("write", refresh)
        search_entry.bind("<Return>", refresh)
        btns = tk.Frame(win)
        btns.pack(fill="x", padx=10, pady=(0, 10))
        tk.Button(btns, text="Restore Selected", command=restore, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Clear Search", command=clear_search, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Refresh", command=refresh, width=10).pack(side="left", padx=4)
        tk.Button(btns, text="Close", command=win.destroy, width=10).pack(side="right", padx=4)
        refresh()
        search_entry.focus_set()

    def goto_email_in_app(self, entry_id):
        """Reveal and select an email in the main list, widening the filters and
        expanding its group as needed so the row actually exists. Returns True on
        success, False if the email can't be shown (e.g. removed/archived)."""
        email = self.get_email_by_id(entry_id)
        if not email:
            return False
        # Grouped emails only render under an expanded group header, so expand the
        # owning group and widen the group filter before re-rendering.
        try:
            gid = self.get_group_id_for_email(entry_id) or ""
        except Exception:
            gid = ""
        if gid:
            for g in self.groups_data.get("groups", []):
                if g.get("id") == gid:
                    g["collapsed"] = False
                    break
        try:
            self.active_group_filter = "all"
        except Exception:
            pass
        # Pick a status filter that includes this email ("all" hides Low/Completed),
        # then fall back across the broad views if the first guess doesn't show it.
        if email.get("urgency") == "Low":
            target = "low"
        elif email.get("status") == "Completed":
            target = "completed"
        else:
            target = "all"
        self.set_filter(target)
        if not self.tree.exists(entry_id):
            for f in ("all", "completed", "low"):
                if f == target:
                    continue
                self.set_filter(f)
                if self.tree.exists(entry_id):
                    break
        if self.tree.exists(entry_id):
            try:
                self.tree.selection_set(entry_id)
                self.tree.focus(entry_id)
                self.tree.see(entry_id)
                self.tree.focus_set()
            except Exception:
                pass
            return True
        return False

