    # ===================== Customizable main-screen buttons =====================
    # The four main button bars (left group/tools column, the Edit-Selected bar, the
    # Filters bar, and the bottom Action bar) are rendered from a single manifest so
    # the user can hide/show and reorder buttons (Settings -> Visual Settings -> Edit
    # Buttons). Each button's exact command/styling lives in its manifest 'make' so
    # behavior is identical to before; only WHICH buttons show and in WHAT order is
    # driven by a saved layout file.

    def _main_button_specs(self):
        """Single source of truth for every customizable main-screen button.
        Returns {toolbar_key: [ {id, label, section, make(parent)->Button, ...} ]}.
        'section' drives the default grouping/separator on the vertical group bar."""
        B = tk.Button

        def grp(parent, text, cmd):
            return B(parent, text=text, command=cmd, width=17)

        specs = {
            "group": [
                {"id": "new_group", "label": "New Group", "section": "group",
                 "make": lambda p: grp(p, "New Group", self.create_group)},
                {"id": "rename_group", "label": "Rename Group", "section": "group",
                 "make": lambda p: grp(p, "Rename Group", self.rename_selected_group)},
                {"id": "set_group_urgency", "label": "Set Group Urgency", "section": "group",
                 "make": lambda p: grp(p, "Set Group Urgency", self.set_selected_group_urgency)},
                {"id": "delete_group", "label": "Delete Group", "section": "group",
                 "make": lambda p: grp(p, "Delete Group", self.delete_selected_group)},
                {"id": "add_selected", "label": "Add Selected", "section": "group",
                 "make": lambda p: grp(p, "Add Selected", self.add_selected_emails_to_selected_group)},
                {"id": "remove_selected", "label": "Remove Selected", "section": "group",
                 "make": lambda p: grp(p, "Remove Selected", self.remove_selected_emails_from_group)},
                {"id": "archive_group", "label": "Archive Group", "section": "group",
                 "make": lambda p: grp(p, "Archive Group", self.archive_selected_group)},
                {"id": "view_archived", "label": "View Archived", "section": "group",
                 "make": lambda p: grp(p, "View Archived", self.open_archived_groups_window)},
                {"id": "ai_summary", "label": "AI Summary", "section": "tools",
                 "make": lambda p: grp(p, "AI Summary", self.generate_selected_group_summary)},
                {"id": "quote_rfq", "label": "Quote RFQ", "section": "tools",
                 "make": lambda p: grp(p, "Quote RFQ", self.open_quote_intelligence_for_selected_group)},
                {"id": "quote_coverage", "label": "Quote Coverage", "section": "tools",
                 "make": lambda p: grp(p, "Quote Coverage", self.open_quote_coverage_window)},
                {"id": "scan_old_purchases", "label": "Scan Old Purchases", "section": "tools",
                 "make": lambda p: grp(p, "Scan Old Purchases", self.open_purchase_history_scanner_window)},
                {"id": "smartscan", "label": "SmartScan", "section": "tools",
                 "make": lambda p: grp(p, "SmartScan", self.open_smartscan_window)},
            ],
            "edit": [
                {"id": "apply_save", "label": "Apply / Save to Selected", "section": "edit", "pad": 10,
                 "make": lambda p: B(p, text="Apply / Save to Selected", command=self.save_selected_changes,
                                     bg=_ACCENT, fg="#ffffff", activebackground=_ACCENT2, activeforeground="#ffffff",
                                     font=("Segoe UI", _FONT_SIZE, "bold"))},
                {"id": "setup_followup", "label": "Setup/Edit Follow Up", "section": "edit",
                 "make": lambda p: B(p, text="Setup/Edit Follow Up", command=self.open_followup_window)},
                {"id": "cancel_followup", "label": "Cancel Follow Up", "section": "edit",
                 "make": lambda p: B(p, text="Cancel Follow Up", command=self.cancel_selected_followups)},
            ],
            "action": [
                {"id": "ai_reply", "label": "AI Reply", "section": "action",
                 "make": lambda p: B(p, text="AI Reply", command=self.create_ai_draft_reply)},
                {"id": "ai_scan_selected", "label": "AI Scan Selected", "section": "action",
                 "make": lambda p: B(p, text="AI Scan Selected", command=self.run_ai_scan_selected)},
                {"id": "ai_scan_cached", "label": "AI Scan New/Cached", "section": "action",
                 "make": lambda p: B(p, text="AI Scan New/Cached", command=self.run_ai_scan_cached_untriaged)},
                {"id": "load_body", "label": "Load Body", "section": "action",
                 "make": lambda p: B(p, text="Load Body", command=self.load_selected_body_preview)},
                {"id": "open_outlook", "label": "Open in Outlook", "section": "action",
                 "make": lambda p: B(p, text="Open in Outlook", command=self.open_selected_email)},
                {"id": "ai_triage", "label": "AI Triage", "section": "action",
                 "make": lambda p: B(p, text="AI Triage", command=self.open_live_triage_queue_window)},
                {"id": "assistant", "label": "\U0001F916 Assistant", "section": "action",
                 "make": lambda p: B(p, text="\U0001F916 Assistant", command=self._open_assistant_log)},
                {"id": "sales_uncat", "label": "Sales Uncat Queue", "section": "action",
                 "make": lambda p: B(p, text="Sales Uncat Queue", command=self.open_sales_uncategorized_queue)},
            ],
        }
        # Filters bar (loop so each closure binds its own key/label). The first eight
        # register in self._filter_buttons so _refresh_filter_button_styles still works.
        filt = []
        for _txt, _key in (("Show All", "all"), ("Needs Reply", "needs_reply"),
                           ("Waiting on Customer", "waiting_customer"), ("Waiting on Vendor", "waiting_vendor"),
                           ("Completed", "completed"), ("Urgent", "urgent"),
                           ("Follow Ups", "followups"), ("Low / Hidden", "low")):
            def _mk_filter(p, k=_key, t=_txt):
                b = tk.Button(p, text=t, command=lambda kk=k: self.set_filter(kk))
                if isinstance(getattr(self, "_filter_buttons", None), dict):
                    self._filter_buttons[k] = b
                return b
            filt.append({"id": f"filter_{_key}", "label": _txt, "section": "filter",
