    def _snapshot_email_for_deleted_followup(self, email):
        """Small, serializable email snapshot used only when the user deletes
        an item from MaINbox but chooses to keep one final follow-up."""
        try:
            snap = dict(email or {})
            snap.pop("message", None)
            # Keep the cached body out of the follow-up record so this remains
            # lightweight and does not bloat the follow-up JSON.
            snap.pop("body", None)
            snap["is_deleted_app_snapshot"] = True
            return snap
        except Exception:
            return {}

    def review_followups_before_app_delete(self, emails):
        """
        If a user deletes an item from MaINbox while follow-ups/tracking still
        exist, ask whether to keep them. Kept items are marked as final one-time
        reminders so deleting an item never starts a recurring tracking loop.
        Returns: "keep", "cancel", or None to abort deletion.
        """
        rows = self.collect_active_tracking_items_for_emails(emails)
        if not rows:
            return "cancel"

        manual_count = len([r for r in rows if r.get("tracking_type") == "Manual"])
        auto_count = len(rows) - manual_count
        message = (
            f"The selected item(s) have {len(rows)} active follow-up/tracking item(s).\n\n"
            f"Manual follow-ups: {manual_count}\n"
            f"AI/automatic tracking: {auto_count}\n\n"
            "Do you want to KEEP these follow-ups after deleting the item(s) from MaINbox?\n\n"
            "Yes = keep existing follow-ups as final one-time reminders.\n"
            "No = cancel the related follow-ups/tracking now.\n"
            "Cancel = do not delete anything."
        )
        answer = messagebox.askyesnocancel("Keep Follow-Ups After Delete?", message)
        if answer is None:
            return None
        return "keep" if answer else "cancel"

    def mark_deleted_item_followups_final(self, emails):
        """Mark kept follow-ups as final one-time reminders after app-only delete."""
        rows = self.collect_active_tracking_items_for_emails(emails)
        if not rows:
            return 0
        now_iso = datetime.now().isoformat()
        email_by_entry = {e.get("entry_id", ""): e for e in emails if isinstance(e, dict)}
        marked = 0
        for row in rows:
            item = row.get("item")
            email = row.get("email") or {}
            if not isinstance(item, dict) or item.get("completed") or item.get("cancelled"):
                continue
            entry_id = item.get("entry_id") or email.get("entry_id", "")
            snap_source = email_by_entry.get(entry_id) or email
            item["one_time_after_app_delete"] = True
            item["deleted_parent"] = True
            item["deleted_parent_at"] = now_iso
            item["deleted_parent_reason"] = "User deleted item from MaINbox but chose to keep follow-up."
            item["prevent_reschedule"] = True
            item["deleted_email_snapshot"] = self._snapshot_email_for_deleted_followup(snap_source)
            marked += 1
        if marked:
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_pending_reply_checks()
        return marked

    def delete_low_hidden_from_app(self):
        """Remove selected Low/Hidden items from MaINbox only. Outlook is not touched."""
        if self.active_filter != "low":
            messagebox.showwarning("Low / Hidden Only", "Switch to the Low / Hidden view first. This app-only delete button only works while viewing Low / Hidden items.")
            return
        selected_emails = self.get_selected_emails(show_warning=False)
        if not selected_emails:
            messagebox.showwarning("No Email Selected", "Select one or more Low / Hidden emails to remove from MaINbox.")
            return
        not_low = [e for e in selected_emails if e.get("urgency") != "Low"]
        if not_low:
            messagebox.showwarning("Low / Hidden Only", "Only Low urgency / hidden emails can be removed with this button.")
            return
        if not messagebox.askyesno("Delete from MaINbox Only", f"Remove {len(selected_emails)} selected email(s) from MaINbox only?\n\nThis will NOT delete anything from Outlook."):
            return
        followup_delete_choice = self.review_followups_before_app_delete(selected_emails)
        if followup_delete_choice is None:
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, "Delete from MaINbox cancelled. No emails or follow-ups were changed.")
            return
        removed, kept_followups, cancelled_followups = self.perform_app_delete(selected_emails, followup_delete_choice)
        self.preview_text.delete("1.0", tk.END)
        followup_note = ""
        if kept_followups:
            followup_note = f"\n\nKept {kept_followups} follow-up/tracking item(s) as final one-time reminders."
        elif cancelled_followups:
            followup_note = f"\n\nCancelled {cancelled_followups} related follow-up/tracking item(s)."
        self.preview_text.insert(tk.END, f"Removed {removed} email(s) from MaINbox only.\n\nOutlook was not changed.{followup_note}")

    def perform_app_delete(self, selected_emails, followup_delete_choice):
        """Shared core for app-only deletion (Outlook is never touched). Snapshots to
        Deleted History, marks status app_deleted (which the sync/scan paths honor so
        rows are not reinserted), applies the follow-up choice ('keep' or 'cancel'),
        rebuilds the email index, saves, and re-renders. Returns
        (removed_count, kept_followups, cancelled_followups). Used by the Low/Hidden
        delete button AND the global Search window so both behave identically."""
        if not selected_emails:
            return (0, 0, 0)
        self.save_undo_state("delete email(s) from app only")
        delete_ids = {e.get("entry_id", "") for e in selected_emails if e.get("entry_id")}
        deleted_at = datetime.now().isoformat()
        kept_followups = 0
        cancelled_followups = 0
        if followup_delete_choice == "keep":
            kept_followups = self.mark_deleted_item_followups_final(selected_emails)
        else:
            rows_to_cancel = self.collect_active_tracking_items_for_emails(selected_emails)
            keys_to_cancel = {row.get("key") for row in rows_to_cancel if row.get("key")}
            cancelled_followups = self.cancel_selected_tracking_items(keys_to_cancel, "Cancelled because item was deleted from MaINbox only")
            for email in selected_emails:
                email["followup_time"] = ""
        existing_history_ids = {row.get("entry_id", "") for row in self.deleted_history if isinstance(row, dict)}
        for email in selected_emails:
            entry_id = email.get("entry_id", "")
            if entry_id and entry_id not in existing_history_ids:
                snap = dict(email)
                snap.pop("message", None)
                snap["deleted_from_app_at"] = deleted_at
                self.deleted_history.insert(0, snap)
        self.deleted_history = self.deleted_history[:1000]

        # v2.10.8 patch: sent/waiting placeholder rows are also stored in
        # mainbox_sent_waiting_placeholders.json. Mark matching rows cleared so
        # the sync/scanner cannot reinsert them after the app restarts.
        sent_placeholder_changed = False
        for placeholder in getattr(self, "sent_waiting_placeholders", []):
            if placeholder.get("entry_id", "") in delete_ids:
                placeholder["cleared"] = True
                placeholder["cleared_at"] = deleted_at
                placeholder["cleared_reason"] = "app_deleted"
                sent_placeholder_changed = True
        if sent_placeholder_changed:
            self.save_sent_waiting_placeholders()

        self.save_deleted_history()
        by_id = {e.get("entry_id", ""): e for e in selected_emails}
        for entry_id in delete_ids:
            existing = self.status_data.get(entry_id, {})
            snap_email = by_id.get(entry_id, {})
            existing["app_deleted"] = True
            existing["deleted_from_app_at"] = deleted_at
            existing["prevent_future_followups"] = True
            existing["deleted_followups_final_only"] = (followup_delete_choice == "keep")
            existing["app_delete_followup_choice"] = followup_delete_choice
            # Store display metadata so Deleted History remains readable/searchable even after cache cleanup.
            # v3.9.2: also persist the identity fields the EntryID-change fallback relies on
            # (sender_email, conversation_id, normalized_subject, store_id). In Cached Exchange
            # Mode a server re-sync can hand the same message a NEW EntryID; without these fields
            # find_saved_status_for_email_fields() could not recognize the resynced copy and the
            # deleted item reappeared as "new" a couple of hours later.
            for key in ["sender", "sender_email", "subject", "normalized_subject", "conversation_id",
                        "received", "received_timestamp", "source", "store_id",
                        "outlook_categories", "category", "urgency", "status"]:
                val = snap_email.get(key, existing.get(key, ""))
                if val not in [None, ""]:
                    existing[key] = val
            # Guarantee a normalized subject is present even if the deleted row never carried one
            # (older cache rows / placeholders), so the subject gate in the fallback can match.
            if not existing.get("normalized_subject"):
                existing["normalized_subject"] = normalize_subject_for_match(existing.get("subject", "") or "")
            self.status_data[entry_id] = existing
        self.emails = [e for e in self.emails if e.get("entry_id", "") not in delete_ids]
        self._rebuild_email_index()
        memberships = self.groups_data.setdefault("memberships", {})
        for entry_id in list(delete_ids):
            memberships.pop(entry_id, None)
        self.flush_status_data()
        self.save_groups()
        self.save_cached_state()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        return (len(delete_ids), kept_followups, cancelled_followups)

    def get_selected_emails(self, show_warning=True):
        selected = [iid for iid in self.tree.selection() if not str(iid).startswith("groupheader:")]
        if not selected:
            if show_warning:
                messagebox.showwarning("No Email Selected", "Please select one or more emails.")
            return []
        # v3 efficiency: resolve each selected id once (the old comprehension called
        # get_email_by_id twice per id — once in the filter and once in the value).
        resolved = []
        for entry_id in selected:
            email = self.get_email_by_id(entry_id)
            if email:
                resolved.append(email)
        return resolved

    def get_selected_email(self):
        selected_emails = self.get_selected_emails()
        return selected_emails[0] if selected_emails else None

    def load_body_if_needed(self, email):
        if email.get("body_loaded"):
            return email.get("body", "")

        # v3.9.42: AI triage runs on a worker thread. If another background Outlook
        # job is already walking folders, do not let AI body loading pile onto COM and
        # make the live queue look blank/frozen. Wait briefly, then continue with the
        # cached/subject-only context if Outlook is still busy.
        lock = getattr(self, "_outlook_worker_lock", None)
        use_lock = bool(lock is not None and threading.current_thread() is not threading.main_thread())
        acquired = False
        if use_lock:
            try:
                acquired = lock.acquire(timeout=8)
            except Exception:
                acquired = True
            if not acquired:
                email["body_load_skipped_reason"] = "Outlook busy; AI triage used subject/sender only for this pass."
                return email.get("body", "") or ""

        try:
            msg = self.get_message_object(email)
            body = ""
            if msg:
                try:
                    body = msg.Body or ""
                except Exception:
                    body = ""
            email["body"] = body
            email["body_loaded"] = True
            # v3 efficiency: single cache write regardless of exit path (was 3 writes).
            self.save_cached_state()
            return body
        finally:
            if use_lock and acquired:
                try:
                    lock.release()
                except Exception:
                    pass


