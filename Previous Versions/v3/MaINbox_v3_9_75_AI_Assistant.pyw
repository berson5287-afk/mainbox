    def choose_group_for_move(self, current_group_id=""):
        groups = [g for g in self.groups_data.get("groups", []) if not g.get("archived") and g.get("id") != current_group_id]
        if not groups:
            messagebox.showwarning("No Groups", "There are no other active groups to move this email into.")
            return ""
        win = tk.Toplevel(self.root)
        win.title("Move to Group")
        remember_window_geometry(win, "Move to Group", "520x420")
        win.transient(self.root)
        win.grab_set()
        tk.Label(win, text="Select the group to move this email into:", font=("Segoe UI", 10, "bold")).pack(anchor="w", padx=10, pady=(10, 4))
        listbox = tk.Listbox(win, height=14)
        listbox.pack(fill="both", expand=True, padx=10, pady=6)
        for g in groups:
            listbox.insert(tk.END, f"{g.get('name','')}  [{g.get('urgency','Normal')}]")
        result = {"group_id": ""}
        def do_move():
            sel = listbox.curselection()
            if not sel:
                return
            result["group_id"] = groups[sel[0]].get("id", "")
            win.destroy()
        def cancel():
            win.destroy()
        listbox.bind("<Double-1>", lambda e: do_move())
        btns = tk.Frame(win)
        btns.pack(fill="x", padx=10, pady=(0, 10))
        tk.Button(btns, text="Move", command=do_move, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Cancel", command=cancel, width=12).pack(side="right", padx=4)
        try:
            listbox.selection_set(0)
            listbox.focus_set()
        except Exception:
            pass
        win.wait_window()
        return result["group_id"]

