def _mainbox_smartscan_theme_payload():
    """Theme payload passed to embedded/external SmartScan child processes."""
    try:
        return json.dumps({
            "theme": str((globals().get("CURRENT_MAINBOX_SETTINGS") or {}).get("theme", "dark")),
            "bg": _BG, "bg2": _BG2, "bg3": _BG3, "accent": _ACCENT, "accent2": _ACCENT2,
            "button_bg": _BTN_BG, "button_fg": _BTN_FG, "fg": _FG, "fg_dim": _FG_DIM,
            "sel_bg": _SEL_BG, "sel_fg": _SEL_FG, "entry_bg": _ENTRY_BG,
            "font_family": _FONT, "font_size": _FONT_SIZE, "font_weight": _FONT_WEIGHT,
            "font_bold": (_FONT_WEIGHT == "bold"),
        })
    except Exception:
        return "{}"


def _ensure_embedded_smartscan_file():
    """Write the embedded SmartScan app/engine to MaINbox data and return its path."""
    try:
        import zlib as _zlib
        target = data_path("SmartScan_Embedded_Mainbox.pyw")
        payload = _zlib.decompress(base64.b64decode(_EMBEDDED_SMARTSCAN_ZB64.encode("ascii"))).decode("utf-8", errors="replace")
        needs_write = True
        try:
            if os.path.exists(target):
                existing = open(target, "r", encoding="utf-8", errors="replace").read()
                needs_write = (existing != payload)
        except Exception:
            needs_write = True
        if needs_write:
            with open(target, "w", encoding="utf-8", newline="\n") as f:
                f.write(payload)
        return target
    except Exception:
        try:
            return data_path("SmartScan_Embedded_Mainbox.pyw")
        except Exception:
            return ""

def _resolve_smartscan_path(path_hint=""):
    """Find SmartScan, preferring the embedded MaINbox copy unless a user path is set."""
    candidates = []
    hint = str(path_hint or "").strip()
    if hint.lower() in ["__embedded__", "embedded", "builtin", "built-in", ""]:
        embedded = _ensure_embedded_smartscan_file()
        if embedded and os.path.exists(embedded):
            return embedded
    elif hint:
        candidates.append(hint)
    try:
        base_dir = os.path.dirname(os.path.abspath(__file__))
    except Exception:
        base_dir = os.getcwd()
    names = [
        hint,
        "SmartScan_Extractor_v2_8_4_mainbox_headless_bridge.pyw",
        "SmartScan_Extractor_v2_8_3_duplicate_missing_tightener.pyw",
        "SmartScan_Extractor_v2_8_2_missing_ocr_qty_audit_fix.pyw",
        "SmartScan_Extractor_v2_8_1_missing_ocr_qty_audit.pyw",
        "SmartScan_Extractor_v2_8_accuracy_audit_upgrade.pyw",
        "SmartScan_Extractor_v2_7_ultimate_smart_route.pyw",
    ]
    for name in names:
        if not name or str(name).lower() in ["__embedded__", "embedded"]:
            continue
        candidates.append(os.path.join(base_dir, name))
        candidates.append(os.path.join(os.getcwd(), name))
    try:
        for folder in [base_dir, os.getcwd()]:
            for found in sorted(glob.glob(os.path.join(folder, "SmartScan_Extractor_v2_*.pyw")), reverse=True):
                candidates.append(found)
    except Exception:
        pass
    seen = set()
    for cand in candidates:
        if not cand:
            continue
        cand = os.path.abspath(os.path.expanduser(str(cand)))
        if cand in seen:
            continue
        seen.add(cand)
        if os.path.exists(cand):
            return cand
    embedded = _ensure_embedded_smartscan_file()
    if embedded and os.path.exists(embedded):
        return embedded
    return ""


def _resolve_embedded_smartscan_path():
    """Return the embedded SmartScan copy that supports MaINbox review/theme mode.

    This intentionally ignores the Settings SmartScan path.  A saved Settings path
    may point at an older standalone SmartScan file, which opens in normal mode,
    does not receive MaINbox's theme reliably, and can ignore the RFQ attachment
    list.  RFQ review must use the embedded copy so Send Quote RFQ always gets
    the Done -> Send Back bridge.
    """
    embedded = _ensure_embedded_smartscan_file()
    if embedded and os.path.exists(embedded):
        return embedded
    return _resolve_smartscan_path("__embedded__")


def _load_smartscan_module(path_hint="", log=None):
    """Load SmartScan as a private plugin module for RFQ extraction."""
    global _SMARTSCAN_MODULE_CACHE
    resolved = _resolve_smartscan_path(path_hint or RFQ_SMARTSCAN_PATH)
    if not resolved:
        raise FileNotFoundError(
            "SmartScan extractor file was not found. Put SmartScan_Extractor_v2_8_3_duplicate_missing_tightener.pyw "
            "in the same folder as MaINbox, or set the SmartScan path in Settings."
        )
    cached = _SMARTSCAN_MODULE_CACHE or {}
    if cached.get("path") == resolved and cached.get("module") is not None:
        return cached["module"], resolved

    module_name = "mainbox_smartscan_plugin"
    loader = importlib.machinery.SourceFileLoader(module_name, resolved)
    spec = importlib.util.spec_from_loader(module_name, loader)
    if spec is None:
        raise ImportError(f"Could not create SmartScan import spec for {resolved}")
    module = importlib.util.module_from_spec(spec)

    # Important: dataclasses inside SmartScan expect their module name to already
    # be present in sys.modules while the file is being executed.  When loading a
    # .pyw manually with SourceFileLoader, Python does not always register it for
    # us first, which can crash at @dataclass with:
    #   AttributeError: 'NoneType' object has no attribute '__dict__'
    # Register before exec_module so SmartScan behaves the same as when it runs
    # standalone.
    old_module = sys.modules.get(module_name)
    sys.modules[module_name] = module
    try:
        loader.exec_module(module)
    except Exception:
        if old_module is not None:
            sys.modules[module_name] = old_module
        else:
            sys.modules.pop(module_name, None)
        raise

    _SMARTSCAN_MODULE_CACHE = {"path": resolved, "module": module}
    return module, resolved


def _smartscan_get(row, name, default=""):
    try:
        if isinstance(row, dict):
            return row.get(name, default)
        return getattr(row, name, default)
    except Exception:
        return default


def _smartscan_row_to_mainbox_material(row, source_name=""):
    """Convert a SmartScan MaterialLine/dict to the material dict used by MaINbox RFQ."""
    try:
        if hasattr(row, "as_dict"):
            d = row.as_dict()
        elif isinstance(row, dict):
            d = dict(row)
        else:
            d = {k: _smartscan_get(row, k, "") for k in [
                "qty", "unit", "description", "part_number", "manufacturer", "status",
                "ai_status", "review_status", "source_text", "notes"
            ]}
    except Exception:
        d = {}

    qty = str(d.get("qty", "") or "").strip()
    unit = str(d.get("unit", "") or "").strip()
    desc = str(d.get("description", "") or "").strip()
    part = str(d.get("part_number", "") or d.get("part", "") or "").strip()
    manuf = str(d.get("manufacturer", "") or "").strip()
    notes_bits = ["SmartScan"]
    if source_name:
        notes_bits.append(os.path.basename(str(source_name)))
    for k in ["ai_status", "review_status", "status"]:
        val = str(d.get(k, "") or "").strip()
        if val and val.lower() not in ["pending", ""]:
            notes_bits.append(val)
            break

    return {
        "qty": qty,
        "unit": unit,
        "description": desc,
        "part_number": part,
        "manufacturer": manuf,
        "notes": " | ".join(notes_bits),
        "source": "smartscan",
        "selected": True,
    }


def _smartscan_python_executable():
    """Return a Python executable that can run SmartScan headless."""
    exe = sys.executable or "python"
    try:
        # If MaINbox is launched with pythonw.exe, use python.exe from the same
        # folder when available.  pythonw works too, but python.exe gives better
        # subprocess behavior and diagnostics.
        base = os.path.basename(exe).lower()
        if base == "pythonw.exe":
            py = os.path.join(os.path.dirname(exe), "python.exe")
            if os.path.exists(py):
                return py
    except Exception:
        pass
    return exe


def _smartscan_split_pdf_to_single_page_files(path, source_name="", keep_dir="", progress_callback=None):
    """Return one-page PDF files for a multipage PDF so SmartScan can scan page-by-page.

    SmartScan is strongest when a page is processed like a single-page scan. Multipage
    PDFs can make OCR/table routing mix headers, footers, and continuation rows across
    pages. This helper converts a multipage PDF into stable page files first, then the
    caller scans each page and merges the material rows back together.
    """
    out_paths = []
    if not RFQ_SMARTSCAN_PAGEWISE_PDF:
        return out_paths
    try:
        if os.path.splitext(str(path or ""))[1].lower() != ".pdf":
            return out_paths
        if not path or not os.path.exists(str(path)):
            return out_paths
    except Exception:
        return out_paths

    def _log(msg):
        if progress_callback:
            try:
                progress_callback(str(msg))
            except Exception:
                pass

    try:
        import fitz  # PyMuPDF
    except Exception as exc:
        _log(f"{source_name or os.path.basename(str(path))}: pagewise SmartScan skipped; PyMuPDF is not available ({exc})")
        return out_paths

    doc = None
    try:
        doc = fitz.open(str(path))
        page_total = len(doc)
        if page_total <= 1:
            return out_paths

        if not keep_dir:
            keep_dir = tempfile.mkdtemp(prefix="mainbox_smartscan_pages_")
        os.makedirs(keep_dir, exist_ok=True)

        base_src = source_name or os.path.basename(str(path)) or "scan.pdf"
        base_no_ext = os.path.splitext(os.path.basename(str(base_src)))[0] or "scan"
        try:
            safe_base = safe_filename_piece(base_no_ext, "scan")[:90]
        except Exception:
            safe_base = re.sub(r"[^A-Za-z0-9_.-]+", "_", base_no_ext)[:90] or "scan"

        _log(f"{base_src}: SmartScan pagewise mode splitting {page_total} PDF page(s) into single-page scans")
        for idx in range(page_total):
            one = None
            try:
                one = fitz.open()
                one.insert_pdf(doc, from_page=idx, to_page=idx)
                out_name = f"{safe_base}__page_{idx + 1:03d}_of_{page_total:03d}.pdf"
                out_path = os.path.join(keep_dir, out_name)
                one.save(out_path, garbage=4, deflate=True)
                out_paths.append(out_path)
            except Exception as page_exc:
                _log(f"{base_src}: could not split page {idx + 1} for SmartScan ({page_exc})")
            finally:
                try:
                    if one is not None:
                        one.close()
                except Exception:
                    pass
    except Exception as exc:
        _log(f"{source_name or os.path.basename(str(path))}: SmartScan pagewise PDF split failed ({exc})")
        return []
    finally:
        try:
            if doc is not None:
                doc.close()
        except Exception:
            pass
    return out_paths


def _smartscan_split_image_to_single_page_files(path, source_name="", keep_dir="", progress_callback=None):
    """Return one single-page PNG per frame for a multi-frame image (multipage TIFF/GIF).

    v3.8.07: gives multi-page IMAGE files the same page-by-page treatment as multipage
    PDFs. Each frame is written as its own single-page PNG so SmartScan scans it like a
    clean single-page scan, then the caller merges the rows back together.
    """
    out_paths = []
    if not RFQ_SMARTSCAN_PAGEWISE_PDF:
        return out_paths
    try:
        ext = os.path.splitext(str(path or ""))[1].lower()
        if ext not in (".tif", ".tiff", ".gif", ".png", ".jpg", ".jpeg", ".bmp", ".webp"):
            return out_paths
        if not path or not os.path.exists(str(path)):
            return out_paths
    except Exception:
        return out_paths

    def _log(msg):
        if progress_callback:
            try:
                progress_callback(str(msg))
            except Exception:
                pass

    try:
        from PIL import Image, ImageSequence
    except Exception as exc:
        _log(f"{source_name or os.path.basename(str(path))}: pagewise image split skipped; Pillow not available ({exc})")
        return out_paths

    img = None
    try:
        img = Image.open(str(path))
        frame_total = getattr(img, "n_frames", 1) or 1
        if frame_total <= 1:
            return out_paths  # single-page image -> let the normal single-shot route handle it

        if not keep_dir:
            keep_dir = tempfile.mkdtemp(prefix="mainbox_smartscan_pages_")
        os.makedirs(keep_dir, exist_ok=True)

        base_src = source_name or os.path.basename(str(path)) or "scan.tif"
        base_no_ext = os.path.splitext(os.path.basename(str(base_src)))[0] or "scan"
        try:
            safe_base = safe_filename_piece(base_no_ext, "scan")[:90]
        except Exception:
            safe_base = re.sub(r"[^A-Za-z0-9_.-]+", "_", base_no_ext)[:90] or "scan"

        _log(f"{base_src}: SmartScan pagewise mode splitting {frame_total} image page(s) into single-page scans")
        for idx, frame in enumerate(ImageSequence.Iterator(img)):
            try:
                out_name = f"{safe_base}__page_{idx + 1:03d}_of_{frame_total:03d}.png"
                out_path = os.path.join(keep_dir, out_name)
                frame.convert("RGB").save(out_path, format="PNG")
                out_paths.append(out_path)
            except Exception as page_exc:
                _log(f"{base_src}: could not split image page {idx + 1} for SmartScan ({page_exc})")
    except Exception as exc:
        _log(f"{source_name or os.path.basename(str(path))}: SmartScan pagewise image split failed ({exc})")
        return []
    finally:
        try:
            if img is not None:
                img.close()
        except Exception:
            pass
    return out_paths


def _smartscan_split_to_single_page_files(path, source_name="", keep_dir="", progress_callback=None):
    """Split any multipage document (PDF or multi-frame image) into single-page files.

    v3.8.07: single entry point used by the pagewise scanner so the same
    split -> scan-each-page -> merge pattern works for PDFs and image files alike.
    """
    if os.path.splitext(str(path or ""))[1].lower() == ".pdf":
        return _smartscan_split_pdf_to_single_page_files(
            path, source_name=source_name, keep_dir=keep_dir, progress_callback=progress_callback
        )
    return _smartscan_split_image_to_single_page_files(
        path, source_name=source_name, keep_dir=keep_dir, progress_callback=progress_callback
    )


def _smartscan_page_label_from_path(path, fallback_name=""):
    """Human-friendly source label for SmartScan page temp files."""
    name = os.path.basename(str(path or fallback_name or ""))
    m = re.search(r"__page_(\d+)_of_(\d+)\.(?:pdf|png|jpe?g|tiff?|bmp|webp|gif)$", name, re.I)
    if m:
        base = re.sub(r"__page_\d+_of_\d+\.(?:pdf|png|jpe?g|tiff?|bmp|webp|gif)$", "", name, flags=re.I)
        return f"{base} page {int(m.group(1))} of {int(m.group(2))}"
    return fallback_name or name


def _smartscan_cleanup_merged_material_rows(materials, progress_callback=None, source_name=""):
    """Conservative cleanup for pagewise SmartScan merges.

    This only removes obvious header/footer/note rows that can be accidentally
    interpreted as one final material item after page-by-page extraction. It is
    intentionally conservative so valid material rows are not touched.
    """
    rows = normalize_material_items(materials or [])
    if not rows:
        return rows

    footer_patterns = [
        r"^\s*page\s+\d+(\s+of\s+\d+)?\s*$",
        r"^\s*continued\b",
        r"^\s*end\s+of\s+(list|material|materials|rfq)\b",
        r"^\s*(material|materials)\s+list\s*$",
        r"^\s*(quote\s+request|rfq)\s*$",
        r"^\s*(project|job|customer|vendor|requested\s+by|prepared\s+by|date)\s*:",
        r"^\s*(note|notes)\s*:",
        r"^\s*(subtotal|total|grand\s+total)\b",
        r"^\s*(signature|approved\s+by|thank\s+you)\b",
    ]
    footer_re = re.compile("|".join(f"(?:{p})" for p in footer_patterns), re.I)

    cleaned = []
    removed = []
    for item in rows:
        desc = re.sub(r"\s+", " ", str(item.get("description", "") or "").strip())
        part = str(item.get("part_number", "") or "").strip()
        qty = str(item.get("qty", "") or "").strip()
        unit = str(item.get("unit", "") or "").strip()
        combined = re.sub(r"\s+", " ", " ".join([qty, unit, part, desc]).strip())

        # Keep anything that clearly looks like a real material request.
        if qty or part:
            cleaned.append(item)
            continue
        if not desc:
            continue
        if footer_re.search(desc) or footer_re.search(combined):
            removed.append(desc[:120])
            continue
        if not re.search(r"[A-Za-z0-9]", desc):
            removed.append(desc[:120])
            continue
        cleaned.append(item)

    if removed and progress_callback:
        try:
            label = (source_name + ": ") if source_name else ""
            progress_callback(label + f"SmartScan cleanup removed {len(removed)} obvious non-material row(s): " + "; ".join(removed[:5]))
        except Exception:
            pass
    return cleaned


def _run_smartscan_headless_pagewise_pdf(path, source_name="", progress_callback=None):
    """Scan a multipage PDF one page at a time and merge the SmartScan rows."""
    messages = []
    merged_text_parts = []
    materials = []
    split_dir = ""

    def slog(msg):
        try:
            messages.append(str(msg))
        except Exception:
            messages.append(repr(msg))
        if progress_callback:
            try:
                progress_callback(str(msg))
            except Exception:
                pass

    try:
        split_dir = tempfile.mkdtemp(prefix="mainbox_smartscan_pages_")
        page_paths = _smartscan_split_to_single_page_files(path, source_name=source_name, keep_dir=split_dir, progress_callback=slog)
        if not page_paths:
            return [], messages, ""
        slog(f"{source_name}: SmartScan pagewise PDF mode will scan {len(page_paths)} single-page file(s) and merge the results")
        for idx, page_path in enumerate(page_paths, start=1):
            page_label = _smartscan_page_label_from_path(page_path, f"{source_name} page {idx}")
            try:
                page_rows, page_msgs, page_text = _run_smartscan_headless_subprocess(page_path, source_name=page_label, progress_callback=progress_callback)
                if page_msgs:
                    messages.extend(page_msgs)
                if page_text:
                    merged_text_parts.append(f"\n--- SmartScan Page {idx}: {page_label} ---\n{page_text}")
                if page_rows:
                    for row in page_rows:
                        rec = dict(row)
                        rec["source_page"] = rec.get("source_page") or f"page {idx}"
                        rec["source"] = rec.get("source") or "smartscan-pagewise"
                        notes = str(rec.get("notes", "") or "")
                        page_note = f"Page {idx}"
                        if page_note not in notes:
                            rec["notes"] = (notes + (" | " if notes else "") + page_note).strip()
                        materials.append(rec)
                    slog(f"{source_name}: SmartScan page {idx} added {len(page_rows)} row(s)")
                else:
                    slog(f"{source_name}: SmartScan page {idx} returned 0 row(s)")
            except Exception as page_exc:
                slog(f"{source_name}: SmartScan page {idx} failed ({page_exc})")
        materials = _smartscan_cleanup_merged_material_rows(materials, progress_callback=progress_callback, source_name=source_name)
        slog(f"{source_name}: SmartScan pagewise PDF merged {len(materials)} total material row(s)")
        return materials, messages, "\n".join(merged_text_parts).strip()
    finally:
        try:
            if split_dir and os.path.exists(split_dir):
                shutil.rmtree(split_dir, ignore_errors=True)
        except Exception:
            pass



def _smartscan_is_multipage_pdf(path):
    """True only when the saved file is a PDF with more than one page."""
    try:
        if os.path.splitext(str(path or ""))[1].lower() != ".pdf":
            return False
        if not path or not os.path.exists(str(path)):
            return False
        try:
            import fitz  # PyMuPDF
            doc = fitz.open(str(path))
            try:
                return len(doc) > 1
            finally:
                try:
                    doc.close()
                except Exception:
                    pass
        except Exception:
            try:
                from pypdf import PdfReader
            except Exception:
                try:
                    from PyPDF2 import PdfReader
                except Exception:
                    PdfReader = None
            if PdfReader:
                reader = PdfReader(str(path))
                return len(getattr(reader, "pages", []) or []) > 1
    except Exception:
        return False
    return False


def _smartscan_is_multipage_document(path):
    """True for a multipage PDF OR a multi-frame image (e.g. multipage TIFF/GIF).

    v3.8.07: lets the pagewise split -> scan -> merge route engage for multi-page
    image files, not just PDFs.
    """
    if _smartscan_is_multipage_pdf(path):
        return True
    try:
        ext = os.path.splitext(str(path or ""))[1].lower()
        if ext not in (".tif", ".tiff", ".gif"):
            return False
        if not path or not os.path.exists(str(path)):
            return False
        from PIL import Image
        with Image.open(str(path)) as img:
            return (getattr(img, "n_frames", 1) or 1) > 1
    except Exception:
        return False


def _smartscan_material_seed_label(source_name=""):
    """Safe base name for the merged SmartScan material-list seed file."""
    base = os.path.splitext(os.path.basename(str(source_name or "smartscan_material_list")))[0]
    try:
        return safe_filename_piece(base, "smartscan_material_list")[:80]
    except Exception:
        return re.sub(r"[^A-Za-z0-9_.-]+", "_", base).strip("._-")[:80] or "smartscan_material_list"


def _smartscan_write_merged_material_list_file(materials, source_name="", keep_dir="", merged_text="", progress_callback=None):
    """Write pagewise SmartScan rows into one clean CSV for the SmartScan review window.

    Multipage PDFs are first scanned one page at a time, then MaINbox sends
    SmartScan ONE merged material-list file instead of asking SmartScan to OCR
    a multipage PDF or a batch of page PDFs in the review window.
    """
    rows = _smartscan_cleanup_merged_material_rows(materials or [], progress_callback=progress_callback, source_name=source_name)
    if not rows:
        return ""
    if not keep_dir:
        keep_dir = tempfile.mkdtemp(prefix="mainbox_smartscan_merged_")
    os.makedirs(keep_dir, exist_ok=True)
    base = _smartscan_material_seed_label(source_name)
    csv_path = os.path.join(keep_dir, f"{base}__SMARTSCAN_PAGEWISE_MERGED_LIST.csv")
    try:
        with open(csv_path, "w", newline="", encoding="utf-8") as f:
            writer = csv.writer(f)
            writer.writerow(["QTY", "UOM", "PART_NUMBER", "DESCRIPTION", "MANUFACTURER", "NOTES"])
            for item in rows:
                writer.writerow([
                    str(item.get("qty", "") or "").strip(),
                    str(item.get("unit", "") or "").strip(),
                    str(item.get("part_number", "") or "").strip(),
                    str(item.get("description", "") or "").strip(),
                    str(item.get("manufacturer", "") or "").strip(),
                    str(item.get("notes", "") or "").strip(),
                ])
        if merged_text:
            try:
                txt_path = os.path.join(keep_dir, f"{base}__SMARTSCAN_PAGEWISE_MERGED_TEXT.txt")
                with open(txt_path, "w", encoding="utf-8", errors="ignore") as tf:
                    tf.write(str(merged_text or ""))
            except Exception:
                pass
        if progress_callback:
            try:
                progress_callback(f"{source_name}: wrote one merged SmartScan material-list file for review: {csv_path}")
            except Exception:
                pass
        return csv_path
    except Exception as exc:
        if progress_callback:
            try:
                progress_callback(f"{source_name}: could not write merged SmartScan material-list file ({exc})")
            except Exception:
                pass
        return ""


def _run_smartscan_headless_subprocess(path, source_name="", progress_callback=None):
    """Run SmartScan as a separate headless process and read its JSON output.

    This is the most seamless/faithful MaINbox integration because it uses the
    same SmartScan engine that works as a standalone app without importing the
    SmartScan Tk module into MaINbox's Outlook/COM process.
    """
    messages = []

    def slog(msg):
        try:
            messages.append(str(msg))
        except Exception:
            messages.append(repr(msg))
        if progress_callback:
            try:
                progress_callback(str(msg))
            except Exception:
                pass

    resolved = _resolve_smartscan_path(RFQ_SMARTSCAN_PATH)
    if not resolved:
        raise FileNotFoundError(
            "SmartScan extractor file was not found. Put SmartScan_Extractor_v2_8_4_mainbox_headless_bridge.pyw "
            "in the same folder as MaINbox, or set the SmartScan path in Settings."
        )

    json_fd, json_path = tempfile.mkstemp(prefix="mainbox_smartscan_", suffix=".json")
    os.close(json_fd)
    try:
        try:
            os.remove(json_path)
        except Exception:
            pass

        timeout = int(os.environ.get("MAINBOX_SMARTSCAN_TIMEOUT", "900"))
        cmd = [
            _smartscan_python_executable(),
            resolved,
            "--mainbox-headless",
            str(path),
            "--json-out",
            json_path,
        ]
        slog(f"{source_name}: launching SmartScan headless: {os.path.basename(resolved)}")
        env = os.environ.copy()
        env["MAINBOX_SMARTSCAN_THEME_JSON"] = _mainbox_smartscan_theme_payload()
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd=os.path.dirname(resolved) or None,
            env=env,
            creationflags=(subprocess.CREATE_NO_WINDOW if hasattr(subprocess, "CREATE_NO_WINDOW") else 0),
        )

        if proc.stdout:
            for line in str(proc.stdout).splitlines()[-20:]:
                if line.strip():
                    slog(f"{source_name}: SmartScan stdout: {line.strip()}")
        if proc.stderr:
            for line in str(proc.stderr).splitlines()[-30:]:
                if line.strip():
                    slog(f"{source_name}: SmartScan stderr: {line.strip()}")

        if proc.returncode != 0:
            raise RuntimeError(f"SmartScan headless exited with code {proc.returncode}")

        if not os.path.exists(json_path) or os.path.getsize(json_path) <= 0:
            raise RuntimeError("SmartScan headless did not create a JSON result file")

        with open(json_path, "r", encoding="utf-8", errors="replace") as f:
            payload = json.load(f)

        if not payload.get("ok", False):
            raise RuntimeError(payload.get("error") or "SmartScan headless returned ok=false")

        for line in payload.get("logs", [])[-25:]:
            if line:
                slog(f"{source_name}: SmartScan: {line}")
        for w in payload.get("warnings", [])[:12]:
            if w:
                slog(f"{source_name}: SmartScan warning: {w}")
        if payload.get("engine_summary"):
            slog(f"{source_name}: SmartScan summary: {payload.get('engine_summary')}")
        if payload.get("confidence") != "":
            slog(f"{source_name}: SmartScan confidence: {payload.get('confidence')}")

        rows = payload.get("rows", []) or []
        materials = []
        for r in rows:
            mat = _smartscan_row_to_mainbox_material(r, source_name=source_name)
            if str(mat.get("description", "") or "").strip():
                materials.append(mat)
        materials = normalize_material_items(materials)
        slog(f"{source_name}: SmartScan headless extracted {len(materials)} material row(s)")
        return materials, messages, str(payload.get("merged_text", "") or "")
    finally:
        try:
            os.remove(json_path)
        except Exception:
            pass


def _run_smartscan_review_subprocess(paths, source_name="SmartScan RFQ Review", progress_callback=None):
    """Open SmartScan review after converting multipage PDFs into one clean material list.

    v3.8.03 important fix:
    - The old review route could still hand a multipage PDF (or a batch of page PDFs)
      into SmartScan's review window.
    - This route now scans each multipage PDF page-by-page HEADLESS first.
    - The page rows are merged/deduped by MaINbox.
    - SmartScan review receives ONE generated merged material-list CSV, so the review
      window starts from the correct combined list instead of re-OCRing a multipage file.
    """
    original_files = [str(p) for p in (paths or []) if p and os.path.exists(str(p))]
    files = []
    review_keep_dir = ""
    premerged_rows = []
    premerged_text_parts = []
    msgs = []

    def rlog(msg):
        try:
            msgs.append(str(msg))
        except Exception:
            msgs.append(repr(msg))
        if progress_callback:
            try:
                progress_callback(str(msg))
            except Exception:
                pass

    try:
        if original_files:
            review_keep_dir = os.path.join(RFQ_DEBUG_DIR, "smartscan_pagewise_review_" + datetime.now().strftime("%Y%m%d_%H%M%S"))
            os.makedirs(review_keep_dir, exist_ok=True)

            for original in original_files:
                original_name = os.path.basename(str(original))
                if RFQ_SMARTSCAN_PAGEWISE_PDF and _smartscan_is_multipage_document(original):
                    rlog(f"{original_name}: SmartScan review pre-scan — splitting multipage PDF and extracting each page before review")
                    try:
                        page_rows, page_msgs, page_text = _run_smartscan_headless_pagewise_pdf(
                            original,
                            source_name=original_name,
                            progress_callback=progress_callback,
                        )
                        if page_msgs:
                            msgs.extend(page_msgs)
                        if page_text:
                            premerged_text_parts.append(page_text)
                        if page_rows:
                            premerged_rows.extend(page_rows)
                            seed_file = _smartscan_write_merged_material_list_file(
                                page_rows,
                                source_name=original_name,
                                keep_dir=review_keep_dir,
                                merged_text=page_text,
                                progress_callback=progress_callback,
                            )
                            if seed_file and os.path.exists(seed_file):
                                files.append(seed_file)
                                rlog(f"{original_name}: SmartScan review will use merged pagewise material list ({len(page_rows)} row(s)), not the original multipage PDF")
                            else:
                                files.append(original)
                                rlog(f"{original_name}: merged material-list file could not be made; falling back to original file")
                        else:
                            files.append(original)
                            rlog(f"{original_name}: pagewise pre-scan returned 0 rows; falling back to original file for review")
                    except Exception as pre_exc:
                        files.append(original)
                        rlog(f"{original_name}: pagewise pre-scan failed ({pre_exc}); falling back to original file for review")
                else:
                    files.append(original)
    except Exception as prep_exc:
        files = list(original_files)
        rlog(f"SmartScan review prep failed ({prep_exc}); using original file list")

    if not files:
        return [], ["SmartScan review: no saved attachments to review."], ""

    # v2.10.28: force the embedded copy for RFQ review. Older external SmartScan
    # paths saved in Settings can launch as the normal/empty standalone app.
    resolved = _resolve_embedded_smartscan_path()
    if not resolved or not os.path.exists(resolved):
        raise FileNotFoundError("Embedded SmartScan review app was not found.")
    json_fd, json_path = tempfile.mkstemp(prefix="mainbox_smartscan_review_", suffix=".json")
    os.close(json_fd)
    try:
        try:
            os.remove(json_path)
        except Exception:
            pass
        env = os.environ.copy()
        env["MAINBOX_SMARTSCAN_THEME_JSON"] = _mainbox_smartscan_theme_payload()
        cmd = [_smartscan_python_executable(), resolved, "--mainbox-review", *files, "--json-out", json_path]
        if progress_callback:
            try:
                progress_callback(f"SmartScan review using embedded bridge: {resolved}")
                progress_callback("SmartScan review file(s): " + "; ".join(files))
            except Exception:
                pass
        if progress_callback:
            try:
                progress_callback("Opening SmartScan review window. Correct the materials there, then click Done → Send Back to MaINbox.")
            except Exception:
                pass
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
        stdout, stderr = proc.communicate()
        if stdout and progress_callback:
            for line in stdout.splitlines()[-20:]:
                if line.strip():
                    try: progress_callback(f"SmartScan: {line.strip()}")
                    except Exception: pass
        if stderr and progress_callback:
            for line in stderr.splitlines()[-20:]:
                if line.strip():
                    try: progress_callback(f"SmartScan warning: {line.strip()}")
                    except Exception: pass
        if proc.returncode not in (0, None):
            raise RuntimeError(f"SmartScan review exited with code {proc.returncode}")
        if not os.path.exists(json_path):
            raise RuntimeError("SmartScan review did not return a result file. Use Done → Send Back to MaINbox, not the window X, when returning rows.")
        with open(json_path, "r", encoding="utf-8", errors="replace") as f:
            payload = json.load(f)
        if payload.get("cancelled"):
            return [], ["SmartScan review was cancelled by user."], payload.get("merged_text", "") or "\n".join(premerged_text_parts)
        if not payload.get("ok", False):
            raise RuntimeError(payload.get("error") or "SmartScan review returned ok=false")
        for w in payload.get("warnings", []) or []:
            if w:
                msgs.append(f"SmartScan warning: {w}")
        if payload.get("engine_summary"):
            msgs.append(f"SmartScan summary: {payload.get('engine_summary')}")
        rows = []
        for r in payload.get("rows", []) or []:
            mat = _smartscan_row_to_mainbox_material(r, source_name=os.path.basename(str(r.get("source_file_path", "") or r.get("source_file_name", "") or files[0])))
            if mat.get("description") or mat.get("part_number"):
                rows.append(mat)
        if not rows and premerged_rows:
            rows = _smartscan_cleanup_merged_material_rows(premerged_rows, progress_callback=progress_callback, source_name=source_name)
            msgs.append("SmartScan review returned 0 rows, so MaINbox kept the pagewise merged material list instead of losing the extraction.")
        else:
            rows = _smartscan_cleanup_merged_material_rows(rows, progress_callback=progress_callback, source_name=source_name)
        msgs.append(f"SmartScan review returned {len(rows)} corrected material row(s) to MaINbox.")
        merged_text = payload.get("merged_text", "") or "\n".join(premerged_text_parts)
        return rows, msgs, merged_text
    finally:
        try:
            if os.path.exists(json_path):
                os.remove(json_path)
        except Exception:
            pass



def smartscan_extract_materials_from_saved_attachment(path, source_name="", progress_callback=None):
    """Run SmartScan on one saved Outlook attachment.

    Primary path: launch SmartScan headless in its own Python process so it works
    like the standalone scanner.  Fallback path: import the module in-process only
    if the headless bridge is not available.
    """
    # Preferred seamless route: separate headless SmartScan process.
    # v3.8.02: for multipage PDFs, split first and run SmartScan on each page as
    # a single-page scan, then merge/dedupe the rows. This matches the workflow
    # that has been most accurate in standalone SmartScan.
    # NOTE: in Python 3 the name bound by "except ... as headless_exc" is deleted
    # when the except block ends, so it cannot be referenced later in this function.
    # Capture its text (and traceback) into names that survive the block.
    headless_exc_text = ""
    headless_tb = ""
    try:
        try:
            if RFQ_SMARTSCAN_PAGEWISE_PDF and _smartscan_is_multipage_document(path):
                pagewise_rows, pagewise_msgs, pagewise_text = _run_smartscan_headless_pagewise_pdf(
                    path, source_name=source_name, progress_callback=progress_callback
                )
                if pagewise_rows:
                    return pagewise_rows, pagewise_msgs, pagewise_text
                # If splitting worked but returned 0 rows, keep the messages visible before fallback.
                if pagewise_msgs:
                    try:
                        if progress_callback:
                            for _m in pagewise_msgs:
                                progress_callback(_m)
                    except Exception:
                        pass
        except Exception as pagewise_exc:
            try:
                if progress_callback:
                    progress_callback(f"{source_name}: SmartScan pagewise PDF route failed ({pagewise_exc}); trying normal SmartScan route")
            except Exception:
                pass
        return _run_smartscan_headless_subprocess(path, source_name=source_name, progress_callback=progress_callback)
    except Exception as headless_exc:
        headless_exc_text = str(headless_exc)
        try:
            headless_tb = traceback.format_exc()
        except Exception:
            pass

    messages = []
    def slog(msg):
        try:
            messages.append(str(msg))
        except Exception:
            messages.append(repr(msg))
        if progress_callback:
            try:
                progress_callback(str(msg))
            except Exception:
                pass

    slog(f"{source_name}: SmartScan headless route failed ({headless_exc_text}); trying in-process fallback.")
    if headless_tb:
        messages.append(headless_tb)

    try:
        module, resolved = _load_smartscan_module(RFQ_SMARTSCAN_PATH, log=slog)
        slog(f"{source_name}: SmartScan plugin loaded from {resolved}")
        db = module.SmartScanDB()
        try:
            settings = db.load_settings()
        except Exception:
            settings = module.ScanSettings()
        # Mainbox RFQ should use SmartScan's own smart routing, but avoid cache-stale rows.
        try:
            settings.mode = "Normal"
            settings.enable_cache = False
            settings.auto_ai_review_after_scan = True
            settings.smart_review_during_scan = True
        except Exception:
            pass
        engine = module.ScanEngine(db, settings, log=slog)
        result = engine.scan_file(path, force_rescan=True)
        raw_rows = list(getattr(result, "materials", []) or [])
        materials = []
        for r in raw_rows:
            mat = _smartscan_row_to_mainbox_material(r, source_name=source_name)
            if str(mat.get("description", "") or "").strip():
                materials.append(mat)
        materials = normalize_material_items(materials)
        merged_text = str(getattr(result, "merged_text", "") or "")
        confidence = getattr(result, "confidence", "")
        warnings = list(getattr(result, "warnings", []) or [])
        summary = str(getattr(result, "engine_summary", "") or "")
        if summary:
            messages.append(f"{source_name}: SmartScan summary: {summary}")
        if confidence != "":
            messages.append(f"{source_name}: SmartScan confidence: {confidence}")
        for w in warnings[:12]:
            messages.append(f"{source_name}: SmartScan warning: {w}")
        messages.append(f"{source_name}: SmartScan extracted {len(materials)} material row(s)")
        return materials, messages, merged_text
    except Exception as exc:
        messages.append(f"{source_name}: SmartScan unavailable/failed ({exc})")
        try:
            messages.append(traceback.format_exc())
        except Exception:
            pass
        return [], messages, ""



def classify_category(subject, body=""):
    text = f"{subject} {body}".lower()
    for category, words in KEYWORDS.items():
        if any(word in text for word in words):
            return category
    return "General"


def classify_urgency(subject, body=""):
    text = f"{subject} {body}".lower()
    for urgency, words in URGENT_KEYWORDS.items():
        if any(word in text for word in words):
            return urgency
    return "Normal"


def connect_outlook(show_error=True):
    """Connect to Outlook using dynamic COM dispatch.

    Important: do NOT use win32com.client.gencache.EnsureDispatch here.
    On some Windows/Office installs the generated win32com cache can become stale
    and raise errors like:
        module 'win32com.gen_py...x96' has no attribute 'CLSIDToPackageMap'

    Dynamic Dispatch avoids that broken generated-cache path and is more reliable
    for MaINbox, especially inside the old-email purchase-history scanner.
    """
    try:
        if pythoncom:
            try:
                pythoncom.CoInitialize()
            except Exception:
                pass
        outlook = win32com.client.Dispatch("Outlook.Application")
        namespace = outlook.GetNamespace("MAPI")
        return outlook, namespace
    except Exception as e:
        if show_error:
            messagebox.showerror(
                "Outlook Error",
                f"Could not connect to Outlook.\n\nMake sure Outlook desktop is open.\n\n{e}"
            )
        return None, None


def get_greeting():
    return "Good morning" if datetime.now().hour < 12 else "Good afternoon"


def html_escape_basic(text):
    return (
        text.replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace("\n", "<br>")
    )


def parse_followup_time(raw):
    """Parse either a clock time or a relative follow-up delay.

    Supported examples:
    - 3:00 PM, 3 PM, 14:30
    - in 1 minute, 1 min, 15 minutes, 2 hours
    - for quick testing only, a bare number 1-5 means minutes
    """
    raw = (raw or "").strip()
    if not raw:
        return None

    now = datetime.now()
    lowered = raw.lower().strip()

    # Relative delays: "in 1 minute", "1 min", "15 minutes", "2 hours".
    m = re.match(r"^(?:in\s+)?(\d+)\s*(m|min|mins|minute|minutes|h|hr|hrs|hour|hours)$", lowered)
    if m:
        qty = int(m.group(1))
        unit = m.group(2)
        if unit.startswith("h"):
            return now + timedelta(hours=qty)
        return now + timedelta(minutes=qty)

    # Friendly dropdown values: "Tomorrow 9 AM" / "Tomorrow 3:00 PM".
    tm = re.match(r"^tomorrow\s+(.+)$", lowered)
    if tm:
        inner = tm.group(1).strip()
        for fmt in ["%I:%M %p", "%I %p", "%H:%M", "%H"]:
            try:
                parsed_time = datetime.strptime(inner.upper(), fmt).time()
                return datetime.combine(now.date() + timedelta(days=1), parsed_time)
            except Exception:
                pass

    # Convenience: if the user types only a number, treat it as minutes.
    # This makes quick tests like "1" = 1 minute work reliably.
    if lowered.isdigit():
        qty = int(lowered)
        if qty > 0:
            return now + timedelta(minutes=qty)

    for fmt in ["%I:%M %p", "%I %p", "%H:%M", "%H"]:
        try:
            parsed_time = datetime.strptime(raw.upper(), fmt).time()
            target = datetime.combine(now.date(), parsed_time)
            if target <= now:
                target += timedelta(days=1)
            return target
        except Exception:
            pass
    return None


