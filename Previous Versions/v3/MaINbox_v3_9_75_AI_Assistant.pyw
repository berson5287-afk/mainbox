def _strip_reply_boilerplate_for_intent(text):
    """Remove common signatures/quoted-history so a short acknowledgement is not missed."""
    raw = str(text or "").replace("\r", "\n")
    cut_markers = [
        "-----original message-----", "from:", "sent:", "to:", "subject:",
        "________________________________", "on ", " wrote:", "confidentiality notice",
        "this e-mail and any attachments", "this email and any attachments",
        "please consider the environment", "unsubscribe",
    ]
    lines = []
    for line in raw.split("\n"):
        lower = line.strip().lower()
        if lower.startswith("--") or lower in ("sent from my iphone", "sent from my ipad"):
            break
        if any(marker in lower for marker in cut_markers[:9]) and len(lines) >= 1:
            break
        lines.append(line)
        if len(lines) >= 20:
            break
    cleaned = " ".join(lines)
    cleaned = re.sub(r"<[^>]+>", " ", cleaned)
    cleaned = re.sub(r"\s+", " ", cleaned).strip()
    return cleaned

def detect_lost_deal(text):
    """Did the customer DECLINE / walk away -- the quote is LOST (done, so archive)?
    Returns (is_lost, phrase, level).

    This is deliberately separate from a bare 'thanks' (which often just means
    'received, still deciding'). Every phrase here signals NOT proceeding.
      - level 'high': an unmistakable walk-away ("thanks anyway", "went with
        another", "found it elsewhere", "project cancelled") -> auto-archive
        eligible, like a cancellation.
      - level 'soft': a likely-but-not-certain brush-off ("not at this time",
        "keep you on file", "on hold") -> ALWAYS held for the user's review,
        never auto-archived, so an ambiguous pause can't silently disappear."""
    t = (text or "").lower()
    high = [
        # polite declination -- "...thanks anyway", "no thank you"
        r"\bthank(?:s|\s*you|\s*u)?\s+anyways?\b",
        r"\bappreciate(?:\s+it|d)?\s+anyways?\b",
        r"\bthanks?\s+for\s+(?:trying|checking|your\s+time|the\s+(?:effort|offer))\b",
        r"\bno\s+thank(?:s|\s*you)\b",
        # went elsewhere / chose another source
        r"\b(?:we|i)\s+(?:went|'?re\s+going|are\s+going|decided\s+to\s+go|will\s+go|have\s+gone)\s+(?:with|in)\s+(?:another|a\s+different|someone|somebody|the\s+other|a\s+competitor)\b",
        r"\bgoing\s+(?:with|in)\s+(?:another|a\s+different)\s+(?:direction|supplier|vendor|source|route|company)\b",
        r"\b(?:found|got|sourced|secured|bought|ordered|purchased|sourcing|buying|getting)\s+(?:it|them|this|these)?\s*(?:elsewhere|somewhere\s+else)\b",
        r"\b(?:with|from|using|chose|chosen|selected|went\s+with)\s+(?:another|a\s+different|the\s+other|a\s+competing)\s+(?:supplier|vendor|source|company|distributor)\b",
        r"\bdecided\s+to\s+(?:go\s+with|use|order\s+from|buy\s+from)\s+(?:another|a\s+different|someone|somebody)\b",
        # pass / not proceeding
        r"\bpass\s+on\s+(?:this|that|it)\b(?!\s+(?:to|along))",
        r"\b(?:we|i)\s+(?:'?ll|will|have\s+to|'?re\s+going\s+to|are\s+going\s+to|gonna)\s+(?:have\s+to\s+)?pass\b(?!\s+(?:it|this|that|along)\b)",
        r"\b(?:going\s+to|gonna|have\s+to)\s+pass\b(?!\s+(?:it|this|that|along)\b)",
        r"\b(?:not|won'?t|will\s+not)\s+(?:be\s+)?(?:moving|going)\s+forward\b",
        r"\bdecided\s+(?:not\s+to\b|against\b)",
        r"\bnot\s+(?:going\s+to\s+)?proceed(?:ing)?\b",
        r"\bno\s+longer\s+(?:interested|need|require)\b",
        # project dead
        r"\b(?:project|job|order|bid)\s+(?:was\s+|got\s+|is\s+|has\s+been\s+)?(?:cancel?led|killed|scrapped|shelved|pulled)\b",
        r"\b(?:project|job|deal|it)\s+(?:fell|has\s+fallen)\s+through\b",
    ]
    soft = [
        r"\bnot\s+(?:at\s+)?(?:this|that)\s+time\b",
        r"\bmaybe\s+(?:next|another)\s+time\b",
        r"\bkeep\s+(?:you|your\s+(?:info|number|quote|pricing|information|company))\s+(?:in\s+mind|on\s+file)\b",
        r"\bwe(?:'?ll|\s+will)\s+(?:reach\s+out|let\s+you\s+know|be\s+in\s+touch|circle\s+back)\s+(?:if|when|should|once)\b",
        r"\b(?:project|job|this|it|order)\s+(?:is\s+)?on\s+hold\b",
        r"\bput(?:ting)?\s+(?:this|it|the\s+\w+)\s+on\s+hold\b",
        r"\bhold\s+off\b",
    ]
    for pat in high:
        m = re.search(pat, t)
        if m:
            return True, m.group(0).strip(), "high"
    for pat in soft:
        m = re.search(pat, t)
        if m:
            return True, m.group(0).strip(), "soft"
    return False, "", ""


def detect_won_order(text, email_type=""):
    """Did the customer PLACE the order / hand over a PO -- i.e. the quote is WON
    (done)? Returns (is_won, phrase).

    Strong signals -- a release/deliver directive, an explicit 'here is the PO',
    or a PO number paired with a go-ahead word -- are treated as won REGARDLESS of
    email_type. A vendor does not hand YOU a PO and tell you to "release and deliver
    to <site>"; that is a customer ordering, even if the row is mis-tagged 'V'. Only
    a bare 'good to go' (no PO / no release) is weak enough to suppress on a
    vendor-typed row, where it usually just means the vendor's side is ready."""
    t = (text or "").lower()
    strong = [
        r"\brelease\s+and\s+deliver\b",
        r"\bplease\s+release\b(?!\s+(?:me|us|time|date)\b)",
        r"\brelease\s+the\s+order\b",
        r"\bplace\s+the\s+order\b",
        r"\bgo\s+ahead\s+(?:and\s+)?(?:order|place|proceed|ship|release)\b",
        r"\bproceed\s+with\s+(?:the\s+)?order\b",
        r"\b(?:here\s+(?:is|are)|attached\s+(?:is|are|find)?)\s+(?:the\s+)?(?:po|p\.o\.|purchase\s+order)\b",
        r"\b(?:po|p\.o\.|purchase\s+order)\s+(?:is\s+)?attached\b",
    ]
    for pat in strong:
        m = re.search(pat, t)
        if m:
            return True, m.group(0).strip()
    # A provided PO number ("PO - 707", "PO#707") paired with a go-ahead/release word
    # in the same message. The go-ahead requirement keeps "please send your PO 707"
    # or "is PO 707 ready" from counting as a won order.
    po = re.search(r"\b(?:po|p\.o\.|purchase\s+order)\s*[#:\-]?\s*\d{2,}\b", t)
    if po and re.search(r"\b(?:good\s+to\s+go|release|deliver|proceed|go\s+ahead|ship|approved)\b", t):
        return True, po.group(0).strip()
    # Weaker, vendor-guarded: a bare "good to go" with no PO / release directive.
    if str(email_type or "").upper() != "V":
        for pat in (r"\bgood\s+to\s+go\b",
                    r"\byou(?:'?re|\s+are)\s+good\s+to\s+(?:go|proceed|order|ship)\b",
                    r"\byou\s+(?:can|may)\s+(?:proceed|release|ship)\b"):
            m = re.search(pat, t)
            if m:
                return True, m.group(0).strip()
    return False, ""


def llm_classify_deal_status(subject, body, timeout=20):
    """Semantic fallback for closing intent when NO pattern matched. Asks the local
    model to classify ONE email's effect on an open quote as WON / LOST / OPEN, and
    returns 'won', 'lost', or '' (OPEN / unknown / unavailable).

    This is the answer to 'phrases we did not anticipate': the pattern lists handle
    the common, confident cases fast; this catches the long tail semantically. It is
    fully guarded -- any error, timeout, or disabled Ollama yields '' (no action) --
    and its hits are surfaced for the user's review only, never auto-archived."""
    if not OLLAMA_ENABLED:
        return ""
    b = (body or "").strip()
    if not b:
        return ""
    if len(b) > 1200:
        b = b[:1200]
    prompt = (
        "You are classifying ONE email's effect on an open sales quote/RFQ between a "
        "distributor and a customer. Reply with EXACTLY ONE word and nothing else.\n"
        "WON = the customer is placing the order, gave a PO, or told us to proceed/ship.\n"
        "LOST = the customer is declining, cancelling, passing, going with someone else, "
        "or no longer needs it.\n"
        "OPEN = anything else: a question, a request, pricing negotiation, still reviewing, or unclear.\n\n"
        f"Subject: {subject or ''}\n"
        f"Body: {b}\n\n"
        "One word (WON, LOST, or OPEN):"
    )
    payload = {
        "model": ai_model_for_task("triage"),
        "prompt": prompt,
        "stream": False,
        "keep_alive": AI_KEEP_ALIVE,
        "options": {"temperature": 0.0, "num_predict": 4, "num_ctx": AI_NUM_CTX, "top_k": 5, "top_p": 0.5},
    }
    try:
        data = json.dumps(payload).encode("utf-8")
        with ollama_open(data, task="triage", timeout=timeout) as response:
            raw = response.read().decode("utf-8")
        result = json.loads(raw)
        ans = str(result.get("response") or "").strip().lower()
        if "lost" in ans:
            return "lost"
        if "won" in ans:
            return "won"
    except Exception:
        return ""
    return ""


def analyze_reply_intent(subject="", body="", sender_or_recipient="", source="", direction="inbound"):
    """Return a compact non-AI intent for reply/followup decisions.

    intent values:
      - closed_ack: simple thank-you/acknowledgement; do not create waiting tracker
      - waiting_on_vendor: vendor/supplier says they will get back to us
      - waiting_on_customer: customer says PO/approval/info is pending
      - needs_reply: asks us for info/confirmation
      - business_request: quote/pricing/request language
      - unknown: no strong signal
    """
    subject = str(subject or "")
    body_clean = _strip_reply_boilerplate_for_intent(body)
    combined = f"{subject} {body_clean} {sender_or_recipient or ''} {source or ''}"
    combined_l = re.sub(r"\s+", " ", combined.lower()).strip()
    body_l = body_clean.lower().strip()

    result = {
        "intent": "unknown",
        "status": "",
        "category": "",
        "is_closed_ack": False,
        "is_waiting": False,
        "needs_tracker": False,
        "matched": [],
        "reason": "No strong reply intent phrase matched.",
    }
    if not combined_l:
        return result

    # WON ORDER FIRST: a placed order / provided PO ("release and deliver", "here is
    # the PO", "PO 707 ... go ahead") means the quote is DONE -- not "waiting on the
    # customer to send a PO later". This must be decided BEFORE the generic PO/order
    # phrase below (which otherwise flips any PO mention to Waiting on Customer and
    # keeps a won, closed thread alive). Strong signals are type-agnostic.
    _won, _won_phrase = detect_won_order(combined_l)
    if _won:
        result.update({
            "intent": "won_order",
            "status": "Completed",
            "category": "Quote / Estimate",
            "is_closed_ack": True,
            "needs_tracker": False,
            "matched": [_won_phrase],
            "reason": "Order placed / PO provided -> quote won (complete).",
        })
        return result

    # Important business/request terms override a casual thanks in the same message.
    request_terms = [
        "please quote", "need pricing", "need a quote", "can you quote", "request for quote", "rfq",
        "price and availability", "p&a", "please provide", "can you provide", "lead time",
        "attached", "attachment", "po", "purchase order", "order", "change order", "revise", "revision",
        "please confirm", "can you confirm", "need more information", "need additional information",
    ]
    has_request = contains_any_phrase(combined_l, request_terms)

    # Strong one-line acknowledgements should close the loop and avoid sent/waiting trackers.
    short_body = re.sub(r"[^a-z0-9 ]+", " ", body_l)
    short_body = re.sub(r"\s+", " ", short_body).strip()
    if not has_request:
        for pattern in REPLY_CLOSED_STRONG_PATTERNS:
            if re.search(pattern, body_l, flags=re.I) or re.search(pattern, combined_l, flags=re.I):
                result.update({
                    "intent": "closed_ack",
                    "status": "Completed",
                    "is_closed_ack": True,
                    "needs_tracker": False,
                    "matched": [pattern],
                    "reason": "Simple acknowledgement/thanks reply detected.",
                })
                return result
        matched_closed = matched_phrases(combined_l, REPLY_CLOSED_PHRASES, max_items=8)
        word_count = len(short_body.split()) if short_body else len(combined_l.split())
        if matched_closed and word_count <= 45 and not contains_any_phrase(combined_l, REPLY_WAITING_PHRASES):
            result.update({
                "intent": "closed_ack",
                "status": "Completed",
                "is_closed_ack": True,
                "needs_tracker": False,
                "matched": matched_closed,
                "reason": "Short acknowledgement/closed reply phrase detected.",
            })
            return result

    matched_vendor_wait = matched_phrases(combined_l, VENDOR_WAITING_PHRASES, max_items=8)
    if matched_vendor_wait:
        result.update({
            "intent": "waiting_on_vendor",
            "status": "Waiting on Vendor",
            "category": "Vendor / Supplier",
            "is_waiting": True,
            "needs_tracker": True,
            "matched": matched_vendor_wait,
            "reason": "Vendor/supplier waiting phrase detected.",
        })
        return result

    matched_customer_wait = matched_phrases(combined_l, CUSTOMER_WAITING_PHRASES, max_items=8)
    if matched_customer_wait or text_mentions_po_or_order(combined_l):
        result.update({
            "intent": "waiting_on_customer",
            "status": "Waiting on Customer",
            "category": "Quote / Estimate",
            "is_waiting": True,
            "needs_tracker": True,
            "matched": matched_customer_wait or ["po/order/approval"],
            "reason": "Customer waiting/PO/approval phrase detected.",
        })
        return result

    matched_needs = matched_phrases(combined_l, VENDOR_NEEDS_US_PHRASES, max_items=8)
    if matched_needs:
        result.update({
            "intent": "needs_reply",
            "status": "Needs Reply",
            "category": "Vendor / Supplier",
            "needs_tracker": False,
            "matched": matched_needs,
            "reason": "Reply asks us for confirmation or more information.",
        })
        return result

    if has_request:
        matched_req = matched_phrases(combined_l, request_terms, max_items=8)
        result.update({
            "intent": "business_request",
            "status": "Needs Reply",
            "needs_tracker": True,
            "matched": matched_req,
            "reason": "Business/request phrase detected.",
        })
    return result

FYI_DONE_PHRASES = [
    "for your records", "no action required", "fyi", "for your information", "confirmation only",
    "receipt", "payment received", "delivery confirmation", "meeting accepted", "calendar invite"
]


_NORMALIZE_SUBJECT_CACHE = {}
_NORMALIZE_SUBJECT_CACHE_MAX = 8192


def normalize_subject_for_match(subject):
    """Normalize subjects so RE:/FW: and spacing do not prevent related-email matching.

    v3.9.27 efficiency: memoized. This runs three regex passes and is called inside
    the tracker sweep's inner matching loops, dedupe, and grouping -- the same few
    thousand subjects over and over. The cache is bounded and reset wholesale when full.
    """
    key = subject or ""
    cached = _NORMALIZE_SUBJECT_CACHE.get(key)
    if cached is not None:
        return cached
    text = key.strip().lower()
    changed = True
    while changed:
        changed = False
        for prefix in ["re:", "fw:", "fwd:", "external:"]:
            if text.startswith(prefix):
                text = text[len(prefix):].strip()
                changed = True
    text = re.sub(r"\[[^\]]{1,40}\]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    if len(_NORMALIZE_SUBJECT_CACHE) >= _NORMALIZE_SUBJECT_CACHE_MAX:
        _NORMALIZE_SUBJECT_CACHE.clear()
    _NORMALIZE_SUBJECT_CACHE[key] = text
    return text


def contains_any_phrase(text, phrases):
    text = (text or "").lower()
    return any(phrase in text for phrase in phrases)


def matched_phrases(text, phrases, max_items=5):
    text = (text or "").lower()
    return [phrase for phrase in phrases if phrase in text][:max_items]


def sender_looks_automated(sender_text):
    sender_text = (sender_text or "").lower()
    compact = sender_text.replace(" ", "").replace("_", "-")
    return any(hint in compact for hint in AUTOMATED_SENDER_HINTS)


def extract_email_address(value):
    """Best-effort email extraction from Outlook sender strings."""
    value = (value or "").strip()
    if not value:
        return ""
    match = re.search(r"[A-Z0-9._%+\-]+@[A-Z0-9.\-]+\.[A-Z]{2,}", value, flags=re.I)
    return match.group(0).lower() if match else value.lower()


def get_email_domain(value):
    email = extract_email_address(value)
    if "@" not in email:
        return ""
    return email.split("@", 1)[1].lower().strip()


def learning_subject_key(subject):
    return normalize_subject_for_match(subject or "")


# v3 Group Sorting Upgrade: project/job identifiers used for safer auto-grouping.
# Keep this local and conservative: it only strengthens grouping when a clear
# business key exists, and avoids broad sender/domain-only grouping.
GENERIC_GROUP_SUBJECTS = {
    "quote", "quote request", "rfq", "request for quote", "p&a", "p and a",
    "price and availability", "price & availability", "pricing", "estimate",
    "proposal", "order", "purchase order", "po", "re quote", "fw quote",
}


def _compact_group_token(value):
    return re.sub(r"[^a-z0-9]", "", str(value or "").lower())


def is_generic_group_subject(subject):
    text = normalize_subject_for_match(subject or "")
    text = re.sub(r"[^a-z0-9&/ -]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    if not text:
        return True
    if text in GENERIC_GROUP_SUBJECTS:
        return True
    words = [w for w in re.split(r"\s+", text) if w]
    if len(words) <= 3 and any(g in text for g in ["quote", "rfq", "p&a", "pricing", "estimate", "proposal"]):
        return True
    return False


def extract_group_match_tokens(text):
    """Extract conservative job/PO/project tokens for grouping.

    These tokens are intentionally stricter than fuzzy subject matching. They
    catch examples like C&D-156B, 156B, 750AL, Harrand 25155, PO 26-091, etc.,
    while avoiding generic subjects such as just 'Quote Request'.
    """
    raw = str(text or "")
    if not raw:
        return set()
    upper = raw.upper()
    tokens = set()

    # Keyword-anchored codes (PO 26-091, SO 12345, JOB 4471, etc.). The keyword must be a whole
    # word -- (?![A-Z]) stops it matching inside ordinary words like SOlutions / ORDERs / REFer --
    # and the captured value must contain a digit, so plain prose ("Order Charge", "below") is not
    # mistaken for a job/PO code.
    for m in re.finditer(
        r"\b(?:PO|P\.?O\.?|QUOTE|QUOTATION|RFQ|JOB|PROJECT|ORDER|SO|SALES\s+ORDER|REF)"
        r"(?![A-Z])\s*(?:#|NO\.?|NUMBER|:|-)?\s*([A-Z0-9][A-Z0-9 &./_-]{2,24})",
        upper, flags=re.I,
    ):
        val = m.group(1)
        if not any(ch.isdigit() for ch in val):
            continue
        # The greedy capture can swallow trailing prose ("SO 12345 Solutions" -> "12345 SOLUTIONS").
        # Keep only the leading code run: once a digit-bearing word has ended, drop any following
        # alpha-only words so the token is "12345", not "12345solutions". Alpha suffixes fused into a
        # digit word (e.g. 750AL, 26-091) are preserved because they still carry a digit.
        words = val.split()
        kept = []
        seen_digit = False
        for w in words:
            has_digit = any(ch.isdigit() for ch in w)
            if seen_digit and not has_digit:
                break
            kept.append(w)
            if has_digit:
                seen_digit = True
        val = " ".join(kept)
        compact = _compact_group_token(val)
        if len(compact) >= 3 and compact not in {"quote", "rfq", "order", "project", "job", "po"}:
            tokens.add(compact)

    patterns = [
        r"\b([A-Z]{1,6}\s*[&-]\s*[A-Z0-9]{2,}(?:\s*[-/]\s*[A-Z0-9]{2,})?)\b",
        r"\b(\d{2,6}\s*[-/]\s*[A-Z0-9]{2,8})\b",
        r"\b([A-Z]{1,4}\d{2,6}[A-Z0-9]{0,4})\b",
        r"\b(\d{2,6}[A-Z]{1,4})\b",
    ]
    for pat in patterns:
        for m in re.finditer(pat, upper, flags=re.I):
            val = m.group(1) if m.groups() else m.group(0)
            compact = _compact_group_token(val)
            if len(compact) >= 3 and compact not in {"quote", "rfq", "order", "project", "job", "po"}:
                tokens.add(compact)

    # If a name/project word sits next to a real number/code, keep the combined
    # signature as a stronger token (ex: HARRAND 25155, EDENWALD 750AL).
    for m in re.finditer(r"\b([A-Z][A-Z0-9]{2,})\s+([0-9]{2,6}[A-Z]{0,4}|[A-Z]{0,3}[0-9]{2,6}[A-Z]{0,4})\b", upper):
        # Skip date-like phrases ("March 2025", "May 14") -- a month name beside a number is not a
        # job/project signature.
        if m.group(1).lower() in _MONTHS:
            continue
        combined = _compact_group_token(m.group(1) + m.group(2))
        if len(combined) >= 5:
            tokens.add(combined)

    return tokens


def quick_sender_intent_analysis(subject, sender, body="", related_count=0, source=""):
    """Fast non-AI triage context used to prevent spam followups and help Ollama sort accurately."""
    subject = subject or ""
    sender = sender or ""
    body = body or ""
    source = source or ""
    combined = f"{subject}\n{sender}\n{body}"
    combined_l = combined.lower()
    reasons = []
    matched = []

    result = {
        "sender_type": "unknown",
        "sender_intent": "unclear",
        "workflow_category": "General",
        "urgency": "Normal",
        "status": "Needs Reply",
        "business_relevance": 0.55,
        "spam_likelihood": 0.10,
        "needs_followup": False,
        "followup_reason": "",
        "same_subject_related_count": int(related_count or 0),
        "reason": "Incoming message defaults to Needs Reply unless rules or AI show otherwise.",
        "hard_decision": False,
    }

    if related_count:
        reasons.append(f"Found {related_count} cached email(s) with the same normalized subject, so this is likely related to an existing thread/job.")

    spam_signal = sender_looks_automated(sender) or contains_any_phrase(combined_l, SPAM_OR_MARKETING_PHRASES)
    strong_spam_signal = sender_looks_automated(sender) and contains_any_phrase(combined_l, STRONG_SPAM_PHRASES)
    if spam_signal and (not related_count or strong_spam_signal):
        matched = matched_phrases(combined_l, SPAM_OR_MARKETING_PHRASES)
        result.update({
            "sender_type": "automated_or_marketing",
            "sender_intent": "newsletter/spam/system notification",
            "workflow_category": "Junk / Ignore",
            "urgency": "Low",
            "status": "Completed",
            "business_relevance": 0.05,
            "spam_likelihood": 0.92,
            "needs_followup": False,
            "followup_reason": "Blocked: automated/marketing/spam-like message.",
            "hard_decision": True,
            "reason": "Pre-AI spam/system filter matched sender or marketing language" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if spam_signal and related_count:
        matched = matched_phrases(combined_l, SPAM_OR_MARKETING_PHRASES)
        result.update({
            "sender_type": "unknown",
            "sender_intent": "possibly automated, but protected because exact subject matches existing work",
            "workflow_category": "General",
            "urgency": "Normal",
            "status": "Needs Reply",
            "business_relevance": 0.74,
            "spam_likelihood": 0.24,
            "needs_followup": False,
            "followup_reason": "Same-subject project protection blocked junk downgrade.",
            "hard_decision": False,
            "reason": "Spam-like language found, but exact same subject already exists in cache, so do not auto-junk unless AI has strong evidence" + (f": {', '.join(matched)}" if matched else "."),
        })

    if contains_any_phrase(combined_l, VENDOR_QUOTE_REPLY_PHRASES):
        matched = matched_phrases(combined_l, VENDOR_QUOTE_REPLY_PHRASES)
        result.update({
            "sender_type": "vendor_or_supplier",
            "sender_intent": "vendor sent quote/pricing/lead time",
            "workflow_category": "Vendor / Supplier",
            "urgency": "Normal",
            "status": "Needs Reply",
            "business_relevance": 0.93,
            "spam_likelihood": 0.03,
            "needs_followup": False,
            "followup_reason": "Vendor replied with quote/pricing; user likely needs to review/respond or update customer, not wait on vendor.",
            "reason": "Vendor quote/pricing phrase matched" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if contains_any_phrase(combined_l, VENDOR_STATUS_REPLY_PHRASES):
        matched = matched_phrases(combined_l, VENDOR_STATUS_REPLY_PHRASES)
        result.update({
            "sender_type": "vendor_or_supplier",
            "sender_intent": "vendor sent status/shipping/order update",
            "workflow_category": "Vendor / Supplier",
            "urgency": "Normal",
            "status": "Needs Reply",
            "business_relevance": 0.82,
            "spam_likelihood": 0.08,
            "needs_followup": False,
            "followup_reason": "Vendor update received; user may need to pass info along or review.",
            "reason": "Vendor status phrase matched" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if contains_any_phrase(combined_l, VENDOR_WAITING_PHRASES):
        matched = matched_phrases(combined_l, VENDOR_WAITING_PHRASES)
        result.update({
            "sender_type": "vendor_or_supplier",
            "sender_intent": "vendor says they will get back with pricing/status/info",
            "workflow_category": "Vendor / Supplier",
            "urgency": "Normal",
            "status": "Waiting on Vendor",
            "business_relevance": 0.90,
            "spam_likelihood": 0.03,
            "needs_followup": True,
            "followup_reason": "Vendor indicated pricing/status/info is pending from them.",
            "reason": "Vendor waiting phrase matched" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if contains_any_phrase(combined_l, VENDOR_NEEDS_US_PHRASES):
        matched = matched_phrases(combined_l, VENDOR_NEEDS_US_PHRASES)
        result.update({
            "sender_type": "vendor_or_supplier",
            "sender_intent": "vendor needs information/confirmation from us",
            "workflow_category": "Vendor / Supplier",
            "urgency": "Normal",
            "status": "Needs Reply",
            "business_relevance": 0.88,
            "spam_likelihood": 0.04,
            "needs_followup": False,
            "followup_reason": "Vendor is asking us for information; this needs our reply.",
            "reason": "Vendor request phrase matched" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if contains_any_phrase(combined_l, CUSTOMER_WAITING_PHRASES) or text_mentions_po_or_order(combined_l):
        matched = matched_phrases(combined_l, CUSTOMER_WAITING_PHRASES)
        result.update({
            "sender_type": "customer_or_prospect",
            "sender_intent": "customer says they will send PO/approval/info later",
            "workflow_category": "Quote / Estimate",
            "urgency": "Normal",
            "status": "Waiting on Customer",
            "business_relevance": 0.90,
            "spam_likelihood": 0.02,
            "needs_followup": True,
            "followup_reason": "Customer indicated PO/order/approval/details are pending.",
            "reason": "Customer waiting/PO phrase matched" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if contains_any_phrase(combined_l, CUSTOMER_REQUEST_PHRASES):
        matched = matched_phrases(combined_l, CUSTOMER_REQUEST_PHRASES)
        result.update({
            "sender_type": "customer_or_prospect",
            "sender_intent": "customer is requesting pricing/help/availability",
            "workflow_category": "Quote / Estimate",
            "urgency": "Normal",
            "status": "Needs Reply",
            "business_relevance": 0.91,
            "spam_likelihood": 0.03,
            "needs_followup": False,
            "followup_reason": "Incoming customer request needs our reply first.",
            "reason": "Customer request phrase matched" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if contains_any_phrase(combined_l, FYI_DONE_PHRASES):
        matched = matched_phrases(combined_l, FYI_DONE_PHRASES)
        result.update({
            "sender_type": "system_or_informational",
            "sender_intent": "informational/no action likely",
            "workflow_category": "General",
            "urgency": "Low",
            "status": "Completed",
            "business_relevance": 0.35,
            "spam_likelihood": 0.20,
            "needs_followup": False,
            "followup_reason": "Informational/no-action phrase detected.",
            "reason": "FYI/completed phrase matched" + (f": {', '.join(matched)}" if matched else "."),
        })
        return result

    if related_count:
        result["business_relevance"] = max(result["business_relevance"], 0.70)
        result["reason"] = "Same-subject relationship found; defaulting to business-relevant Needs Reply unless AI finds stronger evidence."

    return result


def should_allow_followup_decision(email, triage_result=None, quick_result=None):
    """Final safety gate so spam/general/FYI emails do not get automatic follow-ups."""
    triage_result = triage_result or {}
    quick_result = quick_result or {}
    category = (email or {}).get("category") or triage_result.get("workflow_category") or quick_result.get("workflow_category") or "General"
    if category in NO_FOLLOWUP_CATEGORIES or category not in FOLLOWUP_ALLOWED_CATEGORIES:
        return False, f"Blocked follow-up: category {category} is not eligible."
    try:
        business_relevance = float(triage_result.get("business_relevance", quick_result.get("business_relevance", 0.0)) or 0.0)
    except Exception:
        business_relevance = 0.0
    try:
        spam_likelihood = float(triage_result.get("spam_likelihood", quick_result.get("spam_likelihood", 1.0)) or 1.0)
    except Exception:
        spam_likelihood = 1.0
    wants_followup = bool(triage_result.get("needs_followup", quick_result.get("needs_followup", False)))
    if not wants_followup:
        return False, "Blocked follow-up: triage did not mark it follow-up-worthy."
    if business_relevance < MIN_BUSINESS_RELEVANCE_FOR_FOLLOWUP:
        return False, f"Blocked follow-up: business relevance {business_relevance:.2f} is too low."
    if spam_likelihood > MAX_SPAM_LIKELIHOOD_FOR_FOLLOWUP:
        return False, f"Blocked follow-up: spam likelihood {spam_likelihood:.2f} is too high."
    return True, "Follow-up allowed by business relevance gate."



def get_mainbox_device_id():
    """Stable local device id used by the optional MaINbox Cloud Bridge."""
    try:
        init_mainbox_db()
        with sqlite3.connect(MAINBOX_DB_FILE) as conn:
            row = conn.execute("SELECT meta_value FROM db_meta WHERE meta_key=?", ("cloud_device_id",)).fetchone()
            if row and row[0]:
                return row[0]
            device_id = str(uuid.uuid4())
            conn.execute(
                "INSERT OR REPLACE INTO db_meta(meta_key, meta_value, updated_at) VALUES (?, ?, ?)",
                ("cloud_device_id", device_id, datetime.now().isoformat()),
            )
            conn.commit()
            return device_id
    except Exception:
        fallback_file = data_path("mainbox_device_id.txt")
        try:
            if os.path.exists(fallback_file):
                with open(fallback_file, "r", encoding="utf-8") as f:
                    val = f.read().strip()
                if val:
                    return val
            val = str(uuid.uuid4())
            with open(fallback_file, "w", encoding="utf-8") as f:
                f.write(val)
            return val
        except Exception:
            return "mainbox-device"


