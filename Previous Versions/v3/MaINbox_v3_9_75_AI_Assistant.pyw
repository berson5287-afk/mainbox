def _mainbox_mix_white(widget, color, t=0.18):
    """Blend a color toward white by t (0..1). Used for a consistent, visible
    hover lift that works on any base color (dark gray buttons or the accent)."""
    try:
        r, g, b = (c >> 8 for c in widget.winfo_rgb(color))
    except Exception:
        return color
    r = int(r + (255 - r) * t)
    g = int(g + (255 - g) * t)
    b = int(b + (255 - b) * t)
    return "#%02x%02x%02x" % (max(0, min(255, r)), max(0, min(255, g)), max(0, min(255, b)))


def _mainbox_mix(widget, color_a, color_b, t=0.5):
    """Blend color_a toward color_b by t (0..1). Used for soft accent tints that
    auto-adapt to light/dark themes."""
    try:
        ar, ag, ab = (c >> 8 for c in widget.winfo_rgb(color_a))
        br, bg, bb = (c >> 8 for c in widget.winfo_rgb(color_b))
    except Exception:
        return color_a
    r = int(ar + (br - ar) * t)
    g = int(ag + (bg - ag) * t)
    b = int(ab + (bb - ab) * t)
    return "#%02x%02x%02x" % (max(0, min(255, r)), max(0, min(255, g)), max(0, min(255, b)))


def _mainbox_btn_enter(event):
    w = event.widget
    try:
        if getattr(w, "_mainbox_hovering", False):
            return
        if str(w.cget("state")) == "disabled":
            return
        w._mainbox_orig_bg = w.cget("background")
        w._mainbox_hovering = True
        w.configure(background=_mainbox_mix_white(w, w._mainbox_orig_bg, 0.10))
    except Exception:
        pass


def _mainbox_btn_leave(event):
    w = event.widget
    try:
        if getattr(w, "_mainbox_orig_bg", None) is not None:
            w.configure(background=w._mainbox_orig_bg)
        w._mainbox_hovering = False
    except Exception:
        pass


def _install_button_hover(widget):
    """Install a hover lift on EVERY classic tk.Button across the whole app
    (current and future windows) via a single class-level binding. ttk buttons
    already hover through style.map, so this targets the 'Button' widget class."""
    global _BUTTON_HOVER_INSTALLED
    if _BUTTON_HOVER_INSTALLED:
        return
    try:
        widget.bind_class("Button", "<Enter>", _mainbox_btn_enter, add="+")
        widget.bind_class("Button", "<Leave>", _mainbox_btn_leave, add="+")
        _BUTTON_HOVER_INSTALLED = True
    except Exception:
        pass


