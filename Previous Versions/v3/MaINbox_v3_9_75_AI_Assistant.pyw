    def get_row_tag(self, email):
        if email.get("is_new_import"):
            return "new_import"
        urgency = email["urgency"]
        status = email["status"]
        if urgency == "Low":
            urgency = "Normal"
        if status == "Needs Reply":
            status_key = "needs_reply"
        elif status in ["Waiting on Customer", "Waiting on Vendor"]:
            status_key = "waiting"
        elif status == "Completed":
            status_key = "completed"
        else:
            status_key = "normal"
        return f"{urgency.lower()}_{status_key}"

    def get_importance_rank(self, email):
        urgency = email.get("urgency", "Normal")
        status = email.get("status", "New")
        if urgency == "Critical":
            return 0
        if urgency == "High":
            return 1
        if status == "Needs Reply":
            return 2
        if status in ["Waiting on Customer", "Waiting on Vendor"]:
            return 3
        if status == "New":
            return 4
        if status == "Completed":
            return 5
        return 6

    def sort_emails_for_display(self):
        self.emails.sort(key=lambda email: (self.get_importance_rank(email), -email.get("received_timestamp", 0)))

