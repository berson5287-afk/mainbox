    def email_is_completed(self, email):
        """True when the user has closed/hidden this email in MaINbox.

        Follow-up automation should treat Completed, Low, and Junk/Ignore as
        closed states.  The old check only looked at Status == Completed, which
        allowed AI scenario reminders to remain/reappear for items the user had
        already buried as Low or Junk, and sometimes kept completed trackers in
        the Follow-Up Queue until they became due.
        """
        try:
            email = email or {}
            return (
                email.get("status", "") == "Completed"
                or email.get("urgency", "") == "Low"
                or email.get("category", "") == "Junk / Ignore"
            )
        except Exception:
            return False

    def _followup_item_matches_email(self, item, email):
        """Match a follow-up/reminder/check to an email using the strongest IDs available."""
        try:
            if not item or not email:
                return False
            entry_id = email.get("entry_id", "")
            conversation_id = email.get("conversation_id", "")
            subject = (email.get("subject", "") or "").strip().lower()
            group_id = self.get_group_id_for_email(entry_id) if entry_id else ""

            if entry_id and item.get("entry_id") == entry_id:
                return True
            if conversation_id and item.get("conversation_id") == conversation_id:
                return True
            if group_id and item.get("group_id") == group_id:
                return True

            # Subject is only a last-resort fallback for older saved follow-up records
            # that may not have EntryID/ConversationID populated.
            item_subject = (item.get("subject", "") or "").strip().lower()
            if subject and item_subject and subject == item_subject:
                return True
        except Exception:
            pass
        return False

    def collect_active_tracking_items_for_emails(self, emails):
        """
        Return active follow-up/tracking rows associated with the selected email(s).
        Includes manual follow-ups, automatic scenario reminders, pending reply checks,
        and commitment reminders (promised dates / reply-needed).  # v3.8.31
        """
        rows = []
        seen = set()
        email_list = [e for e in (emails or []) if isinstance(e, dict)]

        def add_row(collection_name, index, item, kind, tracking_type, email):
            if not item or item.get("completed") or item.get("cancelled"):
                return
            key = (collection_name, index)
            if key in seen:
                return
            seen.add(key)
            rows.append({
                "key": key,
                "collection": collection_name,
                "index": index,
                "item": item,
                "kind": kind,
                "tracking_type": tracking_type,
                "email": email,
                "subject": item.get("subject") or email.get("subject", "") or "(No subject)",
                "due": self.format_due_display(item.get("due_at", "")) if hasattr(self, "format_due_display") else item.get("due_at", ""),
                "note": item.get("message") or item.get("note") or item.get("reason") or item.get("description") or "",
            })

        for email in email_list:
            for index, item in enumerate(getattr(self, "followups", []) or []):
                if self._followup_item_matches_email(item, email):
                    add_row("followups", index, item, "Manual follow-up", "Manual", email)

            for index, item in enumerate(getattr(self, "scenario_reminders", []) or []):
                if self._followup_item_matches_email(item, email):
                    scenario_type = item.get("type", "scenario")
                    if scenario_type == "vendor_no_response":
                        kind = "Auto: Vendor no-response"
                    elif scenario_type == "customer_po_order_followup":
                        kind = "Auto: PO/order follow-up"
                    else:
                        kind = "Auto: " + scenario_type.replace("_", " ").title()
                    add_row("scenario_reminders", index, item, kind, "Auto", email)

            for index, item in enumerate(getattr(self, "pending_reply_checks", []) or []):
                if self._followup_item_matches_email(item, email):
                    add_row("pending_reply_checks", index, item, "Auto: Pending reply check", "Auto", email)

            # v3.8.30: commitment reminders (promised dates / reply-needed) are active
            # tracking for the email too, so they must show up in the completion review
            # and clear when the email is marked Completed. They were omitted here, so a
            # commitment reminder kept firing even after its email was completed.
            for index, item in enumerate(getattr(self, "commitment_reminders", []) or []):
                if self._followup_item_matches_email(item, email):
                    c_kind = "Auto: " + (item.get("kind_label") or "Commitment reminder")
                    add_row("commitment_reminders", index, item, c_kind, "Auto", email)

        return rows

    def review_tracking_items_before_complete(self, emails):
        """
        When marking email(s) Completed/Low/Junk, let the user decide which related
        follow-ups/tracking records to clear. Automatic items are selected by default;
        manual follow-ups are shown but left unselected unless the user chooses them.
        """
        rows = self.collect_active_tracking_items_for_emails(emails)
        if not rows:
            return set()

        win = tk.Toplevel(self.root)
        win.title("Review Follow-Ups Before Completing")
        remember_window_geometry(win, "Review Follow-Ups Before Completing", "980x460")
        win.transient(self.root)
        win.grab_set()

        tk.Label(
            win,
            text="This email has active follow-up/tracking items.",
            font=("Segoe UI", 14, "bold")
        ).pack(anchor="w", padx=12, pady=(10, 2))
        tk.Label(
            win,
            text="Automatic items are selected by default. Manual follow-ups are shown so you can choose whether to keep or clear them.",
            font=("Segoe UI", 9)
        ).pack(anchor="w", padx=12, pady=(0, 8))

        columns = ("clear", "type", "due", "subject", "note")
        tree = ttk.Treeview(win, columns=columns, show="headings", selectmode="extended", height=12)
        tree.heading("clear", text="Clear?")
        tree.heading("type", text="Auto / Manual")
        tree.heading("due", text="Due")
        tree.heading("subject", text="Subject")
        tree.heading("note", text="Note")
        tree.column("clear", width=70, anchor="center")
        tree.column("type", width=180)
        tree.column("due", width=120)
        tree.column("subject", width=300)
        tree.column("note", width=280)
        tree.pack(fill="both", expand=True, padx=12, pady=6)

        selected_keys = set()
        row_by_iid = {}
        for idx, row in enumerate(rows):
            iid = str(idx)
            row_by_iid[iid] = row
            if row.get("tracking_type") == "Auto":
                selected_keys.add(row["key"])
            tree.insert(
                "", "end", iid=iid,
                values=(
                    "Yes" if row["key"] in selected_keys else "No",
                    row.get("kind", ""),
                    row.get("due", ""),
                    row.get("subject", ""),
                    row.get("note", ""),
                )
            )

        result = {"keys": None, "skip_complete": False}

        def refresh_marks():
            for iid, row in row_by_iid.items():
                vals = list(tree.item(iid, "values"))
                vals[0] = "Yes" if row["key"] in selected_keys else "No"
                tree.item(iid, values=vals)

        def toggle_selected(event=None):
            iids = tree.selection()
            if not iids:
                iid = tree.focus()
                iids = [iid] if iid else []
            for iid in iids:
                row = row_by_iid.get(iid)
                if not row:
                    continue
                key = row["key"]
                if key in selected_keys:
                    selected_keys.remove(key)
                else:
                    selected_keys.add(key)
            refresh_marks()

        def select_auto():
            selected_keys.clear()
            for row in rows:
                if row.get("tracking_type") == "Auto":
                    selected_keys.add(row["key"])
            refresh_marks()

        def select_all():
            selected_keys.clear()
            selected_keys.update(row["key"] for row in rows)
            refresh_marks()

        def select_none():
            selected_keys.clear()
            refresh_marks()

        def clear_selected_and_close():
            result["keys"] = set(selected_keys)
            win.destroy()

        def clear_all_and_close():
            result["keys"] = {row["key"] for row in rows}
            win.destroy()

        def keep_all_and_close():
            result["keys"] = set()
            win.destroy()

        def skip_mark_complete_and_close():
            result["skip_complete"] = True
            result["keys"] = None
            win.destroy()

        tree.bind("<Double-Button-1>", toggle_selected)
        tree.bind("<space>", toggle_selected)
        # Delete key acts as the "Clear Selected" button (commit marked rows).
        tree.bind("<Delete>", lambda e: clear_selected_and_close())

        helper = tk.Label(win, text="Tip: double-click a row or press Space to toggle Clear Yes/No.", font=("Segoe UI", 9), fg=_FG_DIM)
        helper.pack(anchor="w", padx=12, pady=(0, 6))

        btns = tk.Frame(win)
        btns.pack(fill="x", padx=12, pady=(0, 12))
        tk.Button(btns, text="Select Auto Only", command=select_auto, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Select All", command=select_all, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Select None", command=select_none, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Skip Marking Complete", command=skip_mark_complete_and_close, width=22).pack(side="right", padx=4)
        tk.Button(btns, text="Keep All", command=keep_all_and_close, width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Clear All", command=clear_all_and_close, width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Clear Selected", command=clear_selected_and_close, width=16).pack(side="right", padx=4)

        try:
            win.lift()
            win.focus_force()
        except Exception:
            pass
        self.root.wait_window(win)

        if result.get("skip_complete"):
            return None
        return result["keys"] if result["keys"] is not None else set()

    def cancel_selected_tracking_items(self, keys_to_cancel, reason="Cancelled when email marked Completed"):
        """Cancel selected follow-up/tracking records by collection/index key."""
        if not keys_to_cancel:
            return 0
        now_iso = datetime.now().isoformat()
        cancelled = 0
        collections = {
            "followups": getattr(self, "followups", []),
            "scenario_reminders": getattr(self, "scenario_reminders", []),
            # v3.8.30: was missing. collect_active_tracking_items_for_emails now emits
            # "commitment_reminders"-keyed rows, so this map must resolve that collection
            # or those rows would silently never cancel even though the dialog reported them.
            "commitment_reminders": getattr(self, "commitment_reminders", []),
            "pending_reply_checks": getattr(self, "pending_reply_checks", []),
        }
        for collection_name, index in keys_to_cancel:
            items = collections.get(collection_name) or []
            try:
                item = items[index]
            except Exception:
                continue
            if not isinstance(item, dict):
                continue
            if item.get("completed") or item.get("cancelled"):
                continue
            item["cancelled"] = True
            item["cancelled_at"] = now_iso
            item["cancel_reason"] = reason
            cancelled += 1

        if cancelled:
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_pending_reply_checks()
        return cancelled

    def cancel_automatic_tracking_for_email(self, email, reason="Email marked Completed"):
        """
        Stop automatic tracking for a completed email without touching manual follow-ups.

        Preserved:
        - self.followups created from the Setup / Edit Follow Up window

        Cancelled:
        - scenario_reminders such as vendor no-response, customer PO, AI review reminders
        - pending_reply_checks created after MaINbox opens a draft and waits for Sent Items
        - commitment_reminders (promised dates / reply-needed)  # v3.8.31
        """
        if not email:
            return 0

        entry_id = email.get("entry_id", "")
        conversation_id = email.get("conversation_id", "")
        now_iso = datetime.now().isoformat()
        cancelled = 0

        for item in getattr(self, "scenario_reminders", []):
            if item.get("completed") or item.get("cancelled"):
                continue
            same_entry = entry_id and item.get("entry_id") == entry_id
            same_conversation = conversation_id and item.get("conversation_id") == conversation_id
            if same_entry or same_conversation:
                item["cancelled"] = True
                item["cancelled_at"] = now_iso
                item["cancel_reason"] = reason
                cancelled += 1

        for item in getattr(self, "pending_reply_checks", []):
            if item.get("completed") or item.get("cancelled"):
                continue
            same_entry = entry_id and item.get("entry_id") == entry_id
            same_conversation = conversation_id and item.get("conversation_id") == conversation_id
            if same_entry or same_conversation:
                item["cancelled"] = True
                item["cancelled_at"] = now_iso
                item["cancel_reason"] = reason
                cancelled += 1

        # v3.8.31: also cancel commitment reminders (promised dates / reply-needed) for
        # this email. This helper is currently unused, but the completion-review path now
        # handles commitment reminders, and leaving this one incomplete would be a trap if
        # any future code routes mark-complete through here.
        for item in getattr(self, "commitment_reminders", []) or []:
            if item.get("completed") or item.get("cancelled"):
                continue
            same_entry = entry_id and item.get("entry_id") == entry_id
            same_conversation = conversation_id and item.get("conversation_id") == conversation_id
            if same_entry or same_conversation:
                item["cancelled"] = True
                item["cancelled_at"] = now_iso
                item["cancel_reason"] = reason
                cancelled += 1

        # Keep user-created/manual follow-ups visible. Only clear the display if
        # there is no active manual follow-up still scheduled for this email.
        if entry_id and not self.get_active_followup_for_email(entry_id):
            email["followup_time"] = ""

        return cancelled

    def selected_workflow_values_differ(self, selected_emails, category, urgency, status, email_type):
        """True when the edit controls differ from the selected row data.

        This is used before Refresh and by dropdown auto-save so a user's manual
        urgency/status/category choice cannot be lost by re-rendering older saved
        data from Outlook/cache.
        """
        try:
            for email in selected_emails or []:
                if category and category != email.get("category", ""):
                    return True
                if urgency and urgency != email.get("urgency", ""):
                    return True
                if status and status != email.get("status", ""):
                    return True
                if email_type != normalize_email_type_code(email.get("email_type", "")):
                    return True
            return False
        except Exception:
            return False

    def auto_save_selected_workflow_change(self, event=None):
        """Immediately persist dropdown workflow edits made by the user.

        Previously the combobox could show a new urgency while the durable record
        still held the old urgency until Apply/Save was clicked. A subsequent
        Refresh then reloaded the old durable value, making it look like the
        manual urgency change was ignored.
        """
        if getattr(self, "_loading_selected_workflow_fields", False):
            return
        if getattr(self, "_auto_saving_workflow_fields", False):
            return
        try:
            selected = self.get_selected_emails(show_warning=False)
            if not selected:
                return
            new_category = self.category_var.get()
            new_urgency = self.urgency_var.get()
            new_status = self.status_var.get()
            new_email_type = normalize_email_type_code(getattr(self, "email_type_var", tk.StringVar()).get())
            if not self.selected_workflow_values_differ(selected, new_category, new_urgency, new_status, new_email_type):
                return
            self._auto_saving_workflow_fields = True
            self.save_selected_changes(autosave=True)
        finally:
            self._auto_saving_workflow_fields = False

    def save_pending_selected_workflow_edits_before_refresh(self):
        """Commit unsaved visible workflow edits before importing/re-rendering refresh data."""
        try:
            if getattr(self, "_loading_selected_workflow_fields", False):
                return False
            selected = self.get_selected_emails(show_warning=False)
            if not selected:
                return False
            new_category = self.category_var.get()
            new_urgency = self.urgency_var.get()
            new_status = self.status_var.get()
            new_email_type = normalize_email_type_code(getattr(self, "email_type_var", tk.StringVar()).get())
            if not self.selected_workflow_values_differ(selected, new_category, new_urgency, new_status, new_email_type):
                return False
            return bool(self.save_selected_changes(autosave=True))
        except Exception:
            return False

    def save_selected_changes(self, autosave=False):
        selected_emails = self.get_selected_emails(show_warning=not autosave)
        if not selected_emails:
            return False
        new_category = self.category_var.get()
        new_urgency = self.urgency_var.get()
        new_status = self.status_var.get()
        new_email_type = normalize_email_type_code(getattr(self, "email_type_var", tk.StringVar()).get())
        if autosave and not self.selected_workflow_values_differ(selected_emails, new_category, new_urgency, new_status, new_email_type):
            return False
        self.save_undo_state("save selected email changes")
        vendor_reminders_scheduled = 0
        followups_cancelled = 0
        marking_done = (
            new_status == "Completed"
            or new_urgency == "Low"
            or new_category == "Junk / Ignore"
        )
        tracking_keys_to_cancel = set()
        kept_tracking_entry_ids = set()
        if marking_done:
            # If this email has any active follow-up/tracking items, let the user
            # choose exactly what to clear. Auto items are selected by default;
            # manual follow-ups are shown but preserved unless selected.
            tracking_rows_before_review = self.collect_active_tracking_items_for_emails(selected_emails)
            tracking_keys_to_cancel = self.review_tracking_items_before_complete(selected_emails)
            if tracking_keys_to_cancel is None:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, "Mark Complete skipped. No email status or follow-ups were changed.")
                return
            for row in tracking_rows_before_review:
                if row.get("key") in tracking_keys_to_cancel:
                    continue
                tracked_email = row.get("email") or {}
                tracked_entry_id = tracked_email.get("entry_id", "")
                if tracked_entry_id:
                    kept_tracking_entry_ids.add(tracked_entry_id)
        for email in selected_emails:
            original_urgency = email.get("urgency", "Normal")
            entry_id = email.get("entry_id", "")
            email["category"] = new_category
            # If the user marks an email Completed but chooses to keep any active
            # follow-up/tracking item, preserve the current urgency so it does not
            # get pushed into Low/hidden just because completion was applied.
            if new_status == "Completed" and entry_id in kept_tracking_entry_ids:
                email["urgency"] = original_urgency
            else:
                email["urgency"] = new_urgency
            email["status"] = new_status
            if new_email_type or hasattr(self, "email_type_var"):
                email["email_type"] = new_email_type
            email["is_new_import"] = False
            # v3.9.46: a manual workflow edit is the user's explicit decision. Mark the email
            # AI-settled and user-locked so the background drip / 12h re-triage can never
            # overwrite it, and so it survives a refresh (which rebuilds rows from status_data).
            email["ai_triaged_at"] = email.get("ai_triaged_at") or datetime.now().isoformat()
            email["ai_triage_pending"] = False
            email["ai_user_locked"] = True
            self.save_record(email)
            self.learn_from_user_correction(email, new_category, new_urgency, new_status)
            if new_status == "Waiting on Vendor":
                if self.schedule_vendor_no_response_reminder(email):
                    vendor_reminders_scheduled += 1
            # Marking an email Completed/Low/Junk now opens a review popup when
            # related tracking exists. Only the rows selected in that popup are cleared.
        if marking_done and tracking_keys_to_cancel:
            cancel_reason = f"Cancelled from completion review: email marked {new_status or new_category}"
            followups_cancelled += self.cancel_selected_tracking_items(tracking_keys_to_cancel, cancel_reason)
            for email in selected_emails:
                eid = email.get("entry_id", "")
                if eid and not self.get_active_followup_for_email(eid):
                    email["followup_time"] = ""
        self.flush_status_data()
        self.sort_emails_for_display()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        self.save_cached_state()
        self.preview_text.delete("1.0", tk.END)
        extra = f"\n\nVendor no-response reminder scheduled for {vendor_reminders_scheduled} email(s)." if vendor_reminders_scheduled else ""
        cancelled_note = f"\nCancelled {followups_cancelled} active follow-up(s)." if followups_cancelled else ""
        self.preview_text.insert(tk.END, f"Saved changes to {len(selected_emails)} selected email(s).{extra}{cancelled_note}")
        return True

    def get_sender_email(self, msg):
        try:
            sender = msg.SenderEmailAddress or ""
            if sender:
                return sender
        except Exception:
            pass
        try:
            sender = msg.Sender.GetExchangeUser().PrimarySmtpAddress
            if sender:
                return sender
        except Exception:
            pass
        return ""

    def generate_reply_text(self, email, prefer_ai=True):
        fallback = get_followup_message(email.get("category", "General"))
        if not prefer_ai:
            return fallback
        body = self.load_body_if_needed(email)
        ai_result = ask_ollama_for_reply(
            subject=email.get("subject", ""), sender=email.get("sender", ""), body=body,
            category=email.get("category", "General"), urgency=email.get("urgency", "Normal"),
            status=email.get("status", "New")
        )
        if ai_result:
            text = ai_result.get("text") if isinstance(ai_result, dict) else ai_result
            total_ns = ai_result.get("total_duration") if isinstance(ai_result, dict) else None
            load_ns = ai_result.get("load_duration") if isinstance(ai_result, dict) else None
            if total_ns:
                total_s = total_ns / 1_000_000_000
                load_s = (load_ns or 0) / 1_000_000_000
                self.ai_status_var.set(f"AI: Ollama {total_s:.1f}s / load {load_s:.1f}s")
            else:
                self.ai_status_var.set("AI: used Ollama")
            return text
        self.ai_status_var.set("AI: template fallback")
        return fallback

    def force_mainbox_window_to_front(self, window=None, restore_root=True):
        """v3.9.60: reliably restore + foreground a MaINbox window (the main window or one of
        its popups), even when MaINbox is MINIMIZED.

        Tk's lift()/focus_force() alone do not reliably pull a minimized window back under
        Windows' foreground-lock rules -- which is why a reminder popup that appeared while
        MaINbox was minimized could only be recovered via Task Manager -> "Bring to front",
        not by clicking the taskbar button. This mirrors the Win32 AttachThreadInput +
        SetForegroundWindow technique already used for the Outlook inspector in
        bring_outlook_inspector_to_front(). Reminder/alert popups are transient(self.root), so
        if the main window is iconified the popup is hidden too; we restore the main window
        first, then foreground the popup. Everything is best-effort and guarded, so it is a
        no-op (falling back to lift/focus) if win32 is unavailable."""
        target = window or self.root

        def _tk_restore(w):
            # Map an iconified window back so it (and its transient children) can be shown.
            try:
                if w is self.root or str(w.wm_state()) == "iconic":
                    w.deiconify()
            except Exception:
                pass
            try:
                w.state("normal")
            except Exception:
                pass
            try:
                w.lift()
            except Exception:
                pass

        if restore_root:
            _tk_restore(self.root)
        _tk_restore(target)
        try:
            target.update_idletasks()
        except Exception:
            pass

        def _hwnd_for(w):
            if not win32gui:
                return None
            hwnd = None
            try:
                child = w.winfo_id()
                try:
                    parent = win32gui.GetParent(child)
                except Exception:
                    parent = None
                hwnd = parent or child
            except Exception:
                hwnd = None
            if not hwnd:
                try:
                    hwnd = win32gui.FindWindow(None, w.title())
                except Exception:
                    hwnd = None
            return hwnd

        def _force_front(hwnd):
            if not hwnd or not win32gui or not win32con:
                return False
            try:
                if ctypes:
                    try:
                        ctypes.windll.user32.AllowSetForegroundWindow(-1)
                    except Exception:
                        pass
                try:
                    win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
                except Exception:
                    try:
                        win32gui.ShowWindow(hwnd, win32con.SW_SHOWNORMAL)
                    except Exception:
                        pass

                # Temporarily attach input threads -- the standard workaround for Windows'
                # focus-stealing prevention so SetForegroundWindow actually takes effect.
                attached = False
                fg_thread = target_thread = current_thread = None
                if win32process and ctypes:
                    try:
                        fg_hwnd = win32gui.GetForegroundWindow()
                        fg_thread, _ = win32process.GetWindowThreadProcessId(fg_hwnd)
                        target_thread, _ = win32process.GetWindowThreadProcessId(hwnd)
                        current_thread = ctypes.windll.kernel32.GetCurrentThreadId()
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, True)
                                attached = True
                    except Exception:
                        attached = False

                try:
                    win32gui.BringWindowToTop(hwnd)
                except Exception:
                    pass
                try:
                    win32gui.SetWindowPos(hwnd, win32con.HWND_TOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                    win32gui.SetWindowPos(hwnd, win32con.HWND_NOTOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                except Exception:
                    pass
                ok = False
                try:
                    ok = bool(win32gui.SetForegroundWindow(hwnd))
                except Exception:
                    ok = False
                try:
                    win32gui.SetFocus(hwnd)
                except Exception:
                    pass

                if attached and win32process and ctypes:
                    try:
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, False)
                    except Exception:
                        pass
                return ok
            except Exception:
                return False

        # Restore the main window (its taskbar button) first, then the popup itself.
        if restore_root and target is not self.root:
            _force_front(_hwnd_for(self.root))
        _force_front(_hwnd_for(target))

        # Final Tk nudge so focus visibly lands on the popup.
        try:
            target.lift()
            target.focus_force()
        except Exception:
            pass

    def bring_outlook_inspector_to_front(self, item, attempts=10, delay_ms=160):
        """Try Outlook Activate plus Win32 foreground handling. Windows may still block true focus, so we also raise/topmost-nudge."""
        def get_inspector_and_hwnd():
            inspector = None
            hwnd = None
            try:
                inspector = item.GetInspector
            except Exception:
                inspector = None
            try:
                active = self.outlook.ActiveInspector() if self.outlook else None
                if active:
                    inspector = active
            except Exception:
                pass
            if inspector:
                try:
                    inspector.Activate()
                except Exception:
                    pass
                try:
                    hwnd = int(inspector.HWND)
                except Exception:
                    hwnd = None
            return inspector, hwnd

        def force_hwnd_front(hwnd):
            if not hwnd or not win32gui or not win32con:
                return False
            try:
                if ctypes:
                    try:
                        ctypes.windll.user32.AllowSetForegroundWindow(-1)
                    except Exception:
                        pass
                try:
                    win32gui.ShowWindow(hwnd, win32con.SW_SHOWNORMAL)
                except Exception:
                    win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)

                # Temporarily attach input threads. This is the common workaround for Windows focus rules.
                attached = False
                fg_thread = target_thread = current_thread = None
                if win32process and ctypes:
                    try:
                        fg_hwnd = win32gui.GetForegroundWindow()
                        fg_thread, _ = win32process.GetWindowThreadProcessId(fg_hwnd)
                        target_thread, _ = win32process.GetWindowThreadProcessId(hwnd)
                        current_thread = ctypes.windll.kernel32.GetCurrentThreadId()
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, True)
                                attached = True
                    except Exception:
                        attached = False

                try:
                    win32gui.BringWindowToTop(hwnd)
                except Exception:
                    pass
                try:
                    win32gui.SetWindowPos(hwnd, win32con.HWND_TOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                    win32gui.SetWindowPos(hwnd, win32con.HWND_NOTOPMOST, 0, 0, 0, 0, win32con.SWP_NOMOVE | win32con.SWP_NOSIZE | win32con.SWP_SHOWWINDOW)
                except Exception:
                    pass
                ok = False
                try:
                    ok = bool(win32gui.SetForegroundWindow(hwnd))
                except Exception:
                    ok = False
                try:
                    win32gui.SetFocus(hwnd)
                except Exception:
                    pass

                if attached and win32process and ctypes:
                    try:
                        for thread_id in {fg_thread, target_thread}:
                            if thread_id and thread_id != current_thread:
                                ctypes.windll.user32.AttachThreadInput(current_thread, thread_id, False)
                    except Exception:
                        pass
                return ok
            except Exception:
                return False

        def attempt(remaining):
            try:
                try:
                    self.root.attributes("-topmost", False)
                    self.root.lower()
                except Exception:
                    pass
                inspector, hwnd = get_inspector_and_hwnd()
                if hwnd:
                    force_hwnd_front(hwnd)
            except Exception:
                pass
            if remaining > 0:
                try:
                    self.root.after(delay_ms, lambda: attempt(remaining - 1))
                except Exception:
                    pass

        attempt(attempts)

    def display_outlook_item_foreground(self, item):
        """Display an Outlook item and strongly nudge its inspector window to the front."""
        try:
            # Make sure the monitor itself is not marked topmost over Outlook.
            try:
                self.root.attributes("-topmost", False)
            except Exception:
                pass
            item.Display()
        except Exception:
            return
        self.bring_outlook_inspector_to_front(item)

    def make_sent_waiting_placeholder(self, sent_msg, pending=None, target_status="Waiting on Vendor"):
        """Create a visible main-window tracking row for a sent email we are waiting on.

        v2.10.8: Works for both MaINbox-created drafts and manually sent Outlook emails.
        """
        pending = pending or {}
        try:
            conversation_id = ""
            try:
                conversation_id = sent_msg.ConversationID or ""
            except Exception:
                conversation_id = pending.get("conversation_id", "")

            sent_entry_id = ""
            try:
                sent_entry_id = sent_msg.EntryID or ""
            except Exception:
                sent_entry_id = pending.get("sent_entry_id", "")

            subject = ""
            try:
                subject = sent_msg.Subject or pending.get("subject", "")
            except Exception:
                subject = pending.get("subject", "")

            sent_conversation_index = ""
            sent_internet_message_id = ""
            try:
                sent_conversation_index = str(getattr(sent_msg, "ConversationIndex", "") or pending.get("sent_conversation_index", "") or "")
            except Exception:
                sent_conversation_index = pending.get("sent_conversation_index", "") or ""
            try:
                pa = sent_msg.PropertyAccessor
                try:
                    sent_internet_message_id = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
                except Exception:
                    sent_internet_message_id = pending.get("sent_internet_message_id", "") or ""
            except Exception:
                sent_internet_message_id = pending.get("sent_internet_message_id", "") or ""

            if not conversation_id and not sent_entry_id and not subject:
                return None

            # One active waiting row per conversation. If Outlook lacks a conversation id,
            # fall back to sent EntryID / subject hash.
            if conversation_id:
                placeholder_id = f"sentwait:{conversation_id}"
            elif sent_entry_id:
                placeholder_id = f"sentwait:{sent_entry_id}"
            else:
                digest = hashlib.sha1(str(subject).encode("utf-8", "ignore")).hexdigest()[:16]
                placeholder_id = f"sentwait:subject:{digest}"

            recipient = ""
            try:
                recipient = sent_msg.To or ""
            except Exception:
                recipient = pending.get("recipient", "")

            sent_on = datetime.now()
            try:
                if sent_msg.SentOn:
                    sent_on = sent_msg.SentOn.replace(tzinfo=None)
            except Exception:
                try:
                    sent_on = datetime.fromisoformat(pending.get("sent_on", ""))
                except Exception:
                    pass

            placeholder = {
                "entry_id": placeholder_id,
                "sent_entry_id": sent_entry_id,
                "sent_conversation_index": sent_conversation_index,
                "sent_internet_message_id": sent_internet_message_id,
                "tracked_entry_id": pending.get("entry_id", ""),
                "tracked_store_id": pending.get("store_id", ""),
                "store_id": pending.get("store_id", ""),
                "conversation_id": conversation_id,
                "source": "Sent / Waiting",
                "subject": subject,
                "normalized_subject": normalize_subject_for_match(subject),
                "sender": recipient or pending.get("sender", "Sent RFQ / Reply"),
                "sender_email": recipient or pending.get("sender_email", ""),
                "body": "",
                "body_loaded": False,
                "received": sent_on.strftime("%Y-%m-%d %I:%M %p"),
                "received_timestamp": sent_on.timestamp(),
                "outlook_categories": "",
                "category": pending.get("category", "Vendor / Supplier") or "Vendor / Supplier",
                "urgency": pending.get("urgency", "Normal") if pending.get("urgency") != "Low" else "Normal",
                "status": target_status or "Waiting on Vendor",
                "message": None,
                "is_new_import": False,
                "followup_time": "",
                "sender_type": "sent_placeholder",
                "email_type": "V" if target_status == "Waiting on Vendor" else "C",
                "sender_intent": "Waiting for vendor/customer response to sent email",
                "business_relevance": "1.0",
                "spam_likelihood": "0.0",
                "same_subject_related_count": 0,
                "has_attachments": False,
                "is_sent_waiting_placeholder": True,
                "created_at": datetime.now().isoformat(),
                "cleared": False,
            }
            return placeholder
        except Exception:
            return None

    def sync_sent_waiting_placeholders_into_email_list(self):
        """Keep active sent placeholders visible in the main list, without duplicate rows."""
        try:
            # v2.10.8 patch: app-deleted sent placeholders must stay gone after restart.
            # They are stored separately in mainbox_sent_waiting_placeholders.json, so
            # filter them against status_data before re-inserting them into self.emails.
            # v3.9.27 duplicate self-heal: a thread shows at most ONE tracker row. If a
            # loaded real email row is already the active tracker for a conversation
            # (sent_waiting_tracker_active), retire any placeholder for that same
            # conversation instead of showing both. This also cleans up the duplicate
            # pairs older versions created (they re-activated the real row AND added a
            # placeholder for the same send).
            tracked_conversations = set()
            for row in getattr(self, "emails", []) or []:
                if not isinstance(row, dict) or row.get("is_sent_waiting_placeholder"):
                    continue
                if row.get("sent_waiting_tracker_active"):
                    conv = str(row.get("conversation_id", "") or "").strip()
                    if conv:
                        tracked_conversations.add(conv)
            retired_any = False
            active = []
            for p in getattr(self, "sent_waiting_placeholders", []):
                pid = p.get("entry_id", "")
                if p.get("cleared"):
                    continue
                if pid and self.status_data.get(pid, {}).get("app_deleted"):
                    p["cleared"] = True
                    p["cleared_reason"] = "app_deleted"
                    continue
                p_conv = str(p.get("conversation_id", "") or "").strip()
                if p_conv and p_conv in tracked_conversations:
                    p["cleared"] = True
                    p["cleared_at"] = datetime.now().isoformat()
                    p["cleared_reason"] = "superseded_by_tracked_row"
                    retired_any = True
                    continue
                active.append(p)
            if retired_any:
                try:
                    # Persist the retirements; respects the placeholder batch if open.
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
            # Remove placeholder rows that were cleared/deleted from the visible list.
            active_ids = {p.get("entry_id", "") for p in active}
            self.emails = [e for e in self.emails if not e.get("is_sent_waiting_placeholder") or e.get("entry_id") in active_ids]
            # Index where each placeholder row currently lives so we can both add missing
            # rows and refresh rows that already exist.
            existing_index = {}
            for i, e in enumerate(self.emails):
                if e.get("is_sent_waiting_placeholder"):
                    existing_index.setdefault(e.get("entry_id", ""), i)
            for placeholder in active:
                pid = placeholder.get("entry_id", "")
                if not pid:
                    continue
                if pid not in existing_index:
                    self.emails.append(dict(placeholder))
                else:
                    # v3.9.1 fix: a second reply in the same conversation updates the stored
                    # placeholder (newer SentOn time, recipient, body), but the older code only
                    # ever APPENDED a placeholder once and skipped it forever after, so the
                    # already-visible row kept showing the first send time (e.g. the "will
                    # advise" reply at 7:46 stayed put after the quote went out at 8:49).
                    # Refresh the visible row in place from the updated placeholder, then
                    # re-overlay any durable user workflow choice (e.g. a manual Completed)
                    # so the newest send time/body shows without discarding the user's edits.
                    i = existing_index[pid]
                    merged = dict(self.emails[i])
                    merged.update(placeholder)
                    saved = self.status_data.get(pid, {}) if isinstance(self.status_data, dict) else {}
                    if saved:
                        self.apply_saved_workflow_to_email(merged, saved)
                    self.emails[i] = merged
            # v3 efficiency: rebuild index after placeholder sync changes self.emails.
            self._rebuild_email_index()
        except Exception:
            pass

    def thread_is_app_deleted_for_placeholder(self, placeholder):
        """v3.9.2: True if this Sent / Waiting placeholder belongs to a thread the user
        deleted from MaINbox only.

        The Sent Items scan re-sees the original sent message on every refresh, and in
        Cached Exchange Mode the sent message's own EntryID may differ from the id used to
        record the deletion (the deletion is recorded against the inbound message). The old
        guard only checked the placeholder's own entry_id, so a deleted thread came back as a
        Sent / Waiting echo. Matching on the conversation id (precise) catches that; a
        subject-only fallback is used ONLY when neither side has a conversation id, so
        unrelated same-subject RFQs are never suppressed.
        """
        try:
            if not isinstance(self.status_data, dict) or not isinstance(placeholder, dict):
                return False
            p_conv = str(placeholder.get("conversation_id", "") or "").strip().lower()
            p_subject = normalize_subject_for_match(placeholder.get("subject", "") or "")
            if not p_conv and not p_subject:
                return False
            for rec in self.status_data.values():
                if not isinstance(rec, dict) or not rec.get("app_deleted"):
                    continue
                rec_conv = str(rec.get("conversation_id", "") or "").strip().lower()
                if p_conv and rec_conv and rec_conv == p_conv:
                    return True
                if not p_conv and not rec_conv and p_subject:
                    rec_subject = normalize_subject_for_match(rec.get("subject", "") or rec.get("normalized_subject", "") or "")
                    if rec_subject and rec_subject == p_subject:
                        return True
            return False
        except Exception:
            return False

    def add_or_update_sent_waiting_placeholder(self, placeholder):
        if not placeholder:
            return False
        try:
            pid = placeholder.get("entry_id", "")
            if not pid:
                return False
            # v2.10.8 patch: do not recreate a sent/waiting placeholder that the
            # user already deleted from MaINbox only. This prevents it from coming
            # back when Sent Items are scanned after reopening the app.
            # v3.9.2: also suppress when the placeholder's THREAD was deleted (matched by
            # conversation id), since Cached Exchange Mode re-syncs change EntryIDs and the
            # placeholder's own id will not match the id the deletion was recorded against.
            if self.status_data.get(pid, {}).get("app_deleted") or self.thread_is_app_deleted_for_placeholder(placeholder):
                for existing in self.sent_waiting_placeholders:
                    if existing.get("entry_id") == pid:
                        existing["cleared"] = True
                        existing["cleared_reason"] = "app_deleted"
                        break
                self.save_sent_waiting_placeholders()
                return False
            updated = False
            for i, existing in enumerate(self.sent_waiting_placeholders):
                if existing.get("entry_id") == pid:
                    # v3.8.29 fix: do NOT resurrect a placeholder that a matching
                    # incoming reply already cleared. The Sent Items scan re-sees the
                    # original sent message on every refresh; the old code blindly set
                    # cleared=False here, so a tracker cleared by a reply would pop back
                    # and never go away (the "reply came in but the tracker is still
                    # sitting there" bug). Only un-clear if the user genuinely re-opened
                    # the thread by sending AGAIN after the clearing reply, i.e. this
                    # sent message is newer than the reply that cleared it.
                    # v3.9.27: the guard only protected "matching_reply_imported", but the
                    # bounded Outlook rescue scan clears with reason
                    # "bounded_outlook_thread_reply_found" -- those trackers were being
                    # resurrected on the next Sent Items pass whenever Cached Exchange
                    # Mode reassigned the sent message's EntryID (so the processed-id
                    # skip missed it). Protect every reply-based clear the same way, and
                    # never resurrect a placeholder retired by duplicate cleanup (its
                    # surviving sibling is the live tracker for that thread).
                    existing_reason = str(existing.get("cleared_reason", "") or "")
                    if existing.get("cleared") and existing_reason == "duplicate_placeholder_cleanup":
                        return False
                    if existing.get("cleared") and existing_reason in (
                        "matching_reply_imported",
                        "bounded_outlook_thread_reply_found",
                    ):
                        try:
                            new_send_ts = float(placeholder.get("received_timestamp", 0) or 0)
                            cleared_reply_ts = float(existing.get("cleared_reply_timestamp", 0) or 0)
                        except Exception:
                            new_send_ts = 0
                            cleared_reply_ts = 0
                        if not (new_send_ts and cleared_reply_ts and new_send_ts > cleared_reply_ts + 30):
                            # Same original send (or older than the reply) -> leave it
                            # cleared and treat as a no-op so it stays out of the list.
                            return False
                    self.sent_waiting_placeholders[i].update(placeholder)
                    self.sent_waiting_placeholders[i]["cleared"] = False
                    updated = True
                    break
            if not updated:
                self.sent_waiting_placeholders.append(placeholder)
            self.save_sent_waiting_placeholders()
            if getattr(self, "_placeholder_batch", 0):
                self._placeholder_batch_sync_dirty = True
            else:
                self.sync_sent_waiting_placeholders_into_email_list()
            return True
        except Exception:
            return False

    def _flag_tracked_reply_by_intent(self, reply_email, waiting_party=""):
        """v3.9.51: an inbound reply that just cleared one of our sent/waiting trackers is the
        response we were waiting on. Give it a sensible status automatically so the next step is
        smooth, using the existing non-AI analyze_reply_intent():
          - a question / 'please confirm' style reply  -> Needs Reply
          - a 'working on it' / 'I'll get back to you'  -> Waiting on Vendor / Waiting on Customer
            (Vendor vs Customer taken from the tracker we cleared -- whoever we sent to -- then the
             reply's own sender type, then the phrase wording)
          - a plain thank-you / acknowledgement         -> Completed
        Replies with no clear signal are left untouched for normal AI triage. A status the user set
        by hand is never overridden, and the flagged reply is marked settled so the background drip
        / AutoPilot do not re-classify over this rule.
        """
        try:
            if (not isinstance(reply_email, dict)
                    or reply_email.get("ai_user_locked")
                    or reply_email.get("is_sent_waiting_placeholder")):
                return
            try:
                self.load_body_if_needed(reply_email)
            except Exception:
                pass
            subject = reply_email.get("subject", "") or ""
            body = reply_email.get("body", "") or ""
            sender = reply_email.get("sender_email", "") or reply_email.get("sender", "") or ""
            intent = analyze_reply_intent(
                subject=subject, body=body, sender_or_recipient=sender,
                source=reply_email.get("source", ""), direction="inbound")
            new_status = ""
            if intent.get("is_closed_ack"):
                new_status = "Completed"
            elif intent.get("is_waiting"):
                party = waiting_party if waiting_party in ("Vendor", "Customer") else ""
                if not party:
                    _st = str(reply_email.get("sender_type", "") or reply_email.get("email_type", "") or "").lower()
                    if "customer" in _st or "prospect" in _st:
                        party = "Customer"
                    elif "vendor" in _st or "supplier" in _st:
                        party = "Vendor"
                if not party:
                    party = "Customer" if intent.get("intent") == "waiting_on_customer" else "Vendor"
                new_status = "Waiting on " + party
            else:
                _body_q = _strip_reply_boilerplate_for_intent(body) if body else ""
                if intent.get("intent") in ("needs_reply", "business_request") or ("?" in _body_q):
                    new_status = "Needs Reply"
            if not new_status:
                return
            reply_email["status"] = new_status
            reply_email["ai_triaged_at"] = datetime.now().isoformat()
            reply_email["ai_triage_pending"] = False
            reply_email["ai_user_locked"] = True
            reply_email["is_new_import"] = False
            self.save_record(reply_email)
        except Exception:
            pass

    def clear_sent_waiting_placeholder_for_reply(self, email):
        """When a matching incoming reply arrives, clear the sent-placeholder reminder.

        Match by Outlook conversation id first, then by normalized subject as a fallback.
        The timestamp guard keeps the original older inbox email from clearing a brand-new
        sent/waiting tracker.
        """
        try:
            if not email or email.get("is_sent_waiting_placeholder"):
                return False
            conversation_id = email.get("conversation_id", "")
            subject_key = self._normalized_thread_subject(email.get("subject", ""))
            if not conversation_id and not subject_key:
                return False
            changed = False
            now = datetime.now().isoformat()
            for placeholder in getattr(self, "sent_waiting_placeholders", []):
                if placeholder.get("cleared"):
                    continue

                same_thread = False
                if conversation_id and placeholder.get("conversation_id") == conversation_id:
                    same_thread = True
                elif subject_key and self._normalized_thread_subject(placeholder.get("subject", "")) == subject_key:
                    same_thread = True
                if not same_thread:
                    continue

                # Only clear when the incoming message is newer than the sent placeholder.
                # This prevents the original customer/vendor email in the same conversation from
                # immediately clearing the reminder during the next refresh.
                try:
                    email_ts = float(email.get("received_timestamp", 0) or 0)
                    placeholder_ts = float(placeholder.get("received_timestamp", 0) or 0)
                except Exception:
                    email_ts = 0
                    placeholder_ts = 0
                if placeholder_ts and email_ts and email_ts <= (placeholder_ts + 30):
                    continue

                placeholder["cleared"] = True
                placeholder["cleared_at"] = now
                placeholder["cleared_by_entry_id"] = email.get("entry_id", "")
                placeholder["cleared_reason"] = "matching_reply_imported"
                # v3.8.29: remember WHEN the clearing reply arrived. The Sent Items
                # scan re-sees the original sent message on later refreshes; the
                # resurrect guard in add_or_update_sent_waiting_placeholder() uses
                # this to tell "same old send" (keep cleared) apart from "user sent
                # again after the reply" (genuine re-open -> allow a fresh tracker).
                placeholder["cleared_reply_timestamp"] = email_ts
                changed = True
            if changed:
                # v3.9.51: flag the reply that cleared this sent placeholder by intent (see
                # _flag_tracked_reply_by_intent) so the next step is smooth. Placeholders do not
                # carry Vendor/Customer, so the helper derives it from the reply's own sender type.
                self._flag_tracked_reply_by_intent(email, "")
                active_ids = {p.get("entry_id", "") for p in self.sent_waiting_placeholders if not p.get("cleared")}
                self.emails = [e for e in self.emails if not e.get("is_sent_waiting_placeholder") or e.get("entry_id") in active_ids]
                self._rebuild_email_index()
                self.save_sent_waiting_placeholders()
                self.save_cached_state()
            return changed
        except Exception:
            return False


    def clear_existing_sent_waiting_tracker_rows_for_reply(self, reply_email):
        """Close older real-email rows that were only being shown as sent/waiting trackers.

        Sent tracking can be displayed in two ways:
        1) a separate Sent / Waiting placeholder row, and
        2) the original customer/vendor row re-activated to Waiting after the user sends a reply.

        clear_sent_waiting_placeholder_for_reply() handles #1. This handles #2 so that when a
        newer inbound reply arrives, the older "I sent this out" tracker row leaves the main
        active pane and the new reply becomes the item the user sees/acts on.
        """
        try:
            if not reply_email or reply_email.get("is_sent_waiting_placeholder"):
                return False
            reply_id = str(reply_email.get("entry_id", "") or "")
            conversation_id = str(reply_email.get("conversation_id", "") or "").strip()
            subject_key = self._normalized_thread_subject(reply_email.get("subject", ""))
            if not conversation_id and not subject_key:
                return False
            try:
                reply_ts = float(reply_email.get("received_timestamp", 0) or 0)
            except Exception:
                reply_ts = 0
            if not reply_ts:
                return False

            changed = False
            cleared_at = datetime.now().isoformat()
            waiting_party = ""  # v3.9.51: which side the cleared tracker was waiting on (Vendor/Customer)
            for tracked in list(getattr(self, "emails", []) or []):
                try:
                    if not isinstance(tracked, dict):
                        continue
                    if tracked.get("is_sent_waiting_placeholder"):
                        continue
                    tracked_id = str(tracked.get("entry_id", "") or "")
                    if tracked_id and tracked_id == reply_id:
                        continue
                    # Only close rows MaINbox explicitly woke up as sent-waiting trackers.
                    # This avoids completing normal/manual Waiting items that are unrelated to
                    # the sent-tracker feature.
                    if not tracked.get("sent_waiting_tracker_active"):
                        continue

                    same_thread = False
                    tracked_conv = str(tracked.get("conversation_id", "") or "").strip()
                    if conversation_id and tracked_conv and tracked_conv == conversation_id:
                        same_thread = True
                    elif subject_key and self._normalized_thread_subject(tracked.get("subject", "")) == subject_key:
                        same_thread = True
                    if not same_thread:
                        continue

                    try:
                        tracked_ts = float(tracked.get("sent_waiting_tracker_sent_timestamp", 0) or tracked.get("received_timestamp", 0) or 0)
                    except Exception:
                        tracked_ts = 0
                    # The response must be newer than the row/tracker it is clearing. Give Outlook
                    # a small clock/conversation-sync cushion so the original row cannot clear itself.
                    if tracked_ts and reply_ts <= (tracked_ts + 30):
                        continue

                    tracked["sent_waiting_tracker_active"] = False
                    tracked["sent_waiting_tracker_cleared_at"] = cleared_at
                    tracked["sent_waiting_tracker_cleared_by_entry_id"] = reply_id
                    tracked["sent_waiting_tracker_cleared_reason"] = "matching_reply_imported"
                    _orig_tracked_status = tracked.get("status")
                    if _orig_tracked_status == "Waiting on Vendor" and not waiting_party:
                        waiting_party = "Vendor"
                    elif _orig_tracked_status == "Waiting on Customer" and not waiting_party:
                        waiting_party = "Customer"
                    if _orig_tracked_status in ("Waiting on Vendor", "Waiting on Customer"):
                        tracked["status"] = "Completed"
                    tracked["is_new_import"] = False
                    self.save_record(tracked)
                    changed = True
                except Exception:
                    continue

            if changed:
                # v3.9.51: the inbound reply that just cleared a tracker is the response we were
                # waiting on -- flag it by intent so the next step is smooth (a question -> Needs
                # Reply; "working on it / I'll get back to you" -> Waiting on Vendor/Customer matching
                # who we sent to; a plain thanks -> Completed).
                self._flag_tracked_reply_by_intent(reply_email, waiting_party)
                self.flush_status_data()
                # Remove completed tracker rows from the default active pane immediately; they remain
                # available under Completed/search/history if the user needs them.
                self._rebuild_email_index()
                self.save_cached_state()
            return changed
        except Exception:
            return False

    def sweep_sent_waiting_trackers_against_loaded_replies(self):
        """Hard cleanup for Sent / Waiting trackers that already have a newer reply loaded.

        This covers the real-world Joanne case where both rows are visible/searchable:
        - a Sent / Waiting tracker row from the sent email, and
        - a newer inbound RE: row from the other person.

        The older cleanup depended on the incoming import event or the backing
        sent_waiting_placeholders list. If the reply was already in the cache/search list,
        or the visible tracker row was orphaned from that backing list, the row could sit
        in the main pane forever. This sweep compares every visible Sent / Waiting tracker
        against every loaded non-placeholder reply and removes/completes only trackers that
        have a clearly newer matching reply.
        """
        changed = False
        cleared_replies = 0
        try:
            rows = list(getattr(self, "emails", []) or [])
            if not rows:
                return 0

            def norm_subject(value):
                # Use the global normalizer here because it strips RE/FW/External prefixes
                # consistently for both sent placeholders and already-cached inbound replies.
                try:
                    return normalize_subject_for_match(value or "")
                except Exception:
                    try:
                        return self._normalized_thread_subject(value or "")
                    except Exception:
                        return str(value or "").strip().lower()

            def row_ts(row):
                """Return a sortable timestamp for sent/reply matching.

                Older cached rows can have only the display string (for example
                '2026-06-08 12:33 PM') and no received_timestamp. The earlier
                hard cleanup skipped those rows because timestamp was 0, which
                let old Sent / Waiting trackers stay visible even after the
                matching reply was already loaded.
                """
                if not isinstance(row, dict):
                    return 0.0
                for key in ("received_timestamp", "sent_timestamp", "sent_waiting_tracker_sent_timestamp"):
                    try:
                        value = row.get(key, 0)
                        if value not in (None, ""):
                            ts = float(value)
                            if ts > 0:
                                return ts
                    except Exception:
                        pass
                for key in ("received", "sent_on", "created_at", "updated_at"):
                    value = str(row.get(key, "") or "").strip()
                    if not value:
                        continue
                    # Drop timezone suffixes only for display-string fallback matching;
                    # we only need relative ordering inside the same Outlook mailbox.
                    value_clean = value.replace("T", " ")
                    value_clean = re.sub(r"\.\d+", "", value_clean)
                    value_clean = re.sub(r"(Z|[+-]\d{2}:?\d{2})$", "", value_clean).strip()
                    for fmt in (
                        "%Y-%m-%d %I:%M %p",
                        "%Y-%m-%d %H:%M",
                        "%Y-%m-%d %H:%M:%S",
                        "%m/%d/%Y %I:%M %p",
                        "%m/%d/%Y %H:%M",
                        "%m/%d/%y %I:%M %p",
                        "%m/%d/%y %H:%M",
                    ):
                        try:
                            return datetime.strptime(value_clean, fmt).timestamp()
                        except Exception:
                            continue
                    try:
                        return datetime.fromisoformat(value_clean).timestamp()
                    except Exception:
                        pass
                return 0.0

            replies = []
            for row in rows:
                if not isinstance(row, dict):
                    continue
                if row.get("is_sent_waiting_placeholder") or row.get("source") == "Sent / Waiting":
                    continue
                ts = row_ts(row)
                if not ts:
                    continue
                subj = norm_subject(row.get("subject", ""))
                conv = str(row.get("conversation_id", "") or "").strip()
                if not conv and not subj:
                    continue
                replies.append((row, conv, subj, ts))
            if not replies:
                return 0

            def matches_reply(tracker, reply_conv, reply_subj):
                tracker_conv = str(tracker.get("conversation_id", "") or "").strip()
                if tracker_conv and reply_conv and tracker_conv == reply_conv:
                    return True
                tracker_subj = norm_subject(tracker.get("subject", ""))
                if tracker_subj and reply_subj and tracker_subj == reply_subj:
                    return True
                return False

            now = datetime.now().isoformat()
            active_placeholder_ids = set()
            for placeholder in getattr(self, "sent_waiting_placeholders", []) or []:
                if not isinstance(placeholder, dict) or placeholder.get("cleared"):
                    continue
                sent_ts = row_ts(placeholder)
                if not sent_ts:
                    continue
                for reply, reply_conv, reply_subj, reply_ts in replies:
                    if reply_ts <= sent_ts + 30:
                        continue
                    if not matches_reply(placeholder, reply_conv, reply_subj):
                        continue
                    placeholder["cleared"] = True
                    placeholder["cleared_at"] = now
                    placeholder["cleared_by_entry_id"] = reply.get("entry_id", "")
                    placeholder["cleared_reason"] = "matching_reply_imported"
                    placeholder["cleared_reply_timestamp"] = reply_ts
                    pid = placeholder.get("entry_id", "")
                    if pid:
                        rec = self.status_data.get(pid, {}) if isinstance(self.status_data, dict) else {}
                        if isinstance(rec, dict):
                            rec.update({
                                "status": "Completed",
                                "sent_waiting_cleared": True,
                                "sent_waiting_cleared_at": now,
                                "sent_waiting_cleared_by_entry_id": reply.get("entry_id", ""),
                                "updated_at": now,
                            })
                            self.status_data[pid] = rec
                    changed = True
                    cleared_replies += 1
                    break

            for placeholder in getattr(self, "sent_waiting_placeholders", []) or []:
                if isinstance(placeholder, dict) and not placeholder.get("cleared"):
                    pid = placeholder.get("entry_id", "")
                    if pid:
                        active_placeholder_ids.add(pid)

            # Also remove orphaned visible Sent / Waiting rows even if their backing
            # placeholder record is missing/stale. This is intentionally limited to rows
            # explicitly marked as Sent / Waiting so normal Waiting-on-Vendor rows are not touched.
            kept = []
            for row in rows:
                if not isinstance(row, dict):
                    continue
                is_visible_tracker = bool(row.get("is_sent_waiting_placeholder") or row.get("source") == "Sent / Waiting")
                if not is_visible_tracker:
                    kept.append(row)
                    continue
                pid = row.get("entry_id", "")
                if row.get("is_sent_waiting_placeholder") and pid in active_placeholder_ids:
                    # Keep active placeholders unless a newer reply proves this visible row is stale.
                    pass
                sent_ts = row_ts(row)
                should_remove = False
                if sent_ts:
                    for reply, reply_conv, reply_subj, reply_ts in replies:
                        if reply_ts <= sent_ts + 30:
                            continue
                        if matches_reply(row, reply_conv, reply_subj):
                            should_remove = True
                            row["cleared"] = True
                            row["cleared_at"] = now
                            row["cleared_by_entry_id"] = reply.get("entry_id", "")
                            row["cleared_reason"] = "matching_reply_imported"
                            row["cleared_reply_timestamp"] = reply_ts
                            if pid:
                                rec = self.status_data.get(pid, {}) if isinstance(self.status_data, dict) else {}
                                if isinstance(rec, dict):
                                    rec.update({
                                        "status": "Completed",
                                        "sent_waiting_cleared": True,
                                        "sent_waiting_cleared_at": now,
                                        "sent_waiting_cleared_by_entry_id": reply.get("entry_id", ""),
                                        "updated_at": now,
                                    })
                                    self.status_data[pid] = rec
                            changed = True
                            cleared_replies += 1
                            break
                if not should_remove:
                    kept.append(row)

            if changed:
                self.emails = kept
                self._rebuild_email_index()
                try:
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
                try:
                    self.flush_status_data()
                except Exception:
                    pass
                try:
                    self.save_cached_state()
                except Exception:
                    pass
            return cleared_replies
        except Exception:
            return 0

    def assign_imported_reply_to_tracker_group(self, reply_email, tracker=None):
        """Put a rescued incoming reply into the same group as the waiting tracker it replaces.

        The normal auto-group path intentionally has safety guards (especially domain guards),
        but this path is different: the reply has already matched an active sent/waiting tracker
        by Outlook thread/subject and newer timestamp. In that case it should inherit the exact
        group from the tracker/original row so the old tracker can be replaced by the real reply
        inside the correct quote/job group.
        """
        try:
            if not isinstance(reply_email, dict) or not isinstance(tracker, dict):
                return False
            reply_id = str(reply_email.get("entry_id", "") or "").strip()
            if not reply_id or self.get_group_id_for_email(reply_id):
                return False

            candidates = []
            for key in ("entry_id", "tracked_entry_id", "original_entry_id", "source_entry_id", "parent_entry_id"):
                value = str(tracker.get(key, "") or "").strip()
                if value and value not in candidates:
                    candidates.append(value)

            group_id = ""
            for candidate_id in candidates:
                group_id = self.get_group_id_for_email(candidate_id)
                if group_id and self.get_group_by_id(group_id):
                    break

            # If the visible tracker row is grouped only by thread membership somewhere else,
            # use the existing thread resolver as a final safe fallback.
            if not group_id:
                group_id = self.find_group_id_for_thread(tracker, skip_entry_id=reply_id)
            if not group_id:
                group_id = self.find_group_id_for_thread(reply_email, skip_entry_id=reply_id)

            group = self.get_group_by_id(group_id) if group_id else None
            if not group:
                return False

            self.groups_data.setdefault("memberships", {})[reply_id] = group_id
            reply_email["thread_group_rule"] = "sent_waiting_tracker_group"
            reply_email["sent_waiting_tracker_group_id"] = group_id
            reply_email["sent_waiting_tracker_group_name"] = group.get("name", "")
            reply_email["sent_waiting_tracker_grouped_from_entry_id"] = candidates[0] if candidates else ""
            self.mark_group_has_new(group_id)
            self.save_groups()
            return True
        except Exception:
            return False

    def import_matching_inthread_reply_from_outlook(self, msg, folder_label="", tracker=None, silent=True):
        """Import a real inbound reply that matched an active Waiting/Sent tracker.

        v3.9.19 fix: Sales mailbox refresh normally honors the selected Outlook
        category, which is correct for new unrelated mail, but vendor replies can
        arrive uncategorized. If a reply is in the same thread as an active
        sent/waiting tracker, it must be imported even when the category filter
        would have skipped it; otherwise the old Waiting row remains visible and
        the user never sees the answer in MaINbox.
        """
        try:
            source_label = "Sales" if "sales" in str(folder_label or "").lower() else "My Inbox"
            email = self.build_email_data(msg, source_label)
            if not email:
                return False
            entry_id = str(email.get("entry_id", "") or "").strip()
            if not entry_id:
                return False
            already_loaded = bool(self.get_email_by_id(entry_id))
            is_new = self.upsert_email(email)
            try:
                self.assign_imported_reply_to_tracker_group(email, tracker=tracker)
            except Exception:
                pass
            try:
                self.suppress_my_inbox_duplicate_when_sales_copy_exists(email)
            except Exception:
                pass
            if is_new and email.get("urgency") != "Low":
                try:
                    self.handle_new_email_after_import(email, silent=silent)
                except Exception:
                    pass
                try:
                    scheduled_commitments = self.scan_outlook_message_for_commitments(msg, email, direction=source_label)
                    if scheduled_commitments:
                        email["followup_time"] = self.get_followup_display_for_email(email.get("entry_id", ""))
                except Exception:
                    pass
            if is_new or not already_loaded:
                try:
                    self.save_record(email)
                    self.flush_status_data()
                except Exception:
                    pass
            return bool(is_new or not already_loaded)
        except Exception:
            return False

    def scan_outlook_inbox_for_sent_waiting_thread_replies(self, max_items=80, lookback_days=7):
        """Bounded rescue scan for active Waiting/Sent trackers.

        v3.9.20 performance fix: v3.9.19 proved the right idea, but it could be
        too broad during Refresh because it scanned many Outlook messages against
        every active Waiting row. This version keeps the same behavior but only
        looks at recent, active tracker candidates and only imports a reply after
        a cheap thread/subject match is found.
        """
        running_flag = "_sent_waiting_thread_scan_running"
        last_flag = "_sent_waiting_thread_scan_last_at"
        try:
            if getattr(self, running_flag, False):
                return 0
            now_ts_guard = datetime.now().timestamp()
            last_ts_guard = float(getattr(self, last_flag, 0) or 0)
            # Refresh can call reconciliation several times; one bounded scan is enough.
            if last_ts_guard and (now_ts_guard - last_ts_guard) < 8:
                return 0
            setattr(self, running_flag, True)
            setattr(self, last_flag, now_ts_guard)
        except Exception:
            pass

        try:
            # v3.9.27 fix (the "ty reply never cleared the tracker" bug): the old caps
            # silently clamped the caller's max_items=160 down to 70 AND that budget was
            # shared across folders. My Inbox is scanned first, so on any busy mailbox it
            # consumed the entire budget and the Sales Inbox was NEVER reached. Replies
            # that live only in the Sales Inbox (uncategorized customer replies are not
            # imported by the category-filtered refresh) could then never clear their
            # tracker. The budget is now PER FOLDER and honors the caller up to 200.
            try:
                per_folder_max = max(15, min(int(max_items or 80), 200))
            except Exception:
                per_folder_max = 160
            try:
                lookback_days = max(1, min(int(lookback_days or 7), 14))
            except Exception:
                lookback_days = 7

            def norm_subject(value):
                try:
                    return normalize_subject_for_match(value or "")
                except Exception:
                    try:
                        return self._normalized_thread_subject(value or "")
                    except Exception:
                        return str(value or "").strip().lower()

            def parse_row_ts(row):
                if not isinstance(row, dict):
                    return 0.0
                for key in ("received_timestamp", "sent_timestamp", "sent_waiting_tracker_sent_timestamp"):
                    try:
                        value = row.get(key, 0)
                        if value not in (None, ""):
                            ts = float(value)
                            if ts > 0:
                                return ts
                    except Exception:
                        pass
                for key in ("received", "sent_on", "created_at", "updated_at"):
                    value = str(row.get(key, "") or "").strip()
                    if not value:
                        continue
                    value_clean = value.replace("T", " ")
                    value_clean = re.sub(r"\.\d+", "", value_clean)
                    value_clean = re.sub(r"(Z|[+-]\d{2}:?\d{2})$", "", value_clean).strip()
                    for fmt in ("%Y-%m-%d %I:%M %p", "%Y-%m-%d %H:%M", "%Y-%m-%d %H:%M:%S", "%m/%d/%Y %I:%M %p", "%m/%d/%Y %H:%M", "%m/%d/%y %I:%M %p", "%m/%d/%y %H:%M"):
                        try:
                            return datetime.strptime(value_clean, fmt).timestamp()
                        except Exception:
                            continue
                    try:
                        return datetime.fromisoformat(value_clean).timestamp()
                    except Exception:
                        pass
                return 0.0

            trackers = []
            cutoff_dt = datetime.now() - timedelta(days=lookback_days)
            cutoff_ts = cutoff_dt.timestamp()

            def add_tracker(kind, row):
                if not isinstance(row, dict):
                    return
                if row.get("cleared"):
                    return
                subj_key = norm_subject(row.get("subject", ""))
                conv_id = str(row.get("conversation_id", "") or row.get("sent_conversation_id", "") or row.get("sent_waiting_tracker_conversation_id", "") or "").strip()
                sent_ts = parse_row_ts(row)
                # Keep the rescue scan focused. Very old or keyless rows should not make
                # Refresh walk the whole mailbox.
                if sent_ts and sent_ts < cutoff_ts:
                    return
                if not subj_key and not conv_id:
                    return
                trackers.append({"kind": kind, "row": row, "ts": sent_ts, "subject_key": subj_key, "conversation_id": conv_id})

            for p in getattr(self, "sent_waiting_placeholders", []) or []:
                if isinstance(p, dict) and not p.get("cleared"):
                    add_tracker("placeholder", p)
            for row in getattr(self, "emails", []) or []:
                if not isinstance(row, dict):
                    continue
                if row.get("sent_waiting_tracker_active") or row.get("is_sent_waiting_placeholder") or row.get("source") == "Sent / Waiting":
                    add_tracker("row", row)
                elif row.get("status") in ("Waiting on Vendor", "Waiting on Customer") and row.get("urgency") != "Low":
                    add_tracker("waiting_row", row)

            if not trackers:
                return 0

            # Newest active trackers first and cap the total work. This avoids Refresh
            # hanging when old Waiting rows have accumulated.
            trackers.sort(key=lambda x: float(x.get("ts") or 0), reverse=True)
            trackers = trackers[:50]

            conv_map = {}
            subj_map = {}
            for t in trackers:
                if t.get("conversation_id"):
                    conv_map.setdefault(t["conversation_id"], []).append(t)
                if t.get("subject_key"):
                    subj_map.setdefault(t["subject_key"], []).append(t)

            outlook, namespace = self.fresh_outlook()
            if not namespace:
                return 0
            folders = self.coverage_inbox_folders_for_quote_scan(namespace)
            if not folders:
                try:
                    folders = [("My Inbox", namespace.GetDefaultFolder(6))]
                except Exception:
                    folders = []
            if not folders:
                return 0

            changed = False
            cleared = 0
            now = datetime.now().isoformat()
            seen_msg_ids = set()

            def clear_tracker(kind, tracker_row, reply_entry_id, reply_ts):
                nonlocal changed, cleared
                sent_ts = parse_row_ts(tracker_row)
                if sent_ts and reply_ts and reply_ts <= sent_ts + 30:
                    return False
                if kind == "placeholder" or tracker_row.get("is_sent_waiting_placeholder") or tracker_row.get("source") == "Sent / Waiting":
                    tracker_row["cleared"] = True
                    tracker_row["cleared_at"] = now
                    tracker_row["cleared_by_entry_id"] = reply_entry_id
                    tracker_row["cleared_reason"] = "bounded_outlook_thread_reply_found"
                    tracker_row["cleared_reply_timestamp"] = reply_ts
                    pid = tracker_row.get("entry_id", "")
                    if pid and isinstance(getattr(self, "status_data", None), dict):
                        rec = self.status_data.get(pid, {})
                        if isinstance(rec, dict):
                            rec.update({
                                "status": "Completed",
                                "sent_waiting_cleared": True,
                                "sent_waiting_cleared_at": now,
                                "sent_waiting_cleared_by_entry_id": reply_entry_id,
                                "sent_waiting_cleared_reason": "bounded_outlook_thread_reply_found",
                                "updated_at": now,
                            })
                            self.status_data[pid] = rec
                else:
                    tracker_row["sent_waiting_tracker_active"] = False
                    tracker_row["sent_waiting_tracker_cleared_at"] = now
                    tracker_row["sent_waiting_tracker_cleared_by_entry_id"] = reply_entry_id
                    tracker_row["sent_waiting_tracker_cleared_reason"] = "bounded_outlook_thread_reply_found"
                    if tracker_row.get("status") in ("Waiting on Vendor", "Waiting on Customer"):
                        tracker_row["status"] = "Completed"
                    tracker_row["is_new_import"] = False
                    try:
                        self.save_record(tracker_row)
                    except Exception:
                        pass
                changed = True
                cleared += 1
                return True

            total_checked = 0
            for folder_label, folder in folders:
                try:
                    items = folder.Items
                    try:
                        cut_str = cutoff_dt.strftime("%m/%d/%Y %I:%M %p")
                        items = items.Restrict(f"[ReceivedTime] >= '{cut_str}'")
                    except Exception:
                        pass
                    try:
                        items.Sort("[ReceivedTime]", True)
                    except Exception:
                        pass
                    folder_checked = 0
                    for msg in items:
                        # v3.9.27: per-folder budget. The old shared total made the first
                        # folder (My Inbox) starve the Sales Inbox entirely.
                        if folder_checked >= per_folder_max:
                            break
                        folder_checked += 1
                        total_checked += 1
                        try:
                            try:
                                recv_dt = msg.ReceivedTime.replace(tzinfo=None)
                            except Exception:
                                recv_dt = None
                            if recv_dt is not None and recv_dt < cutoff_dt:
                                break
                            recv_ts = recv_dt.timestamp() if recv_dt else datetime.now().timestamp()
                            try:
                                entry_id = str(msg.EntryID or "")
                            except Exception:
                                entry_id = ""
                            if entry_id and entry_id in seen_msg_ids:
                                continue
                            if entry_id:
                                seen_msg_ids.add(entry_id)
                            try:
                                subject = str(msg.Subject or "")
                            except Exception:
                                subject = ""
                            try:
                                conv_id = str(msg.ConversationID or "").strip()
                            except Exception:
                                conv_id = ""
                            subj_key = norm_subject(subject)
                            candidates = []
                            if conv_id and conv_id in conv_map:
                                candidates.extend(conv_map.get(conv_id, []))
                            if subj_key and subj_key in subj_map:
                                for t in subj_map.get(subj_key, []):
                                    if t not in candidates:
                                        candidates.append(t)
                            if not candidates:
                                continue

                            imported = False
                            for t in list(candidates):
                                row = t.get("row")
                                if not isinstance(row, dict) or row.get("cleared"):
                                    continue
                                sent_ts = float(t.get("ts") or parse_row_ts(row) or 0)
                                if sent_ts and recv_ts <= sent_ts + 30:
                                    continue
                                try:
                                    if entry_id and not imported:
                                        existing_reply = self.get_email_by_id(entry_id)
                                        if existing_reply:
                                            self.assign_imported_reply_to_tracker_group(existing_reply, tracker=row)
                                            imported = True
                                        else:
                                            self.import_matching_inthread_reply_from_outlook(msg, folder_label=folder_label, tracker=row, silent=True)
                                            imported = True
                                except Exception:
                                    pass
                                # v3.9.27: clear EVERY matching tracker for this reply. The old
                                # break-after-first left sibling trackers (e.g. a placeholder AND
                                # a re-activated real row for the same thread) sitting active.
                                clear_tracker(t.get("kind", "row"), row, entry_id, recv_ts)
                        except Exception:
                            continue
                except Exception:
                    continue

            if changed:
                active_ids = {p.get("entry_id", "") for p in getattr(self, "sent_waiting_placeholders", []) or [] if isinstance(p, dict) and not p.get("cleared")}
                self.emails = [
                    e for e in (getattr(self, "emails", []) or [])
                    if not (isinstance(e, dict) and (e.get("is_sent_waiting_placeholder") or e.get("source") == "Sent / Waiting") and e.get("entry_id", "") not in active_ids)
                ]
                try:
                    self._rebuild_email_index()
                except Exception:
                    pass
                try:
                    self.save_sent_waiting_placeholders()
                except Exception:
                    pass
                try:
                    self.flush_status_data()
                except Exception:
                    pass
                try:
                    self.save_cached_state()
                except Exception:
                    pass
            return cleared
        except Exception:
            return 0
        finally:
            try:
                setattr(self, running_flag, False)
            except Exception:
                pass

    def reconcile_sent_waiting_placeholders_against_replies(self):
        """Clear any active sent/waiting tracker that already has a newer in-thread reply in
        the loaded email list. The per-message clear during a scan only fires while a reply is
        first being imported; since Sent Items (which create the trackers) are scanned AFTER
        the inbox, a reply imported in the same cycle can miss its tracker and then fall outside
        the incremental scan window, so it is never re-checked. This sweep re-checks every loaded
        reply against the current trackers, reusing the same conversation/subject + timestamp
        matching, so a received response always clears its tracker regardless of scan ordering.

        Returns the number of replies that cleared at least one tracker (0 if none), so callers
        that gate a repaint on "did anything change" treat a reconciliation-only clear as a change."""
        cleared = 0
        try:
            placeholders = getattr(self, "sent_waiting_placeholders", [])
            has_active_placeholder = any(not p.get("cleared") for p in placeholders)
            has_active_real_row_tracker = any(
                isinstance(row, dict) and row.get("sent_waiting_tracker_active")
                for row in (getattr(self, "emails", []) or [])
            )
            # First run the hard sweep. It catches already-loaded replies and orphaned
            # visible Sent / Waiting rows, not just brand-new import events.
            cleared += int(self.sweep_sent_waiting_trackers_against_loaded_replies() or 0)
            # Then ask Outlook itself: for each active sent tracker, scan recent incoming
            # messages and link by the actual thread/conversation chain. This catches cases
            # where the reply exists in Outlook but was not present in the cached row list.
            cleared += int(self.scan_outlook_inbox_for_sent_waiting_thread_replies(max_items=160, lookback_days=14) or 0)
            if not has_active_placeholder and not has_active_real_row_tracker:
                return cleared
            for e in list(self.emails):
                if not e.get("is_sent_waiting_placeholder"):
                    placeholder_cleared = self.clear_sent_waiting_placeholder_for_reply(e)
                    row_cleared = self.clear_existing_sent_waiting_tracker_rows_for_reply(e)
                    if placeholder_cleared or row_cleared:
                        cleared += 1
            # One final sweep handles rows that became orphaned during the per-reply clear.
            cleared += int(self.sweep_sent_waiting_trackers_against_loaded_replies() or 0)
        except Exception:
            pass
        return cleared

    def infer_status_after_reply_sent(self, email, target_status_after_send=None):
        if target_status_after_send in ["Waiting on Customer", "Waiting on Vendor"]:
            return target_status_after_send
        current = email.get("status", "") if email else ""
        if current in ["Waiting on Customer", "Waiting on Vendor"]:
            return current
        category = (email.get("category", "") if email else "").lower()
        source = (email.get("source", "") if email else "").lower()
        subject = (email.get("subject", "") if email else "").lower()
        if "vendor" in category or "supplier" in category or "vendor" in source or "vendor" in subject:
            return "Waiting on Vendor"
        return "Waiting on Customer"

    def record_pending_reply_check(self, email, target_status_after_send=None, followup_source="manual"):
        if not email:
            return
        entry_id = email.get("entry_id", "")
        conversation_id = email.get("conversation_id", "")
        if not entry_id and not conversation_id:
            return
        existing_status = self.status_data.get(entry_id, {}) if entry_id else {}
        if entry_id and (existing_status.get("app_deleted") or existing_status.get("prevent_future_followups")):
            # Deleted-from-app items may still get one final kept follow-up, but
            # they should not start another sent-reply tracking cycle afterward.
            return
        target_status = self.infer_status_after_reply_sent(email, target_status_after_send)
        for item in self.pending_reply_checks:
            if item.get("completed") or item.get("cancelled"):
                continue
            if (entry_id and item.get("entry_id") == entry_id) or (conversation_id and item.get("conversation_id") == conversation_id):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Replaced by newer reply draft"
        self.pending_reply_checks.append({
            "entry_id": entry_id,
            "conversation_id": conversation_id,
            "store_id": email.get("store_id", ""),
            "subject": email.get("subject", ""),
            "created_at": datetime.now().isoformat(),
            "target_status_after_send": target_status,
            "category": email.get("category", ""),
            "urgency": email.get("urgency", ""),
            "source": followup_source,
            "completed": False,
            "cancelled": False,
        })
        self._followup_dedup_needed = True  # v3 efficiency: mark dirty.
        self.save_pending_reply_checks()

    def find_sent_reply_for_pending_check(self, pending):
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return None
        conversation_id = pending.get("conversation_id", "")
        if not conversation_id:
            return None
        try:
            created_at = datetime.fromisoformat(pending.get("created_at", "")) - timedelta(seconds=5)
        except Exception:
            created_at = datetime.now() - timedelta(days=1)
        try:
            sent_folder = namespace.GetDefaultFolder(5)  # olFolderSentMail
            items = sent_folder.Items
            items.Sort("[SentOn]", True)
            checked = 0
            for msg in items:
                if checked >= 150:
                    break
                checked += 1
                try:
                    sent_on = msg.SentOn
                    if sent_on and sent_on.replace(tzinfo=None) < created_at:
                        break
                    msg_conversation_id = ""
                    try:
                        msg_conversation_id = msg.ConversationID
                    except Exception:
                        msg_conversation_id = ""
                    if msg_conversation_id and msg_conversation_id == conversation_id:
                        return msg
                except Exception:
                    continue
        except Exception:
            return None
        return None

    def is_sent_message_thank_you_only(self, sent_msg):
        """Skip placeholder creation for simple thank-you/acknowledgement replies.

        Uses the restored Phase 1 Smart Followup intent detector instead of the
        old 7-term/260-char check, so punctuated acknowledgements and common
        short closers do not create unnecessary sent/waiting trackers.
        """
        try:
            subject = ""
            body = ""
            recipient = ""
            try:
                subject = sent_msg.Subject or ""
            except Exception:
                subject = ""
            try:
                body = sent_msg.Body or ""
            except Exception:
                body = ""
            try:
                recipient = sent_msg.To or ""
            except Exception:
                recipient = ""
            intent = analyze_reply_intent(subject=subject, body=body, sender_or_recipient=recipient, source="Sent Items", direction="outbound")
            return bool(intent.get("is_closed_ack"))
        except Exception:
            return False

    def get_sent_msg_time(self, sent_msg):
        try:
            if sent_msg.SentOn:
                return sent_msg.SentOn.replace(tzinfo=None)
        except Exception:
            pass
        return datetime.now()

    def find_existing_email_for_sent_message(self, sent_msg):
        """Find the MaINbox row/thread a sent Outlook message belongs to."""
        conversation_id = ""
        subject_key = ""
        try:
            conversation_id = sent_msg.ConversationID or ""
        except Exception:
            conversation_id = ""
        try:
            subject_key = self._normalized_thread_subject(sent_msg.Subject or "")
        except Exception:
            subject_key = ""
        best = None
        best_seen = -1
        for email in self.emails:
            if email.get("is_sent_waiting_placeholder"):
                continue
            same = False
            if conversation_id and email.get("conversation_id") == conversation_id:
                same = True
            elif subject_key and self._normalized_thread_subject(email.get("subject", "")) == subject_key:
                same = True
            if not same:
                continue
            seen = email.get("received_timestamp", 0) or email.get("sent_timestamp", 0) or 0
            try:
                seen = float(seen)
            except Exception:
                seen = 0
            if best is None or seen > best_seen:
                best = email
                best_seen = seen
        return best

    def sent_message_looks_like_business_tracker(self, sent_msg):
        """Allow brand-new sent RFQ/request emails to create a tracker row."""
        try:
            subject = ""
            body = ""
            try:
                subject = sent_msg.Subject or ""
            except Exception:
                subject = ""
            try:
                body = (sent_msg.Body or "")[:1200]
            except Exception:
                body = ""
            text = f"{subject}\n{body}".lower()
            markers = [
                "quote", "rfq", "request for quote", "price", "pricing",
                "availability", "lead time", "material", "can you quote",
                "please quote", "please provide", "send over", "vendor", "supplier",
                "estimate", "bid", "stock", "qty", "quantity"
            ]
            return any(m in text for m in markers)
        except Exception:
            return False

    def activate_existing_email_after_sent_message(self, email, sent_msg, target_status="Waiting on Vendor"):
        """If user replies from an existing/completed row, wake it up and show Waiting on Vendor."""
        if not email:
            return False
        try:
            changed = False
            if email.get("status") != target_status:
                email["status"] = target_status
                changed = True
            if email.get("urgency") == "Low" or not email.get("urgency"):
                email["urgency"] = "Normal"
                changed = True
            if email.get("category") in ("", "Junk / Ignore"):
                email["category"] = "Vendor / Supplier"
                changed = True
            email["is_new_import"] = False
            email["sent_waiting_tracker_active"] = True
            email["sent_waiting_tracker_updated_at"] = datetime.now().isoformat()
            try:
                email["sent_waiting_tracker_sent_timestamp"] = self.get_sent_msg_time(sent_msg).timestamp()
            except Exception:
                email["sent_waiting_tracker_sent_timestamp"] = datetime.now().timestamp()
            try:
                email["sent_waiting_tracker_sent_entry_id"] = sent_msg.EntryID or ""
            except Exception:
                pass
            try:
                email["sent_waiting_tracker_conversation_index"] = str(getattr(sent_msg, "ConversationIndex", "") or "")
            except Exception:
                pass
            try:
                pa = sent_msg.PropertyAccessor
                email["sent_waiting_tracker_internet_message_id"] = str(pa.GetProperty("http://schemas.microsoft.com/mapi/proptag/0x1035001F") or "")
            except Exception:
                pass
            # If it was previously removed from MaINbox only, restore visibility.
            entry_id = email.get("entry_id", "")
            if entry_id:
                existing = self.status_data.get(entry_id, {})
                if existing.get("app_deleted"):
                    existing["app_deleted"] = False
                    existing.pop("deleted_from_app_at", None)
                    self.status_data[entry_id] = existing
                    changed = True
            self.save_record(email)
            return changed
        except Exception:
            return False

    def scan_recent_sent_waiting_trackers(self, max_items=80, lookback_days=10):
        """Scan recent Sent Items so manual Outlook sends also create/update trackers.

        v2.10.8 behavior:
        - If user sends a reply in an existing MaINbox thread, even if it was Completed/Low,
          the existing row becomes Waiting on Vendor unless the sent message is only a thank-you.
        - If user sends a brand-new RFQ/request, a Sent / Waiting placeholder appears in the main list.
        """
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return 0
        changed_count = 0
        cutoff = datetime.now() - timedelta(days=lookback_days)
        _cov_debug(f"=== SENT SCAN start (coverage-debug build) max_items={max_items} lookback_days={lookback_days} cutoff={cutoff.isoformat()} ===")
        processed = set()
        self._begin_commitment_batch()  # v3.8.23: coalesce per-message commitment/cache writes
        try:
            processed = set(getattr(self, "sent_waiting_processed_sent_ids", []) or [])
        except Exception:
            processed = set()
        try:
            sent_folder = namespace.GetDefaultFolder(5)  # olFolderSentMail
            items = sent_folder.Items
            items.Sort("[SentOn]", True)
            try:
                _fp = ""
                try:
                    _fp = sent_folder.FolderPath
                except Exception:
                    _fp = getattr(sent_folder, "Name", "?")
                _cov_debug(f"  SENT FOLDER scanned: {_fp!r}  total_items={items.Count}")
                _n = 0
                for _it in items:
                    try:
                        _cov_debug(f"    newest[{_n}]: subj={getattr(_it, 'Subject', '')!r} sent={self.get_sent_msg_time(_it).isoformat()}")
                    except Exception:
                        pass
                    _n += 1
                    if _n >= 8:
                        break
            except Exception as _e:
                _cov_debug(f"  SENT FOLDER diag exception: {_e!r}")
            checked = 0
            for msg in items:
                if checked >= max_items:
                    break
                checked += 1
                try:
                    sent_on = self.get_sent_msg_time(msg)
                    if sent_on < cutoff:
                        break
                    sent_entry_id = ""
                    try:
                        sent_entry_id = msg.EntryID or ""
                    except Exception:
                        sent_entry_id = ""
                    # Re-process existing conversations if needed. v3.8.12: do NOT skip the
                    # whole Sent item just because sent-waiting tracking already handled it;
                    # the ETA/lead-time commitment scanner has its own processed list.
                    already_tracker_processed = bool(sent_entry_id and sent_entry_id in processed)
                    try:
                        msg_subject = getattr(msg, "Subject", "") or ""
                    except Exception:
                        msg_subject = ""
                    try:
                        msg_body = getattr(msg, "Body", "") or ""
                    except Exception:
                        msg_body = ""
                    try:
                        msg_to = getattr(msg, "To", "") or ""
                    except Exception:
                        msg_to = ""
                    reply_intent = analyze_reply_intent(subject=msg_subject, body=msg_body, sender_or_recipient=msg_to, source="Sent Items", direction="outbound")
                    _msg_priced = bool(re.search(r"\$\s*\d|\b\d+\.\d{2}\b", msg_body or ""))
                    if _msg_priced:
                        _cov_debug(f"SENT-PRICED subj={msg_subject!r} sent_on={sent_on.isoformat()} closed_ack={bool(reply_intent.get('is_closed_ack'))} already_processed={already_tracker_processed}")
                    if reply_intent.get("is_closed_ack"):
                        # A pure thank-you makes no tracker -- but a thank-you that carries
                        # line-item pricing is still a quote, so let the coverage hook record it
                        # before we skip the tracker logic for this message. (v3.9.4)
                        if _msg_priced:
                            _cov_debug("  closed-ack BUT priced -> routing to quote coverage hook")
                            try:
                                _cid = ""
                                try:
                                    _cid = msg.ConversationID or ""
                                except Exception:
                                    _cid = ""
                                self.update_coverage_quoted_from_sent(
                                    conversation_id=_cid, subject=msg_subject, body=msg_body,
                                    sent_entry_id=sent_entry_id, sent_on=sent_on.isoformat())
                            except Exception:
                                pass
                        if sent_entry_id:
                            processed.add(sent_entry_id)
                        # v3.9.70: a pure thank-you/ack closes the loop. Before skipping
                        # tracker creation, close the matching INBOUND thread so it does
                        # not linger as Needs Reply / Waiting after we have acked. Only an
                        # open, non-user-locked row is touched. If that thread is a won/
                        # closed deal in a group, surface the archive Cleanup too (deduped).
                        try:
                            _ex = self.find_existing_email_for_sent_message(msg)
                            if (_ex and not _ex.get("ai_user_locked")
                                    and _ex.get("status") in ("Needs Reply", "Waiting on Customer", "Waiting on Vendor", "New", "")):
                                _ex["status"] = "Completed"
                                _ex["ai_triaged_at"] = datetime.now().isoformat()
                                _ex["ai_triage_pending"] = False
                                self.save_record(_ex)
                                try:
                                    if self.get_group_id_for_email(_ex.get("entry_id", "")):
                                        self.load_body_for_rfq(_ex)
                                        _cl, _ph, _kd = self._email_request_is_closed(_ex)
                                        if _cl:
                                            self._assistant_propose_cleanup(_ex, _ph, _kd)
                                except Exception:
                                    pass
                        except Exception:
                            pass
                        continue

                    existing_email = self.find_existing_email_for_sent_message(msg)
                    created_or_updated = False
                    placeholder = None
                    if already_tracker_processed:
                        # Tracker was already handled by an older refresh; leave statuses alone
                        # but still allow the commitment scanner below to run once.
                        pass
                    elif existing_email:
                        # Use the existing row's direction/category instead of forcing every
                        # sent tracker to Waiting on Vendor. Smart Followup may override when
                        # the sent text explicitly says we are waiting on a vendor/customer.
                        target_status = reply_intent.get("status") if reply_intent.get("is_waiting") else ""
                        if target_status not in ["Waiting on Vendor", "Waiting on Customer"]:
                            target_status = self.infer_status_after_reply_sent(existing_email)
                        if self.activate_existing_email_after_sent_message(existing_email, msg, target_status):
                            created_or_updated = True
                        # Smart Followup learning must reinforce whenever the sent reply
                        # clearly indicates we are waiting on a vendor/customer, even if the
                        # row was already in the correct status (in that case activate_*
                        # returns False, and the old code skipped learning here). The
                        # processed-sent-ID set above guarantees each sent message only
                        # teaches once, so this cannot inflate confidence on repeated scans.
                        if reply_intent.get("is_waiting") and target_status in ("Waiting on Vendor", "Waiting on Customer"):
                            behavior = "wait_for_vendor" if target_status == "Waiting on Vendor" else "wait_for_customer"
                            minutes = VENDOR_NO_RESPONSE_MINUTES if target_status == "Waiting on Vendor" else CUSTOMER_PO_FOLLOWUP_MINUTES
                            self.learn_followup_behavior(existing_email, behavior, minutes, "Smart Followup: sent reply intent is waiting.")
                        # v3.9.27 duplicate fix: the activated real row IS the tracker now
                        # (status=Waiting + sent_waiting_tracker_* fields). The old code ALSO
                        # created a separate "Sent / Waiting" placeholder here, so every sent
                        # reply in an existing thread showed TWO waiting rows for the same
                        # thing in the main pane. One tracker per thread: real row wins. Any
                        # older saved placeholder for this conversation is retired below in
                        # sync_sent_waiting_placeholders_into_email_list().
                        placeholder = None
                    elif not already_tracker_processed:
                        # Brand-new outgoing RFQ/request that did not start from an imported row.
                        if self.sent_message_looks_like_business_tracker(msg) or reply_intent.get("needs_tracker"):
                            target_status = reply_intent.get("status") if reply_intent.get("status") in ["Waiting on Vendor", "Waiting on Customer"] else "Waiting on Vendor"
                            pending = {
                                "category": reply_intent.get("category") or "Vendor / Supplier",
                                "urgency": "Normal",
                                "subject": msg_subject,
                                "sent_entry_id": sent_entry_id,
                                "sent_on": sent_on.isoformat(),
                                "reply_intent": reply_intent.get("intent", ""),
                            }
                            placeholder = self.make_sent_waiting_placeholder(msg, pending, target_status)
                            if self.add_or_update_sent_waiting_placeholder(placeholder):
                                created_or_updated = True

                    if created_or_updated:
                        changed_count += 1
                    # v3.8.10: scan the sent message for dated commitments (ship/ETA,
                    # quote expiration, backorder, callbacks, payment due, etc.).
                    try:
                        commit_target = existing_email or (placeholder if isinstance(placeholder, dict) else None)
                        if commit_target:
                            scheduled_commitments = self.scan_outlook_message_for_commitments(msg, commit_target, direction="Sent")
                            if scheduled_commitments:
                                changed_count += scheduled_commitments
                    except Exception:
                        pass
                    # v3.9.1: parse this sent reply for quoted line items and mark them
                    # covered on the matching coverage thread. Self-guards: no-op unless the
                    # thread already has requested items, and dedupes per sent EntryID.
                    try:
                        msg_conv_id = ""
                        try:
                            msg_conv_id = msg.ConversationID or ""
                        except Exception:
                            msg_conv_id = ""
                        # v3.9.54: only run the quote-matcher on a sent message that actually
                        # carries pricing. Without this gate an outgoing RFQ (a request with no
                        # prices) was parsed as a "quote" -- and because no line carries a price,
                        # the no-priced-lines fallback inside update_coverage_quoted_from_sent
                        # kept every parsed line -- wrongly marking the customer's OWN requested
                        # items as Quoted. The other two callers of this hook already gate on price.
                        if re.search(r"\$\s*\d|\b\d+\.\d{2}\b", msg_body or ""):
                            self.update_coverage_quoted_from_sent(
                                conversation_id=msg_conv_id,
                                subject=msg_subject,
                                body=msg_body,
                                sent_entry_id=sent_entry_id,
                                sent_on=sent_on.isoformat(),
                            )
                        # v3.9.4: if this sent item is an OUTGOING request (RFQ you sent out),
                        # move the matching customer's requested items to "Waiting".
                        self.update_coverage_waiting_from_request(
                            subject=msg_subject,
                            body=msg_body,
                            sent_entry_id=sent_entry_id,
                            sent_on=sent_on.isoformat(),
                        )
                    except Exception:
                        pass
                    if sent_entry_id:
                        processed.add(sent_entry_id)
                except Exception:
                    continue
        except Exception:
            try:
                self._flush_commitment_batch()
            except Exception:
                pass
            return changed_count

        try:
            self.sent_waiting_processed_sent_ids = list(processed)[-1000:]
        except Exception:
            pass
        # v3.8.23: close the batch. A scan that detected commitments (or marked a
        # message processed) set _commitment_batch_cache_dirty; combined with the
        # changed_count save below this resolves to a single save_cached_state().
        batch_touched_cache = bool(getattr(self, "_commitment_batch_cache_dirty", False))
        if changed_count:
            self.sync_sent_waiting_placeholders_into_email_list()
            self.flush_status_data()
            self.save_sent_waiting_placeholders()
            self._commitment_batch_cache_dirty = True  # fold the tracker's own cache save into the flush
        self._flush_commitment_batch()
        if not changed_count and batch_touched_cache:
            # commitments were created but no tracker change; flush already wrote cache.
            pass
        # v3.8.38: Sent Items are scanned AFTER the inbox, so a reply imported earlier in the
        # same cycle can miss its just-created tracker (the per-message clear only fires while
        # the reply is being imported, after which it ages out of the incremental scan window).
        # Reconcile every loaded reply against the trackers so a received response always
        # clears its tracker, regardless of scan ordering.
        cleared_count = self.reconcile_sent_waiting_placeholders_against_replies()
        return changed_count + cleared_count

    def coverage_inbox_folders_for_quote_scan(self, namespace=None):
        """Return all inbound folders that can receive vendor quotes.

        The first v3.9.4 scanner only looked at the default Inbox. In real use, vendor
        quote replies may land in the shared Sales mailbox, so coverage stayed at Waiting
        even though the reply was imported elsewhere in MaINbox. Keep this folder list
        narrow (My Inbox + Sales Inbox) and dedupe by EntryID/FolderPath to avoid double scans.
        """
        folders = []
        seen = set()

        def add_folder(folder, label):
            if not folder:
                return
            try:
                key = str(getattr(folder, "EntryID", "") or "")
            except Exception:
                key = ""
            if not key:
                try:
                    key = str(getattr(folder, "FolderPath", "") or getattr(folder, "Name", "") or label)
                except Exception:
                    key = label
            if key in seen:
                return
            seen.add(key)
            folders.append((label, folder))

        try:
            if namespace:
                add_folder(namespace.GetDefaultFolder(6), "My Inbox")  # olFolderInbox
        except Exception:
            pass
        try:
            add_folder(self.find_sales_inbox_folder_safe(), "Sales Inbox")
        except Exception:
            pass
        return folders

    def _attachment_quote_text_from_msg(self, msg, max_atts=10):
        """Extract text from a live Outlook message's DOCUMENT attachments (PDF, Excel,
        CSV, Word, text) so a vendor quote sent as a PDF can be read for Quote Coverage.
        Returns concatenated text, or '' when there are no document attachments or on any
        failure. Reuses the same temp-save + best-effort text/OCR path the RFQ scanner
        uses, and always cleans up its temp folder. A cheap extension pass runs first so
        no temp folder is created unless a real document is actually attached."""
        try:
            atts = msg.Attachments
            count = int(getattr(atts, "Count", 0) or 0)
        except Exception:
            return ""
        if count <= 0:
            return ""
        doc_exts = (".pdf", ".xlsx", ".xls", ".csv", ".doc", ".docx", ".txt", ".rtf")
        candidates = []
        for i in range(1, min(count, max_atts) + 1):
            try:
                att = atts.Item(i)
                fname = safe_filename_piece(getattr(att, "FileName", "") or f"attachment_{i}", f"attachment_{i}")
                if os.path.splitext(fname)[1].lower() not in doc_exts:
                    continue
                if outlook_attachment_is_inline(att):
                    continue
                candidates.append((att, fname))
            except Exception:
                continue
        if not candidates:
            return ""
        text_parts = []
        temp_root = ""
        try:
            temp_root = tempfile.mkdtemp(prefix="mainbox_cov_")
            for att, fname in candidates:
                try:
                    path = os.path.join(temp_root, fname)
                    att.SaveAsFile(path)
                    if not os.path.exists(path):
                        continue
                    t = read_text_from_file_best_effort(path)
                    if t and t.strip():
                        text_parts.append("\n--- Attachment: %s ---\n%s" % (fname, t[:18000]))
                except Exception:
                    continue
        except Exception:
            return ""
        finally:
            try:
                if temp_root and os.path.isdir(temp_root):
                    shutil.rmtree(temp_root, ignore_errors=True)
            except Exception:
                pass
        return "\n".join(text_parts)

    def scan_recent_inbox_for_quotes(self, max_items=150, lookback_days=14):
        """v3.9.5: Vendor pricing arrives inbound -- in My Inbox OR shared Sales Inbox.
        Scan both folders for priced vendor replies; any priced reply whose line items match a
        coverage record's requested items flips those items to Quoted. Linking/gating is handled
        by update_coverage_quoted_from_sent, so this remains conservative and idempotent."""
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return 0
        marked = 0
        # v3.9.74: only pay to read PDF/Excel attachments when coverage is actually in use
        # (some thread still has requested items). Cheap one-time check before the folder walk.
        threads_now = (getattr(self, "quote_coverage", {}) or {}).get("threads", {})
        open_cov = any(isinstance(r, dict) and r.get("requested") for r in threads_now.values())
        cutoff = datetime.now() - timedelta(days=lookback_days)
        _cov_debug(f"=== INBOX QUOTE SCAN start max_items={max_items} lookback_days={lookback_days} cutoff={cutoff.isoformat()} ===")
        folders = self.coverage_inbox_folders_for_quote_scan(namespace)
        if not folders:
            _cov_debug("INBOX QUOTE SCAN: no inbound folders available")
            return 0
        seen_message_ids = set()
        for folder_label, inbox in folders:
            try:
                try:
                    folder_path = str(getattr(inbox, "FolderPath", "") or getattr(inbox, "Name", "") or folder_label)
                except Exception:
                    folder_path = folder_label
                _cov_debug(f"INBOX QUOTE SCAN folder={folder_label!r} path={folder_path!r}")
                items = inbox.Items
                # v3.9.6: trim to the recent window BEFORE reading any message bodies, so a large
                # or uncached shared mailbox isn't fully walked (150+ body reads) on every scan.
                # Restrict can fail on some stores/providers -> fall back to the full collection.
                try:
                    _cut_str = cutoff.strftime("%m/%d/%Y %I:%M %p")
                    items = items.Restrict(f"[ReceivedTime] >= '{_cut_str}'")
                except Exception:
                    pass
                try:
                    items.Sort("[ReceivedTime]", True)
                except Exception:
                    pass
                checked = 0
                for msg in items:
                    if checked >= max_items:
                        break
                    checked += 1
                    try:
                        try:
                            recv_dt = msg.ReceivedTime.replace(tzinfo=None)
                        except Exception:
                            recv_dt = None
                        if recv_dt is not None and recv_dt < cutoff:
                            break
                        try:
                            entry_id = msg.EntryID or ""
                        except Exception:
                            entry_id = ""
                        if entry_id and entry_id in seen_message_ids:
                            continue
                        if entry_id:
                            seen_message_ids.add(entry_id)
                        try:
                            body = msg.Body or ""
                        except Exception:
                            body = ""
                        try:
                            subj = msg.Subject or ""
                        except Exception:
                            subj = ""
                        has_price = bool(re.search(r"\$\s*\d|\b\d+\.\d{2}\b", body))
                        # v3.9.74: vendor quotes often arrive as a PDF/Excel with NO price in the
                        # email body, so the old body-price pre-filter dropped them entirely. When
                        # coverage is in use and the message reads like a quote, pull text from its
                        # document attachments so those line items can flip requested -> Quoted.
                        # Body-priced mail keeps its fast path; attachment text is added on top.
                        attach_text = ""
                        if open_cov and re.search(r"quot|pric|avail|p&a|proposal|estimat", (subj + " " + body).lower()):
                            try:
                                attach_text = self._attachment_quote_text_from_msg(msg)
                            except Exception:
                                attach_text = ""
                        if not has_price and not attach_text:
                            continue
                        try:
                            conv_id = msg.ConversationID or ""
                        except Exception:
                            conv_id = ""
                        _cov_debug(f"INBOX-CANDIDATE folder={folder_label!r} subj={subj!r} body_priced={has_price} attach_chars={len(attach_text)} recv={(recv_dt.isoformat() if recv_dt else '?')}")
                        added = self.update_coverage_quoted_from_sent(
                            conversation_id=conv_id, subject=subj, body=body, attachment_text=attach_text,
                            sent_entry_id=entry_id, sent_on=(recv_dt.isoformat() if recv_dt else datetime.now().isoformat()))
                        if added:
                            marked += added
                    except Exception:
                        continue
            except Exception as _e:
                _cov_debug(f"INBOX QUOTE SCAN folder exception {folder_label!r}: {_e!r}")
        return marked

    def check_pending_sent_replies(self):
        manual_sent_updates = 0
        try:
            manual_sent_updates = self.scan_recent_sent_waiting_trackers(max_items=50, lookback_days=7)
        except Exception:
            manual_sent_updates = 0
        if not getattr(self, "pending_reply_checks", None):
            if manual_sent_updates:
                self.sort_emails_for_display()
                self.render_email_rows()
                try:
                    self.render_group_rows()
                except Exception:
                    pass
            return manual_sent_updates
        changed = False
        completed_count = 0
        self._begin_placeholder_batch()  # v3.8.24: coalesce per-reply placeholder writes/syncs
        for pending in self.pending_reply_checks:
            if pending.get("completed") or pending.get("cancelled"):
                continue
            email = self.get_email_by_id(pending.get("entry_id", "")) or self.find_email_for_followup_item(pending)
            if email and self.email_is_completed(email):
                pending["cancelled"] = True
                pending["cancelled_at"] = datetime.now().isoformat()
                pending["cancel_reason"] = "Cancelled automatic tracking: email marked Completed"
                changed = True
                continue
            sent_msg = self.find_sent_reply_for_pending_check(pending)
            if not sent_msg:
                continue
            if self.is_sent_message_thank_you_only(sent_msg):
                if email:
                    email["status"] = "Completed"
                    email["followup_time"] = ""
                    email["is_new_import"] = False
                    email["sent_waiting_tracker_active"] = False
                    email["smart_followup_closed_reason"] = "Simple thank-you/acknowledgement reply sent."
                    self.save_record(email)
                pending["completed"] = True
                pending["completed_at"] = datetime.now().isoformat()
                pending["completed_reason"] = "simple_ack_reply_found_in_sent_items"
                completed_count += 1
                changed = True
                continue
            if email:
                email["status"] = pending.get("target_status_after_send", "Waiting on Customer")
                email["followup_time"] = ""
                email["is_new_import"] = False
                email["sent_waiting_tracker_active"] = True
                email["sent_waiting_tracker_updated_at"] = datetime.now().isoformat()
                try:
                    email["sent_waiting_tracker_sent_timestamp"] = self.get_sent_msg_time(sent_msg).timestamp()
                except Exception:
                    email["sent_waiting_tracker_sent_timestamp"] = datetime.now().timestamp()
                self.save_record(email)
            # v3.9.27 duplicate fix: only create the separate "Sent / Waiting" placeholder
            # row when there is NO real row to carry the tracker. The old code created it
            # alongside the activated real row, showing two waiting rows for one send.
            if not email:
                placeholder_status = pending.get("target_status_after_send", "Waiting on Vendor")
                if placeholder_status in ["Waiting on Vendor", "Waiting on Customer"]:
                    placeholder = self.make_sent_waiting_placeholder(sent_msg, pending, placeholder_status)
                    self.add_or_update_sent_waiting_placeholder(placeholder)
            pending["completed"] = True
            pending["completed_at"] = datetime.now().isoformat()
            pending["completed_reason"] = "reply_found_in_sent_items"
            completed_count += 1
            changed = True
        self._flush_placeholder_batch()  # v3.8.24: single placeholder write + single resync
        if changed:
            self.flush_status_data()
            self.save_pending_reply_checks()
            self.save_cached_state()
            self.sort_emails_for_display()
            self.render_email_rows()
            try:
                self.render_group_rows()
            except Exception:
                pass
            self.followup_status_var.set(f"Follow-ups: sent reply detected, moved {completed_count} item(s) to waiting status")
        return completed_count

    def create_reply_draft_with_message(self, email, message_text, require_thread=False, target_status_after_send=None, followup_source="manual"):
        self.draft_busy = True
        msg = self.get_message_object(email)
        if not msg:
            self.draft_busy = False
            messagebox.showerror("Draft Error", "Could not reopen this email from Outlook. Try Refresh or Update.")
            return False
        try:
            html_message = html_escape_basic(message_text)
            try:
                reply = msg.Reply()
                self.display_outlook_item_foreground(reply)
                reply.HTMLBody = f"<p>{html_message}</p><br>" + reply.HTMLBody
                self.display_outlook_item_foreground(reply)
                self.root.after(500, lambda r=reply: self.bring_outlook_inspector_to_front(r))
                self.root.after(1200, lambda r=reply: self.bring_outlook_inspector_to_front(r))
            except Exception as reply_error:
                if require_thread:
                    self.draft_busy = False
                    messagebox.showerror("Threaded Reply Error", f"Outlook could not create a threaded reply for this item.\n\n{reply_error}")
                    return False
                outlook, namespace = self.fresh_outlook()
                if not outlook:
                    raise Exception("Could not reconnect to Outlook.Application")
                reply = outlook.CreateItem(0)
                sender_email = self.get_sender_email(msg)
                subject = email.get("subject", "")
                if not subject.lower().startswith("re:"):
                    subject = "RE: " + subject
                reply.To = sender_email
                reply.Subject = subject
                reply.HTMLBody = f"<p>{html_message}</p><br>"
                self.display_outlook_item_foreground(reply)
                self.root.after(500, lambda r=reply: self.bring_outlook_inspector_to_front(r))
                self.root.after(1200, lambda r=reply: self.bring_outlook_inspector_to_front(r))
            # Draft was created/opened. Until we can confirm the reply was actually sent,
            # this item should remain Needs Reply. A background sent-items check will move
            # it to Waiting on Customer/Vendor after the sent reply is detected.
            self.record_pending_reply_check(email, target_status_after_send, followup_source)
            email["status"] = "Needs Reply"
            email["is_new_import"] = False
            self.save_record(email)
            self.flush_status_data()
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.save_cached_state()
            self.draft_busy = False
            return True
        except Exception as e:
            self.draft_busy = False
            messagebox.showerror("Draft Error", f"Could not create draft.\n\n{e}")
            return False

    def create_ai_draft_reply(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return

        jobs = []
        total = len(selected_emails)
        for index, email in enumerate(selected_emails, start=1):
            try:
                body = self.load_body_if_needed(email)
            except Exception:
                body = email.get("body", "") or ""
            fallback = get_followup_message(email.get("category", "General"))
            jobs.append({
                "entry_id": email.get("entry_id", ""),
                "subject": email.get("subject", ""),
                "sender": email.get("sender", ""),
                "body": body,
                "category": email.get("category", "General"),
                "urgency": email.get("urgency", "Normal"),
                "status": email.get("status", "New"),
                "fallback": fallback,
            })
            if total == 1:
                self.render_body_preview(
                    email,
                    body,
                    extra_status="AI Reply clicked: body loaded into preview/cache. Drafting in background..."
                )

        self.save_cached_state()

        def worker(cancel_event):
            results = []
            for job in jobs:
                if cancel_event.is_set():
                    return {"cancelled": True, "results": results}
                ai_result = ask_ollama_for_reply(
                    subject=job["subject"],
                    sender=job["sender"],
                    body=job["body"],
                    category=job["category"],
                    urgency=job["urgency"],
                    status=job["status"],
                )
                text = job["fallback"]
                source = "template fallback"
                timing = ""
                if ai_result:
                    text = ai_result.get("text") if isinstance(ai_result, dict) else str(ai_result)
                    source = "Ollama"
                    if isinstance(ai_result, dict) and ai_result.get("total_duration"):
                        total_s = ai_result.get("total_duration", 0) / 1_000_000_000
                        load_s = (ai_result.get("load_duration") or 0) / 1_000_000_000
                        timing = f"{total_s:.1f}s / load {load_s:.1f}s"
                results.append({
                    "entry_id": job["entry_id"],
                    "message": text,
                    "source": source,
                    "timing": timing,
                })
            return {"cancelled": False, "results": results}

        def success(result):
            if result.get("cancelled"):
                self.ai_status_var.set("AI: draft generation cancelled")
                self.preview_text.insert(tk.END, "\nAI draft generation cancelled before opening remaining drafts.")
                return
            created = 0
            fallback_count = 0
            for row in result.get("results", []):
                email = self.get_email_by_id(row.get("entry_id", ""))
                if not email:
                    continue
                if row.get("source") != "Ollama":
                    fallback_count += 1
                if self.create_reply_draft_with_message(email, row.get("message", ""), require_thread=True):
                    created += 1
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(
                tk.END,
                f"Created {created} threaded draft(s).\n\n"
                f"AI source: {len(result.get('results', [])) - fallback_count} Ollama / {fallback_count} template fallback.\n"
                "The AI work ran in the background so the app should stay usable."
            )
            self.ai_status_var.set("AI: draft complete")

        def error(exc, tb):
            self.ai_status_var.set("AI: fallback after error")
            if messagebox.askyesno("AI Error", f"Ollama failed or timed out, but MaINbox is still usable.\n\nCreate template draft(s) instead?\n\n{exc}"):
                created = 0
                for job in jobs:
                    email = self.get_email_by_id(job.get("entry_id", ""))
                    if email and self.create_reply_draft_with_message(email, job.get("fallback", ""), require_thread=True):
                        created += 1
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, f"Created {created} template fallback draft(s) after AI error.")

        self.start_ai_task("drafting reply", worker, success, error)

    def create_urgent_ack_drafts(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return
        urgent_emails = [email for email in selected_emails if email.get("urgency") in ["High", "Critical"]]
        if not urgent_emails:
            answer = messagebox.askyesno("No High/Critical Selected", "None of the selected emails are marked High or Critical.\n\nCreate acknowledgment draft(s) anyway?")
            if not answer:
                return
            urgent_emails = selected_emails
        created = 0
        for email in urgent_emails:
            message = self.generate_reply_text(email, prefer_ai=True)
            if self.create_reply_draft_with_message(email, message, require_thread=True):
                created += 1
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Created {created} AI/threaded urgent acknowledgment draft(s).")


    def active_followup_count(self):
        manual = len([f for f in self.followups if not f.get("completed") and not f.get("cancelled")])
        scenarios = 0
        for f in self.scenario_reminders:
            if f.get("completed") or f.get("cancelled"):
                continue
            email = self.find_email_for_followup_item(f)
            if email and self.email_is_completed(email):
                continue
            scenarios += 1
        commitments = 0
        for f in getattr(self, "commitment_reminders", []):
            if f.get("completed") or f.get("cancelled"):
                continue
            email = self.find_email_for_followup_item(f)
            if email and self.email_is_completed(email):
                continue
            commitments += 1
        return manual + scenarios + commitments

    def format_due_display(self, due_at_raw):
        try:
            due_at = datetime.fromisoformat(due_at_raw)
            return due_at.strftime("%m/%d %I:%M %p")
        except Exception:
            return "Unknown"

    def find_email_for_followup_item(self, item):
        entry_id = item.get("entry_id", "")
        if entry_id:
            email = self.get_email_by_id(entry_id)
            if email:
                return email
        conversation_id = item.get("conversation_id", "")
        if conversation_id:
            for email in self.emails:
                if email.get("conversation_id") == conversation_id:
                    return email
        group_id = item.get("group_id", "")
        if group_id:
            for email in self.emails:
                if self.get_group_id_for_email(email.get("entry_id", "")) == group_id:
                    return email

        # If the user deleted the item from MaINbox but chose to keep its
        # follow-up, keep a safe snapshot so that one final follow-up can still
        # be reviewed/deployed without putting the email back into the main list.
        try:
            snapshot = item.get("deleted_email_snapshot")
            if isinstance(snapshot, dict) and snapshot.get("entry_id"):
                safe = dict(snapshot)
                safe.pop("message", None)
                safe["is_deleted_app_snapshot"] = True
                return safe
        except Exception:
            pass
        return None

    def get_followup_queue_items(self, include_completed=False):
        # v3.9.27 efficiency: this runs on every preview-queue render (every refresh /
        # AutoPilot cycle). Only re-run the 4-collection dedupe when something actually
        # added or replaced follow-up records; dedupe_followup_records() clears the flag.
        if getattr(self, "_followup_dedup_needed", True):
            self.dedupe_followup_records()
        rows = []
        seen_queue_keys = set()
        for index, item in enumerate(self.followups):
            if not include_completed and (item.get("completed") or item.get("cancelled")):
                continue
            email = self.find_email_for_followup_item(item)
            group_name = ""
            if email:
                group_name = self.get_group_name_for_email(email.get("entry_id", "")) or ""
            status = "Cancelled" if item.get("cancelled") else "Completed" if item.get("completed") else "Active"
            queue_key = ("manual", status if include_completed else "Active", item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if queue_key in seen_queue_keys:
                continue
            seen_queue_keys.add(queue_key)
            rows.append({
                "queue_id": f"manual:{index}",
                "kind": "Manual follow-up",
                "due_at": item.get("due_at", ""),
                "due_display": self.format_due_display(item.get("due_at", "")),
                "subject": item.get("subject") or (email.get("subject", "") if email else "Email not loaded/found"),
                "group": group_name,
                "status": status,
                "note": item.get("message") or item.get("note") or "Manual scheduled follow-up",
                "item": item,
                "email": email,
            })
        for index, item in enumerate(self.scenario_reminders):
            if not include_completed and (item.get("completed") or item.get("cancelled")):
                continue
            email = self.find_email_for_followup_item(item)
            if email and self.email_is_completed(email) and not item.get("one_time_after_app_delete") and not (item.get("completed") or item.get("cancelled")):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Auto-cancelled: related email is Completed/Low/Junk."
                self.save_scenario_reminders()
                self.save_commitment_reminders()
                if not include_completed:
                    continue
            group_name = ""
            if email:
                group_name = self.get_group_name_for_email(email.get("entry_id", "")) or ""
            scenario_type = item.get("type", "scenario")
            if scenario_type == "vendor_no_response":
                kind = "Vendor no-response"
            elif scenario_type == "customer_po_order_followup":
                kind = "PO/order follow-up"
            else:
                kind = scenario_type.replace("_", " ").title()
            status = "Cancelled" if item.get("cancelled") else "Completed" if item.get("completed") else "Active"
            queue_key = (scenario_type, status if include_completed else "Active", item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if queue_key in seen_queue_keys:
                continue
            seen_queue_keys.add(queue_key)
            rows.append({
                "queue_id": f"scenario:{index}",
                "kind": kind,
                "due_at": item.get("due_at", ""),
                "due_display": self.format_due_display(item.get("due_at", "")),
                "subject": item.get("subject") or (email.get("subject", "") if email else "Email not loaded/found"),
                "group": group_name,
                "status": status,
                "note": item.get("note") or item.get("reason") or item.get("description") or "Automatic scenario reminder",
                "item": item,
                "email": email,
            })
        # v3.8.15: include the commitment/promised-date lane so created ETA / lead-time
        # reminders are visible immediately (upcoming preview + queue), not only when due.
        for index, item in enumerate(getattr(self, "commitment_reminders", [])):
            if not include_completed and (item.get("completed") or item.get("cancelled")):
                continue
            email = self.find_email_for_followup_item(item)
            if email and self.email_is_completed(email) and not (item.get("completed") or item.get("cancelled")):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Auto-cancelled: related email is Completed/Low/Junk."
                self.save_commitment_reminders()
                if not include_completed:
                    continue
            group_name = ""
            if email:
                group_name = self.get_group_name_for_email(email.get("entry_id", "")) or ""
            status = "Cancelled" if item.get("cancelled") else "Completed" if item.get("completed") else "Active"
            queue_key = (item.get("type", "commitment"), status if include_completed else "Active",
                         item.get("target_date", ""),
                         item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if queue_key in seen_queue_keys:
                continue
            seen_queue_keys.add(queue_key)
            rows.append({
                "queue_id": f"commitment:{index}",
                "kind": item.get("kind_label", "Promised date"),
                "due_at": item.get("due_at", ""),
                "due_display": self.format_due_display(item.get("due_at", "")),
                "subject": item.get("subject") or (email.get("subject", "") if email else "Email not loaded/found"),
                "group": group_name,
                "status": status,
                "note": item.get("note") or "Detected promised date / ETA reminder",
                "item": item,
                "email": email,
            })
        def sort_key(row):
            try:
                return datetime.fromisoformat(row.get("due_at") or "9999-12-31T23:59:59")
            except Exception:
                return datetime.max
        rows.sort(key=sort_key)
        return rows

    def open_followup_queue_window(self):
        win = tk.Toplevel(self.root)
        win.title("MaINbox Follow-Up Queue")
        remember_window_geometry(win, "MaINbox Follow-Up Queue", "1050x520")
        win.transient(self.root)

        header = tk.Frame(win)
        header.pack(fill="x", padx=10, pady=8)
        title_var = tk.StringVar()
        tk.Label(header, textvariable=title_var, font=("Segoe UI", 15, "bold")).pack(side="left")
        show_completed_var = tk.BooleanVar(value=False)
        tk.Checkbutton(header, text="Show completed/cancelled", variable=show_completed_var).pack(side="right", padx=5)

        columns = ("due", "type", "status", "group", "subject", "note")
        queue_tree = ttk.Treeview(win, columns=columns, show="headings", selectmode="extended")
        queue_tree.heading("due", text="Due")
        queue_tree.heading("type", text="Type")
        queue_tree.heading("status", text="Status")
        queue_tree.heading("group", text="Group")
        queue_tree.heading("subject", text="Subject")
        queue_tree.heading("note", text="Note")
        queue_tree.column("due", width=125)
        queue_tree.column("type", width=155)
        queue_tree.column("status", width=80, anchor="center")
        queue_tree.column("group", width=190)
        queue_tree.column("subject", width=285)
        queue_tree.column("note", width=300)
        queue_tree.pack(fill="both", expand=True, padx=10, pady=5)
        queue_tree.tag_configure("due", background="#fff2cc", foreground="black")
        queue_tree.tag_configure("overdue", background="#f4cccc", foreground="black")
        queue_tree.tag_configure("completed", background="#d9ead3", foreground="black")
        queue_tree.tag_configure("cancelled", background="#eeeeee", foreground="#777777")

        detail = tk.Text(win, height=5, wrap="word", font=("Segoe UI", 9))
        detail.pack(fill="x", padx=10, pady=(4, 6))

        queue_rows = []

        def selected_rows(show_warning=True):
            selected = queue_tree.selection()
            if not selected:
                if show_warning:
                    messagebox.showwarning("No Follow-Up Selected", "Please select one or more follow-up queue items first.")
                return []
            found = []
            selected_set = set(selected)
            for row in queue_rows:
                if row.get("queue_id") in selected_set:
                    found.append(row)
            return found

        def selected_row(show_warning=True):
            rows = selected_rows(show_warning=show_warning)
            return rows[0] if rows else None

        def refresh_queue():
            nonlocal queue_rows
            queue_tree.delete(*queue_tree.get_children())
            queue_rows = self.get_followup_queue_items(include_completed=show_completed_var.get())
            now = datetime.now()
            active = len([r for r in queue_rows if r.get("status") == "Active"])
            title_var.set(f"Follow-Up Queue — {active} active")
            for row in queue_rows:
                tags = []
                if row.get("status") == "Completed":
                    tags = ["completed"]
                elif row.get("status") == "Cancelled":
                    tags = ["cancelled"]
                else:
                    try:
                        due_at = datetime.fromisoformat(row.get("due_at", ""))
                        if due_at <= now:
                            tags = ["overdue"]
                        elif due_at <= now + timedelta(minutes=15):
                            tags = ["due"]
                    except Exception:
                        tags = []
                queue_tree.insert(
                    "", "end", iid=row["queue_id"],
                    values=(row["due_display"], row["kind"], row["status"], row["group"], row["subject"], row["note"]),
                    tags=tags,
                )
            detail.delete("1.0", tk.END)
            if queue_rows:
                detail.insert(tk.END, "Select one or more queue items to cancel, snooze, or trigger now. Open Related Email uses the first selected item.")
            else:
                detail.insert(tk.END, "No active follow-ups are currently queued.")
            self.followup_status_var.set(f"Follow-ups: {self.active_followup_count()} active")
            self.render_followup_preview_queue()

        def show_detail(event=None):
            row = selected_row(show_warning=False)
            if not row:
                detail.delete("1.0", tk.END)
                detail.insert(tk.END, "Select one or more queue items to cancel, snooze, or trigger now. Open Related Email uses the first selected item.")
                return
            email = row.get("email")
            detail.delete("1.0", tk.END)
            detail.insert(
                tk.END,
                f"Type: {row.get('kind')}\n"
                f"Due: {row.get('due_display')}\n"
                f"Status: {row.get('status')}\n"
                f"Group: {row.get('group') or 'None'}\n"
                f"Subject: {row.get('subject')}\n"
                f"Related email loaded: {'Yes' if email else 'No'}\n\n"
                f"Note: {row.get('note')}"
            )

        def open_related():
            row = selected_row()
            if not row:
                return
            email = row.get("email")
            if not email:
                messagebox.showinfo("Email Not Loaded", "This follow-up exists, but the related email is not currently loaded in the visible/cache email list. Try Refresh or Update.")
                return
            try:
                if self.tree.exists(email.get("entry_id", "")):
                    self.tree.selection_set(email["entry_id"])
                    self.tree.see(email["entry_id"])
            except Exception:
                pass
            body = self.load_body_if_needed(email)
            self.render_body_preview(email, body, extra_status="Opened from Follow-Up Queue.")
            win.lift()

        def cancel_selected():
            rows = [r for r in selected_rows() if r.get("status") == "Active"]
            if not rows:
                return
            if not messagebox.askyesno("Cancel Follow-Ups", f"Cancel {len(rows)} queued follow-up(s)?"):
                return
            for row in rows:
                item = row.get("item")
                if item is not None:
                    item["cancelled"] = True
                    item["cancelled_at"] = datetime.now().isoformat()
                    item["cancel_reason"] = "Cancelled from Follow-Up Queue"
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            refresh_queue()
            self.render_email_rows()
            self.render_group_rows()

        def snooze_rows(rows, due_at, label="custom"):
            changed = 0
            for row in rows:
                if row.get("status") != "Active":
                    continue
                item = row.get("item")
                if item is not None:
                    item["due_at"] = due_at.isoformat()
                    item["snoozed_at"] = datetime.now().isoformat()
                    item["snooze_label"] = label
                    email = row.get("email")
                    if email:
                        email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
                    changed += 1
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_cached_state()
            refresh_queue()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            return changed

        def parse_custom_snooze(raw):
            raw = (raw or "").strip()
            if not raw:
                return None
            now = datetime.now()
            for fmt in ["%m/%d/%Y %I:%M %p", "%m/%d/%y %I:%M %p", "%m/%d/%Y %H:%M", "%m/%d/%y %H:%M"]:
                try:
                    return datetime.strptime(raw.upper(), fmt)
                except Exception:
                    pass
            parsed_time = parse_followup_time(raw)
            return parsed_time

        def snooze_selected(minutes=None):
            rows = [r for r in selected_rows() if r.get("status") == "Active"]
            if not rows:
                return
            if minutes is None:
                custom = simpledialog.askstring(
                    "Custom Snooze",
                    "Enter snooze date/time. Examples:\n3:00 PM\n05/13/2026 9:30 AM",
                    parent=win
                )
                due_at = parse_custom_snooze(custom)
                if not due_at:
                    messagebox.showerror("Invalid Snooze", "Please enter a time like 3:00 PM or a date/time like 05/13/2026 9:30 AM.")
                    return
                label = custom
            else:
                due_at = datetime.now() + timedelta(minutes=minutes)
                label = f"{minutes} minutes"
            snooze_rows(rows, due_at, label=label)

        def snooze_dropdown_apply():
            label = snooze_var.get()
            options = {
                "15 min": 15,
                "30 min": 30,
                "1 hour": 60,
                "2 hours": 120,
                "Tomorrow 9 AM": None,
                "Custom date/time": None,
            }
            if label == "Tomorrow 9 AM":
                target = datetime.combine((datetime.now() + timedelta(days=1)).date(), datetime.strptime("9:00 AM", "%I:%M %p").time())
                rows = [r for r in selected_rows() if r.get("status") == "Active"]
                if rows:
                    snooze_rows(rows, target, label=label)
                return
            if label == "Custom date/time":
                snooze_selected(None)
                return
            snooze_selected(options.get(label, 30))

        def trigger_now():
            rows = [r for r in selected_rows() if r.get("status") == "Active"]
            if not rows:
                return
            for row in rows:
                item = row.get("item")
                if item is not None:
                    item["due_at"] = (datetime.now() - timedelta(seconds=1)).isoformat()
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.check_due_followups()
            refresh_queue()

        btns = tk.Frame(win)
        btns.pack(fill="x", padx=10, pady=(0, 10))
        tk.Button(btns, text="Open Related Email", command=open_related, width=18).pack(side="left", padx=4)
        tk.Button(btns, text="Trigger Now Selected", command=trigger_now, width=18).pack(side="left", padx=4)
        snooze_var = tk.StringVar(value="30 min")
        ttk.Combobox(btns, textvariable=snooze_var, values=["15 min", "30 min", "1 hour", "2 hours", "Tomorrow 9 AM", "Custom date/time"], state="readonly", width=18).pack(side="left", padx=4)
        tk.Button(btns, text="Snooze Selected", command=snooze_dropdown_apply, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Cancel Selected", command=cancel_selected, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Refresh", command=refresh_queue, width=12).pack(side="right", padx=4)
        tk.Button(btns, text="Close", command=win.destroy, width=12).pack(side="right", padx=4)

        queue_tree.bind("<<TreeviewSelect>>", show_detail)
        show_completed_var.trace_add("write", lambda *_: refresh_queue())
        refresh_queue()
        try:
            win.lift()
            win.focus_force()
        except Exception:
            pass

    def open_followup_window(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return
        first_email = selected_emails[0]
        existing = self.get_active_followup_for_email(first_email["entry_id"])
        win = tk.Toplevel(self.root)
        win.title("Setup / Edit Follow Up")
        remember_window_geometry(win, "Setup Edit Follow Up", "560x430")
        win.resizable(False, False)
        win.transient(self.root)
        tk.Label(win, text="Setup / Edit Follow Up", font=("Segoe UI", 16, "bold")).pack(pady=12)
        tk.Label(win, text=f"{len(selected_emails)} email(s) selected.\nAt the follow-up time, the app will show a due follow-ups popup. You choose what to deploy.", font=("Segoe UI", 10)).pack(pady=4)
        if existing:
            try:
                existing_dt = datetime.fromisoformat(existing["due_at"])
                default_time = existing_dt.strftime("%I:%M %p")
                existing_text = f"Existing follow-up: {existing_dt.strftime('%m/%d/%Y %I:%M %p')}"
            except Exception:
                default_time = "3:00 PM"
                existing_text = "Existing follow-up found."
        else:
            default_time = "3:00 PM"
            existing_text = "No existing follow-up for the first selected email."
        tk.Label(win, text=existing_text, font=("Segoe UI", 9), fg=_FG_DIM).pack(pady=4)
        time_frame = tk.Frame(win)
        time_frame.pack(pady=10)
        tk.Label(time_frame, text="Follow-up:").pack(side="left", padx=5)
        time_var = tk.StringVar(value=default_time)
        followup_choices = [
            "1 minute", "5 minutes", "15 minutes", "30 minutes",
            "1 hour", "2 hours", "4 hours", "Tomorrow 9 AM", "3:00 PM"
        ]
        followup_box = ttk.Combobox(time_frame, textvariable=time_var, values=followup_choices, state="readonly", width=18)
        followup_box.pack(side="left", padx=5)
        tk.Label(time_frame, text="choose a preset").pack(side="left", padx=5)
        tk.Label(win, text="Scheduling again will replace any active follow-up for the selected email(s).\nThe app must remain open for scheduled follow-up popups to trigger.", font=("Segoe UI", 9), fg=_FG_DIM).pack(pady=8)

        def get_active_auto_followup_conflicts():
            """Return active automatic follow-up/tracking rows for the selected email(s).

            Manual follow-ups are now the user's authoritative reminder.  To keep
            the queue clean, creating a manual follow-up cannot leave an AI/vendor/
            customer/pending tracker active for the same email/thread.
            """
            conflicts = []
            seen = set()
            for email in selected_emails:
                for collection_name, index, item in self.get_active_automatic_tracking_for_email(email, include_pending=True):
                    key = (collection_name, index)
                    if key in seen:
                        continue
                    seen.add(key)
                    scenario_type = item.get("type", item.get("source", "automatic"))
                    conflicts.append({
                        "collection": collection_name,
                        "index": index,
                        "item": item,
                        "email": email,
                        "subject": item.get("subject") or email.get("subject", "") or "(No subject)",
                        "due": self.format_due_display(item.get("due_at", "")) if hasattr(self, "format_due_display") else item.get("due_at", ""),
                        "note": item.get("note", "") or item.get("reason", "") or item.get("source", "") or "Automatic follow-up/tracking",
                        "kind": scenario_type.replace("_", " ").title() if scenario_type else "Automatic Tracking",
                    })
            return conflicts

        def ask_manual_followup_with_auto_conflicts(conflicts):
            """
            If an automatic follow-up/tracker already exists, ask whether to
            replace it with the manual follow-up or stop. Returns: cancel or abort.
            """
            if not conflicts:
                return "cancel"

            dialog = tk.Toplevel(win)
            dialog.title("Automatic Follow-Up Already Exists")
            remember_window_geometry(dialog, "Automatic Follow-Up Conflict", "800x430")
            dialog.transient(win)
            dialog.grab_set()
            dialog.resizable(True, True)

            tk.Label(
                dialog,
                text="An automatic follow-up/tracker already exists for the selected email(s).",
                font=("Segoe UI", 13, "bold")
            ).pack(anchor="w", padx=12, pady=(12, 4))
            tk.Label(
                dialog,
                text="To prevent duplicate reminders, creating the manual follow-up will cancel the existing automatic tracking.",
                font=("Segoe UI", 9)
            ).pack(anchor="w", padx=12, pady=(0, 8))

            frame = tk.Frame(dialog)
            frame.pack(fill="both", expand=True, padx=12, pady=6)
            columns = ("kind", "due", "subject", "note")
            tree = ttk.Treeview(frame, columns=columns, show="headings", height=8)
            tree.heading("kind", text="Existing Tracker")
            tree.heading("due", text="Due")
            tree.heading("subject", text="Subject")
            tree.heading("note", text="Note")
            tree.column("kind", width=170)
            tree.column("due", width=120)
            tree.column("subject", width=270)
            tree.column("note", width=300)
            tree.pack(side="left", fill="both", expand=True)
            yscroll = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)
            yscroll.pack(side="right", fill="y")
            tree.configure(yscrollcommand=yscroll.set)

            for row in conflicts:
                tree.insert("", "end", values=(row.get("kind", "Automatic"), row.get("due", ""), row.get("subject", ""), row.get("note", "")))

            result = {"choice": "abort"}

            def choose(choice):
                result["choice"] = choice
                dialog.destroy()

            btns = tk.Frame(dialog)
            btns.pack(fill="x", padx=12, pady=(8, 12))
            tk.Button(btns, text="Create Manual + Cancel Auto", command=lambda: choose("cancel"), width=28).pack(side="left", padx=4)
            tk.Button(btns, text="Do Not Create", command=lambda: choose("abort"), width=18).pack(side="right", padx=4)

            dialog.protocol("WM_DELETE_WINDOW", lambda: choose("abort"))
            win.wait_window(dialog)
            return result.get("choice", "abort")

        def schedule_or_edit():
            target_dt = parse_followup_time(time_var.get().strip())
            if not target_dt:
                messagebox.showerror("Invalid Time", "Please choose a dropdown value or enter something like 3:00 PM, 9 AM, 14:30, 1, 1 min, 30 minutes, 2 hours, or Tomorrow 9 AM.")
                return

            auto_conflicts = get_active_auto_followup_conflicts()
            auto_choice = ask_manual_followup_with_auto_conflicts(auto_conflicts)
            if auto_choice == "abort":
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, "Manual follow-up was not created. Existing automatic follow-up/tracking was left unchanged.")
                return

            self.save_undo_state("schedule/edit follow-up")
            scheduled_count = 0
            cancelled_auto_count = 0
            now_iso = datetime.now().isoformat()

            if auto_choice == "cancel":
                for conflict in auto_conflicts:
                    item = conflict.get("item")
                    if item and not item.get("completed") and not item.get("cancelled"):
                        item["cancelled"] = True
                        item["cancelled_at"] = now_iso
                        item["cancel_reason"] = "Cancelled by user while creating manual follow-up"
                        cancelled_auto_count += 1

            for email in selected_emails:
                for item in self.followups:
                    if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                        item["cancelled"] = True
                        item["cancelled_at"] = now_iso
                        item["cancel_reason"] = "Replaced by edited follow-up"
                item = {
                    "entry_id": email["entry_id"], "store_id": email.get("store_id", ""),
                    "conversation_id": email.get("conversation_id", ""), "group_id": self.get_group_id_for_email(email.get("entry_id", "")), "subject": email.get("subject", ""),
                    "source": email.get("source", ""), "category": email.get("category", "General"),
                    "due_at": target_dt.isoformat(), "message": "", "use_ai": True,
                    "completed": False, "cancelled": False, "created_at": now_iso
                }
                self.followups.append(item)
                self._followup_dedup_needed = True  # v3 efficiency: mark dirty.
                email["followup_time"] = target_dt.strftime("%m/%d %I:%M %p")
                scheduled_count += 1
            self.save_followups()
            if cancelled_auto_count:
                self.save_scenario_reminders()
                self.save_commitment_reminders()
                self.save_pending_reply_checks()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.save_cached_state()
            self.preview_text.delete("1.0", tk.END)
            extra = f"\nCancelled {cancelled_auto_count} existing automatic follow-up/tracking item(s)." if cancelled_auto_count else ""
            self.preview_text.insert(tk.END, f"Scheduled/edited {scheduled_count} manual follow-up(s) for {target_dt.strftime('%m/%d/%Y %I:%M %p')}.{extra}\n\nThe app must be open for the follow-up drafts to trigger.")
            win.destroy()

        def cancel_from_window():
            win.destroy()
            self.cancel_selected_followups()

        tk.Button(win, text="Save Follow Up", command=schedule_or_edit, width=24).pack(pady=8)
        tk.Button(win, text="Cancel Existing Follow Up", command=cancel_from_window, width=24).pack(pady=8)
        tk.Button(win, text="Close", command=win.destroy, width=24).pack(pady=8)

    def cancel_selected_followups(self):
        selected_emails = self.get_selected_emails()
        if not selected_emails:
            return
        cancelled = 0
        now_iso = datetime.now().isoformat()
        for email in selected_emails:
            # Cancel both manual follow-ups and automatic AI/scenario tracking.
            # Previously this button only cancelled self.followups, so AI Follow-Up
            # Review rows in self.scenario_reminders could stay active and keep
            # returning in the queue even after the user thought they were cleared.
            for item in self.followups:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            for item in self.scenario_reminders:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            for item in self.pending_reply_checks:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            # v3.8.30: also cancel commitment reminders (promised dates / reply-needed)
            # for this email. Previously this handler called save_commitment_reminders()
            # but never modified the list, so a commitment reminder stayed active after the
            # user believed every follow-up/tracking item for the email had been cleared.
            for item in getattr(self, "commitment_reminders", []) or []:
                if self._followup_item_matches_email(item, email) and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = now_iso
                    item["cancel_reason"] = "Cancelled by user"
                    cancelled += 1
            try:
                self.learn_followup_behavior(email, "no_followup", None, "User cancelled follow-up/tracking for this item.")
            except Exception:
                pass
            email["followup_time"] = ""
        self.save_followups()
        self.save_scenario_reminders()
        self.save_commitment_reminders()
        self.save_pending_reply_checks()
        self.render_email_rows()
        self.render_group_rows()
        self.render_followup_preview_queue()
        self.save_cached_state()
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Cancelled {cancelled} active follow-up/tracking item(s).")

    def create_draft_reply(self):
        email = self.get_selected_email()
        if not email:
            return
        self.create_reply_draft_with_message(email, get_followup_message(email.get("category", "General")), require_thread=True)

    def open_selected_email(self):
        email = self.get_selected_email()
        if not email:
            return
        msg = self.get_message_object(email)
        if not msg:
            messagebox.showerror("Open Error", "Could not reopen this email from Outlook. Try Refresh or Update.")
            return
        try:
            email["is_new_import"] = False
            if self.tree.exists(email["entry_id"]):
                self.tree.item(email["entry_id"], tags=(self.get_row_tag(email),))
            msg.Display()
            try:
                inspector = msg.GetInspector
                if inspector:
                    inspector.Activate()
            except Exception:
                pass
        except Exception as e:
            email["message"] = None
            messagebox.showerror("Open Error", f"Could not open email.\n\n{e}")

    def change_category(self):
        self.save_cached_state()
        self.root.destroy()
