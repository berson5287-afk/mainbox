            if self.tree.exists(first_email["entry_id"]):
                self.tree.item(first_email["entry_id"], tags=(self.get_row_tag(first_email),))
        self._loading_selected_workflow_fields = True
        try:
            self.category_var.set(first_email["category"])
            self.urgency_var.set(first_email["urgency"])
            self.status_var.set(first_email["status"])
            try:
                self.email_type_var.set(self.get_email_type_code(first_email))
            except Exception:
                pass
        finally:
            self._loading_selected_workflow_fields = False
        self.preview_text.delete("1.0", tk.END)
        if len(selected_emails) > 1:
            self.preview_text.insert(tk.END, f"{len(selected_emails)} emails selected.\n\nChoose Workflow Category / Urgency / Status above, then click:\nApply / Save to Selected")
            return
        email = first_email

        # If this email body was already loaded/cached, show it again automatically.
        # This fixes the issue where switching away and back showed the placeholder even though
        # the body was already saved locally.
        if email.get("body_loaded") and (email.get("body", "") or "").strip():
            self.render_body_preview(email, email.get("body", ""), extra_status="Loaded from saved body cache.")
            return

        self.preview_text.insert(
            tk.END,
            f"Source: {email['source']}\n"
            f"From: {email['sender']}\n"
            f"Received: {email['received']}\n"
            f"Outlook Categories: {email['outlook_categories']}\n"
            f"Workflow Category: {email['category']}\n"
            f"Urgency: {email['urgency']}\n"
            f"Status: {email['status']}\n"
            f"Follow Up: {email.get('followup_time', '')}\n\n"
            f"Subject: {email['subject']}\n\n"
