                f"Type: {normalize_email_type_code(c.get('sender_type') or c.get('type') or c.get('email_type') or '') or 'Blank/Unknown'}\n"
                f"Date: {c.get('date','')}    Job/Group: {c.get('job','')}\n"
                f"Subject: {c.get('subject','')}\n"
                f"Raw line: {c.get('raw_line','')}\n"
