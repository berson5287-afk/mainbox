    def get_email_by_id(self, entry_id):
        # v3 efficiency: true O(1) lookup via the index built by _rebuild_email_index().
        # The index is rebuilt on every path that removes or replaces rows in
        # self.emails (dedupe, delete, undo, upsert, full reload, placeholder sync), so
        # an index hit is current. We still verify the hit's entry_id matches as a cheap
        # O(1) guard, and fall back to a linear scan that repairs the index on a miss.
        # This replaces the previous "any(hit is e for e in self.emails)" membership
        # check, which was O(n) and made every lookup linear (O(n^2) inside loops).
        idx = getattr(self, "_email_index", None)
        if idx is not None:
            hit = idx.get(entry_id)
            if hit is not None and hit.get("entry_id") == entry_id:
                return hit
        for email in self.emails:
            if email.get("entry_id") == entry_id:
                if idx is not None and entry_id:
                    idx[entry_id] = email
                return email
        if idx is not None and entry_id:
            idx.pop(entry_id, None)
        return None

    def _rebuild_email_index(self):
        """Build/rebuild the O(1) entry_id → email dict used by get_email_by_id.

        Call this after self.emails is fully settled (end of load_cached_state,
        full_update_all, sync_sent_waiting_placeholders, cleanup_duplicates).
        Individual upsert_new calls also update the index so it stays current
        without a full rebuild on every import cycle.
        """
        self._email_index = {
            e["entry_id"]: e
            for e in self.emails
            if isinstance(e, dict) and e.get("entry_id")
        }

    def get_message_object(self, email):
        outlook, namespace = self.fresh_outlook()
        if not namespace:
            return None
        entry_id = email.get("entry_id", "")
        store_id = email.get("store_id", "")
        if email.get("is_sent_waiting_placeholder") and email.get("sent_entry_id"):
            entry_id = email.get("sent_entry_id", "")
        try:
            if store_id and not email.get("is_sent_waiting_placeholder"):
                msg = namespace.GetItemFromID(entry_id, store_id)
            else:
                msg = namespace.GetItemFromID(entry_id)
            email["message"] = msg
            return msg
        except Exception:
            email["message"] = None
            try:
                msg = namespace.GetItemFromID(entry_id)
                email["message"] = msg
                return msg
            except Exception:
                email["message"] = None
                return None

    def render_followup_preview_queue(self):
        """Small always-visible upcoming follow-up preview. Due/past-due items stay at the top in red."""
        if not hasattr(self, "followup_preview_tree"):
            return
        tree = self.followup_preview_tree
        try:
            tree.delete(*tree.get_children())
        except Exception:
            return
        now = datetime.now()
        rows = [r for r in self.get_followup_queue_items(include_completed=False) if r.get("status") == "Active"]
        def sort_key(row):
            try:
                due_at = datetime.fromisoformat(row.get("due_at") or "9999-12-31T23:59:59")
            except Exception:
                due_at = datetime.max
            # due/past-due first, then upcoming by due time
            return (0 if due_at <= now else 1, due_at)
        rows.sort(key=sort_key)
        for idx, row in enumerate(rows[:8]):
            try:
                due_at = datetime.fromisoformat(row.get("due_at") or "9999-12-31T23:59:59")
            except Exception:
                due_at = None
            if due_at and due_at <= now:
                tag = "past_due"
            elif due_at and due_at <= now + timedelta(hours=2):
                tag = "due_soon"
            else:
                tag = "upcoming"
            subject = row.get("subject", "") or "No subject"
            if row.get("group"):
                subject = f"[{row.get('group')}] {subject}"
            tree.insert("", "end", iid=f"preview:{idx}", values=(row.get("due_display", ""), subject[:80]), tags=(tag,))
        if not rows:
            tree.insert("", "end", iid="preview:none", values=("", "No upcoming follow-ups"), tags=("upcoming",))
        # v3.9.1: keep the quote-coverage counter in sync on every load/refresh.
        try:
            self.update_coverage_status_label()
        except Exception:
            pass

