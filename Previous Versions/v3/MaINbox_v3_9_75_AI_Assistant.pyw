        self.render_email_rows()
        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, f"Created {urgency} group: {name}\n\nThis group now appears at the top of its urgency section. Drag emails into it or select emails and click Add Selected.")

