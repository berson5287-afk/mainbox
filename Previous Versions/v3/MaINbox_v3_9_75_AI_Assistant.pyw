    def workflow_record_is_closed(self, record):
        """Return True for user-closed/hidden workflow states that refresh/AI must not reopen."""
        try:
            record = record or {}
            return (
                bool(record.get("app_deleted", False))
                or record.get("status", "") == "Completed"
                or record.get("urgency", "") == "Low"
                or record.get("category", "") == "Junk / Ignore"
            )
        except Exception:
            return False

    def find_saved_status_for_email_fields(self, entry_id="", conversation_id="", sender_email="", sender="", subject="", received_timestamp=0, source=""):
        """Find the saved workflow record for an Outlook item.

        Primary key is Outlook EntryID.  A conservative fallback is used because Outlook/Exchange can
        occasionally surface the same message with a different EntryID after sync/move/cache changes.
        This prevents a user-closed item (Low/Completed/Junk/app-deleted) from reappearing as New.
        """
        try:
            entry_id = str(entry_id or "").strip()
            if entry_id and isinstance(self.status_data, dict):
                direct = self.status_data.get(entry_id)
                if isinstance(direct, dict):
                    return direct

            normalized_subject = normalize_subject_for_match(subject or "")
            sender_key = str(sender_email or sender or "").strip().lower()
            conversation_id = str(conversation_id or "").strip().lower()
            source = str(source or "").strip()
            try:
                ts = float(received_timestamp or 0)
            except Exception:
                ts = 0.0
            if not isinstance(self.status_data, dict) or not normalized_subject or not sender_key:
                return {}

            best = None
            best_score = -1
            for old_entry_id, rec in self.status_data.items():
                if not isinstance(rec, dict):
                    continue
                rec_subject = normalize_subject_for_match(rec.get("subject", "") or rec.get("normalized_subject", "") or "")
                if rec_subject != normalized_subject:
                    continue

                # v3.9.2: compute the timestamp delta and the closed/suppressed state up front so
                # the sender gate can stay strict for active rows but tolerant for rows we are
                # deliberately keeping hidden (app-deleted / Low / Completed / Junk).
                try:
                    rec_ts = float(rec.get("received_timestamp", 0) or 0)
                except Exception:
                    rec_ts = 0.0
                delta = abs(ts - rec_ts) if (ts and rec_ts) else None
                rec_is_closed = self.workflow_record_is_closed(rec)
                rec_conv = str(rec.get("conversation_id", "") or "").strip().lower()
                same_conversation = bool(conversation_id and rec_conv and rec_conv == conversation_id)

                # Cached Exchange Mode can resurface the SAME message with a new EntryID AND a
                # different sender_email form (SMTP vs the X500 "/O=EXCHANGE/..." address). The old
                # strict gate then dropped the suppressed record and the deleted/Low/Completed item
                # came back as new. Only relax the sender mismatch when this is clearly the same
                # delivered message (same conversation, or identical normalized subject within a
                # tight 120s window) AND the stored record is one we are actively suppressing.
                rec_sender = str(rec.get("sender_email", "") or rec.get("sender", "") or "").strip().lower()
                if rec_sender and rec_sender != sender_key:
                    tolerant = rec_is_closed and (same_conversation or (delta is not None and delta <= 120))
                    if not tolerant:
                        continue

                score = 0
                if same_conversation:
                    score += 5
                rec_source = str(rec.get("source", "") or "").strip()
                if source and rec_source and rec_source == source:
                    score += 1
                if delta is not None:
                    if delta <= 60:
                        score += 4
                    elif delta <= 600:
                        score += 2
                    elif not (rec_is_closed and same_conversation):
                        # Same subject far apart is usually a different reply/request — but a
                        # suppressed record that shares the conversation id is the same thread,
                        # and resynced items can have drifted timing, so keep it.
                        continue
                if rec_is_closed:
                    score += 2
                if score > best_score:
                    best = rec
                    best_score = score
            return dict(best) if best and best_score >= 4 else {}
        except Exception:
            return {}

    def apply_saved_workflow_to_email(self, email, saved=None):
        """Overlay durable workflow fields from status_data onto an in-memory email row."""
        try:
            if not isinstance(email, dict):
                return email
            saved = saved if isinstance(saved, dict) else self.status_data.get(email.get("entry_id", ""), {})
            if not isinstance(saved, dict) or not saved:
                return email
            for field in [
                "category", "urgency", "status", "sender_type", "email_type", "sender_intent",
                "reply_intent", "business_relevance", "spam_likelihood", "same_subject_related_count",
                "ai_triaged_at", "ai_triage_pending", "needs_followup_ai", "ai_triage_reason",
                "followup_reason_ai", "followup_blocked_reason", "trusted_sender", "learned_rule_source",
                "sales_inbox_duplicate_hidden", "sales_inbox_duplicate_hidden_at",
                "sent_waiting_tracker_active", "sent_waiting_tracker_sent_timestamp", "ai_user_locked", "ai_triage_skipped"
            ]:
                if field in saved and saved.get(field) not in (None, ""):
                    email[field] = saved.get(field)
            return email
        except Exception:
            return email

    def saved_workflow_is_closed_for_email(self, email):
        try:
            if not isinstance(email, dict):
                return False
            saved = self.status_data.get(email.get("entry_id", ""), {}) if isinstance(self.status_data, dict) else {}
            return self.workflow_record_is_closed(saved) or self.workflow_record_is_closed(email)
        except Exception:
            return False

    def upsert_email(self, email):
        entry_id = email.get("entry_id", "")
        if not entry_id:
            return False
        # v3.9.27 efficiency: the old code linearly scanned self.emails for the existing
        # row, then ran dedupe_email_rows() (which includes a quadratic Sales/My-Inbox
        # cross-check) AND a full index rebuild on EVERY imported message. On a refresh
        # importing a few hundred messages into a couple thousand cached rows that was
        # the single biggest freeze source. The index already maps entry_id -> row, so:
        # find via index, replace/append in place, update the index incrementally, and
        # leave the one full dedupe pass to the refresh orchestrators (refresh_new_emails
        # runs cleanup_duplicates(pre_render) and every save_cached_state() dedupes too).
        idx = getattr(self, "_email_index", None)
        if idx is None:
            self._rebuild_email_index()
            idx = self._email_index
        existing = idx.get(entry_id)
        if existing is not None and existing.get("entry_id") != entry_id:
            existing = None  # stale index hit; treat as miss and repair below
        if existing is None:
            for row in self.emails:
                if isinstance(row, dict) and row.get("entry_id") == entry_id:
                    existing = row
                    idx[entry_id] = row
                    break
        if existing is not None:
            # Durable saved workflow state wins over stale cache rows.
            # This prevents Low/Completed/Junk/app-deleted decisions from being reopened on refresh.
            saved = self.status_data.get(entry_id, {}) if isinstance(self.status_data, dict) else {}
            if saved.get("app_deleted"):
                try:
                    self.emails = [e for e in self.emails if e is not existing]
                    idx.pop(entry_id, None)
                except Exception:
                    pass
                return False
            if saved:
                self.apply_saved_workflow_to_email(email, saved)
            else:
                email["category"] = existing.get("category", email.get("category", "General"))
                email["urgency"] = existing.get("urgency", email.get("urgency", "Normal"))
                email["status"] = existing.get("status", email.get("status", "New"))
            email["followup_time"] = self.get_followup_display_for_email(entry_id)
            email["is_new_import"] = existing.get("is_new_import", False)

            # Preserve cached body content across refreshes so refresh does not throw it away.
            existing_body = existing.get("body", "") or ""
            email["body"] = existing_body
            email["body_loaded"] = bool(existing_body)

            merged = self._merge_duplicate_email_rows(email, existing)
            # v3.9.48: a Refresh must NEVER re-classify an email already in the list. The existing
            # in-memory row carries the user's authoritative workflow (manual edits, triage result,
            # user-lock), which can legitimately be newer than status_data -- e.g. an edit whose
            # Outlook EntryID drifted under Cached Exchange Mode, or any state status_data didn't
            # capture. Force these fields from the existing row to win over the freshly re-imported
            # / status_data values so a refresh can never snap urgency/category/status back.
            # (app_deleted is handled above and still wins.)
            for _f in ("category", "urgency", "status", "email_type",
                       "ai_triaged_at", "ai_triage_pending", "ai_user_locked"):
                _ev = existing.get(_f)
                if _ev not in (None, ""):
                    merged[_f] = _ev
            # Keep status_data in agreement with the row that just won, so it can't stay stale and
            # cause a later refresh/restart to disagree.
            try:
                _sd = self.status_data.get(entry_id) if isinstance(self.status_data, dict) else None
                if isinstance(_sd, dict):
                    for _f in ("category", "urgency", "status"):
                        if merged.get(_f) not in (None, ""):
                            _sd[_f] = merged.get(_f)
            except Exception:
                pass
            for i, row in enumerate(self.emails):
                if row is existing:
                    self.emails[i] = merged
                    break
            idx[entry_id] = merged
            return False

        saved = self.status_data.get(entry_id, {}) if isinstance(self.status_data, dict) else {}
        if saved:
            if saved.get("app_deleted"):
                return False
            self.apply_saved_workflow_to_email(email, saved)
        email["is_new_import"] = True
        email["followup_time"] = self.get_followup_display_for_email(entry_id)
        email["body"] = email.get("body", "") or ""
        email["body_loaded"] = bool(email["body"])
        self.emails.append(email)
        idx[entry_id] = email
        return True

