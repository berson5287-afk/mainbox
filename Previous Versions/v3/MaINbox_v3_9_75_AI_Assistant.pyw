    def get_customer_hint_for_group(self, group, emails):
        text = (group.get("name", "") if group else "")
        for email in emails or []:
            sender = email.get("sender", "") or ""
            domain = get_email_domain(sender)
            if domain and not any(x in domain for x in ["gmail.com", "outlook.com", "yahoo.com", "hotmail.com"]):
                return domain
        return text.strip().lower()[:80]

    def extract_attachment_text_for_email(self, email, saved_file_callback=None):
        """Save Outlook attachments to a temp folder, extract text/OCR, and return text + debug details.

        saved_file_callback(path, filename) may be supplied by Quote Intelligence. It runs
        while the temp attachment still exists, so structured extraction can reuse the same
        saved file instead of re-downloading from Outlook or trying to access the temp folder
        after cleanup.

        v2.8.1 fix: this method can run safely inside the background Quote Intelligence
        thread because it initializes COM before touching Outlook objects. It also logs
        attachment count and filenames so the user can see exactly what happened.
        """
        did_com = outlook_thread_init()
        extracted = []
        details = []
        temp_root = ""
        try:
            msg = self.get_message_object(email)
            if not msg:
                details.append(f"{email.get('subject','Email')}: could not reopen Outlook message for attachment scan")
                return "", details
            try:
                atts = msg.Attachments
                count = int(atts.Count or 0)
            except Exception as exc:
                details.append(f"{email.get('subject','Email')}: could not read Outlook Attachments collection ({exc})")
                return "", details
            if count <= 0:
                details.append(f"{email.get('subject','Email')}: no Outlook attachments found")
                return "", details
            details.append(f"{email.get('subject','Email')}: Outlook reports {count} attachment(s)")
            temp_root = tempfile.mkdtemp(prefix="mainbox_qie_")
            for i in range(1, min(count, 15) + 1):
                try:
                    att = atts.Item(i)
                    raw_name = getattr(att, "FileName", "") or f"attachment_{i}"
                    fname = safe_filename_piece(raw_name, f"attachment_{i}")
                    try:
                        size = int(getattr(att, "Size", 0) or 0)
                    except Exception:
                        size = 0
                    ext_lower = os.path.splitext(fname)[1].lower()
                    # v2.10.41: In AI Only / vision mode, never skip image attachments as inline —
                    # they may be real scanned RFQ images. Only apply inline-skip in text/OCR modes.
                    ai_only_active = RFQ_PARSER_MODE in ["ai_only", "0", "false", "no", "off", "none"]
                    is_vision_image = ext_lower in (".png", ".jpg", ".jpeg", ".webp", ".bmp")
                    is_inline = outlook_attachment_is_inline(att)

                    # v2.10.33: Rescue inline body images that are large enough to be real
                    # content (>8 KB rules out 1x1 tracking pixels, small logos, dividers).
                    # Save them and pass through saved_file_callback so SmartScan's vision
                    # path can scan them — e.g. a photo of a quote pasted into the email body.
                    if is_inline and is_vision_image and saved_file_callback:
                        try:
                            inline_size = int(getattr(att, "Size", 0) or 0)
                        except Exception:
                            inline_size = 0
                        if inline_size >= 8192:
                            inline_fname = f"inline_body_image_{i}{ext_lower}"
                            inline_path = os.path.join(temp_root, inline_fname)
                            try:
                                att.SaveAsFile(inline_path)
                                if os.path.exists(inline_path):
                                    details.append(f"{fname}: rescued as inline body image ({inline_size} bytes) → SmartScan vision path")
                                    try:
                                        saved_file_callback(inline_path, inline_fname)
                                    except Exception as cb_exc:
                                        details.append(f"{inline_fname}: inline image SmartScan callback failed ({cb_exc})")
                                else:
                                    details.append(f"{fname}: inline image save failed — Outlook did not write file")
                            except Exception as inline_exc:
                                details.append(f"{fname}: inline image rescue failed ({inline_exc})")
                            continue
                        else:
                            details.append(f"{fname}: skipped inline image (too small at {inline_size} bytes — likely logo/signature/tracker)")
                            continue

                    if is_inline and not (ai_only_active and is_vision_image):
                        details.append(f"{fname}: skipped inline/signature image")
                        continue
                    if ext_lower in (".pdf", ".xlsx", ".xls", ".csv", ".doc", ".docx", ".txt", ".rtf", ".png", ".jpg", ".jpeg", ".webp", ".bmp"):
                        details.append(f"{fname}: accepted as real RFQ/document attachment; saving original Outlook file")
                    path = os.path.join(temp_root, fname)
                    att.SaveAsFile(path)
                    if RFQ_DEBUG_ATTACHMENTS and os.path.exists(path):
                        try:
                            os.makedirs(RFQ_DEBUG_DIR, exist_ok=True)
                            debug_copy = os.path.join(RFQ_DEBUG_DIR, fname)
                            shutil.copy2(path, debug_copy)
                            details.append(f"{fname}: DEBUG proof copy of original Outlook attachment saved to {debug_copy}")
                        except Exception as dbg_exc:
                            details.append(f"{fname}: DEBUG proof copy failed ({dbg_exc})")
                    if not os.path.exists(path):
                        details.append(f"{fname}: Outlook did not save file")
                        continue
                    details.append(f"{fname}: saved original Outlook attachment to temp file ({size} bytes)")
                    if saved_file_callback:
                        try:
                            saved_file_callback(path, fname)
                        except Exception as cb_exc:
                            details.append(f"{fname}: structured extraction callback failed ({cb_exc})")
                    text = read_text_from_file_best_effort(path)
                    if text and text.strip():
                        extracted.append(f"\n--- Attachment: {fname} ---\n{text[:18000]}")
                        details.append(f"{fname}: saved {size} bytes, extracted {len(text)} chars")
                    else:
                        ext = os.path.splitext(fname)[1].lower() or "unknown type"
                        details.append(f"{fname}: saved {size} bytes, no text extracted from {ext}; install OCR extras/Tesseract; for .xls/.doc files install Microsoft Office or pandas engines")
                except Exception as exc:
                    details.append(f"Attachment {i}: extraction failed ({exc})")
        finally:
            try:
                if temp_root:
                    shutil.rmtree(temp_root, ignore_errors=True)
            except Exception:
                pass
            outlook_thread_uninit(did_com)
        return "\n".join(extracted), details

    def load_body_for_rfq(self, email):
        """Always try to read the current Outlook body for RFQ extraction.

        The normal preview cache may intentionally store body_loaded=True even if Outlook
        was unavailable at that moment. Quote RFQ should not trust that empty cache.
        """
        cached = str(email.get("body", "") or "")
        if cached.strip():
            return cached
        msg = None
        try:
            msg = self.get_message_object(email)
        except Exception:
            msg = None
        if msg:
            try:
                body = str(getattr(msg, "Body", "") or "")
                if body.strip():
                    email["body"] = body
                    email["body_loaded"] = True
                    try:
                        self.save_cached_state()
                    except Exception:
                        pass
                    return body
            except Exception:
                pass
            try:
                html_body = str(getattr(msg, "HTMLBody", "") or "")
                if html_body.strip():
                    body = re.sub(r"(?i)<br\s*/?>", "\n", html_body)
                    body = re.sub(r"(?i)</p\s*>", "\n", body)
                    body = re.sub(r"<[^>]+>", " ", body)
                    body = re.sub(r"&nbsp;", " ", body)
                    body = re.sub(r"&amp;", "&", body)
                    body = re.sub(r"&quot;", "\"", body)
                    body = re.sub(r"&#39;", "'", body)
                    body = re.sub(r"\s+", " ", body)
                    email["body"] = body
                    email["body_loaded"] = True
                    try:
                        self.save_cached_state()
                    except Exception:
                        pass
                    return body
            except Exception:
                pass
        return cached

    def collect_quote_text_for_group(self, group_id):
        emails = self.get_emails_for_group(group_id)
        parts = []
        ocr_details = []
        for email in sorted(emails, key=lambda e: e.get("received_timestamp", 0), reverse=True)[:12]:
            try:
                body = self.load_body_for_rfq(email)
            except Exception:
                body = email.get("body", "") or ""
            parts.append(f"\n--- Email ---\nFrom: {email.get('sender','')}\nSubject: {email.get('subject','')}\nBody:\n{body[:8000]}")
            att_text, details = self.extract_attachment_text_for_email(email)
            if att_text:
                parts.append(att_text)
            ocr_details.extend(details)
        return "\n".join(parts), ocr_details

    def extract_materials_for_group(self, group_id, progress_callback=None):
        r"""STRICT vision-only RFQ extraction build.

        v2.8.4K is intentionally diagnostic and routes each real Outlook attachment by type. PDFs now use fast text-first extraction before slower vision fallback:
        - Creates %TEMP%\MaINbox_RFQ_Debug immediately at app startup.
        - Saves the original Outlook attachments through the existing SaveAsFile path.
        - Copies each saved attachment into the debug folder as proof.
        - For PDFs, first sends selectable PDF/table text to llama3.2:3b; only if weak/empty, renders limited pages to llama3.2-vision.
        - Sends XLSX/CSV/TXT/DOC-readable attachment text/table content to the normal text Llama model.
        - DOES NOT fall back to the old regex extractor when strict mode is on.

        This prevents the old EMT/PVC fallback result from hiding the real failure.
        """
        group = self.get_group_by_id(group_id)
        emails = self.get_emails_for_group(group_id)
        subject = group.get("name", "Quote Group") if group else "Quote Group"
        sender = emails[0].get("sender", "") if emails else ""
        detected_item_count = _rfq_expected_item_count_from_text("\n".join([subject] + [str(e.get("subject", "") or "") for e in emails]))
        try:
            configured_item_hint = int(getattr(self, "settings", {}).get("rfq_expected_item_count_hint", RFQ_EXPECTED_ITEM_COUNT_HINT))
        except Exception:
            configured_item_hint = RFQ_EXPECTED_ITEM_COUNT_HINT
        expected_item_count = detected_item_count or configured_item_hint

        parts = []
        ocr_details = []

        def log(message):
            try:
                msg = str(message)
            except Exception:
                msg = repr(message)
            # IMPORTANT: do not call log() from inside log(); that caused
            # "maximum recursion depth exceeded" immediately when RFQ scanning started.
            # Keep a local details trail and send the same message to the progress popup.
            try:
                ocr_details.append(msg)
            except Exception:
                pass
            if progress_callback:
                try:
                    progress_callback(msg)
                except Exception:
                    pass

        def log_many(messages):
            """Log a list/tuple of extraction status messages without breaking RFQ routing.

            v2.10.54: SmartScan was actually being called, but the RFQ route then
            called log_many() before this helper existed in this scope. That raised
            NameError and made MaINbox discard SmartScan's rows and fall back to the
            built-in extractor. Keep this helper local so both SmartScan and fallback
            status details use the same progress popup/detail trail.
            """
            if not messages:
                return
            if isinstance(messages, (str, bytes)):
                log(messages)
                return
            try:
                iterator = list(messages)
            except Exception:
                iterator = [messages]
            for item in iterator:
                log(item)

        def on_vision_page_result(src_name, page_number, page_rows, preview_path=""):
            """Send completed page rows to the UI/progress handler as soon as one page is done.

            The final cached result is still saved at the end.  When the RFQ window is already
            open, this event lets it append page results while later pages continue scanning.
            """
            try:
                clean_rows = normalize_material_items(page_rows or [])
                if not clean_rows:
                    return
                evt = {
                    "type": "rfq_page_result",
                    "group_id": group_id,
                    "source_name": src_name,
                    "page_number": page_number,
                    "preview_path": preview_path,
                    "rows": clean_rows,
                }
                if progress_callback:
                    try:
                        progress_callback(evt)
                    except Exception:
                        pass
                log(f"{src_name} page {page_number}: page-ready extraction returned {len(clean_rows)} row(s)")
            except Exception as cb_exc:
                log(f"{src_name} page {page_number}: page-ready UI callback failed ({cb_exc})")

        vision_materials = []
        body_typed_list_handled = False  # v3.9.52: set when a plain typed-list body is parsed line-by-line (skips SmartScan + AI re-parse)
        saved_attachment_paths = []
        saved_count = 0

        try:
            os.makedirs(RFQ_DEBUG_DIR, exist_ok=True)
            _rfq_debug_write("01_rfq_extraction_started.txt", (
                f"RFQ extraction started: {datetime.now().isoformat()}\n"
                f"Group: {subject}\n"
                f"Emails in group: {len(emails)}\n"
                f"Text model: {RFQ_TEXT_MODEL}\n"
                f"Vision model: {RFQ_VISION_MODEL}\n"
                f"Strict vision only: {RFQ_STRICT_VISION_ONLY}\n"
                f"Max PDF pages: {RFQ_VISION_MAX_PAGES}\n"
                f"Debug folder: {RFQ_DEBUG_DIR}\n"
            ))
        except Exception as exc:
            log(f"RFQ debug folder could not be initialized ({exc})")

        log(f"STRICT RFQ DEBUG MODE: debug folder = {RFQ_DEBUG_DIR}")
        log(f"RFQ extractor models: normal text={RFQ_TEXT_MODEL}, RFQ vision={RFQ_VISION_MODEL}, max_pdf_pages={RFQ_VISION_MAX_PAGES}")
        log(f"Parser-first mode: {RFQ_PARSER_MODE}. SmartScan default: {RFQ_USE_SMARTSCAN_FOR_RFQ}. SmartScan review window: {RFQ_SMARTSCAN_REVIEW_BEFORE_SEND}. Direct PDF tables: {RFQ_DIRECT_TABLE_PARSE}. Direct spreadsheets: True. Slow vision fallback enabled: {RFQ_ENABLE_VISION_FALLBACK}")
        log("Strict mode is ON: old regex fallback is disabled. PDFs use Docling/LiteParse direct table parsing first; spreadsheets use direct cell/table parsing first; llama3.2:3b is only used if needed. Vision is used only for images or if explicitly enabled.")
        if expected_item_count:
            log(f"Expected RFQ item count hint for AI prompt: {expected_item_count}. This is not used as a hard parser limit.")

        def on_saved_attachment(path, fname):
            nonlocal saved_count
            saved_count += 1
            source_name = fname or os.path.basename(str(path or "attachment"))
            review_path = ""
            try:
                size = os.path.getsize(path) if path and os.path.exists(path) else 0
            except Exception:
                size = 0
            log(f"OUTLOOK SAVE PROOF #{saved_count}: {source_name} saved to {path} ({size} bytes)")
            try:
                # Copy the exact saved Outlook attachment into the debug folder so the user can verify it.
                # IMPORTANT for SmartScan review mode: extract_attachment_text_for_email() deletes its
                # temporary Outlook-save folder when it returns.  v2.10.26 queued that temp path and
                # SmartScan opened later with a dead/missing file, which produced 0 lines even when
                # standalone SmartScan worked.  Queue this persistent proof copy instead.
                os.makedirs(RFQ_DEBUG_DIR, exist_ok=True)
                ext = os.path.splitext(source_name)[1] or os.path.splitext(str(path))[1]
                proof_name = _safe_debug_name(f"saved_original_{saved_count}_{os.path.splitext(source_name)[0]}") + ext
                proof_path = os.path.join(RFQ_DEBUG_DIR, proof_name)
                shutil.copy2(path, proof_path)
                review_path = proof_path
                log(f"DEBUG PROOF COPY: {proof_path}")
                try:
                    ext_l = os.path.splitext(source_name)[1].lower()
                    if ext_l in [".xls", ".xlsx", ".xlsm", ".xlsb", ".csv"]:
                        preview_png = create_rfq_spreadsheet_preview_image(path, source_name)
                        if preview_png:
                            log(f"{source_name}: spreadsheet preview image saved for debug: {preview_png}")
                        else:
                            log(f"{source_name}: spreadsheet preview image could not be created; falling back to source text review")
                except Exception as prev_exc:
                    log(f"{source_name}: spreadsheet preview image failed ({prev_exc})")
            except Exception as copy_exc:
                log(f"{source_name}: could not copy saved original into debug folder ({copy_exc})")
                try:
                    if path and os.path.exists(path):
                        # Last-resort persistent copy outside the soon-deleted temp Outlook folder.
                        keep_dir = os.path.join(tempfile.gettempdir(), "MaINbox_SmartScan_Review")
                        os.makedirs(keep_dir, exist_ok=True)
                        ext = os.path.splitext(source_name)[1] or os.path.splitext(str(path))[1]
                        keep_name = _safe_debug_name(f"review_{datetime.now().strftime('%Y%m%d_%H%M%S')}_{saved_count}_{os.path.splitext(source_name)[0]}") + ext
                        review_path = os.path.join(keep_dir, keep_name)
                        shutil.copy2(path, review_path)
                        log(f"SmartScan persistent review copy: {review_path}")
                except Exception as keep_exc:
                    log(f"{source_name}: could not create SmartScan persistent review copy ({keep_exc})")

            try:
                _rfq_debug_write(f"02_saved_attachment_{saved_count}_{source_name}.txt", (
                    f"Original filename: {source_name}\n"
                    f"Saved temp path: {path}\n"
                    f"SmartScan review path: {review_path or path}\n"
                    f"Size bytes: {size}\n"
                    f"Vision model: {RFQ_VISION_MODEL}\n"
                ))
            except Exception:
                pass

            if RFQ_USE_SMARTSCAN_FOR_RFQ and RFQ_SMARTSCAN_REVIEW_BEFORE_SEND:
                try:
                    candidate = review_path if (review_path and os.path.exists(review_path)) else path
                    if candidate and os.path.exists(candidate):
                        saved_attachment_paths.append(candidate)
                        if RFQ_SMARTSCAN_PAGEWISE_PDF and _smartscan_is_multipage_document(candidate):
                            log(f"{source_name}: queued multipage document for SmartScan pagewise pre-scan + merged-list review: {candidate}")
                        else:
                            log(f"{source_name}: queued persistent file for full SmartScan review: {candidate}")
                    else:
                        log(f"{source_name}: SmartScan review could not queue file because no saved copy exists")
                    log(f"{source_name}: queued for full SmartScan review window. Built-in attachment parser skipped for this attachment.")
                    return
                except Exception as queue_exc:
                    log(f"{source_name}: could not queue SmartScan review ({queue_exc}); falling back to headless/built-in route.")

            if RFQ_USE_SMARTSCAN_FOR_RFQ:
                try:
                    srows, smsgs, smerged = smartscan_extract_materials_from_saved_attachment(path, source_name, progress_callback=None)
                    if smsgs:
                        log_many(smsgs)
                    if smerged:
                        try:
                            parts.append(f"\n--- SmartScan Extracted Text: {source_name} ---\n" + smerged[:12000])
                        except Exception:
                            pass
                    if srows:
                        vision_materials.extend(srows)
                        log(f"{source_name}: SMARTSCAN RFQ SUCCESS - added {len(srows)} material row(s). Built-in RFQ extractor skipped for this attachment.")
                        return
                    log(f"{source_name}: SmartScan returned 0 rows; falling back to built-in RFQ extractor.")
                except Exception as smartscan_exc:
                    log(f"{source_name}: SmartScan RFQ route failed ({smartscan_exc}); falling back to built-in RFQ extractor.")
                    try:
                        _rfq_debug_write(f"99_smartscan_exception_{source_name}.txt", traceback.format_exc())
                    except Exception:
                        pass

            try:
                ext_lower = os.path.splitext(source_name)[1].lower()
                # v2.10.40: When parser mode is "off" (AI Only), skip all text/OCR extraction
                # and send the saved attachment file directly to llama3.2-vision as an image.
                # This mirrors the manual workflow (saved file -> vision model) that gives the
                # best accuracy for PDFs and images without any intermediate text conversion.
                ai_only_mode = RFQ_PARSER_MODE in ["ai_only", "0", "false", "no", "off", "none"]
                if ai_only_mode and ext_lower in [".pdf", ".png", ".jpg", ".jpeg", ".webp", ".bmp"]:
                    log(f"{source_name}: AI Only mode — sending saved file directly to vision model {RFQ_VISION_MODEL}")
                    rows, msgs = vision_first_extract_materials_from_saved_attachment(path, source_name, target_count=expected_item_count, page_callback=on_vision_page_result)
                    if msgs:
                        log_many(msgs)
                    route_label = f"direct vision model {RFQ_VISION_MODEL} (AI Only)"
                elif ext_lower == ".pdf":
                    # v2.8.4K: PDF text-first route. Many supplier/Kojo PDFs contain real selectable table text.
                    # This is much faster and usually more complete than rendering every page to llama3.2-vision.
                    rows, msg = ai_first_extract_materials_from_saved_attachment(path, source_name, subject=subject, sender=sender, expected_item_count=expected_item_count)
                    log(msg)
                    route_label = f"PDF text-first model {RFQ_TEXT_MODEL}"
                    current_count = len(rows or [])
                    if (not rows or current_count < int(os.environ.get("MAINBOX_RFQ_MIN_TEXT_ROWS_BEFORE_VISION", "8"))) and RFQ_ENABLE_VISION_FALLBACK:
                        log(f"{source_name}: PDF parser/text-first returned {current_count} row(s); trying optional vision fallback on up to {RFQ_VISION_MAX_PAGES} page(s)")
                        vrows, vmsgs = vision_first_extract_materials_from_saved_attachment(path, source_name, target_count=expected_item_count, page_callback=on_vision_page_result)
                        if vmsgs:
                            log_many(vmsgs)
                        if vrows and len(vrows) > len(rows or []):
                            rows = vrows
                            route_label = f"PDF vision fallback model {RFQ_VISION_MODEL}"
                        elif rows:
                            log(f"{source_name}: keeping PDF parser/text-first result because vision did not improve row count")
                    elif not rows or current_count < int(os.environ.get("MAINBOX_RFQ_MIN_TEXT_ROWS_BEFORE_VISION", "8")):
                        log(f"{source_name}: PDF parser/text-first returned {current_count} row(s); slow vision fallback is OFF. Set MAINBOX_RFQ_ENABLE_VISION_FALLBACK=1 only for scanned/image PDFs.")
                elif ext_lower in [".png", ".jpg", ".jpeg", ".webp", ".bmp"]:
                    rows, msgs = vision_first_extract_materials_from_saved_attachment(path, source_name)
                    if msgs:
                        log_many(msgs)
                    route_label = f"vision model {RFQ_VISION_MODEL}"
                else:
                    rows, msg = ai_first_extract_materials_from_saved_attachment(path, source_name, subject=subject, sender=sender, expected_item_count=expected_item_count)
                    msgs = [msg]
                    log_many(msgs)
                    route_label = f"text model {RFQ_TEXT_MODEL}"

                if rows:
                    vision_materials.extend(rows)
                    log(f"{source_name}: STRICT RFQ AI SUCCESS via {route_label} - added {len(rows)} material row(s)")
                else:
                    log(f"{source_name}: STRICT RFQ AI returned 0 usable rows via {route_label}")
            except Exception as vision_exc:
                log(f"{source_name}: STRICT RFQ AI ERROR ({vision_exc})")
                try:
                    _rfq_debug_write(f"99_rfq_ai_exception_{source_name}.txt", traceback.format_exc())
                except Exception:
                    pass

        for email in sorted(emails, key=lambda e: e.get("received_timestamp", 0), reverse=True)[:12]:
            try:
                body = self.load_body_for_rfq(email)
            except Exception:
                body = email.get("body", "") or ""
            parts.append(f"\n--- Email ---\nFrom: {email.get('sender','')}\nSubject: {email.get('subject','')}\nBody:\n{body[:12000]}")
            try:
                _rfq_debug_write("04_email_body_used_for_rfq.txt", body[:12000])
            except Exception:
                pass
            quick_rows = extract_materials_from_quote_text(body)
            # v3.9.52: a plain typed material list pasted in the email body (every line like
            # "50 ft - 750 AL BRBW X 4 SETS", or "500 mcm - CU black") must be parsed line-by-line,
            # NOT handed to SmartScan's table/column parser below. SmartScan is built for attachment
            # documents and corrupts such lists -- the "X N SETS" multiplier becomes its own phantom
            # row and real footages get dropped (the exact Quote-Coverage corruption seen on the
            # Edenwald RFQ). extract_typed_list_materials_from_body also recovers lines the quick
            # parser's filter drops because it doesn't recognize the unit (e.g. "500 mcm - CU black").
            typed_rows = extract_typed_list_materials_from_body(body)
            list_like_lines = [
                _ll for _ll in (body or "").splitlines()
                # v3.9.58: also count wire-gauge lines that begin with "#4AWG", "#8 AWG", etc.
                # Without the "#\d" alternative these lines were invisible to the typed-list
                # detector, so body_is_clean_typed_list stayed False and the body was handed to
                # BOTH SmartScan and the AI fallback -- each splitting the same line differently,
                # which produced the duplicate/mangled Quote Coverage rows. The >=60% threshold
                # below still guards against prose that merely mentions a "#4" in passing.
                if re.match(r"^\s*(?:[-*\u2022]\s*)?(?:#\s*\d|\d)", _ll)
            ]
            body_is_clean_typed_list = bool(
                len(typed_rows) >= 2
                and len(list_like_lines) >= 2
                and len(typed_rows) >= max(2, int(len(list_like_lines) * 0.6))
            )
            # The body is ALSO fed to SmartScan's structured parser below when it's
            # long enough (the >120 gate). Running both parsers on the same body and
            # keeping both results is what produced duplicate rows (raw quick-parse
            # rows + cleaned SmartScan rows). Only keep the quick-parse rows when
            # SmartScan will NOT take this body; if SmartScan whiffs, the
            # existing_count==0 fallback further below still recovers the body.
            _smartscan_will_take_body = bool(
                RFQ_USE_SMARTSCAN_FOR_RFQ and body and len(body.strip()) > 120
                and not body_is_clean_typed_list
            )
            if body_is_clean_typed_list:
                vision_materials.extend(typed_rows)
                body_typed_list_handled = True
                log(f"Email body: plain typed material list detected -- parsed {len(typed_rows)} "
                    f"row(s) line-by-line; SmartScan table parser bypassed for this body "
                    f"(prevents 'X N SETS' phantom rows in Quote Coverage)")
            elif quick_rows and not _smartscan_will_take_body:
                vision_materials.extend(quick_rows)
                log(f"Email body: simple typed-list parser found {len(quick_rows)} material row(s)")
            elif quick_rows:
                log(f"Email body: {len(quick_rows)} quick-parse row(s) deferred to SmartScan "
                    f"structured parser (single source, avoids duplicate rows)")
            log(f"Processing email: {email.get('subject','')} from {email.get('sender','')}")

            # v2.10.33: Feed the email body through SmartScan as a .txt file so its
            # structured parser (not just the end-of-pipeline LLM fallback) can find
            # typed material lists pasted directly into the email body.
            # Only do this when SmartScan is active and the body has meaningful content
            # (>120 chars after stripping whitespace — rules out empty/signature-only bodies).
            body_clean = body.strip() if body else ""
            if RFQ_USE_SMARTSCAN_FOR_RFQ and body_clean and len(body_clean) > 120 and not body_is_clean_typed_list:
                body_txt_fd = None
                body_txt_path = ""
                try:
                    body_txt_fd, body_txt_path = tempfile.mkstemp(
                        prefix="mainbox_rfq_body_",
                        suffix=".txt"
                    )
                    with os.fdopen(body_txt_fd, "w", encoding="utf-8", errors="ignore") as bfh:
                        bfh.write(f"Subject: {email.get('subject', '')}\n")
                        bfh.write(f"From: {email.get('sender', '')}\n\n")
                        bfh.write(body_clean[:20000])
                    body_txt_fd = None  # closed by fdopen context manager
                    body_fname = f"email_body_{safe_filename_piece(email.get('subject', 'email'), 'email')[:40]}.txt"
                    log(f"Email body: saved as temp .txt for SmartScan structured parser ({len(body_clean)} chars)")
                    try:
                        on_saved_attachment(body_txt_path, body_fname)
                    except Exception as body_cb_exc:
                        log(f"Email body SmartScan callback failed ({body_cb_exc})")
                except Exception as body_txt_exc:
                    log(f"Email body .txt save for SmartScan failed ({body_txt_exc})")
                finally:
                    try:
                        if body_txt_path and os.path.exists(body_txt_path):
                            os.remove(body_txt_path)
                    except Exception:
                        pass

            try:
                att_text, details = self.extract_attachment_text_for_email(email, saved_file_callback=on_saved_attachment)
                # Keep the text only for user/debug visibility, not for fallback extraction in strict mode.
                if att_text:
                    parts.append(att_text[:12000])
                if details:
                    log_many(details)
            except Exception as exc:
                log(f"Attachment save/extract path failed for email ({exc})")
                try:
                    _rfq_debug_write("99_attachment_save_exception.txt", traceback.format_exc())
                except Exception:
                    pass

        if RFQ_USE_SMARTSCAN_FOR_RFQ and RFQ_SMARTSCAN_REVIEW_BEFORE_SEND and saved_attachment_paths:
            try:
                unique_paths = []
                seen_paths = set()
                for sp in saved_attachment_paths:
                    key = os.path.abspath(str(sp))
                    if key not in seen_paths and os.path.exists(key):
                        unique_paths.append(sp)
                        seen_paths.add(key)
                if not unique_paths:
                    dead_count = len(saved_attachment_paths)
                    log(f"SmartScan review had {dead_count} queued attachment path(s), but none still exist. This should not happen after v2.10.27 persistent-copy fix; check RFQ debug folder.")
                log(f"Opening SmartScan review window for {len(unique_paths)} saved attachment(s). Correct rows there, then click Done → Send Back to MaINbox.")
                rrows, rmsgs, rmerged = _run_smartscan_review_subprocess(unique_paths, subject, progress_callback=progress_callback)
                log_many(rmsgs)
                if rmerged:
                    parts.append("\n--- SmartScan Reviewed Text ---\n" + rmerged[:50000])
                if rrows:
                    vision_materials.extend(rrows)
                    log(f"SMARTSCAN REVIEW SUCCESS - accepted {len(rrows)} corrected material row(s) from SmartScan.")
                else:
                    log("SmartScan review returned 0 rows; MaINbox will try the email body/text fallback if available.")
            except Exception as review_exc:
                log(f"SmartScan full review route failed ({review_exc}); MaINbox will try the email body/text fallback if available.")
                try:
                    _rfq_debug_write("99_smartscan_review_exception.txt", traceback.format_exc())
                except Exception:
                    pass

        quote_text = "\n".join(parts)

        # v2.8.4U: email-body RFQs are valid RFQs too.
        # The PDF/XLSX fixes made strict mode attachment-first, which was great for
        # documents but caused plain email requests with no attachment/table to return
        # zero items.  We now treat the combined email body text as its own source.
        # This runs after attachments so a perfect Docling/XLSX parse is left alone,
        # but if nothing was found from files, the normal text model can extract the
        # typed material list from the email body.
        try:
            existing_count = len(normalize_material_items(vision_materials))
            if quote_text.strip() and (saved_count == 0 or existing_count == 0) and not body_typed_list_handled:
                log("Email-body RFQ source detected; trying text-model extraction from the email body")
                body_rows = ask_ollama_extract_materials(subject, sender, quote_text)
                if body_rows:
                    vision_materials.extend(body_rows)
                    log(f"Email body: text model found {len(body_rows)} material row(s)")
                else:
                    # Keep this limited to email body mode. The old broad regex was bad
                    # for PDFs, but it is useful as a last-resort for short typed lists.
                    simple_rows = extract_materials_from_quote_text(quote_text)
                    if simple_rows:
                        vision_materials.extend(simple_rows)
                        log(f"Email body: simple parser found {len(simple_rows)} material row(s)")
                    else:
                        log("Email body: no material rows found by text model or simple parser")
        except Exception as body_exc:
            log(f"Email body extraction failed ({body_exc})")
            try:
                _rfq_debug_write("99_email_body_extraction_exception.txt", traceback.format_exc())
            except Exception:
                pass

        try:
            _rfq_debug_write("03_rfq_extraction_finished.txt", (
                f"Finished: {datetime.now().isoformat()}\n"
                f"Saved attachments seen by callback: {saved_count}\n"
                f"Strict AI material rows: {len(vision_materials)}\n"
                f"Strict mode: {RFQ_STRICT_VISION_ONLY}\n"
                f"Details:\n" + "\n".join(str(x) for x in ocr_details[-200:])
            ))
        except Exception:
            pass

        if saved_count == 0:
            log("NO OUTLOOK ATTACHMENTS WERE SAVED. Email-body extraction was attempted as the RFQ source.")
            try:
                _rfq_debug_write("98_no_attachments_saved.txt", "No Outlook attachments reached the saved_file_callback. Email-body extraction was attempted instead.")
            except Exception:
                pass

        materials = normalize_material_items(vision_materials)
        if RFQ_STRICT_VISION_ONLY:
            if not materials:
                log("STRICT RESULT: 0 rows from RFQ AI/body extraction. Check the debug folder for saved originals, parsed table text, text_model_response files, and email body logs.")
            return materials, quote_text, ocr_details, True

        # Optional escape hatch if MAINBOX_RFQ_STRICT_VISION_ONLY=0 is set.
        ai_materials = ask_ollama_extract_materials(subject, sender, quote_text)
        if ai_materials:
            materials.extend(ai_materials)
        if not materials:
            materials = extract_materials_from_quote_text(quote_text)
        return normalize_material_items(materials), quote_text, ocr_details, True


    def suggest_vendors_for_materials(self, materials, customer_hint=""):
        vendor_scores = {}
        vendor_reasons = {}
        hist = self.vendor_history or default_vendor_history()
        # v2.8.4V: procurement memory has stronger signal than basic vendor history.
        for pv in self.procurement_suggest_vendors_for_materials(materials, limit=20):
            email = str(pv.get("email", "") or "").lower().strip()
            if email and not is_blocked_internal_vendor(email, pv.get("name", "")):
                vendor_scores[email] = vendor_scores.get(email, 0) + int(pv.get("score", 0) or 0) + 25
                vendor_reasons.setdefault(email, set()).add("procurement memory: " + str(pv.get("reason", "")))
        for item in materials or []:
            key = normalize_material_key(item.get("part_number", ""), item.get("description", ""))
            matches = hist.get("materials", {}).get(key, [])
            if not matches and item.get("description"):
                desc = str(item.get("description", "")).lower()
                for mat_key, mat_matches in hist.get("materials", {}).items():
                    if mat_key and (mat_key in desc or desc[:30] in mat_key):
                        matches.extend(mat_matches[:3])
            for match in matches:
                email = str(match.get("email", "") or "").lower().strip()
                if not email or is_blocked_internal_vendor(email, match.get("name", "")):
                    continue
                vendor_scores[email] = vendor_scores.get(email, 0) + 3 + int(match.get("times_used", 1) or 1)
                vendor_reasons.setdefault(email, set()).add(f"matched {item.get('part_number') or item.get('description','item')}")
        if customer_hint:
            for email, rec in hist.get("customers", {}).get(customer_hint, {}).items():
                if is_blocked_internal_vendor(email, rec.get("name", "")):
                    continue
                vendor_scores[email] = vendor_scores.get(email, 0) + int(rec.get("times_used", 1) or 1) + 2
                vendor_reasons.setdefault(email, set()).add("used for this customer/job before")
        # v2.9.5: Do NOT add every known vendor to every RFQ.
        # Vendors should only appear when they match the current material/customer
        # through procurement memory, material history, or customer/job history.
        # This fixes real vendors like David Lesser/Leviton appearing universally.
        ranked = []
        for email, score in sorted(vendor_scores.items(), key=lambda x: x[1], reverse=True)[:12]:
            rec = hist.get("vendors", {}).get(email, {}) or (self.procurement_memory or {}).get("vendors", {}).get(email, {})
            if is_blocked_internal_vendor(email, rec.get("name", "")):
                continue
            ranked.append({"email": email, "name": rec.get("name", email), "score": score, "reason": "; ".join(sorted(vendor_reasons.get(email, [])))})
        return ranked

    def build_vendor_rfq_body(self, materials):
        material_text = format_materials_for_email(materials)
        if not material_text:
            material_text = "[Paste material list here]"
        return f"Hi,\n\nPlease provide me with price and availability for the below.\n\nThanks!\n\n{material_text}"

    def create_outlook_mail_item(self, to_addr, subject, body, display_only=True):
        outlook, namespace = self.fresh_outlook()
        if not outlook:
            raise Exception("Could not connect to Outlook.")
        mail = outlook.CreateItem(0)
        mail.To = to_addr
        mail.Subject = subject
        mail.HTMLBody = html_escape_basic(body)
        if display_only:
            self.display_outlook_item_foreground(mail)
        else:
            mail.Send()
        return True

    def create_or_update_outlook_commitment_reminder(self, item):
        """v3.8.15: drop (or reschedule) a real Outlook calendar reminder for a
        commitment so it shows in the user's Outlook calendar and alarms even when
        MaINbox is closed. Fully guarded and thread-safe; never raises, never blocks
        reminder creation. Returns True if an appointment was created/updated."""
        if not isinstance(item, dict):
            return False
        if not bool(self.settings.get("commitment_create_outlook_reminder", True)):
            return False
        did_init = outlook_thread_init()
        try:
            outlook, namespace = self.fresh_outlook()
            if not outlook:
                return False
            try:
                start_dt = datetime.fromisoformat(item.get("due_at", ""))
            except Exception:
                return False
            label = item.get("kind_label", "Promised date")
            subj = (item.get("subject", "") or "").strip()
            target = item.get("target_date", "")
            try:
                target_disp = datetime.fromisoformat(target).strftime("%m/%d/%Y") if target else ""
            except Exception:
                target_disp = str(target or "")
            appt_subject = f"Follow up: {label}" + (f" - {subj}" if subj else "")
            body_lines = [
                "MaINbox auto-reminder.",
                f"Type: {label}",
                f"Promised/target date: {target_disp}",
                f"From: {item.get('sender','')}",
                f"Subject: {subj}",
            ]
            matched = (item.get("matched_text", "") or "").strip()
            if matched:
                body_lines.append("")
                body_lines.append(f"Detected: {matched}")
            appt_body = "\n".join(body_lines)

            appt = None
            existing_id = item.get("outlook_appt_entry_id", "")
            if existing_id and namespace:
                try:
                    appt = namespace.GetItemFromID(existing_id)
                except Exception:
                    appt = None
            created_new = False
            if appt is None:
                appt = outlook.CreateItem(1)  # olAppointmentItem
                created_new = True
            appt.Subject = appt_subject
            appt.Body = appt_body
            appt.Start = start_dt
            appt.Duration = 15  # minutes
            appt.ReminderSet = True
            appt.ReminderMinutesBeforeStart = 0
            try:
                appt.BusyStatus = 0  # olFree - a reminder, not a blocking meeting
            except Exception:
                pass
            try:
                appt.Categories = "MaINbox Follow-Up"
            except Exception:
                pass
            appt.Save()
            try:
                new_id = appt.EntryID or ""
            except Exception:
                new_id = ""
            if new_id and new_id != existing_id:
                item["outlook_appt_entry_id"] = new_id
                try:
                    self.save_commitment_reminders()
                except Exception:
                    pass
            try:
                self.log(f"Outlook calendar reminder {'created' if created_new else 'updated'} for {start_dt.strftime('%m/%d %I:%M %p')}: {appt_subject[:60]}")
            except Exception:
                pass
            return True
        except Exception:
            return False
        finally:
            try:
                outlook_thread_uninit(did_init)
            except Exception:
                pass

    def learn_vendor_history_from_rfq(self, vendors, materials, group, emails):
        customer_hint = self.get_customer_hint_for_group(group, emails)
        hist = self.vendor_history
        now = datetime.now().isoformat()
        for vendor in vendors:
            email = str(vendor.get("email", "") or "").lower().strip()
            name = str(vendor.get("name", "") or email).strip()
            if not email or is_blocked_internal_vendor(email, name):
                continue
            vrec = hist.setdefault("vendors", {}).setdefault(email, {"email": email, "name": name, "times_used": 0, "last_used_at": ""})
            vrec["name"] = name or vrec.get("name", email)
            vrec["times_used"] = int(vrec.get("times_used", 0) or 0) + 1
            vrec["last_used_at"] = now
            if customer_hint:
                crec = hist.setdefault("customers", {}).setdefault(customer_hint, {}).setdefault(email, {"times_used": 0, "last_used_at": ""})
                crec["times_used"] = int(crec.get("times_used", 0) or 0) + 1
                crec["last_used_at"] = now
            for item in materials or []:
                key = normalize_material_key(item.get("part_number", ""), item.get("description", ""))
                if not key:
                    continue
                entries = hist.setdefault("materials", {}).setdefault(key, [])
                found = None
                for rec in entries:
                    if str(rec.get("email", "")).lower() == email:
                        found = rec
                        break
                if not found:
                    found = {"email": email, "name": name, "times_used": 0, "last_used_at": ""}
                    entries.append(found)
                found["times_used"] = int(found.get("times_used", 0) or 0) + 1
                found["last_used_at"] = now
                found["sample_description"] = item.get("description", "")
        self.save_vendor_history()
        try:
            self.record_procurement_request(vendors, materials, group, subject="RFQ")
        except Exception:
            pass

    def open_quote_intelligence_for_selected_group(self):
        group_id = self.selected_group_id_from_groups_tree()
        group = self.get_group_by_id(group_id)
        if not group:
            messagebox.showwarning("No Group Selected", "Select a quote/job group first.")
            return
        emails = self.get_emails_for_group(group_id)
        if not emails:
            messagebox.showwarning("No Emails In Group", "Add the customer quote request email to this group first.")
            return

        cached = self.get_rfq_cache_record(group_id)
        if cached and normalize_material_items(cached.get("materials", [])):
            cached_materials = normalize_material_items(cached.get("materials", []))
            cached_vendors = list(cached.get("vendors", []))
            if not cached_vendors:
                customer_hint = self.get_customer_hint_for_group(group, emails)
                cached_vendors = self.suggest_vendors_for_materials(cached_materials, customer_hint)
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, f"Opened cached RFQ extractor data instantly. Last saved: {cached.get('updated_at','unknown')}\n")
            self.open_quote_intelligence_window(group_id, cached_materials, cached_vendors, cached.get("ocr_details", ["Loaded from RFQ extractor cache."]), cached.get("used_ai", False))
            return

        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, "Quote Intelligence is scanning email bodies and attachments. A live progress window has opened.\n")

        progress_win = tk.Toplevel(self.root)
        progress_win.title("MaINbox RFQ Extraction Progress")
        remember_window_geometry(progress_win, "MaINbox RFQ Extraction Progress", "860x520")
        progress_win.transient(self.root)
        progress_win.lift()

        header = tk.Frame(progress_win)
        header.pack(fill="x", padx=10, pady=(10, 4))
        status_var = tk.StringVar(value="Starting RFQ extraction...")
        tk.Label(header, text="RFQ extraction is running", font=("Segoe UI", 12, "bold")).pack(anchor="w")
        tk.Label(header, textvariable=status_var, fg=_FG_DIM).pack(anchor="w", pady=(2, 0))

        progress_bar = ttk.Progressbar(progress_win, mode="indeterminate")
        progress_bar.pack(fill="x", padx=10, pady=(2, 8))
        progress_bar.start(12)

        progress_text = tk.Text(progress_win, wrap="word", height=22)
        progress_text.pack(fill="both", expand=True, padx=10, pady=(0, 8))
        progress_text.insert(tk.END, "Starting...\n")
        progress_text.configure(state="disabled")

        bottom = tk.Frame(progress_win)
        bottom.pack(fill="x", padx=10, pady=(0, 10))
        close_btn = tk.Button(bottom, text="Close", command=progress_win.destroy, state="disabled")
        close_btn.pack(side="right")

        def add_progress_line(message):
            try:
                if not progress_win.winfo_exists():
                    return
                progress_text.configure(state="normal")
                progress_text.insert(tk.END, "• " + str(message) + "\n")
                progress_text.see(tk.END)
                progress_text.configure(state="disabled")
                status_var.set(str(message)[:140])
            except Exception:
                pass

        def finish_progress(message, success=True):
            try:
                if not progress_win.winfo_exists():
                    return
                progress_bar.stop()
                status_var.set(message)
                progress_text.configure(state="normal")
                progress_text.insert(tk.END, "\n" + message + "\n")
                progress_text.see(tk.END)
                progress_text.configure(state="disabled")
                close_btn.configure(state="normal")
            except Exception:
                pass

        def progress_callback(message):
            if isinstance(message, dict) and message.get("type") == "rfq_page_result":
                def handle_page_event(evt=message):
                    try:
                        rows = normalize_material_items(evt.get("rows", []) or [])
                        src_name = evt.get("source_name", "attachment")
                        page_no = evt.get("page_number", "")
                        add_progress_line(f"{src_name} page {page_no} is ready - added {len(rows)} row(s) to the RFQ window.")
                        updater = None
                        try:
                            updater = getattr(self, "_rfq_live_windows", {}).get(group_id)
                        except Exception:
                            updater = None
                        if updater:
                            updater(rows, src_name, page_no, evt.get("preview_path", ""))
                        elif rows:
                            # Open a partial RFQ window as soon as page 1 finishes so the user can review
                            # while later pages continue extracting in the background.
                            customer_hint_now = self.get_customer_hint_for_group(group, emails)
                            vendors_now = self.suggest_vendors_for_materials(rows, customer_hint_now)
                            self.open_quote_intelligence_window(group_id, rows, vendors_now, [f"{src_name} page {page_no}: page-ready result"], True)
                            updater = getattr(self, "_rfq_live_windows", {}).get(group_id)
                            if updater and evt.get("preview_path"):
                                updater([], src_name, page_no, evt.get("preview_path", ""))
                    except Exception as ev_exc:
                        add_progress_line(f"Page-ready UI update failed: {ev_exc}")
                self.root.after(0, handle_page_event)
            else:
                self.root.after(0, lambda m=message: add_progress_line(m))

        def worker():
            try:
                materials, quote_text, ocr_details, used_ai = self.extract_materials_for_group(group_id, progress_callback=progress_callback)
                customer_hint = self.get_customer_hint_for_group(group, emails)
                vendors = self.suggest_vendors_for_materials(materials, customer_hint)
                self.record_rfq_cache(group_id, materials=materials, vendors=vendors, ocr_details=ocr_details,
                                      used_ai=used_ai, quote_text=quote_text, group=group, emails=emails,
                                      customer_hint=customer_hint)
                def finish_and_open_or_update():
                    try:
                        updater = getattr(self, "_rfq_live_windows", {}).get(group_id)
                    except Exception:
                        updater = None
                    if updater:
                        updater(materials, "Final RFQ", "", "")
                        finish_progress(f"Finished. Extracted {len(materials)} material row(s). RFQ window is already open and updated.")
                    else:
                        finish_progress(f"Finished. Extracted {len(materials)} material row(s). Opening RFQ window...")
                        self.open_quote_intelligence_window(group_id, materials, vendors, ocr_details, used_ai)
                self.root.after(0, finish_and_open_or_update)
            except Exception as exc:
                err = str(exc)
                self.root.after(0, lambda e=err: finish_progress(f"RFQ extraction failed: {e}", success=False))
                self.root.after(0, lambda e=err: messagebox.showerror("Quote Intelligence Error", f"Could not scan this group.\n\n{e}"))
        threading.Thread(target=worker, daemon=True).start()

    def open_quote_intelligence_for_selected_email(self, email=None):
        """Open Quote RFQ directly from one selected email, no visible group required."""
        if email is None:
            emails = self.get_selected_emails()
            if not emails:
                 return
            email = emails[0]
        entry_id = str(email.get("entry_id", "") or "")
        if not entry_id:
            messagebox.showwarning("No Email Selected", "Select the customer quote request email first.")
            return

        # Create an in-memory temporary group so the existing RFQ extraction and
        # send window can work unchanged, without adding anything to Groups/Quote Jobs.
        subject = str(email.get("subject", "") or "Single Email RFQ").strip() or "Single Email RFQ"
        group_id = "single_email_rfq:" + entry_id
        group = {
            "id": group_id,
            "name": subject,
            "urgency": email.get("urgency", "Normal") or "Normal",
            "status": email.get("status", "Needs Reply") or "Needs Reply",
            "created_at": datetime.now().isoformat(),
            "single_email_rfq": True,
        }
        if not hasattr(self, "_single_email_rfq_groups") or self._single_email_rfq_groups is None:
            self._single_email_rfq_groups = {}
        self._single_email_rfq_groups[group_id] = {"group": group, "email": email}

        cached = self.get_rfq_cache_record(group_id)
        if cached and normalize_material_items(cached.get("materials", [])):
            cached_materials = normalize_material_items(cached.get("materials", []))
            cached_vendors = list(cached.get("vendors", []))
            if not cached_vendors:
                customer_hint = self.get_customer_hint_for_group(group, [email])
                cached_vendors = self.suggest_vendors_for_materials(cached_materials, customer_hint)
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, f"Opened cached RFQ extractor data instantly. Last saved: {cached.get('updated_at','unknown')}\n")
            self.open_quote_intelligence_window(group_id, cached_materials, cached_vendors, cached.get("ocr_details", ["Loaded from RFQ extractor cache."]), cached.get("used_ai", False))
            return

        self.preview_text.delete("1.0", tk.END)
        self.preview_text.insert(tk.END, "Quote RFQ is scanning this selected email and attachments. A live progress window has opened.\n")

        progress_win = tk.Toplevel(self.root)
        progress_win.title("MaINbox RFQ Extraction Progress")
        remember_window_geometry(progress_win, "MaINbox RFQ Extraction Progress", "860x520")
        progress_win.transient(self.root)
        progress_win.lift()

        header = tk.Frame(progress_win)
        header.pack(fill="x", padx=10, pady=(10, 4))
        status_var = tk.StringVar(value="Starting RFQ extraction...")
        tk.Label(header, text="RFQ extraction is running", font=("Segoe UI", 12, "bold")).pack(anchor="w")
        tk.Label(header, textvariable=status_var, fg=_FG_DIM).pack(anchor="w", pady=(2, 0))

        progress_bar = ttk.Progressbar(progress_win, mode="indeterminate")
        progress_bar.pack(fill="x", padx=10, pady=(2, 8))
        progress_bar.start(12)

        progress_text = tk.Text(progress_win, wrap="word", height=22)
        progress_text.pack(fill="both", expand=True, padx=10, pady=(0, 8))
        progress_text.insert(tk.END, "Starting...\n")
        progress_text.configure(state="disabled")

        bottom = tk.Frame(progress_win)
        bottom.pack(fill="x", padx=10, pady=(0, 10))
        close_btn = tk.Button(bottom, text="Close", command=progress_win.destroy, state="disabled")
        close_btn.pack(side="right")

        def add_progress_line(message):
            try:
                if not progress_win.winfo_exists():
                    return
                progress_text.configure(state="normal")
                progress_text.insert(tk.END, "• " + str(message) + "\n")
                progress_text.see(tk.END)
                progress_text.configure(state="disabled")
                status_var.set(str(message)[:140])
            except Exception:
                pass

        def finish_progress(message, success=True):
            try:
                if not progress_win.winfo_exists():
                    return
                progress_bar.stop()
                status_var.set(message)
                progress_text.configure(state="normal")
                progress_text.insert(tk.END, "\n" + message + "\n")
                progress_text.see(tk.END)
                progress_text.configure(state="disabled")
                close_btn.configure(state="normal")
            except Exception:
                pass

        def progress_callback(message):
            if isinstance(message, dict) and message.get("type") == "rfq_page_result":
                def handle_page_event(evt=message):
                    try:
                        rows = normalize_material_items(evt.get("rows", []) or [])
                        src_name = evt.get("source_name", "attachment")
                        page_no = evt.get("page_number", "")
                        add_progress_line(f"{src_name} page {page_no} is ready - added {len(rows)} row(s) to the RFQ window.")
                        updater = None
                        try:
                            updater = getattr(self, "_rfq_live_windows", {}).get(group_id)
                        except Exception:
                            updater = None
                        if updater:
                            updater(rows, src_name, page_no, evt.get("preview_path", ""))
                        elif rows:
                            customer_hint_now = self.get_customer_hint_for_group(group, [email])
                            vendors_now = self.suggest_vendors_for_materials(rows, customer_hint_now)
                            self.open_quote_intelligence_window(group_id, rows, vendors_now, [f"{src_name} page {page_no}: page-ready result"], True)
                            updater = getattr(self, "_rfq_live_windows", {}).get(group_id)
                            if updater and evt.get("preview_path"):
                                updater([], src_name, page_no, evt.get("preview_path", ""))
                    except Exception as ev_exc:
                        add_progress_line(f"Page-ready UI update failed: {ev_exc}")
                self.root.after(0, handle_page_event)
            else:
                self.root.after(0, lambda m=message: add_progress_line(m))

        def worker():
            try:
                materials, quote_text, ocr_details, used_ai = self.extract_materials_for_group(group_id, progress_callback=progress_callback)
                customer_hint = self.get_customer_hint_for_group(group, [email])
                vendors = self.suggest_vendors_for_materials(materials, customer_hint)
                self.record_rfq_cache(group_id, materials=materials, vendors=vendors, ocr_details=ocr_details,
                                      used_ai=used_ai, quote_text=quote_text, group=group, emails=[email],
                                      customer_hint=customer_hint)
                def finish_and_open_or_update():
                    try:
                        updater = getattr(self, "_rfq_live_windows", {}).get(group_id)
                    except Exception:
                        updater = None
                    if updater:
                        updater(materials, "Final RFQ", "", "")
                        finish_progress(f"Finished. Extracted {len(materials)} material row(s). RFQ window is already open and updated.")
                    else:
                        finish_progress(f"Finished. Extracted {len(materials)} material row(s). Opening RFQ window...")
                        self.open_quote_intelligence_window(group_id, materials, vendors, ocr_details, used_ai)
                self.root.after(0, finish_and_open_or_update)
            except Exception as exc:
                err = str(exc)
                self.root.after(0, lambda e=err: finish_progress(f"RFQ extraction failed: {e}", success=False))
                self.root.after(0, lambda e=err: messagebox.showerror("Quote RFQ Error", f"Could not scan this email.\n\n{e}"))

        threading.Thread(target=worker, daemon=True).start()

    def open_quote_intelligence_window(self, group_id, materials, vendors, ocr_details, used_ai):
        """v2.8.4C RFQ & Materials Extractor.

        Keeps v2.8.3 as the base and upgrades only the RFQ/material editing UI:
        - spreadsheet-style material grid
        - editable cells with Enter = next row same column
        - UOM dropdown support
        - multi-row batch edit with Yes/No prompt
        - selected items move to ITEMS ALREADY REQUESTED only after Send RFQs Now
        """
        group = self.get_group_by_id(group_id)
        emails = self.get_emails_for_group(group_id)
        customer_hint = self.get_customer_hint_for_group(group, emails)

        mat_items = []
        vend_items = []
        requested_records = []
        cell_editor = {"widget": None, "row": None, "col": None}
        last_edit_col = {"col": "qty"}
        UOM_VALUES = ["", "ft", "ea", "m", "c", "in", "pc", "box", "roll", "set", "lot"]

        def save_current_rfq_cache():
            """Cache the current RFQ window state, including user edits."""
            try:
                subj = subject_var.get().strip() if "subject_var" in locals() else ""
            except Exception:
                subj = ""
            try:
                body = body_text.get("1.0", tk.END).strip() if "body_text" in locals() else ""
            except Exception:
                body = ""
            try:
                self.record_rfq_cache(group_id, materials=mat_items, vendors=vend_items, ocr_details=ocr_details,
                                      used_ai=used_ai, group=group, emails=emails, customer_hint=customer_hint,
                                      requested_records=requested_records, subject=subj, body=body)
            except Exception:
                pass

        cached_window_state = self.get_rfq_cache_record(group_id)

        def _build_left_source_text():
            """Build the source body shown on the left side of the RFQ window.

            This intentionally does not change extraction behavior; it only gives the
            user the original/cached RFQ text beside the extracted rows for easier
            line-by-line review and manual teaching/correction.
            """
            try:
                cached_quote_text = str((cached_window_state or {}).get("quote_text", "") or "").strip()
                if cached_quote_text:
                    return cached_quote_text
            except Exception:
                pass
            parts = []
            try:
                for e in emails or []:
                    subj = str(e.get("subject", "") or "").strip()
                    sender = str(e.get("sender", "") or "").strip()
                    received = str(e.get("received", "") or "").strip()
                    body = str(e.get("body", "") or "").strip()
                    block = []
                    if subj:
                        block.append(f"Subject: {subj}")
                    if sender:
                        block.append(f"From: {sender}")
                    if received:
                        block.append(f"Received: {received}")
                    if body:
                        block.append("Body:\n" + body)
                    if block:
                        parts.append("\n".join(block))
            except Exception:
                pass
            return "\n\n--- EMAIL ---\n\n".join(parts).strip() or "No cached email body/source text is available for this RFQ."

        source_body_text = _build_left_source_text()

        for rr in cached_window_state.get("requested_records", []) if isinstance(cached_window_state, dict) else []:
            if isinstance(rr, dict):
                requested_records.append(rr)

        for rec in self.quote_requests or []:
            if rec.get("group_id") == group_id:
                sent_to = ", ".join([f"{v.get('name', v.get('email',''))} <{v.get('email','')}>" for v in rec.get("vendors", [])])
                sent_on = rec.get("created_at", "")
                for m in normalize_material_items(rec.get("materials", [])):
                    requested_records.append({"selected": False, "material": m, "sent_to": sent_to, "sent_on": sent_on})

        # Avoid duplicate "already requested" rows when cached state and quote history overlap.
        try:
            deduped_requested = []
            seen_requested = set()
            for rr in requested_records:
                m = rr.get("material", {}) if isinstance(rr, dict) else {}
                key = re.sub(r"\s+", " ", f"{canonical_material_key(m)}|{rr.get('sent_to','')}|{rr.get('sent_on','')}".lower()).strip()
                if key in seen_requested:
                    continue
                seen_requested.add(key)
                deduped_requested.append(rr)
            requested_records[:] = deduped_requested
        except Exception:
            pass

        win = tk.Toplevel(self.root)
        apply_theme(win)
        win.title(f"MaINbox v3 Procurement Memory RFQ - {group.get('name','') if group else ''}")
        remember_window_geometry(win, "Procurement Memory RFQ", "1560x980")
        try:
            win.minsize(1420, 860)
        except Exception:
            pass
        win.transient(self.root)

        # ---------------- Header ----------------
        header = tk.Frame(win)
        header.pack(fill="x", padx=10, pady=(8, 4))
        tk.Label(header, text="MaINbox - RFQ & Materials Extractor", font=("Segoe UI", 16, "bold")).pack(side="left")
        engine_label = "AI + OCR text" if used_ai else "OCR/heuristic extraction"
        tk.Label(header, text=f"   Extraction mode: {engine_label}", fg=_FG_DIM, font=("Segoe UI", 9)).pack(side="left")

        outer = tk.PanedWindow(win, orient=tk.HORIZONTAL, sashrelief=tk.RAISED)
        outer.pack(fill="both", expand=True, padx=10, pady=4)
        left_panel = tk.Frame(outer)
        center_panel = tk.Frame(outer)
        right_panel = tk.Frame(outer)
        outer.add(left_panel, minsize=270)
        outer.add(center_panel, minsize=760)
        outer.add(right_panel, minsize=430)

        # ---------------- Left side source/body + OCR info panel ----------------
        left_view_mode = {"mode": "body"}

        left_toolbar = tk.Frame(left_panel)
        left_toolbar.pack(fill="x", padx=4, pady=(4, 2))
        left_title_var = tk.StringVar(value="Email Body / Source Text")
        left_toggle_var = tk.StringVar(value="Show Scan Output")
        tk.Label(left_toolbar, textvariable=left_title_var, font=("Segoe UI", 10, "bold"), anchor="w").pack(side="left", fill="x", expand=True)

        left_content = tk.Frame(left_panel)
        left_content.pack(fill="both", expand=True, padx=4, pady=(0, 6))

        source_frame = tk.Frame(left_content)
        source_frame.pack(fill="both", expand=True)
        source_help = tk.Label(
            source_frame,
            text="Review the customer email/source text beside the extracted rows. Use Add Row or edit the grid to teach/correct missing line items.",
            anchor="w", justify="left", wraplength=450, fg=_FG_DIM
        )
        source_help.pack(fill="x", padx=5, pady=(4, 2))
        source_text = tk.Text(source_frame, height=28, wrap="word", font=("Segoe UI", 9))
        source_scroll = ttk.Scrollbar(source_frame, orient="vertical", command=source_text.yview)
        source_text.configure(yscrollcommand=source_scroll.set)
        source_text.pack(side="left", fill="both", expand=True, padx=(5, 0), pady=5)
        source_scroll.pack(side="right", fill="y", padx=(0, 5), pady=5)
        source_text.insert("1.0", source_body_text)

        scan_frame = tk.Frame(left_content)

        # v2.10.45: Scan Output / teaching view.  This is a review aid only; it does
        # not change the extraction pipeline.  It shows the saved scan/page preview
        # when available and highlights the likely source row as the user moves
        # through extracted items.  User edits are recorded into procurement memory
        # so future RFQ prompts can learn from corrections.
        scan_preview_frame = tk.Frame(scan_frame)
        scan_preview_frame.pack(fill="both", expand=True, padx=0, pady=(0, 4))
        scan_nav = tk.Frame(scan_preview_frame)
        scan_nav.pack(fill="x", padx=5, pady=(4, 2))
        scan_hint_var = tk.StringVar(value="Select an extracted line item to highlight its likely source. Edit or add rows on the right to teach MaINbox.")
        tk.Label(scan_nav, textvariable=scan_hint_var, anchor="w", justify="left", wraplength=430).pack(side="left", fill="x", expand=True)

        scan_canvas_frame = tk.Frame(scan_preview_frame)
        scan_canvas_frame.pack(fill="both", expand=True, padx=5, pady=5)
        scan_canvas = tk.Canvas(scan_canvas_frame, bg="#ffffff", highlightthickness=1, highlightbackground="#999999")
        scan_canvas_v = ttk.Scrollbar(scan_canvas_frame, orient="vertical", command=scan_canvas.yview)
        scan_canvas_h = ttk.Scrollbar(scan_canvas_frame, orient="horizontal", command=scan_canvas.xview)
        scan_canvas.configure(yscrollcommand=scan_canvas_v.set, xscrollcommand=scan_canvas_h.set)
        scan_canvas.grid(row=0, column=0, sticky="nsew")
        scan_canvas_v.grid(row=0, column=1, sticky="ns")
        scan_canvas_h.grid(row=1, column=0, sticky="ew")
        scan_canvas_frame.grid_rowconfigure(0, weight=1)
        scan_canvas_frame.grid_columnconfigure(0, weight=1)
        scan_img_state = {"tk": None, "path": "", "scale": 1.0, "w": 0, "h": 0, "highlight": None}

        def _extract_existing_path_from_detail(detail):
            text = str(detail or "")
            # Prefer rendered PDF/image previews. Also accept saved original image files.
            patterns = [
                r"spreadsheet preview image saved for debug:\s*(.+?\.(?:png|jpg|jpeg|webp|bmp))",
                r"rendered PDF page image saved for debug:\s*(.+?\.(?:png|jpg|jpeg|webp|bmp))",
                r"DEBUG PROOF COPY:\s*(.+?\.(?:png|jpg|jpeg|webp|bmp))",
                r"saved to\s+(.+?\.(?:png|jpg|jpeg|webp|bmp))\s*\(",
            ]
            for pat in patterns:
                m = re.search(pat, text, flags=re.I)
                if not m:
                    continue
                candidate = m.group(1).strip().strip('"')
                if os.path.exists(candidate):
                    return candidate
            return ""

        def _find_scan_preview_path(material=None):
            """Find the best original preview image, preferring the selected item's page/source."""
            try:
                desired_page = None
                desired_source = ""
                if isinstance(material, dict):
                    desired_source = str(material.get("source", "") or "") + " " + str(material.get("source_page", "") or "")
                    pm = re.search(r"page\s*(\d+)", desired_source, flags=re.I)
                    if pm:
                        desired_page = int(pm.group(1))
                candidates = []
                for d in ocr_details or []:
                    path = _extract_existing_path_from_detail(d)
                    if not path:
                        continue
                    score = 0
                    text = str(d or "")
                    if desired_page is not None and re.search(rf"page\s*{desired_page}", text, flags=re.I):
                        score += 10
                    if isinstance(material, dict):
                        src = str(material.get("source", "") or "")
                        for token in re.split(r"[:\/ ]+", src):
                            token = token.strip()
                            if len(token) >= 4 and token.lower() in text.lower():
                                score += 2
                                break
                    candidates.append((score, path))
                if candidates:
                    candidates.sort(reverse=True)
                    return candidates[0][1]
            except Exception:
                pass
            return ""

        # Maps item index -> canvas Y coordinate in text-preview mode.
        # Populated by _draw_text_scan_preview() and used by the highlighter
        # so it doesn't have to recompute row positions on every selection.
        _text_preview_row_y = {}

        def _draw_text_scan_preview():
            scan_canvas.delete("all")
            _text_preview_row_y.clear()
            scan_img_state.update({"tk": None, "path": "", "scale": 1.0, "w": 0, "h": 0, "highlight": None})
            scan_canvas.create_text(10, 10, anchor="nw", text="No original document image preview was found. Showing source text rows as a review guide.", fill="#111111", font=("Segoe UI", 10, "bold"))
            y = 42
            scan_canvas.create_text(10, y, anchor="nw", text="Qty", fill="#111111", font=("Segoe UI", 9, "bold"))
            scan_canvas.create_text(80, y, anchor="nw", text="Material / Description", fill="#111111", font=("Segoe UI", 9, "bold"))
            y += 24
            total_rows = min(len(mat_items), 300)
            for i, m in enumerate(mat_items[:300]):
                row_y = y + i * 26
                _text_preview_row_y[i] = row_y          # store for fast lookup
                scan_canvas.create_line(5, row_y - 4, 900, row_y - 4, fill="#cccccc")
                scan_canvas.create_text(10, row_y, anchor="nw", text=str(m.get("qty", "")), fill="#111111", font=("Segoe UI", 10))
                scan_canvas.create_text(80, row_y, anchor="nw", text=str(m.get("source_text", "") or m.get("description", "") or m.get("part_number", "")), fill="#111111", font=("Segoe UI", 10))
            # Scrollregion height is the actual bottom of content + padding.
            canvas_h = max(420, y + total_rows * 26 + 40)
            scan_canvas.configure(scrollregion=(0, 0, 950, canvas_h))

        def _load_scan_preview_image(force=False, material=None):
            path = _find_scan_preview_path(material)
            if not path:
                # Only redraw the text preview when we are not already showing it
                # (i.e. no cached image is displayed).  This avoids a full canvas
                # redraw — and loss of the "source_highlight" rectangle — on every
                # item selection when no image is available.
                if scan_img_state.get("tk") is not None or not _text_preview_row_y:
                    _draw_text_scan_preview()
                    scan_hint_var.set("No saved original document preview was found. MaINbox will highlight source text rows instead.")
                return False
            if not force and scan_img_state.get("path") == path and scan_img_state.get("tk") is not None:
                return True
            try:
                from PIL import Image, ImageTk
                img = Image.open(path)
                max_w = 620
                scale = min(1.0, float(max_w) / max(1, img.width))
                if scale < 1.0:
                    img = img.resize((int(img.width * scale), int(img.height * scale)))
                tk_img = ImageTk.PhotoImage(img)
                scan_canvas.delete("all")
                scan_canvas.create_image(0, 0, anchor="nw", image=tk_img, tags=("scan_image",))
                scan_canvas.configure(scrollregion=(0, 0, img.width, img.height))
                scan_img_state.update({"tk": tk_img, "path": path, "scale": scale, "w": img.width, "h": img.height, "highlight": None})
                scan_hint_var.set(f"Showing saved scan preview: {os.path.basename(path)}. Select/edit items to highlight and teach MaINbox.")
                return True
            except Exception as exc:
                _draw_text_scan_preview()
                scan_hint_var.set(f"Scan preview image could not be loaded ({exc}). Showing extracted-row guide instead.")
                return False

        def _highlight_source_text_for_material(m):
            try:
                source_text.tag_remove("rfq_current_source", "1.0", tk.END)
                source_text.tag_configure("rfq_current_source", background="#5a4a22", foreground="#fff4cc")
                candidates = [str(m.get("source_text", "") or ""), str(m.get("description", "") or ""), str(m.get("part_number", "") or ""), str(m.get("qty", "") or "")]
                candidates = [c.strip() for c in candidates if len(c.strip()) >= 2]
                for cand in candidates:
                    pos = source_text.search(cand, "1.0", nocase=True, stopindex=tk.END)
                    if pos:
                        end = f"{pos}+{len(cand)}c"
                        source_text.tag_add("rfq_current_source", pos, end)
                        source_text.see(pos)
                        break
            except Exception:
                pass

        def _parse_source_bbox_pct(value):
            try:
                if isinstance(value, str):
                    value = value.strip()
                    if not value:
                        return None
                    try:
                        value = json.loads(value)
                    except Exception:
                        nums = re.findall(r"-?\d+(?:\.\d+)?", value)
                        value = [float(x) for x in nums[:4]]
                if isinstance(value, dict):
                    value = [value.get("x1"), value.get("y1"), value.get("x2"), value.get("y2")]
                if not isinstance(value, (list, tuple)) or len(value) < 4:
                    return None
                vals = [float(value[i]) for i in range(4)]
                if vals[2] <= vals[0] or vals[3] <= vals[1]:
                    return None
                # Accept either percent 0-100 or normalized 0-1.
                if max(vals) <= 1.5:
                    vals = [v * 100.0 for v in vals]
                vals = [max(0.0, min(100.0, v)) for v in vals]
                return vals
            except Exception:
                return None

        # Debounce token for highlight_selected_material_source so rapid keyboard
        # navigation doesn't queue a burst of redundant canvas updates.
        _highlight_pending = {"after_id": None}

        def _do_highlight_selected_material_source():
            """Actual highlight work; always called via after() so it can be debounced."""
            _highlight_pending["after_id"] = None
            try:
                sel = mat_tree.selection() if "mat_tree" in locals() else []
                if not sel:
                    return
                idx = int(sel[0])
                if idx < 0 or idx >= len(mat_items):
                    return
                m = mat_items[idx]
                _highlight_source_text_for_material(m)

                # ── Determine whether the image needs switching ─────────────────
                # Find the best preview path for this item *before* we draw
                # anything so we know whether the canvas needs to change.
                new_path = _find_scan_preview_path(m)
                currently_image = scan_img_state.get("tk") is not None
                current_path   = scan_img_state.get("path", "")

                image_changed = new_path and (new_path != current_path)

                if image_changed:
                    # Image switch: reload first, *then* draw the rectangle below.
                    _load_scan_preview_image(False, m)
                elif not currently_image:
                    # Already in text mode — ensure the text grid is drawn.
                    if not _text_preview_row_y:
                        _draw_text_scan_preview()
                # (If same image is already shown, skip the reload entirely.)

                # ── Remove old highlight rectangle ───────────────────────────────
                try:
                    scan_canvas.delete("source_highlight")
                except Exception:
                    pass

                # ── Parse line/row number hint from item metadata ────────────────
                line_text = str(m.get("source_page", "") or m.get("notes", "") or "")
                line_num = None
                lm = re.search(r"(?:row|line)\s*(\d+)", line_text, flags=re.I)
                if lm:
                    try:
                        line_num = int(lm.group(1))
                    except Exception:
                        line_num = None

                if scan_img_state.get("tk") is not None:
                    # ── IMAGE mode ───────────────────────────────────────────────
                    w = max(120, int(scan_img_state.get("w") or 500))
                    h = max(120, int(scan_img_state.get("h") or 500))
                    bbox = _parse_source_bbox_pct(m.get("source_bbox_pct"))

                    if bbox:
                        x1 = int((bbox[0] / 100.0) * w)
                        y1 = int((bbox[1] / 100.0) * h)
                        x2 = int((bbox[2] / 100.0) * w)
                        y2 = int((bbox[3] / 100.0) * h)
                    elif line_num:
                        # Spreadsheet/table: map explicit row number to visual row.
                        scale = float(scan_img_state.get("scale") or 1.0)
                        y1 = max(10, min(h - 45, int((18 + line_num * 24) * scale)))
                        y2 = min(h - 5, y1 + 34)
                        x1, x2 = 8, w - 8
                    else:
                        # Proportional fallback — place the band in the document
                        # body area (skipping ~10 % header / footer margin) so it
                        # doesn't always snap to the very top or bottom.
                        body_top    = int(h * 0.10)
                        body_bottom = int(h * 0.90)
                        total = max(1, len(mat_items))
                        frac  = idx / max(1, total - 1)
                        mid   = body_top + int((body_bottom - body_top) * frac)
                        band  = max(20, int((body_bottom - body_top) / max(1, total)))
                        y1 = max(body_top, mid - band // 2)
                        y2 = min(body_bottom, y1 + band)
                        x1, x2 = 8, w - 8

                    scan_canvas.create_rectangle(x1, y1, x2, y2, outline="#c99632", width=3, tags=("source_highlight",))
                    try:
                        label_text = f"Item {idx + 1}: {m.get('qty','')} {m.get('description','') or m.get('part_number','')}"
                        lx = max(8, x1)
                        ly = max(8, y1 - 18)
                        scan_canvas.create_text(lx, ly, anchor="nw", text=label_text[:80], fill="#000000", font=("Segoe UI", 9, "bold"), tags=("source_highlight",))
                    except Exception:
                        pass
                    scan_canvas.tag_raise("source_highlight")

                    # Scroll so the highlighted band sits roughly 20 % from the
                    # top of the visible area, clamped to [0, 1].
                    view_margin = int(scan_canvas.winfo_height() * 0.20) if scan_canvas.winfo_height() > 1 else 60
                    target_top  = max(0, y1 - view_margin)
                    frac_scroll = target_top / max(1, h)
                    scan_canvas.yview_moveto(min(1.0, max(0.0, frac_scroll)))

                else:
                    # ── TEXT-PREVIEW mode ────────────────────────────────────────
                    # Use the pre-computed Y positions from _draw_text_scan_preview
                    # so there's no off-by-one between what's drawn and what we scroll to.
                    row_y = _text_preview_row_y.get(idx)
                    if row_y is None:
                        # Fallback if the index is out of the rendered range.
                        row_y = 66 + idx * 26
                    scan_canvas.create_rectangle(5, row_y - 5, 900, row_y + 22,
                                                 outline="#c99632", width=2, fill="",
                                                 tags=("source_highlight",))
                    scan_canvas.tag_raise("source_highlight")

                    # Correct scroll fraction: use the actual scrollregion height.
                    sr = scan_canvas.cget("scrollregion")
                    try:
                        canvas_h = float(str(sr).split()[-1]) if sr else max(420, 66 + len(mat_items) * 26 + 40)
                    except Exception:
                        canvas_h = max(420, 66 + len(mat_items) * 26 + 40)
                    view_margin = int(scan_canvas.winfo_height() * 0.20) if scan_canvas.winfo_height() > 1 else 60
                    target_top  = max(0, row_y - view_margin)
                    frac_scroll = target_top / max(1, canvas_h)
                    scan_canvas.yview_moveto(min(1.0, max(0.0, frac_scroll)))

                scan_hint_var.set(f"Source highlight for item {idx + 1}: {m.get('qty','')} {m.get('description','') or m.get('part_number','')}")
            except Exception:
                pass

