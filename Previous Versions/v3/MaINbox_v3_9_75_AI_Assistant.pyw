    def refresh_new_emails(self):
        """v3.9.40: manual Refresh now runs the Outlook mailbox walk on a BACKGROUND engine
        (a worker thread with its own thread-local COM namespace) and applies the results on
        the Tk main thread, so the UI stays fully responsive during a refresh instead of
        freezing for minutes while Outlook is walked on a slow/uncached mailbox.

        Sent-tracker reconciliation is handled as emails come in (cached clears in the apply
        step) rather than via a synchronous Sent Items scan, which was a large part of the old
        freeze. The heavy Outlook property reads all happen on the worker; the main-thread apply
        is cached-only and fast."""
        if getattr(self, "_refresh_running", False):
            try:
                self.last_updated_var.set("Refresh already in progress \u2014 still working in the background...")
            except Exception:
                pass
            return
        # Commit any visible manual workflow dropdown edits before the refresh re-imports/renders.
        try:
            self.save_pending_selected_workflow_edits_before_refresh()
        except Exception:
            pass
        # v3.9.48: snapshot every existing email's workflow the instant Refresh begins. The
        # background mailbox walk frees the main thread (that is what stops the freeze), so a
        # timer (the auto-triage drip) or an in-flight triage can mutate these rows WHILE the
        # refresh rebuilds them -- which is how a manually-set urgency/category/status was being
        # lost. We restore this snapshot after the rebuild, so Refresh can never change a workflow
        # the user already set. Keyed by EntryID, with a stable subject+sender+timestamp fallback
        # so it still matches if Cached Exchange Mode hands the same message back with a new EntryID.
        try:
            self._pre_refresh_wf_by_eid = {}
            self._pre_refresh_wf_by_key = {}
            for _e in self.emails:
                if not isinstance(_e, dict):
                    continue
                _rec = {
                    "category": _e.get("category"),
                    "urgency": _e.get("urgency"),
                    "status": _e.get("status"),
                    "email_type": _e.get("email_type"),
                    "ai_triaged_at": _e.get("ai_triaged_at"),
                    "ai_triage_pending": _e.get("ai_triage_pending"),
                    "ai_user_locked": _e.get("ai_user_locked"),
                    "ai_triage_skipped": _e.get("ai_triage_skipped"),
                }
                _eid = _e.get("entry_id")
                if _eid:
                    self._pre_refresh_wf_by_eid[_eid] = _rec
                try:
                    _subj = normalize_subject_for_match(_e.get("subject", "") or "")
                    _snd = str(_e.get("sender_email", "") or _e.get("sender", "") or "").strip().lower()
                    _ts = int(float(_e.get("received_timestamp", 0) or 0))
                    if _subj and _snd:
                        self._pre_refresh_wf_by_key[(_subj, _snd, _ts)] = _rec
                except Exception:
                    pass
        except Exception:
            self._pre_refresh_wf_by_eid = {}
            self._pre_refresh_wf_by_key = {}
        self._refresh_running = True
        try:
            self.last_updated_var.set("Refreshing in the background \u2014 you can keep working\u2026")
            self.connection_status_var.set("Outlook: refreshing")
        except Exception:
            pass

        def work(outlook, namespace):
            collected = self._refresh_collect_inbound(namespace)
            # v3.9.56: vendor pricing comes back INBOUND (My Inbox / shared Sales Inbox).
            # v3.9.27's refresh_new_emails scanned the inbox here to flip matched coverage
            # items to Quoted, but that call was lost when this method moved its Outlook walk
            # onto the background worker (v3.9.40). Result: an inbound priced reply imports and
            # is visible, yet its requested items never flip to Quoted unless a heavy manual
            # full-refresh is run. Re-run the inbox quote scan here -- on the worker thread, off
            # the Tk main thread, so it cannot freeze the refresh. scan_recent_inbox_for_quotes
            # is conservative + idempotent and saves coverage atomically (save_json -> os.replace),
            # so it is safe alongside the rest of refresh / a concurrent AutoPilot cycle.
            try:
                self.scan_recent_inbox_for_quotes()
            except Exception:
                pass
            return collected

        def done(collected):
            try:
                self._refresh_apply_inbound(collected or [])
            except Exception:
                pass
            finally:
                self._refresh_running = False

        def err(exc):
            self._refresh_running = False
            try:
                msg = str(exc) or ""
                if "already busy" in msg or "skipped this background pass" in msg:
                    # v3.9.60: AutoPilot (or another Outlook worker) holds the serialization
                    # lock. Nothing was changed; the next Refresh/AutoPilot tick will catch up.
                    self.last_updated_var.set("Refresh skipped - a background sync was running. Try Refresh again in a moment.")
                    return
                if self.is_outlook_disconnect_error(exc):
                    self.reset_outlook_connection("manual refresh")
                    self.last_updated_var.set("Outlook reconnecting \u2014 click Refresh again in a moment. Nothing was changed.")
                    self.connection_status_var.set("Outlook: disconnected")
                else:
                    self.last_updated_var.set("Refresh error \u2014 nothing was changed.")
                    self.connection_status_var.set("Outlook: refresh error")
            except Exception:
                pass

        self.run_outlook_worker(work, on_done=done, on_error=err, label="manual-refresh")

    def _collect_folder_dicts(self, folder, source_label, scan_limit, category_filter):
        """v3.9.40 worker side: walk ONE folder newest-first and return plain email dicts via
        build_email_data (which returns message=None, so nothing apartment-bound is marshalled
        back). No upsert, no tracker mutation, no Tk -- safe off the main thread. Mirrors the
        COM walk in import_from_folder but collects instead of applying."""
        out = []
        try:
            messages = folder.Items
            try:
                messages.Sort("[ReceivedTime]", True)
            except Exception:
                pass
            iterable = messages
            using_restrict = False
            if category_filter:
                try:
                    category = self.selected_sales_category.replace("'", "''")
                    restricted = messages.Restrict(f"@SQL=\"urn:schemas-microsoft-com:office:office#Keywords\" LIKE '%{category}%'")
                    restricted.Sort("[ReceivedTime]", True)
                    iterable = restricted
                    using_restrict = True
                except Exception:
                    iterable = messages
                    using_restrict = False
            ordered = []
            try:
                m = iterable.GetFirst()
                guard = 0
                while m is not None and guard < 100000:
                    guard += 1
                    ordered.append(m)
                    if scan_limit is not None and len(ordered) >= scan_limit:
                        break
                    m = iterable.GetNext()
            except Exception:
                ordered = []
            scan_source = ordered if ordered else iterable
            scanned = 0
            for msg in scan_source:
                if scan_limit is not None and scanned >= scan_limit:
                    break
                scanned += 1
                try:
                    if category_filter and not using_restrict:
                        outlook_categories = msg.Categories or ""
                        if not self.email_has_outlook_category(outlook_categories, self.selected_sales_category):
                            continue
                    email = self.build_email_data(msg, source_label)
                    if not email:
                        continue
                    out.append(email)
                except Exception:
                    continue
        except Exception:
            pass
        return out

    def _refresh_collect_inbound(self, namespace):
        """v3.9.40 worker side of Refresh: collect recent My Inbox + Sales emails as plain dicts
        from a thread-local namespace. No state mutation that touches Tk, no rendering."""
        collected = []
        try:
            my_folder = namespace.GetDefaultFolder(6)  # olFolderInbox
            collected.extend(self._collect_folder_dicts(my_folder, "My Inbox", FAST_MY_INBOX_SCAN_LIMIT, False))
        except Exception:
            pass
        try:
            sales_folder = self._find_sales_inbox_folder_in(namespace)
            if sales_folder:
                collected.extend(self._collect_folder_dicts(sales_folder, "Sales", FAST_SALES_SCAN_LIMIT, True))
        except Exception:
            pass
        return collected

    def _refresh_apply_inbound(self, collected):
        """v3.9.40 main-thread side of Refresh: apply the worker-collected email dicts (upsert,
        duplicate suppression, new-item handling), reconcile sent/waiting trackers AS THE REPLIES
        ARRIVE (cached clears -- no Outlook COM), then render and save. Contains no Outlook COM,
        so it cannot freeze the UI no matter how slow the mailbox is."""
        added_my = 0
        added_sales = 0
        self._begin_commitment_batch()
        try:
            for email in collected:
                try:
                    is_new = self.upsert_email(email)
                    self.suppress_my_inbox_duplicate_when_sales_copy_exists(email)
                    if is_new and email.get("urgency") != "Low":
                        self.handle_new_email_after_import(email, silent=True)
                    # Sent trackers are handled as emails come in: a reply that just arrived
                    # clears its matching waiting tracker. Both clears are cached (operate on
                    # self.emails / self.sent_waiting_placeholders), so there is no COM here.
                    self.clear_sent_waiting_placeholder_for_reply(email)
                    self.clear_existing_sent_waiting_tracker_rows_for_reply(email)
                    if is_new:
                        if email.get("source") == "Sales":
                            added_sales += 1
                        else:
                            added_my += 1
                except Exception:
                    continue
        finally:
            try:
                self._flush_commitment_batch()
            except Exception:
                pass
        # v3.9.75: re-group any still-ungrouped RFQ-template reply. Nothing re-evaluates an email
        # imported under an older grouping matcher, so a reply that names only a bare job number
        # (now matched as of v3.9.74) would otherwise stay ungrouped forever. Deterministic + cheap.
        try:
            self.retroactively_group_pa_template_replies()
        except Exception:
            pass
        try:
            self.cleanup_duplicates(reason="pre_render", save=True)
        except Exception:
            pass
        # v3.9.48: restore the workflow snapshot taken when Refresh began, so nothing that ran on
        # the freed main thread during the background walk (auto-triage drip, in-flight triage) can
        # change a category/urgency/status the user set. Existing rows are matched by EntryID first,
        # then by a stable subject+sender+timestamp key (covers EntryID drift); genuinely new emails
        # are not in the snapshot, so their fresh classification is left untouched.
        try:
            _by_eid = getattr(self, "_pre_refresh_wf_by_eid", None) or {}
            _by_key = getattr(self, "_pre_refresh_wf_by_key", None) or {}
            if _by_eid or _by_key:
                for _e in self.emails:
                    if not isinstance(_e, dict):
                        continue
                    _rec = _by_eid.get(_e.get("entry_id"))
                    if _rec is None:
                        try:
                            _subj = normalize_subject_for_match(_e.get("subject", "") or "")
                            _snd = str(_e.get("sender_email", "") or _e.get("sender", "") or "").strip().lower()
                            _ts = int(float(_e.get("received_timestamp", 0) or 0))
                            _rec = _by_key.get((_subj, _snd, _ts))
                        except Exception:
                            _rec = None
                    if not _rec:
                        continue
                    for _f, _v in _rec.items():
                        if _v not in (None, ""):
                            _e[_f] = _v
                    # keep status_data in agreement so the restored value also survives a later restart.
                    try:
                        _sd = self.status_data.get(_e.get("entry_id")) if isinstance(self.status_data, dict) else None
                        if isinstance(_sd, dict):
                            for _f in ("category", "urgency", "status"):
                                if _rec.get(_f) not in (None, ""):
                                    _sd[_f] = _rec.get(_f)
                    except Exception:
                        pass
        except Exception:
            pass
        finally:
            self._pre_refresh_wf_by_eid = {}
            self._pre_refresh_wf_by_key = {}
        # v3.9.69: the snapshot restore above would revert these corrections on an
        # EXISTING row, so they run AFTER it (and so apply on a plain Refresh, not
        # only to brand-new mail):
        #   (1) Outlook shows the user already replied to a row still marked "Needs
        #       Reply" -> it isn't Needs Reply; flip to the matching Waiting.
        #   (2) A thread the user JUST replied to, in a group, not yet Completed, may
        #       now be a closed deal (won order / PO provided, or a cancellation).
        #       Load its body once and, if so, propose the archive Cleanup. Gated by
        #       user_replied + group membership, so this touches only a tiny set
        #       (just-replied threads) -- never a full-mailbox body load.
        try:
            _checked = getattr(self, "_closed_checked_eids", None)
            if not isinstance(_checked, set):
                _checked = self._closed_checked_eids = set()
            _budget = 30
            for _e in self.emails:
                if not isinstance(_e, dict):
                    continue
                _eid = _e.get("entry_id", "")
                _replied = bool(_e.get("user_replied"))
                _grouped = bool(self.get_group_id_for_email(_eid))
                _handled = False
                # A thread that is now CLOSED -- won order, cancellation, or the
                # customer declining ("thanks anyway", "went with another") -- is
                # DONE. Check it for (a) anything the user just replied to, and (b)
                # any grouped, not-yet-checked quote thread, so a customer walk-away
                # is caught even when we never replied. Body loaded once; the budget
                # + a session 'checked' set keep this off the hot path.
                _do = False
                if _e.get("status") != "Completed":
                    if _replied:
                        _do = True
                    elif _grouped and _eid not in _checked and _budget > 0:
                        _do = True
                        _budget -= 1
                        _checked.add(_eid)
                if _do:
                    try:
                        if self.load_body_for_rfq(_e):
                            _closed, _phrase, _kind = self._email_request_is_closed(_e)
                            if _closed:
                                _e["status"] = "Completed"
                                try:
                                    _sd = self.status_data.get(_eid) if isinstance(self.status_data, dict) else None
                                    if isinstance(_sd, dict):
                                        _sd["status"] = "Completed"
                                except Exception:
                                    pass
                                try:
                                    self._cancel_active_followups_for_email(_e, reason="Quote closed")
                                except Exception:
                                    pass
                                self._assistant_propose_cleanup(_e, _phrase, _kind)
                                _handled = True
                    except Exception:
                        pass
                # Otherwise, a still-"Needs Reply" row the user already replied to is
                # no longer Needs Reply -> flip to the matching Waiting.
                if not _handled and _replied and _e.get("status") == "Needs Reply":
                    _ns = "Waiting on Vendor" if str(_e.get("email_type", "")).upper() == "V" else "Waiting on Customer"
                    _e["status"] = _ns
                    try:
                        _sd = self.status_data.get(_eid) if isinstance(self.status_data, dict) else None
                        if isinstance(_sd, dict):
                            _sd["status"] = _ns
                    except Exception:
                        pass
        except Exception:
            pass
        try:
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.save_cached_state()
        except Exception:
            pass
        try:
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(
                tk.END,
                f"Refresh complete.\n\nNew My Inbox emails imported: {added_my}\n"
                f"New Sales emails imported: {added_sales}\n\n"
                "The mailbox walk ran in the background, so MaINbox stayed responsive the whole time. "
                "Sent/waiting trackers are reconciled as replies arrive.")
        except Exception:
            pass
        try:
            cov_threads, cov_items = self.coverage_outstanding_summary()
            if cov_items > 0:
                self.preview_text.insert(
                    tk.END,
                    f"\n\n\u26a0 Quote coverage: {cov_items} requested item(s) still need quotes "
                    f"across {cov_threads} thread(s). Click \"Quote Coverage\" to see the list.")
        except Exception:
            pass
        try:
            self.last_updated_var.set(f"Last updated: {datetime.now().strftime('%I:%M:%S %p')} \u2014 background refresh")
            self.connection_status_var.set("Outlook: connected")
        except Exception:
            pass


    def apply_visual_settings_to_existing_widgets(self, widget=None):
        """Retheme already-created Tk widgets without rebuilding the UI."""
        if widget is None:
            widget = self.root
        try:
            apply_theme(self.root)
        except Exception:
            pass
        try:
            cls = widget.winfo_class()
        except Exception:
            cls = ""
        try:
            if isinstance(widget, (tk.Frame, tk.LabelFrame)):
                widget.configure(bg=_BG)
            elif isinstance(widget, tk.Label):
                widget.configure(bg=_BG, fg=_FG)
                try:
                    current_font = font.Font(font=widget.cget("font"))
                    current_size = abs(int(current_font.actual().get("size", _FONT_SIZE)))
                    current_weight = current_font.actual().get("weight", "normal")
                    if current_size <= 12:
                        widget.configure(font=(_FONT, _FONT_SIZE, "bold" if current_weight == "bold" else _FONT_WEIGHT))
                except Exception:
                    pass
            elif isinstance(widget, tk.Button):
                widget.configure(bg=_BTN_BG, fg=_BTN_FG, activebackground=_ACCENT2, activeforeground="#ffffff", font=(_FONT, _FONT_SIZE, _FONT_WEIGHT))
            elif isinstance(widget, tk.Entry):
                widget.configure(bg=_ENTRY_BG, fg=_FG, insertbackground=_FG, font=(_FONT, _FONT_SIZE, _FONT_WEIGHT))
            elif isinstance(widget, tk.Text):
                widget.configure(bg=_BG3, fg=_FG, insertbackground=_FG, selectbackground=_SEL_BG, selectforeground=_SEL_FG, font=(_FONT, _FONT_SIZE, _FONT_WEIGHT))
            elif isinstance(widget, tk.Listbox):
                widget.configure(bg=_BG3, fg=_FG, selectbackground=_SEL_BG, selectforeground=_SEL_FG, font=(_FONT, _FONT_SIZE, _FONT_WEIGHT))
        except Exception:
            pass
        try:
            for child in widget.winfo_children():
                self.apply_visual_settings_to_existing_widgets(child)
        except Exception:
            pass
        try:
            self.normal_font.configure(family=_FONT, size=_FONT_SIZE, weight=_FONT_WEIGHT)
            self.bold_font.configure(family=_FONT, size=_FONT_SIZE, weight="bold")
        except Exception:
            pass
        try:
            self.configure_tree_tags()
        except Exception:
            pass
        try:
            self.tree.configure(style="Treeview")
        except Exception:
            pass
        try:
            self.render_email_rows()
        except Exception:
            pass
        try:
            self.root.update_idletasks()
        except Exception:
            pass


    def apply_visual_settings_with_wait_splash(self, message="Applying visual changes..."):
        """Hide existing windows, show a short themed wait splash, repaint, then restore."""
        import time as _time

        root = getattr(self, "root", None)
        hidden_windows = []

        def _hide_window(win):
            try:
                if not win or not win.winfo_exists():
                    return
                state = win.state()
                # Do not try to restore windows that were already withdrawn/iconified.
                if state in ("normal", "zoomed"):
                    hidden_windows.append((win, state))
                    win.withdraw()
            except Exception:
                pass

        try:
            # Hide child/top-level windows first so the user does not watch them repaint.
            for child in list(root.winfo_children()):
                try:
                    if isinstance(child, tk.Toplevel) and child.winfo_exists():
                        _hide_window(child)
                except Exception:
                    pass
            _hide_window(root)
        except Exception:
            pass

        splash = None
        try:
            splash = tk.Toplevel(root)
            splash.title("Please wait")
            splash.resizable(False, False)
            splash.attributes("-topmost", True)
            try:
                splash.configure(bg=_BG)
                apply_theme(splash)
            except Exception:
                pass

            tk.Label(
                splash,
                text="Please wait...",
                font=(_FONT, max(12, _FONT_SIZE + 4), "bold"),
                fg=_ACCENT,
                bg=_BG,
            ).pack(pady=(26, 8), padx=26)
            tk.Label(
                splash,
                text=message,
                font=(_FONT, max(9, _FONT_SIZE), _FONT_WEIGHT),
                fg=_FG_DIM,
                bg=_BG,
                wraplength=360,
                justify="center",
            ).pack(pady=(0, 12), padx=26)
            progress = ttk.Progressbar(splash, mode="indeterminate", length=300)
            progress.pack(pady=(0, 22), padx=26)
            progress.start(12)

            try:
                splash.update_idletasks()
                w, h = 420, 160
                x = (splash.winfo_screenwidth() // 2) - (w // 2)
                y = (splash.winfo_screenheight() // 2) - (h // 2)
                splash.geometry(f"{w}x{h}+{x}+{y}")
                splash.update()
            except Exception:
                pass

            _time.sleep(0.20)
            try:
                self.apply_visual_settings_to_existing_widgets()
            except Exception:
                pass
            try:
                splash.update()
            except Exception:
                pass
            _time.sleep(0.20)

        finally:
            try:
                if splash and splash.winfo_exists():
                    splash.destroy()
            except Exception:
                pass

            # Restore only windows that were visible before the visual refresh.
            for win, state in hidden_windows:
                try:
                    if win and win.winfo_exists():
                        win.deiconify()
                        if state == "zoomed":
                            try:
                                win.state("zoomed")
                            except Exception:
                                pass
                        try:
                            win.lift()
                        except Exception:
                            pass
                except Exception:
                    pass

            try:
                if root and root.winfo_exists():
                    root.update_idletasks()
            except Exception:
                pass


