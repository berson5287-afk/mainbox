def ai_model_for_task(task, fallback=None):
    task = str(task or "").strip().lower()
    mapping = {
        "reply": AI_REPLY_MODEL,
        "triage": AI_TRIAGE_MODEL,
        "summary": AI_SUMMARY_MODEL,
        "quote": AI_QUOTE_MODEL,
        "purchase": AI_PURCHASE_MODEL,
        "vision": RFQ_VISION_MODEL,
        "status": AI_STATUS_MODEL,
    }
    return str(mapping.get(task) or fallback or OLLAMA_MODEL).strip()


# ---------------------------------------------------------------------------
# v3.8.35 AI host routing: split AI work between the local Ollama and a more
# capable remote (home) Ollama, with automatic fallback.
#
#   - Light, latency-sensitive tasks (triage, reply, status) stay local.
#   - Heavy tasks (summary, quote, purchase, vision) go to the remote host
#     when one is configured AND reachable; otherwise they fall back to local.
#
# Enable by pointing MaINbox at the home machine, e.g. (Windows):
#     set MAINBOX_REMOTE_OLLAMA=http://100.x.x.x:11434      (home Tailscale IP)
#     set MAINBOX_REMOTE_MODELS=summary=qwen2.5:32b,quote=qwen2.5:32b,purchase=qwen2.5:32b,vision=llama3.2-vision:11b
# If MAINBOX_REMOTE_OLLAMA is unset, every task runs locally and behavior is
# unchanged. The remote-model override applies ONLY to remote calls, so a
# fallback to local always uses the normal (local) model name.
# ---------------------------------------------------------------------------
_LOCAL_OLLAMA_BASE = os.environ.get("MAINBOX_LOCAL_OLLAMA", "http://localhost:11434").rstrip("/")
_REMOTE_OLLAMA_BASE = (os.environ.get("MAINBOX_REMOTE_OLLAMA", "").strip() or None)
if _REMOTE_OLLAMA_BASE:
    _REMOTE_OLLAMA_BASE = _REMOTE_OLLAMA_BASE.rstrip("/")

# Tasks routed to the remote host when one is configured (comma-separated env
# override). Move a task in or out of this set to change where it runs.
REMOTE_OLLAMA_TASKS = {
    t.strip().lower()
    for t in os.environ.get("MAINBOX_REMOTE_TASKS", "summary,quote,purchase,vision").split(",")
    if t.strip()
}

# Snapshot of the env-configured remote task set so Settings can toggle triage routing
# (remote_ai_triage_model) without clobbering an explicit MAINBOX_REMOTE_TASKS opt-in.
_ENV_REMOTE_TASKS = frozenset(REMOTE_OLLAMA_TASKS)

# Optional per-task model override used ONLY on the remote host. Format:
# "task=model,task=model". Tasks not listed keep their normal model name, so
# local fallback never asks the local box for a model it does not have.
REMOTE_MODEL_FOR_TASK = {}
for _pair in os.environ.get("MAINBOX_REMOTE_MODELS", "").split(","):
    if "=" in _pair:
        _k, _v = _pair.split("=", 1)
        if _k.strip() and _v.strip():
            REMOTE_MODEL_FOR_TASK[_k.strip().lower()] = _v.strip()

# Model the host uses for a LIGHT task that spills over from this PC when this PC is busy
# (env override; normally set in Settings). Empty/None disables light spill.
REMOTE_LIGHT_MODEL = (os.environ.get("MAINBOX_REMOTE_LIGHT_MODEL", "").strip() or None)

# Light tasks allowed to borrow a free host slot when this PC is saturated.
LIGHT_SPILL_TASKS = {"triage", "reply"}

# Per-host concurrency caps. Local stays high so existing behavior is unchanged;
# the remote cap protects a single home GPU from being overrun, which is what
# lets small local jobs and big remote jobs run in parallel.
_local_ai_sem = threading.BoundedSemaphore(max(1, int(os.environ.get("MAINBOX_LOCAL_AI_CONCURRENCY", "8"))))
_remote_ai_sem = threading.BoundedSemaphore(max(1, int(os.environ.get("MAINBOX_REMOTE_AI_CONCURRENCY", "1"))))

# Remote health is tracked by a lightweight background probe so routing
# decisions are instant and a sleeping/offline home PC does not stall calls.
REMOTE_PROBE_INTERVAL = max(5, int(os.environ.get("MAINBOX_REMOTE_PROBE_SECONDS", "15")))
_remote_available = True
_remote_state_lock = threading.Lock()
_remote_probe_started = False
_remote_probe_lock = threading.Lock()
_remote_probe_stop = threading.Event()


class _BufferedOllamaResponse:
    """Minimal stand-in for an http.client.HTTPResponse: callers use it inside
    a `with ... as response:` block and read the body with response.read()."""

    def __init__(self, body, status=200, host=""):
        self._body = body
        self.status = status
        self.host = host

    def read(self, *args, **kwargs):
        return self._body

    def getcode(self):
        return self.status

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        return False


def _remote_is_available():
    with _remote_state_lock:
        return _remote_available


def _set_remote_available(value):
    global _remote_available
    with _remote_state_lock:
        _remote_available = bool(value)


def _ping_remote_ollama():
    if not _REMOTE_OLLAMA_BASE:
        return False
    try:
        req = urllib.request.Request(_REMOTE_OLLAMA_BASE + "/api/tags", method="GET")
        with urllib.request.urlopen(req, timeout=3) as resp:
            resp.read()
            ok = getattr(resp, "status", 200) == 200
    except Exception:
        ok = False
    _set_remote_available(ok)
    return ok


def _remote_probe_loop():
    while True:
        _ping_remote_ollama()
        if _remote_probe_stop.wait(REMOTE_PROBE_INTERVAL):
            return


def _ensure_remote_probe():
    global _remote_probe_started
    if _remote_probe_started or not _REMOTE_OLLAMA_BASE:
        return
    with _remote_probe_lock:
        if _remote_probe_started:
            return
        threading.Thread(target=_remote_probe_loop, name="OllamaRemoteProbe", daemon=True).start()
        _remote_probe_started = True


def ai_host_for_task(task):
    """Base URL of the Ollama host that should serve this task right now.
    Mirrors ai_model_for_task, but picks the machine instead of the model."""
    if (_REMOTE_OLLAMA_BASE
            and str(task or "").strip().lower() in REMOTE_OLLAMA_TASKS
            and _remote_is_available()):
        return _REMOTE_OLLAMA_BASE
    return _LOCAL_OLLAMA_BASE


def _set_payload_model(data, model):
    """Return the request body with its model field replaced (no-op if model is falsy)."""
    if not model:
        return data
    try:
        payload = json.loads(data.decode("utf-8"))
        payload["model"] = model
        return json.dumps(payload).encode("utf-8")
    except Exception:
        return data


def _apply_remote_model(data, task):
    """Swap in the configured host model for this task, if any."""
    return _set_payload_model(data, REMOTE_MODEL_FOR_TASK.get(str(task or "").strip().lower()))


def _post_ollama_generate(base, data, timeout):
    req = urllib.request.Request(
        base.rstrip("/") + "/api/generate",
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        body = resp.read()
        status = getattr(resp, "status", 200)
    return _BufferedOllamaResponse(body, status, base)


def ollama_open(data, task=None, timeout=OLLAMA_TIMEOUT_SECONDS):
    """Drop-in replacement for the urllib.request.urlopen(req, ...) pattern used by
    MaINbox's Ollama /api/generate calls.

    - Heavy tasks (summary, quote, purchase, vision) prefer the host, falling back to
      local if the host fails or is offline.
    - Light tasks (triage, reply) run on this PC; if this PC is busy they borrow a free
      host slot (using the host light model) to keep things moving, and only wait for a
      local slot when neither this PC nor the host has one free.
    Returns a response-like object that supports `with ... as r: r.read()`."""
    _ensure_remote_probe()
    t = str(task or "").strip().lower()

    # Heavy / vision: host first, automatic local fallback.
    if ai_host_for_task(task) == _REMOTE_OLLAMA_BASE and _REMOTE_OLLAMA_BASE:
        try:
            with _remote_ai_sem:
                return _post_ollama_generate(_REMOTE_OLLAMA_BASE, _apply_remote_model(data, task), timeout)
        except Exception:
            _set_remote_available(False)  # trip the breaker, then fall through to local
        with _local_ai_sem:
            return _post_ollama_generate(_LOCAL_OLLAMA_BASE, data, timeout)

    # Light tasks: prefer this PC; spill to a free host slot when this PC is saturated.
    if (t in LIGHT_SPILL_TASKS and _REMOTE_OLLAMA_BASE and REMOTE_LIGHT_MODEL
            and _remote_is_available()):
        if _local_ai_sem.acquire(blocking=False):
            try:
                return _post_ollama_generate(_LOCAL_OLLAMA_BASE, data, timeout)
            finally:
                _local_ai_sem.release()
        if _remote_ai_sem.acquire(blocking=False):   # this PC busy -> borrow host if a slot is free
            try:
                return _post_ollama_generate(_REMOTE_OLLAMA_BASE, _set_payload_model(data, REMOTE_LIGHT_MODEL), timeout)
            except Exception:
                _set_remote_available(False)
            finally:
                _remote_ai_sem.release()
        # neither free -> wait for a local slot
        with _local_ai_sem:
            return _post_ollama_generate(_LOCAL_OLLAMA_BASE, data, timeout)

    # Default local path (light tasks with no host spill configured, or any other task).
    with _local_ai_sem:
        return _post_ollama_generate(_LOCAL_OLLAMA_BASE, data, timeout)


def ollama_router_shutdown():
    """Optional: stop the background remote-health probe (e.g., on app exit)."""
    _remote_probe_stop.set()


def list_ollama_models(base_url, timeout=4):
    """Return a sorted list of installed model names from an Ollama host's /api/tags.
    Returns [] if the host is unreachable. Used to populate the Settings dropdowns."""
    base = str(base_url or "").strip().rstrip("/")
    if not base:
        return []
    try:
        req = urllib.request.Request(base + "/api/tags", method="GET")
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="replace"))
        names = [str(m.get("name", "")).strip() for m in data.get("models", []) if m.get("name")]
        return sorted(n for n in names if n)
    except Exception:
        return []



