            tk.Label(controls, text=label, bg=_BG2, fg=_FG).grid(row=row, column=0, sticky="w", pady=4)
            tk.Spinbox(controls, from_=low, to=high, increment=step, textvariable=var, width=8, format="%.2f").grid(row=row, column=1, sticky="w", pady=4)

        add_float_row(0, "Follow-up learning threshold:", followup_conf_var, 0.50, 0.95)
        add_float_row(1, "Auto-group confidence threshold:", triage_conf_var, 0.40, 0.95)
        add_float_row(2, "Minimum business relevance for auto-followup:", relevance_var, 0.40, 0.95)
        add_float_row(3, "Maximum spam likelihood allowed for auto-followup:", spam_var, 0.05, 0.80)
        add_float_row(4, "AI rescan delay hours:", rescan_hours_var, 0.25, 72.0, 0.25)
        tk.Label(controls, text="Emails AI may scan per run:", bg=_BG2, fg=_FG).grid(row=5, column=0, sticky="w", pady=4)
        tk.Spinbox(controls, from_=1, to=250, increment=1, textvariable=scan_limit_var, width=8).grid(row=5, column=1, sticky="w", pady=4)
        tk.Checkbutton(
            controls,
            text="Require confirmation before applying newly learned behavior",
            variable=confirm_var,
            bg=_BG2,
            fg=_FG,
            selectcolor=_BG3,
            activebackground=_BG2,
        ).grid(row=6, column=0, columnspan=3, sticky="w", pady=(8, 4))

        def apply_preset(*args):
            profile = profile_var.get()
            if profile == "conservative":
                followup_conf_var.set(0.86)
                triage_conf_var.set(0.78)
                relevance_var.set(0.78)
                spam_var.set(0.25)
                rescan_hours_var.set(18.0)
                scan_limit_var.set(12)
                preset_hint.config(text="Conservative = slower learning, fewer mistakes, more manual confirmation.")
            elif profile == "balanced":
                followup_conf_var.set(0.78)
                triage_conf_var.set(0.68)
                relevance_var.set(0.72)
                spam_var.set(0.35)
                rescan_hours_var.set(12.0)
                scan_limit_var.set(20)
                preset_hint.config(text="Balanced = current recommended behavior for daily business use.")
            elif profile == "fast":
                followup_conf_var.set(0.66)
                triage_conf_var.set(0.58)
                relevance_var.set(0.64)
                spam_var.set(0.45)
                rescan_hours_var.set(4.0)
                scan_limit_var.set(35)
                preset_hint.config(text="Fast = learns quicker and scans more, but may need more correction if it over-learns.")
            else:
                preset_hint.config(text="Custom = use your own thresholds below.")

        profile_var.trace_add("write", apply_preset)
        apply_preset()

        btns = tk.Frame(win, bg=_BG)
        btns.pack(fill="x", padx=14, pady=14)

        def save_learning_settings():
            try:
                current = load_mainbox_settings()
                current.update({
                    "ai_learning_profile": profile_var.get(),
                    "ai_learning_confirm_before_apply": bool(confirm_var.get()),
                    "followup_learning_confidence": float(followup_conf_var.get()),
                    "triage_group_min_confidence": float(triage_conf_var.get()),
                    "min_business_relevance_for_followup": float(relevance_var.get()),
                    "max_spam_likelihood_for_followup": float(spam_var.get()),
                    "ai_engine_min_rescan_hours": float(rescan_hours_var.get()),
                    "ai_engine_max_scan_per_run": int(scan_limit_var.get()),
                })
                save_json(MAINBOX_SETTINGS_FILE, current)
                self.settings = load_mainbox_settings()
                apply_mainbox_settings(self.settings)
                messagebox.showinfo("AI Learning Settings", "AI learning settings saved.")
                win.destroy()
            except Exception as exc:
                messagebox.showerror("AI Learning Settings", f"Could not save AI learning settings.\n\n{exc}")

        tk.Button(btns, text="Save AI Learning", command=save_learning_settings, width=18).pack(side="right", padx=5)
        tk.Button(btns, text="Cancel", command=win.destroy, width=14).pack(side="right", padx=5)


    def open_update_window(self):
        win = tk.Toplevel(self.root)
        win.title("Update Options")
        remember_window_geometry(win, "Update Options", "560x780")
        win.resizable(True, True)
        win.transient(self.root)
        apply_theme(win)

        tk.Label(win, text="Update Options", font=("Segoe UI", 16, "bold")).pack(pady=12)
        tk.Label(win, text="Enter a date to update emails received on or after that date.", font=("Segoe UI", 10)).pack(pady=4)
        date_frame = tk.Frame(win)
        date_frame.pack(pady=10)
        tk.Label(date_frame, text="Since date:").pack(side="left", padx=5)
        date_var = tk.StringVar(value=datetime.now().strftime("%m/%d/%Y"))
        tk.Entry(date_frame, textvariable=date_var, width=14).pack(side="left", padx=5)
        tk.Label(date_frame, text="MM/DD/YYYY").pack(side="left", padx=5)

        def run_date_update():
            try:
                since_dt = datetime.strptime(date_var.get().strip(), "%m/%d/%Y")
            except Exception:
                messagebox.showerror("Invalid Date", "Please enter the date as MM/DD/YYYY.")
                return
            win.destroy()
            self.update_since_date(since_dt)

        def run_full_update():
            answer = messagebox.askyesno("Full Update", "Full Update may take a long time because it scans many emails.\n\nAre you sure you want to continue?")
            if answer:
                win.destroy()
                self.full_update()

        def run_restore_from_json():
            answer = messagebox.askyesno(
                "Restore from JSON",
                "This will force the SQLite database mirror to match your current JSON files.\n\nUse this if JSON files were restored or edited outside MaINbox. Continue?"
            )
            if not answer:
                return
            result = restore_db_from_json_files()
            self.reload_local_state_from_disk()
            messagebox.showinfo(
                "Restore from JSON",
                f"Restored: {len(result.get('restored', []))}\nSkipped missing JSON: {len(result.get('skipped', []))}\nErrors: {len(result.get('errors', []))}"
            )

        def run_backup_db_to_json():
            result = backup_db_to_json_files()
            messagebox.showinfo(
                "Backup Database to JSON",
                f"Backup folder:\n{result.get('backup_folder')}\n\nExported: {len(result.get('exported', []))}\nSkipped: {len(result.get('skipped', []))}\nErrors: {len(result.get('errors', []))}"
            )

        def run_verify_sync():
            result = verify_sync_health()
            lines = [
                f"OK: {result.get('ok', 0)}",
                f"Warnings: {result.get('warnings', 0)}",
                f"Errors: {result.get('errors', 0)}",
                "",
            ]
            for item in result.get("items", [])[:16]:
                lines.append(f"{item.get('file')}: {item.get('status')}")
            messagebox.showinfo("Sync Health", "\n".join(lines))

        cloud_cfg = load_cloud_bridge_config()
        bridge_path_var = tk.StringVar(value=str(cloud_cfg.get("bridge_script_path") or ""))
        # v3.8.33: optional device id for restoring ANOTHER computer's backup (cross-device).
        restore_source_var = tk.StringVar(value=str(cloud_cfg.get("restore_source_device_id") or ""))

        def save_bridge_path(show_message=True):
            path = bridge_path_var.get().strip().strip('"')
            cfg = save_cloud_bridge_config_updates(
                bridge_script_path=path,
                bridge_python_executable=sys.executable or "python",
                auto_run_bridge_on_request=True,
            )
            if show_message:
                if cfg is not None:
                    messagebox.showinfo("MaINbox Cloud Bridge", "Cloud bridge file path saved.")
                else:
                    messagebox.showerror("MaINbox Cloud Bridge", "Could not save cloud bridge file path.")
            return cfg is not None

        def save_restore_source_device(show_message=True):
            # v3.8.33: persist the cross-device restore source id. Blank = restore this
            # computer's own backup; set to another computer's device_id to restore its backup.
            val = restore_source_var.get().strip().strip('"')
            cfg = save_cloud_bridge_config_updates(restore_source_device_id=val)
            if show_message:
                if cfg is None:
                    messagebox.showerror("MaINbox Cloud Bridge", "Could not save restore source device ID.")
                elif val:
                    messagebox.showinfo(
                        "MaINbox Cloud Bridge",
                        f"Restore source device ID saved:\n{val}\n\n"
                        "Restore Latest Cloud Backup will now pull the backup that BELONGS TO the device ID\n"
                        "you entered above (i.e. another computer's backup), not this computer's own.\n"
                        "Clear the field to restore this computer's own backup again.",
                    )
                else:
                    messagebox.showinfo(
                        "MaINbox Cloud Bridge",
                        "Restore source device ID cleared. Restore Latest Cloud Backup will use this computer's own backup.",
                    )
            return cfg is not None

        def browse_bridge_file():
            path = filedialog.askopenfilename(
                parent=win,
                title="Select mainbox_cloud_bridge_v4_3.py",
                filetypes=[("Python files", "*.py;*.pyw"), ("All files", "*.*")],
            )
            if path:
                bridge_path_var.set(path)
                save_bridge_path(show_message=False)

        def show_cloud_bridge_status():
            messagebox.showinfo("MaINbox Cloud Bridge Status", format_cloud_bridge_status_text(read_cloud_bridge_status()))

        def run_cloud_bridge_backup_request():
            save_bridge_path(show_message=False)
            request = request_cloud_bridge_backup("manual_from_mainbox_update_options")
            if not request:
                messagebox.showerror("MaINbox Cloud Bridge", "Could not write the cloud backup request file.")
                return

            launched, launch_message = launch_cloud_bridge_once()
            details = [
                "Cloud backup request saved.",
                "",
                f"Config file:\n{MAINBOX_CLOUD_CONFIG_FILE}",
                "",
                launch_message,
            ]
            if not launched:
                details.extend([
                    "",
                    "Use Browse Bridge File to point to mainbox_cloud_bridge_v4_3.py, then click this backup button again.",
                ])
            else:
                details.extend([
                    "",
                    "The bridge is running one backup in the background.",
                    "Click View Cloud Bridge Status in a few seconds to confirm the Supabase upload and latest mirror.",
                ])
            status = read_cloud_bridge_status()
            if status:
                details.extend(["", "Previous status:", format_cloud_bridge_status_text(status)])
            messagebox.showinfo("MaINbox Cloud Bridge", "\n".join(details))

        def run_download_latest_cloud_backup():
            save_bridge_path(show_message=False)
            save_restore_source_device(show_message=False)
            launched, launch_message = launch_cloud_bridge_download_latest()
            details = [
                "Latest cloud backup download requested.",
                "",
                launch_message,
                "",
                f"Restore folder:\n{MAINBOX_CLOUD_RESTORE_DIR}",
                "",
                "This only downloads the latest backup. It does not replace your local MaINbox data.",
            ]
            if not launched:
                details.extend(["", "Use Browse Bridge File to point to mainbox_cloud_bridge_v4_3.py, then try again."])
            else:
                details.extend(["", "Click View Cloud Bridge Status in a few seconds to confirm the download."])
            messagebox.showinfo("MaINbox Cloud Restore", "\n".join(details))

        def run_restore_latest_cloud_backup():
            save_bridge_path(show_message=False)
            save_restore_source_device(show_message=False)
            answer = messagebox.askyesnocancel(
                "Restore Latest Cloud Backup",
                "This will restore the latest MaINbox cloud backup from Supabase onto this computer.\n\n"
                "When you click Yes, MaINbox will start the restore bridge and then close itself.\n"
                "The bridge will wait for MaINbox to fully close before replacing the database.\n"
                "A local safety backup will be made before restoring.\n\n"
                "Continue?"
            )
            if answer is not True:
                return
            launched, launch_message = launch_cloud_bridge_restore_latest()
            if not launched:
                messagebox.showerror(
                    "MaINbox Cloud Restore",
                    launch_message + "\n\nUse Browse Bridge File to point to mainbox_cloud_bridge_v4_3.py, then try again."
                )
                return
            try:
                win.destroy()
            except Exception:
                pass
            try:
                self.set_status("Cloud restore started. Closing MaINbox so the database can be restored...")
            except Exception:
                pass
            try:
                self.root.after(100, self.on_close)
            except Exception:
                try:
                    self.root.destroy()
                except Exception:
                    pass

        def run_open_cloud_restore_folder():
            ok, msg = open_cloud_restore_folder()
            if not ok:
                messagebox.showerror("MaINbox Cloud Restore", f"Could not open restore folder:\n{msg}")

        def run_rebuild_cache():
            self.rebuild_indexes_and_cache()
            messagebox.showinfo("Rebuild Indexes/Cache", "Indexes/cache rebuilt and saved.")

        tk.Button(win, text="Update Since Date", command=run_date_update, width=30).pack(pady=6)
        tk.Button(win, text="Full Update", command=run_full_update, width=30).pack(pady=6)

        tk.Label(win, text="Maintenance", font=("Segoe UI", 11, "bold")).pack(pady=(14, 4))
        tk.Button(win, text="Restore from JSON to Database", command=run_restore_from_json, width=30).pack(pady=4)
        tk.Button(win, text="Backup Database to JSON", command=run_backup_db_to_json, width=30).pack(pady=4)
        tk.Button(win, text="Verify Sync Health", command=run_verify_sync, width=30).pack(pady=4)

        bridge_frame = tk.LabelFrame(win, text="Cloud Bridge", padx=8, pady=8)
        bridge_frame.pack(fill="x", padx=18, pady=(8, 4))
        tk.Label(bridge_frame, text="Bridge file:").pack(anchor="w")
        path_row = tk.Frame(bridge_frame)
        path_row.pack(fill="x", pady=(2, 4))
        tk.Entry(path_row, textvariable=bridge_path_var).pack(side="left", fill="x", expand=True, padx=(0, 6))
