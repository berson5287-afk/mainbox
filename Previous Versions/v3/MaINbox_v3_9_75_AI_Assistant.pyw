        def get_selected_source_lines_for_add():
            """Return highlighted source/body text lines for Add Row teaching.

            When the user highlights a missing line in the left Source Text / Scan
            Output text and clicks Add Row, MaINbox should insert that line at the
            current grid position instead of only appending a blank row.
            """
            candidates = []
            for widget in [source_text]:
                try:
                    if widget.tag_ranges(tk.SEL):
                        raw = widget.get(tk.SEL_FIRST, tk.SEL_LAST)
                        candidates.extend([ln.strip() for ln in str(raw or "").splitlines() if ln.strip()])
                        break
                except Exception:
                    pass
            cleaned = []
            for line in candidates:
                line = re.sub(r"^[\s>*•\-]+", "", str(line or "")).strip()
                line = re.sub(r"^\(?\d+\)?[\).]\s+", "", line).strip()
                if line:
                    cleaned.append(line)
            return cleaned

        def parse_manual_source_material_line(line):
            """Best-effort parser for a user-highlighted missing RFQ line."""
            raw = re.sub(r"\s+", " ", str(line or "").strip())
            raw = raw.strip(" -:;|\t")
            qty = ""
            unit = ""
            desc = raw
            if "|" in raw:
                parts = [p.strip() for p in raw.split("|") if p.strip()]
                if parts:
                    first = parts[0]
                    rest = " | ".join(parts[1:]).strip()
                    m = re.match(r"^(\d[\d,]*(?:\.\d+)?)\s*([A-Za-z]{1,12})?$", first, flags=re.I)
                    if m and rest:
                        qty = m.group(1).replace(",", "")
                        unit = (m.group(2) or "").strip().lower()
                        desc = rest
                    else:
                        qty, unit, desc2 = split_qty_unit_description(" ".join(parts))
                        desc = desc2 or rest or raw
            else:
                qty, unit, desc = split_qty_unit_description(raw)
            unit_map = {"boxes": "box", "bags": "bag", "pcs": "pc", "pieces": "pc", "each": "ea"}
            unit = unit_map.get(str(unit or "").lower(), str(unit or "").lower())
            desc = str(desc or raw).strip(" -:;|")
            part = ""
            if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/#\-]{1,30}", desc or ""):
                part = desc.upper()
            return {
                "selected": True,
                "qty": qty or "1",
                "unit": unit or "ea",
                "description": desc,
                "part_number": part,
                "manufacturer": "",
                "notes": "manual from highlighted source",
                "source": "user-highlighted-source",
            }

        def add_material():
            source_lines = get_selected_source_lines_for_add()
            selected_indexes = sorted([int(i) for i in mat_tree.selection() if str(i).isdigit()])
            insert_at = (selected_indexes[-1] + 1) if selected_indexes else len(mat_items)
            prior_text = ""
            if insert_at > 0 and insert_at - 1 < len(mat_items):
                try:
                    prior_text = material_display_text(mat_items[insert_at - 1])
                except Exception:
                    prior_text = ""

            if source_lines:
                new_rows = [parse_manual_source_material_line(line) for line in source_lines]
            else:
                new_rows = [{"selected": True, "qty": "1", "unit": "ea", "description": "", "part_number": "", "notes": "manual", "source": "manual"}]

            inserted_ids = []
            for offset, row in enumerate(new_rows):
                idx = min(max(insert_at + offset, 0), len(mat_items))
                source_line = source_lines[offset] if offset < len(source_lines) else "manual row added"
                if source_lines and not row.get("source_text"):
                    row["source_text"] = source_line
                mat_items.insert(idx, row)
                inserted_ids.append(str(idx))
                before_hint = f"inserted after: {prior_text}" if prior_text else "manual insertion"
                after_hint = source_line if source_line else material_display_text(row) or "manual row added"
                record_rfq_extraction_correction(idx, "row", before_hint, after_hint, action="add_from_source" if source_lines else "add")
                prior_text = material_display_text(row)

            redraw_materials(inserted_ids)
            save_current_rfq_cache()
            if inserted_ids:
                mat_tree.selection_set(inserted_ids[0])
                mat_tree.focus(inserted_ids[0])
                mat_tree.see(inserted_ids[0])
                _do_highlight_selected_material_source()
                begin_edit_cell(inserted_ids[0], "desc" if source_lines else "desc")

        def remove_material():
            indexes = sorted([int(i) for i in mat_tree.selection() if str(i).isdigit()], reverse=True)
            if not indexes:
                return
            if len(indexes) > 1 and not messagebox.askyesno("Delete Rows", f"Delete {len(indexes)} selected material row(s)?"):
                return
            for idx in indexes:
                if 0 <= idx < len(mat_items):
                    try:
                        record_rfq_extraction_correction(idx, "row", material_display_text(mat_items[idx]), "deleted", action="delete")
                    except Exception:
                        pass
                    mat_items.pop(idx)
            redraw_materials()
            save_current_rfq_cache()

        def move_requested_back():
            indexes = sorted([int(i) for i in requested_tree.selection() if str(i).isdigit()], reverse=True)
            if not indexes:
                messagebox.showinfo("Move Requested Back", "Select one or more requested items first.")
                return
            for idx in indexes:
                if 0 <= idx < len(requested_records):
                    rec = requested_records.pop(idx)
                    m = dict(rec.get("material", {}))
                    m["selected"] = True
                    m["notes"] = (m.get("notes", "") + " moved back from requested").strip()
                    mat_items.append(m)
            redraw_materials(); redraw_requested()
            save_current_rfq_cache()

        def clear_requested_items():
            if not requested_records:
                return
            if not messagebox.askyesno("Clear Requested Items", "Clear all requested-item tracking rows in this window? This does not delete Outlook emails or sent RFQs."):
                return
            requested_records.clear()
            redraw_requested()
            save_current_rfq_cache()

        def add_vendor_from_fields():
            email = extract_email_address(new_vendor_email.get())
            name = new_vendor_name.get().strip() or email
            notes = new_vendor_notes.get().strip() or "manual"
            if not email or "@" not in email:
                messagebox.showwarning("Vendor Email Needed", "Enter a valid vendor email address.")
                return
            vend_items.append({"selected": True, "name": name, "email": email, "reason": notes})
            new_vendor_name.set(""); new_vendor_email.set(""); new_vendor_notes.set("")
            redraw_vendors([str(len(vend_items) - 1)])
            save_current_rfq_cache()

        def collect_stored_vendors():
            """Return searchable known vendors from vendor history and procurement memory."""
            vendors = {}
            try:
                for email, rec in ((self.vendor_history or {}).get("vendors", {}) or {}).items():
                    if isinstance(rec, dict):
                        e = extract_email_address(rec.get("email") or email)
                        if e and "@" in e and not is_blocked_internal_vendor(e, rec.get("name", "")):
                            vendors[e] = {
                                "name": str(rec.get("name") or e).strip() or e,
                                "email": e,
                                "source": "vendor history",
                                "last_used": str(rec.get("last_used_at") or rec.get("last_requested_at") or rec.get("updated_at") or ""),
                                "request_count": int(rec.get("request_count", 0) or 0),
                                "award_count": int(rec.get("award_count", 0) or 0),
                            }
            except Exception:
                pass
            try:
                for email, rec in ((self.procurement_memory or {}).get("vendors", {}) or {}).items():
                    if isinstance(rec, dict):
                        e = extract_email_address(rec.get("email") or email)
                        if e and "@" in e and not is_blocked_internal_vendor(e, rec.get("name", "")):
                            prior = vendors.get(e, {})
                            vendors[e] = {
                                "name": str(rec.get("name") or prior.get("name") or e).strip() or e,
                                "email": e,
                                "source": "procurement memory" if not prior else prior.get("source", "vendor history") + " + procurement memory",
                                "last_used": str(rec.get("last_used_at") or rec.get("last_requested_at") or prior.get("last_used") or ""),
                                "request_count": max(int(prior.get("request_count", 0) or 0), int(rec.get("request_count", 0) or 0)),
                                "award_count": max(int(prior.get("award_count", 0) or 0), int(rec.get("award_count", 0) or 0)),
                            }
            except Exception:
                pass
            return sorted(vendors.values(), key=lambda v: (str(v.get("name", "")).lower(), str(v.get("email", "")).lower()))

        def add_stored_vendor():
            stored = collect_stored_vendors()
            if not stored:
                messagebox.showinfo("Add Stored Vendor", "No stored vendors were found yet. Add or send RFQs to vendors and MaINbox will remember them here.", parent=win)
                return

            pop = tk.Toplevel(win)
            pop.title("Add Stored Vendor")
            remember_window_geometry(pop, "MaINbox Add Stored Vendor", "820x520")
            try:
                pop.transient(win)
            except Exception:
                pass

            top = tk.Frame(pop)
            top.pack(fill="x", padx=10, pady=(10, 6))
            tk.Label(top, text="Search stored vendors:").pack(side="left")
            search_var = tk.StringVar()
            search_entry = tk.Entry(top, textvariable=search_var)
            search_entry.pack(side="left", fill="x", expand=True, padx=(8, 0))

            tree = ttk.Treeview(pop, columns=("name", "email", "source", "history"), show="headings", selectmode="extended", height=16)
            for col, label, width, anchor in [
                ("name", "Vendor / Contact", 210, "w"),
                ("email", "Email", 250, "w"),
                ("source", "Source", 160, "w"),
                ("history", "History", 140, "w"),
            ]:
                tree.heading(col, text=label)
                tree.column(col, width=width, anchor=anchor)
            tree.pack(fill="both", expand=True, padx=10, pady=(0, 8))

            bottom = tk.Frame(pop)
            bottom.pack(fill="x", padx=10, pady=(0, 10))
            status_var = tk.StringVar(value="")
            tk.Label(bottom, textvariable=status_var, anchor="w").pack(side="left", fill="x", expand=True)

            shown = []

            def refresh_stored_list(*_):
                q = str(search_var.get() or "").strip().lower()
                tree.delete(*tree.get_children())
                shown.clear()
                for v in stored:
                    hay = " ".join([
                        str(v.get("name", "")),
                        str(v.get("email", "")),
                        str(v.get("source", "")),
                    ]).lower()
                    if q and q not in hay:
                        continue
                    idx = len(shown)
                    shown.append(v)
                    hist = f"{int(v.get('request_count', 0) or 0)} RFQ / {int(v.get('award_count', 0) or 0)} award"
                    tree.insert("", "end", iid=str(idx), values=(v.get("name", ""), v.get("email", ""), v.get("source", ""), hist))
                status_var.set(f"{len(shown)} vendor(s) shown. Double-click or choose Add Selected.")

            def add_selected_stored():
                selected_ids = [iid for iid in tree.selection() if str(iid).isdigit()]
                if not selected_ids:
                    messagebox.showinfo("Add Stored Vendor", "Select one or more stored vendors first.", parent=pop)
                    return
                existing = {str(v.get("email", "") or "").lower().strip(): i for i, v in enumerate(vend_items)}
                added = 0
                selected_existing = []
                new_selection = []
                for iid in selected_ids:
                    idx = int(iid)
                    if idx < 0 or idx >= len(shown):
                        continue
                    v = shown[idx]
                    email = extract_email_address(v.get("email", ""))
                    if not email or "@" not in email:
                        continue
                    if email in existing:
                        row_idx = existing[email]
                        vend_items[row_idx]["selected"] = True
                        reason = str(vend_items[row_idx].get("reason", "") or "")
                        if "stored vendor" not in reason.lower():
                            vend_items[row_idx]["reason"] = (reason + "; " if reason else "") + "stored vendor"
                        selected_existing.append(str(row_idx))
                    else:
                        vend_items.append({
                            "selected": True,
                            "name": str(v.get("name") or email).strip() or email,
                            "email": email,
                            "reason": "stored vendor: " + str(v.get("source", "") or "history"),
                        })
                        row_idx = len(vend_items) - 1
                        existing[email] = row_idx
                        new_selection.append(str(row_idx))
                        added += 1
                select_rows = new_selection or selected_existing
                redraw_vendors(select_rows)
                if select_rows:
                    try:
                        vendor_tree.selection_set(select_rows)
                        vendor_tree.focus(select_rows[0])
                        vendor_tree.see(select_rows[0])
                    except Exception:
                        pass
                save_current_rfq_cache()
                messagebox.showinfo("Add Stored Vendor", f"Added {added} vendor(s). Existing matches were selected instead of duplicated.", parent=pop)
                pop.destroy()

            tk.Button(bottom, text="Add Selected", command=add_selected_stored).pack(side="right", padx=(6, 0))
            tk.Button(bottom, text="Cancel", command=pop.destroy).pack(side="right", padx=(6, 0))

            search_var.trace_add("write", refresh_stored_list)
            tree.bind("<Double-1>", lambda event: add_selected_stored())
            refresh_stored_list()
            try:
                search_entry.focus_set()
            except Exception:
                pass

        def edit_vendor(idx=None):
            if idx is None:
                sel = vendor_tree.selection()
                if not sel:
                    return
                idx = int(sel[0])
            v = vend_items[idx]
            name = simpledialog.askstring("Edit Vendor", "Vendor / contact name:", initialvalue=v.get("name", ""), parent=win)
            if name is None: return
            email = simpledialog.askstring("Edit Vendor", "Email address:", initialvalue=v.get("email", ""), parent=win)
            if email is None: return
            notes = simpledialog.askstring("Edit Vendor", "Notes / source:", initialvalue=v.get("reason", ""), parent=win)
            if notes is None: notes = v.get("reason", "")
            email = extract_email_address(email)
            if "@" not in email:
                messagebox.showwarning("Invalid Email", "Vendor email must contain @.")
                return
            v.update({"name": name.strip() or email, "email": email, "reason": notes.strip()})
            redraw_vendors([str(idx)])
            save_current_rfq_cache()

        def remove_vendor():
            indexes = sorted([int(i) for i in vendor_tree.selection() if str(i).isdigit()], reverse=True)
            if not indexes:
                return
            if len(indexes) > 1 and not messagebox.askyesno("Remove Vendors", f"Remove {len(indexes)} selected vendor row(s)?"):
                return
            for idx in indexes:
                if 0 <= idx < len(vend_items):
                    vend_items.pop(idx)
            redraw_vendors()
            save_current_rfq_cache()

        def vendor_click(event):
            row = vendor_tree.identify_row(event.y)
            col = vendor_tree.identify_column(event.x)
            if row and col == "#1":
                idx = int(row)
                vend_items[idx]["selected"] = not vend_items[idx].get("selected", True)
                redraw_vendors([row])
                save_current_rfq_cache()
                return "break"
            return None

        def vendor_double(event):
            row = vendor_tree.identify_row(event.y)
            if row:
                edit_vendor(int(row))
                return "break"
            return None

        def auto_route_rfq():
            """Add/select preferred vendors based on material memory and prior awards.

            Manual vendor selections are also treated as routing choices for the
            currently selected items so Auto-Route can be used to teach MaINbox
            which vendor should receive those item(s) before an RFQ is sent.
            """
            mats = selected_materials(False) or mat_items
            if not mats:
                messagebox.showinfo("Auto-RFQ Routing", "Select at least one material item first.", parent=win)
                return

            manual_vendors = selected_vendors()
            learned_manual = 0
            if manual_vendors:
                try:
                    self.record_procurement_request(manual_vendors, mats, group, subject=subject_var.get().strip() or "Auto-Route")
                    learned_manual = len(manual_vendors)
                except Exception:
                    pass
                manual_emails = {str(v.get("email", "")).lower().strip() for v in manual_vendors}
                for v in vend_items:
                    email = str(v.get("email", "")).lower().strip()
                    if email in manual_emails:
                        reason = str(v.get("reason", "") or "")
                        if "manual auto-route" not in reason.lower():
                            v["reason"] = (reason + "; " if reason else "") + "manual auto-route for selected item(s)"
                        v["selected"] = True

            suggestions = self.procurement_suggest_vendors_for_materials(mats, limit=12)
            added = 0
            selected_from_memory = 0
            existing = {str(v.get("email", "")).lower().strip(): v for v in vend_items}
            for sug in suggestions:
                email = str(sug.get("email", "") or "").lower().strip()
                if not email:
                    continue
                if email in existing:
                    if not existing[email].get("selected", True):
                        selected_from_memory += 1
                    existing[email]["selected"] = True
                    reason = str(existing[email].get("reason", "") or "")
                    if "procurement memory" not in reason.lower():
                        existing[email]["reason"] = (reason + "; " if reason else "") + "procurement memory: " + str(sug.get("reason", ""))
                else:
                    vend_items.append({"selected": True, "name": sug.get("name", email), "email": email, "reason": "procurement memory: " + str(sug.get("reason", ""))})
                    added += 1

            redraw_vendors()
            save_current_rfq_cache()

            if manual_vendors or suggestions:
                parts = []
                if learned_manual:
                    parts.append(f"learned {learned_manual} manually selected vendor route(s) for {len(mats)} selected item(s)")
                if added:
                    parts.append(f"added {added} vendor(s) from procurement memory")
                if selected_from_memory:
                    parts.append(f"selected {selected_from_memory} existing vendor(s) from procurement memory")
                if not parts and suggestions:
                    parts.append("confirmed the existing selected vendor route(s)")
                messagebox.showinfo("Auto-RFQ Routing", "Auto-Route complete: " + "; ".join(parts) + ".", parent=win)
            else:
                messagebox.showinfo("Auto-RFQ Routing", "No vendor memory exists for these selected items yet. Manually select/add a vendor, then click Auto-Route to teach MaINbox before sending.", parent=win)

