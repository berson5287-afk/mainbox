        if not self.draft_busy and not self.loading_win:
            self.warm_ai_once()
        self.schedule_ai_keep_warm()


    # =========================
    # AI Engine Clean helpers
    # =========================
    def start_ai_task(self, task_name, worker_func, success_func=None, error_func=None):
        """Run one AI/slow job in a worker thread and marshal completion back to Tkinter."""
        if not AI_ENGINE_ENABLED:
            if error_func:
                error_func(RuntimeError("AI engine is disabled."), "")
            return False
        if self.ai_task_running:
            # Do not repeatedly pop modal "AI Busy" warnings during refresh/update loops.
            # The status/loading UI already shows that the AI engine is working.
            try:
                running_name = self.ai_task_name or "AI task"
                self.ai_status_var.set(f"AI: already working on {running_name}...")
            except Exception:
                pass
            return False

        self.ai_task_running = True
        self.ai_task_name = task_name or "AI task"
        self.ai_cancel_event = threading.Event()
        self.draft_busy = True
        try:
            self.ai_status_var.set(f"AI: {self.ai_task_name}...")
        except Exception:
            pass

        def runner():
            if pythoncom:
                try:
                    pythoncom.CoInitialize()
                except Exception:
                    pass
            try:
                result = worker_func(self.ai_cancel_event)
                self.root.after(0, lambda: finish_ok(result))
            except Exception as exc:
                tb = traceback.format_exc()
                self.root.after(0, lambda exc=exc, tb=tb: finish_error(exc, tb))
            finally:
                if pythoncom:
                    try:
                        pythoncom.CoUninitialize()
                    except Exception:
                        pass

        def finish_ok(result):
            self.ai_task_running = False
            self.ai_task_name = ""
            self.ai_cancel_event = None
            self.draft_busy = False
            try:
                if success_func:
                    success_func(result)
            finally:
                try:
                    if not self.ai_task_running:
                        self.ai_status_var.set("AI: ready")
                except Exception:
                    pass

        def finish_error(exc, tb):
            self.ai_task_running = False
            self.ai_task_name = ""
            self.ai_cancel_event = None
            self.draft_busy = False
            if error_func:
                error_func(exc, tb)
            else:
                try:
                    self.ai_status_var.set("AI: error/fallback")
                    messagebox.showerror("AI Error", f"AI task failed but MaINbox is still usable.\n\n{exc}")
                except Exception:
                    pass

        threading.Thread(target=runner, daemon=True).start()
        return True

    def run_ai_scan_selected(self):
        selected = self.get_selected_emails(show_warning=False)
        if not selected:
            messagebox.showwarning("No Email Selected", "Select one or more emails to AI scan.")
            return
        self.start_ai_triage_for_emails(selected, task_name=f"triaging {len(selected)} selected email(s)", allow_group_prompt=True)

    def _collect_triage_candidates(self, limit=None):
        """Emails that have not been AI-triaged recently, newest first. Capped at `limit`
        when given (the queue passes a large limit so it shows ALL pending emails), else at
        AI_ENGINE_MAX_SCAN_PER_RUN. Shared by the startup count and the triage queue."""
        now = datetime.now()
        _cap = limit if (isinstance(limit, int) and limit > 0) else AI_ENGINE_MAX_SCAN_PER_RUN
        candidates = []
        for email in sorted(self.emails, key=lambda e: e.get("received_timestamp", 0), reverse=True):
            if len(candidates) >= _cap:
                break
            if email.get("urgency") == "Low" or email.get("status") == "Completed":
                continue
            if email.get("ai_triage_skipped"):
                continue  # v3.9.49: user explicitly skipped this email -> never a candidate (queue or drip)
            if email.get("ai_user_locked"):
                continue  # v3.9.46: user set this email's workflow manually; never auto-triage over it
            last = email.get("ai_triaged_at") or ""
            should_scan = bool(email.get("ai_triage_pending", False))
            if not should_scan and last:
                try:
                    should_scan = (now - datetime.fromisoformat(last)).total_seconds() >= AI_ENGINE_MIN_RESCAN_HOURS * 3600
                except Exception:
                    should_scan = True
            if not last or should_scan:
                candidates.append(email)
        return candidates

    def schedule_auto_triage_drip(self):
        """v3.9.45: schedule the next gentle auto-triage tick (no-op if the drip is disabled)."""
        try:
            if getattr(self, "auto_triage_drip_enabled", True) and AI_TRIAGE_ENABLED:
                self.root.after(AI_AUTO_TRIAGE_DRIP_SECONDS * 1000, self._auto_triage_drip_tick)
        except Exception:
            pass

    def _auto_triage_drip_tick(self):
        """v3.9.45: send ONE queued email to the local/host AI whenever the engine is idle.

        This is what actually drains the AI triage queue automatically -- previously nothing
        did, so ticked emails just sat there unless the user clicked Send. It is deliberately
        one-at-a-time (never a sweep), so it cannot recreate the old 100-email batch stall, and
        it reuses the same threaded triage path as the manual Send button (fresh_outlook is
        thread-guarded, so the worker can't corrupt the main COM session). Self-pacing: while a
        triage is already running -- including a manual batch the user just sent -- it waits for
        the next tick. Skipped/Low/Completed emails are never picked, so Skip still wins."""
        try:
            if not (getattr(self, "auto_triage_drip_enabled", True) and AI_TRIAGE_ENABLED):
                return
            # Don't fight a running AI job, an in-progress draft, or a modal window.
            if getattr(self, "ai_task_running", False) or getattr(self, "draft_busy", False) or getattr(self, "loading_win", None):
                return
            # Give the user's just-clicked manual selection priority for a short window.
            yield_until = getattr(self, "_auto_triage_yield_until", None)
            if yield_until:
                try:
                    if datetime.now() < yield_until:
                        return
                except Exception:
                    pass
            candidates = self._collect_triage_candidates(limit=1)
            if candidates:
                self.start_ai_triage_for_emails(
                    candidates, task_name="auto-triaging 1 email", allow_group_prompt=False)
        except Exception:
            pass
        finally:
            self.schedule_auto_triage_drip()

    def run_ai_scan_cached_untriaged(self):
        """v3.9.41: do NOT auto-sweep cached emails into one large background batch.

        The old behavior grabbed up to ai_engine_max_scan_per_run candidates (e.g. 100) and
        triaged them as a single background task. On a slow/uncached mailbox that batch could
        stall on a single slow body-load and leave the AI status stuck at "triaging 100..."
        while silently emptying the AI Triage queue (the emails were pulled into the batch, so
        the queue showed nothing for the user to act on).

        Instead, the startup pass now just reports how many emails are waiting, and leaves them
        in the AI Triage queue where the user sends them to the local AI (in their own
        controlled batches), triages by hand, or skips them. Set MAINBOX_AI_AUTOSCAN=1 to
        restore the old auto-batch behavior if you want it back."""
        if not AI_TRIAGE_ENABLED:
            try:
                self.ai_status_var.set("AI: triage disabled")
            except Exception:
                pass
            return
        # Opt-in: restore the old auto-batch sweep.
        if os.environ.get("MAINBOX_AI_AUTOSCAN", "0") == "1":
            candidates = self._collect_triage_candidates()
            if not candidates:
                try:
                    self.ai_status_var.set("AI: no cached emails need scanning")
                except Exception:
                    pass
                return
            self.start_ai_triage_for_emails(
                candidates,
                task_name=f"triaging {len(candidates)} cached/new email(s)",
                allow_group_prompt=False)
            return
        # Default: report the queue count; let the queue surface the emails for the user.
        try:
            n = len(self._collect_triage_candidates())
        except Exception:
            n = 0
        try:
            if n:
                self.ai_status_var.set(f"AI: {n} email(s) waiting in triage queue")
            else:
                self.ai_status_var.set("AI: ready")
        except Exception:
            pass

    def start_ai_triage_for_emails(self, emails, task_name="triaging emails", allow_group_prompt=False, progress_cb=None):
        emails = [e for e in (emails or []) if e]
        if not emails:
            return False

        def worker(cancel_event):
            results = []
            for index, email in enumerate(emails, start=1):
                if cancel_event.is_set():
                    return {"cancelled": True, "results": results}

                changed = False
                before = {
                    "category": email.get("category"),
                    "urgency": email.get("urgency"),
                    "status": email.get("status"),
                    "group": self.get_group_id_for_email(email.get("entry_id", "")),
                }
                applied = {}

                try:
                    body = self.load_body_if_needed(email)
                except Exception:
                    body = email.get("body", "") or ""

                # The user may mark an item Low/Completed while AI is still working.
                # Re-check durable state before applying AI suggestions so background AI
                # cannot reopen a closed/hidden email.
                if self.saved_workflow_is_closed_for_email(email):
                    self.apply_saved_workflow_to_email(email)
                    email["ai_triage_pending"] = False
                    self.save_record(email)
                    changed = True
                    results.append({"email": email, "before": before, "after": dict(email), "applied": {"skipped": "closed_by_user"}})
                    if progress_cb:
                        try:
                            self.root.after(0, progress_cb, results[-1])
                        except Exception:
                            pass
                    continue

                related, related_lines = self.build_related_subject_context(email)
                # v3 efficiency: pass related into apply_quick_sender_intent so the
                # O(n) subject scan only runs once per email instead of twice.
                quick_result = self.apply_quick_sender_intent(email, body=body, _related=related)
                if isinstance(quick_result, tuple):
                    quick, quick_changed = quick_result
                else:
                    quick, quick_changed = quick_result, False
                if quick_changed:
                    applied["prefilter"] = quick.get("reason", "Pre-AI filter")
                    changed = True

                result = None
                if not quick.get("hard_decision"):
                    try:
                        result = ask_ollama_for_triage(
                            subject=email.get("subject", ""),
                            sender=email.get("sender_email") or email.get("sender", ""),
                            body=body,
                            groups=self.groups_data.get("groups", []),
                            signal_context=quick,
                            related_subjects=related_lines,
                        )
                    except Exception:
                        result = None

                suggested_group = ""
                confidence = 0.0
                reason = quick.get("reason", "")

                if isinstance(result, dict):
                    suggested_category = str(result.get("workflow_category", quick.get("workflow_category", ""))).strip()
                    suggested_urgency = str(result.get("urgency", quick.get("urgency", ""))).strip()
                    suggested_status = str(result.get("status", quick.get("status", ""))).strip()
                    reason = str(result.get("reason", reason)).strip()

                    try:
                        business_relevance = float(result.get("business_relevance", quick.get("business_relevance", 0)) or 0)
                    except Exception:
                        business_relevance = 0
                    try:
                        spam_likelihood = float(result.get("spam_likelihood", quick.get("spam_likelihood", 0)) or 0)
                    except Exception:
                        spam_likelihood = 0
                    if spam_likelihood >= 0.70 or business_relevance <= 0.25:
                        suggested_category = "Junk / Ignore"
                        suggested_urgency = "Low"
                        suggested_status = "Completed"
                    if suggested_status == "Waiting on Customer":
                        sender_intent = f"{result.get('sender_intent','')} {quick.get('sender_intent','')} {reason}".lower()
                        if "po" not in sender_intent and "approval" not in sender_intent and "send" not in sender_intent and "later" not in sender_intent and quick.get("status") != "Waiting on Customer":
                            suggested_status = "Needs Reply"

                    if suggested_category in CATEGORIES and suggested_category != email.get("category"):
                        email["category"] = suggested_category
                        applied["category"] = suggested_category
                        changed = True
                    if suggested_urgency in URGENCY_LEVELS and suggested_urgency != email.get("urgency"):
                        email["urgency"] = suggested_urgency
                        applied["urgency"] = suggested_urgency
                        changed = True
                    if suggested_status in STATUSES and suggested_status != email.get("status"):
                        if email.get("status") != "Completed" or suggested_status == "Completed":
                            email["status"] = suggested_status
                            applied["status"] = suggested_status
                            changed = True

                    email["sender_type"] = str(result.get("sender_type", quick.get("sender_type", "unknown"))).strip() or "unknown"
                    email["sender_intent"] = str(result.get("sender_intent", quick.get("sender_intent", ""))).strip()
                    email["business_relevance"] = business_relevance
                    email["spam_likelihood"] = spam_likelihood
                    email["needs_followup_ai"] = bool(result.get("needs_followup", quick.get("needs_followup", False)))
                    email["followup_reason_ai"] = str(result.get("followup_reason", quick.get("followup_reason", ""))).strip()
                    email["same_subject_related_count"] = len(related)

                    try:
                        confidence = float(result.get("group_confidence", 0) or 0)
                    except Exception:
                        confidence = 0.0
                    thread_group_id = self.find_group_id_for_thread(email, skip_entry_id=email.get("entry_id", ""))
                    if thread_group_id and not self.get_group_id_for_email(email.get("entry_id", "")):
                        thread_group = self.get_group_by_id(thread_group_id)
                        if thread_group:
                            self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = thread_group_id
                            self.mark_group_has_new(thread_group_id)
                            applied["group"] = thread_group.get("name", "")
                            applied["thread_group_rule"] = "conversation_or_subject"
                            changed = True

                    if not self.get_group_id_for_email(email.get("entry_id", "")):
                        pa_group_id = self.auto_assign_pa_template_group(email)
                        pa_group = self.get_group_by_id(pa_group_id)
                        if pa_group:
                            applied["group"] = pa_group.get("name", "")
                            applied["pa_template_rule"] = email.get("pa_template_rule", "")
                            changed = True

                    if not self.get_group_id_for_email(email.get("entry_id", "")):
                        business_group_id = self.auto_assign_business_key_group(email)
                        business_group = self.get_group_by_id(business_group_id)
                        if business_group:
                            applied["group"] = business_group.get("name", "")
                            applied["business_group_rule"] = email.get("business_group_rule", "")
                            changed = True

                    suggested_group = str(result.get("suggested_group_id", "")).strip()
                    group = self.get_group_by_id(suggested_group)
                    already_grouped = bool(self.get_group_id_for_email(email.get("entry_id", "")))
                    if group and not already_grouped and confidence >= AI_TRIAGE_GROUP_MIN_CONFIDENCE:
                        if allow_group_prompt:
                            applied["suggested_group"] = suggested_group
                            applied["suggested_group_name"] = group.get("name", "")
                            applied["suggested_group_confidence"] = confidence
                        else:
                            self.groups_data.setdefault("memberships", {})[email.get("entry_id", "")] = suggested_group
                            self.mark_group_has_new(suggested_group)
                            applied["group"] = group.get("name", "")
                            changed = True

                # AI follow-up decision runs here so import/refresh stays fast and spam-safe.
                try:
                    body_for_scenario = email.get("body", "") or ""
                    combined_for_scenario = f"{email.get('subject','')} {body_for_scenario}"
                    followup_source = result if isinstance(result, dict) else quick
                    scheduled, followup_msg = self.schedule_ai_followup_if_needed(email, triage_result=followup_source, quick_result=quick)
                    if scheduled:
                        applied["ai_followup"] = followup_msg
                        changed = True
                    elif text_mentions_po_or_order(combined_for_scenario) or bool((followup_source or {}).get("needs_followup", quick.get("needs_followup", False))):
                        applied["followup_blocked"] = followup_msg
                except Exception as _followup_exc:
                    applied["followup_error"] = str(_followup_exc)[:180]

                email["ai_triage_pending"] = False
                email["ai_triaged_at"] = datetime.now().isoformat()
                email["ai_triage_reason"] = reason

                # v3.9.42: always persist the triaged flag/timestamp. Otherwise
                # no-change emails can reappear in the waiting count after restart.
                self.save_record(email)

                after = {
                    "category": email.get("category"),
                    "urgency": email.get("urgency"),
                    "status": email.get("status"),
                    "group": self.get_group_id_for_email(email.get("entry_id", "")),
                }
                results.append({
                    "entry_id": email.get("entry_id", ""),
                    "subject": email.get("subject", ""),
                    "sender": email.get("sender", ""),
                    "before": before,
                    "after": after,
                    "applied": applied,
                    "reason": reason,
                    "changed": changed,
                })
                if progress_cb:
                    try:
                        self.root.after(0, progress_cb, results[-1])
                    except Exception:
                        pass

            self.flush_status_data()
            self.save_groups()
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_cached_state()
            return {"cancelled": False, "results": results}

        def success(result):
            results = result.get("results", []) if isinstance(result, dict) else []
            for _row in results:
                if _row.get("changed") or _row.get("applied"):
                    self.record_ai_triage_history(_row)
            changed = [r for r in results if r.get("changed") or r.get("applied")]
            suggestions = [r for r in results if r.get("applied", {}).get("suggested_group")]

            # AI Assistant (experimental): auto-apply confident group suggestions
            # here on the MAIN thread (safe to render). Only the uncertain ones are
            # left in the "needs review" list below. Replaces the old behavior where
            # every suggestion just sat in the preview pane waiting for a manual move.
            assistant = getattr(self, "assistant", None)
            auto_grouped_count = 0
            if assistant and assistant.config.enabled and suggestions:
                leftover = []
                for row in suggestions:
                    ap = row.get("applied", {}) or {}
                    gid = ap.get("suggested_group", "")
                    gname = ap.get("suggested_group_name", "")
                    try:
                        gconf = float(ap.get("suggested_group_confidence", 0) or 0)
                    except Exception:
                        gconf = 0.0
                    eid = row.get("entry_id", "")
                    if not gid or not self.get_group_by_id(gid) or self.get_group_id_for_email(eid):
                        continue
                    rec = assistant.handle(
                        kind="Group", stakes=LOW, confidence=gconf,
                        subject=row.get("subject", ""), sender=row.get("sender", ""),
                        summary=f"Add to group '{gname}'",
                        before={"group": ""}, after={"group": gname},
                        reason=row.get("reason", ""),
                        payload={"entry_id": eid, "group_id": gid},
                        dedup_key=f"group:{eid}",
                    )
                    if rec.get("decision") in (AUTO, REVIEW):
                        auto_grouped_count += 1
                    else:
                        leftover.append(row)
                suggestions = leftover

            # Surface RULE-based / silent groupings (exact thread, business key,
            # learned rule, same-subject, and confident non-prompt auto-groups) in
            # the assistant log as well, so the user can SEE which group each email
            # landed in and re-group it if it's wrong -- previously these never
            # appeared in the log (only the AI-*suggested* ones did). The grouping
            # already happened during the worker pass; this only visualizes it.
            # dedup_key collapses repeats from re-scans onto a single row.
            if assistant and assistant.config.enabled:
                for row in results:
                    ap = row.get("applied", {}) or {}
                    if ap.get("suggested_group"):
                        continue  # already handled by the AI-suggestion path above
                    eid = row.get("entry_id", "")
                    gid = (row.get("after", {}) or {}).get("group", "")
                    if not eid or not gid or not self.get_group_by_id(gid):
                        continue
                    em = self.get_email_by_id(eid)
                    if not em:
                        continue
                    rule = ("thread" if ap.get("thread_group_rule")
                            else "business_key" if ap.get("business_group_rule")
                            else "learned" if ap.get("learned_group_rule")
                            else "auto")
                    self._assistant_log_autogroup(
                        em, gid,
                        reason=(row.get("reason", "") or "Auto-grouped by rule."),
                        rule=rule)

            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.preview_text.delete("1.0", tk.END)
            if result.get("cancelled"):
                self.preview_text.insert(tk.END, f"AI scan cancelled.\nProcessed before cancel: {len(results)}")
                self.ai_status_var.set("AI: scan cancelled")
                return
            self.preview_text.insert(
                tk.END,
                f"AI scan complete.\nScanned: {len(results)} email(s)\nUpdated: {len(changed)} email(s)\n\n"
            )
            for row in changed[:12]:
                applied = row.get("applied", {})
                details = ", ".join([f"{k}: {v}" for k, v in applied.items() if not k.startswith("suggested_group")]) or "metadata updated"
                self.preview_text.insert(tk.END, f"- {row.get('subject','No subject')[:90]}\n  {details}\n")
                if row.get("reason"):
                    self.preview_text.insert(tk.END, f"  Reason: {row.get('reason')[:160]}\n")
            if auto_grouped_count:
                self.preview_text.insert(tk.END, f"\nAssistant auto-grouped {auto_grouped_count} email(s) (see the Assistant log).\n")
            if suggestions:
                self.preview_text.insert(tk.END, "\nGroup suggestions needing review:\n")
                for row in suggestions[:8]:
                    self.preview_text.insert(
                        tk.END,
                        f"- {row.get('subject','No subject')[:80]} → {row.get('applied',{}).get('suggested_group_name','')}\n"
                    )
            self.ai_status_var.set(f"AI: scan complete ({len(changed)} updated)")

        def error(exc, tb):
            self.ai_status_var.set("AI: scan error")
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, f"AI scan failed, but MaINbox is still usable.\n\n{exc}\n\nDetails:\n{tb[-1500:]}")

        return self.start_ai_task(task_name, worker, success, error)


    def is_outlook_disconnect_error(self, exc):
        """Return True when Outlook COM dropped its connection mid-refresh."""
        text = str(exc).lower()
        return (
            "object is not connected to server" in text
            or "rpc server is unavailable" in text
            or "call was rejected by callee" in text
            or "server execution failed" in text
            or "-2147220995" in text
            or "-2147023174" in text
            or "-2147418111" in text
        )

    def reset_outlook_connection(self, reason=""):
        """Drop stale COM objects so the next operation reconnects cleanly."""
        try:
            self.outlook = None
            self.namespace = None
            self.connection_status_var.set("Outlook: reconnecting" + (f" ({reason})" if reason else ""))
        except Exception:
            pass

    def fresh_outlook(self):
        # v3.9.40: COM objects are apartment-bound. fresh_outlook is reachable from worker
        # threads (the background refresh engine and body loads). Writing self.outlook /
        # self.namespace from a worker would hand the Tk main thread a COM object from the
        # worker's apartment, and the main thread's next COM call on it would block forever
        # (a permanent UI freeze). Off the main thread we return a PRIVATE thread-local
        # connection and leave the shared handles untouched; on the main thread, unchanged.
        outlook, namespace = connect_outlook(show_error=False)
        if threading.current_thread() is threading.main_thread():
            if outlook:
                self.outlook = outlook
            if namespace:
                self.namespace = namespace
        return outlook, namespace

    def run_outlook_worker(self, work_fn, on_done=None, on_error=None, label="outlook-worker"):
        """Run an Outlook COM job off the Tk main thread.

        v3.9.42: serialize background Outlook workers. Multiple simultaneous COM
        callers against the same Outlook/shared mailbox profile can make Outlook
        reject calls or hang. Low-priority timed passes are allowed to skip and
        retry later instead of stacking threads.
        """
        def _runner():
            lock = getattr(self, "_outlook_worker_lock", None)
            acquired = False
            if lock is not None:
                try:
                    acquired = lock.acquire(blocking=False)
                except Exception:
                    acquired = True
                if not acquired:
                    failed = RuntimeError(f"{label}: Outlook worker already busy; skipped this background pass")
                    if on_error:
                        try:
                            self.root.after(0, lambda e=failed: on_error(e))
                        except Exception:
                            pass
                    return

            did_com = False
            result = None
            failed = None
            try:
                did_com = outlook_thread_init()
                try:
                    _outlook, namespace = connect_outlook(show_error=False)
                except Exception as exc:
                    namespace = None
                    failed = exc
                if failed is None and not namespace:
                    failed = RuntimeError("no Outlook namespace on worker thread")
                if failed is None:
                    result = work_fn(_outlook, namespace)
            except Exception as exc:
                failed = exc
            finally:
                try:
                    outlook_thread_uninit(did_com)
                except Exception:
                    pass
                if lock is not None and acquired:
                    try:
                        lock.release()
                    except Exception:
                        pass

            if failed is not None:
                if on_error:
                    try:
                        self.root.after(0, lambda e=failed: on_error(e))
                    except Exception:
                        pass
            elif on_done:
                try:
                    self.root.after(0, lambda r=result: on_done(r))
                except Exception:
                    pass
        threading.Thread(target=_runner, name=label, daemon=True).start()

    def _find_sales_inbox_folder_in(self, namespace):
        """v3.9.40: resolve the Sales inbox from a thread-local namespace (worker-safe variant
        of find_sales_inbox_folder; never touches self.namespace)."""
        try:
            folders = namespace.Folders
            for i in range(1, folders.Count + 1):
                root = folders.Item(i)
                if SALES_MAILBOX_NAME.lower() in str(root.Name).lower():
                    try:
                        return root.Folders.Item("Inbox")
                    except Exception:
                        return root
            for i in range(1, folders.Count + 1):
                root = folders.Item(i)
                try:
                    return root.Folders.Item(SALES_MAILBOX_NAME)
                except Exception:
                    pass
        except Exception:
            pass
        return None

    def ensure_outlook_namespace(self):
        """Best-effort Outlook connection used by AutoPilot/manual refresh."""
        if self.namespace:
            return True
        self.connect_outlook_quietly()
        return bool(self.namespace)

    def get_my_inbox_folder_safe(self):
        """Get Inbox folder with one reconnect retry if Outlook COM is stale."""
        try:
            if not self.ensure_outlook_namespace():
                return None
            return self.namespace.GetDefaultFolder(6)
        except Exception as exc:
            if self.is_outlook_disconnect_error(exc):
                self.reset_outlook_connection("stale COM")
                self.fresh_outlook()
                try:
                    if self.namespace:
                        return self.namespace.GetDefaultFolder(6)
                except Exception:
                    return None
            return None

    def find_sales_inbox_folder_safe(self):
        """Find Sales inbox with one reconnect retry if Outlook COM is stale."""
        try:
            if not self.ensure_outlook_namespace():
                return None
            return self.find_sales_inbox_folder()
        except Exception as exc:
            if self.is_outlook_disconnect_error(exc):
                self.reset_outlook_connection("stale COM")
                self.fresh_outlook()
                try:
                    return self.find_sales_inbox_folder() if self.namespace else None
                except Exception:
                    return None
            return None

    def toggle_autopilot(self):
        """Turn lightweight AutoPilot refresh on/off without changing manual Refresh/Update."""
        self.auto_refresh_enabled = not bool(self.auto_refresh_enabled)
        if self.auto_refresh_enabled:
            self.auto_status_var.set(f"AutoPilot: watching every {getattr(self, 'auto_refresh_seconds', AUTO_REFRESH_SECONDS)}s")
            self.schedule_auto_refresh()
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, "AutoPilot is ON. MaINbox will lightly check for new emails and queue AI triage for new business items only.")
        else:
            self.auto_status_var.set("AutoPilot: off")
            self.preview_text.delete("1.0", tk.END)
            self.preview_text.insert(tk.END, "AutoPilot is OFF. Use Refresh or Update manually when needed.")

    def schedule_auto_refresh(self):
        if self.auto_refresh_enabled and AUTOPILOT_ENABLED:
            self.root.after(int(getattr(self, "auto_refresh_seconds", AUTO_REFRESH_SECONDS)) * 1000, self.background_auto_refresh)

    def schedule_followup_check(self):
        if self.followup_check_enabled:
            self.root.after(FOLLOWUP_CHECK_SECONDS * 1000, self.check_due_followups)

    def background_auto_refresh(self):
        """v3.9.60: AutoPilot lightweight delta import, now run on a BACKGROUND worker thread.

        Previously this walked Outlook (My Inbox + Sales + a Sent Items tracker scan)
        synchronously on the Tk main thread, which froze the UI for as long as the mailbox
        walk took on a slow/uncached/shared-mailbox connection. It now mirrors the manual
        Refresh engine (v3.9.40): the heavy Outlook property reads happen on a worker thread
        with its own thread-local COM namespace (run_outlook_worker -> _refresh_collect_inbound),
        and the results are applied on the Tk main thread (_autopilot_apply_inbound: upsert,
        dedup, render, save). The main thread is never blocked, so AutoPilot no longer freezes
        the UI.

        Like the manual background Refresh, the old synchronous per-cycle Sent Items COM scan
        (scan_recent_sent_waiting_trackers) + reconcile is intentionally NOT run here -- that
        scan was a large part of the old freeze, and running it on the worker would both
        re-introduce worker-side self.emails mutation and break the import-then-reconcile
        ordering. Sent/waiting trackers are reconciled as the replies arrive (cached clears in
        the apply step), and a full Sent reconciliation still runs on the heavier on-demand
        Update / full-scan paths.
        """
        if not self.auto_refresh_enabled or not AUTOPILOT_ENABLED:
            return
        # Idle gate: skip (and retry on the next tick) if a draft/loading/AI task is busy, an
        # AutoPilot pass is already in flight, or a manual Refresh is currently running.
        if (self.auto_refresh_running or self.draft_busy or self.loading_win
                or getattr(self, "ai_task_running", False)
                or getattr(self, "_refresh_running", False)):
            try:
                self.auto_status_var.set("AutoPilot: waiting for idle")
            except Exception:
                pass
            self.schedule_auto_refresh()
            return

        self.auto_refresh_running = True
        try:
            self.auto_status_var.set("AutoPilot: checking newest emails...")
        except Exception:
            pass

        # Snapshot existing entry_ids + workflow on the main thread BEFORE the worker starts.
        # The background mailbox walk frees the main thread, so a timer (the auto-triage drip)
        # or an in-flight triage can mutate these rows while AutoPilot rebuilds them. We restore
        # this snapshot in the apply step so AutoPilot can never overwrite a category/urgency/
        # status the user (or a prior triage) already set, and we never AI-triage a row that
        # already existed this cycle (EntryID drift under Cached Exchange Mode can make an
        # already-handled email look new). Keyed by EntryID with a stable subject+sender+
        # timestamp fallback. Stored in AutoPilot-specific attributes so it never interacts
        # with the manual Refresh snapshot (_pre_refresh_wf_*).
        before_ids = set(
            e.get("entry_id", "") for e in self.emails
            if isinstance(e, dict) and e.get("entry_id")
        )
        self._ap_pre_wf_by_eid = {}
        self._ap_pre_wf_by_key = {}
        try:
            for _e in self.emails:
                if not isinstance(_e, dict):
                    continue
                _rec = {
                    "category": _e.get("category"), "urgency": _e.get("urgency"),
                    "status": _e.get("status"), "email_type": _e.get("email_type"),
                    "ai_triaged_at": _e.get("ai_triaged_at"), "ai_triage_pending": _e.get("ai_triage_pending"),
                    "ai_user_locked": _e.get("ai_user_locked"), "ai_triage_skipped": _e.get("ai_triage_skipped"),
                }
                _eid = _e.get("entry_id")
                if _eid:
                    self._ap_pre_wf_by_eid[_eid] = _rec
                try:
                    _subj = normalize_subject_for_match(_e.get("subject", "") or "")
                    _snd = str(_e.get("sender_email", "") or _e.get("sender", "") or "").strip().lower()
                    _ts = int(float(_e.get("received_timestamp", 0) or 0))
                    if _subj and _snd:
                        self._ap_pre_wf_by_key[(_subj, _snd, _ts)] = _rec
                except Exception:
                    pass
        except Exception:
            self._ap_pre_wf_by_eid = {}
            self._ap_pre_wf_by_key = {}

        def work(outlook, namespace):
            # Worker thread: collect recent My Inbox + Sales emails as plain dicts from a
            # thread-local namespace (no self.emails mutation, no Tk -- exactly what the manual
            # Refresh worker does). Also run the conservative, idempotent inbox quote scan so an
            # inbound priced reply flips its requested items to Quoted, off the main thread.
            collected = self._refresh_collect_inbound(namespace)
            try:
                self.scan_recent_inbox_for_quotes()
            except Exception:
                pass
            return collected

        def on_done(collected):
            try:
                self._autopilot_apply_inbound(collected or [], before_ids)
            finally:
                self.auto_refresh_running = False
                self.schedule_auto_refresh()

        def on_error(exc):
            try:
                msg = str(exc) or ""
                if "already busy" in msg or "skipped this background pass" in msg:
                    # Another Outlook worker (e.g. a manual Refresh) holds the serialization
                    # lock. AutoPilot is a low-priority pass, so just wait and retry next tick.
                    try:
                        self.auto_status_var.set("AutoPilot: busy, will retry shortly")
                    except Exception:
                        pass
                elif self.is_outlook_disconnect_error(exc):
                    self.reset_outlook_connection("AutoPilot")
                    try:
                        self.auto_status_var.set("AutoPilot: Outlook reconnecting; will retry")
                        self.connection_status_var.set("Outlook: disconnected")
                    except Exception:
                        pass
                else:
                    try:
                        self.auto_status_var.set("AutoPilot: refresh error")
                        self.connection_status_var.set("Outlook: refresh error")
                    except Exception:
                        pass
            finally:
                self.auto_refresh_running = False
                self.schedule_auto_refresh()

        self.run_outlook_worker(work, on_done=on_done, on_error=on_error, label="autopilot")

    def _autopilot_apply_inbound(self, collected, before_ids):
        """v3.9.60 main-thread side of AutoPilot: apply the worker-collected email dicts
        (upsert, duplicate suppression, new-item handling) and reconcile sent/waiting trackers
        AS THE REPLIES ARRIVE (cached clears -- no Outlook COM), then restore the pre-cycle
        workflow snapshot, render, save, update AutoPilot status, and queue AI triage for the
        genuinely new business emails. Contains no Outlook COM, so it cannot freeze the UI.
        Mirrors _refresh_apply_inbound with AutoPilot-specific status + AI-triage gating."""
        self._begin_commitment_batch()
        try:
            for email in collected:
                try:
                    is_new = self.upsert_email(email)
                    self.suppress_my_inbox_duplicate_when_sales_copy_exists(email)
                    if is_new and email.get("urgency") != "Low":
                        self.handle_new_email_after_import(email, silent=True)
                    # Sent trackers are reconciled as replies arrive: a reply that just landed
                    # clears its matching waiting tracker. Both clears are cached (operate on
                    # self.emails / self.sent_waiting_placeholders), so there is no COM here.
                    self.clear_sent_waiting_placeholder_for_reply(email)
                    self.clear_existing_sent_waiting_tracker_rows_for_reply(email)
                except Exception:
                    continue
        finally:
            try:
                self._flush_commitment_batch()
            except Exception:
                pass
        # v3.9.75: re-group any still-ungrouped RFQ-template reply (see refresh worker note).
        try:
            self.retroactively_group_pa_template_replies()
        except Exception:
            pass
        try:
            self.cleanup_duplicates(reason="pre_render", save=True)
        except Exception:
            pass

        # Restore the pre-cycle workflow snapshot (see background_auto_refresh) so nothing that
        # ran on the freed main thread during the walk can change a workflow the user already set.
        _by_eid = getattr(self, "_ap_pre_wf_by_eid", None) or {}
        _by_key = getattr(self, "_ap_pre_wf_by_key", None) or {}
        try:
            if _by_eid or _by_key:
                for _e in self.emails:
                    if not isinstance(_e, dict):
                        continue
                    _rec = _by_eid.get(_e.get("entry_id"))
                    if _rec is None:
                        try:
                            _subj = normalize_subject_for_match(_e.get("subject", "") or "")
                            _snd = str(_e.get("sender_email", "") or _e.get("sender", "") or "").strip().lower()
                            _ts = int(float(_e.get("received_timestamp", 0) or 0))
                            _rec = _by_key.get((_subj, _snd, _ts))
                        except Exception:
                            _rec = None
                    if not _rec:
                        continue
                    for _f, _v in _rec.items():
                        if _v not in (None, ""):
                            _e[_f] = _v
                    try:
                        _sd = self.status_data.get(_e.get("entry_id")) if isinstance(self.status_data, dict) else None
                        if isinstance(_sd, dict):
                            for _f in ("category", "urgency", "status"):
                                if _rec.get(_f) not in (None, ""):
                                    _sd[_f] = _rec.get(_f)
                    except Exception:
                        pass
        except Exception:
            pass

        new_emails = [
            e for e in self.emails
            if isinstance(e, dict) and e.get("entry_id", "") not in before_ids
        ]
        added_total = len(new_emails)

        try:
            if added_total > 0:
                self.sort_emails_for_display()
                self.render_email_rows()
                self.render_group_rows()
                self.render_followup_preview_queue()
                self.save_cached_state()
                self.last_updated_var.set(f"Last updated: {datetime.now().strftime('%I:%M:%S %p')} \u2014 AutoPilot {added_total} new")
                self.auto_status_var.set(
                    f"AutoPilot: imported {added_total} new; AI queue next" if new_emails
                    else f"AutoPilot: imported {added_total} new"
                )
            else:
                self.last_updated_var.set(f"Last updated: {datetime.now().strftime('%I:%M:%S %p')} \u2014 AutoPilot no new emails")
                self.auto_status_var.set(f"AutoPilot: watching every {getattr(self, 'auto_refresh_seconds', AUTO_REFRESH_SECONDS)}s")
            self.connection_status_var.set("Outlook: connected")
        except Exception:
            pass

        # Queue AI triage only for genuinely new business emails -- never for rows that already
        # existed this cycle (matched against the pre-cycle snapshot key), were user-locked or
        # skipped, or are Completed/Low.
        if AUTOPILOT_AI_SCAN_NEW_IMPORTS and new_emails and not getattr(self, "ai_task_running", False):
            candidates = []
            for email in sorted(new_emails, key=lambda e: e.get("received_timestamp", 0), reverse=True):
                if len(candidates) >= AUTOPILOT_NEW_EMAIL_SCAN_LIMIT:
                    break
                if email.get("status") == "Completed" or email.get("urgency") == "Low":
                    continue
                if email.get("ai_user_locked") or email.get("ai_triage_skipped"):
                    continue
                try:
                    _subj = normalize_subject_for_match(email.get("subject", "") or "")
                    _snd = str(email.get("sender_email", "") or email.get("sender", "") or "").strip().lower()
                    _ts = int(float(email.get("received_timestamp", 0) or 0))
                    if (_subj, _snd, _ts) in _by_key:
                        continue
                except Exception:
                    pass
                candidates.append(email)
            if candidates:
                self.start_ai_triage_for_emails(candidates, task_name=f"AutoPilot triaging {len(candidates)} new email(s)", allow_group_prompt=False)

        # Clear the snapshot now that it has been applied (local _by_eid/_by_key still hold the
        # references used above, so clearing the instance attrs here is safe).
        self._ap_pre_wf_by_eid = {}
        self._ap_pre_wf_by_key = {}

    def load_sales_category_options(self):
        """Return the Outlook Sales categories MaINbox knows about."""
        options = []
        try:
            cache = load_json(CATEGORY_CACHE_FILE, {})
            for cat in cache.get("categories", []) or []:
                cat = str(cat or "").strip()
                if cat and cat not in options:
                    options.append(cat)
        except Exception:
            pass
        if self.selected_sales_category and self.selected_sales_category not in options:
            options.insert(0, self.selected_sales_category)
        return options

    def is_sales_message_uncategorized(self, msg_categories):
        """Sales queue rule: no Outlook category means it still needs a user/category assignment."""
        return not str(msg_categories or "").strip()

    def build_sales_uncategorized_queue_row(self, msg):
        """Build the lightweight row used by the Sales uncategorized queue.

        This intentionally avoids build_email_data() because that routine can touch extra
        Outlook properties and slow/freeze the UI on shared mailboxes over slower connections.
        The full email is still built later after the user applies a category.
        """
        try:
            received = msg.ReceivedTime
            received_naive = received.replace(tzinfo=None)
            entry_id = msg.EntryID
            if not entry_id:
                return None
            if self.status_data.get(entry_id, {}).get("app_deleted"):
                return None
            store_id = ""
            try:
                store_id = msg.Parent.StoreID
            except Exception:
                store_id = ""
            conversation_id = ""
            try:
                conversation_id = msg.ConversationID
            except Exception:
                conversation_id = ""
            subject = msg.Subject or ""
            sender = msg.SenderName or ""
            categories = msg.Categories or ""
            return {
                "entry_id": entry_id,
                "store_id": store_id,
                "conversation_id": conversation_id,
                "source": "Sales",
                "subject": subject,
                "normalized_subject": normalize_subject_for_match(subject),
                "sender": sender,
                "sender_email": "",
                "body": "",
                "body_loaded": False,
                "received": received.strftime("%Y-%m-%d %I:%M %p"),
                "received_timestamp": received.timestamp(),
                "outlook_categories": categories,
                "category": classify_category(subject),
                "urgency": classify_urgency(subject),
                "status": self.status_data.get(entry_id, {}).get("status", "New"),
                "message": None,
                "is_new_import": False,
                "followup_time": self.get_followup_display_for_email(entry_id),
                "sender_type": self.status_data.get(entry_id, {}).get("sender_type", "unknown"),
                "email_type": self.status_data.get(entry_id, {}).get("email_type", ""),
                "sender_intent": self.status_data.get(entry_id, {}).get("sender_intent", ""),
                "business_relevance": self.status_data.get(entry_id, {}).get("business_relevance", ""),
                "spam_likelihood": self.status_data.get(entry_id, {}).get("spam_likelihood", ""),
                "same_subject_related_count": self.status_data.get(entry_id, {}).get("same_subject_related_count", 0),
                "has_attachments": False,
            }
        except Exception:
            return None

    def restrict_items_received_before(self, items, cutoff):
        """Ask Outlook to date-filter first so Python does not walk many newer emails."""
        try:
            cutoff_str = cutoff.strftime("%m/%d/%Y %I:%M %p")
            return items.Restrict(f"[ReceivedTime] <= '{cutoff_str}'")
        except Exception:
            return items

    def scan_sales_uncategorized_queue(self, show_popup=False, silent=False):
        """Find Sales Inbox messages older than the grace period that still have no Outlook category."""
        rows = []
        try:
            folder = self.find_sales_inbox_folder_safe()
            if not folder:
                return []
            cutoff = datetime.now() - timedelta(minutes=SALES_UNCATEGORIZED_AFTER_MINUTES)
            messages = folder.Items
            # Filter by age inside Outlook first. This keeps the scanner from walking through
            # all brand-new Sales emails just to reach the items that are old enough to queue.
            messages = self.restrict_items_received_before(messages, cutoff)
            messages.Sort("[ReceivedTime]", True)

            scanned = 0
            for msg in messages:
                if scanned >= int(getattr(self, "sales_uncategorized_scan_limit", SALES_UNCATEGORIZED_SCAN_LIMIT)):
                    break
                try:
                    # Only count messages that are actually old enough after the Restrict/fallback.
                    received = msg.ReceivedTime
                    received_naive = received.replace(tzinfo=None)
                    if received_naive > cutoff:
                        continue
                    scanned += 1

                    if not self.is_sales_message_uncategorized(getattr(msg, "Categories", "")):
                        continue
                    email = self.build_sales_uncategorized_queue_row(msg)
                    if not email:
                        continue
                    rows.append(email)
                except Exception:
                    continue
        except Exception as exc:
            if not silent:
                try:
                    messagebox.showerror("Sales Uncategorized Queue", f"Could not scan Sales uncategorized emails.\n\n{exc}")
                except Exception:
                    pass
        self.sales_uncategorized_queue = rows
        if show_popup and rows:
            last_popup = getattr(self, "last_sales_uncategorized_popup_at", None)
            should_show = True
            if last_popup:
                try:
                    should_show = (datetime.now() - last_popup) >= timedelta(minutes=5)
                except Exception:
                    should_show = True
            if should_show:
                self.last_sales_uncategorized_popup_at = datetime.now()
                self.open_sales_uncategorized_queue(force_foreground=True)
        return rows

    def check_sales_uncategorized_queue(self):
        """Periodic safety check independent of the main categorized Sales import."""
        try:
            if getattr(self, "sales_uncategorized_queue_enabled", True) and not getattr(self, "auto_refresh_running", False) and not getattr(self, "loading_win", None):
                self.scan_sales_uncategorized_queue(show_popup=True, silent=True)
        finally:
            try:
                self.root.after(int(getattr(self, "sales_uncategorized_refresh_seconds", 60)) * 1000, self.check_sales_uncategorized_queue)
            except Exception:
                pass

    def open_sales_uncategorized_queue(self, force_foreground=True):
        """Popup queue for Sales Inbox emails that have not received an Outlook category after 20 minutes."""
        rows = self.scan_sales_uncategorized_queue(show_popup=False, silent=True)
        if getattr(self, "sales_uncategorized_window", None) and self.sales_uncategorized_window.winfo_exists():
            win = self.sales_uncategorized_window
            try:
                win.deiconify()
                win.lift()
                win.focus_force()
                win._refresh_queue()
            except Exception:
                pass
            return

        win = tk.Toplevel(self.root)
        self.sales_uncategorized_window = win
        win.title("Sales Uncategorized Queue")
        remember_window_geometry(win, "Sales Uncategorized Queue", "1050x520")
        apply_theme(win)
        try:
            win.transient(self.root)
        except Exception:
            pass

        tk.Label(
            win,
            text=f"Sales emails with no Outlook category after {SALES_UNCATEGORIZED_AFTER_MINUTES} minutes",
            font=("Segoe UI", 13, "bold"), fg=_ACCENT, bg=_BG
        ).pack(anchor="w", padx=10, pady=(10, 2))
        info_var = tk.StringVar(value="")
        tk.Label(win, textvariable=info_var, fg=_FG_DIM, bg=_BG).pack(anchor="w", padx=10, pady=(0, 8))

        control = tk.Frame(win, bg=_BG)
        control.pack(fill="x", padx=10, pady=(0, 6))
        tk.Label(control, text="Categorize selected as:", bg=_BG, fg=_FG).pack(side="left")
        cat_var = tk.StringVar(value=self.selected_sales_category)
        cat_combo = ttk.Combobox(control, textvariable=cat_var, values=self.load_sales_category_options(), state="readonly", width=32)
        cat_combo.pack(side="left", padx=6)

        tree = ttk.Treeview(win, columns=("received", "sender", "subject"), show="headings", selectmode="extended")
        tree.heading("received", text="Received")
        tree.heading("sender", text="Sender")
        tree.heading("subject", text="Subject")
        tree.column("received", width=150)
        tree.column("sender", width=220)
        tree.column("subject", width=610)
        tree.pack(fill="both", expand=True, padx=10, pady=6)

        def refresh_queue():
            fresh = self.scan_sales_uncategorized_queue(show_popup=False, silent=True)
            tree.delete(*tree.get_children())
            for email in fresh:
                tree.insert("", "end", iid=email.get("entry_id", ""), values=(email.get("received", ""), email.get("sender", ""), email.get("subject", "")))
            info_var.set(f"{len(fresh)} uncategorized Sales email(s) ready for assignment. These stay out of the main window until categorized.")
            try:
                cat_combo["values"] = self.load_sales_category_options()
            except Exception:
                pass

        def apply_category_to_selected():
            selected = list(tree.selection())
            category = str(cat_var.get() or "").strip()
            if not selected:
                messagebox.showwarning("No Email Selected", "Select one or more Sales emails first.", parent=win)
                return
            if not category:
                messagebox.showwarning("No Category Selected", "Choose a Sales category first.", parent=win)
                return
            changed = 0
            for entry_id in selected:
                email = next((e for e in getattr(self, "sales_uncategorized_queue", []) if e.get("entry_id") == entry_id), None)
                if not email:
                    email = {"entry_id": entry_id}
                msg = self.get_message_object(email)
                if not msg:
                    continue
                try:
                    existing = str(getattr(msg, "Categories", "") or "").strip()
                    parts = [p.strip() for p in existing.split(",") if p.strip()]
                    if category not in parts:
                        parts.append(category)
                    msg.Categories = ", ".join(parts)
                    msg.Save()
                    changed += 1
                    # If this monitor is for that category, import immediately so it appears now.
                    if category.strip().lower() == self.selected_sales_category.strip().lower():
                        imported = self.build_email_data(msg, "Sales")
                        if imported:
                            imported["outlook_categories"] = msg.Categories or ""
                            is_new = self.upsert_email(imported)
                            self.save_record(imported)
                            if is_new and imported.get("urgency") != "Low":
                                self.handle_new_email_after_import(imported, silent=True)
                except Exception:
                    continue
            self.flush_status_data()
            self.sort_emails_for_display()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            self.save_cached_state()
            refresh_queue()
            try:
                self.preview_text.delete("1.0", tk.END)
                self.preview_text.insert(tk.END, f"Categorized {changed} Sales email(s) as '{category}'.")
            except Exception:
                pass

        def open_selected_in_outlook():
            selected = list(tree.selection())
            if not selected:
                return
            email = next((e for e in getattr(self, "sales_uncategorized_queue", []) if e.get("entry_id") == selected[0]), None)
            if not email:
                return
            msg = self.get_message_object(email)
            if msg:
                try:
                    msg.Display()
                except Exception:
                    pass

        tk.Button(control, text="Apply Category", command=apply_category_to_selected).pack(side="left", padx=5)
        tk.Button(control, text="Refresh Queue", command=refresh_queue).pack(side="left", padx=5)
        tk.Button(control, text="Open in Outlook", command=open_selected_in_outlook).pack(side="left", padx=5)
        tk.Button(control, text="Close", command=win.destroy).pack(side="right", padx=5)
        tree.bind("<Double-1>", lambda event: open_selected_in_outlook())
        win._refresh_queue = refresh_queue
        refresh_queue()

        def on_close():
            self.sales_uncategorized_window = None
            win.destroy()
        win.protocol("WM_DELETE_WINDOW", on_close)
        if force_foreground:
            try:
                win.lift()
                win.focus_force()
                win.attributes("-topmost", True)
                win.after(1200, lambda: win.attributes("-topmost", False))
            except Exception:
                pass

    def check_due_followups(self):
        """Check due follow-ups without auto-drafting.

        v41 experiment: due follow-ups now open a review popup. The user chooses
        which drafts to deploy, cancel selected items, or cancel all due items.
        This avoids the old freeze caused by auto-creating Outlook drafts on the
        periodic follow-up timer.
        """
        if not self.followup_check_enabled:
            return
        if self.draft_busy or self.loading_win or getattr(self, "due_followup_popup_open", False):
            self.schedule_followup_check()
            return

        now = datetime.now()
        try:
            self.sweep_reply_needed_reminders()
        except Exception:
            pass
        due_rows = self.get_due_followup_review_rows(now)
        active = self.active_followup_count()

        if due_rows:
            # Do not spam the user every 30 seconds if they close/ignore the popup.
            last_popup = getattr(self, "last_due_followup_popup_at", None)
            should_show = True
            if last_popup:
                try:
                    should_show = (now - last_popup) >= timedelta(minutes=5)
                except Exception:
                    should_show = True
            if should_show:
                self.last_due_followup_popup_at = now
                self.show_due_followups_popup(due_rows)
            self.followup_status_var.set(f"Follow-ups: {len(due_rows)} due | {active} active")
        else:
            self.followup_status_var.set(f"Follow-ups: {active} active")

        self.schedule_followup_check()

    def get_due_followup_review_rows(self, now=None):
        """Return due follow-up rows for the review popup. No Outlook/AI calls here."""
        now = now or datetime.now()
        rows = []
        seen_due_keys = set()
        auto_cancelled = False  # v3.8.31: track in-memory auto-cancels so they get saved
        # v3.9.27 efficiency: this runs on the 30-second follow-up timer. Gate the
        # 4-collection dedupe behind the existing dirty flag; when it does run and
        # changes something, the four files are saved exactly as before.
        if getattr(self, "_followup_dedup_needed", True) and self.dedupe_followup_records():
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_pending_reply_checks()

        for idx, item in enumerate(self.followups):
            if item.get("completed") or item.get("cancelled"):
                continue
            try:
                due_at = datetime.fromisoformat(item.get("due_at", ""))
            except Exception:
                continue
            if due_at > now:
                continue
            email = self.find_email_for_followup_item(item)
            if not email:
                continue
            due_key = ("manual", item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if due_key in seen_due_keys:
                continue
            seen_due_keys.add(due_key)
            rows.append({
                "queue_id": f"followup:{idx}:{item.get('entry_id', '')}",
                "kind": "Scheduled Follow-Up",
                "item": item,
                "email": email,
                "due_at": due_at,
                "due_display": due_at.strftime("%m/%d %I:%M %p"),
                "subject": email.get("subject", item.get("subject", "")),
                "sender": email.get("sender", ""),
                "group": self.get_group_name_for_email(email.get("entry_id", "")),
                "note": item.get("message", "") or item.get("note", "") or "Scheduled follow-up is due.",
            })

        for idx, item in enumerate(self.scenario_reminders):
            if item.get("completed") or item.get("cancelled"):
                continue
            try:
                due_at = datetime.fromisoformat(item.get("due_at", ""))
            except Exception:
                continue
            if due_at > now:
                continue
            email = self.find_email_for_followup_item(item)
            if not email:
                continue
            if self.email_is_completed(email) and not item.get("one_time_after_app_delete"):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Cancelled automatic tracking: email already Completed"
                auto_cancelled = True
                continue
            scenario_type = item.get("type", "scenario")
            due_key = (scenario_type, item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if due_key in seen_due_keys:
                continue
            seen_due_keys.add(due_key)
            if scenario_type == "vendor_no_response":
                kind = "Vendor No-Response"
            elif scenario_type == "customer_po_order_followup":
                kind = "Customer PO Follow-Up"
            elif scenario_type in ["ai_followup_review", "ai_vendor_followup_review", "ai_customer_followup_review"]:
                kind = "AI Follow-Up Review"
            else:
                kind = "Scenario Reminder"
            rows.append({
                "queue_id": f"scenario:{idx}:{item.get('entry_id', '')}",
                "kind": kind,
                "item": item,
                "email": email,
                "due_at": due_at,
                "due_display": due_at.strftime("%m/%d %I:%M %p"),
                "subject": email.get("subject", item.get("subject", "")),
                "sender": email.get("sender", item.get("sender", "")),
                "group": self.get_group_name_for_email(email.get("entry_id", "")),
                "note": item.get("note", ""),
                "scenario_type": scenario_type,
            })

        rows, commitment_cancelled = self._append_commitment_due_rows(rows, seen_due_keys, now)
        # v3.8.31: persist reminders auto-cancelled above because their email is already
        # Completed. These in-memory cancels were previously only written if some later
        # action happened to save, so they could silently reappear after a restart and the
        # reminder would fire again.
        if auto_cancelled or commitment_cancelled:
            try:
                self.save_scenario_reminders()
                self.save_commitment_reminders()
            except Exception:
                pass
        rows.sort(key=lambda r: r.get("due_at") or datetime.max)
        return rows

    def _append_commitment_due_rows(self, rows, seen_due_keys, now):
        """v3.8.10: surface due promised-date commitments in the same review queue.

        v3.8.31: returns (rows, changed) so the caller can persist any commitment
        reminders auto-cancelled here (email already Completed). Previously those
        in-memory cancels could be lost on restart if no later save happened.
        """
        changed = False
        for idx, item in enumerate(getattr(self, "commitment_reminders", [])):
            if item.get("completed") or item.get("cancelled"):
                continue
            try:
                due_at = datetime.fromisoformat(item.get("due_at", ""))
            except Exception:
                continue
            if due_at > now:
                continue
            email = self.find_email_for_followup_item(item)
            if not email:
                continue
            if self.email_is_completed(email):
                item["cancelled"] = True
                item["cancelled_at"] = datetime.now().isoformat()
                item["cancel_reason"] = "Cancelled commitment reminder: email already Completed"
                changed = True
                continue
            scenario_type = item.get("type", "commitment")
            due_key = (scenario_type, item.get("target_date", ""), item.get("entry_id") or item.get("conversation_id") or item.get("group_id") or item.get("subject"))
            if due_key in seen_due_keys:
                continue
            seen_due_keys.add(due_key)
            rows.append({
                "queue_id": f"commitment:{idx}:{item.get('entry_id', '')}",
                "kind": item.get("kind_label", "Promised Date"),
                "item": item,
                "email": email,
                "due_at": due_at,
                "due_display": due_at.strftime("%m/%d %I:%M %p"),
                "subject": email.get("subject", item.get("subject", "")),
                "sender": email.get("sender", item.get("sender", "")),
                "group": self.get_group_name_for_email(email.get("entry_id", "")),
                "note": item.get("note", ""),
                "scenario_type": scenario_type,
            })
        return rows, changed

    def deploy_due_followup_row(self, row):
        """Create the chosen draft and mark that due item completed.

        v3.8.30: restored. The def line for this method had been lost in an
        earlier edit, leaving the body as dead code after _append_commitment_due_rows'
        `return rows`. deploy_selected() in the due-follow-up review window calls
        self.deploy_due_followup_row(row), so without this method clicking
        "Deploy Selected" raised AttributeError.
        """
        item = row.get("item")
        email = row.get("email")
        if not item or not email:
            return False

        kind = row.get("kind", "")
        scenario_type = row.get("scenario_type", "")
        target_status = None
        followup_source = "scheduled_followup"

        if scenario_type == "vendor_no_response":
            message = get_vendor_no_response_message()
            target_status = "Waiting on Vendor"
            followup_source = "vendor_no_response"
        elif scenario_type == "customer_po_order_followup":
            message = get_po_followup_message()
            target_status = "Waiting on Customer"
            followup_source = "customer_po_order_followup"
        elif scenario_type in ["ai_followup_review", "ai_vendor_followup_review", "ai_customer_followup_review"]:
            message = self.generate_reply_text(email, prefer_ai=True)
            followup_source = scenario_type
            if scenario_type == "ai_vendor_followup_review":
                target_status = "Waiting on Vendor"
            elif scenario_type == "ai_customer_followup_review":
                target_status = "Waiting on Customer"
        else:
            message = self.generate_reply_text(email, prefer_ai=True)
            followup_source = "scheduled_followup"

        if scenario_type.startswith("commitment_"):
            # v3.8.10: tailored draft for promised-date commitments.
            try:
                disp = datetime.fromisoformat(item.get("target_date", "")).strftime("%m/%d/%Y")
            except Exception:
                disp = item.get("target_date", "") or "the date provided"
            try:
                greeting = get_greeting()
            except Exception:
                greeting = "Hello"
            message = get_commitment_followup_message(item.get("kind", ""), disp, greeting=greeting)
            followup_source = scenario_type
            email_type = (email.get("email_type", "") or "").upper()
            if email_type == "V":
                target_status = "Waiting on Vendor"
            elif email_type == "C":
                target_status = "Waiting on Customer"
        ok = self.create_reply_draft_with_message(
            email,
            message,
            require_thread=True,
            target_status_after_send=target_status,
            followup_source=followup_source,
        )
        if ok:
            item["completed"] = True
            item["completed_at"] = datetime.now().isoformat()
            item["completed_reason"] = f"draft_deployed_from_due_popup:{kind}"
            email["followup_time"] = "Completed"
            if item.get("one_time_after_app_delete"):
                # This was intentionally kept after the email was deleted from
                # MaINbox. Treat it as the final reminder and do not allow the
                # draft/send tracking step to spawn another follow-up cycle.
                now_iso = datetime.now().isoformat()
                for pending in getattr(self, "pending_reply_checks", []) or []:
                    if self._followup_item_matches_email(pending, email) and not pending.get("completed") and not pending.get("cancelled"):
                        pending["cancelled"] = True
                        pending["cancelled_at"] = now_iso
                        pending["cancel_reason"] = "Cancelled after final one-time follow-up for deleted MaINbox item."
                try:
                    existing = self.status_data.get(email.get("entry_id", ""), {})
                    existing["app_deleted"] = True
                    existing["prevent_future_followups"] = True
                    existing["deleted_followups_final_only"] = True
                    self.status_data[email.get("entry_id", "")] = existing
                    self.flush_status_data()
                    self.save_pending_reply_checks()
                except Exception:
                    pass
            return True
        return False

    def show_due_followups_popup(self, due_rows=None):
        """Show due follow-ups for user confirmation instead of auto-drafting."""
        if getattr(self, "due_followup_popup_open", False):
            return
        due_rows = due_rows or self.get_due_followup_review_rows(datetime.now())
        if not due_rows:
            return

        self.due_followup_popup_open = True
        win = tk.Toplevel(self.root)
        win.title("Due Follow-Ups Ready")
        remember_window_geometry(win, "Due Follow-Ups Ready", "1050x520")
        win.transient(self.root)

        header = tk.Frame(win)
        header.pack(fill="x", padx=10, pady=8)
        title_var = tk.StringVar(value=f"{len(due_rows)} follow-up(s) are due")
        tk.Label(header, textvariable=title_var, font=("Segoe UI", 15, "bold")).pack(side="left")
        tk.Label(header, text="Select the drafts you want deployed, or cancel them.", fg=_FG_DIM).pack(side="left", padx=12)

        columns = ("due", "kind", "sender", "group", "subject", "note")
        tree = ttk.Treeview(win, columns=columns, show="headings", selectmode="extended")
        for col, label, width in [
            ("due", "Due", 120), ("kind", "Type", 160), ("sender", "Sender", 170),
            ("group", "Group", 180), ("subject", "Subject", 300), ("note", "Note", 260),
        ]:
            tree.heading(col, text=label)
            tree.column(col, width=width)
        tree.pack(fill="both", expand=True, padx=10, pady=5)
        tree.tag_configure("due", background="#fff2cc", foreground="black")

        detail = tk.Text(win, height=5, wrap="word", font=("Segoe UI", 9))
        detail.pack(fill="x", padx=10, pady=(4, 6))

        row_map = {}

        def reload_rows():
            nonlocal due_rows, row_map
            due_rows = self.get_due_followup_review_rows(datetime.now())
            row_map = {r["queue_id"]: r for r in due_rows}
            tree.delete(*tree.get_children())
            for row in due_rows:
                tree.insert(
                    "", "end", iid=row["queue_id"],
                    values=(row.get("due_display", ""), row.get("kind", ""), row.get("sender", ""), row.get("group", ""), row.get("subject", ""), row.get("note", "")),
                    tags=("due",),
                )
            title_var.set(f"{len(due_rows)} follow-up(s) are due")
            detail.delete("1.0", tk.END)
            if due_rows:
                detail.insert(tk.END, "Select one or more due follow-ups. Deploy Selected creates drafts only for what you choose.")
            else:
                detail.insert(tk.END, "No due follow-ups remain.")
            self.followup_status_var.set(f"Follow-ups: {len(due_rows)} due | {self.active_followup_count()} active")
            self.render_followup_preview_queue()

        def selected_rows(show_warning=True):
            selected = tree.selection()
            rows = [row_map[iid] for iid in selected if iid in row_map]
            if not rows and show_warning:
                messagebox.showwarning("No Follow-Up Selected", "Select one or more due follow-ups first.", parent=win)
            return rows

        def show_detail(event=None):
            rows = selected_rows(show_warning=False)
            detail.delete("1.0", tk.END)
            if not rows:
                detail.insert(tk.END, "Select one or more due follow-ups. Deploy Selected creates drafts only for what you choose.")
                return
            row = rows[0]
            detail.insert(
                tk.END,
                f"Type: {row.get('kind')}\n"
                f"Due: {row.get('due_display')}\n"
                f"Sender: {row.get('sender')}\n"
                f"Group: {row.get('group') or 'None'}\n"
                f"Subject: {row.get('subject')}\n\n"
                f"Note: {row.get('note')}\n\n"
                f"Selected items: {len(rows)}"
            )

        def deploy_selected():
            rows = selected_rows()
            if not rows:
                return
            if not messagebox.askyesno("Deploy Follow-Up Drafts", f"Create draft(s) for {len(rows)} selected due follow-up(s)?", parent=win):
                return
            deployed = 0
            failed = 0
            for row in rows:
                if self.deploy_due_followup_row(row):
                    deployed += 1
                else:
                    failed += 1
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_cached_state()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            reload_rows()
            messagebox.showinfo("Follow-Ups", f"Drafts deployed: {deployed}\nFailed/skipped: {failed}", parent=win)

        def cancel_rows(rows, reason):
            cancelled = 0
            for row in rows:
                item = row.get("item")
                if item and not item.get("completed") and not item.get("cancelled"):
                    item["cancelled"] = True
                    item["cancelled_at"] = datetime.now().isoformat()
                    item["cancel_reason"] = reason
                    email = row.get("email")
                    if email:
                        email["followup_time"] = "Cancelled"
                    cancelled += 1
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_cached_state()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            reload_rows()
            return cancelled

        def cancel_selected():
            rows = selected_rows()
            if not rows:
                return
            if messagebox.askyesno("Cancel Selected", f"Cancel {len(rows)} selected due follow-up(s)?", parent=win):
                count = cancel_rows(rows, "Cancelled from due follow-up popup")
                messagebox.showinfo("Cancelled", f"Cancelled {count} follow-up(s).", parent=win)

        def cancel_all_due():
            rows = list(row_map.values())
            if not rows:
                return
            if messagebox.askyesno("Cancel All Due", f"Cancel ALL {len(rows)} due follow-up(s)?", parent=win):
                count = cancel_rows(rows, "Cancel all due from due follow-up popup")
                messagebox.showinfo("Cancelled", f"Cancelled {count} due follow-up(s).", parent=win)

        def snooze_rows(rows, due_at, label="custom"):
            changed = 0
            for row in rows:
                item = row.get("item")
                if item and not item.get("completed") and not item.get("cancelled"):
                    item["due_at"] = due_at.isoformat()
                    item["snoozed_at"] = datetime.now().isoformat()
                    item["snooze_label"] = label
                    email = row.get("email")
                    if email:
                        email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
                    changed += 1
            self.save_followups()
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_cached_state()
            self.render_email_rows()
            self.render_group_rows()
            self.render_followup_preview_queue()
            reload_rows()
            return changed

        def parse_custom_snooze(raw):
            raw = (raw or "").strip()
            if not raw:
                return None
            for fmt in ["%m/%d/%Y %I:%M %p", "%m/%d/%y %I:%M %p", "%m/%d/%Y %H:%M", "%m/%d/%y %H:%M"]:
                try:
                    return datetime.strptime(raw.upper(), fmt)
                except Exception:
                    pass
            return parse_followup_time(raw)

        def snooze_selected(minutes=None):
            rows = selected_rows()
            if not rows:
                return
            if minutes is None:
                custom = simpledialog.askstring(
                    "Custom Snooze",
                    "Enter snooze date/time. Examples:\n3:00 PM\n05/13/2026 9:30 AM",
                    parent=win
                )
                due_at = parse_custom_snooze(custom)
                if not due_at:
                    messagebox.showerror("Invalid Snooze", "Please enter a time like 3:00 PM or a date/time like 05/13/2026 9:30 AM.", parent=win)
                    return
                label = custom
            else:
                due_at = datetime.now() + timedelta(minutes=minutes)
                label = f"{minutes} minutes"
            count = snooze_rows(rows, due_at, label=label)
            if count:
                messagebox.showinfo("Snoozed", f"Snoozed {count} follow-up(s).", parent=win)

        def snooze_dropdown_apply():
            label = snooze_var.get()
            options = {
                "15 min": 15,
                "30 min": 30,
                "1 hour": 60,
                "2 hours": 120,
                "Tomorrow 9 AM": None,
                "Custom date/time": None,
            }
            if label == "Tomorrow 9 AM":
                target = datetime.combine((datetime.now() + timedelta(days=1)).date(), datetime.strptime("9:00 AM", "%I:%M %p").time())
                rows = selected_rows()
                if rows:
                    count = snooze_rows(rows, target, label=label)
                    if count:
                        messagebox.showinfo("Snoozed", f"Snoozed {count} follow-up(s).", parent=win)
                return
            if label == "Custom date/time":
                snooze_selected(None)
                return
            snooze_selected(options.get(label, 30))

        def select_all():
            tree.selection_set(tree.get_children())
            show_detail()

        def on_close():
            self.due_followup_popup_open = False
            win.destroy()

        btns = tk.Frame(win)
        btns.pack(fill="x", padx=10, pady=(0, 10))
        tk.Button(btns, text="Select All", command=select_all, width=12).pack(side="left", padx=4)
        tk.Button(btns, text="Deploy Selected", command=deploy_selected, width=18).pack(side="left", padx=4)
        snooze_var = tk.StringVar(value="30 min")
        ttk.Combobox(btns, textvariable=snooze_var, values=["15 min", "30 min", "1 hour", "2 hours", "Tomorrow 9 AM", "Custom date/time"], state="readonly", width=18).pack(side="left", padx=4)
        tk.Button(btns, text="Snooze Selected", command=snooze_dropdown_apply, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Cancel Selected", command=cancel_selected, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Cancel All Due", command=cancel_all_due, width=16).pack(side="left", padx=4)
        tk.Button(btns, text="Refresh List", command=reload_rows, width=14).pack(side="right", padx=4)
        tk.Button(btns, text="Close", command=on_close, width=12).pack(side="right", padx=4)

        tree.bind("<<TreeviewSelect>>", show_detail)
        win.protocol("WM_DELETE_WINDOW", on_close)
        reload_rows()
        # v3.9.60: a due-follow-up reminder can fire while MaINbox is minimized (e.g. during an
        # AutoPilot / background pass). lift()/focus_force() alone do not reliably restore a
        # minimized window under Windows, so use the Win32 restore+foreground helper -- the user
        # previously had to use Task Manager -> "Bring to front" to see it. Falls back to lift/focus.
        try:
            self.force_mainbox_window_to_front(win)
        except Exception:
            try:
                win.lift()
                win.focus_force()
            except Exception:
                pass

    def get_active_followup_for_email(self, entry_id):
        # v3.8.12: the Follow Up column should show the earliest active reminder
        # from manual follow-ups, automatic scenario reminders, or ETA/lead-time
        # commitment reminders. Previously commitment reminders were created but
        # did not visibly appear in the main grid until they were due in the queue.
        matches = []
        for _items in (
            getattr(self, "followups", []) or [],
            getattr(self, "scenario_reminders", []) or [],
            getattr(self, "commitment_reminders", []) or [],
        ):
            for f in _items:
                if isinstance(f, dict) and f.get("entry_id") == entry_id and not f.get("completed") and not f.get("cancelled"):
                    matches.append(f)
        if not matches:
            return None
        matches.sort(key=lambda f: f.get("due_at", ""))
        return matches[0]

    def get_active_manual_followup_for_email(self, email):
        """Return the earliest active user-created follow-up matching this email/thread.

        Manual follow-ups are intentional user decisions, so later AI follow-up
        automation should not create a duplicate reminder for the same
        email/conversation/group while one is active.
        """
        try:
            matches = []
            for item in getattr(self, "followups", []) or []:
                if not isinstance(item, dict):
                    continue
                if item.get("completed") or item.get("cancelled"):
                    continue
                if self._followup_item_matches_email(item, email):
                    matches.append(item)
            if not matches:
                return None
            matches.sort(key=lambda f: f.get("due_at", ""))
            return matches[0]
        except Exception:
            return None

    def active_manual_followup_exists_for_email(self, email):
        return self.get_active_manual_followup_for_email(email) is not None

    def get_active_automatic_tracking_for_email(self, email, include_pending=True):
        """Return active automatic follow-up/tracking rows for this email/thread.

        This is intentionally broader than the old exact EntryID-only check.
        It prevents a second AI/vendor/customer reminder from being created for
        the same conversation/group when another automatic tracker already
        exists. Manual follow-ups still outrank automatic reminders.
        """
        try:
            matches = []
            for collection_name, items in (
                ("scenario_reminders", getattr(self, "scenario_reminders", []) or []),
                ("pending_reply_checks", getattr(self, "pending_reply_checks", []) or []) if include_pending else ("pending_reply_checks", []),
            ):
                for index, item in enumerate(items):
                    if not isinstance(item, dict):
                        continue
                    if item.get("completed") or item.get("cancelled"):
                        continue
                    if self._followup_item_matches_email(item, email):
                        matches.append((collection_name, index, item))
            return matches
        except Exception:
            return []

    def active_automatic_tracking_exists_for_email(self, email, include_pending=True):
        return bool(self.get_active_automatic_tracking_for_email(email, include_pending=include_pending))

    def get_followup_display_for_email(self, entry_id):
        item = self.get_active_followup_for_email(entry_id)
        if not item:
            return ""
        try:
            return datetime.fromisoformat(item["due_at"]).strftime("%m/%d %I:%M %p")
        except Exception:
            return "Scheduled"


    def scenario_reminder_exists(self, scenario_type, entry_id):
        for item in self.scenario_reminders:
            if item.get("type") == scenario_type and item.get("entry_id") == entry_id and not item.get("completed") and not item.get("cancelled"):
                return True
        return False

    def schedule_scenario_reminder(self, scenario_type, email, minutes, note=""):
        if not email:
            return False
        if self.email_is_completed(email):
            email["followup_blocked_reason"] = "Blocked automatic tracking: email is Completed/Low/Junk."
            return False
        entry_id = email.get("entry_id", "")
        existing_status = self.status_data.get(entry_id, {}) if entry_id else {}
        if entry_id and (existing_status.get("app_deleted") or existing_status.get("prevent_future_followups")):
            email["followup_blocked_reason"] = "Blocked automatic tracking: item was deleted from MaINbox."
            return False
        ai_types = {"ai_followup_review", "ai_vendor_followup_review", "ai_customer_followup_review"}
        is_ai_followup = scenario_type in ai_types or str(scenario_type).startswith("ai_")
        if is_ai_followup and self.active_manual_followup_exists_for_email(email):
            email["followup_blocked_reason"] = "Blocked AI follow-up: an active manual follow-up already exists for this email/thread."
            return False
        if self.active_automatic_tracking_exists_for_email(email, include_pending=True):
            email["followup_blocked_reason"] = "Blocked automatic tracking: an active automatic follow-up already exists for this email/thread."
            return False
        if not entry_id or self.scenario_reminder_exists(scenario_type, entry_id):
            return False
        due_at = datetime.now() + timedelta(minutes=minutes)
        item = {
            "type": scenario_type,
            "entry_id": entry_id,
            "store_id": email.get("store_id", ""),
            "conversation_id": email.get("conversation_id", ""),
            "group_id": self.get_group_id_for_email(entry_id),
            "subject": email.get("subject", ""),
            "sender": email.get("sender", ""),
            "created_at": datetime.now().isoformat(),
            "due_at": due_at.isoformat(),
            "baseline_received_timestamp": email.get("received_timestamp", 0),
            "note": note,
            "completed": False,
            "cancelled": False
        }
        self.scenario_reminders.append(item)
        email["followup_time"] = due_at.strftime("%m/%d %I:%M %p")
        # v3.9.27 efficiency: the old tail ran the 4-collection dedupe AND a full
        # email-cache JSON write for EVERY reminder created -- including once per
        # PO-mention email during bulk import. The creation guards above already
        # guarantee this item is unique (any active manual/automatic tracker for the
        # thread blocks creation), so: write the small scenario file immediately
        # (crash-safe) WITHOUT a dedupe pass, mark the dedupe flag dirty for the next
        # periodic/orchestrated pass, and defer the heavy cache write to the open
        # commitment batch when bulk work is in progress. save_commitment_reminders()
        # was also dropped here: this function never touches commitment_reminders.
        self.save_scenario_reminders()
        self._followup_dedup_needed = True  # v3 efficiency: mark dirty for next save.
        if getattr(self, "_commitment_batch", 0):
            self._commitment_batch_cache_dirty = True
        else:
            self.save_cached_state()
        return True

    def commitment_reminder_exists(self, entry_id, kind, date_iso):
        for item in getattr(self, "commitment_reminders", []):
            if (item.get("entry_id") == entry_id and item.get("kind") == kind
                    and item.get("target_date") == date_iso
                    and not item.get("completed") and not item.get("cancelled")):
                return True
        return False

    def _save_commitment_prompt_preference(self, mode=None):
        """Persist the reminder creation mode from the popup without touching unrelated settings."""
        try:
            cur = load_mainbox_settings()
            if mode:
                mode = str(mode or "").strip().lower()
                if mode in ("disabled", "prompt", "auto"):
                    cur["commitment_reminder_mode"] = mode
                    cur["commitment_reminders_enabled"] = (mode != "disabled")
            save_json(MAINBOX_SETTINGS_FILE, cur)
            self.settings = load_mainbox_settings()
            apply_mainbox_settings(self.settings)
        except Exception:
            pass

    def _run_on_main_ui_thread(self, func, default=None, timeout_seconds=90):
        """Run a small UI decision safely even if the scanner was called by a worker thread."""
        try:
            if threading.current_thread() is threading.main_thread():
                return func()
            result_q = queue.Queue(maxsize=1)

            def _wrapped():
                try:
                    result_q.put(func())
                except Exception:
                    result_q.put(default)

            try:
                self.root.after(0, _wrapped)
                return result_q.get(timeout=timeout_seconds)
            except Exception:
                return default
        except Exception:
            return default

    def _prompt_for_commitment_reminder(self, email, commitment, source, fire_dt):
        """Ask the user before creating an ETA/lead-time reminder."""
        def _dialog():
            try:
                win = tk.Toplevel(self.root)
                win.title("Create Reminder?")
                remember_window_geometry(win, "Commitment Reminder Prompt", "560x430")
                win.transient(self.root)
                win.grab_set()
                apply_theme(win)

                label = commitment.get("label", COMMITMENT_KIND_LABELS.get(commitment.get("kind", ""), "Reminder"))
                date_iso = commitment.get("date_iso", "")
                try:
                    target_txt = datetime.fromisoformat(date_iso).strftime("%m/%d/%Y")
                except Exception:
                    target_txt = date_iso or "Unknown"
                conf = float(commitment.get("confidence", 0) or 0)
                matched = (commitment.get("matched_text", "") or "").strip()
                subject = (email.get("subject", "") or "").strip()
                sender = (email.get("sender", "") or "").strip()
                due_txt = ""
                try:
                    due_txt = fire_dt.strftime("%m/%d/%Y %I:%M %p").lstrip("0")
                except Exception:
                    due_txt = str(fire_dt or "")

                tk.Label(win, text="MaINbox found a possible reminder.", font=(_FONT, 14, "bold"), fg=_ACCENT, bg=_BG).pack(anchor="w", padx=14, pady=(14, 6))
                info = tk.Frame(win, bg=_BG2, padx=10, pady=10)
                info.pack(fill="both", expand=True, padx=14, pady=6)

                rows = [
                    ("Type:", str(label)),
                    ("Target date:", str(target_txt)),
                    ("Reminder time:", str(due_txt)),
                    ("Confidence:", f"{conf:.2f}"),
                    ("Source:", str(source or "email")),
                    ("From:", str(sender)),
                    ("Subject:", str(subject)),
                ]
                for r, (k, v) in enumerate(rows):
                    tk.Label(info, text=k, bg=_BG2, fg=_FG_DIM, anchor="w", width=16).grid(row=r, column=0, sticky="nw", pady=2)
                    tk.Label(info, text=v, bg=_BG2, fg=_FG, anchor="w", wraplength=380, justify="left").grid(row=r, column=1, sticky="nw", pady=2)
                tk.Label(info, text="Detected text:", bg=_BG2, fg=_FG_DIM, anchor="w", width=16).grid(row=len(rows), column=0, sticky="nw", pady=(8, 2))
                txt = tk.Text(info, height=4, width=46, wrap="word", bg=_ENTRY_BG, fg=_FG, insertbackground=_FG)
                txt.grid(row=len(rows), column=1, sticky="ew", pady=(8, 2))
                txt.insert("1.0", matched or "(No snippet available)")
                txt.configure(state="disabled")
                info.columnconfigure(1, weight=1)

                decision = {"action": "skip"}

                def choose(action):
                    decision["action"] = action
                    try:
                        win.grab_release()
                    except Exception:
                        pass
                    win.destroy()

                btns = tk.Frame(win, bg=_BG)
                btns.pack(fill="x", padx=14, pady=(8, 14))
                tk.Button(btns, text="Create Reminder", command=lambda: choose("create"), width=16).pack(side="left", padx=4)
                tk.Button(btns, text="Skip", command=lambda: choose("skip"), width=10).pack(side="left", padx=4)
                tk.Button(btns, text="Fully Auto From Now On", command=lambda: choose("auto"), width=20).pack(side="right", padx=4)
                tk.Button(btns, text="Disable Reminders", command=lambda: choose("disabled"), width=16).pack(side="right", padx=4)
                win.protocol("WM_DELETE_WINDOW", lambda: choose("skip"))
                try:
                    win.focus_force()
                    win.lift()
                except Exception:
                    pass
                self.root.wait_window(win)
                return decision.get("action", "skip")
            except Exception:
                try:
                    return "create" if messagebox.askyesno("Create Reminder?", "MaINbox found a possible ETA / lead-time reminder. Create it?") else "skip"
                except Exception:
                    return "skip"

        return self._run_on_main_ui_thread(_dialog, default="skip")

    def schedule_commitment_reminder(self, email, commitment, source=""):
        """v3.8.10: create a dated promised-date follow-up in its own lane so it
        coexists with manual follow-ups and the automatic scenario reminders.

        v3.8.13 adds a user-controlled creation mode:
        disabled = do not create, prompt = ask first, auto = create only above the auto threshold.
        """
        try:
            if not email:
                return False
            mode = str(self.settings.get("commitment_reminder_mode", "prompt") or "prompt").strip().lower()
            if not bool(self.settings.get("commitment_reminders_enabled", True)):
                mode = "disabled"
            if mode not in ("disabled", "prompt", "auto"):
                mode = "prompt"
            if mode == "disabled":
                return False
            try:
                conf = float(commitment.get("confidence", 0) or 0)
            except Exception:
                conf = 0.0
            entry_id = email.get("entry_id", "")
            if not entry_id or self.email_is_completed(email):
                return False
            kind = commitment.get("kind", "")
            date_iso = commitment.get("date_iso", "")
            if not kind or not date_iso:
                return False
            # Exact duplicate (same thread + kind + date) -> skip.
            if self.commitment_reminder_exists(entry_id, kind, date_iso):
                return False
            try:
                target_dt = datetime.fromisoformat(date_iso)
            except Exception:
                return False
            buffer = str(self.settings.get("commitment_reminder_buffer", "morning_of") or "morning_of")
            hour = self.settings.get("commitment_reminder_hour", 8)
            fire_dt = commitment_fire_datetime(target_dt.date(), buffer=buffer, hour=hour, now=datetime.now())

            if mode == "auto":
                try:
                    auto_min = float(self.settings.get("commitment_auto_min_confidence", 0.80))
                except Exception:
                    auto_min = 0.80
                if conf < auto_min:
                    return False
            elif mode == "prompt":
                action = self._prompt_for_commitment_reminder(email, commitment, source, fire_dt)
                if action == "disabled":
                    self._save_commitment_prompt_preference("disabled")
                    return False
                if action == "auto":
                    self._save_commitment_prompt_preference("auto")
                    # The user's explicit popup choice creates this detected reminder too.
                elif action != "create":
                    return False

            label = commitment.get("label", COMMITMENT_KIND_LABELS.get(kind, kind.title()))
            disp = target_dt.strftime("%m/%d/%Y")
            snippet = (commitment.get("matched_text", "") or "")[:160]
            note = f"{label}: {disp} (auto-detected in {source or 'email'})."
            if snippet:
                note += f" Source: \"{snippet}\""
            item = {
                "type": f"commitment_{kind}",
                "kind": kind,
                "kind_label": label,
                "entry_id": entry_id,
                "store_id": email.get("store_id", ""),
                "conversation_id": email.get("conversation_id", ""),
                "group_id": self.get_group_id_for_email(entry_id),
                "subject": email.get("subject", ""),
                "sender": email.get("sender", ""),
                "created_at": datetime.now().isoformat(),
                "due_at": fire_dt.isoformat(),
                "target_date": date_iso,
                "matched_text": (commitment.get("matched_text", "") or "")[:300],
                "basis": commitment.get("basis", ""),
                "confidence": commitment.get("confidence", 0),
                "source": source,
                "note": note,
                "completed": False,
                "cancelled": False,
            }
            # We are committed to creating this reminder now (mode/prompt gate passed).
            # Only at this point supersede an active same-(thread,kind) reminder whose
            # promised DATE differs, so a Skip / below-threshold detection above can
            # never silently delete an existing reminder.
            for old in getattr(self, "commitment_reminders", []):
                if (old.get("entry_id") == entry_id and old.get("kind") == kind
                        and not old.get("completed") and not old.get("cancelled")
                        and old.get("target_date") != date_iso):
                    old["cancelled"] = True
                    old["cancelled_at"] = datetime.now().isoformat()
                    old["cancel_reason"] = "Superseded: promised date changed in a newer email."
                    # Reuse the same Outlook appointment so the changed date reschedules
                    # it in place instead of leaving an orphan on the calendar.
                    if old.get("outlook_appt_entry_id") and not item.get("outlook_appt_entry_id"):
                        item["outlook_appt_entry_id"] = old.get("outlook_appt_entry_id")
                        old["outlook_appt_entry_id"] = ""
            self.commitment_reminders.append(item)
            self._followup_dedup_needed = True
            self.save_commitment_reminders()
            if getattr(self, "_commitment_batch", 0):
                self._commitment_batch_cache_dirty = True
            else:
                try:
                    self.save_cached_state()
                except Exception:
                    pass
            # Best-effort: also place a real Outlook calendar reminder (guarded; never
            # blocks or breaks the in-app reminder if Outlook/COM is unavailable).
            try:
                self.create_or_update_outlook_commitment_reminder(item)
            except Exception:
                pass
            return True
        except Exception:
            return False

    def _extract_text_from_file_light(self, path, ext):
        """Light, dependency-tolerant text extraction used ONLY for commitment
        scanning. Any failure returns '' so it can never break the send scan."""
        try:
            if ext in (".txt", ".csv", ".htm", ".html"):
                with open(path, "r", encoding="utf-8", errors="ignore") as f:
                    data = f.read()
                if ext in (".htm", ".html"):
                    data = re.sub(r"<[^>]+>", " ", data)
                return data[:120000]
            if ext == ".pdf":
                try:
                    import fitz  # PyMuPDF
                except Exception:
                    return ""
                out = []
                try:
                    doc = fitz.open(path)
                    for pg in doc:
                        out.append(pg.get_text("text") or "")
                        if sum(len(x) for x in out) > 120000:
                            break
                    doc.close()
                except Exception:
                    return ""
                return "\n".join(out)[:120000]
            if ext == ".docx":
                try:
                    import docx
                    d = docx.Document(path)
                    return "\n".join(p.text for p in d.paragraphs)[:120000]
                except Exception:
                    return ""
            if ext in (".xlsx", ".xlsm"):
                try:
                    import openpyxl
                    wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
                    parts = []
                    for ws in wb.worksheets:
                        for row in ws.iter_rows(values_only=True):
                            parts.append(" ".join("" if c is None else str(c) for c in row))
                            if sum(len(x) for x in parts) > 120000:
                                break
                        if sum(len(x) for x in parts) > 120000:
                            break
                    wb.close()
                    return "\n".join(parts)[:120000]
                except Exception:
                    return ""
        except Exception:
            return ""
        return ""

    def _commitment_attachment_text(self, sent_msg, max_files=6, max_chars=200000):
        """Pull text from a sent message's text-style attachments for date scanning."""
        texts = []
        tdir = ""
        try:
            atts = getattr(sent_msg, "Attachments", None)
            try:
                count = int(atts.Count) if atts is not None else 0
            except Exception:
                count = 0
            if not count:
                return ""
            text_exts = (".pdf", ".docx", ".doc", ".txt", ".csv", ".xlsx", ".xlsm", ".xls", ".htm", ".html")
            tdir = tempfile.mkdtemp(prefix="mainbox_commit_")
            used = 0
            for i in range(1, count + 1):
                if used >= max_files:
                    break
                try:
                    att = atts.Item(i)
                except Exception:
                    continue
                try:
                    name = (att.FileName or "").strip()
                except Exception:
                    name = ""
                ext = os.path.splitext(name)[1].lower()
                if ext not in text_exts:
                    continue
                try:
                    if outlook_attachment_is_inline(att):
                        continue
                except Exception:
                    pass
                try:
                    safe_name = re.sub(r"[^A-Za-z0-9._-]", "_", name) or f"att_{i}{ext}"
                    tmp = os.path.join(tdir, f"{i}_{safe_name}")
                    att.SaveAsFile(tmp)
                    used += 1
                    t = self._extract_text_from_file_light(tmp, ext)
                    if t:
                        texts.append(f"[attachment: {name}]\n{t}")
                except Exception:
                    continue
            return ("\n\n".join(texts))[:max_chars]
        except Exception:
            return ""
        finally:
            try:
                if tdir and os.path.isdir(tdir):
                    shutil.rmtree(tdir, ignore_errors=True)
            except Exception:
                pass

    def scan_outlook_message_for_commitments(self, msg, email, direction="incoming", force=False, return_detected=False):
        """v3.8.12: scan any Outlook MailItem for ETA/lead-time/promised-date text.

        v3.8.10 only scanned Sent Items after MaINbox created/updated a waiting
        tracker. That missed the most common case: a vendor reply arrives with
        "ETA 6/15", "lead time 2-3 weeks", "ships tomorrow", etc. This method
        scans newly imported Inbox/Sales messages too, while using a separate
        processed list so old sent-tracker bookkeeping cannot suppress the new
        commitment scanner.

        v3.8.17: force=True re-scans even if already processed (manual "Set
        Reminder from Email"); return_detected=True returns (scheduled, detected).
        """
        def _ret(scheduled, detected):
            return (scheduled, detected) if return_detected else scheduled
        try:
            if not email or not bool(self.settings.get("commitment_reminders_enabled", True)):
                return _ret(0, 0)
            try:
                msg_id = getattr(msg, "EntryID", "") or email.get("entry_id", "") or ""
            except Exception:
                msg_id = email.get("entry_id", "") or ""
            processed = set(getattr(self, "commitment_processed_message_ids", []) or [])
            if msg_id and msg_id in processed and not force:
                return _ret(0, 0)

            parts = []
            try:
                body = getattr(msg, "Body", "") or ""
            except Exception:
                body = ""
            if not body:
                body = email.get("body", "") or ""
            if body:
                parts.append(body)
            try:
                subj = getattr(msg, "Subject", "") or email.get("subject", "")
            except Exception:
                subj = email.get("subject", "")
            if subj:
                parts.append(str(subj))

            att_src = ""
            if bool(self.settings.get("commitment_scan_attachments", True)):
                try:
                    att_src = self._commitment_attachment_text(msg)
                except Exception:
                    att_src = ""
                if att_src:
                    parts.append(att_src)

            combined = "\n\n".join(p for p in parts if p)
            if not combined.strip():
                if msg_id and not force:
                    processed.add(msg_id)
                    self.commitment_processed_message_ids = list(processed)[-1500:]
                return _ret(0, 0)
            try:
                min_conf = float(self.settings.get("commitment_min_confidence", 0.6))
            except Exception:
                min_conf = 0.6

            commitments = extract_commitment_dates(combined, today=datetime.now())
            scheduled = 0
            detected = 0
            self._begin_commitment_batch()  # v3.8.23: one write per scanned message
            try:
                for c in commitments:
                    if float(c.get("confidence", 0) or 0) < min_conf:
                        continue
                    detected += 1
                    src = f"{direction} email body"
                    mt = c.get("matched_text", "") or ""
                    if att_src and mt and mt in att_src and (not body or mt not in body):
                        src = f"{direction} attachment"
                    if self.schedule_commitment_reminder(email, c, source=src):
                        scheduled += 1
            finally:
                self._flush_commitment_batch()
            if msg_id and not force:
                processed.add(msg_id)
                self.commitment_processed_message_ids = list(processed)[-1500:]
                if getattr(self, "_commitment_batch", 0):
                    self._commitment_batch_cache_dirty = True
                else:
                    try:
                        self.save_cached_state()
                    except Exception:
                        pass
            if scheduled:
                try:
                    self.log(f"Commitment follow-ups auto-created: {scheduled} from {direction} item '{str(subj or '')[:60]}'")
                except Exception:
                    pass
            return _ret(scheduled, detected)
        except Exception:
            return _ret(0, 0)

    def scan_selected_email_for_reminders(self):
        """v3.8.17: manual 'Set Reminder from Email' - scan the selected email(s)
        for ETA/ship/lead-time/promised dates on demand, regardless of category,
        new-ness, or whether it was already auto-scanned. Mirrors the auto path but
        forces a re-scan and gives clear feedback."""
        try:
            emails = self.get_selected_emails(show_warning=True)
            if not emails:
                return
            mode = str(self.settings.get("commitment_reminder_mode", "prompt") or "prompt").strip().lower()
            if not bool(self.settings.get("commitment_reminders_enabled", True)) or mode == "disabled":
                if messagebox.askyesno("Reminders Off", "Commitment reminders are turned off.\n\nTurn them on (prompt mode) and scan this email now?"):
                    self._save_commitment_prompt_preference("prompt")
                else:
                    return
            total_scheduled = 0
            total_detected = 0
            checked = 0
            for email in emails:
                checked += 1
                msg = None
                try:
                    msg = self.get_message_object(email)
                except Exception:
                    msg = None
                scheduled, detected = self.scan_outlook_message_for_commitments(
                    msg, email, direction="manual", force=True, return_detected=True)
                total_scheduled += int(scheduled or 0)
                total_detected += int(detected or 0)
            try:
                self.sort_emails_for_display()
                self.render_email_rows()
                self.render_followup_preview_queue()
                self.followup_status_var.set(f"Follow-ups: {self.active_followup_count()} active")
            except Exception:
                pass
            if total_detected == 0:
                messagebox.showinfo("Set Reminder from Email", f"No ship / ETA / delivery / promised dates were detected in the selected email(s).\n\nChecked: {checked}.")
            elif total_scheduled == 0:
                messagebox.showinfo("Set Reminder from Email", f"Detected {total_detected} dated item(s) but no new reminder was created (it may already exist, or you chose Skip).")
            else:
                messagebox.showinfo("Set Reminder from Email", f"Detected {total_detected} dated item(s); created {total_scheduled} reminder(s).\n\nThey appear under Upcoming Follow-Ups" + (" and on your Outlook calendar." if self.settings.get("commitment_create_outlook_reminder", True) else "."))
        except Exception as exc:
            try:
                messagebox.showerror("Set Reminder from Email", f"Could not scan the selected email:\n{exc}")
            except Exception:
                pass

    def email_needs_my_reply(self, email):
        """True when the user owes the next action on this email (customer/vendor is
        waiting on a reply). Deterministic - does not depend on AI being available."""
        try:
            if not isinstance(email, dict):
                return False
            if email.get("is_sent_waiting_placeholder"):
                return False  # this is OUR sent item awaiting THEIR reply, not our move
            if email.get("status", "") != "Needs Reply":
                return False
            if self.email_is_completed(email):
                return False
            if email.get("urgency", "") == "Low" or email.get("category", "") == "Junk / Ignore":
                return False
            if bool(self.settings.get("reply_needed_business_only", True)):
                try:
                    br = float(email.get("business_relevance", 0) or 0)
                except Exception:
                    br = 0.0
                # only exclude when we have positive evidence it is low-relevance
                if 0 < br < 0.45:
                    return False
            return True
        except Exception:
            return False

    def build_reply_needed_suggestion(self, email):
        """Build a specific 'what you owe' suggestion from cached fields only (no
        Outlook fetch, so the periodic sweep stays fast)."""
        subject = email.get("subject", "") or ""
        body = email.get("body", "") or ""  # cached body only
        sender = email.get("sender", "") or email.get("sender_email", "")
        try:
            return summarize_reply_request(subject, body, sender)
        except Exception:
            return {"kind": "respond", "action": "reply", "detail": "",
                    "suggestion": f"Reply to {sender or 'them'}: respond"}

    def _active_reply_needed_for_email(self, email):
        for it in getattr(self, "commitment_reminders", []):
            if it.get("kind") == "reply_needed" and not it.get("completed") and not it.get("cancelled"):
                if self._followup_item_matches_email(it, email):
                    return it
        return None

    def schedule_reply_needed_reminder(self, email):
        """Create one 'Reply Needed' reminder (in the commitment lane) for an
        unanswered inbound. Auto (no prompt), one active per thread, optional Outlook."""
        try:
            if not email or not bool(self.settings.get("reply_needed_reminders_enabled", True)):
                return False
            if not self.email_needs_my_reply(email):
                return False
            entry_id = email.get("entry_id", "")
            if not entry_id or self._active_reply_needed_for_email(email):
                return False
            try:
                delay = int(self.settings.get("reply_needed_delay_hours", 4))
            except Exception:
                delay = 4
            now = datetime.now()
            recv = None
            try:
                ts = float(email.get("received_timestamp", 0) or 0)
                if ts:
                    recv = datetime.fromtimestamp(ts)
            except Exception:
                recv = None
            fire = (recv or now) + timedelta(hours=delay)
            if fire < now:
                fire = now  # already overdue -> surface immediately
            info = self.build_reply_needed_suggestion(email)
            suggestion = info.get("suggestion") or f"Reply to {email.get('sender', 'them')}: respond"
            item = {
                "type": "commitment_reply_needed",
                "kind": "reply_needed",
                "kind_label": "Reply Needed",
                "entry_id": entry_id,
                "store_id": email.get("store_id", ""),
                "conversation_id": email.get("conversation_id", ""),
                "group_id": self.get_group_id_for_email(entry_id),
                "subject": email.get("subject", ""),
                "sender": email.get("sender", ""),
                "created_at": now.isoformat(),
                "due_at": fire.isoformat(),
                "target_date": fire.date().isoformat(),
                "matched_text": "",
                "basis": info.get("kind", ""),
                "confidence": 1.0,
                "source": "reply-needed",
                "note": suggestion,
                "completed": False,
                "cancelled": False,
            }
            self.commitment_reminders.append(item)
            self._followup_dedup_needed = True
            self.save_commitment_reminders()
            # v3.9.44: hand the Outlook calendar write to the background writer instead of
            # doing the slow COM round-trip here on the 30s follow-up tick (the freeze).
            self._enqueue_outlook_reminder_write(item)
            return True
        except Exception:
            return False

    def _enqueue_outlook_reminder_write(self, item):
        """v3.9.44: queue one Outlook calendar-reminder write for the serialized background
        writer. Safe to call from the main thread; returns immediately. The reminder's data
        is already saved in self.commitment_reminders, so the calendar item is cosmetic and
        any failure here is harmless."""
        try:
            self._reminder_write_queue.put(item)
        except Exception:
            return
        with self._reminder_write_lock:
            if self._reminder_writer_running:
                return
            self._reminder_writer_running = True
        try:
            threading.Thread(target=self._drain_outlook_reminder_writes,
                             name="outlook-reminder-writer", daemon=True).start()
        except Exception:
            with self._reminder_write_lock:
                self._reminder_writer_running = False

    def _drain_outlook_reminder_writes(self):
        """v3.9.44: background drain for queued Outlook calendar-reminder writes. Runs each
        create_or_update on its own COM-initialized thread, one at a time, so a burst of
        reminders never floods Outlook or blocks the UI. Exits when the queue is idle and
        restarts automatically on the next enqueue."""
        did_com = outlook_thread_init()
        try:
            while True:
                try:
                    item = self._reminder_write_queue.get(timeout=0.5)
                except Exception:
                    with self._reminder_write_lock:
                        if self._reminder_write_queue.empty():
                            self._reminder_writer_running = False
                            return
                        continue
                try:
                    self.create_or_update_outlook_commitment_reminder(item)
                except Exception:
                    pass
        finally:
            try:
                outlook_thread_uninit(did_com)
            except Exception:
                pass

    def sweep_reply_needed_reminders(self):
        """Keep 'Reply Needed' reminders in sync with current state: cancel ones the
        user has answered/closed, and create reminders for inbound items that have
        gone unanswered past the delay. Runs on the 30s follow-up tick; uses only
        cached data so it never blocks the UI."""
        try:
            if not bool(self.settings.get("reply_needed_reminders_enabled", True)):
                return 0
            self._begin_commitment_batch()  # v3.8.23: coalesce per-item writes into one
            changed = 0
            now = datetime.now()
            # 1) cancel reminders that are no longer warranted (replied / status changed / closed).
            for it in getattr(self, "commitment_reminders", []):
                if it.get("kind") != "reply_needed" or it.get("completed") or it.get("cancelled"):
                    continue
                em = self.find_email_for_followup_item(it)
                if (not em) or (not self.email_needs_my_reply(em)):
                    it["cancelled"] = True
                    it["cancelled_at"] = now.isoformat()
                    it["cancel_reason"] = "Reply no longer needed (replied, status changed, or closed)."
                    changed += 1
            # 2) create reminders for aged, unanswered Needs-Reply items.
            try:
                delay = int(self.settings.get("reply_needed_delay_hours", 4))
            except Exception:
                delay = 4
            created = 0
            for em in list(getattr(self, "emails", [])):
                if created >= 50:
                    break
                if not self.email_needs_my_reply(em):
                    continue
                if self._active_reply_needed_for_email(em):
                    continue
                try:
                    ts = float(em.get("received_timestamp", 0) or 0)
                    if ts and (now - datetime.fromtimestamp(ts)) < timedelta(hours=delay):
                        continue  # give the user time to reply before nagging
                except Exception:
                    pass
                if self.schedule_reply_needed_reminder(em):
                    created += 1
                    changed += 1
            if changed:
                self._followup_dedup_needed = True
                self._commitment_batch_dirty = True
            self._flush_commitment_batch()
            return created
        except Exception:
            try:
                self._flush_commitment_batch()
            except Exception:
                pass
            return 0

    def search_mailboxes_for_stock_info(self, item, days_back=180, extra_keywords="",
                                        folders=None, match_mode="any",
                                        require_stock_signal=True, max_results=40,
                                        max_per_folder=1500, scan_attachments=False,
                                        progress=None, diag=None):
        """v3.8.25: manually search the user's own Outlook mail for stock/substitute/
        pricing mentions relevant to a line item. Read-only; never modifies Outlook.

        folders: list of any of "my_inbox", "sales", "sent". Returns a list of result
        dicts: {folder, received, received_ts, sender, subject, snippet, hits, entry_id}.
        Designed to run in a worker thread; `progress(text)` is an optional callback.

        v3.8.27: pass a mutable `diag` dict to collect diagnostics for troubleshooting.
        v3.8.28: thread-safe Outlook access (COM init + fresh thread-local namespace).
        """
        results = []
        if diag is None:
            diag = {}
        diag.setdefault("folders_opened", [])
        diag.setdefault("folders_missing", [])
        diag.setdefault("scanned", {})
        diag.setdefault("term_hits", 0)
        diag.setdefault("date_skipped", 0)
        diag.setdefault("errors", [])

        required, all_terms = build_search_terms(item, extra_keywords)
        extra_terms = [t for t in all_terms if t not in required]
        diag["required_terms"] = list(required)
        diag["extra_terms"] = list(extra_terms)
        if not all_terms:
            diag["errors"].append("no search terms built from item")
            return results
        try:
            cutoff = datetime.now() - timedelta(days=max(1, int(days_back)))
        except Exception:
            cutoff = datetime.now() - timedelta(days=180)
        diag["cutoff"] = cutoff.strftime("%Y-%m-%d")

        # CRITICAL: this runs on a background worker thread. Outlook COM objects are
        # thread-affine, so the main thread's self.namespace cannot be used here -
        # doing so made every folder fail to open. Initialize COM on THIS thread and
        # create a fresh Outlook connection, exactly like the other background scanners.
        did_com = outlook_thread_init()
        try:
            try:
                _outlook, namespace = connect_outlook(show_error=False)
            except Exception as e:
                namespace = None
                diag["errors"].append("connect: %s" % e)
            if not namespace:
                diag["errors"].append("no Outlook namespace on worker thread")
                return results

            def _open_sales_folder(ns):
                """Resolve the Sales shared mailbox/folder from a thread-local
                namespace (mirrors find_sales_inbox_folder without touching
                self.namespace, which belongs to the main thread)."""
                try:
                    roots = ns.Folders
                    for i in range(1, roots.Count + 1):
                        root = roots.Item(i)
                        if SALES_MAILBOX_NAME.lower() in str(root.Name).lower():
                            try:
                                return root.Folders.Item("Inbox")
                            except Exception:
                                return root
                    for i in range(1, roots.Count + 1):
                        root = roots.Item(i)
                        try:
                            return root.Folders.Item(SALES_MAILBOX_NAME)
                        except Exception:
                            pass
                except Exception:
                    pass
                return None

            folder_objs = []
            if "my_inbox" in folders:
                try:
                    f = namespace.GetDefaultFolder(6)  # olFolderInbox
                    if f:
                        folder_objs.append(("My Inbox", f))
                        diag["folders_opened"].append("My Inbox")
                    else:
                        diag["folders_missing"].append("My Inbox")
                except Exception as e:
                    diag["errors"].append("My Inbox open: %s" % e)
            if "sales" in folders:
                try:
                    f = _open_sales_folder(namespace)
                    if f:
                        folder_objs.append(("Sales", f))
                        diag["folders_opened"].append("Sales")
                    else:
                        diag["folders_missing"].append("Sales")
                except Exception as e:
                    diag["errors"].append("Sales open: %s" % e)
            if "sent" in folders:
                try:
                    f = namespace.GetDefaultFolder(5)  # olFolderSentMail
                    if f:
                        folder_objs.append(("Sent", f))
                        diag["folders_opened"].append("Sent")
                    else:
                        diag["folders_missing"].append("Sent")
                except Exception as e:
                    diag["errors"].append("Sent open: %s" % e)

            for fname, folder in folder_objs:
                if len(results) >= max_results:
                    break
                try:
                    items = folder.Items
                    items.Sort("[ReceivedTime]", True)
                except Exception:
                    try:
                        items = folder.Items
                    except Exception as e:
                        diag["errors"].append("%s Items: %s" % (fname, e))
                        continue
                checked = 0
                if progress:
                    try:
                        progress("Searching %s..." % fname)
                    except Exception:
                        pass
                for msg in items:
                    if checked >= max_per_folder or len(results) >= max_results:
                        break
                    checked += 1
                    try:
                        # Date gate. SKIP messages older than the cutoff rather than
                        # breaking, so the scan is correct even if Outlook returns items
                        # unsorted (Sort can silently fail). Sent items expose SentOn.
                        recv_naive = None
                        for attr in ("ReceivedTime", "SentOn"):
                            try:
                                val = getattr(msg, attr, None)
                                if val is None:
                                    continue
                                try:
                                    recv_naive = datetime(val.year, val.month, val.day,
                                                          getattr(val, "hour", 0),
                                                          getattr(val, "minute", 0),
                                                          getattr(val, "second", 0))
                                except Exception:
                                    try:
                                        recv_naive = val.replace(tzinfo=None)
                                    except Exception:
                                        recv_naive = None
                                if recv_naive is not None:
                                    break
                            except Exception:
                                continue
                        if recv_naive is not None and recv_naive < cutoff:
                            diag["date_skipped"] = diag.get("date_skipped", 0) + 1
                            continue
                        try:
                            subject = msg.Subject or ""
                        except Exception:
                            subject = ""
                        try:
                            body = msg.Body or ""
                        except Exception:
                            body = ""
                        combined_text = body
                        if scan_attachments:
                            try:
                                att = self._commitment_attachment_text(msg)
                                if att:
                                    combined_text = (body + "\n" + att) if body else att
                            except Exception:
                                pass
                        # Diagnostic: did ANY term appear at all (ignoring the signal
                        # filter)? Distinguishes "term never seen" from "seen but filtered".
                        try:
                            _m_any, _h_any = message_matches_search(
                                combined_text, subject, required, extra_terms,
                                match_mode=match_mode, require_stock_signal=False)
                            if _m_any:
                                diag["term_hits"] = diag.get("term_hits", 0) + 1
                        except Exception:
                            pass
                        matched, hits = message_matches_search(
                            combined_text, subject, required, extra_terms,
                            match_mode=match_mode, require_stock_signal=require_stock_signal)
                        if not matched:
                            continue
                        try:
                            sender = self.get_sender_email(msg) or ""
                        except Exception:
                            sender = ""
                        if not sender:
                            try:
                                sender = msg.SenderName or ""
                            except Exception:
                                sender = ""
                        try:
                            entry_id = msg.EntryID or ""
                        except Exception:
                            entry_id = ""
                        results.append({
                            "folder": fname,
                            "received": recv_naive.strftime("%Y-%m-%d %I:%M %p") if recv_naive else "",
                            "received_ts": recv_naive.timestamp() if recv_naive else 0,
                            "sender": sender,
                            "subject": _norm(subject)[:160],
                            "snippet": extract_stock_snippet(combined_text, hits),
                            "hits": hits,
                            "entry_id": entry_id,
                        })
                    except Exception:
                        continue
                diag["scanned"][fname] = checked

            results.sort(key=lambda r: r.get("received_ts", 0), reverse=True)
            diag["result_count"] = len(results)
            return results[:max_results]
        except Exception as e:
            try:
                diag["errors"].append("top-level: %s" % e)
            except Exception:
                pass
            return results
        finally:
            try:
                outlook_thread_uninit(did_com)
            except Exception:
                pass

    def schedule_vendor_no_response_reminder(self, email):
        return self.schedule_scenario_reminder(
            "vendor_no_response",
            email,
            VENDOR_NO_RESPONSE_MINUTES,
            f"Waiting on vendor: remind if no response after {VENDOR_NO_RESPONSE_MINUTES} minutes."
        )

    def schedule_po_order_followup_if_needed(self, email, triage_result=None, quick_result=None):
        if not email:
            return False
        text = f"{email.get('subject', '')} {email.get('body', '')}"
        if not text_mentions_po_or_order(text):
            return False
        allowed, why = should_allow_followup_decision(email, triage_result=triage_result, quick_result=quick_result)
        if not allowed:
            email["followup_blocked_reason"] = why
            return False
        # Treat this as a money-close customer follow-up scenario only after the business relevance gate passes.
        email["status"] = "Waiting on Customer"
        email["followup_reason_ai"] = (triage_result or quick_result or {}).get("followup_reason", "Customer mentioned PO/order.")
        self.save_record(email)
        self.flush_status_data()
        return self.schedule_scenario_reminder(
            "customer_po_order_followup",
            email,
            CUSTOMER_PO_FOLLOWUP_MINUTES,
            f"Customer mentioned PO/order and passed follow-up gate. Auto-create a follow-up draft after {CUSTOMER_PO_FOLLOWUP_MINUTES} minutes if nothing newer arrives."
        )

    def schedule_ai_followup_if_needed(self, email, triage_result=None, quick_result=None, force=False):
        """Let AI recommend follow-ups, but keep execution safe: due items show in the follow-up review queue and every decision is logged in AI Triage.

        force=True means the user explicitly approved this follow-up from the
        assistant log, so the confidence gate below is skipped and we schedule
        directly (the row is still de-duplicated by schedule_scenario_reminder)."""
        if not email:
            return False, "No email."

        # A dead OR done quote should do the OPPOSITE of a follow-up: propose
        # cleaning up the group (archive it + mark complete). Covers a customer
        # cancellation / no-quote AND a won order (PO provided / "good to go"). It
        # stays a one-click Approve unless Auto-Archive is on. force=True (explicit
        # approve) bypasses this. Nothing is deleted.
        if not force:
            closed, _phrase, _kind = self._email_request_is_closed(email)
            # Semantic fallback: no phrase matched, but if this is a SHORT reply in a
            # quote thread, ask the local model whether the customer closed it (won/
            # lost). Catches phrasings no pattern anticipated. Held for review only
            # (never auto-archives); a no-op when Ollama is off.
            if not closed:
                try:
                    _b = str(email.get("body", "") or "")
                    _head = re.split(r"\n\s*(?:from:|sent:|on .+ wrote:|-{3,}\s*original message)",
                                     _b, maxsplit=1, flags=re.I)[0]
                    _wc = len(_head.split())
                    if 0 < _wc <= 25 and self.get_group_id_for_email(email.get("entry_id", "")):
                        _verdict = llm_classify_deal_status(email.get("subject", ""), _head)
                        if _verdict in ("won", "lost"):
                            closed, _phrase, _kind = True, "AI read", ("llm_won" if _verdict == "won" else "llm_lost")
                except Exception:
                    pass
            if closed:
                self._assistant_propose_cleanup(email, _phrase, _kind)
                _why = {"won": "Order placed (quote won)", "llm_won": "Order placed (AI read)",
                        "declined": "Customer declined", "declined_soft": "Possible customer decline",
                        "llm_lost": "Customer declined (AI read)", "no_quote": "No quote / no bid"
                        }.get(_kind, "Customer cancelled")
                email["followup_blocked_reason"] = f"{_why}; proposed archive instead."
                return False, f"{_why} -> proposed archive + mark complete (no follow-up)."

        followup_source = triage_result if isinstance(triage_result, dict) else {}
        quick_source = quick_result if isinstance(quick_result, dict) else {}

        manual_followup = self.get_active_manual_followup_for_email(email)
        if manual_followup:
            try:
                due_text = self.format_due_display(manual_followup.get("due_at", "")) if hasattr(self, "format_due_display") else manual_followup.get("due_at", "")
            except Exception:
                due_text = manual_followup.get("due_at", "")
            why = f"Blocked AI follow-up: active manual follow-up already exists{(' for ' + due_text) if due_text else ''}."
            email["followup_blocked_reason"] = why
            self.record_ai_triage_history(email, before={}, after={"category": email.get("category", ""), "urgency": email.get("urgency", ""), "status": email.get("status", ""), "group": self.get_group_id_for_email(email.get("entry_id", ""))}, reason=why, source="AI Followup")
            return False, why

        learned_followup, learned_key = self.get_followup_learning_hint_for_email(email)
        if learned_followup:
            behavior = learned_followup.get("behavior", "")
            if behavior == "no_followup":
                why = f"Blocked follow-up: learned no-follow-up rule matched ({learned_key})."
                email["followup_blocked_reason"] = why
                self.record_ai_triage_history(email, before={}, after={"category": email.get("category", ""), "urgency": email.get("urgency", ""), "status": email.get("status", ""), "group": self.get_group_id_for_email(email.get("entry_id", ""))}, reason=why, source="Followup Learn")
                return False, why
            # Learned follow-up rules can turn a borderline AI decision into a follow-up candidate,
            # but the normal business/spam safety gates still apply.
            followup_source = dict(followup_source)
            quick_source = dict(quick_source)
            followup_source["needs_followup"] = True
            followup_source["followup_reason"] = learned_followup.get("reason", "Learned follow-up rule matched.")
            followup_source["business_relevance"] = max(float(followup_source.get("business_relevance", quick_source.get("business_relevance", 0.80)) or 0.80), 0.80)
            followup_source["spam_likelihood"] = min(float(followup_source.get("spam_likelihood", quick_source.get("spam_likelihood", 0.10)) or 0.10), 0.20)

        allowed, why = should_allow_followup_decision(email, triage_result=followup_source, quick_result=quick_source)
        if not allowed:
            email["followup_blocked_reason"] = why
            return False, why

        # ── Flood guard ────────────────────────────────────────────────────────
        # A re-triage runs on every rescan (as often as every ~15 min). If this
        # email already has an active automatic follow-up, the reminder itself is
        # a no-op -- schedule_scenario_reminder de-dupes it -- but WITHOUT this
        # guard the assistant.handle() call below still created a NEW activity row
        # every pass, flooding the live log with dozens of identical "Schedule a
        # follow-up reminder" entries for the same email (exactly what the user
        # saw). Bail out before logging once a tracker already exists. An explicit
        # user approval (force=True) still passes so they can (re)confirm a held
        # item.
        if not force and self.active_automatic_tracking_exists_for_email(email, include_pending=True):
            email["followup_blocked_reason"] = "Automatic follow-up already active; not re-logging."
            return False, "Automatic follow-up already active for this email/thread."

        # AI Assistant gate (experimental): even after the business-relevance gate
        # passes, only auto-create the reminder if the assistant is confident.
        # Low-confidence ones are surfaced in the live log instead of silently
        # piling up — directly reducing reminder noise. Scheduling a reminder is
        # low-stakes (a JSON entry, no Outlook draft), so this is freeze-safe.
        assistant = getattr(self, "assistant", None)
        if assistant and assistant.config.enabled and not force:
            fu_conf = confidence_from_triage({
                "business_relevance": followup_source.get("business_relevance", quick_source.get("business_relevance", 0.0)),
                "spam_likelihood": followup_source.get("spam_likelihood", quick_source.get("spam_likelihood", 1.0)),
            })
            fu_reason = str(followup_source.get("followup_reason", quick_source.get("followup_reason", "")) or "Possible follow-up.").strip()
            # Guard: we are already inside schedule_ai_followup_if_needed, and the
            # fall-through below does the real scheduling for AUTO/REVIEW. So tell
            # _assistant_apply NOT to re-schedule (which would recurse). The Approve
            # button in the log runs apply WITHOUT this guard, so it schedules then.
            self._assistant_suppress_schedule = True
            try:
                rec = assistant.handle(
                    kind="Follow-up", stakes=LOW, confidence=fu_conf,
                    subject=email.get("subject", ""), sender=email.get("sender", ""),
                    summary="Schedule a follow-up reminder",
                    before={}, after={"action": "schedule_followup"},
                    reason=fu_reason,
                    payload={"entry_id": email.get("entry_id", ""),
                             "schedule": True, "triage": followup_source, "quick": quick_source},
                    dedup_key=f"followup:{email.get('entry_id','')}",
                )
            finally:
                self._assistant_suppress_schedule = False
            if rec.get("decision") == ASK:
                # Below your auto-file bar: don't schedule now, hold it for your
                # one-click Approve in the log. Approving routes through
                # _assistant_apply, which schedules it then.
                email["followup_blocked_reason"] = "Below your auto-file bar; held for your approval."
                return False, "Held for your approval (below your auto-file bar)."
            # At/above the bar (AUTO): fall through and schedule as normal (logged).

        reason = str(followup_source.get("followup_reason", quick_source.get("followup_reason", "AI determined this business item may need a follow-up.")) or "AI determined this business item may need a follow-up.").strip()
        status = email.get("status", "")
        minutes = CUSTOMER_PO_FOLLOWUP_MINUTES
        scenario_type = "ai_followup_review"
        if learned_followup and learned_followup.get("minutes"):
            try:
                minutes = int(learned_followup.get("minutes"))
            except Exception:
                pass
        if (learned_followup and learned_followup.get("behavior") == "wait_for_vendor") or status == "Waiting on Vendor":
            minutes = int(learned_followup.get("minutes") or VENDOR_NO_RESPONSE_MINUTES) if learned_followup else VENDOR_NO_RESPONSE_MINUTES
            scenario_type = "ai_vendor_followup_review"
        elif (learned_followup and learned_followup.get("behavior") == "wait_for_customer") or status == "Waiting on Customer":
            minutes = int(learned_followup.get("minutes") or CUSTOMER_PO_FOLLOWUP_MINUTES) if learned_followup else CUSTOMER_PO_FOLLOWUP_MINUTES
            scenario_type = "ai_customer_followup_review"

        scheduled = self.schedule_scenario_reminder(
            scenario_type,
            email,
            minutes,
            f"AI follow-up recommendation: {reason}"
        )
        if scheduled:
            email["followup_reason_ai"] = reason
            self.save_record(email)
            self.flush_status_data()
            behavior = "followup_review"
            if scenario_type == "ai_vendor_followup_review":
                behavior = "wait_for_vendor"
            elif scenario_type == "ai_customer_followup_review":
                behavior = "wait_for_customer"
            self.learn_followup_behavior(email, behavior, minutes, f"Learned from AI follow-up decision: {reason}")
            self.record_ai_triage_history(email, before={}, after={"category": email.get("category", ""), "urgency": email.get("urgency", ""), "status": email.get("status", ""), "group": self.get_group_id_for_email(email.get("entry_id", ""))}, reason=f"Follow-up scheduled/learned ({behavior}, {minutes} min): {reason}", source="AI Followup")
            return True, f"AI follow-up scheduled in {minutes} min: {reason}"
        return False, "AI follow-up already exists or could not be scheduled."

    def newer_related_email_exists(self, reminder):
        conversation_id = reminder.get("conversation_id", "")
        group_id = reminder.get("group_id", "")
        baseline = reminder.get("baseline_received_timestamp", 0) or 0
        entry_id = reminder.get("entry_id", "")
        for email in self.emails:
            if email.get("entry_id") == entry_id:
                continue
            is_related = False
            if conversation_id and email.get("conversation_id") == conversation_id:
                is_related = True
            elif group_id and self.get_group_id_for_email(email.get("entry_id", "")) == group_id:
                is_related = True
            if is_related and (email.get("received_timestamp", 0) or 0) > baseline:
                return True
        return False

    def check_due_scenario_reminders(self):
        now = datetime.now()
        self.check_pending_sent_replies()
        changed = False
        due_count = 0
        for item in self.scenario_reminders:
            if item.get("completed") or item.get("cancelled"):
                continue
            try:
                due_at = datetime.fromisoformat(item.get("due_at", ""))
            except Exception:
                continue
            if due_at > now:
                continue

            email = self.find_email_for_followup_item(item)
            if not email:
                item["completed"] = True
                item["completed_at"] = datetime.now().isoformat()
                item["completed_reason"] = "email_not_found"
                changed = True
                continue

            if self.newer_related_email_exists(item):
                item["completed"] = True
                item["completed_at"] = datetime.now().isoformat()
                item["completed_reason"] = "newer_related_email_found"
                email["followup_time"] = ""
                changed = True
                continue

            scenario_type = item.get("type")
            if scenario_type == "vendor_no_response":
                group_name = self.get_group_name_for_email(email.get("entry_id", ""))
                message = (
                    "Vendor no-response reminder:\n\n"
                    f"No newer related email has been found after {VENDOR_NO_RESPONSE_MINUTES} minutes.\n\n"
                    f"Subject: {email.get('subject', '')}\n"
                    f"Group: {group_name or 'None'}\n\n"
                    "Create a quick vendor follow-up draft now?"
                )
                create_draft = messagebox.askyesno("MaINbox Reminder", message)
                if create_draft:
                    self.create_reply_draft_with_message(email, get_vendor_no_response_message(), require_thread=True, target_status_after_send="Waiting on Vendor", followup_source="vendor_no_response")
                item["completed"] = True
                item["completed_at"] = datetime.now().isoformat()
                item["completed_reason"] = "vendor_reminder_shown"
                email["followup_time"] = "Completed"
                due_count += 1
                changed = True

            elif scenario_type == "customer_po_order_followup":
                ok = self.create_reply_draft_with_message(email, get_po_followup_message(), require_thread=True, target_status_after_send="Waiting on Customer", followup_source="customer_po_order_followup")
                item["completed"] = True
                item["completed_at"] = datetime.now().isoformat()
                item["completed_reason"] = "po_followup_draft_created" if ok else "po_followup_draft_failed"
                email["followup_time"] = "Completed" if ok else "Draft failed"
                due_count += 1
                changed = True

            elif scenario_type in ["ai_followup_review", "ai_vendor_followup_review", "ai_customer_followup_review"]:
                # AI-driven follow-ups are intentionally routed to the Due Follow-Ups review popup.
                # Do not auto-create drafts here; the user can monitor/correct these in AI Triage.
                continue

        if changed:
            self.save_scenario_reminders()
            self.save_commitment_reminders()
            self.save_followups()
            self.save_cached_state()
            self.render_email_rows()
            self.render_group_rows()
        return due_count

