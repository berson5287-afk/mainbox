                label = rec.get("customer", "") or rec.get("customer_email", "") or "?"
                subj = rec.get("subject", "") or "(no subject)"
                disp = f"{label} \u2014 {subj}"[:80]
                tag = "has_out" if t["outstanding"] > 0 else "done"
                out_disp = f"{t['outstanding']} / {t['requested_count']}"
                threads_tree.insert("", "end", iid=t["thread_key"], values=(disp, out_disp), tags=(tag,))
            thread_ct, item_ct = self.coverage_outstanding_summary()
            if item_ct:
                summary_var.set(f"{item_ct} item(s) still need quotes across {thread_ct} customer request(s)")
            else:
                summary_var.set("All requested items have been quoted.")
            if cur and threads_tree.exists(cur):
                threads_tree.selection_set(cur)
                load_items(cur)
            else:
                state["current"] = None
                items_tree.delete(*items_tree.get_children())

        def on_thread_select(event=None):
            sel = threads_tree.selection()
            if sel:
                load_items(sel[0])

        threads_tree.bind("<<TreeviewSelect>>", on_thread_select)

        def set_done(done):
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            sel = items_tree.selection()
            if not sel:
                messagebox.showinfo("Quote Coverage", "Select one or more line items first.")
                return
            for iid in sel:
                pk = state.get("item_keys", {}).get(iid, "")
                if pk:
                    self.coverage_toggle_item_done(cur, pk, done=done)
            reload_all()

        def set_item_status(status):
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            sel = target_iids()
            if not sel:
                messagebox.showinfo("Quote Coverage", "Check or select one or more line items first.")
                return
            for iid in sel:
                pk = state.get("item_keys", {}).get(iid, "")
                if pk:
                    self.coverage_set_item_status(cur, pk, status)
            reload_all()

        def add_lines():
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            txt = add_text.get("1.0", tk.END)
            n = self.coverage_add_requested_lines(cur, txt)
            add_text.delete("1.0", tk.END)
            reload_all()
            messagebox.showinfo("Quote Coverage", f"Added {n} requested item(s).")

        def dismiss_current():
            cur = state.get("current")
            if not cur:
                return
            if messagebox.askyesno("Dismiss request",
                                   "Remove this customer request from the coverage queue?"):
                self.coverage_dismiss_thread(cur, True)
                state["current"] = None
                reload_all()

        # ---- checkboxes / re-quote / double-click-to-email ----
        def toggle_check(iid):
            if iid in state["checked"]:
                state["checked"].discard(iid)
                items_tree.set(iid, "chk", CHK_OFF)
            else:
                state["checked"].add(iid)
                items_tree.set(iid, "chk", CHK_ON)

        def toggle_check_all():
            kids = items_tree.get_children()
            all_on = bool(kids) and all(i in state["checked"] for i in kids)
            for i in kids:
                if all_on:
                    state["checked"].discard(i)
                    items_tree.set(i, "chk", CHK_OFF)
                else:
                    state["checked"].add(i)
                    items_tree.set(i, "chk", CHK_ON)

        def on_items_click(event):
            if items_tree.identify_region(event.x, event.y) != "cell":
                return
            if items_tree.identify_column(event.x) == "#1":  # checkbox column
                row = items_tree.identify_row(event.y)
                if row:
                    toggle_check(row)
                    return "break"  # don't also change the row selection

        items_tree.bind("<Button-1>", on_items_click, add="+")

        def target_iids():
            # act on checked items; if none are checked, fall back to the highlighted selection
            if state["checked"]:
                return [i for i in items_tree.get_children() if i in state["checked"]]
            return list(items_tree.selection())

        def requote_selected():
            cur = state.get("current")
            if not cur:
                messagebox.showinfo("Quote Coverage", "Select a customer request on the left first.")
                return
            rec = self.get_coverage_record(cur, create=False)
            if not rec:
                return
            keys = [state.get("item_keys", {}).get(i, "") for i in target_iids()]
            keys = [k for k in keys if k]
            if not keys:
                messagebox.showinfo("Quote Coverage", "Check the line items you want to re-quote first.")
                return
            keyset = set(keys)
            materials = normalize_material_items(
                [r for r in (rec.get("requested", []) or []) if self.coverage_item_primary_key(r) in keyset])
            if not materials:
                messagebox.showinfo("Quote Coverage", "Couldn't load those items to re-quote.")
                return
            # flip them to Waiting (auto, so a fresh vendor reply still auto-flips to Quoted), then refresh
            self.coverage_requote_items(cur, keys)
            reload_all()
            # open the RFQ & Materials extractor seeded with these items + suggested vendors
            group_id = rec.get("group_id", "") or ""
            try:
                group = self.get_group_by_id(group_id) if group_id else None
                emails = self.get_emails_for_group(group_id) if group_id else []
                if group or emails:
                    customer_hint = self.get_customer_hint_for_group(group, emails)
                else:
                    customer_hint = rec.get("customer", "") or ""
                vendors = self.suggest_vendors_for_materials(materials, customer_hint)
                self.open_quote_intelligence_window(
                    group_id, materials, vendors,
                    ["Re-quote from Quote Coverage \u2014 items carried over."], False)
            except Exception as e:
                messagebox.showwarning(
                    "Re-quote",
                    "Marked the items as Waiting, but couldn't open the RFQ extractor automatically "
                    f"(\u201c{e}\u201d). You can open it from the group's Quote RFQ button.")

        def _open_eid(eid):
            try:
                if self.goto_email_in_app(eid):
                    try:
                        self.root.lift()
                    except Exception:
                        pass
                    return True
            except Exception:
                pass
            try:
                ns = getattr(self, "namespace", None)
                if ns is None:
                    _o, ns = self.fresh_outlook()
                if ns:
                    it = ns.GetItemFromID(eid)
                    if it:
                        it.Display()
                        return True
            except Exception:
                pass
            return False

        def _eid_label(eid):
            e = self.get_email_by_id(eid)
            if e:
                subj = e.get("subject") or "(no subject)"
                who = e.get("sender") or e.get("sender_email") or ""
                when = e.get("received") or e.get("date") or ""
                return f"{subj}  \u2014  {who}  {when}".strip()
            try:
                ns = getattr(self, "namespace", None)
                if ns is None:
                    _o, ns = self.fresh_outlook()
                if ns:
                    it = ns.GetItemFromID(eid)
                    if it:
                        return f"{(getattr(it, 'Subject', '') or '(no subject)')}  \u2014  {getattr(it, 'SenderName', '')}"
            except Exception:
                pass
            return f"(email {str(eid)[:14]}\u2026)"

        def associated_entry_ids(rec):
            ids = []
            for eid in (rec.get("processed_sent_ids", []) or []):  # vendor quote replies
                if eid and eid not in ids:
                    ids.append(eid)
            gid = rec.get("group_id", "") if isinstance(rec, dict) else ""  # request-thread emails
            if gid:
                try:
                    for e in (self.get_emails_for_group(gid) or []):
                        eid = e.get("entry_id", "")
                        if eid and eid not in ids:
                            ids.append(eid)
                except Exception:
                    pass
            return ids

        def show_email_chooser(ids):
            top = tk.Toplevel(win)
            top.title("Associated emails")
            try:
                apply_theme(top)
            except Exception:
                pass
            top.configure(bg=_BG)
            tk.Label(top, text="This request is linked to more than one email. Open which one?",
                     bg=_BG, fg=_FG, font=(_FONT, 9), wraplength=560, justify="left").pack(fill="x", padx=10, pady=(10, 4))
            lb = tk.Listbox(top, width=96, height=min(12, max(3, len(ids))),
                            bg=_BG3, fg=_FG, selectbackground=_ACCENT, selectforeground="#ffffff", activestyle="none")
            lb.pack(fill="both", expand=True, padx=10, pady=6)
            for eid in ids:
                lb.insert("end", _eid_label(eid))

            def open_sel(event=None):
                s = lb.curselection()
                if not s:
                    return
                if not _open_eid(ids[s[0]]):
                    messagebox.showinfo("Quote Coverage",
                                        "That email couldn't be opened \u2014 it may have been moved, archived, or removed.")
                    return
                top.destroy()

            lb.bind("<Double-1>", open_sel)
            bf = tk.Frame(top, bg=_BG)
            bf.pack(fill="x", padx=10, pady=(0, 10))
            tk.Button(bf, text="Open", command=open_sel, bg=_ACCENT, fg="#ffffff",
                      activebackground=_ACCENT2, activeforeground="#ffffff", relief="flat",
                      padx=12, cursor="hand2").pack(side="right", padx=4)
            tk.Button(bf, text="Cancel", command=top.destroy, relief="flat", padx=12, cursor="hand2").pack(side="right", padx=4)

        def on_item_double(event=None):
            try:
                if items_tree.identify_column(event.x) == "#1":  # checkbox column toggles, doesn't navigate
                    return
            except Exception:
                pass
            cur = state.get("current")
            if not cur:
                return
            rec = self.get_coverage_record(cur, create=False)
            if not rec:
                return
            ids = associated_entry_ids(rec)
            if not ids:
                messagebox.showinfo("Quote Coverage", "No associated email is available to open for this request.")
                return
            if len(ids) == 1:
                if not _open_eid(ids[0]):
                    messagebox.showinfo("Quote Coverage",
                                        "That email couldn't be opened \u2014 it may have been moved, archived, or removed.")
                return
            show_email_chooser(ids)

        items_tree.bind("<Double-1>", on_item_double, add="+")

        reload_all()

    def save_procurement_memory(self):
        self.sync_vendor_history_to_procurement_memory()
        purge_blocked_procurement_vendors_from_memory(self.procurement_memory)
        self.procurement_memory["updated_at"] = datetime.now().isoformat()
        save_json(PROCUREMENT_MEMORY_FILE, self.procurement_memory)

    def procurement_stats_for_material(self, item):
        key = canonical_material_key(item)
        return self.procurement_memory.get("materials", {}).get(key, {}) if key else {}

    def procurement_suggest_vendors_for_materials(self, materials, limit=12):
        scores = {}
        reasons = {}
        mem = self.procurement_memory or default_procurement_memory()
        for item in materials or []:
            key = canonical_material_key(item)
            if not key:
                continue
            mrec = mem.get("materials", {}).get(key, {})
            for email, stat in (mrec.get("vendors", {}) or {}).items():
                email = str(email or "").lower().strip()
                if not email or is_blocked_internal_vendor(email, stat.get("name", "")):
                    continue
                award_count = int(stat.get("award_count", 0) or 0)
                request_count = int(stat.get("request_count", 0) or 0)
                preferred = bool(stat.get("preferred", False))
                score = award_count * 12 + request_count * 3 + (20 if preferred else 0)
                last_price = stat.get("last_unit_price", None)
                if last_price not in [None, ""]:
                    score += 2
                scores[email] = scores.get(email, 0) + score
                bits = []
                if preferred: bits.append("preferred")
                if award_count: bits.append(f"{award_count} award(s)")
                if request_count: bits.append(f"{request_count} RFQ(s)")
                if last_price not in [None, ""]: bits.append(f"last ${last_price}/unit")
                reasons.setdefault(email, set()).add(f"{key}: " + ", ".join(bits or ["history"]))
        ranked = []
        for email, score in sorted(scores.items(), key=lambda x: x[1], reverse=True)[:limit]:
            vrec = mem.get("vendors", {}).get(email, {}) or (self.vendor_history or {}).get("vendors", {}).get(email, {})
            ranked.append({"email": email, "name": vrec.get("name", email), "score": score, "reason": "; ".join(sorted(reasons.get(email, [])))})
        return ranked

    def record_procurement_request(self, vendors, materials, group=None, subject=""):
        mem = self.procurement_memory
        now = datetime.now().isoformat()
        customer_hint = self.get_customer_hint_for_group(group, self.get_emails_for_group(group.get("id")) if group and group.get("id") else []) if group else ""
        for vendor in vendors or []:
            email = str(vendor.get("email", "") or "").lower().strip()
            if not email or is_blocked_internal_vendor(email, vendor.get("name", "")):
                continue
            vrec = mem.setdefault("vendors", {}).setdefault(email, {"email": email, "name": vendor.get("name", email), "request_count": 0, "award_count": 0, "last_used_at": ""})
            vrec["name"] = vendor.get("name", email) or vrec.get("name", email)
            vrec["request_count"] = int(vrec.get("request_count", 0) or 0) + 1
            vrec["last_used_at"] = now
            if customer_hint:
                vrec.setdefault("customers", {})[customer_hint] = int(vrec.setdefault("customers", {}).get(customer_hint, 0) or 0) + 1
            for item in materials or []:
                key = canonical_material_key(item)
                if not key:
                    continue
                mrec = mem.setdefault("materials", {}).setdefault(key, {"key": key, "sample_description": item.get("description", ""), "vendors": {}, "last_used_at": ""})
                if item.get("description") and not mrec.get("sample_description"):
                    mrec["sample_description"] = item.get("description", "")
                mrec["last_used_at"] = now
                stat = mrec.setdefault("vendors", {}).setdefault(email, {"email": email, "name": vendor.get("name", email), "request_count": 0, "award_count": 0})
                stat["name"] = vendor.get("name", email) or stat.get("name", email)
                stat["request_count"] = int(stat.get("request_count", 0) or 0) + 1
                stat["last_requested_at"] = now
        self.save_procurement_memory()

    def record_procurement_award(self, vendor, materials, group=None, unit_price=None, total_price=None, notes=""):
        mem = self.procurement_memory
        now = datetime.now().isoformat()
        email = str(vendor.get("email", "") or "").lower().strip()
        if not email or is_blocked_internal_vendor(email, vendor.get("name", "")):
            return 0
        vrec = mem.setdefault("vendors", {}).setdefault(email, {"email": email, "name": vendor.get("name", email), "request_count": 0, "award_count": 0})
        vrec["name"] = vendor.get("name", email) or vrec.get("name", email)
        vrec["award_count"] = int(vrec.get("award_count", 0) or 0) + 1
        vrec["last_awarded_at"] = now
        count = 0
        for item in materials or []:
            key = canonical_material_key(item)
            if not key:
                continue
            qty = str(item.get("qty", "") or "").strip()
            unit = str(item.get("unit", "") or "").strip()
            desc = str(item.get("description", "") or "").strip()
            mrec = mem.setdefault("materials", {}).setdefault(key, {"key": key, "sample_description": desc, "vendors": {}})
            if desc:
                mrec["sample_description"] = desc
            stat = mrec.setdefault("vendors", {}).setdefault(email, {"email": email, "name": vendor.get("name", email), "request_count": 0, "award_count": 0})
            stat["name"] = vendor.get("name", email) or stat.get("name", email)
            stat["award_count"] = int(stat.get("award_count", 0) or 0) + 1
            stat["preferred"] = True
            stat["last_awarded_at"] = now
            if unit_price is not None:
                stat["last_unit_price"] = unit_price
            award = {"created_at": now, "vendor": vendor, "material_key": key, "material": dict(item), "group_id": group.get("id", "") if group else "", "group_name": group.get("name", "") if group else "", "unit_price": unit_price, "total_price": total_price, "notes": notes}
            mem.setdefault("awards", []).append(award)
            if unit_price is not None or total_price is not None:
                mem.setdefault("price_history", []).append({"created_at": now, "vendor_email": email, "vendor_name": vendor.get("name", email), "material_key": key, "description": desc, "qty": qty, "unit": unit, "unit_price": unit_price, "total_price": total_price, "notes": notes})
            mem.setdefault("routing_rules", {}).setdefault(key, [])
            if email not in mem["routing_rules"][key]:
                mem["routing_rules"][key].insert(0, email)
            count += 1
        self.save_procurement_memory()
        return count

    def purchase_history_extract_job_hint(self, subject="", body=""):
        """Best-effort job/group matching for old purchase history.

        If the user names quote groups by job, this lets the scanner connect
        older vendor purchases back to those job names without requiring a
        separate job-number database.
        """
        combined = f"{subject}\n{body}".lower()
        best = ""
        for g in (self.groups_data or {}).get("groups", []) or []:
            name = str(g.get("name", "") or "").strip()
            if not name or len(name) < 3:
                continue
            if name.lower() in combined:
                return name
            # Also match compact job-like tokens from group names.
            for token in re.findall(r"[A-Za-z]{2,}\d{2,}|\d{4,}|[A-Z]{2,}-?\d{3,}", name, flags=re.I):
                if len(token) >= 4 and token.lower() in combined:
                    best = name
        if best:
            return best
        m = re.search(r"\b(?:job|project|po|req|requisition)\s*#?\s*[:\-]?\s*([A-Z0-9][A-Z0-9\-_/]{3,})", f"{subject}\n{body}", flags=re.I)
        return m.group(1).strip() if m else ""

    def purchase_history_candidate_lines(self, text):
        """Extract likely purchased/quoted material rows from an old email body.

        v2.10.23: tightened this so addresses, signature/contact info, RFQ prose,
        job notes, and quote instructions do not become "materials". It now favors
        true catalog/part/price/quantity lines such as "IP710-D2Z $72.69" or
        "25 EA 3/4 EMT connector $1.25".
        """
        text = text or ""
        rows = []
        for raw in text.splitlines():
            line = re.sub(r"\s+", " ", str(raw or "")).strip()
            if len(line) < 5 or len(line) > 240:
                continue
            if purchase_history_line_noise_reason(line):
                continue

            low = line.lower()
            has_trade_word = bool(re.search(r"\b(emt|pvc|rigid|conduit|connector|strap|locknut|bushing|coupling|nipple|wire|cable|breaker|panel|box|gutter|kindorf|strut|washer|nut|rod|paint|tie|fitting|receptacle|switch|cover|device|transformer|lug|bolt|screw|anchor|unistrut|channel|hubbell|leviton|burndy|southwire|thhn|mccb|gfci|afci|nema|dimmer|disconnect|fuse|clamp|terminal|elbow)\b", low))
            has_money = bool(re.search(r"\$\s*\d|\b\d+\.\d{2,4}\b", line))
            has_qty = bool(re.match(r"^\s*\d+(?:\.\d+)?\s*(?:ea|each|ft|feet|pc|pcs|box|bag|roll|set|lot|m|c)?\b", line, flags=re.I))
            part_guess = purchase_history_extract_part_number_from_text(line)

            # Conservative gate: must have real material evidence, not just prose.
            if not ((has_trade_word and (has_qty or has_money or part_guess)) or (part_guess and (has_money or has_qty))):
                continue

            # Qty/unit at start, e.g. 25 EA 3/4 EMT connector $1.25
            qty = ""
            unit = ""
            desc = line
            m = re.match(r"^\s*(\d+(?:\.\d+)?)\s*(ea|each|ft|feet|pc|pcs|box|bag|roll|set|lot|m|c)?\s*[xX\-:,]*\s*(.+)$", line, flags=re.I)
            if m:
                qty = m.group(1)
                unit = (m.group(2) or "").lower()
                if unit == "each":
                    unit = "ea"
                if unit == "feet":
                    unit = "ft"
                desc = m.group(3).strip()

            prices = []
            for pm in re.finditer(r"\$\s*([0-9][0-9,]*(?:\.\d{1,4})?)", line):
                val = money_to_float(pm.group(0))
                if val is not None:
                    prices.append(val)
            if not prices and any(x in low for x in ["price", "unit", "ext", "total", "quote"]):
                for pm in re.finditer(r"\b([0-9][0-9,]*\.\d{2})\b", line):
                    val = money_to_float(pm.group(1))
                    if val is not None:
                        prices.append(val)

            unit_price = prices[0] if prices else None
            total_price = prices[-1] if len(prices) > 1 else None

            desc = re.sub(r"\$\s*[0-9][0-9,]*(?:\.\d{1,4})?", " ", desc)
            desc = re.sub(r"\b(?:unit price|ext price|total|price|quote)\b\s*[:\-]?", " ", desc, flags=re.I)
            desc = re.sub(r"\s+", " ", desc).strip(" -:,;\t")
            if not desc or purchase_history_line_noise_reason(desc):
                continue

            row = {"qty": qty, "unit": unit, "description": desc, "part_number": part_guess, "unit_price": unit_price, "total_price": total_price, "raw_line": line}
            if not is_likely_purchase_material_row(row):
                continue
            rows.append(row)

        # If line parsing found nothing, use the existing RFQ material heuristic as a
        # last candidate builder, but run every result through the stricter guard.
        if not rows:
            for item in heuristic_extract_materials(text, max_items=25) or []:
                item = dict(item)
                item.setdefault("unit", "")
                item.setdefault("unit_price", None)
                item.setdefault("total_price", None)
                item.setdefault("raw_line", item.get("description", ""))
                if purchase_history_line_noise_reason(item.get("raw_line") or item.get("description")):
                    continue
                if not is_likely_purchase_material_row(item):
                    continue
                rows.append(item)

        # Deduplicate by normalized material key + qty/unit/price.
        cleaned = []
        seen = set()
        for r in rows:
            key = (canonical_material_key(r), str(r.get("qty", "")), str(r.get("unit", "")), str(r.get("unit_price", "")))
            if key in seen:
                continue
            seen.add(key)
            cleaned.append(r)
        return cleaned[:80]


    def open_smartscan_window(self):
        """Open the full SmartScan review/learning app using MaINbox's current theme."""
        try:
            # v2.10.28: the toolbar SmartScan button should also use the embedded/themed
            # copy, not a possibly stale external settings path.
            resolved = _resolve_embedded_smartscan_path()
            if not resolved or not os.path.exists(resolved):
                messagebox.showerror("SmartScan", "SmartScan could not be prepared from the embedded MaINbox copy.")
                return
            env = os.environ.copy()
            env["MAINBOX_SMARTSCAN_THEME_JSON"] = _mainbox_smartscan_theme_payload()
