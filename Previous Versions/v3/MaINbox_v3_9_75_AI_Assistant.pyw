            return f"http://{ip}:{port}" if ip else ""

        def refresh_conn_models():
            host_base = _conn_base_url()
            if not host_base:
                conn_status_var.set("Enter a Host PC IP, then Refresh to load the host's models.")
                return
            host_models = list_ollama_models(host_base)
            if host_models:
                for _c in (conn_heavy_combo, conn_light_combo, conn_triage_combo, conn_vision_combo):
                    _c["values"] = host_models
                conn_status_var.set(f"Host OK: {len(host_models)} model(s) loaded into the host model lists.")
            else:
                conn_status_var.set(f"Host {host_base} unreachable \u2014 kept your saved model names.")

