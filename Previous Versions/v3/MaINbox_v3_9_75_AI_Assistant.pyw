                    "remote_ai_triage_model": conn_triage_var.get().strip(),
                    "rfq_parser_mode": parser_mode_var.get().strip().lower(),
                    "rfq_ocr_order": ocr_order_var.get().strip().lower(),
                    "rfq_pdf_text_enabled": bool(pdf_text_var.get()),
                    "rfq_tesseract_enabled": bool(tesseract_var.get()),
                    "rfq_image_ocr_enabled": bool(image_ocr_var.get()),
                    "rfq_vision_fallback_enabled": bool(vision_fallback_var.get()),
                    "rfq_expected_item_count_hint": int(expected_item_count_var.get()),
                    "rfq_use_smartscan": bool(smartscan_var.get()),
                    "commitment_reminders_enabled": bool(commitment_enabled_var.get()) and commitment_mode_var.get().strip().lower() != "disabled",
                    "commitment_reminder_mode": "disabled" if commitment_mode_var.get().strip().lower() == "disabled" else (commitment_mode_var.get().strip().lower() or "prompt"),
                    "commitment_scan_attachments": bool(commitment_attachments_var.get()),
                    "commitment_reminder_buffer": commitment_buffer_var.get().strip() or "morning_of",
                    "commitment_reminder_hour": int(commitment_hour_var.get()),
                    "commitment_min_confidence": float(commitment_conf_var.get()),
                    "commitment_auto_min_confidence": float(commitment_auto_conf_var.get()),
                    "commitment_create_outlook_reminder": bool(commitment_outlook_var.get()),
                    "reply_needed_reminders_enabled": bool(reply_needed_var.get()),
                    "reply_needed_delay_hours": int(reply_delay_var.get()),
                }
                old_settings = dict(getattr(self, "settings", load_mainbox_settings()))
                normalized = load_mainbox_settings()
                normalized.update(new_settings)
                # v2.10.36: if the user switches Dark/Light theme, reset every saved
                # custom color override to that theme's proper palette. Otherwise old
                # dark custom backgrounds can keep the UI dark even after Light theme
                # is selected.
                if str(old_settings.get("theme", "dark")).lower() != str(new_settings.get("theme", "dark")).lower():
                    normalized.update(mainbox_theme_color_defaults(new_settings.get("theme", "dark")))
                save_json(MAINBOX_SETTINGS_FILE, normalized)
                self.settings = load_mainbox_settings()

                visual_keys = {"theme", "font_family", "font_size", "font_bold"}
                auto_keys = {"auto_refresh_enabled", "auto_refresh_seconds"}
                sales_uncat_keys = {"sales_uncat_enabled", "sales_uncat_refresh_seconds", "sales_uncat_scan_limit"}

                visual_changed = any(old_settings.get(k) != self.settings.get(k) for k in visual_keys)
                auto_changed = any(old_settings.get(k) != self.settings.get(k) for k in auto_keys)
                sales_uncat_changed = any(old_settings.get(k) != self.settings.get(k) for k in sales_uncat_keys)

                # Keep this lightweight: update module-level settings, but only repaint the UI
                # when visual settings actually changed. Repainting the full main window is the
                # slow part, so a Save with only AI/OCR/functionality changes stays fast.
                apply_mainbox_settings(self.settings)

                if auto_changed:
                    self.auto_refresh_enabled = bool(self.settings.get("auto_refresh_enabled", AUTO_REFRESH_ENABLED))
                    self.auto_refresh_seconds = int(self.settings.get("auto_refresh_seconds", AUTO_REFRESH_SECONDS))
                    try:
                        self.auto_status_var.set(
                            f"AutoPilot: watching every {self.auto_refresh_seconds}s" if self.auto_refresh_enabled else "AutoPilot: off"
                        )
                    except Exception:
                        pass
                    if self.auto_refresh_enabled:
                        self.schedule_auto_refresh()

                if sales_uncat_changed:
                    self.sales_uncategorized_queue_enabled = bool(self.settings.get("sales_uncat_enabled", True))
                    self.sales_uncategorized_refresh_seconds = int(self.settings.get("sales_uncat_refresh_seconds", 60))
                    self.sales_uncategorized_scan_limit = int(self.settings.get("sales_uncat_scan_limit", SALES_UNCATEGORIZED_SCAN_LIMIT))

                if visual_changed:
                    try:
                        win.destroy()
                    except Exception:
                        pass
                    self.apply_visual_settings_with_wait_splash("Applying your visual settings...")
                else:
                    messagebox.showinfo("Settings Saved", "Settings saved.")
                    win.destroy()
            except Exception as exc:
                messagebox.showerror("Settings", f"Could not save settings.\n\n{exc}")

        tk.Button(btns, text="Save Settings", command=save_settings, width=18).pack(side="right", padx=5)
        tk.Button(btns, text="Cancel", command=win.destroy, width=14).pack(side="right", padx=5)


    def open_saved_senders_manager(self, parent=None):
        """v3.9.4 -- manage the quote-pipeline saved sender lists (customers + vendors)
        that drive auto-recognition. Reads/writes the SAME JSON files the pipeline uses,
        so add/edit/remove here takes effect on the next Quote Scan (no restart)."""
        try:
            from mainbox_quote_pipeline_entry import (load_saved_senders, add_saved_sender,
                                                      remove_saved_sender)
        except Exception as exc:
            messagebox.showerror("Saved Senders", f"Quote pipeline module not available.\n\n{exc}")
            return

        win = tk.Toplevel(parent or self.root)
        win.title("Saved Senders")
        remember_window_geometry(win, "MaINbox Saved Senders", "560x620")
        win.transient(parent or self.root)
        apply_theme(win)

        tk.Label(win, text="Saved Senders", font=(_FONT, 14, "bold"), fg=_ACCENT, bg=_BG).pack(
            anchor="w", padx=14, pady=(12, 4))
        tk.Label(win, text="Quote Scan auto-recognizes these senders: customer RFQs auto-draft an ack "
                           "and open the extractor; vendors are treated as suppliers. Changes apply on "
                           "the next scan.",
                 bg=_BG, fg=_FG_DIM, wraplength=520, justify="left").pack(anchor="w", padx=14, pady=(0, 8))

        def build_list_section(kind, title):
            frame = tk.LabelFrame(win, text=title, bg=_BG2, fg=_ACCENT, padx=10, pady=10)
            frame.pack(fill="both", expand=True, padx=14, pady=8)

            lb = tk.Listbox(frame, bg=_BG3, fg=_FG, selectbackground=_SEL_BG,
                            selectforeground=_SEL_FG, height=7, activestyle="none")
            lb.pack(fill="both", expand=True, pady=(0, 6))

            def refresh():
                lb.delete(0, tk.END)
                for e in sorted(load_saved_senders(kind)):
                    lb.insert(tk.END, e)

            row = tk.Frame(frame, bg=_BG2)
            row.pack(fill="x")
            entry = tk.Entry(row, bg=_ENTRY_BG, fg=_FG, insertbackground=_FG)
            entry.pack(side="left", fill="x", expand=True, padx=(0, 6))

            def add():
                val = entry.get().strip()
                if not val:
                    return
                if "@" not in val:
                    messagebox.showwarning("Saved Senders", "Please enter an email address.", parent=win)
                    return
                add_saved_sender(kind, val)
                entry.delete(0, tk.END)
                refresh()

            def remove():
                sel = lb.curselection()
                if not sel:
                    return
                email = lb.get(sel[0])
                if messagebox.askyesno("Saved Senders", f"Remove {email} from saved {kind}s?", parent=win):
                    remove_saved_sender(kind, email)
                    refresh()

            tk.Button(row, text="Add", command=add, width=8).pack(side="left", padx=2)
            tk.Button(row, text="Remove Selected", command=remove, width=16).pack(side="left", padx=2)
            entry.bind("<Return>", lambda e: add())
            refresh()

        build_list_section("customer", "Saved Customers (RFQs auto-quote)")
        build_list_section("vendor", "Saved Vendors (treated as suppliers)")

        tk.Button(win, text="Close", command=win.destroy, width=14).pack(side="right", padx=14, pady=12)


